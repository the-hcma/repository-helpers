# Security audit helpers
# ---------------------------------------------------------------------------

# Emits one "pkg current fix_version cve1,cve2,..." line per vulnerable Python
# package that has a known fix version available. Packages with no fix are
# silently skipped (nothing we can do in a dep-update PR).

# py_audit(tool, dir): run pip-audit in the specified directory
py_audit() {
  local -r tool="$1"
  local audit_dir="${2:-$dir}"
  local raw exit_code

  set +e
  case "$tool" in
    uv)
      raw="$(cd "$audit_dir" && uv run --with pip-audit pip-audit --format=json 2>/dev/null)"
      exit_code=$?
      ;;
    *)
      if ! command -v pip-audit &>/dev/null; then
        return 0  # pip-audit not installed — skip audit silently
      fi
      raw="$(cd "$audit_dir" && pip-audit --format=json 2>/dev/null)"
      exit_code=$?
      ;;
  esac
  set -e

  [[ -z "$raw" || "$raw" == 'null' ]] && return 0
  if ! printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then return 0; fi

  printf '%s' "$raw" | jq -r '
    .dependencies[]
    | select(.vulns | length > 0)
    | . as $dep
    | .vulns
      | map(select(.fix_versions | length > 0))
      | select(length > 0)
      | {
          name: $dep.name,
          version: $dep.version,
          fix: (map(.fix_versions[]) | sort | last),
          cves: (map(.id) | join(", "))
        }
    | "\(.name) \(.version) \(.fix) \(.cves)"
  ' 2>/dev/null || true
}

# Emits one "pkg current fix_version cve1,cve2,..." line per vulnerable npm
# package where a direct-dep fix is available. Transitive-only vulns are
# skipped (package.json cannot address them without introducing breaking changes).
npm_audit() {
  local raw exit_code

  set +e
  case "$npm_tool" in
    pnpm) raw="$(pnpm --dir "$dir" audit --json 2>/dev/null)" ;;
    yarn) raw="$(yarn --cwd "$dir" audit --json 2>/dev/null)" ;;
    npm)  raw="$(npm audit --prefix "$dir" --json 2>/dev/null)" ;;
  esac
  exit_code=$?
  set -e

  [[ -z "$raw" || "$raw" == '{}' || "$raw" == 'null' ]] && return 0
  if ! printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then return 0; fi

  # npm/pnpm JSON: .vulnerabilities.<name>.{ isDirect, fixAvailable: bool | {name,version} }
  # yarn emits newline-delimited JSON events; filter to advisories.
  if [[ "$npm_tool" == 'yarn' ]]; then
    # yarn audit --json emits one JSON object per line; skip non-advisory lines.
    printf '%s' "$raw" | jq -r '
      select(.type == "auditAdvisory")
      | .data.advisory
      | select(.findings | any(.paths[]; . == "." or (test("^[^/]+$"))))
      | select(.patched_versions != "<0.0.0")
      | "\(.module_name) \(.findings[0].version) \(.patched_versions | ltrimstr(">=") | ltrimstr(">") | split(" ")[0]) \(.cves | if length > 0 then join(", ") else .id end)"
    ' 2>/dev/null | sort -u || true
  else
    # npm and pnpm share the same audit JSON format.
    printf '%s' "$raw" | jq -r '
      .vulnerabilities
      | to_entries[]
      | select(.value.isDirect == true)
      | select(.value.fixAvailable | type == "object")
      | {
          name: .key,
          current: (.value.via | map(select(type == "object")) | .[0].range // "unknown"),
          fix: .value.fixAvailable.version,
          cves: (.value.via
            | map(select(type == "object") | .url | split("/") | last)
            | map(select(startswith("GHSA-") or (test("CVE-"))))
            | unique | join(", "))
        }
      | "\(.name) \(.current) \(.fix) \(.cves)"
    ' 2>/dev/null || true
  fi
}

# Write the PR body for a combined security update PR.
# Args: ecosystem  audit_lines  body_file
write_security_pr_body() {
  local -r eco="$1"
  local -r audit_lines="$2"
  local -r body_file="$3"
  {
    printf '## Security: CVE fixes\n\n'
    printf "Automated security updates via \`dep-update\`.\n\n"
    printf 'Patching all packages with known vulnerabilities that have a fix available.\n\n'
    printf '## Vulnerabilities addressed\n\n'
    printf '| Package | Current | Fixed | CVEs |\n'
    printf '|---|---|---|---|\n'
    while IFS=' ' read -r pkg current fix cves; do
      [[ -z "$pkg" ]] && continue
      printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" \
        "$pkg" "$current" "$fix" "${cves/,/, }"
    done <<< "$audit_lines"
    printf '\n- **Ecosystem:** %s\n' "$eco"
  } > "$body_file"
}

# Creates exactly ONE PR that bumps all npm packages with CVE fixes.
npm_security_update() {
  local -r audit_lines="$1"
  [[ -z "$audit_lines" ]] && return 0

  local -r branch="dep-updates/npm-security"
  local -r body_file="/tmp/dep-update-pr-npm-security.md"

  local pkg_list=""
  while IFS=' ' read -r pkg _current _fix _cves; do
    [[ -z "$pkg" ]] && continue
    pkg_list="${pkg_list} ${pkg}"
  done <<< "$audit_lines"
  pkg_list="${pkg_list# }"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing security branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      git -C "$worktree_path" checkout "$branch"
      run_in_worktree gt track -p main 2>/dev/null || true
      run_in_worktree gt submit --no-interactive --publish --no-stack
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then state_append_pr "$existing_pr"; fi
    fi
    git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[${npm_tool}] Security: patching CVE vulnerabilities in ${pkg_list}…"

  # Restore manifest + lockfile to a clean state.
  local lockfile
  case "$npm_tool" in
    pnpm) lockfile="pnpm-lock.yaml" ;;
    yarn) lockfile="yarn.lock" ;;
    npm)  lockfile="package-lock.json" ;;
  esac
  git -C "$worktree_path" checkout -- package.json 2>/dev/null || true
  git -C "$worktree_path" checkout -- "$lockfile" 2>/dev/null || true

  # Apply audit fixes. npm/pnpm patch manifests + lockfiles in one step.
  case "$npm_tool" in
    pnpm)
      pnpm --dir "$worktree_path" audit --fix 2>/dev/null \
        || pnpm --dir "$worktree_path" install --no-frozen-lockfile
      ;;
    yarn)
      # yarn has no native audit --fix; upgrade the vulnerable packages directly.
      local -a yarn_args=()
      while IFS=' ' read -r pkg _current fix _cves; do
        [[ -z "$pkg" ]] && continue
        yarn_args+=("${pkg}@${fix}")
      done <<< "$audit_lines"
      yarn --cwd "$worktree_path" upgrade "${yarn_args[@]}"
      ;;
    npm)
      npm audit fix --prefix "$worktree_path" 2>/dev/null || true
      ;;
  esac

  git -C "$worktree_path" add package.json
  # Only stage the lockfile if the project tracks it (not gitignored).
  if ! git -C "$worktree_path" check-ignore -q "$lockfile" 2>/dev/null; then
    git -C "$worktree_path" add "$lockfile" 2>/dev/null || true
  fi

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[${npm_tool}] Security: no file changes after audit fix — already patched or indirect only. Skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(git -C "$worktree_path" branch --show-current)"

  local commit_msg="fix(deps): patch CVE vulnerabilities in npm dependencies"
  git -C "$worktree_path" checkout -b "$branch"
  git -C "$worktree_path" commit -m "$commit_msg"

  if [[ "$parent_branch" == "$wt_base_branch" ]]; then
    run_in_worktree gt track -p main
  else
    run_in_worktree gt track -p "$parent_branch"
  fi
  log "[gate] Submitting security PR for '${branch}'…"
  run_in_worktree gt submit --no-interactive --publish --no-stack

  local submitted_head
  submitted_head="$(git -C "$worktree_path" rev-parse "$branch")"

  local pr_num
  pr_num="$(gh_pr_number_for_new_branch "$branch")"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  write_security_pr_body "${npm_tool}" "$audit_lines" "$body_file"
  gh pr edit "$pr_num" \
    --title "$commit_msg" \
    --body-file "$body_file" \
    --add-label "dep-updater" \
    --add-label "security" || true
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh pr edit "$pr_num" --add-label "merge-mq" 2>/dev/null || true
  fi

  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "npm" "npm-security (CVEs)" "" "" "$branch" "$pr_num"

  if [[ "$no_wait_ci" == '0' ]]; then
    log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
    wait_for_mergeable_quick "$pr_num"
    log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
    wait_for_ci "$branch" "$submitted_head" "$pr_num"
    log "[gate] CI passed. Final merge conflict check…"
    wait_for_mergeable "$pr_num"
    log "[gate] PR #${pr_num} is mergeable. Proceeding to next update."
  fi
}

