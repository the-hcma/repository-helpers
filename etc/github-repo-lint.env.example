# Optional: copy to ~/.config/github-repo-lint.env (mode 600).
# The service reuses ~/.config/dep-updater.env for SMTP by default; this file
# overrides report details and org settings for github-repo-lint --enforcer.
#
# The enforcer discovers repositories via the GitHub org API (orgs/<ORG>/repos)
# and only reports compliance drift. To apply supported GitHub-side repairs, run:
#   scripts/github-repo-lint --repo OWNER/NAME --apply-fix
# Workflow candidate stacks still need a local clone under GITHUB_REPO_LINT_SCAN_ROOT
# (or run --apply-fix from the target repo).

# Mail relay host. Use localhost when sendmail(1) delivers locally (only setting required).
GITHUB_REPO_LINT_SMTP_HOST=localhost

# Optional overrides (defaults are applied when omitted):
# GITHUB_REPO_LINT_REPORT_TO=johndoe@example.com
# GITHUB_REPO_LINT_REPORT_FROM=github-repo-lint@example.com
# GITHUB_REPO_LINT_REPORT_SUBJECT_PREFIX=[github-repo-lint]
# GITHUB_REPO_LINT_LOG=%h/scratch/repository-helpers/github-repo-lint.log
# GITHUB_REPO_LINT_ORG=the-hcma
# GITHUB_REPO_LINT_SCAN_ROOT=/path/to/parent-of-git-clones  # apply-fix local clones only
# GITHUB_REPO_LINT_INCLUDE_PRIVATE=0
