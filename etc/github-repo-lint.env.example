# Optional: copy to ~/.config/repo-big-brother-enforcer.env (mode 600).
# The service reuses ~/.config/dep-updater.env for SMTP by default; this file
# overrides report details and scan settings for repo-big-brother-enforcer.
#
# The enforcer only reports compliance drift. To apply supported GitHub-side
# repairs, run: scripts/check-repo-practices --repo OWNER/NAME --apply-fix

# Mail relay host. Use localhost when sendmail(1) delivers locally (only setting required).
REPO_BIG_BROTHER_SMTP_HOST=localhost

# Optional overrides (defaults are applied when omitted):
# REPO_BIG_BROTHER_REPORT_TO=johndoe@example.com
# REPO_BIG_BROTHER_REPORT_FROM=repo-big-brother-enforcer@example.com
# REPO_BIG_BROTHER_REPORT_SUBJECT_PREFIX=[repo-big-brother-enforcer]
# REPO_BIG_BROTHER_LOG=%h/scratch/repository-helpers/repo-big-brother-enforcer.log
# REPO_BIG_BROTHER_SCAN_ROOT=/path/to/parent-of-git-clones
