# Optional: copy to ~/.config/secret-audit.env (mode 600).
# Overlays ~/.config/dep-updater.env for the secret-audit timer / batch-run.
# SMTP host/user/password usually stay in dep-updater.env; set recipients here
# when secret-audit should notify a different list.

# Recipients (comma-separated if your MTA accepts it). Falls back to
# DEP_UPDATER_REPORT_TO when unset.
# SECRET_AUDIT_REPORT_TO=security-oncall@example.com

# Optional From / Reply-To (default: DEP_UPDATER_REPORT_FROM or
# secret-audit-batch@example.com).
# SECRET_AUDIT_REPORT_FROM=secret-audit-batch@example.com
# SECRET_AUDIT_REPORT_REPLY_TO=security-oncall@example.com
# SECRET_AUDIT_REPORT_SUBJECT_PREFIX=[secret-audit-batch]

# Org sweep defaults (timer).
# SECRET_AUDIT_ORG=the-hcma
# SECRET_AUDIT_INCLUDE_PRIVATE=1

# TruffleHog worker concurrency (positive integer). Omit to use TruffleHog default.
# SECRET_AUDIT_CONCURRENCY=8

# Host paths: append log + per-run detail transcripts (mode 0600; may contain secrets).
# Emails never include finding payloads — only the path to the detail file.
# SECRET_AUDIT_BATCH_LOG=$HOME/scratch/repository-helpers/secret-audit-batch.log
# SECRET_AUDIT_DETAIL_DIR=$HOME/scratch/repository-helpers/secret-audit-runs
