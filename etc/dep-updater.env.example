# Required: copy to ~/.config/repository-helpers/dep-updater.env (mode 600) and fill in values.
# dep-updater.service fails to start if this file is missing (EnvironmentFile=).
# dep-updater-batch-run also exits with an error when the file is absent.

# SMTP server (required for email reports)
DEP_UPDATER_SMTP_HOST=smtp.example.com
DEP_UPDATER_SMTP_PORT=587
DEP_UPDATER_SMTP_TLS=starttls
DEP_UPDATER_SMTP_USER=your-smtp-username
DEP_UPDATER_SMTP_PASSWORD=your-smtp-password

# Report recipient and sender
DEP_UPDATER_REPORT_TO=you@example.com
DEP_UPDATER_REPORT_FROM=dep-updater-batch@example.com
DEP_UPDATER_REPORT_REPLY_TO=dep-updater-batch@example.com

# Optional overrides
# DEP_UPDATER_REPORT_SUBJECT_PREFIX=[dep-updater-batch]
# DEP_UPDATER_BATCH_LOG=%h/scratch/repository-helpers/dep-updater-batch.log
# DEP_UPDATER_BATCH_SCAN_ROOT=/path/to/parent-of-git-clones
# Batch deadline (seconds or 4h / 240m / 90s). Exceeding it stops dep-updater, logs
# ERROR: WAIT_TIMEOUT, and emails a timeout report. Default 4h; raise
# dep-updater.service TimeoutStartSec if you increase this (see docs/SYSTEMD.md).
# DEP_UPDATER_BATCH_TIMEOUT=4h
