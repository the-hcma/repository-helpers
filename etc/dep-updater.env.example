# Required: copy to ~/.config/dep-updater.env (mode 600).
# Used by dep-updater-batch-run, dep-updater-notifier, and github-repo-lint --enforcer.
# dep-updater.service fails to start if this file is missing (EnvironmentFile=).

# Mail relay host. Use localhost when sendmail(1) delivers locally (only setting required).
DEP_UPDATER_SMTP_HOST=localhost

# Optional overrides (defaults are applied when omitted):
# DEP_UPDATER_REPORT_TO=johndoe@example.com
# DEP_UPDATER_REPORT_FROM=dep-updater-batch@example.com   # notifier default differs when unset
# DEP_UPDATER_REPORT_SUBJECT_PREFIX=[dep-updater-batch]
# DEP_UPDATER_BATCH_LOG=%h/scratch/repository-helpers/dep-updater-batch.log
# DEP_UPDATER_BATCH_SCAN_ROOT=/path/to/parent-of-git-clones
# DEP_UPDATER_BATCH_TIMEOUT=4h
# DEP_UPDATER_MERGE_VIA=gh          # batch default; use merge-queue to roll back to Graphite MQ
