# Agent review operator notifications (used by scripts/wait-for-agent-review complete/give-up).
# SMTP delivery reuses DEP_UPDATER_SMTP_* from ~/.config/dep-updater.env when present.

AGENT_REVIEW_AGENT=copilot
# Quota escalation when an agent is exhausted (comma-separated). Default when unset:
# coderabbit,copilot,bugbot
AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=coderabbit,copilot,bugbot
# Daily Copilot quota cache (refreshed once per local calendar day):
# AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE=%h/scratch/repository-helpers/copilot-review-quota.env
# Daily Bugbot usage cache (refreshed once per local calendar day):
# AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE=%h/scratch/repository-helpers/bugbot-review-quota.env
# Daily CodeRabbit quota cache (refreshed once per local calendar day):
# AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE=%h/scratch/repository-helpers/coderabbit-review-quota.env
AGENT_REVIEW_REPORT_TO=you@example.com
AGENT_REVIEW_REPORT_FROM=agent-review@example.com

# Optional defaults (else inferred from git remote origin):
# AGENT_REVIEW_GITHUB_REPO=the-hcma/example-repo
# AGENT_REVIEW_PR_NUMBER=42

# Legacy idle dwell (default 15m). The loop completes as soon as nothing is
# outstanding (no pending feedback, not waiting on a requested Copilot/Bugbot
# review, CodeRabbit workflow not running). CYCLE_TIMEOUT is retained for
# compatibility and older idle-complete email wording:
AGENT_REVIEW_CYCLE_TIMEOUT=15m
# Non-convergence cap: while review→fix→push cycles keep iterating without
# reaching idle-success, give up after this wall time (default 12h):
AGENT_REVIEW_PR_TIMEOUT=12h
# Transient merge/restack retries (UNSTABLE lag, flaky gt/gh, post-restack poll):
# AGENT_REVIEW_TRANSIENT_RETRIES=5
# AGENT_REVIEW_TRANSIENT_RETRY_SLEEP=30s
# CodeRabbit rate-limit sleep chunk size (default 60m). Longer "Next review available in"
# cooldowns are slept in successive chunks until retry_after (issues #366 / #347). After
# cooldown, wait AGENT_REVIEW_CODERABBIT_POST_COOLDOWN_GRACE (default 60s) for on-push; only
# then may the loop post a one-shot @coderabbitai full review if still missing. Never post
# plain @coderabbitai review.
# AGENT_REVIEW_CODERABBIT_RATE_LIMIT_WAIT_MAX=60m
# AGENT_REVIEW_CODERABBIT_POST_COOLDOWN_GRACE=60s
# Deprecated alias for AGENT_REVIEW_CYCLE_TIMEOUT:
# AGENT_REVIEW_LOOP_TIMEOUT=15m

# SMTP (required for email):
DEP_UPDATER_SMTP_HOST=localhost
