# User systemd oneshot: re-arm repository-helpers timers after boot / login.
#
# Template: ``etc/systemd/ensure-user-service-timers.service`` in this repository.
# Installed by ``scripts/setup-service`` (substitutes ``@@REPO_DIR@@``).
#
# Runs on the service host only (ConditionHost injected at install). Heals shared
# NFS ``timers.target.wants/`` if a standby ``setup-service`` previously disabled
# timers, or if the user manager started before wants links were visible.
#
# Do not pair with a .timer — activation is via default.target only.

[Unit]
Description=Ensure repository-helpers user service timers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TimeoutStartSec=2min
ExecStart=@@REPO_DIR@@/scripts/ensure-user-service-timers
# Quiet: heal is frequent; failures still go to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
