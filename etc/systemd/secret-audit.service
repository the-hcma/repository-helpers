# User systemd oneshot: TruffleHog org deep secret audit (#509).
#
# Template: ``etc/systemd/secret-audit.service`` in this repository.
# Installed by ``scripts/setup-secret-audit`` (substitutes @@REPO_DIR@@).
#
# Reuses ~/.config/dep-updater.env for SMTP; optional ~/.config/secret-audit.env.
#
# Logs: ~/scratch/repository-helpers/secret-audit-batch.log

[Unit]
Description=Secret audit (TruffleHog org deep scan)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-%h/.config/dep-updater.env
EnvironmentFile=-%h/.config/secret-audit.env
TimeoutStartSec=2h 30min
TimeoutStopSec=2min
KillMode=control-group
ExecStart=@@REPO_DIR@@/scripts/secret-audit-batch-run
StandardOutput=append:%h/scratch/repository-helpers/secret-audit-batch.log
StandardError=append:%h/scratch/repository-helpers/secret-audit-batch.log

# No [Install] section — activated only by secret-audit.timer (not default.target).
