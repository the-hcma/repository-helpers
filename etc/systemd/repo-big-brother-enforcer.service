# User systemd oneshot: Repo Big Brother Enforcer.
#
# Installed by repository-helpers scripts/setup-repo-big-brother-enforcer
# (substitutes @@REPO_DIR@@). The matching timer runs this daily.
#
# scripts/repo-big-brother-enforcer reuses ~/.config/dep-updater.env for SMTP,
# with optional overrides from ~/.config/repo-big-brother-enforcer.env.
#
# Logs: ~/scratch/repository-helpers/repo-big-brother-enforcer.log

[Unit]
Description=Repo Big Brother Enforcer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-%h/.config/dep-updater.env
EnvironmentFile=-%h/.config/repo-big-brother-enforcer.env
TimeoutStartSec=1h 30min
TimeoutStopSec=2min
KillMode=control-group
ExecStart=@@REPO_DIR@@/scripts/repo-big-brother-enforcer
StandardOutput=append:%h/scratch/repository-helpers/repo-big-brother-enforcer.log
StandardError=append:%h/scratch/repository-helpers/repo-big-brother-enforcer.log

[Install]
WantedBy=default.target
