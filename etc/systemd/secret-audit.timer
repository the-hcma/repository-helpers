# Daily timer for secret-audit (TruffleHog org deep scan).
#
# Template: ``etc/systemd/secret-audit.timer`` in this repository.
# scripts/setup-secret-audit enables this with systemctl --user enable --now
# on the ConditionHost machine. Requires user lingering there.

[Unit]
Description=Secret audit (TruffleHog) - daily schedule

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=true
Unit=secret-audit.service

[Install]
WantedBy=timers.target
