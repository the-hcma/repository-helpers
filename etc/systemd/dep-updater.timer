# Optional daily timer for Dependency Updater (dep-updater.service).
# Template: ``etc/systemd/dep-updater.timer`` in this repository.
# Installed by setup-service when present. Requires user lingering on the
# ConditionHost machine so the timer fires without an active login session.

[Unit]
Description=Dependency Updater — daily schedule

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true
Unit=dep-updater.service

[Install]
WantedBy=timers.target
