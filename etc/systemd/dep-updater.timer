# Optional daily timer for Dependency Updater (dep-updater.service).
# Omit this file when the service should be started manually only.
#
# ``setup-service`` enables this with ``systemctl --user enable --now``.
# Requires user lingering so the timer fires without an active login session.

[Unit]
Description=Dependency Updater — daily schedule

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true
Unit=dep-updater.service

[Install]
WantedBy=timers.target
