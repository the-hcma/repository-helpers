# Daily timer for GitHub Repo Lint (enforcer).
#
# scripts/setup-github-repo-lint enables this with systemctl --user enable --now.
# Requires user lingering so the timer fires without an active login session.

[Unit]
Description=GitHub Repo Lint (enforcer) - daily schedule

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
Unit=github-repo-lint.service

[Install]
WantedBy=timers.target
