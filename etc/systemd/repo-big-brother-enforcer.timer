# Daily timer for Repo Big Brother Enforcer.
#
# scripts/setup-repo-big-brother-enforcer enables this with systemctl --user enable --now.
# Requires user lingering so the timer fires without an active login session.

[Unit]
Description=Repo Big Brother Enforcer - daily schedule

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
Unit=repo-big-brother-enforcer.service

[Install]
WantedBy=timers.target
