# User systemd oneshot: Dependency Updater (batch dep-updater under a scan root).
#
# Installed by repository-helpers ``scripts/setup-service`` (substitutes
# ``@@REPO_DIR@@``). When ``dep-updater.timer`` exists in the same
# directory, setup-service enables a daily schedule; without a timer unit, only
# the service is installed (run manually via systemctl).
#
# ``scripts/dep-updater-batch-run`` requires ``~/.config/dep-updater.env``
# (copy from ``etc/dep-updater.env.example``). Fetches origin, runs batch-all, emails report.
#
# Logs: ``~/scratch/repository-helpers/dep-updater-batch.log``

[Unit]
Description=Dependency Updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/dep-updater.env
# Script enforces ``DEP_UPDATER_BATCH_TIMEOUT``; this is a safety limit (+30m for fetch/email).
TimeoutStartSec=4h 30min
TimeoutStopSec=2min
KillMode=control-group
ExecStart=@@REPO_DIR@@/scripts/dep-updater-batch-run
StandardOutput=append:%h/scratch/repository-helpers/dep-updater-batch.log
StandardError=append:%h/scratch/repository-helpers/dep-updater-batch.log

[Install]
WantedBy=default.target
