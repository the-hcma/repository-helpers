# User systemd oneshot: GitHub Repo Lint (enforcer).
#
# Template: ``etc/systemd/github-repo-lint.service`` in this repository.
# Installed by ``scripts/setup-github-repo-lint`` (substitutes @@REPO_DIR@@).
#
# scripts/github-repo-lint --enforcer reuses ~/.config/dep-updater.env for SMTP,
# with optional overrides from ~/.config/github-repo-lint.env.
#
# Logs: ~/scratch/repository-helpers/github-repo-lint.log

[Unit]
Description=GitHub Repo Lint (enforcer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-%h/.config/dep-updater.env
EnvironmentFile=-%h/.config/github-repo-lint.env
TimeoutStartSec=1h 30min
TimeoutStopSec=2min
KillMode=control-group
ExecStart=@@REPO_DIR@@/scripts/github-repo-lint
StandardOutput=append:%h/scratch/repository-helpers/github-repo-lint.log
StandardError=append:%h/scratch/repository-helpers/github-repo-lint.log

[Install]
WantedBy=default.target
