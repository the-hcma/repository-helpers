#!/usr/bin/env bash
# Tests for scripts/lib/gnu-sed.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

lib="${script_dir}/../scripts/lib/gnu-sed"
readonly lib
dep_script="${script_dir}/../scripts/dep-updater"
readonly dep_script

pass=0
fail=0

printf '\n=== static: gnu-sed defines helpers ===\n'
for fn in tooling_prereq_gnu_sed_path tooling_prereq_check_gnu_sed gnu_sed_inplace; do
  if grep -qF "${fn}()" "$lib"; then
    printf '[PASS] gnu-sed defines %s\n' "$fn"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] gnu-sed missing %s\n' "$fn"
    fail=$(( fail + 1 ))
  fi
done

printf '\n=== static: dep-updater uses gnu-sed, not raw sed -i ===\n'
if grep -qF 'lib/gnu-sed"' "$dep_script" \
  && grep -qF 'check_gnu_sed_prereqs' "$dep_script" \
  && grep -qF 'gnu_sed_inplace' "$dep_script" \
  && ! grep -qE 'sed -i' "$dep_script"; then
  printf '[PASS] dep-updater: gnu-sed wired; no raw sed -i\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater must source gnu-sed and avoid raw sed -i\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: tooling-path prepends gnu-sed gnubin ===\n'
path_lib="${script_dir}/../scripts/lib/tooling-path"
if grep -qF 'tooling_path_prepend_gnu_sed' "$path_lib" \
  && grep -qF 'tooling_path_prepend_gnu_userland' "$path_lib" \
  && grep -qF 'gnu-sed/libexec/gnubin' "$path_lib"; then
  printf '[PASS] tooling-path: prepend gnu-sed Homebrew gnubin\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling-path: missing gnu-sed prepend helper\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gnu sed available ===\n'
# shellcheck disable=SC1090,SC1091
source "$lib"
log_prereq() { printf '%s\n' "$*" >&2; }
if ! path="$(tooling_prereq_gnu_sed_path)"; then
  printf '[SKIP] functional: GNU sed not on PATH (macOS: brew install gnu-sed)\n'
else
  tmp="$(mktemp)"
  printf '  "openai==2.41.1",\n' >"$tmp"
  if gnu_sed_inplace -E "$tmp" \
    -e 's#("openai)(==)(2\.41\.1)"#\1>=2.44.0"#' \
    && grep -qF '"openai>=2.44.0",' "$tmp"; then
    printf '[PASS] functional: gnu_sed_inplace -E rewrites PEP 508 pin\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] functional: gnu_sed_inplace -E rewrite failed (sed=%s)\n' "$path"
    fail=$(( fail + 1 ))
  fi
  rm -f "$tmp"
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
