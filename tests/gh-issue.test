#!/usr/bin/env bash
# Tests for scripts/gh-issue (Markdown pre-flight; no live GitHub calls).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

cli="${script_dir}/../scripts/gh-issue"
readonly cli

printf '\n=== --help ===\n'
help_out=''
help_exit=0
help_out="$(bash "$cli" --help 2>&1)" || help_exit=$?
assert_exit_0 '--help' "$help_out" "$help_exit"
assert_contains '--help mentions body-file' "$help_out" 'body-file'
assert_contains '--help mentions lint' "$help_out" 'lint'

printf '\n=== create refuses dirty --body-file ===\n'
tmp="$(mktemp)"
printf '%s\n' \
  'This is a paragraph that has been hand-wrapped across multiple' \
  'physical lines using single newlines.' >"$tmp"
dirty_out=''
dirty_rc=0
dirty_out="$(bash "$cli" create --title 't' --body-file "$tmp" 2>&1)" || dirty_rc=$?
assert_exit_nonzero 'dirty body-file blocked' "$dirty_out" "$dirty_rc"
assert_contains 'dirty mentions GITHUB_MARKDOWN' "$dirty_out" 'GITHUB_MARKDOWN'
rm -f "$tmp"

printf '\n=== create refuses multi-line inline --body ===\n'
ml_out=''
ml_rc=0
ml_out="$(bash "$cli" create --title 't' --body $'line one\nline two' 2>&1)" || ml_rc=$?
assert_exit_nonzero 'multi-line --body blocked' "$ml_out" "$ml_rc"
assert_contains 'multi-line mentions single line' "$ml_out" 'single line'

printf '\n=== create refuses literal \\\\n in --body ===\n'
esc_out=''
esc_rc=0
esc_out="$(bash "$cli" create --title 't' --body 'line one\nline two' 2>&1)" || esc_rc=$?
assert_exit_nonzero 'literal escape --body blocked' "$esc_out" "$esc_rc"
assert_contains 'literal escape finding' "$esc_out" 'literal'

printf '\n=== static: gh stays on rate-limit line ===\n'
if rg -n -- 'github_api_exec_with_rate_limit_retry .*-- gh issue' "$cli" >/dev/null; then
  pass_case 'gh issue invoked via rate-limit helper'
else
  fail_case 'gh issue must stay on github_api_exec_with_rate_limit_retry line'
fi

test_summary
