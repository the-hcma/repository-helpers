#!/usr/bin/env bash
# Tests for scripts/dev/merge-stack: a stacked PR is landed with `gh stack merge`, a plain PR with
# `gh pr merge --auto --squash`, and a failed or unconfirmed enqueue is an error, never a silent success
# (repository-helpers#748).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

merge_stack="${script_dir}/../scripts/dev/merge-stack"
readonly merge_stack

# assert_eq <label> <actual> <expected>
assert_eq() {
  if [[ "$2" == "$3" ]]; then
    pass_case "$1"
  else
    printf '  expected [%s], got [%s]\n' "$3" "$2" >&2
    fail_case "$1"
  fi
}

work_dir="$(mktemp -d)"
readonly work_dir
trap 'rm -rf "${work_dir}"' EXIT
fake_bin="${work_dir}/bin"
gh_log="${work_dir}/gh.log"
mkdir -p "${fake_bin}"

# merge-stack reads the stacking-tool marker and the origin of the directory it runs in, so every case runs
# from a fixture clone instead of whatever directory the test was started from.
fixture_repo="${work_dir}/clone"
mkdir -p "${fixture_repo}/.github"
git -C "${fixture_repo}" init --quiet
git -C "${fixture_repo}" remote add origin https://github.com/the-hcma/example.git
printf 'gh-stack\n' >"${fixture_repo}/.github/stacking-tool"

# Fake gh. `gh pr view` applies the caller's --jq to the PR fixture; `gh stack view --json` prints the
# stack fixture (or fails like gh does outside a stack); the merge commands log and exit as told.
cat >"${fake_bin}/gh" <<'FAKE'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${FAKE_GH_LOG}"
case "$1 $2" in
  'pr view')
    filter='.'
    args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do
      if [[ "${args[$i]}" == '--jq' ]]; then filter="${args[$((i + 1))]}"; fi
    done
    if [[ "${filter}" == '.state' && -n "${FAKE_MERGED_AFTER_STATE_READS:-}" ]]; then
      reads=$(( $(cat "${FAKE_GH_LOG}.reads" 2>/dev/null || printf 0) + 1 ))
      printf '%s' "${reads}" >"${FAKE_GH_LOG}.reads"
      if (( reads > FAKE_MERGED_AFTER_STATE_READS )); then
        printf 'MERGED\n'
        exit 0
      fi
    fi
    exec jq -r "${filter}" "${FAKE_PR_FIXTURE}"
    ;;
  'api repos/'*)
    [[ -z "${FAKE_SETUP_FAIL:-}" ]] || exit 1
    printf '%s\n' "${FAKE_ALLOW_AUTO:-true}"
    exit 0
    ;;
  'api graphql')
    if [[ "$*" == *'mergeQueue(branch'* ]]; then
      [[ -z "${FAKE_SETUP_FAIL:-}" ]] || exit 1
      if (( ${FAKE_QUEUE_RULES:-0} > 0 )); then printf 'MQ_fake\n'; fi
      exit 0
    fi
    calls=$(( $(cat "${FAKE_GH_LOG}.queue" 2>/dev/null || printf 0) + 1 ))
    printf '%s' "${calls}" >"${FAKE_GH_LOG}.queue"
    if [[ -n "${FAKE_QUEUE_FAIL_AFTER:-}" ]] && (( calls > FAKE_QUEUE_FAIL_AFTER )); then
      exit 1
    fi
    if [[ -n "${FAKE_IN_QUEUE_CALLS:-}" ]] && (( calls > FAKE_IN_QUEUE_CALLS )); then
      printf 'false\n'
      exit 0
    fi
    printf '%s\n' "${FAKE_IN_QUEUE:-false}"
    exit 0
    ;;
  'stack view')
    if [[ -n "${FAKE_STACK_FAIL_AFTER:-}" ]]; then
      views=$(( $(cat "${FAKE_GH_LOG}.views" 2>/dev/null || printf 0) + 1 ))
      printf '%s' "${views}" >"${FAKE_GH_LOG}.views"
      if (( views > FAKE_STACK_FAIL_AFTER )); then
        printf 'timed out\n' >&2
        exit 1
      fi
    fi
    if [[ -n "${FAKE_NO_STACK:-}" ]]; then
      printf 'current branch is not part of a stack\n' >&2
      exit 2
    fi
    cat "${FAKE_STACK_FIXTURE}"
    ;;
  'stack merge')
    printf 'stack merge output\n'
    exit "${FAKE_STACK_MERGE_RC:-0}"
    ;;
  'pr merge')
    printf 'pr merge output\n'
    exit "${FAKE_PR_MERGE_RC:-0}"
    ;;
esac
exit 0
FAKE
chmod +x "${fake_bin}/gh"

pr_open='{"state":"OPEN","mergeStateStatus":"CLEAN","isDraft":false,"autoMergeRequest":null,"mergedAt":null}'
pr_queued='{"state":"OPEN","mergeStateStatus":"CLEAN","isDraft":false,"autoMergeRequest":{"enabledAt":"x"},"mergedAt":null}'
pr_merged='{"state":"MERGED","mergeStateStatus":"UNKNOWN","isDraft":false,"autoMergeRequest":null,"mergedAt":"2026-10-19T00:00:00Z"}'
stack_json='{"branches":[{"name":"a","pr":{"number":10},"isQueued":true},{"name":"b","pr":{"number":11},"isQueued":true}]}'
stack_unqueued_json='{"branches":[{"name":"a","pr":{"number":10},"isQueued":false},{"name":"b","pr":{"number":11},"isQueued":false}]}'
printf '%s' "${stack_json}" >"${work_dir}/stack.json"

# run_merge <pr-json> [env assignments…] -- <merge-stack args…>
run_merge() {
  local -r pr_json="$1"
  shift
  local -a envs=()
  while [[ "$1" != '--' ]]; do
    envs+=("$1")
    shift
  done
  shift
  printf '%s' "${pr_json}" >"${work_dir}/pr.json"
  : >"${gh_log}"
  rm -f "${gh_log}.views" "${gh_log}.reads" "${gh_log}.queue"
  rc=0
  out="$(cd "${fixture_repo}" && env PATH="${fake_bin}:${PATH}" MERGE_STACK_POLL_INTERVAL_S=0 MERGE_STACK_RETRY_SLEEP_S=0 FAKE_GH_LOG="${gh_log}" FAKE_PR_FIXTURE="${work_dir}/pr.json" \
    FAKE_STACK_FIXTURE="${work_dir}/stack.json" "${envs[@]+"${envs[@]}"}" \
    bash "${merge_stack}" "$@" 2>&1)" || rc=$?
}

printf '\n=== a stacked PR is merged with gh stack merge ===\n'
run_merge "${pr_open}" -- --pr 11
assert_eq 'a stacked PR exits 0 once queued' "${rc}" '0'
assert_contains 'the stack merge command is used' "$(<"${gh_log}")" 'stack merge --yes --squash'
assert_not_contains 'auto-merge is not attempted for a stacked PR' "$(<"${gh_log}")" 'pr merge'
assert_contains 'the restack follow-up is printed' "${out}" 'gh stack rebase'

run_merge "${pr_open}" -- --pr 11 --repo the-hcma/other
assert_contains 'a --repo that is not the current clone skips stack detection with a note' "${out}" 'stack detection is skipped'
assert_not_contains 'no gh stack merge is run for another repository' "$(<"${gh_log}")" 'stack merge'

run_merge "${pr_open}" -- --pr 10
assert_eq 'a stacked PR that is not the top of its stack exits 1' "${rc}" '1'
assert_contains 'the reason names the stack-number ambiguity' "${out}" 'read as a stack number first'
assert_not_contains 'nothing is merged for a lower PR' "$(<"${gh_log}")" 'stack merge'

run_merge "${pr_open}" FAKE_STACK_FAIL_AFTER=2 -- --pr 11
assert_eq 'a failed read of the stack readiness list stops the merge' "${rc}" '1'
assert_contains 'the unreadable list is named' "${out}" "could not read the stack's open PRs"
assert_not_contains 'nothing is merged when the stack cannot be read' "$(<"${gh_log}")" 'stack merge'

printf '\n=== a PR outside a stack is auto-merged ===\n'
run_merge "${pr_queued}" FAKE_NO_STACK=1 -- --pr 12
assert_eq 'a plain PR exits 0 when auto-merge is set' "${rc}" '0'
assert_contains 'gh pr merge --auto --squash is used' "$(<"${gh_log}")" 'pr merge 12 --auto --squash'
assert_not_contains 'gh stack merge is not used outside a stack' "$(<"${gh_log}")" 'stack merge'

printf '\n=== a plain PR is merged the way the repository is set up ===\n'
# With a merge queue GitHub ignores the method flag (and prints "The merge strategy for main is set by the
# merge queue"), so none is passed; without one auto-merge still needs --squash; with neither there is nothing to
# enqueue into, and the wrapper refuses instead of merging directly.
run_merge "${pr_queued}" FAKE_NO_STACK=1 FAKE_QUEUE_RULES=1 -- --pr 12
assert_eq 'a plain PR in a repository with a merge queue exits 0' "${rc}" '0'
assert_contains 'the queue path runs gh pr merge --auto with no method flag' "$(<"${gh_log}")" 'pr merge 12 --auto'
assert_not_contains 'the queue path passes no --squash' "$(<"${gh_log}")" '--squash'
assert_contains 'the effective merge queue of the PR base branch is read, whatever configures it' "$(<"${gh_log}")" 'mergeQueue(branch'
assert_contains 'the base branch is passed as a query variable' "$(<"${gh_log}")" 'b=main'
pr_queued_release='{"state":"OPEN","mergeStateStatus":"CLEAN","isDraft":false,"autoMergeRequest":{"enabledAt":"x"},"mergedAt":null,"baseRefName":"release/1#a"}'
run_merge "${pr_queued_release}" FAKE_NO_STACK=1 FAKE_QUEUE_RULES=1 -- --pr 12
assert_contains 'the queue is read for the PR own base branch, not main' "$(<"${gh_log}")" 'b=release/1#a'
run_merge "${pr_queued}" FAKE_NO_STACK=1 FAKE_QUEUE_RULES=0 FAKE_ALLOW_AUTO=true -- --pr 12
assert_contains 'without a merge queue but with auto-merge allowed --squash is kept' "$(<"${gh_log}")" 'pr merge 12 --auto --squash'
run_merge "${pr_open}" FAKE_NO_STACK=1 FAKE_QUEUE_RULES=0 FAKE_ALLOW_AUTO=false -- --pr 12
assert_eq 'a repository with neither a merge queue nor auto-merge exits 1' "${rc}" '1'
assert_contains 'the refusal names what to enable' "${out}" 'merge queue'
assert_contains 'the refusal names auto-merge as the alternative' "${out}" 'auto-merge'
assert_contains 'the refusal says nothing was merged' "${out}" 'nothing was merged'
assert_not_contains 'no merge command runs when there is nothing to enqueue into' "$(<"${gh_log}")" 'pr merge'
run_merge "${pr_open}" FAKE_NO_STACK=1 FAKE_SETUP_FAIL=1 -- --pr 12
assert_eq 'an unreadable merge setup exits 1' "${rc}" '1'
assert_contains 'the unreadable setup is named' "${out}" 'could not read the merge setup'
assert_not_contains 'no merge command runs when the setup cannot be read' "$(<"${gh_log}")" 'pr merge'

printf '\n=== a retired graphite marker is refused ===\n'
printf 'graphite\n' >"${fixture_repo}/.github/stacking-tool"
run_merge "${pr_queued}" FAKE_NO_STACK=1 -- --pr 12
assert_eq 'a graphite marker exits 1' "${rc}" '1'
assert_contains 'the refusal says Graphite is retired' "${out}" 'Graphite is retired'
assert_contains 'the refusal points at the retirement issue' "${out}" 'repository-helpers#772'
assert_not_contains 'no merge command runs for a graphite marker' "$(<"${gh_log}")" 'merge 12'
printf 'gh-stack\n' >"${fixture_repo}/.github/stacking-tool"

printf '\n=== a one-branch stack is not a GitHub stack ===\n'
# A branch registered locally with `gh stack init` and submitted alone has one PR and no stack on GitHub, so
# `gh stack merge` refuses it ("this stack has not been submitted to GitHub yet"); it must be auto-merged.
single_json='{"trunk":"main","currentBranch":"solo","branches":[{"name":"solo","pr":{"number":13},"isMerged":false,"isQueued":false}]}'
printf '%s' "${single_json}" >"${work_dir}/stack.json"
run_merge "${pr_queued}" -- --pr 13
assert_eq 'a PR that is alone in its local stack exits 0 when auto-merge is set' "${rc}" '0'
assert_contains 'a lone branch is auto-merged with gh pr merge' "$(<"${gh_log}")" 'pr merge 13 --auto --squash'
assert_not_contains 'gh stack merge is not run for a lone branch' "$(<"${gh_log}")" 'stack merge'
assert_contains 'the plain path is announced' "${out}" 'is not in a stack'
printf '%s' "${stack_json}" >"${work_dir}/stack.json"

printf '\n=== a half-submitted stack is an error, not a plain merge ===\n'
# Several local branches but only one with a PR: merging that one layer on its own would quietly land part of a
# stack. It stops and asks for `gh stack submit` first; a lone branch (above) and a PR with no stack still go plain.
half_json='{"trunk":"main","currentBranch":"b","branches":[{"name":"a","pr":{"number":14},"isMerged":false,"isQueued":false},{"name":"b","isMerged":false,"isQueued":false}]}'
printf '%s' "${half_json}" >"${work_dir}/stack.json"
run_merge "${pr_queued}" -- --pr 14
assert_eq 'a stack with a branch that has no PR exits 1' "${rc}" '1'
assert_contains 'the reason names the missing PRs and the fix' "${out}" 'gh stack submit'
assert_not_contains 'nothing is auto-merged for a half-submitted stack' "$(<"${gh_log}")" 'pr merge'
assert_not_contains 'nothing is stack-merged for a half-submitted stack' "$(<"${gh_log}")" 'stack merge'
printf '%s' "${stack_json}" >"${work_dir}/stack.json"

printf '\n=== failures are errors, not silent successes ===\n'
run_merge "${pr_open}" FAKE_STACK_MERGE_RC=1 -- --pr 11
assert_eq 'a failed stack merge exits 2' "${rc}" '2'
assert_contains 'the merge command output is shown, not hidden' "${out}" 'stack merge output'
assert_contains 'the failure says nothing was queued' "${out}" 'nothing was queued'
printf '%s' "${stack_unqueued_json}" >"${work_dir}/stack.json"
run_merge "${pr_open}" -- --pr 11
assert_eq 'a stack merge that exits 0 but leaves no queue entry exits 2' "${rc}" '2'
assert_contains 'the unconfirmed stacked enqueue is named' "${out}" 'it was not queued'
printf '%s' "${stack_json}" >"${work_dir}/stack.json"
run_merge "${pr_open}" FAKE_NO_STACK=1 -- --pr 12
assert_eq 'a plain PR with no auto-merge request after the command exits 2' "${rc}" '2'
assert_contains 'the unconfirmed enqueue is named' "${out}" 'it was not queued'
run_merge "$(printf '%s' "${pr_open}" | sed 's/CLEAN/BLOCKED/')" -- --pr 11
assert_eq 'a PR that is not ready exits 2' "${rc}" '2'
assert_contains 'the not-ready state is reported' "${out}" 'mergeStateStatus=BLOCKED'
assert_not_contains 'no merge command runs for a PR that is not ready' "$(<"${gh_log}")" 'merge 11'
run_merge "$(printf '%s' "${pr_open}" | sed 's/"isDraft":false/"isDraft":true/')" -- --pr 11
assert_eq 'a draft PR exits 2' "${rc}" '2'
run_merge "${pr_merged}" -- --pr 11
assert_eq 'an already merged PR exits 0' "${rc}" '0'
assert_not_contains 'nothing is run for an already merged PR' "$(<"${gh_log}")" 'merge 11'
run_merge "${pr_open}" -- --pr abc
assert_eq 'a non-numeric PR exits 1' "${rc}" '1'

run_merge "$(printf '%s' "${pr_queued}" | sed 's/CLEAN/BLOCKED/')" FAKE_NO_STACK=1 -- --pr 12
assert_eq 'a plain PR whose checks are still pending still gets auto-merge' "${rc}" '0'
assert_contains 'auto-merge is requested for the pending plain PR' "$(<"${gh_log}")" 'pr merge 12 --auto --squash'
help_out="$(bash "${merge_stack}" --help 2>&1)"
assert_not_contains '--help does not print the script body' "${help_out}" 'set -euo pipefail'
assert_contains '--help shows the usage line' "${help_out}" 'merge-stack --pr <number>'

run_merge "${pr_open}" FAKE_NO_STACK=1 FAKE_IN_QUEUE=true -- --pr 12
assert_eq 'a plain PR that is in the merge queue (auto-merge request already consumed) is confirmed' "${rc}" '0'
printf '%s' "${stack_unqueued_json}" >"${work_dir}/stack.json"
run_merge "${pr_open}" FAKE_IN_QUEUE=true -- --pr 11
assert_eq 'a stacked PR with a merge queue entry is confirmed even when the stack shows no queue state' "${rc}" '0'
printf '%s' "${stack_json}" >"${work_dir}/stack.json"

printf '\n=== --wait reports a merge or a machine-parseable timeout ===\n'
run_merge "${pr_merged}" -- --pr 11 --wait
assert_eq '--wait on a merged PR exits 0' "${rc}" '0'
run_merge "${pr_open}" -- --pr 11 --wait --timeout 0
assert_eq '--wait with an exhausted timeout exits 3' "${rc}" '3'
assert_contains 'the timeout is one ERROR: WAIT_TIMEOUT line' "${out}" 'ERROR: WAIT_TIMEOUT merge-stack pr=11'
run_merge "${pr_open}" FAKE_MERGED_AFTER_STATE_READS=3 -- --pr 11 --wait
assert_eq '--wait polls an open PR until it merges and exits 0' "${rc}" '0'
assert_contains '--wait reports the merge' "${out}" 'PR #11 merged'
run_merge "${pr_open}" FAKE_NO_STACK=1 FAKE_IN_QUEUE=true FAKE_IN_QUEUE_CALLS=1 -- --pr 12 --wait
assert_eq '--wait on a plain PR that left the queue exits 2' "${rc}" '2'
assert_contains '--wait names the dropped PR' "${out}" 'is no longer queued'
run_merge "${pr_open}" FAKE_NO_STACK=1 FAKE_IN_QUEUE=true FAKE_IN_QUEUE_CALLS=1 FAKE_MERGED_AFTER_STATE_READS=2 -- --pr 12 --wait
assert_eq '--wait reports a merge, not a drop, when the PR merges between the reads' "${rc}" '0'
assert_contains '--wait names the merged PR after the re-read' "${out}" 'PR #12 merged'
run_merge "${pr_open}" FAKE_NO_STACK=1 FAKE_IN_QUEUE=true FAKE_QUEUE_FAIL_AFTER=1 -- --pr 12 --wait --timeout 1
assert_eq '--wait keeps polling when the queue read fails and ends in the timeout' "${rc}" '3'
assert_not_contains '--wait does not call an unreadable queue dropped' "${out}" 'no longer queued'

printf '\n=== static: wiring ===\n'
help_out="$(bash "${merge_stack}" --help 2>&1)"
assert_not_contains '--help does not document a positional gh stack merge' "${help_out}" 'gh stack merge <pr>'
if grep -E 'gh (stack|pr) merge[^#]*\|[[:space:]]*(tail|head)' "${merge_stack}" >/dev/null; then
  fail_case 'merge-stack does not pipe the merge command through tail or head'
else
  pass_case 'merge-stack does not pipe the merge command through tail or head'
fi

test_summary
