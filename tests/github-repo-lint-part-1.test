action_yml="${rh_root}/actions/setup-pnpm-corepack/action.yml"
if [[ -f "$action_yml" ]] \
  && grep -q '^rp_package_json_has_exact_pnpm_package_manager()' "$lib" \
  && grep -q '^rp_validate_pnpm_ci_corepack()' "$lib" \
  && grep -qF 'rp_check_pnpm_corepack_ci' "$lib" \
  && grep -qF 'corepack prepare' "$action_yml" \
  && grep -qE '^[[:space:]]*uses:[[:space:]]*actions/cache@[0-9a-f]{40}([[:space:]]|#|$)' "$action_yml" \
  && grep -q '^rp_helpers_setup_pnpm_corepack_nested_uses_sha_pinned()' "$lib" \
  && grep -q '^rp_actions_workflows_setup_pnpm_nested_uses_sha_pinned()' "$lib"; then
