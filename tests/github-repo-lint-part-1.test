  exit 1
fi
if [[ "${1:-}" == "issue" && "${2:-}" == "create" ]]; then
  echo 'ERROR: should not create on list failure' >&2
  exit 0
fi
exit 0
MOCK_GH
chmod +x "${mock_bin}/gh"
cat >>"$cve_list_funcs" <<'DRIVER'
audit_json='audit.json'
issue_title='CVE check: pip-audit findings'
