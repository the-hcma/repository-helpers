cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

# shellcheck disable=SC2154
if [[ "$exit_code" -ne 0 ]] \
  && grep -qF "pnpm-workspace.yaml must set minimumReleaseAge: ${release_age_dep_updater_minutes}" <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] pnpm-release-age: wrong minimumReleaseAge fails with suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-release-age: expected failure for stale minimumReleaseAge (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: pnpm Corepack CI requires packageManager and bans action-setup ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

# package.json without packageManager
pkg_b64="$(printf '%s' '{"name":"x"}' | base64 -w0)"
# ci.yml with pnpm/action-setup + unquoted cache: pnpm (valid YAML)
ci_b64="$(printf '%s' $'jobs:\n  ci:\n    steps:\n      - uses: pnpm/action-setup@v6.0.9\n        with:\n          version: latest\n      - uses: actions/setup-node@v6.4.0\n        with:\n          cache: pnpm\n' | base64 -w0)"

cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "\$args" == *'/labels'* ]]; then
  printf '%s\n' '[[{"name":"merge-it"}]]'
  exit 0
fi
if [[ "\$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "\$args" == *'contents/.github/workflows'* && "\$args" != *'.yml'* ]]; then
  printf '%s\n' '[{"type":"file","name":"ci.yml"}]'
  exit 0
fi
if [[ "\$args" == *'contents/pnpm-lock.yaml'* ]]; then
  printf '%s\n' '{"content":"bG9ja2ZpbGVWZXJzaW9uOiAnOS4wJwo="}'
  exit 0
fi
if [[ "\$args" == *'contents/package.json'* ]]; then
  printf '%s\n' '{"content":"${pkg_b64}"}'
  exit 0
fi
if [[ "\$args" == *'contents/.github/workflows/ci.yml'* ]]; then
  printf '%s\n' '{"content":"${ci_b64}"}'
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  if [[ "\$args" == *'repository-helpers'* ]]; then
    printf '%s\n' "{\"content\":\"\${GRL_LOCAL_B64}\"}"
  else
    printf '%s\n' "{\"content\":\"\${GRL_CONSUMER_B64}\"}"
  fi
  exit 0
fi
if [[ "\$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"\${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'must set exact "packageManager": "pnpm@X.Y.Z"' <<<"$output" \
  && grep -qF 'must not use pnpm/action-setup' <<<"$output" \
  && grep -qF "must not set setup-node cache: 'pnpm'" <<<"$output"; then
  printf '[PASS] pnpm-corepack: missing packageManager and action-setup fail\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-corepack: expected packageManager/action-setup failures (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: default audit runs full checks for strict repos ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
