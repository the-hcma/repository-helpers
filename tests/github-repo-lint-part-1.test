if [[ "$cve_fail_exit" -ne 0 ]] \
  && grep -qF 'ERROR: pip-audit found CVEs but failed to create security/cve issue' <<<"$cve_fail_output"; then
  printf '[PASS] cve-check template exits non-zero when gh issue create fails\n'
