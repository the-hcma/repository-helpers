printf '\n=== functional: cve-check template treats unexpected JSON shape as transient, not clean ===\n'
cve_shape_tmp="$(mktemp -d)"
cve_shape_funcs="${cve_shape_tmp}/cve-funcs.bash"
awk '
  /^[[:space:]]*run: \|[[:space:]]*$/ {
    in_run = 1
    next
  }
  in_run {
    if ($0 ~ /^          /) {
      sub(/^          /, "")
      print
      next
    }
    if ($0 ~ /^[[:space:]]*$/) {
      print ""
      next
    }
    in_run = 0
  }
' "$cve_template" | sed '/^while (( attempt/,$d' >"$cve_shape_funcs"
# pip-audit's JSON output is not a versioned contract — a well-formed but
# unexpected top-level shape (here: an empty object, missing .dependencies)
# must not be classified "clean" (which would silently close open
# security/cve issues via close_resolved_cve_issues).
cat >"${cve_shape_tmp}/audit.json" <<'AUDIT_JSON'
{}
AUDIT_JSON
cat >>"$cve_shape_funcs" <<'DRIVER'
classify_audit_json 'audit.json'
DRIVER
cve_shape_output=""
cve_shape_output="$(cd "${cve_shape_tmp}" && bash "$cve_shape_funcs" 2>&1)"
if [[ "$cve_shape_output" == 'transient' ]]; then
  printf '[PASS] cve-check template classifies unexpected JSON shape as transient, not clean\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cve-check template classified unexpected JSON shape as %s (expected transient)\n' \
    "$cve_shape_output"
  fail=$(( fail + 1 ))
fi
rm -rf "$cve_shape_tmp"

printf '\n=== functional: cve-check template treats renamed per-dependency vulns field as transient ===\n'
cve_renamed_tmp="$(mktemp -d)"
cve_renamed_funcs="${cve_renamed_tmp}/cve-funcs.bash"
awk '
  /^[[:space:]]*run: \|[[:space:]]*$/ {
    in_run = 1
    next
  }
  in_run {
    if ($0 ~ /^          /) {
      sub(/^          /, "")
      print
      next
    }
    if ($0 ~ /^[[:space:]]*$/) {
      print ""
      next
    }
    in_run = 0
  }
' "$cve_template" | sed '/^while (( attempt/,$d' >"$cve_renamed_funcs"
# .dependencies is a well-formed array (passes the top-level guard above), but
# pip-audit renamed the per-dependency vulns field — .vulns // [] in the CVE
# filter would silently default to "no vulns", classifying real CVEs "clean".
cat >"${cve_renamed_tmp}/audit.json" <<'AUDIT_JSON'
{"dependencies":[{"name":"example-pkg","version":"1.0.0","vulnerabilities":[{"id":"CVE-2024-0001"}]}]}
AUDIT_JSON
cat >>"$cve_renamed_funcs" <<'DRIVER'
classify_audit_json 'audit.json'
DRIVER
cve_renamed_output=""
cve_renamed_output="$(cd "${cve_renamed_tmp}" && bash "$cve_renamed_funcs" 2>&1)"
if [[ "$cve_renamed_output" == 'transient' ]]; then
  printf '[PASS] cve-check template classifies renamed per-dependency vulns field as transient, not clean\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cve-check template classified renamed vulns field as %s (expected transient)\n' \
    "$cve_renamed_output"
  fail=$(( fail + 1 ))
fi
rm -rf "$cve_renamed_tmp"

printf '\n=== functional: cve-check template treats empty dependencies list as transient ===\n'
cve_empty_tmp="$(mktemp -d)"
cve_empty_funcs="${cve_empty_tmp}/cve-funcs.bash"
awk '
  /^[[:space:]]*run: \|[[:space:]]*$/ {
    in_run = 1
    next
  }
  in_run {
    if ($0 ~ /^          /) {
      sub(/^          /, "")
      print
      next
    }
    if ($0 ~ /^[[:space:]]*$/) {
      print ""
      next
    }
    in_run = 0
  }
' "$cve_template" | sed '/^while (( attempt/,$d' >"$cve_empty_funcs"
# jq's all() over a zero-length stream is true, so {"dependencies": []} passed
# the earlier guards and the CVE filter (length > 0) was then false — the
# exact fall-through the guard was added to prevent. A uv+pyproject repo
# always has real dependencies, so a truly empty scan means the environment
# broke (failed sync, --skip-editable filtering everything), not "clean".
cat >"${cve_empty_tmp}/audit.json" <<'AUDIT_JSON'
{"dependencies":[]}
AUDIT_JSON
cat >>"$cve_empty_funcs" <<'DRIVER'
classify_audit_json 'audit.json'
DRIVER
cve_empty_output=""
cve_empty_output="$(cd "${cve_empty_tmp}" && bash "$cve_empty_funcs" 2>&1)"
if [[ "$cve_empty_output" == 'transient' ]]; then
  printf '[PASS] cve-check template classifies empty dependencies list as transient, not clean\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cve-check template classified empty dependencies list as %s (expected transient)\n' \
    "$cve_empty_output"
  fail=$(( fail + 1 ))
fi
rm -rf "$cve_empty_tmp"

printf '\n=== functional: cve-check template tolerates a real pip-audit --skip-editable shape ===\n'
cve_skip_tmp="$(mktemp -d)"
cve_skip_funcs="${cve_skip_tmp}/cve-funcs.bash"
awk '
  /^[[:space:]]*run: \|[[:space:]]*$/ {
    in_run = 1
    next
  }
  in_run {
    if ($0 ~ /^          /) {
      sub(/^          /, "")
      print
      next
    }
    if ($0 ~ /^[[:space:]]*$/) {
      print ""
      next
    }
    in_run = 0
  }
' "$cve_template" | sed '/^while (( attempt/,$d' >"$cve_skip_funcs"
# pip-audit --skip-editable still reports the project's own editable install
# in .dependencies[], with no vulns key at all — e.g.
# {"name":"home-warden","skip_reason":"distribution marked as editable"}
# (verified against a real `pip-audit --skip-editable --format=json` run on a
# uv project). The has("vulns") guard added above must not treat this
# skip_reason shape as a tool error, or every real CVE-check run would
# classify transient and fail after 3 retries — a regression caught by
# review before this landed (repository-helpers#636).
cat >"${cve_skip_tmp}/audit.json" <<'AUDIT_JSON'
{"dependencies":[{"name":"home-warden","skip_reason":"distribution marked as editable"},{"name":"example-pkg","version":"1.0.0","vulns":[]}]}
AUDIT_JSON
cat >>"$cve_skip_funcs" <<'DRIVER'
classify_audit_json 'audit.json'
DRIVER
cve_skip_output=""
cve_skip_output="$(cd "${cve_skip_tmp}" && bash "$cve_skip_funcs" 2>&1)"
if [[ "$cve_skip_output" == 'clean' ]]; then
  printf '[PASS] cve-check template tolerates a real pip-audit --skip-editable shape\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cve-check template rejected a real pip-audit --skip-editable shape as %s (expected clean)\n' \
    "$cve_skip_output"
  fail=$(( fail + 1 ))
fi
rm -rf "$cve_skip_tmp"

printf '\n=== static: cleanup-merged-branches deletes Graphite MQ branches ===\n'
gtmq_template="${templates_dir}/cleanup-merged-branches.yml"
if grep -qF 'gtmq_batch_' "$gtmq_template" \
