args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[{"name":"merge-it"}]]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":""}'
  exit 0
fi
if [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/dependabot.yml'* ]]; then
  # npm cooldown is 9 days (policy requires release_age_dependabot_days)
  printf '%s\n' '{"content":"dmVyc2lvbjogMgp1cGRhdGVzOgogIC0gcGFja2FnZS1lY29zeXN0ZW06ICJucG0iCiAgICBkaXJlY3Rvcnk6ICIvIgogICAgc2NoZWR1bGU6CiAgICAgIGludGVydmFsOiB3ZWVrbHkKICAgIGNvb2xkb3duOgogICAgICBkZWZhdWx0LWRheXM6IDkK"}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_LOCAL_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

# shellcheck disable=SC2154
if [[ "$exit_code" -ne 0 ]] \
  && grep -qF "dependabot.yml must set cooldown default-days: ${release_age_dependabot_days} on every updates entry" <<<"$output"; then
  printf '[PASS] dependabot-cooldown: wrong default-days value fails\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dependabot-cooldown: expected failure for wrong default-days (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: pnpm minimumReleaseAge enforced ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
