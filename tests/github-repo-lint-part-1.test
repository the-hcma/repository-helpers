  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo thehcma/rusty-jack --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'protect-main ruleset' <<<"$output" \
  && grep -qF 'classic main branch protection' <<<"$output" \
  && grep -qF 'missing .github/workflows/ci.yml (required for GitHub merge queue checks)' <<<"$output" \
  && grep -qF 'license file (LICENSE)' <<<"$output" \
  && grep -qF 'CODEOWNERS (.github/CODEOWNERS)' <<<"$output" \
  && grep -qF 'pr-ship-and-review agents rule + Cursor shim' <<<"$output"; then
  printf '[PASS] full-default: strict repo without GitHub MQ runs protect/classic/MQ/metadata checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-default: expected comprehensive strict-repo failures (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"

if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
