if grep -qF 'source "${rp_lib_dir}/release-age-defaults"' "$lib" \
  && grep -q '^rp_dependabot_has_release_age_cooldown()' "$lib" \
  && grep -q '^rp_check_dependabot_release_age_policy()' "$lib" \
  && grep -q '^rp_check_pnpm_release_age_policy()' "$lib" \
  && grep -q '^rp_check_pnpm_corepack_ci()' "$lib" \
  && grep -qF 'required_days="$release_age_dependabot_days"' "$lib" \
  && grep -qF 'required_minutes="$release_age_dep_updater_minutes"' "$lib" \
