#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices — part 1 of 6.
# Split from the former aa-github-repo-lint.test so CI can run the parts in parallel (#692).
# To add a test, read the how-to at the top of tests/lib/github-repo-lint-part-init first.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck source=tests/lib/github-repo-lint-part-init
source "${script_dir}/lib/github-repo-lint-part-init"

pass=0
fail=0

printf '\n=== static: scripts and library ===\n'
if [[ -f "$checker" && -f "$lib" && -f "$merge_wrapper" ]]; then
  printf '[PASS] github-repo-lint, lib/repo-practices, and merge wrapper exist\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing github-repo-lint entrypoints\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_log_manual_step' "$lib" \
  && grep -qF 'rp_log_check_ok' "$lib" \
  && grep -qF 'rp_github_url' "$lib" \
  && grep -qF 'rp_print_final_status' "$lib" \
  && grep -qF 'rp_resolve_git_context_slug' "$lib" \
  && grep -qF 'rp_validate_workflow_file_extensions' "$lib" \
  && grep -qF 'rp_validate_branch_cleanup_workflows' "$lib" \
  && grep -qF 'rp_print_new_repo_checklist' "$lib" \
  && grep -qF 'rp_check_protect_main_ruleset' "$lib" \
  && grep -qF 'rp_check_classic_main_protection' "$lib" \
  && grep -qF 'rp_check_license_metadata' "$lib" \
  && grep -qF 'rp_check_pr_ship_and_review_rule' "$lib" \
  && grep -qF 'rp_pr_ship_and_review_rule_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/pr-ship-and-review.mdc' "$lib" \
  && grep -qF 'rp_check_stacking_tool' "$lib" \
  && grep -qF 'rp_check_secret_audit_intake' "$lib" \
  && grep -qF 'lib/secret-audit' "$lib" \
  && grep -qF 'rp_check_stacking_docs_consistency' "$lib" \
  && grep -qF 'rp_stacking_tool_rule_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/stacking-tool.mdc' "$lib" \
  && grep -qF 'rp_check_git_commit_identity' "$lib" \
  && grep -qF 'rp_git_commit_identity_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/git-commit-identity.mdc' "$lib" \
  && grep -qF 'rp_check_no_secret_exposure' "$lib" \
  && grep -qF 'rp_no_secret_exposure_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/no-secret-exposure.mdc' "$lib" \
  && grep -qF 'rp_check_remote_timeouts_retries' "$lib" \
  && grep -qF 'rp_remote_timeouts_retries_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/remote-timeouts-retries.mdc' "$lib" \
  && grep -qF 'rp_check_read_agents_and_rules' "$lib" \
  && grep -qF 'rp_read_agents_and_rules_is_valid' "$lib" \
  && grep -qF 'rp_org_agents_rule_dual_path_outcome' "$lib" \
  && grep -qF 'rp_cursor_rule_shim_is_valid' "$lib" \
  && grep -qF 'rp_queue_org_agents_rule_pair' "$lib" \
  && grep -qF 'repo-practices-agents/rules/' "$lib" \
  && grep -qF 'repo-practices-cursor/read-agents-and-rules.mdc' "$lib" \
  && grep -qF 'rp_check_agent_bootstrap' "$lib" \
  && grep -qF 'rp_agents_md_documents_cursor_rules' "$lib" \
  && grep -qF 'rp_claude_md_shim_is_valid' "$lib" \
  && grep -qF 'rp_copilot_instructions_shim_is_valid' "$lib" \
  && grep -qF 'repo-practices-agents/CLAUDE.md' "$lib" \
  && grep -qF 'add-claude-md-shim' "$lib" \
  && grep -qF 'add-copilot-instructions-shim' "$lib" \
  && grep -qF 'rp_agents_rules_instructions_is_valid' "$lib" \
  && grep -qF 'add-agents-rules-instructions' "$lib" \
  && grep -qF 'rp_check_repo_practices_after_config_change' "$lib" \
  && grep -qF 'rp_repo_practices_after_config_change_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/repo-practices-after-config-change.mdc' "$lib" \
  && grep -qF 'lib/stacking-tool' "$lib" \
  && grep -qF 'rp_fetch_repo_license_file' "$lib" \
  && grep -qF 'rp_text_has_copyright_notice' "$lib" \
  && grep -qF 'rp_fetch_repo_codeowners_file' "$lib" \
  && grep -qF 'rp_apply_codeowners_pr' "$lib" \
  && grep -qF 'rp_apply_candidate_fix_stack' "$lib" \
  && grep -qF -- '--apply-fix|--apply' "$lib" \
  && grep -qF 'rp_authenticated_github_login' "$lib" \
  && grep -qF 'rp_discover_ci_status_contexts' "$lib" \
  && grep -qF 'rp_compact_print_report' "$lib" \
  && grep -qF 'rp_print_failure_summary' "$lib" \
  && grep -qF 'rp_track_failures' "$lib" \
  && grep -qF 'rp_repo_requires_protect_main_ruleset' "$lib" \
  && grep -qF 'rp_protect_main_create_payload' "$lib" \
  && grep -qF 'rp_check_github_merge_queue' "$lib" \
  && grep -qF 'rp_ruleset_has_github_merge_queue' "$lib" \
  && grep -qF 'rp_ruleset_requires_signatures' "$lib" \
  && grep -qF 'rp_validate_ruleset_required_signatures' "$lib" \
  && grep -qF 'required_signatures' "$lib" \
  && grep -qF 'rp_ruleset_requires_code_owner_review' "$lib" \
  && grep -qF 'rp_ruleset_has_org_admin_bypass' "$lib" \
  && grep -qF 'rp_validate_ruleset_code_owner_review' "$lib" \
  && grep -qF 'rp_check_main_commit_verification' "$lib" \
  && grep -qF 'cleanup-merged-branches.yml' "$lib" \
  && grep -qF 'rp_cleanup_merged_branches_workflow_is_canonical' "$lib" \
  && grep -qF 'rp_gh_path_check' "$lib" \
  && grep -qF 'rp_gh_api_detail_is_not_found' "$lib" \
  && grep -qF 'rp_gh_api_detail_is_transient' "$lib"; then
  printf '[PASS] library defines branch cleanup, metadata, CODEOWNERS, and checklist helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected branch cleanup and new-repo helpers in lib/repo-practices\n'
  fail=$(( fail + 1 ))
fi

# grep -F '--auto' treats --auto as a grep option; require -- end-of-options.
# shellcheck disable=SC2016  # static assert matches literal source text
if [[ "$(grep -cF "grep -qF -- '--auto'" "$lib" || true)" -ge 2 ]]; then
  printf '[PASS] dependabot auto-merge check greps --auto with end-of-options\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dependabot auto-merge check must use grep -qF -- '\''--auto'\''\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'rp_log_manual_step' "$lib" \
  && grep -A20 '^rp_log_manual_step()' "$lib" | grep -qF 'rp_compact' \
  && ! grep -A20 '^rp_log_manual_step()' "$lib" | grep -qF 'rp_compact_record_fix'; then
  printf '[PASS] compact mode omits unverifiable manual steps from Fix lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_log_manual_step should not record compact Fix lines\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: repo-practices has no hardcoded consumer repo names ===\n'
if rp_assert_no_hardcoded_consumer_repo_names "$lib"; then
  printf '[PASS] repo-practices avoids hardcoded consumer org repo slugs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices contains hardcoded consumer org repo slugs\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: repo-practices runner adoption ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'runner-ensure' "$lib" \
  && grep -qF 'rp_runner_gh_api_stream' "$lib" \
  && grep -qF 'rp_runner_git_stream' "$lib" \
  && grep -qF 'rp_runner_jq_file' "$lib"; then
  printf '[PASS] repo-practices lib: runner-ensure and rp_runner helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices lib: missing runner helpers\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'lib/runner-bootstrap' "$checker" \
  && grep -qF 'lib/runner-bootstrap' "$merge_wrapper"; then
  printf '[PASS] github-repo-lint and check-merge-settings bootstrap runner\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] checker scripts should source lib/runner-bootstrap\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: private repo discovery filter ===\n'
if grep -qF 'rp_include_private' "$lib" \
  && grep -qF 'include-private' "$lib" \
  && grep -qF 'select(.private == false)' "$lib" \
  && grep -qF 'GITHUB_REPO_LINT_INCLUDE_PRIVATE' "$lib" \
  && grep -qF 'github-repo-slug' "$lib"; then
  printf '[PASS] repo-practices skips private repos in org discovery by default\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected private-repo filter helpers in lib/repo-practices\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_discover_org_repos' "$checker" \
  && grep -qF 'enforcer_discover_repo_slugs' "$checker" \
  && grep -qF 'rp_include_private=1' "$checker"; then
  printf '[PASS] github-repo-lint enforcer discovers org repos via GitHub API\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected enforcer org API discovery in github-repo-lint\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: repo labels fetch captures stdout ===\n'
# shellcheck disable=SC2016  # grep for literal command substitution in lib source
# rp_runner_gh_api_stream uses rate-limit retry and emits stdout only on success
# (no mid-attempt stream), so labels stay capture-safe under pagination retries.
if grep -qF 'rp_runner_gh_api_stream "repo-practices repo labels"' "$lib" \
  && grep -qF 'labels_json="$(rp_fetch_repo_labels_json' "$lib"; then
  printf '[PASS] labels: repo labels API uses rate-limit capture (no stream leak)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] labels: expected rp_fetch_repo_labels_json via rate-limit gh api stream\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: rp_fetch_repo_labels_json folds slurped pages without gh --slurp + --jq ===\n'
# SC2317/SC2329: stubs are consumed by the sourced function body.
# shellcheck disable=SC2317,SC2329
labels_fetch_out="$(
  rp_runner_gh_api_stream() {
    shift
    local arg has_slurp=0 has_jq=0
    for arg in "$@"; do
      [[ "$arg" == '--slurp' ]] && has_slurp=1
      [[ "$arg" == '--jq' || "$arg" == '-q' ]] && has_jq=1
    done
    if (( has_slurp && has_jq )); then
      printf 'the --slurp option is not supported with --jq or --template\n' >&2
      return 1
    fi
    printf '%s\n' '[[{"name":"a"},{"name":"dep-updater"}],[{"name":"security"}]]'
  }
  rp_runner_jq_file() {
    local input="$2"
    shift 2
    jq "$@" <<<"$input"
  }
  # shellcheck disable=SC1090
  source <(awk '/^rp_fetch_repo_labels_json\(\)/,/^}$/' "$lib")
  rp_fetch_repo_labels_json "the-hcma/demo"
)"
if [[ "$labels_fetch_out" == '["a","dep-updater","security"]' ]]; then
  printf '[PASS] labels: paginated pages are combined into one name array under real gh flag rules\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] labels: expected ["a","dep-updater","security"], got: %s\n' "$labels_fetch_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: standard labels (dep-updater, security) are provisioned (repository-helpers#684) ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF "rp_STANDARD_LABEL_NAMES=(dep-updater security)" "$lib" \
  && grep -qF "[dep-updater]='0075ca'" "$lib" \
  && grep -qF "[security]='b60205'" "$lib" \
  && grep -qF 'rp_check_standard_labels()' "$lib" \
  && grep -qF 'labels_json="$(rp_fetch_repo_labels_json "$slug")"' "$lib" \
  && grep -qF 'rp_apply_create_label "$slug" "$name"' "$lib" \
  && grep -qF 'rp_check_standard_labels "$slug"' "$lib"; then
  printf '[PASS] standard labels: rp_check_standard_labels checks dep-updater/security and is wired into rp_check_one_repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] standard labels: expected rp_check_standard_labels + rp_STANDARD_LABEL_* wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: rp_apply_create_label POSTs to the labels endpoint via a temp-file body ===\n'
# shellcheck disable=SC2016  # assert literal POST path in source
if grep -qF 'rp_apply_create_label()' "$lib" \
  && grep -qF "'{name: \$name, color: \$color, description: \$description}'" "$lib" \
  && grep -qF -- '--method POST "repos/${slug}/labels"' "$lib"; then
  printf '[PASS] rp_apply_create_label: POSTs name/color/description to repos/{slug}/labels\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_apply_create_label: expected a POST to repos/{slug}/labels with name/color/description\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: rp_check_standard_labels creates a missing label under --apply-fix ===\n'
std_label_tmp="$(mktemp -d)"
std_label_log="${std_label_tmp}/apply.log"
: >"$std_label_log"
# SC2317/SC2329/SC2034: stubs and rp_apply_fix are consumed by the sourced
# rp_check_standard_labels body, invisible to shellcheck through the process
# substitution.
# shellcheck disable=SC2317,SC2329,SC2034
(
  rp_apply_fix=1
  rp_suggest=0
  rp_STANDARD_LABEL_NAMES=(dep-updater security)
  declare -A rp_STANDARD_LABEL_COLORS=([dep-updater]='0075ca' [security]='b60205')
  declare -A rp_STANDARD_LABEL_DESCRIPTIONS=(
    [dep-updater]='Automated dependency update via dep-updater'
    [security]='Automated CVE / security dependency fixes'
  )
  rp_fetch_repo_labels_json() { printf '["dep-updater"]'; }
  rp_runner_jq_file() {
    local input="$2"
    shift 2
    jq "$@" <<<"$input"
  }
  rp_apply_create_label() { printf '%s\n' "$*" >>"$std_label_log"; }
  rp_log_fail() { :; }
  rp_log_suggest() { :; }
  rp_log_check_ok() { :; }
  rp_log_check_fail() { :; }
  rp_log_gh_api_fail() { :; }
  rp_github_url() { printf 'url'; }
  # shellcheck disable=SC1090
  source <(awk '/^rp_check_standard_labels\(\)/,/^}$/' "$lib")
  rc=0
  rp_check_standard_labels "the-hcma/demo" || rc=$?
  printf '%s' "$rc" >"${std_label_tmp}/rc"
)
std_label_rc="$(cat "${std_label_tmp}/rc")"
if [[ "$std_label_rc" == "1" ]] \
  && grep -qF 'the-hcma/demo security b60205 Automated CVE / security dependency fixes' "$std_label_log" \
  && ! grep -qF 'dep-updater' "$std_label_log"; then
  printf '[PASS] rp_check_standard_labels: creates only the missing label (security), leaves the present one alone\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_standard_labels: expected --apply-fix to create exactly the missing security label\n'
  cat "$std_label_log" >&2
  fail=$(( fail + 1 ))
fi
rm -rf "$std_label_tmp"

printf '\n=== static: gh api body retries use a file, not stdin pipe ===\n'
# shellcheck disable=SC2016  # assert literal --input "$tmp" in source
if grep -qF 'rp_runner_gh_api_input' "$lib" \
  && grep -qF -- '--input "$tmp"' "$lib" \
  && ! grep -nE 'rp_runner_gh_api_stream.*--input -|--input -.*rp_runner_gh_api_stream' "$lib"; then
  printf '[PASS] repo-practices: ruleset/protection writes retry from a temp file\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices: piped --input - cannot be retried after a rate limit\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: expected probes omitted from email failures ===\n'
# shellcheck disable=SC2016,SC1003  # static assert matches literal source text
if grep -qF 'runner_exec "$label" --probe -- jq' "$lib" \
  && grep -qF 'rp_runner_gh_api_stream "repo-practices gh path exists' "$lib" \
  && grep -qF 'rp_runner_gh_api_stream "repo-practices gh fetch' "$lib" \
  && grep -qF 'rp_runner_gh_api_stream "repo-practices protect-main ruleset id" --probe' "$lib" \
  && grep -qF 'rp_runner_gh_api_stream "repo-practices classic main protection" --probe' "$lib" \
  && grep -qF ' --probe \' "$lib"; then
  printf '[PASS] repo-practices marks gh/jq existence probes for runner email filtering\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices: expected --probe on gh path and jq -e checks\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: installed secret-scan matches canonical ===\n'
# shellcheck disable=SC1090,SC1091
installed_scan=""
canonical_scan=""
norm_installed=""
norm_canonical=""
installed_scan="$(<"${rh_root}/.github/ci/secret-scan")"
canonical_scan="$(<"${rh_root}/scripts/lib/ci-secret-scan")"
# Mirror rp_ci_secret_scan_normalize_for_compare (portable; avoid sourcing lib here).
norm_installed="$(printf '%s' "$installed_scan" | tr -d '\r')"
norm_installed="${norm_installed// && / }"
norm_installed="${norm_installed//\\n/ }"
norm_installed="$(printf '%s' "$norm_installed" | tr -s '[:space:]' ' ')"
norm_installed="${norm_installed# }"
norm_installed="${norm_installed% }"
norm_canonical="$(printf '%s' "$canonical_scan" | tr -d '\r')"
norm_canonical="${norm_canonical// && / }"
norm_canonical="${norm_canonical//\\n/ }"
norm_canonical="$(printf '%s' "$norm_canonical" | tr -s '[:space:]' ' ')"
norm_canonical="${norm_canonical# }"
norm_canonical="${norm_canonical% }"
if [[ "$installed_scan" == "$canonical_scan" || "$norm_installed" == "$norm_canonical" ]]; then
  printf '[PASS] secret-scan: .github/ci/secret-scan is canonical (formatting drift tolerated)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] secret-scan: .github/ci/secret-scan drift from scripts/lib/ci-secret-scan\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: secret-scan drift actionable diff ===\n'
if grep -qF 'rp_ci_secret_scan_install_report_drift' "$lib" \
  && grep -qF 'rp_ci_secret_scan_unified_diff' "$lib" \
  && grep -qF 'rp_log_fail_detail' "$lib" \
  && grep -qE -- 'secret-scan diff".*--probe|--probe.*secret-scan diff' "$lib" \
  && grep -qF -- '--stream-stdout' "$lib" \
  && ! grep -qF 'secret-scan must use the canonical scripts/lib/ci-secret-scan install' "$lib"; then
  printf '[PASS] secret-scan: drift failures name component and emit unified diff\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] secret-scan: missing actionable drift diff wiring\n'
  fail=$(( fail + 1 ))
fi

if drift_msg="$(bash -c "
  source '${rh_root}/scripts/lib/runner-bootstrap'
  source '${lib}'
  rp_current_slug='the-hcma/example-repo'
  rp_compact=0
  rp_track_failures=0
  rp_suggest=0
  canonical_script=\$(rp_candidate_secret_scan_script)
  installed_script=\"\${canonical_script}# drift\"
  ci_text='jobs:
  secret-scan:
    name: Secret Scan
    steps:
      - run: echo wrong'
  rp_ci_secret_scan_install_report_drift 'the-hcma/example-repo' \"\$installed_script\" \"\$ci_text\" 2>&1 || true
")" && [[ "$drift_msg" == *'ci.yml secret-scan job drift'* ]] \
  && [[ "$drift_msg" == *'FAIL:'* ]] \
  && [[ "$drift_msg" == *'@@'* || "$drift_msg" == *'---'* ]] \
  && [[ "$drift_msg" != *'(installed and canonical content differ)'* ]]; then
  printf '[PASS] secret-scan: drift reporter names failing component\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] secret-scan: drift reporter did not emit component-specific failure\n'
  fail=$(( fail + 1 ))
fi

# Probe-mode diff must not appear in runner "Command failures" email sections.
if probe_fail_ids="$(bash -c "
  source '${rh_root}/scripts/lib/runner-bootstrap'
  source '${lib}'
  rp_current_slug='the-hcma/example-repo'
  rp_compact=0
  rp_track_failures=0
  rp_suggest=0
  canonical_script=\$(rp_candidate_secret_scan_script)
  installed_script=\"\${canonical_script}# drift\"
  ci_text='jobs:
  secret-scan:
    name: Secret Scan
    steps:
      - run: echo wrong'
  rp_ci_secret_scan_install_report_drift 'the-hcma/example-repo' \"\$installed_script\" \"\$ci_text\" >/dev/null 2>&1 || true
  runner_session_failed_ids
")" && ! grep -q . <<<"$probe_fail_ids"; then
  printf '[PASS] secret-scan: drift diff is probe (omitted from command failures)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] secret-scan: drift diff must use --probe so exit 1 is not a command failure\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_main' "$merge_wrapper" && grep -q 'merge-only' "$merge_wrapper"; then
  printf '[PASS] check-merge-settings delegates to repo-practices with --merge-only\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] check-merge-settings should source lib and pass --merge-only\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: workflow apply-fix prepares stacked candidate PRs ===\n'
if grep -qF 'rp_queue_candidate_file_fix' "$lib" \
  && grep -qF 'rp_candidate_cleanup_branch_on_merge_workflow' "$lib" \
  && grep -qF 'rp_candidate_cleanup_merged_branches_workflow' "$lib" \
  && grep -qF 'rp_candidate_merged_pr_closer_workflow' "$lib" \
  && grep -qF 'rp_candidate_dependabot_auto_merge_workflow' "$lib" \
  && grep -qF 'rp_candidate_secret_scan_script' "$lib" \
  && grep -qF 'rp_fix_ci_workflow_secret_scan_job' "$lib" \
  && grep -qF 'rp_check_ci_secret_scan_gitleaks_pin' "$lib" \
  && grep -qF 'rp_check_ci_shellcheck_pin' "$lib" \
  && grep -qF 'rp_add_ci_secret_scan_job_to_workflow' "$lib" \
  && grep -qF 'rp_ci_workflow_has_secret_scan_coverage' "$lib" \
  && grep -qF 'ci.yml must include a secret-scan job' "$lib" \
  && grep -qF 'rp_ci_workflow_has_hardened_concurrency' "$lib" \
  && grep -qF 'rp_ci_workflow_secret_scan_job_is_canonical' "$lib" \
  && grep -qF 'ci-secret-scan-policy' "$lib" \
  && grep -qF 'ci-shellcheck-policy' "$lib" \
  && grep -qF 'ci-secret-scan' "$lib" \
  && grep -qF 'repo-practices-workflows' "$lib" \
  && grep -qF '.worktrees/repo-practices-candidate-fixes-wt' "$lib" \
  && grep -qF 'worktree add --detach' "$lib" \
  && grep -qF 'runner_sh "repo-practices gt track"' "$lib" \
  && grep -qF 'stacking_tool_submit_as' "$lib" \
  && grep -qF 'stacking_tool_read_optional' "$lib" \
  && grep -qF 'repo-practices gh stack init' "$lib"; then
  printf '[PASS] apply-fix: missing workflows are emitted through a stacked worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] apply-fix: expected dedicated worktree and marker-aware stack helpers\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: candidate PR rollout notice (repository-helpers#661) ===\n'
notice_out="$(bash -c "source '${lib}'; rp_candidate_pr_rollout_notice")"
if grep -qF 'Org rollout candidate' <<<"$notice_out" \
  && grep -qF 'do not enable auto-merge' <<<"$notice_out" \
  && grep -qF 'org-cursor-rule-rollout.md' <<<"$notice_out"; then
  printf '[PASS] rp_candidate_pr_rollout_notice warns against auto-merge before agent review\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_candidate_pr_rollout_notice: expected auto-merge warning, got: %s\n' "$notice_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: both apply-fix candidate PR paths include the rollout notice ===\n'
if awk '
    /^rp_apply_candidate_fixes_via_api\(\)/ { in_fn=1 }
    in_fn && /rp_candidate_pr_rollout_notice/ { ok=1 }
    in_fn && /^}/ { exit }
    END { exit(ok ? 0 : 1) }
  ' "$lib" \
  && awk '
    /^rp_apply_candidate_fix_stack\(\)/ { in_fn=1 }
    in_fn && /rp_candidate_pr_rollout_notice/ { ok=1 }
    in_fn && /^}/ { exit }
    END { exit(ok ? 0 : 1) }
  ' "$lib"; then
  printf '[PASS] apply-fix: single-file (Contents API) and local-clone stack paths both call the rollout notice\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] apply-fix: expected the rollout notice wired into both candidate PR body paths\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: candidate workflow templates lint ===\n'
template_fail=0
lint_tmp="$(mktemp -d)"
for template in \
  cleanup-branch-on-merge.yml \
  cleanup-merged-branches.yml \
  cve-check.yml \
  dependabot-auto-merge.yml \
  merged-pr-closer.yml; do
  template_path="${templates_dir}/${template}"
  run_block="${lint_tmp}/${template}.bash"
  if [[ ! -f "$template_path" ]]; then
    printf '[FAIL] workflow-template: missing %s\n' "$template"
    template_fail=1
    continue
  fi
  if grep -q $'\t' "$template_path" \
    || ! grep -q '^name:' "$template_path" \
    || ! grep -q '^on:' "$template_path" \
    || ! grep -q '^permissions:' "$template_path" \
    || ! grep -q '^jobs:' "$template_path"; then
    printf '[FAIL] workflow-template: malformed %s\n' "$template"
    template_fail=1
    continue
  fi
  awk '
    /^[[:space:]]*run: \|[[:space:]]*$/ {
      in_run = 1
      next
    }
    in_run {
      if ($0 ~ /^          /) {
        sub(/^          /, "")
        print
        next
      }
      if ($0 ~ /^[[:space:]]*$/) {
        print ""
        next
      }
      in_run = 0
    }
  ' "$template_path" >"$run_block"
  if [[ -s "$run_block" ]] && ! bash -n "$run_block"; then
    printf '[FAIL] workflow-template: run block is not valid bash in %s\n' "$template"
    template_fail=1
  fi
done
rm -rf "$lint_tmp"
if [[ "$template_fail" -eq 0 ]]; then
  printf '[PASS] workflow-template: candidates have required keys and valid run blocks\n'
  pass=$(( pass + 1 ))
else
  fail=$(( fail + 1 ))
fi

printf '\n=== static: cve-check template classifies JSON and files issues ===\n'
cve_template="${templates_dir}/cve-check.yml"
# shellcheck disable=SC2016  # grep for literal ${audit_json} / $? strings in template
if grep -qF 'persist-credentials: false' "$cve_template" \
  && grep -qF 'issues: write' "$cve_template" \
  && grep -qF 'uv run --no-progress --with pip --with pip-audit' "$cve_template" \
  && grep -qF 'pip-audit --skip-editable' "$cve_template" \
  && grep -qF -- '--format=json' "$cve_template" \
  && grep -qF 'cve-check: classify-json-outcome' "$cve_template" \
  && grep -qF 'type == "object" and (.dependencies | type == "array")' "$cve_template" \
  && grep -qF '.dependencies | length > 0' "$cve_template" \
  && grep -qF 'has("skip_reason")' "$cve_template" \
  && grep -qF 'has("vulns") and (.vulns | type == "array")' "$cve_template" \
  && grep -qE 'uses: astral-sh/setup-uv@[0-9a-f]{40}' "$cve_template" \
  && grep -qE 'uses: actions/checkout@[0-9a-f]{40}' "$cve_template" \
  && grep -qF 'security/cve' "$cve_template" \
  && grep -qF 'gh issue' "$cve_template" \
  && grep -qF 'ERROR: pip-audit found CVEs but failed to create security/cve issue' "$cve_template" \
  && grep -qF 'ERROR: pip-audit found CVEs but failed to comment on security/cve issue' "$cve_template" \
  && grep -qF ')" || return 1' "$cve_template" \
  && grep -qF 'rm -f "${audit_json}"' "$cve_template" \
  && grep -qF 'audit_rc=$?' "$cve_template" \
  && grep -qF 'audit_rc != 0 && audit_rc != 1' "$cve_template" \
  && ! grep -qF '|| true)"' "$cve_template" \
  && ! grep -qF 'WARN: failed to create security/cve issue' "$cve_template" \
  && ! grep -qF 'WARN: failed to comment on security/cve issue' "$cve_template" \
  && ! grep -qF 'uses: nick-fields/retry@v4' "$cve_template"; then
  printf '[PASS] cve-check template classifies JSON outcomes and files security issues\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cve-check template missing JSON classify / issue notification pattern\n'
  fail=$(( fail + 1 ))
fi

