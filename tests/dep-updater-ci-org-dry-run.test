#!/usr/bin/env bash
# Tests for scripts/dep-updater-ci-org-dry-run and .github/workflows/dep-updater.yml.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

script="${rh_root}/scripts/dep-updater-ci-org-dry-run"
workflow="${rh_root}/.github/workflows/dep-updater.yml"
readonly script workflow

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

pass=0
fail=0

printf '\n=== static: dep-updater-ci-org-dry-run script exists ===\n'
# shellcheck disable=SC2016  # assert literal source fragments, not expansions
if [[ -f "$script" ]] \
  && grep -qF -- '--batch --all --dry-run --include-private --scan-root' "$script" \
  && grep -qF 'refusing to greenwash' "$script" \
  && grep -qF -- '--scan-root must resolve under' "$script" \
  && grep -qF 'canonicalize-missing' "$script" \
  && grep -qF 'gh repo clone' "$script" \
  && grep -qF 'orgs/${owner}/repos' "$script" \
  && grep -qF 'github_api_exec_with_rate_limit_retry "dep-updater-ci-org-dry-run list org repos"' "$script" \
  && grep -qF 'DEP_UPDATER_ORG="$org"' "$script" \
  && grep -qF 'lib/github-api-rate-limit' "$script" \
  && grep -qF 'runner-bootstrap' "$script"; then
  printf '[PASS] dep-updater-ci-org-dry-run clones org repos and dry-runs batch-all\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater-ci-org-dry-run missing or incomplete\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: dep-updater CI workflow ===\n'
# shellcheck disable=SC2016  # assert literal workflow / secret names
if [[ -f "$workflow" ]] \
  && grep -qF 'scripts/dep-updater' "$workflow" \
  && grep -qF '.github/workflows/dep-updater.yml' "$workflow" \
  && grep -qF 'scripts/dep-updater-batch-run' "$workflow" \
  && grep -qF 'scripts/dep-updater-ci-org-dry-run' "$workflow" \
  && grep -qF 'scripts/dep-updater-notifier' "$workflow" \
  && grep -qF 'scripts/lib/release-age-defaults' "$workflow" \
  && grep -qF 'environment: dep-updater' "$workflow" \
  && grep -qF 'approve-pending-deployments' "$workflow" \
  && grep -qF 'workflow_dispatch:' "$workflow" \
  && ! grep -qF 'merge_group:' "$workflow" \
  && grep -qF 'secrets.DEP_UPDATER_TOKEN' "$workflow" \
  && grep -qF '@withgraphite/graphite-cli' "$workflow" \
  && grep -qF 'gh extension install github/gh-stack' "$workflow" \
  && grep -qF 'gh extension upgrade github/gh-stack' "$workflow" \
  && grep -qF 'gh stack --help' "$workflow" \
  && grep -qF 'GH_TOKEN: ${{ github.token }}' "$workflow" \
  && ! grep -qF 'gh extension install github/gh-stack || true' "$workflow" \
  && ! grep -qF 'gh extension upgrade github/gh-stack || true' "$workflow" \
  && grep -qF 'persist-credentials: false' "$workflow" \
  && grep -qF 'org dep-updater dry-run' "$workflow" \
  && grep -qF 'scripts/dep-updater-ci-org-dry-run --org' "$workflow"; then
  printf '[PASS] dep-updater CI workflow dry-runs org when dep-updater paths change\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater CI workflow missing or incomplete\n'
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
