#!/usr/bin/env bash
# Tests for scripts/lib/ci-secret-scan and scripts/dev/secret-scan.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

lib="${rh_root}/scripts/lib/ci-secret-scan"
dev="${rh_root}/scripts/dev/secret-scan"
readonly lib dev

pass=0
fail=0

make_stub_bin() {
  local dir="$1"
  local name="$2"
  local body="$3"
  mkdir -p "$dir"
  printf '%s\n' "#!/usr/bin/env bash" "set -euo pipefail" "$body" >"${dir}/${name}"
  chmod +x "${dir}/${name}"
}

printf '\n=== static: canonical script exists ===\n'
if [[ -f "$lib" && -x "$dev" ]]; then
  printf '[PASS] ci-secret-scan library and dev wrapper exist\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing ci-secret-scan entrypoints\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: hardened install contract ===\n'
# shellcheck disable=SC2016  # assert literal ${version}/${os}/${arch} in source URL template
if grep -qF "ci_secret_scan_version='8.30.1'" "$lib" \
  && grep -qF 'ci_secret_scan_download_retries=3' "$lib" \
  && grep -qF 'curl -fSL' "$lib" \
  && grep -qF 'ERROR: gitleaks download failed' "$lib" \
  && grep -qF 'file -b' "$lib" \
  && grep -qF 'tar -tzf' "$lib" \
  && grep -qF 'ci_secret_scan_release_os' "$lib" \
  && grep -qF 'gitleaks_${version}_${os}_${arch}.tar.gz' "$lib" \
  && grep -qF 'declare -rA ci_secret_scan_sha256=(' "$lib" \
  && grep -qE "^\s*\[linux_x64\]='[0-9a-f]{64}'" "$lib" \
  && grep -qE "^\s*\[darwin_arm64\]='[0-9a-f]{64}'" "$lib" \
  && grep -qF 'ci_secret_scan_verify_checksum' "$lib" \
  && grep -qF 'ci_secret_scan_ensure' "$lib" \
  && grep -qF 'ci_secret_scan_installed_version' "$lib" \
  && grep -qF 'gitleaks version' "$lib" \
  && grep -qF 'checksum mismatch' "$lib" \
  && grep -qF 'skipping checksum verification' "$lib" \
  && grep -qF 'PATH still resolves' "$lib" \
  && grep -qF 'hash -r' "$lib" \
  && ! grep -qF 'releases/latest' "$lib"; then
  printf '[PASS] install uses pinned version, curl -f, retries, OS/arch asset, pre-tar + SHA-256 validation\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected hardened gitleaks install contract in ci-secret-scan\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: leak mitigation guidance ===\n'
if grep -qF 'ci_secret_scan_print_mitigation' "$lib" \
  && grep -qF 'ERROR: SECRET_SCAN_LEAK' "$lib" \
  && grep -qF 'git push origin --delete' "$lib" \
  && grep -qF 'git branch -D' "$lib" \
  && grep -qF 'Revoke and rotate' "$lib" \
  && grep -qF 'scripts/dev/secret-scan' "$lib" \
  && grep -qF 'ci_secret_scan_gitleaks_leak_exit' "$lib"; then
  printf '[PASS] leak mitigation documents revoke, branch deletion, and pre-push prevention\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected leak mitigation guidance in ci-secret-scan\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: PR diff scan wiring ===\n'
if grep -qF 'GITLEAKS_BASE' "$lib" \
  && grep -qF 'GITLEAKS_HEAD' "$lib" \
  && grep -q 'log-opts' "$lib"; then
  printf '[PASS] supports PR diff scan via GITLEAKS_BASE and GITLEAKS_HEAD\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected PR diff scan env handling\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: install rejects non-gzip download ===\n'
tmp_repo="$(mktemp -d)"
mkdir -p "${tmp_repo}/.github/ci"
cp "$lib" "${tmp_repo}/.github/ci/secret-scan"
stub_bin="${tmp_repo}/stub-bin"
# shellcheck disable=SC2016  # stub script body is literal bash, not an expand-here string
make_stub_bin "$stub_bin" curl '
  outfile=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o) outfile="$2"; shift 2 ;;
      -w) shift 2 ;;
      --retry | --retry-delay) shift 2 ;;
      -*) shift ;;
      *) shift ;;
    esac
  done
  printf "not gzip\n" >"$outfile"
  printf "200"
'
make_stub_bin "$stub_bin" file 'printf "ASCII text\n"'
make_stub_bin "$stub_bin" tar 'exit 1'
make_stub_bin "$stub_bin" sudo 'exit 1'

install_out=""
install_rc=0
install_out="$(
  cd "$tmp_repo" \
    && PATH="${stub_bin}:${PATH}" \
      CI_SECRET_SCAN_BIN_DIR="${tmp_repo}/bin" \
      bash .github/ci/secret-scan 2>&1
)" || install_rc=$?
rm -rf "$tmp_repo"

if [[ "$install_rc" -ne 0 ]] \
  && grep -qF 'ERROR: gitleaks download failed' <<<"$install_out"; then
  printf '[PASS] non-gzip download fails with actionable error\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected download failure message (rc=%s)\n%s\n' "$install_rc" "$install_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: install succeeds with valid tarball ===\n'
tmp_repo="$(mktemp -d)"
mkdir -p "${tmp_repo}/.github/ci"
cp "$lib" "${tmp_repo}/.github/ci/secret-scan"
toolchain="${tmp_repo}/toolchain"
mkdir -p "$toolchain"
# Version-aware so ci_secret_scan_ensure's post-install re-probe sees the pinned
# version resolve; any other invocation behaves like a clean (no-leak) scan.
# shellcheck disable=SC2016  # $1 is literal in the generated fixture script
printf '#!/bin/sh\ncase "$1" in version) echo 8.30.1-test ;; *) echo leaked ;; esac\n' \
  >"${toolchain}/gitleaks"
tar -czf "${toolchain}/gitleaks.tar.gz" -C "$toolchain" gitleaks
stub_bin="${tmp_repo}/stub-bin"
# shellcheck disable=SC2016  # stub script body is literal bash, not an expand-here string
make_stub_bin "$stub_bin" curl "
  outfile=''
  while [[ \$# -gt 0 ]]; do
    case \"\$1\" in
      -o) outfile=\"\$2\"; shift 2 ;;
      -w) shift 2 ;;
      --retry | --retry-delay) shift 2 ;;
      -*) shift ;;
      *) shift ;;
    esac
  done
  cp '${toolchain}/gitleaks.tar.gz' \"\$outfile\"
  printf '200'
"
make_stub_bin "$stub_bin" file 'printf "gzip compressed data\n"'
make_stub_bin "$stub_bin" tar '/usr/bin/tar "$@"'
make_stub_bin "$stub_bin" sudo 'exit 1'

install_ok_out=""
install_ok_rc=0
install_ok_out="$(
  cd "$tmp_repo" \
    && PATH="${stub_bin}:${PATH}" \
      GITLEAKS_VERSION='8.30.1-test' \
      CI_SECRET_SCAN_BIN_DIR="${tmp_repo}/bin" \
      bash .github/ci/secret-scan 2>&1
)" || install_ok_rc=$?

if [[ "$install_ok_rc" -eq 0 ]] && [[ -x "${tmp_repo}/bin/gitleaks" ]] \
  && grep -qF 'skipping checksum verification' <<<"$install_ok_out"; then
  printf '[PASS] override-version tarball installs (checksum skipped) and scan exits 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected successful install and scan (rc=%s)\n%s\n' "$install_ok_rc" "$install_ok_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: checksum mismatch aborts the install (supply chain) ===\n'
tmp_repo="$(mktemp -d)"
mkdir -p "${tmp_repo}/.github/ci"
cp "$lib" "${tmp_repo}/.github/ci/secret-scan"
mm_tc="${tmp_repo}/toolchain"
mkdir -p "$mm_tc"
printf '#!/bin/sh\necho leaked\n' >"${mm_tc}/gitleaks"
# Pinned version but a bogus tarball → digest will not match ci_secret_scan_sha256.
tar -czf "${mm_tc}/gitleaks.tar.gz" -C "$mm_tc" gitleaks
mm_stub="${tmp_repo}/stub-bin"
# shellcheck disable=SC2016  # stub body mixes literal bash with one expanded path
make_stub_bin "$mm_stub" curl "
  outfile=''
  while [[ \$# -gt 0 ]]; do
    case \"\$1\" in
      -o) outfile=\"\$2\"; shift 2 ;;
      -w) shift 2 ;;
      --retry | --retry-delay) shift 2 ;;
      *) shift ;;
    esac
  done
  cp '${mm_tc}/gitleaks.tar.gz' \"\$outfile\"
  printf '200'
"
make_stub_bin "$mm_stub" file 'printf "gzip compressed data\n"'
make_stub_bin "$mm_stub" tar '/usr/bin/tar "$@"'
make_stub_bin "$mm_stub" sudo 'exit 1'

mm_out=""
mm_rc=0
mm_out="$(
  cd "$tmp_repo" \
    && PATH="${mm_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${tmp_repo}/bin" \
      bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || mm_rc=$?
mm_installed_probe='present'
[[ ! -e "${tmp_repo}/bin/gitleaks" ]] && mm_installed_probe='absent'
rm -rf "$tmp_repo"
if [[ "$mm_rc" -ne 0 ]] \
  && grep -qF 'checksum mismatch' <<<"$mm_out" \
  && [[ "$mm_installed_probe" == 'absent' ]]; then
  printf '[PASS] a tampered gitleaks tarball fails the SHA-256 check and installs nothing\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected checksum-mismatch abort (rc=%s installed=%s)\n%s\n' \
    "$mm_rc" "$mm_installed_probe" "$mm_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ensure re-installs a wrong-version gitleaks on PATH ===\n'
wv_repo="$(mktemp -d)"
wv_stub="${wv_repo}/stub-bin"
make_stub_bin "$wv_stub" gitleaks 'printf "1.0.0\n"'
make_stub_bin "$wv_stub" curl "touch '${wv_repo}/curl-called'; exit 22"
make_stub_bin "$wv_stub" file 'printf "data\n"'
wv_out=""
wv_rc=0
wv_out="$(
  PATH="${wv_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${wv_repo}/bin" bash -c '
    # shellcheck source=/dev/null
    source "'"$lib"'"
    ci_secret_scan_ensure
  ' 2>&1
)" || wv_rc=$?
wv_curl_called='no'
[[ -e "${wv_repo}/curl-called" ]] && wv_curl_called='yes'
rm -rf "$wv_repo"
if [[ "$wv_rc" -ne 0 && "$wv_curl_called" == 'yes' ]] \
  && grep -qF 'gitleaks download failed' <<<"$wv_out"; then
  printf '[PASS] a gitleaks on PATH at the wrong version triggers a (verified) reinstall\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ensure must not trust an off-version gitleaks (rc=%s)\n%s\n' "$wv_rc" "$wv_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ensure trusts a pinned-version gitleaks already on PATH ===\n'
pv_repo="$(mktemp -d)"
pv_stub="${pv_repo}/stub-bin"
make_stub_bin "$pv_stub" gitleaks 'printf "v8.30.1\n"'
make_stub_bin "$pv_stub" curl 'printf "should not download\n" >&2; exit 1'
pv_out=""
pv_rc=0
pv_out="$(
  PATH="${pv_stub}:${PATH}" bash -c '
    # shellcheck source=/dev/null
    source "'"$lib"'"
    ci_secret_scan_ensure
  ' 2>&1
)" || pv_rc=$?
rm -rf "$pv_repo"
if [[ "$pv_rc" -eq 0 ]] && ! grep -qF 'should not download' <<<"$pv_out"; then
  printf '[PASS] ensure is a no-op when gitleaks already reports the pinned version\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ensure re-downloaded despite a matching version (rc=%s)\n%s\n' "$pv_rc" "$pv_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ensure errors when a stale gitleaks shadows the install ===\n'
sh_repo="$(mktemp -d)"
sh_tc="${sh_repo}/tc"
mkdir -p "$sh_tc"
printf '#!/bin/sh\necho ok\n' >"${sh_tc}/gitleaks"
tar -czf "${sh_repo}/gitleaks.tar.gz" -C "$sh_tc" gitleaks
sh_stub="${sh_repo}/stub-bin"
# A stale gitleaks stays first on PATH; the default-dir sudo install is a no-op so
# the freshly "installed" binary never becomes resolvable.
make_stub_bin "$sh_stub" gitleaks 'printf "8.20.0\n"'
make_stub_bin "$sh_stub" sudo 'exit 0'
# shellcheck disable=SC2016  # stub body mixes literal bash with one expanded path
make_stub_bin "$sh_stub" curl "
  outfile=''
  while [[ \$# -gt 0 ]]; do case \"\$1\" in -o) outfile=\"\$2\"; shift 2 ;; *) shift ;; esac; done
  cp '${sh_repo}/gitleaks.tar.gz' \"\$outfile\"
  printf '200'
"
make_stub_bin "$sh_stub" file 'printf "gzip compressed data\n"'
make_stub_bin "$sh_stub" tar '/usr/bin/tar "$@"'

sh_out=""
sh_rc=0
sh_out="$(
  PATH="${sh_stub}:${PATH}" GITLEAKS_VERSION='8.20.0-pin' bash -c '
    # shellcheck source=/dev/null
    source "'"$lib"'"
    ci_secret_scan_ensure
  ' 2>&1
)" || sh_rc=$?
rm -rf "$sh_repo"
if [[ "$sh_rc" -ne 0 ]] && grep -qF 'PATH still resolves' <<<"$sh_out"; then
  printf '[PASS] ensure fails loudly when the verified gitleaks is not the one that resolves\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ensure must not proceed with a shadowing gitleaks (rc=%s)\n%s\n' "$sh_rc" "$sh_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: matching checksum accepts the pinned tarball ===\n'
ok_repo="$(mktemp -d)"
ok_tc="${ok_repo}/toolchain"
mkdir -p "$ok_tc"
printf '#!/bin/sh\necho ok\n' >"${ok_tc}/gitleaks"
tar -czf "${ok_repo}/gitleaks.tar.gz" -C "$ok_tc" gitleaks
ok_digest="$(sha256sum "${ok_repo}/gitleaks.tar.gz" | awk '{ print $1 }')"
# Point every ci_secret_scan_sha256 slot at this fixture's real digest so the
# pinned-version path verifies successfully on whatever arch the test runs on.
sed -E "s/\\[(linux|darwin)_(x64|arm64)\\]='[0-9a-f]+'/[\\1_\\2]='${ok_digest}'/" \
  "$lib" >"${ok_repo}/lib-under-test"
ok_stub="${ok_repo}/stub-bin"
# shellcheck disable=SC2016  # stub body mixes literal bash with one expanded path
make_stub_bin "$ok_stub" curl "
  outfile=''
  while [[ \$# -gt 0 ]]; do
    case \"\$1\" in
      -o) outfile=\"\$2\"; shift 2 ;;
      *) shift ;;
    esac
  done
  cp '${ok_repo}/gitleaks.tar.gz' \"\$outfile\"
  printf '200'
"
make_stub_bin "$ok_stub" file 'printf "gzip compressed data\n"'
make_stub_bin "$ok_stub" tar '/usr/bin/tar "$@"'

acc_out=""
acc_rc=0
acc_out="$(
  PATH="${ok_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${ok_repo}/bin" bash -c '
    # shellcheck source=/dev/null
    source "'"${ok_repo}/lib-under-test"'"
    ci_secret_scan_install_gitleaks
  ' 2>&1
)" || acc_rc=$?
acc_installed='absent'
[[ -x "${ok_repo}/bin/gitleaks" ]] && acc_installed='present'
rm -rf "$ok_repo"
if [[ "$acc_rc" -eq 0 && "$acc_installed" == 'present' ]] \
  && ! grep -qF 'skipping checksum verification' <<<"$acc_out" \
  && ! grep -qF 'checksum mismatch' <<<"$acc_out"; then
  printf '[PASS] a tarball whose SHA-256 matches ci_secret_scan_sha256 installs cleanly\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pinned-version matching-digest install (rc=%s installed=%s)\n%s\n' \
    "$acc_rc" "$acc_installed" "$acc_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: leak prints mitigation and exits 1 ===\n'
tmp_repo="$(mktemp -d)"
mkdir -p "${tmp_repo}/.github/ci"
cp "$lib" "${tmp_repo}/.github/ci/secret-scan"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin 'https://github.com/the-hcma/example-repo.git'
git -C "$tmp_repo" checkout -q -b leak-branch
leak_stub="${tmp_repo}/stub-bin"
make_stub_bin "$leak_stub" gitleaks 'printf "leak found\n" >&2; exit 1'

leak_out=""
leak_rc=0
leak_out="$(
  cd "$tmp_repo" \
    && PATH="${leak_stub}:${PATH}" \
      GITHUB_REPOSITORY='the-hcma/example-repo' \
      GITHUB_HEAD_REF='leak-branch' \
      bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_run "$(pwd)"
      ' 2>&1
)" || leak_rc=$?

if [[ "$leak_rc" -eq 1 ]] \
  && grep -qF 'ERROR: SECRET_SCAN_LEAK' <<<"$leak_out" \
  && grep -qF 'git push origin --delete leak-branch' <<<"$leak_out" \
  && grep -qF 'git branch -D leak-branch' <<<"$leak_out" \
  && grep -qF 'repos/the-hcma/example-repo/git/refs/heads/leak-branch' <<<"$leak_out"; then
  printf '[PASS] gitleaks leak exit prints branch-specific mitigation steps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected mitigation output on leak (rc=%s)\n%s\n' "$leak_rc" "$leak_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: repo-practices secret-scan helpers ===\n'
rp_lib="${rh_root}/scripts/lib/repo-practices"
inline_ci='jobs:
  secret-scan:
    steps:
      - run: |
          curl -sSL gitleaks_8.30.0_linux_x64.tar.gz | tar -xz gitleaks
'
canonical_ci='jobs:
  secret-scan:
    env:
      GITLEAKS_BASE: x
      GITLEAKS_HEAD: y
    steps:
      - run: bash .github/ci/secret-scan
'
# shellcheck disable=SC1090,SC1091
source "$rp_lib"

if rp_ci_workflow_has_brittle_gitleaks_install "$inline_ci" \
  && ! rp_ci_workflow_has_brittle_gitleaks_install "$canonical_ci" \
  && rp_ci_workflow_uses_canonical_secret_scan_invocation "$canonical_ci" \
  && rp_ci_secret_scan_script_is_canonical "$(cat "$lib")"; then
  printf '[PASS] repo-practices detects brittle installs and canonical script\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices secret-scan helper checks misbehaved\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: secret-scan formatting-only drift is canonical ===\n'
legacy_script=""
canonical_script=""
canonical_script="$(cat "$lib")"
# Simulate pre-#282 shellcheck reflow (&& on one line vs split printf lines).
legacy_script="${canonical_script//git switch main\\n       git branch -D/git switch main \&\& git branch -D}"
if [[ "$legacy_script" != "$canonical_script" ]] \
  && rp_ci_secret_scan_script_is_canonical "$legacy_script"; then
  printf '[PASS] secret-scan canonical check ignores formatting-only drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] secret-scan canonical check should accept shellcheck reflow diffs\n'
  fail=$(( fail + 1 ))
fi

fixed_ci="$(rp_fix_ci_workflow_secret_scan_job "$inline_ci")"
if rp_ci_workflow_secret_scan_job_is_canonical "$fixed_ci" \
  && ! grep -qF 'FALLBACK_VERSION' <<<"$fixed_ci"; then
  printf '[PASS] rp_fix_ci_workflow_secret_scan_job replaces inline install job\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected canonical secret-scan job replacement\n%s\n' "$fixed_ci"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: CI concurrency hardening helpers ===\n'
# shellcheck disable=SC2016
legacy_concurrency_ci='name: CI
on:
  pull_request:
concurrency:
  group: ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
jobs:
  guard:
    runs-on: ubuntu-latest
'
if ! rp_ci_workflow_has_hardened_concurrency "$legacy_concurrency_ci" \
  && rp_ci_workflow_has_hardened_concurrency "$(rp_fix_ci_workflow_concurrency "$legacy_concurrency_ci")"; then
  printf '[PASS] rp_fix_ci_workflow_concurrency keys group on head SHA and action\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected hardened concurrency replacement\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # fixture embeds literal GitHub Actions ${{ }} expressions
read -r -d '' legacy_action_concurrency_ci <<'EOF' || true
name: CI
on:
  pull_request:
concurrency:
  group: ci-${{ github.event.pull_request.number || github.ref }}-${{ github.event.pull_request.head.sha || github.sha }}
  cancel-in-progress: true
jobs:
  guard:
    runs-on: ubuntu-latest
EOF
if rp_ci_workflow_has_hardened_concurrency "$legacy_action_concurrency_ci" \
  || ! rp_ci_workflow_has_hardened_concurrency "$(rp_fix_ci_workflow_concurrency "$legacy_action_concurrency_ci")"; then
  printf '[FAIL] expected action-scoped concurrency to require rp_fix_ci_workflow_concurrency\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] rp_fix_ci_workflow_concurrency upgrades SHA-only groups to action scope\n'
  pass=$(( pass + 1 ))
fi

no_concurrency_ci='name: CI
on:
  pull_request:
jobs:
  guard:
    runs-on: ubuntu-latest
'
if rp_ci_workflow_has_hardened_concurrency "$(rp_fix_ci_workflow_concurrency "$no_concurrency_ci")"; then
  printf '[PASS] rp_fix_ci_workflow_concurrency inserts block before jobs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected concurrency block insertion\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: Graphite restack pull_request triggers ===\n'
# shellcheck disable=SC2016  # fixture embeds literal GitHub Actions ${{ }} expressions
read -r -d '' graphite_restack_ci <<'EOF' || true
name: CI
on:
  pull_request:
    types: [opened, reopened, synchronize, ready_for_review]
jobs:
  guard:
    runs-on: ubuntu-latest
    outputs:
      skip: ${{ steps.set-skip.outputs.skip }}
    steps:
      - id: set-skip
        env:
          HEAD_REF: ${{ github.head_ref }}
          PR_STATE: merged
        run: |
          if [[ "$HEAD_REF" == gtmq_merge_* ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi
EOF
fixed_graphite_restack_ci="$(rp_fix_ci_workflow_graphite_restack_triggers "$graphite_restack_ci")"
if rp_ci_workflow_needs_graphite_restack_trigger_fix "$graphite_restack_ci" \
  && ! rp_ci_workflow_needs_graphite_restack_trigger_fix "$fixed_graphite_restack_ci" \
  && rp_ci_workflow_has_pull_request_edited_type "$fixed_graphite_restack_ci" \
  && rp_ci_workflow_has_feature_branch_push_trigger "$fixed_graphite_restack_ci" \
  && rp_ci_workflow_guard_has_push_dedup "$fixed_graphite_restack_ci" \
  && rp_ci_workflow_guard_has_dedup_permissions "$fixed_graphite_restack_ci" \
  && rp_ci_workflow_guard_has_coderabbit_edited_skip "$fixed_graphite_restack_ci" \
  && ! rp_ci_workflow_guard_skip_run_is_broken "$fixed_graphite_restack_ci"; then
  printf '[PASS] rp_fix_ci_workflow_graphite_restack_triggers adds full Graphite restack CI coverage\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected full Graphite restack trigger fix\n%s\n' "$fixed_graphite_restack_ci"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: CodeRabbit edited guard skip ===\n'
read -r -d '' coderabbit_guard_ci <<'EOF' || true
name: CI
on:
  pull_request:
jobs:
  guard:
    steps:
      - id: set-skip
        run: |
          if [[ "$HEAD_REF" == gtmq_merge_* ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          # Skip push CI when an open PR already covers this branch.
          if [[ "${{ github.event_name }}" == "push" ]]; then
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi
          echo "skip=false" >> "$GITHUB_OUTPUT"
EOF
if ! rp_ci_workflow_guard_has_coderabbit_edited_skip "$coderabbit_guard_ci" \
  && rp_ci_workflow_guard_has_coderabbit_edited_skip "$(rp_fix_ci_workflow_guard_coderabbit_edited "$coderabbit_guard_ci")"; then
  printf '[PASS] rp_fix_ci_workflow_guard_coderabbit_edited inserts CodeRabbit skip\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected CodeRabbit edited guard skip insertion\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: fpdf-style guard with existing exit 0 ===\n'
read -r -d '' fpdf_guard_ci <<'EOF' || true
name: CI
on:
  pull_request:
jobs:
  guard:
    steps:
      - id: check
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if [[ "${{ github.head_ref }}" == gtmq_merge_* ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          pr_number="${{ github.event.pull_request.number }}"
          if [[ -n "$pr_number" ]]; then
            state=$(gh pr view "$pr_number" --repo "${{ github.repository }}" --json state -q .state)
            if [[ "$state" == "MERGED" ]]; then
              echo "skip=true" >> "$GITHUB_OUTPUT"
            else
              echo "skip=false" >> "$GITHUB_OUTPUT"
            fi
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi
EOF
fixed_fpdf_guard_ci="$(rp_fix_ci_workflow_guard_push_dedup "$fpdf_guard_ci")"
if rp_ci_workflow_guard_has_push_dedup "$fixed_fpdf_guard_ci" \
  && ! rp_ci_workflow_guard_skip_run_is_broken "$fixed_fpdf_guard_ci" \
  && [[ "$(grep -c 'exit 0' <<<"$fixed_fpdf_guard_ci")" -eq 4 ]]; then
  printf '[PASS] fpdf-style guard fix keeps one exit 0 per skip path\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected canonical fpdf-style guard without duplicate exit 0\n%s\n' "$fixed_fpdf_guard_ci"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: bunnify-style HEAD_REF guard with merged skip ===\n'
read -r -d '' bunnify_guard_ci <<'EOF' || true
name: CI
on:
  pull_request:
jobs:
  guard:
    steps:
      - id: check
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD_REF: ${{ github.head_ref }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          REPOSITORY: ${{ github.repository }}
        run: |
          if [[ "$HEAD_REF" == gtmq_merge_* ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          pr_number="$PR_NUMBER"
          if [[ -n "$pr_number" ]]; then
            state=$(gh pr view "$pr_number" --repo "$REPOSITORY" --json state -q .state)
            if [[ "$state" == "MERGED" ]]; then
              echo "skip=true" >> "$GITHUB_OUTPUT"
            else
              echo "skip=false" >> "$GITHUB_OUTPUT"
            fi
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi
EOF
fixed_bunnify_guard_ci="$(rp_fix_ci_workflow_guard_push_dedup "$bunnify_guard_ci")"
# shellcheck disable=SC2016  # assert literal YAML run line content
merged_view_marker='gh pr view "${PR_NUMBER}"'
if rp_ci_workflow_guard_has_push_dedup "$fixed_bunnify_guard_ci" \
  && ! rp_ci_workflow_guard_skip_run_is_broken "$fixed_bunnify_guard_ci" \
  && grep -qF "$merged_view_marker" <<<"$fixed_bunnify_guard_ci" \
  && grep -qF 'open PR exists; pull_request handles this push' <<<"$fixed_bunnify_guard_ci"; then
  printf '[PASS] HEAD_REF/PR_NUMBER guard keeps merged skip and adds push dedup\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected HEAD_REF/PR_NUMBER guard with merged skip and push dedup\n%s\n' "$fixed_bunnify_guard_ci"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: pr-state guard with separate pr-state step ===\n'
read -r -d '' pr_state_guard_ci <<'EOF' || true
name: CI
on:
  pull_request:
jobs:
  guard:
    steps:
      - id: pr-state
        env:
          GH_TOKEN: ${{ github.token }}
        run: echo "state=OPEN" >> "$GITHUB_OUTPUT"
      - id: set-skip
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD_REF: ${{ github.head_ref || github.ref_name }}
          PR_STATE: ${{ steps.pr-state.outputs.state }}
        run: |
          if [[ "$HEAD_REF" == gtmq_merge_* ]] || [[ "$PR_STATE" == "MERGED" ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "skip=false" >> "$GITHUB_OUTPUT"
EOF
if ! rp_ci_workflow_guard_skip_run_is_broken "$pr_state_guard_ci"; then
  printf '[PASS] pr-state two-step guard is not flagged broken\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-state two-step guard should not false-positive broken detection\n'
  fail=$(( fail + 1 ))
fi

no_scan_ci='jobs:
  guard:
    runs-on: ubuntu-latest
'
added_ci="$(rp_add_ci_secret_scan_job_to_workflow "$no_scan_ci")"
if rp_ci_workflow_has_secret_scan_job "$added_ci" \
  && grep -qF 'bash .github/ci/secret-scan' <<<"$added_ci" \
  && ! rp_ci_workflow_has_secret_scan_coverage "$no_scan_ci"; then
  printf '[PASS] rp_add_ci_secret_scan_job_to_workflow appends canonical job\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected secret-scan job appended to ci.yml\n%s\n' "$added_ci"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gitleaks pin policy ===\n'
pinned="$(ci_secret_scan_policy_read_pinned_version "$lib")"
if [[ "$pinned" == '8.30.1' ]] \
  && ci_secret_scan_policy_version_is_older_than '8.30.0' '8.30.1' \
  && ! ci_secret_scan_policy_version_is_older_than '8.30.1' '8.30.1' \
  && ! ci_secret_scan_policy_version_is_older_than '8.31.0' '8.30.1'; then
  printf '[PASS] policy reads pinned version and compares semvers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] policy pinned read or semver comparison failed (pinned=%s)\n' "$pinned"
  fail=$(( fail + 1 ))
fi

policy_mock_dir="$(mktemp -d)"
policy_mock_bin="${policy_mock_dir}/bin"
mkdir -p "$policy_mock_bin"
cat >"${policy_mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'repos/gitleaks/gitleaks/releases --paginate'* ]]; then
  printf '%s\n' 'v8.31.0' 'v8.30.1'
  exit 0
fi
if [[ "$args" == *'releases/tags/v8.31.0'* ]]; then
  if [[ "$args" == *'published_at'* ]]; then
    date -u -d '1 day ago' +%Y-%m-%dT%H:%M:%SZ
  elif [[ "$args" == *'assets[].name'* ]]; then
    printf 'gitleaks_8.31.0_linux_x64.tar.gz\n'
  fi
  exit 0
fi
if [[ "$args" == *'releases/tags/v8.30.1'* ]]; then
  if [[ "$args" == *'published_at'* ]]; then
    date -u -d '30 days ago' +%Y-%m-%dT%H:%M:%SZ
  elif [[ "$args" == *'assets[].name'* ]]; then
    printf 'gitleaks_8.30.1_linux_x64.tar.gz\n'
  fi
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${policy_mock_bin}/gh"

eligible=""
eligible="$(
  PATH="${policy_mock_bin}:${PATH}" \
    ci_secret_scan_policy_pick_eligible_gitleaks_version 2>/dev/null || true
)"
rm -rf "$policy_mock_dir"

if [[ "$eligible" == '8.30.1' ]]; then
  # shellcheck disable=SC2154  # release_age_dep_updater_days from release-age-defaults via repo-practices
  printf '[PASS] policy picks newest release past %s-day gate\n' "$release_age_dep_updater_days"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected eligible gitleaks 8.30.1, got %s\n' "$eligible"
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
