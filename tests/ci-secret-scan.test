printf '\n=== functional: gitleaks pin policy ===\n'
pinned="$(ci_secret_scan_policy_read_pinned_version "$lib")"
if [[ "$pinned" == '8.30.1' ]] \
  && ci_secret_scan_policy_version_is_older_than '8.30.0' '8.30.1' \
  && ! ci_secret_scan_policy_version_is_older_than '8.30.1' '8.30.1' \
  && ! ci_secret_scan_policy_version_is_older_than '8.31.0' '8.30.1'; then
  printf '[PASS] policy reads pinned version and compares semvers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] policy pinned read or semver comparison failed (pinned=%s)\n' "$pinned"
  fail=$(( fail + 1 ))
fi

policy_mock_dir="$(mktemp -d)"
policy_mock_bin="${policy_mock_dir}/bin"
mkdir -p "$policy_mock_bin"
cat >"${policy_mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'repos/gitleaks/gitleaks/releases --paginate'* ]]; then
  printf '%s\n' 'v8.31.0' 'v8.30.1'
  exit 0
fi
if [[ "$args" == *'releases/tags/v8.31.0'* ]]; then
  if [[ "$args" == *'published_at'* ]]; then
    date -u -d '1 day ago' +%Y-%m-%dT%H:%M:%SZ
  elif [[ "$args" == *'assets[].name'* ]]; then
    printf 'gitleaks_8.31.0_linux_x64.tar.gz\n'
  fi
  exit 0
fi
if [[ "$args" == *'releases/tags/v8.30.1'* ]]; then
  if [[ "$args" == *'published_at'* ]]; then
    date -u -d '30 days ago' +%Y-%m-%dT%H:%M:%SZ
  elif [[ "$args" == *'assets[].name'* ]]; then
    printf 'gitleaks_8.30.1_linux_x64.tar.gz\n'
  fi
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${policy_mock_bin}/gh"

eligible=""
eligible="$(
  PATH="${policy_mock_bin}:${PATH}" \
    ci_secret_scan_policy_pick_eligible_gitleaks_version 2>/dev/null || true
)"
rm -rf "$policy_mock_dir"

if [[ "$eligible" == '8.30.1' ]]; then
  # shellcheck disable=SC2154  # release_age_dep_updater_days from release-age-defaults via repo-practices
  printf '[PASS] policy picks newest release past %s-day gate\n' "$release_age_dep_updater_days"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected eligible gitleaks 8.30.1, got %s\n' "$eligible"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gitleaks download retries through a transient outage (#842) ===\n'
rt_repo="$(mktemp -d)"
mkdir -p "${rt_repo}/.github/ci"
cp "$lib" "${rt_repo}/.github/ci/secret-scan"
rt_tc="${rt_repo}/toolchain"
mkdir -p "$rt_tc"
printf '#!/bin/sh\necho ok\n' >"${rt_tc}/gitleaks"
tar -czf "${rt_tc}/gitleaks.tar.gz" -C "$rt_tc" gitleaks
rt_stub="${rt_repo}/stub-bin"
# The first two curl calls fail like a 503 (exit 22, stderr text); later calls succeed.
# shellcheck disable=SC2016  # stub body mixes literal bash with expanded paths
make_stub_bin "$rt_stub" curl "
  outfile=''
  while [[ \$# -gt 0 ]]; do
    case \"\$1\" in
      -o) outfile=\"\$2\"; shift 2 ;;
      -w) shift 2 ;;
      --retry | --retry-delay) shift 2 ;;
      *) shift ;;
    esac
  done
  n=\$(( \$(cat '${rt_repo}/calls' 2>/dev/null || echo 0) + 1 ))
  printf '%s' \"\$n\" >'${rt_repo}/calls'
  if [[ -n \"\${RT_PARTIAL:-}\" ]]; then
    cp '${rt_tc}/gitleaks.tar.gz' \"\$outfile\"
    printf 'curl: (28) Operation timed out\n' >&2
    printf '200'
    exit 28
  fi
  if (( n <= \${RT_FAIL_CALLS:-2} )); then
    printf 'curl: (22) The requested URL returned error: %s\n' \"\${RT_HTTP_CODE:-503}\" >&2
    printf '%s' \"\${RT_HTTP_CODE:-503}\"
    exit \${RT_CURL_EXIT:-22}
  fi
  cp '${rt_tc}/gitleaks.tar.gz' \"\$outfile\"
  printf '200'
"
make_stub_bin "$rt_stub" file 'printf "gzip compressed data\n"'
make_stub_bin "$rt_stub" tar '/usr/bin/tar "$@"'
make_stub_bin "$rt_stub" sudo 'exit 1'
make_stub_bin "$rt_stub" sleep "printf '%s\\n' \"\$1\" >>'${rt_repo}/sleeps'"
make_uname_linux_stub "$rt_stub"

rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      CI_SECRET_SCAN_RETRY_DELAY=7 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
rt_sleeps="$(tr '\n' ' ' <"${rt_repo}/sleeps" 2>/dev/null || true)"
if [[ "$rt_rc" -eq 0 && -x "${rt_repo}/bin/gitleaks" && "$rt_calls" == '3' && "$rt_sleeps" == '7 14 ' ]]; then
  printf '[PASS] two 503 attempts then success installs gitleaks, sleeping 7s then 14s between attempts\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected install after two failed attempts (rc=%s calls=%s sleeps=%s)\n%s\n' \
    "$rt_rc" "$rt_calls" "$rt_sleeps" "$rt_out"
  fail=$(( fail + 1 ))
fi

rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 CI_SECRET_SCAN_DOWNLOAD_RETRIES=4 CI_SECRET_SCAN_RETRY_DELAY=0 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_error_lines="$(grep -c '^ERROR: gitleaks download failed' <<<"$rt_out" || true)"
if [[ "$rt_rc" -ne 0 && "$rt_error_lines" == '1' ]] \
  && grep -qF 'after 4 attempts' <<<"$rt_out" \
  && grep -qF 'http_code=503 curl_exit=22' <<<"$rt_out" \
  && grep -qF 'returned error: 503' <<<"$rt_out"; then
  printf '[PASS] a download that always fails reports one ERROR line with the attempts, HTTP status and curl error\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one ERROR line with http_code=503 curl_exit=22 (rc=%s)\n%s\n' "$rt_rc" "$rt_out"
  fail=$(( fail + 1 ))
fi

rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 RT_HTTP_CODE=404 CI_SECRET_SCAN_DOWNLOAD_RETRIES=5 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
if [[ "$rt_rc" -ne 0 && "$rt_calls" == '1' ]] && grep -qF 'http_code=404' <<<"$rt_out" \
  && grep -qF 'after 1 attempt (' <<<"$rt_out"; then
  printf '[PASS] a permanent 404 fails on the first attempt instead of waiting out the retry window\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one attempt for a 404 (rc=%s calls=%s)\n%s\n' "$rt_rc" "$rt_calls" "$rt_out"
  fail=$(( fail + 1 ))
fi

# The overall budget: a backoff that would pass it ends the install after one attempt, without sleeping.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 CI_SECRET_SCAN_DOWNLOAD_RETRIES=5 CI_SECRET_SCAN_RETRY_DELAY=500 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
if [[ "$rt_rc" -ne 0 && "$rt_calls" == '1' && ! -e "${rt_repo}/sleeps" ]] \
  && grep -qF 'after 1 attempt (' <<<"$rt_out"; then
  printf '[PASS] a backoff longer than the overall budget ends the install after one attempt, without sleeping\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one attempt when the backoff exceeds the budget (rc=%s calls=%s)\n%s\n' \
    "$rt_rc" "$rt_calls" "$rt_out"
  fail=$(( fail + 1 ))
fi

# A 200 whose body is not the expected archive is named in the final error, not reported as a bare download failure.
make_stub_bin "$rt_stub" file 'printf "HTML document, ASCII text\n"'
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=0 CI_SECRET_SCAN_DOWNLOAD_RETRIES=2 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
make_stub_bin "$rt_stub" file 'printf "gzip compressed data\n"'
if [[ "$rt_rc" -ne 0 ]] && grep -qF 'body=body is not a valid tar.gz archive' <<<"$rt_out" \
  && grep -qF 'after 2 attempts' <<<"$rt_out"; then
  printf '[PASS] an invalid archive served as 200 is retried and named in the final error\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected body=body is not a valid tar.gz archive (rc=%s)\n%s\n' "$rt_rc" "$rt_out"
  fail=$(( fail + 1 ))
fi

# A 200 that ends in a curl transfer error (a timeout after a complete archive) is retried, never checksummed.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" \
      RT_PARTIAL=1 CI_SECRET_SCAN_DOWNLOAD_RETRIES=3 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
if [[ "$rt_rc" -ne 0 && "$rt_calls" == '3' ]] \
  && ! grep -qF 'checksum mismatch' <<<"$rt_out" \
  && grep -qF 'curl_exit=28' <<<"$rt_out"; then
  printf '[PASS] a complete archive with a curl error is retried to exhaustion and never reaches the checksum abort\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected 3 attempts and no checksum abort (rc=%s calls=%s)\n%s\n' "$rt_rc" "$rt_calls" "$rt_out"
  fail=$(( fail + 1 ))
fi

# A zero-padded delay is decimal: 08 must not be read as an invalid octal number.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 CI_SECRET_SCAN_DOWNLOAD_RETRIES=3 CI_SECRET_SCAN_RETRY_DELAY=08 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_sleeps="$(tr '\n' ' ' <"${rt_repo}/sleeps" 2>/dev/null || true)"
if [[ "$rt_rc" -ne 0 && "$rt_sleeps" == '8 16 ' ]] && ! grep -qiE 'value too great|syntax error' <<<"$rt_out"; then
  printf '[PASS] CI_SECRET_SCAN_RETRY_DELAY=08 sleeps 8s then 16s instead of failing arithmetic\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected sleeps of 8 and 16 for delay 08 (rc=%s sleeps=%s)\n%s\n' "$rt_rc" "$rt_sleeps" "$rt_out"
  fail=$(( fail + 1 ))
fi

# A certificate-verification failure (curl exit 60) repeats on every attempt: fail on the first one.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 RT_HTTP_CODE=000 RT_CURL_EXIT=60 CI_SECRET_SCAN_DOWNLOAD_RETRIES=5 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
if [[ "$rt_rc" -ne 0 && "$rt_calls" == '1' ]] && grep -qF 'curl_exit=60' <<<"$rt_out"; then
  printf '[PASS] a certificate-verification failure (curl exit 60) fails on the first attempt\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one attempt for curl exit 60 (rc=%s calls=%s)\n%s\n' "$rt_rc" "$rt_calls" "$rt_out"
  fail=$(( fail + 1 ))
fi

# A write error (curl exit 23, a full disk) repeats while storage stays full: fail on the first attempt.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 RT_HTTP_CODE=000 RT_CURL_EXIT=23 CI_SECRET_SCAN_DOWNLOAD_RETRIES=5 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
if [[ "$rt_rc" -ne 0 && "$rt_calls" == '1' ]] && grep -qF 'curl_exit=23' <<<"$rt_out"; then
  printf '[PASS] a write error (curl exit 23) fails on the first attempt\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one attempt for curl exit 23 (rc=%s calls=%s)\n%s\n' "$rt_rc" "$rt_calls" "$rt_out"
  fail=$(( fail + 1 ))
fi

# Curl can fail to write the body after it received HTTP 200: still a write error, still the first attempt.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" CI_SECRET_SCAN_BIN_DIR="${rt_repo}/bin" GITLEAKS_VERSION='0.0.0' \
      RT_FAIL_CALLS=99 RT_HTTP_CODE=200 RT_CURL_EXIT=23 CI_SECRET_SCAN_DOWNLOAD_RETRIES=5 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_calls="$(cat "${rt_repo}/calls" 2>/dev/null || echo 0)"
if [[ "$rt_rc" -ne 0 && "$rt_calls" == '1' ]] && grep -qF 'curl_exit=23' <<<"$rt_out"; then
  printf '[PASS] a write error after HTTP 200 (curl exit 23) fails on the first attempt\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one attempt for curl exit 23 after HTTP 200 (rc=%s calls=%s)\n%s\n' \
    "$rt_rc" "$rt_calls" "$rt_out"
  fail=$(( fail + 1 ))
fi

# The default destination is installed with sudo -n only: a failing sudo is called once, never again without -n.
rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps" "${rt_repo:?}/sudo-calls"
make_stub_bin "$rt_stub" sudo "printf '%s\\n' \"\$*\" >>'${rt_repo}/sudo-calls'; exit 1"
# A stubbed non-root id keeps this test off the root branch, which would write the real /usr/local/bin.
make_stub_bin "$rt_stub" id 'printf "1000\n"'
rt_tmp="$(mktemp -d)"
rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && PATH="${rt_stub}:${PATH}" TMPDIR="$rt_tmp" GITLEAKS_VERSION='0.0.0' RT_FAIL_CALLS=0 bash -c '
        # shellcheck source=/dev/null
        source .github/ci/secret-scan
        ci_secret_scan_install_gitleaks
      ' 2>&1
)" || rt_rc=$?
rt_sudo_calls="$(wc -l <"${rt_repo}/sudo-calls" 2>/dev/null || echo 0)"
rt_leftover="$(find "$rt_tmp" -mindepth 1 -maxdepth 1 | wc -l)"
rm -rf "${rt_tmp:?}"
make_stub_bin "$rt_stub" sudo 'exit 1'
rm -f "${rt_stub:?}/id"
if [[ "$rt_rc" -ne 0 && "$rt_sudo_calls" == '1' && "$rt_leftover" == '0' ]] \
  && grep -qE '^-n install ' "${rt_repo}/sudo-calls" \
  && grep -qF 'ERROR: gitleaks install failed' <<<"$rt_out"; then
  printf '[PASS] a failing sudo is called once with -n, the install reports an ERROR and leaves no temp files\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one sudo -n call, an ERROR line and no leftovers (rc=%s sudo_calls=%s leftover=%s)\n%s\n' \
    "$rt_rc" "$rt_sudo_calls" "$rt_leftover" "$rt_out"
  fail=$(( fail + 1 ))
fi

# Running as root installs directly: no sudo at all, and a failing direct install is reported like any other.
# Stubbed id and install keep this off the real /usr/local/bin.
rt_install_ok() {
  rm -rf "${rt_repo:?}/bin" "${rt_repo:?}/calls" "${rt_repo:?}/sleeps" \
    "${rt_repo:?}/sudo-calls" "${rt_repo:?}/install-calls"
  make_stub_bin "$rt_stub" id 'printf "0\n"'
  make_stub_bin "$rt_stub" sudo "printf '%s\\n' \"\$*\" >>'${rt_repo}/sudo-calls'; exit 1"
  make_stub_bin "$rt_stub" install "printf '%s\\n' \"\$*\" >>'${rt_repo}/install-calls'; exit ${1}"
  rt_out=""
  rt_rc=0
  rt_out="$(
    cd "$rt_repo" \
      && PATH="${rt_stub}:${PATH}" GITLEAKS_VERSION='0.0.0' RT_FAIL_CALLS=0 bash -c '
          # shellcheck source=/dev/null
          source .github/ci/secret-scan
          ci_secret_scan_install_gitleaks
        ' 2>&1
  )" || rt_rc=$?
  rt_install_calls="$(wc -l <"${rt_repo}/install-calls" 2>/dev/null || echo 0)"
  rt_sudo_seen='no'
  [[ -e "${rt_repo}/sudo-calls" ]] && rt_sudo_seen='yes'
  rm -f "${rt_stub:?}/id" "${rt_stub:?}/install"
  make_stub_bin "$rt_stub" sudo 'exit 1'
}

rt_install_ok 0
if [[ "$rt_rc" -eq 0 && "$rt_install_calls" == '1' && "$rt_sudo_seen" == 'no' ]] \
  && grep -qE '^-m 0755 .*/gitleaks /usr/local/bin/gitleaks$' "${rt_repo}/install-calls"; then
  printf '[PASS] as root the default destination is installed directly with no sudo call\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected one direct install and no sudo (rc=%s installs=%s sudo=%s)\n%s\n' \
    "$rt_rc" "$rt_install_calls" "$rt_sudo_seen" "$rt_out"
  fail=$(( fail + 1 ))
fi

rt_install_ok 1
if [[ "$rt_rc" -ne 0 && "$rt_sudo_seen" == 'no' ]] && grep -qF 'ERROR: gitleaks install failed' <<<"$rt_out"; then
  printf '[PASS] as root a failing direct install is reported with an ERROR line and no sudo fallback\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected an ERROR line and no sudo for a failing root install (rc=%s sudo=%s)\n%s\n' \
    "$rt_rc" "$rt_sudo_seen" "$rt_out"
  fail=$(( fail + 1 ))
fi

rt_out=""
rt_rc=0
rt_out="$(
  cd "$rt_repo" \
    && CI_SECRET_SCAN_DOWNLOAD_RETRIES=0 bash -c 'source .github/ci/secret-scan' 2>&1
)" || rt_rc=$?
rm -rf "$rt_repo"
if [[ "$rt_rc" -eq 2 ]] && grep -qF 'invalid CI_SECRET_SCAN_DOWNLOAD_RETRIES' <<<"$rt_out"; then
  printf '[PASS] a zero retry count is rejected with exit 2\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected exit 2 for an invalid retry count (rc=%s)\n%s\n' "$rt_rc" "$rt_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
