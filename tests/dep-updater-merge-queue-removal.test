#!/usr/bin/env bash
# Tests for dep-updater's merge wait when GitHub removes the PR from the merge queue (#844): the wait used to
# run out its whole timeout and report a vague WAIT_TIMEOUT. It now notices the removal, re-enqueues once when
# the queue's own checks failed, and otherwise ends with one ERROR: MERGE_QUEUE_REMOVED line. Hermetic:
# merge_pr_via_gh_single is extracted from the script and every dependency (the merged check, the queue
# lookup, gh, sleep) is stubbed.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

dep_updater="${script_dir}/../scripts/dep-updater"
readonly dep_updater

work_dir="$(mktemp -d)"
readonly work_dir
trap 'rm -rf "${work_dir}"' EXIT

# run_merge <removals sequence> <merged-at poll> <timeout minutes> [gh fail from call] [lookup burn secs]
# -> the function's output, then "rc=<n>". The removals sequence is space separated
# "<latest removal id>|<reason>" answers of the queue lookup ("none|" = never removed; the first one is the
# baseline read before the enqueue; the last one repeats; "-" is an empty answer). The PR reads as merged
# from poll number <merged-at> on (0 = never). gh fails from call number [gh fail from call]. Each queue
# lookup after the baseline advances the synthetic clock by [lookup burn secs] (default 0).
run_merge() {
  local -r sequence="$1" merged_at="$2" timeout_min="$3" gh_fail_from="${4:-0}" lookup_burn_sec="${5:-0}"

  : >"${work_dir}/gh.log"
  printf 0 >"${work_dir}/merged.n"
  printf 0 >"${work_dir}/removals.n"
  printf 0 >"${work_dir}/gh.n"
  printf 0 >"${work_dir}/clock"
  timeout 60 bash -c "
    set -uo pipefail
    repo_owner='the-hcma'
    repo_name='repository-helpers'
    merge_timeout_min=${timeout_min}
    no_wait_ci=0
    $(awk '/^merge_queue_removed_error\(\) \{/,/^\}/' "${dep_updater}")
    $(awk '/^wait_timeout_error\(\) \{/,/^\}/' "${dep_updater}")
    $(awk '/^dep_updater_now_epoch\(\) \{/,/^\}/' "${dep_updater}")
    $(awk '/^dep_updater_reenqueue_auto_merge\(\) \{/,/^\}/' "${dep_updater}")
    $(awk '/^merge_pr_via_gh_single\(\) \{/,/^\}/' "${dep_updater}")
    log() { printf '%s\n' \"\$*\"; }
    die() { printf 'ERROR: %s\n' \"\$*\"; exit 1; }
    record_first_failure() { printf 'RECORDED: %s\n' \"\$*\"; }
    # Advance a synthetic wall clock so a no-op sleep still spends the merge budget the way a real
    # sleep would, and so a slow queue lookup (below) can burn time without a real wait.
    dep_updater_now_epoch() { cat '${work_dir}/clock'; }
    sleep() {
      local -r secs=\"\${1:-0}\"
      printf '%s' \"\$(( \$(cat '${work_dir}/clock') + secs ))\" >'${work_dir}/clock'
    }
    ci_conclusion_for_pr() { printf 'success'; }
    # The counters live in files: these run inside command substitutions, which are subshells.
    gh_pr_merged_for_number() {
      local n
      n=\$(( \$(cat '${work_dir}/merged.n') + 1 ))
      printf '%s' \"\$n\" >'${work_dir}/merged.n'
      if (( ${merged_at} > 0 && n >= ${merged_at} )); then printf 'true'; else printf 'false'; fi
    }
    read -r -a answers <<<'${sequence}'
    gh_pr_merge_queue_removals() {
      local idx
      idx=\$(cat '${work_dir}/removals.n')
      printf '%s' \"\$(( idx + 1 ))\" >'${work_dir}/removals.n'
      # Burn wall-clock time on every lookup after the baseline (idx 0), matching a rate-limited gh call.
      if (( idx > 0 && ${lookup_burn_sec} > 0 )); then
        printf '%s' \"\$(( \$(cat '${work_dir}/clock') + ${lookup_burn_sec} ))\" >'${work_dir}/clock'
      fi
      (( idx < \${#answers[@]} )) || idx=\$(( \${#answers[@]} - 1 ))
      if [[ \"\${answers[idx]}\" == '-' ]]; then printf ''; else printf '%s' \"\${answers[idx]}\"; fi
    }
    # Both entry points count into one log: the first enqueue goes through dep_runner_gh_stdout and the
    # re-enqueue through the shared rate-limit executor.
    stub_gh() {
      local n
      n=\$(( \$(cat '${work_dir}/gh.n') + 1 ))
      printf '%s' \"\$n\" >'${work_dir}/gh.n'
      printf 'GH %s\n' \"\$*\" >>'${work_dir}/gh.log'
      if (( ${gh_fail_from} > 0 && n >= ${gh_fail_from} )); then
        printf 'gh: boom'
        return 1
      fi
      return 0
    }
    dep_runner_gh_stdout() { stub_gh \"\$@\"; }
    github_api_exec_with_rate_limit_retry() { stub_gh \"\$@\"; }
    rc=0
    merge_pr_via_gh_single 7 || rc=\$?
    echo \"rc=\$rc\"" 2>&1 || true
}

gh_calls() {
  grep -c '^GH ' "${work_dir}/gh.log" || true
}

printf '\n=== a failed merge-group run is re-enqueued once and the PR then merges ===\n'
out="$(run_merge 'none| id1|failed_checks' 14 3)"
assert_contains "the wait ends successfully" "$out" "rc=0"
assert_contains "the PR is reported merged" "$out" "PR #7 merged."
assert_contains "the re-enqueue is announced with a parseable note" "$out" \
  "NOTE: MERGE_QUEUE_REENQUEUE pr=#7 repo=the-hcma/repository-helpers reason=failed_checks"
assert_not_contains "no error line is printed" "$out" "ERROR: MERGE_QUEUE_REMOVED"
assert_count_equals "gh enables auto-merge twice: the first enqueue and the re-enqueue" \
  "$(cat "${work_dir}/gh.log")" "GH " 2

printf '\n=== a second removal ends the wait with one parseable error ===\n'
out="$(run_merge 'none| id1|failed_checks id2|failed_checks' 0 3)"
assert_contains "the wait fails" "$out" "rc=1"
assert_contains "the error names the PR, repository, reason and the one re-enqueue" "$out" \
  "ERROR: MERGE_QUEUE_REMOVED pr=#7 repo=the-hcma/repository-helpers reason=failed_checks reenqueued=1"
assert_contains "the failure is recorded for the batch report" "$out" "RECORDED: MERGE_QUEUE_REMOVED pr=#7"
assert_not_contains "it is not reported as a timeout" "$out" "WAIT_TIMEOUT"
assert_count_equals "gh enables auto-merge only twice" "$(cat "${work_dir}/gh.log")" "GH " 2

printf '\n=== a removal for another reason is not re-enqueued ===\n'
out="$(run_merge 'none| id1|merge_conflict' 0 3)"
assert_contains "the wait fails" "$out" "rc=1"
assert_contains "the error carries the reason and no re-enqueue" "$out" \
  "ERROR: MERGE_QUEUE_REMOVED pr=#7 repo=the-hcma/repository-helpers reason=merge_conflict reenqueued=0"
assert_not_contains "no re-enqueue note" "$out" "MERGE_QUEUE_REENQUEUE"
assert_count_equals "gh enables auto-merge once" "$(cat "${work_dir}/gh.log")" "GH " 1

printf '\n=== a failing re-enqueue is reported, not hidden behind a gh error ===\n'
out="$(run_merge 'none| id1|failed_checks' 0 3 2)"
assert_contains "the wait fails" "$out" "rc=1"
assert_contains "the error says the re-enqueue failed" "$out" \
  "ERROR: MERGE_QUEUE_REMOVED pr=#7 repo=the-hcma/repository-helpers reason=failed_checks reenqueued=failed"
assert_contains "gh's own message is logged" "$out" "gh: boom"

printf '\n=== removals that already existed before the enqueue are ignored ===\n'
out="$(run_merge 'id9|failed_checks id9|failed_checks' 0 1)"
assert_contains "the wait ends in the usual timeout" "$out" "ERROR: WAIT_TIMEOUT merge pr=#7 via=gh"
assert_not_contains "no removal error" "$out" "MERGE_QUEUE_REMOVED"
assert_not_contains "no re-enqueue" "$out" "MERGE_QUEUE_REENQUEUE"

printf '\n=== a failed lookup is never mistaken for a removal ===\n'
out="$(run_merge 'none| -' 0 1)"
assert_contains "an empty queue answer leaves the usual timeout" "$out" "ERROR: WAIT_TIMEOUT merge pr=#7 via=gh"
assert_not_contains "no removal error for an empty answer" "$out" "MERGE_QUEUE_REMOVED"

printf '\n=== a failed baseline lookup does not turn an old removal into a new one ===\n'
out="$(run_merge '- id1|failed_checks id1|failed_checks' 0 3)"
assert_contains "the wait ends in the usual timeout" "$out" "ERROR: WAIT_TIMEOUT merge pr=#7 via=gh"
assert_not_contains "the old removal is not reported" "$out" "MERGE_QUEUE_REMOVED"
assert_not_contains "the old removal is not re-enqueued" "$out" "MERGE_QUEUE_REENQUEUE"
assert_count_equals "gh enables auto-merge once" "$(cat "${work_dir}/gh.log")" "GH " 1

printf '\n=== a failed baseline still catches a removal that happens afterwards ===\n'
out="$(run_merge '- id1|failed_checks id2|failed_checks' 0 3)"
assert_contains "the first successful check becomes the baseline and the next removal is re-enqueued" "$out" \
  "NOTE: MERGE_QUEUE_REENQUEUE pr=#7 repo=the-hcma/repository-helpers reason=failed_checks"
assert_count_equals "gh enables auto-merge twice" "$(cat "${work_dir}/gh.log")" "GH " 2

printf '\n=== a slow queue lookup counts against the merge deadline ===\n'
# timeout=1m; the first mid-wait lookup burns 50s. Sleep-only accounting would still report waited≈1m0s and
# keep polling; wall-clock accounting ends once the lookup pushes past the deadline and reports the real elapsed.
out="$(run_merge 'none| none|' 0 1 0 50)"
assert_contains "the wait times out" "$out" "ERROR: WAIT_TIMEOUT merge pr=#7 via=gh"
assert_contains "waited= reports wall-clock time including the slow lookup, not only sleep" "$out" \
  "waited=1m 20s timeout=1m"
assert_not_contains "no removal path" "$out" "MERGE_QUEUE_REMOVED"

printf '\n=== a PR that merges during a slow lookup is reported merged, not timed out ===\n'
# merged_at=6 reaches only the post-deadline recheck: (1) pre-wait, (2-5) mid-wait polls at t=0/10/20/30,
# then the lookup burns the clock to 80 and (6) the post-deadline recheck sees merged=true.
out="$(run_merge 'none| none|' 6 1 0 50)"
assert_contains "the wait ends successfully" "$out" "rc=0"
assert_contains "the PR is reported merged" "$out" "PR #7 merged."
assert_not_contains "it is not reported as a timeout" "$out" "WAIT_TIMEOUT"
clock_after="$(cat "${work_dir}/clock")"
if [[ "$clock_after" == "80" ]]; then
  pass_case "the slow lookup advanced the clock past the deadline"
else
  printf 'expected clock 80, got %s\n' "$clock_after" >&2
  fail_case "the slow lookup advanced the clock past the deadline"
fi

# run_lookup <graphql response json> -> the lookup's "<latest removal id>|<reason>" answer, with the real jq filter
# applied to the fixture by a stub of the gh api executor.
run_lookup() {
  local -r fixture="$1"

  timeout 30 bash -c "
    set -uo pipefail
    repo_owner='the-hcma'
    repo_name='repository-helpers'
    $(awk '/^gh_pr_merge_queue_removals\(\) \{/,/^\}/' "${dep_updater}")
    dep_runner_gh_stdout() {
      local filter=''
      while [[ \$# -gt 0 ]]; do
        if [[ \"\$1\" == '--jq' ]]; then filter=\"\$2\"; fi
        shift
      done
      jq -r \"\$filter\" <<<'${fixture}'
    }
    gh_pr_merge_queue_removals 845" 2>&1 || true
}

assert_equals() {
  local -r label="$1" actual="$2" expected="$3"

  if [[ "$actual" == "$expected" ]]; then
    pass_case "$label"
  else
    printf 'expected [%s], got [%s]\n' "$expected" "$actual" >&2
    fail_case "$label"
  fi
}

# lookup_for <totalCount> <nodes json> -> the lookup's answer for a GraphQL response with those timeline items.
lookup_for() {
  run_lookup "{\"data\":{\"repository\":{\"pullRequest\":{\"timelineItems\":{\"totalCount\":$1,\"nodes\":$2}}}}}"
}

printf '\n=== dep_updater_now_epoch delegates to time_log_now_utc_epoch ===\n'
now_out="$(
  timeout 15 bash -c "
    set -uo pipefail
    $(awk '/^dep_updater_now_epoch\(\) \{/,/^\}/' "${dep_updater}")
    time_log_now_utc_epoch() { printf '1700000000'; }
    dep_updater_now_epoch
  "
)"
assert_equals "the helper returns time_log_now_utc_epoch's epoch seconds" "$now_out" "1700000000"

printf '\n=== the lookup names the latest removal by id and skips the merge-time removal ===\n'
assert_equals "no removal events answers none" "$(lookup_for 74 '[]')" "none|"
assert_equals "totalCount counts every timeline item and is ignored; the latest removal and its reason are reported" \
  "$(lookup_for 74 '[{"id":"A","reason":"failed_checks"},{"id":"B","reason":"merge_conflict"}]')" \
  "B|merge_conflict"
assert_equals "the removal GitHub records when the PR merges is not a removal" \
  "$(lookup_for 9 '[{"id":"A","reason":"failed_checks"},{"id":"B","reason":"merged"}]')" "A|failed_checks"
assert_equals "nodes of another event type (no reason) are not removals" \
  "$(lookup_for 3 '[{},{"id":"A","reason":"failed_checks"}]')" "A|failed_checks"

printf '\n=== a full page of 50 removals still shows the newest one (page-boundary regression) ===\n'
page_old="$(jq -nc '[range(1;51) | {id: "R\(.)", reason: "failed_checks"}]')"
page_new="$(jq -nc '[range(2;52) | {id: "R\(.)", reason: "failed_checks"}]')"
assert_equals "a full page names its newest removal" "$(lookup_for 90 "$page_old")" "R50|failed_checks"
assert_equals "the next removal pushes the oldest out and changes the answer although the page length is 50" \
  "$(lookup_for 91 "$page_new")" "R51|failed_checks"
out="$(run_merge 'R50|failed_checks R51|failed_checks' 0 3)"
assert_contains "the wait re-enqueues a removal that arrives when the page is already full" "$out" \
  "NOTE: MERGE_QUEUE_REENQUEUE pr=#7 repo=the-hcma/repository-helpers reason=failed_checks"

printf '\n=== static: the failure keeps the PR open and reaches the batch summary ===\n'
cleanup_body="$(awk '/^cleanup_on_error\(\) \{/,/^\}/' "${dep_updater}")"
assert_contains "cleanup_on_error leaves the PR open for a queue removal" "$cleanup_body" \
  "MERGE_QUEUE_REMOVED*"
scrape_body="$(awk '/^batch_all_scrape_actionable_from_log\(\) \{/,/^\}/' "${dep_updater}")"
assert_contains "the batch summary scrapes the removal line" "$scrape_body" \
  "(WAIT_TIMEOUT|MERGE_QUEUE_REMOVED)"
lookup_body="$(awk '/^gh_pr_merge_queue_removals\(\) \{/,/^\}/' "${dep_updater}")"
assert_contains "the lookup goes through the rate-limited gh api executor" "$lookup_body" \
  "dep_runner_gh_stdout \"gh pr merge queue removals\" -- api graphql"
reenqueue_body="$(awk '/^dep_updater_reenqueue_auto_merge\(\) \{/,/^\}/' "${dep_updater}")"
assert_contains "the re-enqueue goes through the shared rate-limit executor with pacing and a timeout" \
  "$reenqueue_body" "github_api_exec_with_rate_limit_retry \"gh pr merge re-enqueue\" -- gh pr merge"
merge_body="$(awk '/^merge_pr_via_gh_single\(\) \{/,/^\}/' "${dep_updater}")"
assert_contains "the merge wait deadlines from wall-clock time, not sleep increments alone" \
  "$merge_body" "dep_updater_now_epoch"

test_summary
