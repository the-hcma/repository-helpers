#!/usr/bin/env bash
# Tests for scripts/github-repo-lint --enforcer.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/github-repo-lint"
setup_wrapper="${script_dir}/../scripts/setup-github-repo-lint"
unit="${script_dir}/../etc/systemd/github-repo-lint.service"
timer="${script_dir}/../etc/systemd/github-repo-lint.timer"
env_example="${script_dir}/../etc/github-repo-lint.env.example"
readonly script setup_wrapper unit timer env_example

pass=0
fail=0

write_test_env_file() {
  local -r dir="$1"
  mkdir -p "${dir}/.config"
  cat >"${dir}/.config/github-repo-lint.env" <<'EOF'
GITHUB_REPO_LINT_SMTP_HOST=smtp.test
GITHUB_REPO_LINT_REPORT_TO=johndoe@example.com
GITHUB_REPO_LINT_REPORT_FROM=github-repo-lint@example.com
EOF
}

printf '\n=== static: service assets ===\n'
if [[ -x "$script" ]] \
  && [[ -x "$setup_wrapper" ]] \
  && [[ -f "$unit" ]] \
  && [[ -f "$timer" ]] \
  && [[ -f "$env_example" ]] \
  && grep -qF -- '--apply-fix' "$env_example"; then
  printf '[PASS] assets: runner, setup wrapper, env example, service, and timer exist\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] assets: missing github-repo-lint enforcer assets\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'EnvironmentFile=-%h/.config/dep-updater.env' "$unit" \
  && grep -qF 'EnvironmentFile=-%h/.config/github-repo-lint.env' "$unit" \
  && grep -qF 'ExecStart=@@REPO_DIR@@/scripts/github-repo-lint' "$unit" \
  && grep -qF 'github-repo-lint.log' "$unit" \
  && grep -qF 'Unit=github-repo-lint.service' "$timer" \
  && grep -qF 'OnCalendar=*-*-* 04:00:00' "$timer" \
  && ! grep -qF 'WantedBy=default.target' "$unit"; then
  printf '[PASS] unit: daily systemd service uses SMTP fallback, runner, and log\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] unit: expected github-repo-lint service/timer wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: setup-service integration ===\n'
if grep -qF 'GITHUB_REPO_LINT_SERVICE_UNIT=github-repo-lint' "$setup_wrapper" \
  && grep -qF 'GITHUB_REPO_LINT_SERVICE_UNIT' "${script_dir}/../scripts/setup-service"; then
  printf '[PASS] setup: wrapper selects github-repo-lint unit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] setup: expected wrapper and setup-service unit override for github-repo-lint\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: strict onboarding monitor ===\n'
if grep -qF 'enforcer_discover_repo_slugs' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'rp_discover_org_repos' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_discover_note' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_check_cmd' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_run_context_command' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_discover_notes_file' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_print_repo_sections' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_format_passed_slugs' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_short_name_from_note' "${script_dir}/../scripts/github-repo-lint" \
  && ! grep -qF 'Practices output:' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'repo_helpers_run_context_footer_full' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF -- '--strict-onboarding' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF -- '--compact' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF $'tee -a "$enforcer_run_log" <"$enforcer_check_log"' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF "\"\${enforcer_check_log:-}\"" "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'lib/runner-bootstrap' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'run_command "github-repo-lint enforcer checks"' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'env -u RUNNER_SESSION_DIR -u RUNNER_SESSION_KEEP' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'enforcer_append_runner_stderr' "${script_dir}/../scripts/github-repo-lint" \
  && ! grep -qF 'enforcer_runner_git_show_toplevel' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'parsed_failure_count=' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF '[A-Za-z]//g' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'runner_report_append_command_failures' "${script_dir}/../scripts/github-repo-lint"; then
  printf '[PASS] monitor: discovers org repos via GitHub API and runs compact strict checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] monitor: missing repo discovery or strict check invocation\n'
  fail=$(( fail + 1 ))
fi

# write_mock_org_gh <bin-dir> <repo-name> [<repo-name> ...]
# Lists the given names for orgs/*/repos (public jq filter still matches).
write_mock_org_gh() {
  local -r bin_dir="$1"
  shift
  local repo
  mkdir -p "$bin_dir"
  {
    cat <<'HDR'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'orgs/'*'/repos'* ]]; then
HDR
    for repo in "$@"; do
      printf "  printf '%%s\\n' '%s'\n" "$repo"
    done
    cat <<'FTR'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
FTR
  } >"${bin_dir}/gh"
  chmod +x "${bin_dir}/gh"
}

printf '\n=== static: enforcer singleton lock ===\n'
if grep -qF 'lib/timer-singleton-lock' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'timer_singleton_acquire_lock' "${script_dir}/../scripts/github-repo-lint" \
  && grep -qF 'github-repo-lint.lock' "${script_dir}/../scripts/github-repo-lint"; then
  printf '[PASS] singleton-lock: enforcer uses shared timer flock helper\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] singleton-lock: missing flock guard for duplicate enforcer starts\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== missing env file exits non-zero ===\n'
missing_home=""
missing_home="$(mktemp -d)"
missing_out=""
missing_exit=0
missing_out="$(
  HOME="$missing_home" bash "$script" 2>&1
)" || missing_exit=$?
rm -rf "$missing_home"
if [[ "$missing_exit" -ne 0 ]] \
  && grep -qF 'Missing required env file' <<<"$missing_out" \
  && grep -qF 'dep-updater.env' <<<"$missing_out"; then
  printf '[PASS] missing-env: hard failure when env file absent\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing-env: expected die on missing env (exit=%s)\n' "$missing_exit"
  fail=$(( fail + 1 ))
fi

printf '\n=== --print builds multipart report ===\n'
print_tmp=""
print_tmp="$(mktemp -d)"
write_test_env_file "$print_tmp"
print_out=""
print_exit=0
print_out="$(
  HOME="$print_tmp" REPO_HELPERS_TEST_MODE=1 \
    bash "$script" --print 2>/dev/null
)" || print_exit=$?
rm -rf "$print_tmp"
if [[ "$print_exit" -eq 0 ]] \
  && grep -qF 'GitHub Repo Lint PASSED' <<<"$print_out" \
  && grep -qF 'scripts/github-repo-lint --repo OWNER/NAME --apply-fix' <<<"$print_out" \
  && grep -qF 'Org:' <<<"$print_out" \
  && grep -qF 'demo-repo' <<<"$print_out" \
  && grep -qF 'multipart/alternative' <<<"$print_out"; then
  printf '[PASS] print: sample multipart email on stdout\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] print: expected sample multipart report (exit=%s)\n' "$print_exit"
  fail=$(( fail + 1 ))
fi

printf '\n=== mock monitor sends SMTP report on failure ===\n'
tmp=""
tmp="$(mktemp -d)"
write_test_env_file "$tmp"
mkdir -p "$tmp/scratch" "$tmp/bin"
write_mock_org_gh "$tmp/bin" ok-repo bad-repo

cat >"$tmp/github-repo-lint-checker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GITHUB_REPO_LINT_ARGS_LOG:?}"
if [[ "$*" == *'the-hcma/bad-repo'* ]]; then
  printf 'Passed: the-hcma/ok-repo\n' >&2
  printf 'Failed:\n' >&2
  printf 'the-hcma/bad-repo:\n' >&2
  printf '  - merge-it label is required for full org onboarding\n' >&2
  printf '    Fix: create merge-it label and enable Graphite merge queue on main\n' >&2
  printf '1 of 2 repositories failed practices check\n' >&2
  exit 1
fi
printf 'Passed: the-hcma/ok-repo, the-hcma/bad-repo\n' >&2
printf 'all 2 repositories passed\n' >&2
EOF
chmod +x "$tmp/github-repo-lint-checker"

breadcrumb="${tmp}/smtp.out"
args_log="${tmp}/args.out"
monitor_exit=0
(
  HOME="$tmp" \
  PATH="${tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  REPO_HELPERS_SMTP_BREADCRUMB="$breadcrumb" \
  GITHUB_REPO_LINT_ARGS_LOG="$args_log" \
  GITHUB_REPO_LINT_LOG="${tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${tmp}/github-repo-lint-checker" \
  bash "${script_dir}/../scripts/github-repo-lint"
) >/dev/null || monitor_exit=$?

if [[ "$monitor_exit" -eq 1 ]] \
  && [[ -f "$breadcrumb" ]] \
  && grep -qF 'GitHub Repo Lint FAILED' "$breadcrumb" \
  && grep -qF 'Org:      the-hcma' "$breadcrumb" \
  && grep -qF 'Repos:    2 checked, 1 failed' "$breadcrumb" \
  && grep -qF 'scripts/github-repo-lint --repo OWNER/NAME --apply-fix' "$breadcrumb" \
  && grep -qF 'Skipped:' "$breadcrumb" \
  && grep -qF 'Passed:' "$breadcrumb" \
  && grep -qF 'Failed:' "$breadcrumb" \
  && grep -qF 'ok-repo' "$breadcrumb" \
  && grep -qF 'bad-repo:' "$breadcrumb" \
  && grep -qF 'Fix: create merge-it label and enable Graphite merge queue on main' "$breadcrumb" \
  && grep -qF 'multipart/alternative' "$breadcrumb" \
  && grep -qF -- '--strict-onboarding' "$args_log" \
  && grep -qF -- '--compact' "$args_log"; then
  printf '[PASS] mock-monitor: exit 1 and sends failure email from strict checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mock-monitor: expected failure email and strict args (exit=%s)\n' "$monitor_exit"
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp"

printf '\n=== mock monitor lists passed repos from compact stderr ===\n'
ok_tmp=""
ok_tmp="$(mktemp -d)"
write_test_env_file "$ok_tmp"
mkdir -p "$ok_tmp/scratch" "$ok_tmp/bin"
write_mock_org_gh "$ok_tmp/bin" ok-repo

cat >"$ok_tmp/github-repo-lint-checker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'label-json-on-stdout\n'
printf 'Passed: the-hcma/ok-repo\n' >&2
printf 'all 1 repositories passed\n' >&2
EOF
chmod +x "$ok_tmp/github-repo-lint-checker"

ok_breadcrumb="${ok_tmp}/smtp.out"
ok_exit=0
(
  HOME="$ok_tmp" \
  PATH="${ok_tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  REPO_HELPERS_SMTP_BREADCRUMB="$ok_breadcrumb" \
  GITHUB_REPO_LINT_LOG="${ok_tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${ok_tmp}/github-repo-lint-checker" \
  bash "${script_dir}/../scripts/github-repo-lint"
) >/dev/null || ok_exit=$?

if [[ "$ok_exit" -eq 0 ]] \
  && [[ -f "$ok_breadcrumb" ]] \
  && grep -qF 'GitHub Repo Lint PASSED' "$ok_breadcrumb" \
  && grep -qF 'Repos:    1 checked, 0 failed' "$ok_breadcrumb" \
  && grep -A1 'Passed:' "$ok_breadcrumb" | grep -qF 'ok-repo' \
  && ! grep -qE '^Failed:' "$ok_breadcrumb"; then
  printf '[PASS] mock-monitor: compact stderr Passed line appears in success email\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mock-monitor: expected passed repo list in email without Failed section (exit=%s)\n' "$ok_exit"
  fail=$(( fail + 1 ))
fi
rm -rf "$ok_tmp"

printf '\n=== discovery excludes private repos via org API jq filter ===\n'
disc_tmp=""
disc_tmp="$(mktemp -d)"
write_test_env_file "$disc_tmp"
mkdir -p "$disc_tmp/bin" "$disc_tmp/scratch"

cat >"$disc_tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'orgs/the-hcma/repos'* && "$args" == *'private == false'* ]]; then
  printf '%s\n' 'public-repo'
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' 'public-repo'
  printf '%s\n' 'private-repo'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
EOF
chmod +x "$disc_tmp/bin/gh"

disc_args_log="${disc_tmp}/args.out"
cat >"$disc_tmp/github-repo-lint-checker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GITHUB_REPO_LINT_ARGS_LOG:?}"
printf 'Passed: the-hcma/public-repo\n' >&2
printf 'all 1 repositories passed\n' >&2
EOF
chmod +x "$disc_tmp/github-repo-lint-checker"

disc_monitor_exit=0
(
  HOME="$disc_tmp" \
  PATH="${disc_tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  GITHUB_REPO_LINT_ARGS_LOG="$disc_args_log" \
  GITHUB_REPO_LINT_LOG="${disc_tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${disc_tmp}/github-repo-lint-checker" \
  bash "${script}"
) >/dev/null || disc_monitor_exit=$?

if [[ "$disc_monitor_exit" -eq 0 ]] \
  && grep -qF -- '--repo the-hcma/public-repo' "$disc_args_log" \
  && ! grep -qF 'private-repo' "$disc_args_log"; then
  printf '[PASS] discovery: private org repos are excluded without --include-private\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] discovery: expected only public repo in checker args (exit=%s)\n%s\n' \
    "$disc_monitor_exit" "$(cat "$disc_args_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$disc_tmp"

printf '\n=== discovery includes org repos without a local clone ===\n'
nloc_tmp=""
nloc_tmp="$(mktemp -d)"
write_test_env_file "$nloc_tmp"
mkdir -p "$nloc_tmp/bin" "$nloc_tmp/scratch"
# No local clones under the workdir — only the org API list drives discovery.
write_mock_org_gh "$nloc_tmp/bin" remote-only-repo org-repo

nloc_args_log="${nloc_tmp}/args.out"
cat >"$nloc_tmp/github-repo-lint-checker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GITHUB_REPO_LINT_ARGS_LOG:?}"
printf 'Passed: the-hcma/org-repo, the-hcma/remote-only-repo\n' >&2
printf 'all 2 repositories passed\n' >&2
EOF
chmod +x "$nloc_tmp/github-repo-lint-checker"

nloc_monitor_exit=0
(
  HOME="$nloc_tmp" \
  PATH="${nloc_tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  GITHUB_REPO_LINT_ARGS_LOG="$nloc_args_log" \
  GITHUB_REPO_LINT_LOG="${nloc_tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${nloc_tmp}/github-repo-lint-checker" \
  bash "${script}"
) >/dev/null || nloc_monitor_exit=$?

if [[ "$nloc_monitor_exit" -eq 0 ]] \
  && grep -qF -- '--repo the-hcma/remote-only-repo' "$nloc_args_log" \
  && grep -qF -- '--repo the-hcma/org-repo' "$nloc_args_log"; then
  printf '[PASS] discovery: org API includes repos even without a local clone\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] discovery: expected remote-only-repo and org-repo from API (exit=%s)\n%s\n' \
    "$nloc_monitor_exit" "$(cat "$nloc_args_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$nloc_tmp"

printf '\n=== discovery matches org filter case-insensitively ===\n'
case_tmp=""
case_tmp="$(mktemp -d)"
write_test_env_file "$case_tmp"
mkdir -p "$case_tmp/bin" "$case_tmp/scratch"
write_mock_org_gh "$case_tmp/bin" org-repo

case_args_log="${case_tmp}/args.out"
cat >"$case_tmp/github-repo-lint-checker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GITHUB_REPO_LINT_ARGS_LOG:?}"
printf 'Passed: the-hcma/org-repo\n' >&2
printf 'all 1 repositories passed\n' >&2
EOF
chmod +x "$case_tmp/github-repo-lint-checker"

case_monitor_exit=0
(
  HOME="$case_tmp" \
  PATH="${case_tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  GITHUB_REPO_LINT_ARGS_LOG="$case_args_log" \
  GITHUB_REPO_LINT_ORG='The-HCMA' \
  GITHUB_REPO_LINT_LOG="${case_tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${case_tmp}/github-repo-lint-checker" \
  bash "${script}"
) >/dev/null || case_monitor_exit=$?

if [[ "$case_monitor_exit" -eq 0 ]] \
  && grep -qF -- '--repo the-hcma/org-repo' "$case_args_log"; then
  printf '[PASS] discovery: mixed-case GITHUB_REPO_LINT_ORG still matches org repos\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] discovery: expected mixed-case org filter match (exit=%s)\n%s\n' \
    "$case_monitor_exit" "$(cat "$case_args_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$case_tmp"

printf '\n=== include-private from env file is applied after load ===\n'
priv_tmp=""
priv_tmp="$(mktemp -d)"
write_test_env_file "$priv_tmp"
printf 'GITHUB_REPO_LINT_INCLUDE_PRIVATE=1\n' >>"${priv_tmp}/.config/github-repo-lint.env"
mkdir -p "$priv_tmp/bin" "$priv_tmp/scratch"

cat >"$priv_tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'orgs/the-hcma/repos'* && "$args" == *'private == false'* ]]; then
  printf '%s\n' 'public-only'
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' 'public-only'
  printf '%s\n' 'private-repo'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
EOF
chmod +x "$priv_tmp/bin/gh"

priv_args_log="${priv_tmp}/args.out"
cat >"$priv_tmp/github-repo-lint-checker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GITHUB_REPO_LINT_ARGS_LOG:?}"
printf 'Passed: the-hcma/private-repo, the-hcma/public-only\n' >&2
printf 'all 2 repositories passed\n' >&2
EOF
chmod +x "$priv_tmp/github-repo-lint-checker"

priv_exit=0
(
  HOME="$priv_tmp" \
  PATH="${priv_tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  GITHUB_REPO_LINT_ARGS_LOG="$priv_args_log" \
  GITHUB_REPO_LINT_LOG="${priv_tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${priv_tmp}/github-repo-lint-checker" \
  bash "${script}"
) >/dev/null || priv_exit=$?

if [[ "$priv_exit" -eq 0 ]] \
  && grep -qF -- '--repo the-hcma/private-repo' "$priv_args_log" \
  && grep -qF -- '--repo the-hcma/public-only' "$priv_args_log"; then
  printf '[PASS] include-private: env file flag is honored after enforcer_load_required_env_file\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] include-private: expected private-repo from env file (exit=%s)\n%s\n' \
    "$priv_exit" "$(cat "$priv_args_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$priv_tmp"

printf '\n=== org API discovery failure is not treated as an empty org ===\n'
fail_tmp=""
fail_tmp="$(mktemp -d)"
write_test_env_file "$fail_tmp"
mkdir -p "$fail_tmp/bin" "$fail_tmp/scratch"

cat >"$fail_tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'orgs/'*'/repos'* ]]; then
  printf 'gh: API error simulating discovery failure\n' >&2
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
EOF
chmod +x "$fail_tmp/bin/gh"

fail_breadcrumb="${fail_tmp}/smtp.out"
fail_exit=0
(
  HOME="$fail_tmp" \
  PATH="${fail_tmp}/bin:${PATH}" \
  REPO_HELPERS_TEST_MODE=1 \
  REPO_HELPERS_SMTP_BREADCRUMB="$fail_breadcrumb" \
  GITHUB_REPO_LINT_LOG="${fail_tmp}/scratch/github-repo-lint.log" \
  GITHUB_REPO_LINT_CHECKER="${fail_tmp}/bin/true" \
  bash "${script}"
) >/dev/null || fail_exit=$?

if [[ "$fail_exit" -ne 0 ]] \
  && [[ -f "$fail_breadcrumb" ]] \
  && grep -qF 'Command failures' "$fail_breadcrumb" \
  && grep -qF 'repo-practices org repos' "$fail_breadcrumb" \
  && ! grep -qF 'no GitHub repositories discovered for org' "$fail_breadcrumb"; then
  printf '[PASS] discovery: GitHub API failure is reported distinctly from empty org\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] discovery: expected API failure report (exit=%s)\n%s\n' \
    "$fail_exit" "$(cat "$fail_breadcrumb" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$fail_tmp"

printf '\n=== print report includes run context footer ===\n'
ctx_tmp=""
ctx_tmp="$(mktemp -d)"
write_test_env_file "$ctx_tmp"
ctx_out=""
ctx_exit=0
ctx_out="$(
  HOME="$ctx_tmp" REPO_HELPERS_TEST_MODE=1 \
    bash "$script" --print 2>/dev/null
)" || ctx_exit=$?
if [[ "$ctx_exit" -eq 0 ]] \
  && grep -qF 'Run context:' <<<"$ctx_out" \
  && grep -qF 'Host:' <<<"$ctx_out" \
  && grep -qF 'User:' <<<"$ctx_out" \
  && grep -qF 'Workdir:' <<<"$ctx_out" \
  && grep -qF 'Command:' <<<"$ctx_out" \
  && grep -qF 'Started:' <<<"$ctx_out" \
  && grep -qF 'Finished:' <<<"$ctx_out" \
  && grep -qF 'Log file:' <<<"$ctx_out" \
  && ! grep -qF 'Practices output:' <<<"$ctx_out" \
  && grep -qF 'Skipped:' <<<"$ctx_out" \
  && grep -qF 'Passed:' <<<"$ctx_out" \
  && ! grep -qE '^Failed:' <<<"$ctx_out"; then
  printf '[PASS] print: multipart report ends with unified run context footer\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] print: expected run context footer (exit=%s)\n' "$ctx_exit"
  fail=$(( fail + 1 ))
fi
rm -rf "$ctx_tmp"

printf '\n=== slug discovery strips .git suffix ===\n'
slug_lib="${script_dir}/../scripts/lib/github-repo-slug"
# shellcheck disable=SC1090,SC1091
source "$slug_lib"
slug_from_https=""
slug_from_https="$(gh_slug_from_origin_url 'https://github.com/the-hcma/dotted-repo.git')"
slug_from_ssh=""
slug_from_ssh="$(gh_slug_from_origin_url 'git@github.com:the-hcma/dotted-repo.git')"
if [[ "$slug_from_https" == 'the-hcma/dotted-repo' ]] \
  && [[ "$slug_from_ssh" == 'the-hcma/dotted-repo' ]] \
  && grep -qF '%.git}' "$slug_lib"; then
  printf '[PASS] slug-discovery: shared slug helper strips .git suffix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] slug-discovery: expected .git suffix stripped (https=%s ssh=%s)\n' \
    "$slug_from_https" "$slug_from_ssh"
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
