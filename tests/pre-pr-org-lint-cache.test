#!/usr/bin/env bash
# Tests for skipping the org-wide repo-practices audit in pre-pr-checks when nothing it reads has changed (#824).
# Two worktrees each ran a full org audit against one shared API budget; a passing run is now recorded with a
# fingerprint (org-wide templates at HEAD plus every org repo's default-branch SHA) and reused for a few hours.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/pre-pr-ecosystem"

work_dir="$(mktemp -d)"
readonly work_dir
trap 'rm -rf "${work_dir}"' EXIT

fixture="${work_dir}/repo"
mkdir -p "${fixture}/scripts/lib/repo-practices-agents"
(
  cd "$fixture"
  git init -q
  git config user.email 'test@example.com'
  git config user.name 'Test'
  printf '#!/usr/bin/env bash\n' >scripts/github-repo-lint
  printf 'template v1\n' >scripts/lib/repo-practices-agents/rule.md
  # shellcheck disable=SC2016  # the fake helper must read the variable when it runs, not now
  printf '#!/usr/bin/env bash\ncat -- "$FAKE_REMOTE_FILE" || exit 1\n' >scripts/gh-api
  chmod +x scripts/gh-api
  git add -A
  git commit -q -m init
)

export FAKE_REMOTE_FILE="${work_dir}/remote.txt"
export PRE_PR_CHECKS_CACHE_DIR="${work_dir}/cache"
printf 'the-hcma/a sha-a1\nthe-hcma/b sha-b1\n' >"$FAKE_REMOTE_FILE"

# Stubs for the parts that touch GitHub or the diff; the fingerprint and the cache are the real code.
runs_file="${work_dir}/runs"
: >"$runs_file"
lint_rc=0
# count_runs — how many audits have run (a file, because run_job captures output in a subshell).
count_runs() { wc -l <"$runs_file" | tr -d ' '; }
gh_slug_from_repo_dir() { printf 'the-hcma/repository-helpers\n'; }
prec_org_wide_lint_trigger() { printf 'scripts/lib/repo-practices-agents/rule.md\n'; }
run_command() {
  printf 'run\n' >>"$runs_file"
  return "$lint_rc"
}

# run_job — runs the audit job; leaves its output in job_out and its exit status in job_rc.
run_job() {
  job_rc=0
  job_out="$(prec_run_repo_practices_lint "$fixture" 2>&1)" || job_rc=$?
}

printf '\n=== the first run audits the org and records the pass ===\n'
run_job
assert_contains 'the audit runs' "$job_out" 'running org-wide'
assert_contains 'the audit ran once' "runs=$(count_runs)" 'runs=1'
assert_contains 'the job passes' "rc=${job_rc}" 'rc=0'
assert_contains 'the pass is recorded' "$(ls "${work_dir}/cache")" 'org-lint-pass.the-hcma'

printf '\n=== an unchanged set of main SHAs skips the audit ===\n'
run_job
assert_contains 'the skip is announced with the reason' "$job_out" 'skipped org-wide audit'
assert_contains 'the skip names how to force the audit' "$job_out" 'PRE_PR_CHECKS_ORG_LINT_CACHE_TTL=0'
assert_contains 'the audit did not run again' "runs=$(count_runs)" 'runs=1'
assert_contains 'the job passes' "rc=${job_rc}" 'rc=0'

printf '\n=== a changed main SHA runs the audit ===\n'
printf 'the-hcma/a sha-a2\nthe-hcma/b sha-b1\n' >"$FAKE_REMOTE_FILE"
run_job
assert_contains 'the audit runs again' "runs=$(count_runs)" 'runs=2'
assert_not_contains 'no skip is announced' "$job_out" 'skipped org-wide audit'

printf '\n=== a new org repository runs the audit ===\n'
printf 'the-hcma/a sha-a2\nthe-hcma/b sha-b1\nthe-hcma/c sha-c1\n' >"$FAKE_REMOTE_FILE"
run_job
assert_contains 'the audit runs for the new repository' "runs=$(count_runs)" 'runs=3'

printf '\n=== a changed org-wide template runs the audit ===\n'
(
  cd "$fixture"
  printf 'template v2\n' >scripts/lib/repo-practices-agents/rule.md
  git commit -q -am 'change template'
)
run_job
assert_contains 'the audit runs for the changed template' "runs=$(count_runs)" 'runs=4'
run_job
assert_contains 'the same template is skipped afterwards' "runs=$(count_runs)" 'runs=4'

printf '\n=== a failing audit is not recorded ===\n'
printf 'the-hcma/a sha-a9\n' >"$FAKE_REMOTE_FILE"
lint_rc=1
run_job
assert_contains 'the failure is returned' "rc=${job_rc}" 'rc=1'
run_job
assert_contains 'the next run audits again instead of skipping' "runs=$(count_runs)" 'runs=6'
lint_rc=0

printf '\n=== an expired record runs the audit ===\n'
run_job
runs_before="$(count_runs)"
cache_file="$(prec_org_lint_cache_file the-hcma)"
read -r recorded_fp _ <"$cache_file"
printf '%s %s\n' "$recorded_fp" "$(( EPOCHSECONDS - 90000 ))" >"$cache_file"
run_job
assert_contains 'a record older than the TTL does not skip' "runs=$(( $(count_runs) - runs_before ))" 'runs=1'

printf '\n=== a failed lookup runs the audit instead of trusting a partial key ===\n'
runs_before="$(count_runs)"
mv -- "${fixture}/scripts/gh-api" "${fixture}/scripts/gh-api.off"
run_job
mv -- "${fixture}/scripts/gh-api.off" "${fixture}/scripts/gh-api"
assert_contains 'no gh-api helper means the audit runs' "runs=$(( $(count_runs) - runs_before ))" 'runs=1'
runs_before="$(count_runs)"
rm -f -- "$FAKE_REMOTE_FILE"
run_job
printf 'the-hcma/a sha-a9\n' >"$FAKE_REMOTE_FILE"
assert_contains 'a failing remote listing means the audit runs' "runs=$(( $(count_runs) - runs_before ))" 'runs=1'
assert_contains 'the job still passes' "rc=${job_rc}" 'rc=0'

printf '\n=== TTL 0 turns the cache off and an invalid TTL is an error ===\n'
run_job
runs_before="$(count_runs)"
PRE_PR_CHECKS_ORG_LINT_CACHE_TTL=0 run_job
assert_contains 'TTL 0 always audits' "runs=$(( $(count_runs) - runs_before ))" 'runs=1'
PRE_PR_CHECKS_ORG_LINT_CACHE_TTL=soon run_job
assert_contains 'an invalid TTL fails with one line' "$job_out" 'ERROR: PRE_PR_CHECKS_ORG_LINT_CACHE_TTL must be a non-negative integer'
assert_contains 'an invalid TTL exits 2' "rc=${job_rc}" 'rc=2'

test_summary
