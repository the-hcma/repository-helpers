#!/usr/bin/env bash
# Tests for github-repo-lint --jobs: parallel per-repo audits must report exactly like a serial run.
# shellcheck disable=SC2016  # bash -c programs are single-quoted so the child shell expands them
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/repo-practices"
runner_bootstrap="${script_dir}/../scripts/lib/runner-bootstrap"
readonly lib runner_bootstrap

tmp="$(mktemp -d)"
readonly tmp
trap 'rm -rf "$tmp"' EXIT

# Drives rp_audit_repos with a stubbed rp_check_one_repo and prints the same report pieces rp_main
# does. Stub behaviour per repo:
#   o/a  passes, but (when GATE=1) blocks until o/c has finished, so it completes after repos that
#        started later: proves concurrency and out-of-order completion without any sleep.
#   o/b  passes with two warnings.
#   o/c  fails with a compact failure + fix entry.
#   o/d  fails with plain output and no compact entry (and exits early when DIE_D=1).
read -r -d '' driver <<'DRIVER' || true
set -euo pipefail
source "$1"
jobs="$2"; compact="$3"; apply_fix="$4"
gate_dir="$5"
rp_jobs="$jobs"; rp_compact="$compact"; rp_apply_fix="$apply_fix"; rp_track_failures=1
rp_repo_slugs=(o/a o/b o/c o/d)
rp_check_one_repo() {
  local slug="$1" spin=0 here="$BASHPID" in_parent=no
  [[ "$here" != "$PARENT_PID" ]] || in_parent=yes
  if [[ "${GATE:-0}" == 1 && "$slug" == o/a ]]; then
    while [[ ! -e "${gate_dir}/c" ]]; do
      spin=$(( spin + 1 ))
      if (( spin > 3000000 )); then printf 'gate timeout\n' >&2; return 9; fi
    done
  fi
  printf 'out:%s\n' "$slug"
  printf 'err:%s pid_is_parent=%s\n' "$slug" "$in_parent" >&2
  case "$slug" in
    o/b) rp_warn_count=$(( rp_warn_count + 2 )); return 0 ;;
    o/c)
      rp_compact_record_failure "$slug" "$slug: bad thing"
      rp_compact_record_fix "$slug" "$slug: do the fix"
      : >"${gate_dir}/c"
      return 1
      ;;
    o/d)
      [[ "${DIE_D:-0}" != 1 ]] || exit 7
      return 1
      ;;
  esac
  return 0
}
PARENT_PID="$BASHPID"
rp_audit_repos "${#rp_repo_slugs[@]}"
if [[ "$rp_compact" -eq 1 ]]; then rp_compact_print_report; fi
if [[ "$rp_compact" -eq 0 ]]; then rp_print_failure_summary; fi
printf 'RESULT fail=%s warn=%s\n' "$rp_audit_total_fail" "$rp_warn_count"
DRIVER

# run_case <name> <jobs> <compact> <apply_fix> [VAR=value ...]  -> $tmp/<name>.{out,err,rc}
run_case() {
  local -r name="$1" jobs="$2" compact="$3" apply_fix="$4"
  shift 4
  local rc=0
  mkdir -p "${tmp}/${name}.gate"
  env "$@" bash -c "$driver" bash "$lib" "$jobs" "$compact" "$apply_fix" "${tmp}/${name}.gate" \
    >"${tmp}/${name}.out" 2>"${tmp}/${name}.err" || rc=$?
  printf '%s\n' "$rc" >"${tmp}/${name}.rc"
}

same_file() {
  local -r label="$1" left="$2" right="$3"
  if cmp -s "$left" "$right"; then
    pass_case "$label"
  else
    fail_case "$label"
    diff "$left" "$right" >&2 || true
  fi
}

printf '\n=== jobs: parallel report matches serial ===\n'
run_case serial_compact 1 1 0 GATE=0
run_case par_compact 4 1 0 GATE=1
run_case serial_plain 1 0 0 GATE=0
run_case par_plain 4 0 0 GATE=1
same_file "compact stdout is identical for --jobs 4 and --jobs 1" "${tmp}/serial_compact.out" "${tmp}/par_compact.out"
# err lines embed pid_is_parent, which legitimately differs between serial and parallel; normalise it.
sed -E 's/ pid_is_parent=(yes|no)//' "${tmp}/serial_compact.err" >"${tmp}/serial_compact.norm"
sed -E 's/ pid_is_parent=(yes|no)//' "${tmp}/par_compact.err" >"${tmp}/par_compact.norm"
same_file "compact stderr (report) is identical for --jobs 4 and --jobs 1" "${tmp}/serial_compact.norm" "${tmp}/par_compact.norm"
same_file "non-compact stdout is identical for --jobs 4 and --jobs 1" "${tmp}/serial_plain.out" "${tmp}/par_plain.out"
sed -E 's/ pid_is_parent=(yes|no)//' "${tmp}/serial_plain.err" >"${tmp}/serial_plain.norm"
sed -E 's/ pid_is_parent=(yes|no)//' "${tmp}/par_plain.err" >"${tmp}/par_plain.norm"
same_file "non-compact stderr (headers, output, summary) is identical for --jobs 4 and --jobs 1" "${tmp}/serial_plain.norm" "${tmp}/par_plain.norm"
assert_contains "parallel compact run aggregates failures and warnings" "$(cat "${tmp}/par_compact.out")" "RESULT fail=2 warn=2"
assert_contains "parallel compact report keeps the failing repo's grouped entry" "$(cat "${tmp}/par_compact.err")" "- bad thing"
assert_contains "parallel compact report keeps the fix line" "$(cat "${tmp}/par_compact.err")" "Fix: do the fix"

printf '\n=== jobs: repos really run concurrently ===\n'
assert_contains "gated repo completes only because a later repo ran at the same time" \
  "$(cat "${tmp}/par_compact.out")" "out:o/a"
assert_not_contains "no gate timeout in the concurrent run" "$(cat "${tmp}/par_compact.err")" "gate timeout"
run_case par_two 2 1 0 GATE=1
assert_contains "--jobs 2 is enough to run the gated repo alongside the next one" \
  "$(cat "${tmp}/par_two.out")" "RESULT fail=2 warn=2"

printf '\n=== jobs: --apply-fix stays serial ===\n'
run_case apply_fix 4 1 1 GATE=0
assert_contains "--apply-fix with --jobs 4 audits in the parent shell" \
  "$(cat "${tmp}/apply_fix.err")" "err:o/b pid_is_parent=yes"
run_case par_pid 4 1 0 GATE=0
assert_contains "--jobs 4 audits in a background worker" \
  "$(cat "${tmp}/par_pid.err")" "err:o/b pid_is_parent=no"

printf '\n=== jobs: a worker that dies is reported as a failed repo ===\n'
run_case died 4 1 0 GATE=1 DIE_D=1
assert_contains "dead worker is surfaced on stderr" "$(cat "${tmp}/died.err")" "audit worker for o/d exited before finishing"
assert_contains "dead worker counts as a failure" "$(cat "${tmp}/died.out")" "RESULT fail=2 warn=2"

printf '\n=== jobs: argument handling and session safety ===\n'
parse_out="$(bash -c 'source "$1"; rp_parse_args prog --jobs 0' bash "$lib" 2>&1 || true)"
assert_contains "--jobs 0 is rejected" "$parse_out" "--jobs requires a positive integer (got: 0)"
parse_out="$(bash -c 'source "$1"; rp_parse_args prog --jobs' bash "$lib" 2>&1 || true)"
assert_contains "--jobs without a value is rejected" "$parse_out" "--jobs requires a positive integer"
parse_out="$(bash -c 'source "$1"; rp_parse_args prog --jobs 6 --repo o/a; printf "jobs=%s\n" "$rp_jobs"' bash "$lib" 2>&1)"
assert_contains "--jobs N is stored" "$parse_out" "jobs=6"
usage_out="$(bash -c 'source "$1"; rp_usage prog' bash "$lib" 2>&1)"
assert_contains "usage documents --jobs" "$usage_out" "--jobs N:"
session_out="$(bash -c '
  source "$1"; source "$2"
  rp_check_one_repo() { :; }
  rp_jobs=3; rp_repo_slugs=(o/a o/b o/c)
  rp_audit_repos 3
  [[ -d "$RUNNER_SESSION_DIR" ]] && printf "session_alive\n" || printf "session_gone\n"
' bash "$runner_bootstrap" "$lib" 2>&1)"
assert_contains "workers do not tear down the parent's runner session" "$session_out" "session_alive"

printf '\n=== jobs: the default worker count comes from the host ===\n'
mkdir -p "${tmp}/cores"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "${MOCK_NPROC:-}"\n' >"${tmp}/cores/nproc"
chmod +x "${tmp}/cores/nproc"
default_jobs() {
  env PATH="${tmp}/cores:${PATH}" MOCK_NPROC="$1" GITHUB_REPO_LINT_JOBS="${2:-}" \
    bash -c 'source "$1"; printf "[%s]" "$(rp_default_jobs)"' bash "$lib"
}
assert_contains "a single-core host audits serially" "$(default_jobs 1)" "[1]"
assert_contains "two cores give two workers" "$(default_jobs 2)" "[2]"
assert_contains "many cores are capped where the pacing gate becomes the bottleneck" "$(default_jobs 64)" "[4]"
assert_not_contains "an unreadable core count still yields a positive worker count" "$(default_jobs garbage)" "[]"
assert_contains "GITHUB_REPO_LINT_JOBS overrides the core count" "$(default_jobs 2 7)" "[7]"
bad_env_out="$(env GITHUB_REPO_LINT_JOBS=0 bash -c 'source "$1"; source "$2"; rp_check_one_repo() { :; }; rp_repo_slugs=(o/a o/b); rp_audit_repos 2' bash "$runner_bootstrap" "$lib" 2>&1 || true)"
assert_contains "an invalid GITHUB_REPO_LINT_JOBS is rejected like --jobs" "$bad_env_out" "GITHUB_REPO_LINT_JOBS requires a positive integer (got: 0)"
parse_out="$(bash -c 'source "$1"; rp_parse_args prog --repo o/a; printf "jobs=[%s]\n" "$rp_jobs"' bash "$lib" 2>&1)"
assert_contains "without --jobs the setting stays unresolved until the audit" "$parse_out" "jobs=[]"
auto_out="$(env PATH="${tmp}/cores:${PATH}" MOCK_NPROC=3 bash -c '
  source "$1"; source "$2"
  rp_check_one_repo() { :; }
  rp_repo_slugs=(o/a o/b o/c)
  rp_audit_repos_parallel() { printf "parallel jobs=%s\n" "$rp_jobs"; }
  rp_audit_repos 3
' bash "$runner_bootstrap" "$lib" 2>&1)"
assert_contains "several repos without --jobs run in parallel on a multi-core host" "$auto_out" "parallel jobs=3"
serial_out="$(env PATH="${tmp}/cores:${PATH}" MOCK_NPROC=3 bash -c '
  source "$1"; source "$2"
  rp_check_one_repo() { :; }
  rp_repo_slugs=(o/a o/b o/c)
  rp_jobs=1
  rp_audit_repos_parallel() { printf "parallel\n"; }
  rp_audit_repos 3
  printf "serial-ran\n"
' bash "$runner_bootstrap" "$lib" 2>&1)"
assert_not_contains "--jobs 1 forces a serial audit" "$serial_out" "parallel"

printf '\n=== jobs: workers do not share runner command history ===\n'
mkdir -p "${tmp}/runner.gate"
# o/a records a command, then waits for o/c to record its own; if both shared one session, o/a's
# runner_last_id would return o/c's command and o/a would read o/c's stdout.
runner_out="$(bash -c '
  set -euo pipefail
  source "$1"; source "$2"
  gate_dir="$3"
  rp_jobs=3; rp_compact=1; rp_repo_slugs=(o/a o/b o/c)
  rp_check_one_repo() {
    local slug="$1" spin=0 id got
    runner_exec probe --probe -- printf "%s" "$slug" >/dev/null
    if [[ "$slug" == o/a ]]; then
      while [[ ! -e "${gate_dir}/c" ]]; do
        spin=$(( spin + 1 ))
        if (( spin > 3000000 )); then printf "gate timeout\n"; return 9; fi
      done
    fi
    id="$(runner_last_id)"
    got="$(runner_read "$id" stdout)"
    printf "saw:%s:%s\n" "$slug" "$got"
    [[ "$slug" != o/c ]] || : >"${gate_dir}/c"
    return 0
  }
  rp_audit_repos 3
  [[ -d "$RUNNER_SESSION_DIR" ]] && printf "session_alive\n"
' bash "$runner_bootstrap" "$lib" "${tmp}/runner.gate" 2>&1)"
assert_contains "gated worker reads its own last command, not a concurrent worker's" "$runner_out" "saw:o/a:o/a"
assert_contains "second worker reads its own last command" "$runner_out" "saw:o/b:o/b"
assert_contains "third worker reads its own last command" "$runner_out" "saw:o/c:o/c"
assert_not_contains "no gate timeout while sharing a runner session root" "$runner_out" "gate timeout"

printf '\n=== jobs: worker command failures reach the parent session report ===\n'
# A failing runner command inside a worker must be listed by the parent's failed-command report,
# in repo order, exactly as when the same repos are audited serially. The listing is taken after a
# marker so the replayed per-repo [FAIL] diagnostics cannot satisfy the assertions.
read -r -d '' failed_listing_driver <<'DRIVER' || true
  set -euo pipefail
  source "$1"; source "$2"
  rp_jobs="$3"; rp_compact=1; rp_repo_slugs=(o/a o/b o/c)
  rp_check_one_repo() {
    runner_exec "label-$1" -- bash -c "exit 3" >/dev/null 2>&1 || true
    return 0
  }
  rp_audit_repos 3
  printf "FAILED_LISTING\n"
  while IFS= read -r id; do printf "%s\n" "$(runner_read "$id" label)"; done < <(runner_session_failed_ids)
DRIVER
fail_serial="$(bash -c "$failed_listing_driver" bash "$runner_bootstrap" "$lib" 1 2>&1)"
fail_parallel="$(bash -c "$failed_listing_driver" bash "$runner_bootstrap" "$lib" 3 2>&1)"
serial_listing="${fail_serial#*FAILED_LISTING}"
parallel_listing="${fail_parallel#*FAILED_LISTING}"
assert_contains "serial audit lists the failed repo commands (baseline)" "$serial_listing" "label-o/c"
assert_contains "parallel audit lists the first worker's failed command" "$parallel_listing" "label-o/a"
assert_contains "parallel audit lists the last worker's failed command" "$parallel_listing" "label-o/c"
assert_contains "parallel failed-command list matches the serial one" "[${parallel_listing}]" "[${serial_listing}]"

printf '\n=== jobs: interrupt cleanup and TMPDIR fallback ===\n'
# TERM while workers are running must stop the workers and remove the buffer directory.
intr_tmp="${tmp}/intr-tmp"
intr_dir="${tmp}/intr"
mkdir -p "$intr_tmp" "$intr_dir"
TMPDIR="$intr_tmp" bash -c '
  set -euo pipefail
  source "$1"
  dir="$2"
  rp_jobs=2; rp_compact=1; rp_repo_slugs=(o/a o/b)
  rp_check_one_repo() {
    printf "%s\n" "$BASHPID" >"${dir}/pid-${1//\//_}"
    local spin=0
    # An in-flight command (like gh) is a child of the worker and must not outlive an abort.
    bash -c '"'"'
      printf "%s\n" "$$" >"$1/child-$2"
      n=0
      while [[ ! -e "$1/release" ]]; do
        n=$(( n + 1 ))
        if (( n > 6000000 )); then exit 9; fi
      done
    '"'"' _ "$dir" "${1//\//_}" &
    while [[ ! -e "${dir}/release" ]]; do
      spin=$(( spin + 1 ))
      if (( spin > 6000000 )); then return 9; fi
    done
  }
  rp_audit_repos 2
' bash "$lib" "$intr_dir" >"${tmp}/intr.out" 2>"${tmp}/intr.err" &
intr_pid=$!
spin=0
while [[ ! -e "${intr_dir}/child-o_a" || ! -e "${intr_dir}/child-o_b" ]]; do
  spin=$(( spin + 1 ))
  if (( spin > 3000000 )); then break; fi
done
kill -TERM "$intr_pid"
intr_rc=0
wait "$intr_pid" || intr_rc=$?
worker_alive=0
for worker_file in "${intr_dir}"/pid-* "${intr_dir}"/child-*; do
  worker_pid="$(<"$worker_file")"
  spin=0
  while kill -0 "$worker_pid" 2>/dev/null; do
    spin=$(( spin + 1 ))
    if (( spin > 300000 )); then worker_alive=$(( worker_alive + 1 )); break; fi
  done
done
: >"${intr_dir}/release"
leftover="$(find "$intr_tmp" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
assert_contains "TERM during a parallel audit exits with 130" "$intr_rc" "130"
assert_contains "TERM during a parallel audit says it was interrupted" "$(cat "${tmp}/intr.err")" "audit interrupted"
assert_contains "TERM during a parallel audit stops every worker and its in-flight command" "workers_alive=${worker_alive}" "workers_alive=0"
assert_contains "TERM during a parallel audit removes the buffer directory" "leftover=${leftover}" "leftover=0"

# An unusable TMPDIR must degrade to the serial audit instead of aborting the run.
run_case bad_tmpdir 4 1 0 GATE=0 TMPDIR=/nonexistent-tmpdir-for-test
assert_contains "unwritable TMPDIR falls back to a serial audit with a note" \
  "$(cat "${tmp}/bad_tmpdir.err")" "auditing serially"
assert_contains "serial fallback still audits in the parent shell" \
  "$(cat "${tmp}/bad_tmpdir.err")" "err:o/b pid_is_parent=yes"
assert_contains "serial fallback still reports the same result" \
  "$(cat "${tmp}/bad_tmpdir.out")" "RESULT fail=2 warn=2"

test_summary
