#!/usr/bin/env bash
# Tests for scripts/lib/dep-updater-org-clone.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/dep-updater-org-clone"
readonly lib

pass=0
fail=0

printf '\n=== static: dep-updater-org-clone shallow clone helper ===\n'
if [[ -f "$lib" ]] \
  && grep -qF 'dep_updater_org_clone_shallow()' "$lib" \
  && grep -qF 'runner-ensure' "$lib" \
  && grep -qF 'gh repo clone' "$lib" \
  && grep -qF -- '--depth 1 --single-branch' "$lib"; then
  printf '[PASS] dep-updater-org-clone: depth-1 single-branch gh repo clone\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater-org-clone: missing or incomplete\n'
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
