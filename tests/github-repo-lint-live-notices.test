#!/usr/bin/env bash
# Tests for live pacing notices in the parallel github-repo-lint audit (repository-helpers#824): a worker's stderr is
# buffered and replayed after every worker finishes, so a long GITHUB_API_PACE_WAIT used to be invisible while it
# happened. The pacing gate now also writes its notices to a live channel when the caller opens one.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/repo-practices"
rate_limit_lib="${script_dir}/../scripts/lib/github-api-rate-limit"
readonly lib rate_limit_lib

tmp="$(mktemp -d)"
readonly tmp
trap 'rm -rf "$tmp"' EXIT

note='NOTE: GITHUB_API_PACE_WAIT label=gh until=1 remaining=5s wake=00:00:05Z'

# shellcheck disable=SC1090  # path built from script_dir at runtime
source "$rate_limit_lib"

printf '\n=== the notice helper ===\n'
plain_err="${tmp}/plain.err"
_github_api_pace_note "$note" 2>"$plain_err"
assert_contains 'without a live channel the notice goes to stderr only' "$(cat "$plain_err")" "$note"

live_file="${tmp}/live.out"
live_err="${tmp}/live.err"
exec 7>"$live_file"
GITHUB_API_PACE_LIVE_FD=7 GITHUB_API_PACE_LIVE_LABEL='o/a' _github_api_pace_note "$note" 2>"$live_err"
exec 7>&-
assert_contains 'a live channel gets the notice prefixed with the label' "$(cat "$live_file")" "[o/a] ${note}"
assert_contains 'stderr keeps the unprefixed notice' "$(cat "$live_err")" "$note"
assert_not_contains 'stderr does not get the prefix' "$(cat "$live_err")" '[o/a]'

GITHUB_API_PACE_LIVE_FD=7 _github_api_pace_note "$note" 2>"$live_err"
assert_contains 'a live descriptor that is not open is ignored' "$(cat "$live_err")" "$note"
GITHUB_API_PACE_LIVE_FD=abc _github_api_pace_note "$note" 2>"$live_err"
assert_contains 'a non-numeric live descriptor is ignored' "$(cat "$live_err")" "$note"

# Drives the parallel audit with a stub that waits on the pacing gate, as a real worker would.
read -r -d '' driver <<'DRIVER' || true
set -euo pipefail
source "$1"
source "$2"
rp_jobs="$3"; rp_compact=1; rp_apply_fix=0; rp_track_failures=0
rp_repo_slugs=(o/a o/b)
rp_check_one_repo() {
  printf 'out:%s\n' "$1"
  _github_api_pace_note "NOTE: GITHUB_API_PACE_WAIT label=gh until=1 remaining=5s wake=00:00:05Z"
  printf 'err:%s\n' "$1" >&2
  return 0
}
rp_audit_repos "${#rp_repo_slugs[@]}"
DRIVER

printf '\n=== the parallel audit shows notices while workers run ===\n'
bash -c "$driver" bash "$lib" "$rate_limit_lib" 2 >"${tmp}/par.out" 2>"${tmp}/par.err" || true
par_err="$(cat "${tmp}/par.err")"
assert_contains 'worker o/a notice is on stderr with its repo label' "$par_err" "[o/a] ${note}"
assert_contains 'worker o/b notice is on stderr with its repo label' "$par_err" "[o/b] ${note}"
live_line="$(grep -n -F '[o/a] NOTE' "${tmp}/par.err" | head -n 1 | cut -d: -f1)"
replay_line="$(grep -n -F 'err:o/a' "${tmp}/par.err" | head -n 1 | cut -d: -f1)"
assert_contains 'the live notice comes before the buffered replay' "before=$(( live_line < replay_line ))" 'before=1'
assert_contains 'the buffered replay still has the unprefixed notice' \
  "$(grep -c -x -F "$note" "${tmp}/par.err")" '2'
assert_contains 'the buffered stdout replay is unchanged' "$(cat "${tmp}/par.out")" 'out:o/a'

printf '\n=== a serial audit has no live channel ===\n'
bash -c "$driver" bash "$lib" "$rate_limit_lib" 1 >"${tmp}/ser.out" 2>"${tmp}/ser.err" || true
assert_not_contains 'serial notices carry no repo prefix' "$(cat "${tmp}/ser.err")" '[o/a]'
assert_contains 'serial notices are still printed' "$(cat "${tmp}/ser.err")" "$note"

test_summary
