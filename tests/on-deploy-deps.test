#!/usr/bin/env bash
# Tests for scripts/lib/on-deploy-deps.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

lib="${script_dir}/../scripts/lib/on-deploy-deps"
readonly lib

pass=0
fail=0

printf '\n=== static: library defines public entry points ===\n'
for fn in on_deploy_deps_resolve_lib_path on_deploy_deps_source_from_repo \
  on_deploy_deps_python_env_stale on_deploy_deps_pnpm_modules_stale \
  on_deploy_deps_bootstrap_python_venv on_deploy_deps_sync_python_frozen \
  on_deploy_deps_install_pnpm_frozen; do
  if grep -qF "${fn}()" "$lib"; then
    printf '[PASS] on-deploy-deps defines %s\n' "$fn"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] on-deploy-deps missing %s\n' "$fn"
    fail=$(( fail + 1 ))
  fi
done

printf '\n=== functional: python_env_stale detects missing venv ===\n'
tmp_repo=""
tmp_repo="$(mktemp -d)"
printf '[project]\nname = "t"\n' >"${tmp_repo}/pyproject.toml"
touch "${tmp_repo}/uv.lock"
# shellcheck disable=SC1090,SC1091
source "$lib"
if on_deploy_deps_python_env_stale "$tmp_repo"; then
  printf '[PASS] missing .venv is stale\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing .venv should be stale\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: python_env_stale fresh venv is not stale ===\n'
tmp_repo="$(mktemp -d)"
printf '[project]\nname = "t"\n' >"${tmp_repo}/pyproject.toml"
touch "${tmp_repo}/uv.lock"
mkdir -p "${tmp_repo}/.venv"
touch "${tmp_repo}/.venv/.keep"
sleep 1
touch "${tmp_repo}/.venv/.keep"
if on_deploy_deps_python_env_stale "$tmp_repo"; then
  printf '[FAIL] venv newer than lockfiles should not be stale\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] fresh venv is not stale\n'
  pass=$(( pass + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: python_env_stale uses uv check, not .venv mtime ===\n'
integration_repo=""
for candidate in "${script_dir}/../../my-tracks" "${HOME}/work/ai/my-tracks"; do
  if [[ -f "${candidate}/uv.lock" && -d "${candidate}/.venv" ]]; then
    integration_repo="$(cd "$candidate" && pwd)"
    break
  fi
done
if command -v uv >/dev/null 2>&1 && [[ -n "$integration_repo" ]]; then
  # shellcheck disable=SC1090,SC1091
  source "$lib"
  if on_deploy_deps_python_env_stale "$integration_repo"; then
    printf '[FAIL] synced my-tracks venv should not be stale (lockfile may be newer than .venv dir)\n'
    fail=$(( fail + 1 ))
  else
    printf '[PASS] uv sync --check overrides misleading .venv mtime\n'
    pass=$(( pass + 1 ))
  fi
else
  printf '[SKIP] uv or my-tracks checkout not available for integration check\n'
fi

printf '\n=== functional: pnpm_modules_stale uses .modules.yaml not node_modules dir ===\n'
# shellcheck disable=SC1090,SC1091
source "$lib"
tmp_repo="$(mktemp -d)"
printf '{}\n' >"${tmp_repo}/package.json"
touch "${tmp_repo}/pnpm-lock.yaml"
mkdir -p "${tmp_repo}/node_modules"
touch "${tmp_repo}/node_modules/.modules.yaml"
sleep 1
touch "${tmp_repo}/node_modules/.modules.yaml"
if on_deploy_deps_pnpm_modules_stale "$tmp_repo"; then
  printf '[FAIL] lockfile not newer than .modules.yaml should not be stale\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] fresh .modules.yaml is not stale\n'
  pass=$(( pass + 1 ))
fi
sleep 1
touch "${tmp_repo}/pnpm-lock.yaml"
if on_deploy_deps_pnpm_modules_stale "$tmp_repo"; then
  printf '[PASS] lockfile newer than .modules.yaml is stale\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] lockfile newer than .modules.yaml should be stale\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: pnpm_modules_stale detects missing node_modules ===\n'
tmp_repo="$(mktemp -d)"
printf '{}\n' >"${tmp_repo}/package.json"
touch "${tmp_repo}/pnpm-lock.yaml"
if on_deploy_deps_pnpm_modules_stale "$tmp_repo"; then
  printf '[PASS] missing node_modules is stale\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing node_modules should be stale\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: pnpm_modules_stale honors npm subdir ===\n'
tmp_repo="$(mktemp -d)"
mkdir -p "${tmp_repo}/web"
printf '{}\n' >"${tmp_repo}/web/package.json"
touch "${tmp_repo}/web/pnpm-lock.yaml"
if on_deploy_deps_pnpm_modules_stale "$tmp_repo" web; then
  printf '[PASS] missing web/node_modules is stale\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing web/node_modules should be stale\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: resolve_lib_path finds sibling repository-helpers ===\n'
tmp_root="$(mktemp -d)"
tmp_home="$(mktemp -d)"
tmp_repo="${tmp_root}/my-service"
tmp_rh="${tmp_root}/repository-helpers"
mkdir -p "${tmp_repo}" "${tmp_rh}/scripts/lib"
cp "$lib" "${tmp_rh}/scripts/lib/on-deploy-deps"
resolved=""
resolved="$(
  HOME="$tmp_home" REPOSITORY_HELPERS_DIR='' on_deploy_deps_resolve_lib_path "$tmp_repo"
)"
if [[ "$(readlink -f "$resolved")" == "$(readlink -f "${tmp_rh}/scripts/lib/on-deploy-deps")" ]]; then
  printf '[PASS] resolve_lib_path finds sibling checkout\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] resolve_lib_path expected sibling lib, got: %s\n' "${resolved:-<empty>}"
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_root" "$tmp_home"

printf '\n=== functional: bootstrap loads main library ===\n'
tmp_root="$(mktemp -d)"
tmp_home="$(mktemp -d)"
tmp_repo="${tmp_root}/my-service"
tmp_rh="${tmp_root}/repository-helpers"
mkdir -p "${tmp_repo}" "${tmp_rh}/scripts/lib"
cp "${script_dir}/../scripts/lib/on-deploy-deps" "${tmp_rh}/scripts/lib/on-deploy-deps"
cp "${script_dir}/../scripts/lib/on-deploy-deps-bootstrap" "${tmp_rh}/scripts/lib/on-deploy-deps-bootstrap"
# shellcheck disable=SC1090,SC1091
source "${tmp_rh}/scripts/lib/on-deploy-deps-bootstrap"
if on_deploy_deps_load_library "$tmp_repo"; then
  if declare -F on_deploy_deps_python_env_stale >/dev/null 2>&1; then
    printf '[PASS] bootstrap load defines on_deploy_deps_python_env_stale\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] bootstrap load did not define on_deploy_deps_python_env_stale\n'
    fail=$(( fail + 1 ))
  fi
else
  printf '[FAIL] on_deploy_deps_load_library failed\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_root" "$tmp_home"

printf '\n=== summary ===\n'
printf '%d passed, %d failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
