#!/usr/bin/env bash
# Tests for scripts/lib/tooling-prereqs.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

lib="${script_dir}/../scripts/lib/tooling-prereqs"
readonly lib
dep_script="${script_dir}/../scripts/dep-updater"
readonly dep_script

pass=0
fail=0

printf '\n=== static: library defines prereq helpers ===\n'
for fn in tooling_prereq_check_tools tooling_prereq_check_ecosystem_tools \
  tooling_prereq_describe_tool_line tooling_prereq_pip_audit_usable \
  tooling_prereq_report_reset tooling_prereq_report_note \
  tooling_prereq_report_note_any tooling_prereq_report_finish \
  tooling_prereq_can_manage_packages; do
  if grep -qF "${fn}()" "$lib"; then
    printf '[PASS] tooling-prereqs defines %s\n' "$fn"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] tooling-prereqs missing %s\n' "$fn"
    fail=$(( fail + 1 ))
  fi
done

printf '\n=== static: dep-updater sources tooling-prereqs ===\n'
# shellcheck disable=SC2016
if grep -qF 'source "${dep_script_dir}/lib/tooling-prereqs"' "$dep_script" \
  && grep -qF 'tooling_prereq_check_tools "[tooling]" git gh jq rg' "$dep_script" \
  && grep -qF 'tooling_prereq_check_tools "[tooling]" gt' "$dep_script" \
  && grep -qF 'tooling_prereq_check_ecosystem_tools' "$dep_script"; then
  printf '[PASS] dep-updater uses tooling-prereqs for core and ecosystem checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater must source tooling-prereqs and call check helpers\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: ecosystem helpers avoid dep-updater global names ===\n'
if ! grep -qE 'local -r has_npm=' "$lib" \
  && ! grep -qE 'local -r py_tool=' "$lib"; then
  printf '[PASS] tooling-prereqs: no local -r has_npm/py_tool (readonly collision with dep-updater)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling-prereqs: must not declare local -r has_npm or py_tool\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: check_ecosystem_tools with readonly globals in scope ===\n'
# shellcheck disable=SC1090,SC1091
source "$lib"
# shellcheck disable=SC2317,SC2329  # invoked indirectly via tooling_prereq_emit
log_prereq() { printf '%s\n' "$*" >&2; }
readonly has_npm=1
readonly py_tool=uv
readonly npm_tool=pnpm
eco_err="$(mktemp)"
describe_err="$(mktemp)"
set +e
tooling_prereq_check_ecosystem_tools "$has_npm" "$npm_tool" "$py_tool" >/dev/null 2>"$eco_err"
tooling_prereq_describe_tool_line pip-audit "$py_tool" >/dev/null 2>"$describe_err"
describe_rc=$?
set -e
collision=0
if grep -qF 'readonly variable' "$eco_err" "$describe_err" 2>/dev/null; then
  collision=1
fi
rm -f "$eco_err" "$describe_err"
if [[ "$collision" -eq 0 && "$describe_rc" -eq 0 ]]; then
  printf '[PASS] ecosystem prereq helpers run without readonly collision when has_npm/py_tool are readonly\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ecosystem prereq helpers hit readonly collision (describe_rc=%s)\n' "$describe_rc"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: check_tools counts missing ===\n'
tmp_home="$(mktemp -d)"
PATH="/usr/bin:/bin"
# shellcheck disable=SC1090,SC1091
source "$lib"
# shellcheck disable=SC2317,SC2329  # invoked indirectly via tooling_prereq_emit
log_prereq() { printf '%s\n' "$*" >&2; }
set +e
out="$(TOOLING_PREREQ_CAN_INSTALL=0 tooling_prereq_check_tools "[tooling]" definitely-not-a-real-tool-xyz 2>&1)"
rc=$?
set -e
rm -rf "$tmp_home"
if [[ "$rc" -eq 1 ]] && printf '%s' "$out" | grep -qF 'definitely-not-a-real-tool-xyz'; then
  printf '[PASS] tooling_prereq_check_tools returns missing count\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling_prereq_check_tools expected exit 1 with tool name in output, got rc=%s\n' "$rc"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: report lists all misses with admin install plan ===\n'
# shellcheck disable=SC1090,SC1091
source "$lib"
# shellcheck disable=SC2317,SC2329  # invoked indirectly via tooling_prereq_emit
log_prereq() { printf '%s\n' "$*" >&2; }
tooling_prereq_report_reset
tooling_prereq_report_note_any timeout \
  'neither timeout(1) nor gtimeout(1) on PATH (need GNU coreutils)' \
  -- definitely-missing-timeout-xyz definitely-missing-gtimeout-xyz
tooling_prereq_report_note gh "$(tooling_prereq_missing_message gh)"
set +e
out="$(TOOLING_PREREQ_CAN_INSTALL=0 TOOLING_PREREQ_UNAME=Darwin tooling_prereq_report_finish 2>&1)"
rc=$?
set -e
if [[ "$rc" -eq 2 ]] \
  && grep -qF 'ERROR: missing prerequisites (2)' <<<"$out" \
  && grep -qF 'neither timeout(1) nor gtimeout(1)' <<<"$out" \
  && grep -qF "'gh' (GitHub CLI) not found" <<<"$out" \
  && grep -qF 'ask an administrator' <<<"$out" \
  && grep -qE 'brew install .*coreutils' <<<"$out" \
  && grep -qE 'brew install .*gh|brew install gh' <<<"$out"; then
  printf '[PASS] report_finish lists all misses and admin brew plan\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report_finish multi-miss admin plan (rc=%s)\n%s\n' "$rc" "$out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: last_ids reflects only the latest report ===\n'
# Callers read the ids after report_finish to name a host-tooling skip, so a clean
# check must not leave the previous run's tools visible.
tooling_prereq_report_reset
tooling_prereq_report_note gh "$(tooling_prereq_missing_message gh)"
set +e
# In-shell, not a command substitution: the snapshot has to survive into this shell
# for the accessor to mean anything.
TOOLING_PREREQ_CAN_INSTALL=0 TOOLING_PREREQ_UNAME=Linux \
  tooling_prereq_report_finish >/dev/null 2>&1
set -e
stale_ids_before="$(tooling_prereq_report_last_ids)"
tooling_prereq_report_reset
set +e
TOOLING_PREREQ_CAN_INSTALL=0 TOOLING_PREREQ_UNAME=Linux \
  tooling_prereq_report_finish >/dev/null 2>&1
set -e
stale_ids_after="$(tooling_prereq_report_last_ids)"
if [[ -n "$stale_ids_before" && -z "$stale_ids_after" ]]; then
  printf '[PASS] report_last_ids is cleared by a report with nothing missing\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report_last_ids stale: before="%s" after="%s"\n' \
    "$stale_ids_before" "$stale_ids_after"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: report uses Run: when user can install ===\n'
tooling_prereq_report_reset
tooling_prereq_report_note jq "$(tooling_prereq_missing_message jq)"
set +e
out="$(TOOLING_PREREQ_CAN_INSTALL=1 TOOLING_PREREQ_UNAME=Darwin tooling_prereq_report_finish 2>&1)"
rc=$?
set -e
if [[ "$rc" -eq 1 ]] \
  && grep -qF 'you appear able to run the package manager' <<<"$out" \
  && ! grep -qF 'ask an administrator' <<<"$out"; then
  printf '[PASS] report_finish uses self-install wording when can_install=1\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report_finish can_install wording (rc=%s)\n%s\n' "$rc" "$out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: Linux report emits active apt-get line ===\n'
tooling_prereq_report_reset
tooling_prereq_report_note timeout "$(tooling_prereq_missing_message timeout)"
tooling_prereq_report_note gh "$(tooling_prereq_missing_message gh)"
set +e
out="$(TOOLING_PREREQ_CAN_INSTALL=0 TOOLING_PREREQ_UNAME=Linux tooling_prereq_report_finish 2>&1)"
rc=$?
set -e
if [[ "$rc" -eq 2 ]] \
  && grep -qE '^[[:space:]]*sudo apt-get install -y .*coreutils' <<<"$out" \
  && grep -qE '^[[:space:]]*sudo apt-get install -y .*gh' <<<"$out" \
  && ! grep -qF '# Debian/Ubuntu:' <<<"$out"; then
  printf '[PASS] report_finish Linux path emits active apt-get install line\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report_finish Linux apt plan (rc=%s)\n%s\n' "$rc" "$out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: can_manage_packages capability probes use --probe ===\n'
# shellcheck disable=SC2016  # assert literal --probe flags in source
if grep -qF 'tooling-prereqs sudo -n true" --probe' "$lib" \
  && grep -qF 'tooling-prereqs id -u" --probe' "$lib" \
  && grep -qF 'tooling-prereqs brew --prefix" --probe' "$lib"; then
  printf '[PASS] can_manage_packages: sudo/id/brew probes use runner --probe\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] can_manage_packages: expected --probe on capability probes\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: start-development uses consolidated prereq report ===\n'
sd_script="${script_dir}/../scripts/dev/start-development"
# shellcheck disable=SC2016
if grep -qF 'tooling_prereq_report_finish' "$sd_script" \
  && grep -qF 'tooling_prereq_report_note_any' "$sd_script" \
  && grep -qF 'tooling_prereq_collect_gnu_userland' "$sd_script" \
  && ! grep -qF 'ERROR: Missing prerequisite: neither timeout' "$sd_script"; then
  printf '[PASS] start-development uses shared multi-prereq reporter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] start-development must use tooling_prereq_report_* (no one-liner timeout)\n'
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
