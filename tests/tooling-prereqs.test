#!/usr/bin/env bash
# Tests for scripts/lib/tooling-prereqs.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

lib="${script_dir}/../scripts/lib/tooling-prereqs"
readonly lib
dep_script="${script_dir}/../scripts/dep-updater"
readonly dep_script

pass=0
fail=0

printf '\n=== static: library defines prereq helpers ===\n'
for fn in tooling_prereq_check_tools tooling_prereq_check_ecosystem_tools \
  tooling_prereq_describe_tool_line tooling_prereq_pip_audit_usable; do
  if grep -qF "${fn}()" "$lib"; then
    printf '[PASS] tooling-prereqs defines %s\n' "$fn"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] tooling-prereqs missing %s\n' "$fn"
    fail=$(( fail + 1 ))
  fi
done

printf '\n=== static: dep-updater sources tooling-prereqs ===\n'
# shellcheck disable=SC2016
if grep -qF 'source "${dep_script_dir}/lib/tooling-prereqs"' "$dep_script" \
  && grep -qF 'tooling_prereq_check_tools "[tooling]" git gt gh jq rg' "$dep_script" \
  && grep -qF 'tooling_prereq_check_ecosystem_tools' "$dep_script"; then
  printf '[PASS] dep-updater uses tooling-prereqs for core and ecosystem checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater must source tooling-prereqs and call check helpers\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: check_tools counts missing ===\n'
tmp_home="$(mktemp -d)"
PATH="/usr/bin:/bin"
# shellcheck disable=SC1090,SC1091
source "$lib"
log_prereq() { printf '%s\n' "$*" >&2; }
set +e
out="$(tooling_prereq_check_tools "[tooling]" definitely-not-a-real-tool-xyz 2>&1)"
rc=$?
set -e
rm -rf "$tmp_home"
if [[ "$rc" -eq 1 ]] && printf '%s' "$out" | grep -qF 'definitely-not-a-real-tool-xyz'; then
  printf '[PASS] tooling_prereq_check_tools returns missing count\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling_prereq_check_tools expected exit 1 with tool name in output, got rc=%s\n' "$rc"
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
