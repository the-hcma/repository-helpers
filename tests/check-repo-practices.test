if [[ "$args" == *'contents/.github/CODEOWNERS'* && "$args" == *'repository-helpers'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

