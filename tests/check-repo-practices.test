#!/usr/bin/env bash
# Tests for scripts/check-repo-practices and scripts/lib/repo-practices.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

checker="${rh_root}/scripts/check-repo-practices"
lib="${rh_root}/scripts/lib/repo-practices"
merge_wrapper="${rh_root}/scripts/check-merge-settings"
readonly checker lib merge_wrapper

pass=0
fail=0

printf '\n=== static: scripts and library ===\n'
if [[ -f "$checker" && -f "$lib" && -f "$merge_wrapper" ]]; then
  printf '[PASS] check-repo-practices, lib/repo-practices, and merge wrapper exist\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing check-repo-practices entrypoints\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_log_manual_step' "$lib" \
  && grep -qF 'rp_log_check_ok' "$lib" \
  && grep -qF 'rp_github_url' "$lib" \
  && grep -qF 'rp_print_final_status' "$lib" \
  && grep -qF 'rp_resolve_git_context_slug' "$lib" \
  && grep -qF 'rp_validate_branch_cleanup_workflows' "$lib" \
  && grep -qF 'rp_print_new_repo_checklist' "$lib" \
  && grep -qF 'rp_check_protect_main_ruleset' "$lib" \
  && grep -qF 'rp_check_classic_main_protection' "$lib" \
  && grep -qF 'rp_check_license_metadata' "$lib" \
  && grep -qF 'rp_fetch_repo_license_file' "$lib" \
  && grep -qF 'rp_text_has_copyright_notice' "$lib" \
  && grep -qF 'rp_fetch_repo_codeowners_file' "$lib" \
  && grep -qF 'rp_apply_codeowners_pr' "$lib" \
  && grep -qF 'rp_authenticated_github_login' "$lib" \
  && grep -qF 'rp_discover_ci_status_contexts' "$lib" \
  && grep -qF 'rp_repo_requires_protect_main_ruleset' "$lib" \
  && grep -qF 'rp_protect_main_create_payload' "$lib" \
  && grep -qF 'cleanup-merged-branches.yml' "$lib" \
  && ! grep -qF 'domesti-bot' "$lib"; then
  printf '[PASS] library defines branch cleanup, metadata, CODEOWNERS, and checklist helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected branch cleanup and new-repo helpers in lib/repo-practices\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_main' "$merge_wrapper" && grep -q 'merge-only' "$merge_wrapper"; then
  printf '[PASS] check-merge-settings delegates to repo-practices with --merge-only\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] check-merge-settings should source lib and pass --merge-only\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: --merge-only skips branch cleanup failure ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/sparse-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$merge_wrapper" --repo the-hcma/sparse-repo 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] && ! grep -qF 'branch cleanup' <<<"$output"; then
  printf '[PASS] --merge-only does not require branch cleanup workflows\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-only should skip branch cleanup (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: full check fails without branch cleanup workflows ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":"Z3JhcGhpdGUtYXBwCkdyYXBoaXRlIG1lcmdlIHF1ZXVlCg=="}'
  exit 0
fi
if [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'cleanup-branch-on-merge.yml' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] full audit fails branch cleanup and prints SUGGEST lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected branch cleanup FAIL with SUGGEST (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: default audit runs full checks for strict repos ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'repos/thehcma/rusty-jack/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'branches/main/protection'* ]]; then
  exit 1
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo thehcma/rusty-jack --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'protect-main ruleset' <<<"$output" \
  && grep -qF 'classic main branch protection' <<<"$output" \
  && grep -qF 'merge-it label is required' <<<"$output" \
  && grep -qF 'license file (LICENSE)' <<<"$output" \
  && grep -qF 'CODEOWNERS (.github/CODEOWNERS)' <<<"$output"; then
  printf '[PASS] full-default: strict repo without merge-it runs protect/classic/Graphite/metadata checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-default: expected comprehensive strict-repo failures (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: full check fails without license or copyright ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/repository-helpers/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/README.md'* ]]; then
  printf '%s\n' '{"content":"IyBSZXBvc2l0b3J5Cg=="}'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/repository-helpers --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'license file' <<<"$output" \
  && grep -qF 'copyright notice' <<<"$output" \
  && grep -qF 'CODEOWNERS' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] metadata: missing license, copyright, and CODEOWNERS fail with suggestions\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] license-metadata: expected license/copyright failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: CODEOWNERS apply creates a PR ===\n'
if grep -qF 'rp_apply_codeowners_pr' "$lib" \
  && grep -qF 'gh pr create' "$lib" \
  && grep -qF 'rp_authenticated_github_login' "$lib" \
  && grep -qF "* @\${login}" "$lib" \
  && grep -qF 'repo-practices/add-codeowners' "$lib"; then
  printf '[PASS] codeowners-apply: --apply creates a PR with authenticated user as owner\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] codeowners-apply: missing PR-based CODEOWNERS remediation\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: strict onboarding fails without merge-it ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/new-service --strict-onboarding 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'merge-it label is required' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] strict-onboarding: missing merge-it fails with remediation hint\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] strict-onboarding: expected missing merge-it failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: git context audits only current repo ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'orgs/'*'/repos'* ]]; then
  printf 'unexpected org repo discovery: %s\n' "$args" >&2
  exit 99
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/repository-helpers/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(cd "$rh_root" && PATH="${mock_bin}:${PATH}" bash "$checker" 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] \
  && ! grep -qF '==>' <<<"$output" \
  && grep -qF 'https://github.com/the-hcma/repository-helpers/tree/main/.github/workflows' <<<"$output" \
  && grep -qFx 'passed' <<<"$output"; then
  printf '[PASS] without --repo, git context audits only the current clone\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected single-repo audit with inspect URLs and passed summary (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
