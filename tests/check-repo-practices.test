if [[ "$exit_code" -ne 0 ]] \
  && grep -qFx 'Passed: the-hcma/repository-helpers' <<<"$output" \
  && grep -qFx 'Failed:' <<<"$output" \
  && grep -qFx 'the-hcma/broken-service:' <<<"$output" \
  && grep -qF '  - merge-it label is required for full org onboarding' <<<"$output" \
  && grep -qF '  Fix: create merge-it label and enable Graphite merge queue on main' \
    <<<"$output" \
  && grep -qF '1 of 2 repositories failed practices check' <<<"$output" \
  && ! grep -qF 'OK:' <<<"$output"; then
  printf '[PASS] compact: one passed line plus grouped failures and fixes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] compact: expected grouped pass/fail output (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: workflow .yaml extension fails ===\n'
