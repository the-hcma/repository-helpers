#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

make_tmpdir() {
  local tmp
  tmp="$(mktemp -d)"
  # Collapse macOS TMPDIR trailing-slash doubles (…/T//…) so path asserts match
  # realpath'd command lines from the notifier under pre-pr-checks isolation.
  tmp="$(cd "$tmp" && pwd -P)"
  printf '%s\n' "$tmp"
}

stage_notifier_bundle() {
  local -r tmp="$1"
  mkdir -p "$tmp/bin/lib"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"
  cp scripts/lib/time-log "$tmp/bin/lib/time-log"
  cp scripts/lib/tooling-path "$tmp/bin/lib/tooling-path"
  cp scripts/lib/sendmail "$tmp/bin/lib/sendmail"
  cp scripts/lib/runner "$tmp/bin/lib/runner"
  cp scripts/lib/runner-ensure "$tmp/bin/lib/runner-ensure"
  cp scripts/lib/runner-bootstrap "$tmp/bin/lib/runner-bootstrap"
}

# Keep mocks first, then the bash that runs this suite (shebang via env), then
# a minimal system PATH. The notifier bootstraps GNU userland itself after start;
# do not strip the interpreter or rely on BSD /usr/bin tools in the wrapper PATH.
notifier_test_path() {
  local -r tmp="$1"
  local bash_dir
  bash_dir="$(cd "$(dirname "${BASH}")" && pwd)"
  printf '%s\n' "${tmp}/bin:${bash_dir}:/usr/bin:/bin"
}

run_discovery() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai/bunnify/.git" "$tmp/work/ai/my-tracks/.git"

  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    *) shift ;;
  esac
done

repo="$(basename "$dir")"
if [[ "$repo" == "bunnify" ]]; then
  printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
else
  printf '%s' '{"has_updates":false,"has_cves":false,"updates":[],"cves":[]}'
fi
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  if [[ -z "$err" ]]; then
    pass_case 'stderr is quiet by default in --print'
  else
    fail_case 'stderr is quiet by default in --print'
  fi
  assert_contains 'email includes From header' "$out" "From: dep-updater-notifier-no-reply@example.com"
  assert_contains 'email includes Reply-To header' "$out" "Reply-To: dep-updater-notifier-no-reply@example.com"
  assert_contains 'email subject mentions updates' "$out" \
    "Subject: [dep-updater-notifier] dependency updates needed"
  assert_contains 'email body includes discovered repo section' "$out" "=== bunnify ==="
}

run_short_flags() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" -p -v 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  assert_contains 'verbose output appears on stderr' "$err" "Checking bunnify"
  assert_contains 'email includes From header' "$out" "From: dep-updater-notifier-no-reply@example.com"
  assert_contains 'email includes Reply-To header' "$out" "Reply-To: dep-updater-notifier-no-reply@example.com"
  assert_contains 'print mode emits email on stdout' "$out" \
    "Subject: [dep-updater-notifier] dependency updates needed"
}

run_failure_not_cron_silent() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN
  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"

  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' 'ERROR: simulated dep-updater failure' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains 'stderr includes cron failure summary' "$err" \
    "ERROR: dep-updater-notifier failed: bunnify:"
  assert_contains 'stderr includes failed scan command' "$err" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
  assert_not_contains 'stderr does not say see email' "$err" \
    "see email for details"
  assert_contains 'stderr includes run_command FAIL block' "$err" \
    "[FAIL] dep-updater: bunnify"
  assert_contains 'stderr includes exit code' "$err" \
    "exit code: 1"
  assert_contains 'stderr includes dep-updater error line' "$err" \
    "ERROR: simulated dep-updater failure"
  if [[ -f "$sendmail_breadcrumb" ]]; then
    pass_case 'sendmail mock was invoked'
  else
    fail_case 'sendmail mock was not invoked'
  fi
}

run_failure_email_lists_stderr_in_plain_body() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' 'ERROR: tool missing under cron' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'print-mode email body labels dep-updater stderr' "$mail_out" "dep-updater stderr:"
  assert_contains 'print-mode email body includes stderr text' "$mail_out" "ERROR: tool missing under cron"
  assert_contains 'email section header includes actionable reason' "$mail_out" \
    "=== bunnify === (scan failed: tool missing under cron)"
  assert_contains 'email body includes failed scan command' "$mail_out" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
}

run_failure_email_header_from_runner_stderr_block() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' '[FAIL] gh auth' >&2
printf '%s\n' '  command:   gh auth setup-git' >&2
printf '%s\n' '  exit code: 1' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  unknown command "setup-git" for "gh"' >&2
printf '%s\n' '  --- end stderr ---' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'email header lifts nested runner stderr hint' "$mail_out" \
    '=== bunnify === (scan failed: gh auth: unknown command "setup-git" for "gh")'
}

run_failure_email_header_uses_first_runner_stderr_block() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' '[FAIL] first step' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  first failure message' >&2
printf '%s\n' '  --- end stderr ---' >&2
printf '%s\n' '[FAIL] second step' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  second failure message' >&2
printf '%s\n' '  --- end stderr ---' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'email header uses first nested runner stderr block' "$mail_out" \
    '=== bunnify === (scan failed: first step: first failure message)'
  assert_not_contains 'email header does not merge later stderr blocks' "$mail_out" \
    'scan failed: second step'
}

run_failure_email_header_uses_first_nonblank_stderr_line() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' '[FAIL] gh auth' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  unknown command "setup-git" for "gh"' >&2
printf '%s\n' '  Usage: gh <command> <subcommand> [flags]' >&2
printf '%s\n' '  --- end stderr ---' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'email header uses first non-blank stderr line' "$mail_out" \
    '=== bunnify === (scan failed: gh auth: unknown command "setup-git" for "gh")'
  assert_not_contains 'email header ignores trailing usage text' "$mail_out" \
    'scan failed: gh auth: Usage:'
}

run_failure_stderr_includes_invalid_json_reason() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN
  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"

  mkdir -p "$tmp/work/ai/bunnify/.git"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '\n[npm] CVEs with available fixes:\n'
printf '%s\n' '{"repo":"/tmp","has_updates":false,"has_cves":false,"cves":[],"updates":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains 'stderr names invalid-json repo' "$err" \
    'ERROR: dep-updater-notifier failed: bunnify: invalid JSON on stdout (exit code 0)'
  assert_contains 'stderr includes failed scan command for invalid json' "$err" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
  if [[ -f "$sendmail_breadcrumb" ]]; then
    pass_case 'sendmail still invoked for failure report'
  else
    fail_case 'sendmail still invoked for failure report'
  fi

  mail_out="$(env HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"
  assert_contains 'email body includes failed scan command for invalid json' "$mail_out" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
}

printf '\n=== static: empty arrays safe under set -u ===\n'
notifier_script="scripts/dep-updater-notifier"
if grep -qF "(( \${#notice_lines[@]} > 0 ))" "$notifier_script" \
  && grep -qF "(( \${#update_repos_paths[@]} > 0 ))" "$notifier_script"; then
  pass_case 'empty notice_lines and update_repos_paths are guarded before iteration'
else
  fail_case 'missing length guard before empty-array iteration (breaks bash 3.x + set -u)'
fi

printf '\n=== static: dep-updater-notifier runner adoption ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'lib/runner-bootstrap' "$notifier_script" \
  && grep -qF 'dun_runner_jq_file' "$notifier_script" \
  && grep -qF 'dun_runner_jq_r' "$notifier_script" \
  && grep -qF 'dun_runner_exec_stdout' "$notifier_script" \
  && grep -qF 'run_command "dep-updater:' "$notifier_script" \
  && grep -qF 'dun_actionable_fail_reason_from_stderr' "$notifier_script"; then
  pass_case 'dep-updater-notifier: jq and utilities via dun_runner helpers; dep-updater via run_command'
else
  fail_case 'dep-updater-notifier: missing runner adoption wiring'
fi

echo "=== discovery: finds repos under HOME/work/ai ==="
run_discovery

echo "=== flags: short forms work ==="
run_short_flags

echo "=== failure: scan failure is not cron-silent ==="
run_failure_not_cron_silent

echo "=== failure: print-mode email lists dep-updater stderr ==="
run_failure_email_lists_stderr_in_plain_body

echo "=== failure: email header uses nested runner stderr hint ==="
run_failure_email_header_from_runner_stderr_block

echo "=== failure: email header stops at first nested stderr block ==="
run_failure_email_header_uses_first_runner_stderr_block

echo "=== failure: email header uses first non-blank stderr line ==="
run_failure_email_header_uses_first_nonblank_stderr_line

echo "=== failure: cron stderr includes invalid-json reason ==="
run_failure_stderr_includes_invalid_json_reason

echo "=== done ==="
test_summary
