#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

make_tmpdir() {
  local tmp
  tmp="$(mktemp -d)"
  printf '%s\n' "$tmp"
}

run_discovery() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai/bunnify/.git" "$tmp/work/ai/my-tracks/.git"

  mkdir -p "$tmp/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"
  mkdir -p "$tmp/bin/lib"
  cp "scripts/lib/time-log" "$tmp/bin/lib/time-log"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    *) shift ;;
  esac
done

repo="$(basename "$dir")"
if [[ "$repo" == "bunnify" ]]; then
  printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
else
  printf '%s' '{"has_updates":false,"has_cves":false,"updates":[],"cves":[]}'
fi
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$tmp/bin:/usr/bin:/bin" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  if [[ -z "$err" ]]; then
    pass_case 'stderr is quiet by default in --print'
  else
    fail_case 'stderr is quiet by default in --print'
  fi
  assert_contains 'email includes From header' "$out" "From: dep-updater-notifier-no-reply@hcma.info"
  assert_contains 'email includes Reply-To header' "$out" "Reply-To: dep-updater-notifier-no-reply@hcma.info"
  assert_contains 'email subject mentions updates' "$out" \
    "Subject: [dep-updater-notifier] dependency updates needed"
  assert_contains 'email body includes discovered repo section' "$out" "=== bunnify ==="
}

run_short_flags() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai/bunnify/.git"
  mkdir -p "$tmp/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"
  mkdir -p "$tmp/bin/lib"
  cp "scripts/lib/time-log" "$tmp/bin/lib/time-log"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$tmp/bin:/usr/bin:/bin" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" -p -v 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  assert_contains 'verbose output appears on stderr' "$err" "Checking bunnify"
  assert_contains 'email includes From header' "$out" "From: dep-updater-notifier-no-reply@hcma.info"
  assert_contains 'email includes Reply-To header' "$out" "Reply-To: dep-updater-notifier-no-reply@hcma.info"
  assert_contains 'print mode emits email on stdout' "$out" \
    "Subject: [dep-updater-notifier] dependency updates needed"
}

run_failure_not_cron_silent() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN
  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"

  mkdir -p "$tmp/work/ai/bunnify/.git"
  mkdir -p "$tmp/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"
  mkdir -p "$tmp/bin/lib"
  cp "scripts/lib/time-log" "$tmp/bin/lib/time-log"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$tmp/bin:/usr/bin:/bin" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains 'stderr includes cron failure summary' "$err" \
    "ERROR: dep-updater-notifier failed (see email for details)"
  if [[ -f "$sendmail_breadcrumb" ]]; then
    pass_case 'sendmail mock was invoked'
  else
    fail_case 'sendmail mock was not invoked'
  fi
}

echo "=== discovery: finds repos under HOME/work/ai ==="
run_discovery

echo "=== flags: short forms work ==="
run_short_flags

echo "=== failure: scan failure is not cron-silent ==="
run_failure_not_cron_silent

echo "=== done ==="
test_summary
