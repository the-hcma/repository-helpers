#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

make_tmpdir() {
  local tmp
  tmp="$(mktemp -d)"
  # Collapse macOS TMPDIR trailing-slash doubles (…/T//…) so path asserts match
  # realpath'd command lines from the notifier under pre-pr-checks isolation.
  tmp="$(cd "$tmp" && pwd -P)"
  printf '%s\n' "$tmp"
}

stage_clone_with_origin() {
  local -r dir="$1"
  local -r slug="$2"
  mkdir -p "$dir"
  git -C "$dir" init --quiet
  git -C "$dir" remote add origin "https://github.com/${slug}.git"
}

stage_gh_not_archived_mock() {
  local -r tmp="$1"
  mkdir -p "$tmp/bin" "$tmp/.local/bin"
  cat >"$tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == 'api' && "${2:-}" == repos/* ]]; then
  printf 'false\n'
  exit 0
fi
printf 'unexpected gh invocation: %s\n' "$*" >&2
exit 1
EOF
  chmod +x "$tmp/bin/gh"
  cp "$tmp/bin/gh" "$tmp/.local/bin/gh"
}

stage_notifier_bundle() {
  local -r tmp="$1"
  mkdir -p "$tmp/bin/lib" "$tmp/.local/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"
  cp scripts/lib/time-log "$tmp/bin/lib/time-log"
  cp scripts/lib/tooling-path "$tmp/bin/lib/tooling-path"
  cp scripts/lib/gnu-userland "$tmp/bin/lib/gnu-userland"
  cp scripts/lib/tooling-prereqs "$tmp/bin/lib/tooling-prereqs"
  cp scripts/lib/sendmail "$tmp/bin/lib/sendmail"
  cp scripts/lib/email-multipart "$tmp/bin/lib/email-multipart"
  cp scripts/lib/runner "$tmp/bin/lib/runner"
  cp scripts/lib/runner-ensure "$tmp/bin/lib/runner-ensure"
  cp scripts/lib/runner-bootstrap "$tmp/bin/lib/runner-bootstrap"
  cp scripts/lib/github-repo-slug "$tmp/bin/lib/github-repo-slug"
  cp scripts/lib/github-api-rate-limit "$tmp/bin/lib/github-api-rate-limit"
  stage_gh_not_archived_mock "$tmp"
}

# Keep mocks first, then the bash that runs this suite (shebang via env), then
# a minimal system PATH. The notifier bootstraps GNU userland itself after start;
# do not strip the interpreter or rely on BSD /usr/bin tools in the wrapper PATH.
notifier_test_path() {
  local -r tmp="$1"
  local bash_dir
  bash_dir="$(cd "$(dirname "${BASH}")" && pwd)"
  printf '%s\n' "${tmp}/bin:${bash_dir}:/usr/bin:/bin"
}

run_discovery() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_clone_with_origin "$tmp/work/ai/my-tracks" 'the-hcma/example-tracks'

  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    *) shift ;;
  esac
done

repo="$(basename "$dir")"
if [[ "$repo" == "bunnify" ]]; then
  printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
else
  printf '%s' '{"has_updates":false,"has_cves":false,"updates":[],"cves":[]}'
fi
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  if [[ -z "$err" ]]; then
    pass_case 'stderr is quiet by default in --print'
  else
    fail_case 'stderr is quiet by default in --print'
  fi
  assert_contains 'email includes To header' "$out" "To: johndoe@example.com"
  assert_contains 'email includes From header' "$out" "From: dep-updater-notifier-no-reply@example.com"
  assert_contains 'email includes Reply-To header' "$out" "Reply-To: dep-updater-notifier-no-reply@example.com"
  assert_contains 'email subject mentions updates' "$out" \
    "Subject: [dep-updater-notifier] dependency updates needed"
  assert_contains 'email body includes GitHub slug section' "$out" \
    "=== the-hcma/example-repo ==="
  assert_not_contains 'email section uses slug not directory basename' "$out" \
    "=== bunnify ==="
  # Sole-update rows used to vanish: $(jq) strips the trailing newline and
  # `while read` drops the only line → header-only "Outdated packages" tables.
  assert_contains 'email body lists the sole outdated package' "$out" "astral-sh/setup-uv"
  assert_contains 'email body lists the from version' "$out" "v7"
  assert_contains 'email body lists the to version' "$out" "v8"
  assert_contains 'To update line uses GitHub slug' "$out" \
    "the-hcma/example-repo:  cd $tmp/work/ai/bunnify &&"
}

run_short_flags() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" -p -v 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  assert_contains 'verbose output appears on stderr' "$err" "Checking the-hcma/example-repo"
  assert_contains 'email includes To header' "$out" "To: johndoe@example.com"
  assert_contains 'email includes From header' "$out" "From: dep-updater-notifier-no-reply@example.com"
  assert_contains 'email includes Reply-To header' "$out" "Reply-To: dep-updater-notifier-no-reply@example.com"
  assert_contains 'print mode emits email on stdout' "$out" \
    "Subject: [dep-updater-notifier] dependency updates needed"
}

run_env_file_report_addresses() {
  local tmp out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  mkdir -p "$tmp/work/ai" "$tmp/.config"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/.config/dep-updater.env" <<'EOF'
DEP_UPDATER_SMTP_HOST=localhost
DEP_UPDATER_REPORT_TO=operator@example.com
DEP_UPDATER_REPORT_FROM=notifier-from@example.com
EOF

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env DEP_UPDATER_ENV_FILE="$tmp/.config/dep-updater.env" HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null)"

  assert_contains 'env file sets To address' "$out" "To: operator@example.com"
  assert_contains 'env file sets From address' "$out" "From: notifier-from@example.com"
  assert_contains 'env file sets Reply-To from From' "$out" "Reply-To: notifier-from@example.com"
}

run_missing_env_file_fails_outside_test_mode() {
  local tmp err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"
  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' '{"has_updates":false,"has_cves":false,"updates":[],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  err="$(env -u REPO_HELPERS_TEST_MODE -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    "$tmp/bin/dep-updater-notifier" --print 2>&1 >/dev/null || true)"

  assert_contains 'missing env file is fatal outside test mode' "$err" \
    "Missing required env file: ${tmp}/.config/dep-updater.env"
}

run_failure_not_cron_silent() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN
  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"

  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' 'ERROR: simulated dep-updater failure' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains 'stderr includes cron failure summary' "$err" \
    "ERROR: dep-updater-notifier failed: the-hcma/example-repo:"
  assert_contains 'stderr includes failed scan command' "$err" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
  assert_not_contains 'stderr does not say see email' "$err" \
    "see email for details"
  assert_contains 'stderr includes run_command FAIL block' "$err" \
    "[FAIL] dep-updater: the-hcma/example-repo"
  assert_contains 'stderr includes exit code' "$err" \
    "exit code: 1"
  assert_contains 'stderr includes dep-updater error line' "$err" \
    "ERROR: simulated dep-updater failure"
  if [[ -f "$sendmail_breadcrumb" ]]; then
    pass_case 'sendmail mock was invoked'
  else
    fail_case 'sendmail mock was not invoked'
  fi
}

run_failure_email_lists_stderr_in_plain_body() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' 'ERROR: tool missing under cron' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'print-mode email body labels dep-updater stderr' "$mail_out" "dep-updater stderr:"
  assert_contains 'print-mode email body includes stderr text' "$mail_out" "ERROR: tool missing under cron"
  assert_contains 'email section header includes actionable reason' "$mail_out" \
    "=== the-hcma/example-repo === (scan failed: tool missing under cron)"
  assert_contains 'email body includes failed scan command' "$mail_out" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
}

run_failure_email_header_from_runner_stderr_block() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' '[FAIL] gh auth' >&2
printf '%s\n' '  command:   gh auth setup-git' >&2
printf '%s\n' '  exit code: 1' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  unknown command "setup-git" for "gh"' >&2
printf '%s\n' '  --- end stderr ---' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'email header lifts nested runner stderr hint' "$mail_out" \
    '=== the-hcma/example-repo === (scan failed: gh auth: unknown command "setup-git" for "gh")'
}

run_failure_email_header_uses_first_runner_stderr_block() {
  local tmp mail_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' '[FAIL] first step' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  first failure message' >&2
printf '%s\n' '  --- end stderr ---' >&2
printf '%s\n' '[FAIL] second step' >&2
printf '%s\n' '  --- stderr ---' >&2
printf '%s\n' '  second failure message' >&2
printf '%s\n' '  --- end stderr ---' >&2
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  mail_out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"

  assert_contains 'email header uses first nested runner stderr block' "$mail_out" \
    '=== the-hcma/example-repo === (scan failed: first step: first failure message)'
  assert_not_contains 'email header does not merge later stderr blocks' "$mail_out" \
    'scan failed: second step'
}

