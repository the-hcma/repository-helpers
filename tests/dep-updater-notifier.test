run_failure_stderr_includes_invalid_json_reason() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN
  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"

  mkdir -p "$tmp/work/ai"
  stage_clone_with_origin "$tmp/work/ai/bunnify" 'the-hcma/example-repo'
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '\n[npm] CVEs with available fixes:\n'
printf '%s\n' '{"repo":"/tmp","has_updates":false,"has_cves":false,"cves":[],"updates":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains 'stderr names invalid-json repo' "$err" \
    'ERROR: dep-updater-notifier failed: the-hcma/example-repo: invalid JSON on stdout (exit code 0)'
  assert_contains 'stderr includes failed scan command for invalid json' "$err" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
  if [[ -f "$sendmail_breadcrumb" ]]; then
    pass_case 'sendmail still invoked for failure report'
  else
    fail_case 'sendmail still invoked for failure report'
  fi

  mail_out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"
  assert_contains 'email body includes failed scan command for invalid json' "$mail_out" \
    "command: $tmp/bin/dep-updater --report-json --dir $tmp/work/ai/bunnify"
}

run_skips_archived_repos() {
  local tmp out err
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  local -r archived_scan_breadcrumb="${tmp}/archived-scan.invoked"
  # tooling_path_bootstrap_cron_minimal puts $HOME/.local/bin ahead of /usr/bin.
  # Install the gh mock there so CI's real /usr/bin/gh cannot shadow it (404 →
  # archived-unknown → both repos skipped → empty email). Same pattern as
  # tests/dep-updater.test batch archived/private discovery fixtures.
  mkdir -p "$tmp/work/ai/active" "$tmp/work/ai/archived" "$tmp/.local/bin"
  stage_notifier_bundle "$tmp"

  # Minimal remotes so gh_slug_from_repo_dir resolves OWNER/NAME.
  git -C "$tmp/work/ai/active" init --quiet
  git -C "$tmp/work/ai/active" remote add origin "https://github.com/the-hcma/example-active.git"
  git -C "$tmp/work/ai/archived" init --quiet
  git -C "$tmp/work/ai/archived" remote add origin "https://github.com/the-hcma/example-archived.git"

  cat >"$tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
# github-repo-slug calls: gh api repos/OWNER/NAME --jq .archived
if [[ "${1:-}" == 'api' && "${2:-}" == repos/* ]]; then
  case "$2" in
    repos/the-hcma/example-archived) printf 'true\n'; exit 0 ;;
    repos/the-hcma/example-active) printf 'false\n'; exit 0 ;;
    *) printf 'false\n'; exit 0 ;;
  esac
fi
printf 'unexpected gh invocation: %s\n' "$*" >&2
exit 1
EOF
  cp "$tmp/bin/gh" "$tmp/.local/bin/gh"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    *) shift ;;
  esac
done
repo="$(basename "$dir")"
if [[ "$repo" == 'archived' ]]; then
  : >"${DEP_UPDATER_ARCHIVED_SCAN_BREADCRUMB:?}"
  printf '%s\n' 'ERROR: archived: dep-updater should not scan archived repos' >&2
  exit 1
fi
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"actions/checkout","from":"v4","to":"v5"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/gh" "$tmp/.local/bin/gh" "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    DEP_UPDATER_ARCHIVED_SCAN_BREADCRUMB="$archived_scan_breadcrumb" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  assert_contains 'email includes active repo slug' "$out" \
    "=== the-hcma/example-active ==="
  assert_contains 'email lists active package' "$out" "actions/checkout"
  assert_not_contains 'email omits archived repo section' "$out" "=== archived ==="
  assert_not_contains 'email omits archived repo slug' "$out" \
    "=== the-hcma/example-archived ==="
  assert_not_contains 'stderr has no archived scan failure' "$err" "archived:"
  if [[ ! -e "$archived_scan_breadcrumb" ]]; then
    pass_case 'archived repository is not scanned'
  else
    fail_case 'archived repository is not scanned'
  fi
}

# Missing origin: skip the scan, warn in the report, and do not blame git remote get-url.
run_no_origin_skips_with_actionable_warning() {
  local tmp out err spaced_cmd slash_out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  local -r scan_breadcrumb="${tmp}/orphan-scan.invoked"
  mkdir -p "$tmp/work/ai/orphan" "$tmp/.local/bin"
  stage_notifier_bundle "$tmp"

  git -C "$tmp/work/ai/orphan" init --quiet
  mkdir -p "$tmp/work/ai/has space"
  git -C "$tmp/work/ai/has space" init --quiet
  # No origin remote — archived probe's git remote get-url fails (must be --probe).

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
: >"${DEP_UPDATER_ORPHAN_SCAN_BREADCRUMB:?}"
printf '%s\n' 'ERROR: simulated scan boom' >&2
exit 2
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    DEP_UPDATER_ORPHAN_SCAN_BREADCRUMB="$scan_breadcrumb" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains 'email skips clone without GitHub origin' "$out" \
    '=== orphan === (skipped: no resolvable GitHub origin URL)'
  assert_contains 'email tells operator to point origin at GitHub' "$out" \
    'Point origin at a GitHub URL so the notifier can label the clone as OWNER/NAME'
  assert_contains 'email includes clone path' "$out" "path: $tmp/work/ai/orphan"
  assert_contains 'email includes git remote add origin command' "$out" \
    "command: git -C $tmp/work/ai/orphan remote add origin https://github.com/OWNER/NAME.git || git -C $tmp/work/ai/orphan remote set-url origin https://github.com/OWNER/NAME.git"
  spaced_cmd="$(printf 'git -C %q remote add origin https://github.com/OWNER/NAME.git || git -C %q remote set-url origin https://github.com/OWNER/NAME.git' \
    "$tmp/work/ai/has space" "$tmp/work/ai/has space")"
  assert_contains 'email quotes clone paths that contain spaces' "$out" \
    "command: ${spaced_cmd}"
  assert_contains 'stderr names missing origin as a notifier failure' "$err" \
    'orphan: no resolvable GitHub origin URL'
  assert_not_contains 'email does not scan a clone without origin' "$out" 'simulated scan boom'
  assert_not_contains 'email does not blame missing origin remote probe' "$out" 'git remote get-url'
  assert_not_contains 'stderr does not blame missing origin remote probe' "$err" 'git remote get-url'
  if [[ ! -e "$scan_breadcrumb" ]]; then
    pass_case 'clone without origin is not scanned'
  else
    fail_case 'clone without origin is not scanned'
  fi

  slash_out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    DEP_UPDATER_NOTIFIER_REPOS="$tmp/work/ai/orphan/" \
    REPO_HELPERS_TEST_MODE=1 \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null || true)"
  assert_contains 'trailing slash still names the clone orphan' "$slash_out" \
    '=== orphan === (skipped: no resolvable GitHub origin URL)'
  assert_not_contains 'trailing slash does not emit an empty section title' "$slash_out" \
    '=== ==='
}

run_skips_directory_symlinks() {
  local tmp out
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' RETURN

  local -r sendmail_breadcrumb="${tmp}/sendmail.invoked"
  local -r symlink_scan_breadcrumb="${tmp}/symlink-scan.invoked"
  mkdir -p "$tmp/work/ai" "$tmp/share"
  stage_clone_with_origin "$tmp/work/ai/active" 'the-hcma/example-active'
  stage_clone_with_origin "$tmp/share/live-clone" 'the-hcma/example-live'
  ln -s "$tmp/share/live-clone" "$tmp/work/ai/live-clone"
  stage_notifier_bundle "$tmp"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    *) shift ;;
  esac
done
repo="$(basename "$dir")"
if [[ "$repo" == 'live-clone' ]]; then
  : >"${DEP_UPDATER_SYMLINK_SCAN_BREADCRUMB:?}"
  printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"actions/checkout","from":"v4","to":"v5"}],"cves":[]}'
  exit 0
fi
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"actions/setup-node","from":"v4","to":"v5"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env -u DEP_UPDATER_ENV_FILE HOME="$tmp" PATH="$(notifier_test_path "$tmp")" \
    DEP_UPDATER_SYMLINK_SCAN_BREADCRUMB="$symlink_scan_breadcrumb" \
    REPO_HELPERS_TEST_MODE=1 REPO_HELPERS_SENDMAIL_BREADCRUMB="$sendmail_breadcrumb" \
    "$tmp/bin/dep-updater-notifier" --print 2>/dev/null)"

  assert_contains 'email includes real clone slug' "$out" \
    "=== the-hcma/example-active ==="
  assert_not_contains 'email omits symlinked clone basename' "$out" "=== live-clone ==="
  assert_not_contains 'email omits symlinked clone slug' "$out" \
    "=== the-hcma/example-live ==="
  if [[ ! -e "$symlink_scan_breadcrumb" ]]; then
    pass_case 'directory symlink under scan root is not scanned'
  else
    fail_case 'directory symlink under scan root is not scanned'
  fi
}

printf '\n=== static: empty arrays safe under set -u ===\n'
notifier_script="scripts/dep-updater-notifier"
if grep -qF "(( \${#notice_lines[@]} > 0 ))" "$notifier_script" \
  && grep -qF "(( \${#update_repos_paths[@]} > 0 ))" "$notifier_script"; then
  pass_case 'empty notice_lines and update_repos_paths are guarded before iteration'
else
  fail_case 'missing length guard before empty-array iteration (breaks bash 3.x + set -u)'
fi

printf '\n=== static: dep-updater-notifier runner adoption ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'lib/runner-bootstrap' "$notifier_script" \
  && grep -qF 'dun_runner_jq_file' "$notifier_script" \
  && grep -qF 'dun_runner_jq_r' "$notifier_script" \
  && grep -qF 'dun_runner_exec_stdout' "$notifier_script" \
  && grep -qF 'run_command "dep-updater:' "$notifier_script" \
  && grep -qF 'dun_actionable_fail_reason_from_stderr' "$notifier_script"; then
  pass_case 'dep-updater-notifier: jq and utilities via dun_runner helpers; dep-updater via run_command'
else
  fail_case 'dep-updater-notifier: missing runner adoption wiring'
fi

printf '\n=== static: dep-updater-notifier stream newline restore ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'dun_runner_print_stream' "$notifier_script" \
  && grep -qF 'dun_runner_jq_stream' "$notifier_script" \
  && grep -qF 'dun_skip_archived_repo' "$notifier_script" \
  && grep -qF 'dun_repo_display_name' "$notifier_script" \
  && grep -qF 'dun_repo_basename' "$notifier_script" \
  && grep -qF 'dun_record_missing_origin' "$notifier_script" \
  && grep -qF 'github-repo-slug' "$notifier_script" \
  && grep -qF '.updates|length' "$notifier_script" \
  && ! grep -qF 'dun_runner_print_captured' "$notifier_script"; then
  pass_case 'dep-updater-notifier: stream-only newline restore, archived skip, slug labels, updates|length gate'
else
  fail_case 'dep-updater-notifier: missing stream/archived-skip/slug wiring (or scalar print_captured)'
fi

printf '\n=== static: missing-origin suggested command avoids runner-adoption || git ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'origin_cmd="${origin_add} || ${origin_set}"' "$notifier_script" \
  && grep -qF 'origin_add="git -C ${quoted_repo} remote add origin https://github.com/OWNER/NAME.git"' \
    "$notifier_script" \
  && grep -qF 'origin_set="git -C ${quoted_repo} remote set-url origin https://github.com/OWNER/NAME.git"' \
    "$notifier_script" \
  && ! grep -qE '[|][[:space:]]*git[[:space:]]' "$notifier_script"; then
  pass_case 'missing-origin command is assembled without a || git token on one line'
else
  fail_case 'missing-origin suggested git command would trip runner-adoption (|| git)'
fi

printf '\n=== static: dep-updater-notifier skips scan-root directory symlinks ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF '[[ -L "$child" ]]' "$notifier_script"; then
  pass_case 'dep-updater-notifier: discover_repos skips directory symlinks'
else
  fail_case 'dep-updater-notifier: discover_repos must skip directory symlinks'
fi

printf '\n=== static: dep-updater-notifier multipart via email-multipart ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
# Regression: runner_exec_stdout + sed <<<"$body" emptied the HTML MIME part
# (runner backgrounds sed with /dev/null stdin; HTML-preferring clients showed blank).
if grep -qF 'lib/email-multipart' "$notifier_script" \
  && grep -qF 'repo_helpers_email_write_multipart' "$notifier_script" \
  && ! grep -qE 'html escape|<<<"\$body"' "$notifier_script"; then
  pass_case 'dep-updater-notifier: send path uses email-multipart (no runner here-string HTML escape)'
else
  fail_case 'dep-updater-notifier: missing email-multipart wiring or still uses broken HTML escape'
fi

printf '\n=== static: dep-updater-notifier loads dep-updater.env ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'dun_load_env_file' "$notifier_script" \
  && grep -qF 'dun_apply_config_defaults' "$notifier_script" \
  && grep -qF 'DEP_UPDATER_REPORT_TO' "$notifier_script" \
  && grep -qF '${HOME}/.config/dep-updater.env' "$notifier_script"; then
  pass_case 'dep-updater-notifier: loads REPORT_TO from dep-updater.env'
else
  fail_case 'dep-updater-notifier: missing dep-updater.env address wiring'
fi

echo "=== discovery: finds repos under HOME/work/ai ==="
run_discovery

echo "=== flags: short forms work ==="
run_short_flags

echo "=== config: env file sets report addresses ==="
run_env_file_report_addresses

echo "=== config: missing env file fails outside test mode ==="
run_missing_env_file_fails_outside_test_mode

echo "=== failure: scan failure is not cron-silent ==="
run_failure_not_cron_silent

echo "=== failure: print-mode email lists dep-updater stderr ==="
run_failure_email_lists_stderr_in_plain_body

echo "=== failure: email header uses nested runner stderr hint ==="
run_failure_email_header_from_runner_stderr_block

echo "=== failure: email header stops at first nested stderr block ==="
run_failure_email_header_uses_first_runner_stderr_block

echo "=== failure: email header uses first non-blank stderr line ==="
run_failure_email_header_uses_first_nonblank_stderr_line

echo "=== failure: cron stderr includes invalid-json reason ==="
run_failure_stderr_includes_invalid_json_reason

echo "=== discovery: skips archived GitHub repositories ==="
run_skips_archived_repos

echo "=== discovery: skips clones without GitHub origin and warns ==="
run_no_origin_skips_with_actionable_warning

echo "=== discovery: skips directory symlinks under the scan root ==="
run_skips_directory_symlinks

echo "=== done ==="
test_summary
