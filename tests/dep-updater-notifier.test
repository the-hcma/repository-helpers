#!/usr/bin/env bash
set -euo pipefail

failures=0

pass() {
  printf '[PASS] %s\n' "$1"
}

fail() {
  printf '[FAIL] %s\n' "$1"
  failures=$(( failures + 1 ))
}

assert_contains() {
  local -r haystack="$1"
  local -r needle="$2"
  local -r name="$3"
  if grep -qF "$needle" <<<"$haystack"; then
    pass "$name"
  else
    printf '%s\n' "---- output ----" >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' "--------------" >&2
    fail "$name"
  fi
}

make_tmpdir() {
  local tmp
  tmp="$(mktemp -d)"
  printf '%s\n' "$tmp"
}

echo "=== discovery: finds repos under HOME/work/ai ==="
(
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' EXIT

  mkdir -p "$tmp/work/ai/bunnify/.git" "$tmp/work/ai/my-tracks/.git"

  mkdir -p "$tmp/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    *) shift ;;
  esac
done

repo="$(basename "$dir")"
if [[ "$repo" == "bunnify" ]]; then
  printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
else
  printf '%s' '{"has_updates":false,"has_cves":false,"updates":[],"cves":[]}'
fi
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$tmp/bin:/usr/bin:/bin" "$tmp/bin/dep-updater-notifier" --print 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  if [[ -z "$err" ]]; then
    pass 'stderr is quiet by default in --print'
  else
    fail 'stderr is quiet by default in --print'
  fi
  assert_contains "$out" "From: dep-updater-notifier-no-reply@hcma.info" 'email includes From header'
  assert_contains "$out" "Reply-To: dep-updater-notifier-no-reply@hcma.info" 'email includes Reply-To header'
  assert_contains "$out" "Subject: [dep-updater-notifier] dependency updates needed" 'email subject mentions updates'
  assert_contains "$out" "=== bunnify ===" 'email body includes discovered repo section'
)

echo "=== flags: short forms work ==="
(
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' EXIT

  mkdir -p "$tmp/work/ai/bunnify/.git"
  mkdir -p "$tmp/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' '{"has_updates":true,"has_cves":false,"updates":[{"ecosystem":"gha","package":"astral-sh/setup-uv","from":"v7","to":"v8"}],"cves":[]}'
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  out="$(env HOME="$tmp" PATH="$tmp/bin:/usr/bin:/bin" "$tmp/bin/dep-updater-notifier" -p -v 2>"$tmp/stderr")"
  err="$(cat "$tmp/stderr")"

  assert_contains "$err" "Checking bunnify" 'verbose output appears on stderr'
  assert_contains "$out" "From: dep-updater-notifier-no-reply@hcma.info" 'email includes From header'
  assert_contains "$out" "Reply-To: dep-updater-notifier-no-reply@hcma.info" 'email includes Reply-To header'
  assert_contains "$out" "Subject: [dep-updater-notifier] dependency updates needed" 'print mode emits email on stdout'
)

echo "=== failure: scan failure is not cron-silent ==="
(
  tmp="$(make_tmpdir)"
  readonly tmp
  trap 'rm -rf "$tmp"' EXIT

  mkdir -p "$tmp/work/ai/bunnify/.git"
  mkdir -p "$tmp/bin"
  cp "scripts/dep-updater-notifier" "$tmp/bin/dep-updater-notifier"

  cat >"$tmp/bin/dep-updater" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exit 1
EOF
  chmod +x "$tmp/bin/dep-updater" "$tmp/bin/dep-updater-notifier"

  # Run in "sendmail" mode with a stub sendmail binary, so we can assert
  # non-zero exit emits a single stderr line for cron.
  cat >"$tmp/bin/sendmail" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cat >/dev/null
exit 0
EOF
  chmod +x "$tmp/bin/sendmail"

  out="$(env HOME="$tmp" PATH="$tmp/bin:/usr/bin:/bin" "$tmp/bin/dep-updater-notifier" 2>"$tmp/stderr" || true)"
  err="$(cat "$tmp/stderr")"

  assert_contains "$err" "ERROR: dep-updater-notifier failed (see email for details)" 'stderr includes cron failure summary'
)

echo "=== done ==="
if (( failures > 0 )); then
  exit 1
fi
