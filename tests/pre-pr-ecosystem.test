#!/usr/bin/env bash
# Hermetic tests for scripts/lib/pre-pr-ecosystem (detection + shebang filter).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/pre-pr-ecosystem"

pre_pr_checks="${script_dir}/../scripts/dev/pre-pr-checks"
ecosystem_lib="${script_dir}/../scripts/lib/pre-pr-ecosystem"
rh_root="${script_dir}/.."
readonly pre_pr_checks ecosystem_lib rh_root

pass=0
fail=0

make_git_fixture() {
  local -r dir="$1"
  mkdir -p "$dir"
  (
    cd "$dir"
    git init -q
    git config user.email 'test@example.com'
    git config user.name 'Test'
  )
}

commit_all() {
  local -r dir="$1"
  (
    cd "$dir"
    git add -A
    git commit -q -m 'fixture' --allow-empty
  )
}

printf '\n=== static: pre-pr-ecosystem conventions ===\n'
if head -1 "$ecosystem_lib" | grep -qF '# shellcheck shell=bash'; then
  pass_case 'ecosystem lib: shellcheck shell=bash'
else
  fail_case 'ecosystem lib: shellcheck shell=bash'
fi
if grep -qF 'runner-ensure' "$ecosystem_lib" \
  && grep -qF 'prec_detect_profile' "$ecosystem_lib" \
  && grep -qF 'prec_require_tools_for_planned' "$ecosystem_lib" \
  && grep -qF 'PRE_PR_CHECKS_SKIP' "$ecosystem_lib"; then
  pass_case 'ecosystem lib: detect + require + skip env'
else
  fail_case 'ecosystem lib: detect + require + skip env'
fi
# shellcheck disable=SC2016  # assert literal source text
if grep -qF 'prec_shell_file_eligible' "$ecosystem_lib" \
  && grep -qF "*bash*" "$ecosystem_lib" \
  && grep -qF 'runner_exec_stdout "prec git ls-files .github/ci"' "$ecosystem_lib"; then
  pass_case 'ecosystem lib: shebang-aware shell collect via runner'
else
  fail_case 'ecosystem lib: shebang-aware shell collect via runner'
fi

# shellcheck disable=SC2016  # static: no run_command followed by return 0 in runners
if awk '
  /run_command/ { prev=1; next }
  prev && /^[[:space:]]*return 0/ { exit 0 }
  { prev=0 }
  END { exit 1 }
' "$ecosystem_lib"; then
  fail_case 'job runners do not mask run_command failures with return 0'
else
  pass_case 'job runners do not mask run_command failures with return 0'
fi

printf '\n=== static: pre-pr-checks detect-first wiring ===\n'
if grep -qF 'pre-pr-ecosystem' "$pre_pr_checks" \
  && grep -qF 'prec_detect_profile' "$pre_pr_checks" \
  && grep -qF 'prec_require_tools_for_planned' "$pre_pr_checks" \
  && grep -qF 'start_planned_parallel_checks' "$pre_pr_checks"; then
  pass_case 'pre-pr-checks sources ecosystem and detect-first'
else
  fail_case 'pre-pr-checks sources ecosystem and detect-first'
fi
# Detect before require: line order in main().
detect_line=0
require_line=0
detect_line="$(grep -n 'prec_detect_profile' "$pre_pr_checks" | head -1 | cut -d: -f1)"
require_line="$(grep -n 'prec_require_tools_for_planned' "$pre_pr_checks" | head -1 | cut -d: -f1)"
if [[ -n "$detect_line" && -n "$require_line" && "$detect_line" -lt "$require_line" ]]; then
  pass_case 'pre-pr-checks calls detect before require_tools'
else
  fail_case 'pre-pr-checks calls detect before require_tools'
fi
# Must not unconditionally require shellcheck at top-level require_tools.
if ! grep -qE '^require_tools\(\)' "$pre_pr_checks" \
  && ! grep -qF 'command -v shellcheck' "$pre_pr_checks"; then
  pass_case 'pre-pr-checks does not always require shellcheck'
else
  fail_case 'pre-pr-checks does not always require shellcheck'
fi

printf '\n=== prec_shell_file_eligible ===\n'
elig_tmp="$(mktemp -d)"
printf '#!/usr/bin/env bash\necho hi\n' >"${elig_tmp}/ok-script"
printf '#!/usr/bin/env python3\nprint(1)\n' >"${elig_tmp}/py-script"
printf 'x = 1\n' >"${elig_tmp}/plain.py"
if prec_shell_file_eligible "${elig_tmp}/ok-script"; then
  pass_case 'eligible: bash shebang script'
else
  fail_case 'eligible: bash shebang script'
fi
if ! prec_shell_file_eligible "${elig_tmp}/py-script"; then
  pass_case 'ineligible: python shebang (no extension)'
else
  fail_case 'ineligible: python shebang (no extension)'
fi
if ! prec_shell_file_eligible "${elig_tmp}/plain.py"; then
  pass_case 'ineligible: .py extension'
else
  fail_case 'ineligible: .py extension'
fi
printf '#!/usr/bin/env perl\nprint 1;\n' >"${elig_tmp}/perl-script"
printf '# shellcheck shell=bash\ntrue\n' >"${elig_tmp}/sourced-lib"
if ! prec_shell_file_eligible "${elig_tmp}/perl-script"; then
  pass_case 'ineligible: perl shebang'
else
  fail_case 'ineligible: perl shebang'
fi
if prec_shell_file_eligible "${elig_tmp}/sourced-lib"; then
  pass_case 'eligible: sourced lib without shebang'
else
  fail_case 'eligible: sourced lib without shebang'
fi
rm -rf "$elig_tmp"

printf '\n=== detect: python-only fixture (no cargo/pnpm jobs) ===\n'
py_fix="$(mktemp -d)"
make_git_fixture "$py_fix"
printf '[project]\nname = "x"\n' >"${py_fix}/pyproject.toml"
mkdir -p "${py_fix}/scripts"
printf '#!/usr/bin/env bash\ntrue\n' >"${py_fix}/scripts/hello"
commit_all "$py_fix"
unset PRE_PR_CHECKS_SKIP
prec_detect_profile "$py_fix"
detected="$(prec_format_detected)"
planned="$(prec_format_planned_jobs)"
if [[ "$detected" == *python* && "$detected" != *rust* && "$detected" != *ts-* ]]; then
  pass_case 'python-only: detected python (no foreign ecosystems)'
else
  fail_case "python-only: detected python (got ${detected})"
fi
if [[ "$planned" == *python-static* && "$planned" != *cargo* && "$planned" != *ts-* \
  && "$planned" != *shellcheck* && "$planned" != *pytest-hermetic* ]]; then
  pass_case 'python-only: planned python-static; no shellcheck without helpers/wrapper'
else
  fail_case "python-only: planned jobs (got ${planned})"
fi
# Require tools must not demand cargo/pnpm for this profile.
need_cargo=0
need_pnpm=0
prec_job_is_planned 'cargo-fmt' && need_cargo=1
prec_job_is_planned 'ts-web' && need_pnpm=1
prec_job_is_planned 'ts-root' && need_pnpm=1
if [[ "$need_cargo" -eq 0 && "$need_pnpm" -eq 0 ]]; then
  pass_case 'python-only: no cargo/pnpm in planned tools'
else
  fail_case 'python-only: no cargo/pnpm in planned tools'
fi
rm -rf "$py_fix"

printf '\n=== detect: pytest-hermetic wrapper plans hermetic job (#555) ===\n'
herm_fix="$(mktemp -d)"
make_git_fixture "$herm_fix"
printf '[project]\nname = "x"\n' >"${herm_fix}/pyproject.toml"
mkdir -p "${herm_fix}/.github/ci"
printf '#!/usr/bin/env bash\nset -euo pipefail\nuv run pytest -m '\''not live'\'' -q\n' \
  >"${herm_fix}/.github/ci/pytest-hermetic"
chmod +x "${herm_fix}/.github/ci/pytest-hermetic"
commit_all "$herm_fix"
unset PRE_PR_CHECKS_SKIP
prec_detect_profile "$herm_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" == *python-static* && "$planned" == *pytest-hermetic* ]]; then
  pass_case 'pytest-hermetic: plans python-static and pytest-hermetic when wrapper exists'
else
  fail_case "pytest-hermetic: expected both jobs (got ${planned})"
fi
# Exercise prec_require_tools_for_planned with only pytest-hermetic planned so
# the python-static uv branch cannot mask a missing pytest-hermetic check.
# shellcheck disable=SC2034 # array is read by prec_job_is_planned inside the gate
prec_planned_jobs=('pytest-hermetic')
no_uv_bin="$(mktemp -d)"
ln -s "$(command -v bash)" "${no_uv_bin}/bash"
require_out=""
require_rc=0
set +e
require_out="$(PATH="$no_uv_bin" prec_require_tools_for_planned 2>&1)"
require_rc=$?
set -e
rm -rf "$no_uv_bin"
if [[ "$require_rc" -ne 0 ]] && grep -qF 'uv not found' <<<"$require_out"; then
  pass_case 'pytest-hermetic: prec_require_tools_for_planned fails without uv'
else
  fail_case "pytest-hermetic: expect uv missing die (rc=${require_rc})\n${require_out}"
fi
# Absent wrapper must not plan the job (already covered by python-only above).
rm -rf "$herm_fix"

printf '\n=== behavioural: pytest-hermetic runner invokes the wrapper (#555) ===\n'
run_fix="$(mktemp -d)"
make_git_fixture "$run_fix"
printf '[project]\nname = "x"\n' >"${run_fix}/pyproject.toml"
mkdir -p "${run_fix}/.github/ci"
printf '#!/usr/bin/env bash\nset -euo pipefail\nprintf "hermetic-ok\\n"\n' \
  >"${run_fix}/.github/ci/pytest-hermetic"
chmod +x "${run_fix}/.github/ci/pytest-hermetic"
commit_all "$run_fix"
herm_out=""
herm_rc=0
set +e
herm_out="$(prec_run_pytest_hermetic "$run_fix" 2>&1)"
herm_rc=$?
set -e
if [[ "$herm_rc" -eq 0 ]] && grep -qF 'hermetic-ok' <<<"$herm_out"; then
  pass_case 'pytest-hermetic: runner executes .github/ci/pytest-hermetic'
else
  fail_case "pytest-hermetic: runner failed (rc=${herm_rc})\n${herm_out}"
fi
# Failing wrapper must fail the job.
printf '#!/usr/bin/env bash\nset -euo pipefail\nexit 7\n' \
  >"${run_fix}/.github/ci/pytest-hermetic"
chmod +x "${run_fix}/.github/ci/pytest-hermetic"
set +e
prec_run_pytest_hermetic "$run_fix" >/dev/null 2>&1
herm_rc=$?
set -e
if [[ "$herm_rc" -ne 0 ]]; then
  pass_case 'pytest-hermetic: failing wrapper fails the pre-pr job'
else
  fail_case 'pytest-hermetic: failing wrapper must not exit 0'
fi
rm -rf "$run_fix"

printf '\n=== detect: helpers-style plans shellcheck ===\n'
hs_fix="$(mktemp -d)"
make_git_fixture "$hs_fix"
mkdir -p "${hs_fix}/scripts/dev" "${hs_fix}/scripts/lib"
printf '#!/usr/bin/env bash\ntrue\n' >"${hs_fix}/scripts/dev/pre-pr-checks"
printf '#!/usr/bin/env bash\ntrue\n' >"${hs_fix}/scripts/lib/helper"
commit_all "$hs_fix"
prec_detect_profile "$hs_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" == *shellcheck* && "$planned" == *bash-n* ]]; then
  pass_case 'helpers-style: plans bash-n and shellcheck'
else
  fail_case "helpers-style: plans shell jobs (got ${planned})"
fi
rm -rf "$hs_fix"

printf '\n=== detect: shellcheck wrapper plans shellcheck ===\n'
wrap_fix="$(mktemp -d)"
make_git_fixture "$wrap_fix"
mkdir -p "${wrap_fix}/.github/ci" "${wrap_fix}/scripts"
printf '#!/usr/bin/env bash\ntrue\n' >"${wrap_fix}/.github/ci/shellcheck"
printf '#!/usr/bin/env bash\ntrue\n' >"${wrap_fix}/scripts/ok"
commit_all "$wrap_fix"
prec_detect_profile "$wrap_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" == *shellcheck* ]]; then
  pass_case 'wrapper: plans shellcheck'
else
  fail_case "wrapper: plans shellcheck (got ${planned})"
fi
rm -rf "$wrap_fix"

printf '\n=== detect: rust-only fixture ===\n'
rs_fix="$(mktemp -d)"
make_git_fixture "$rs_fix"
printf '[package]\nname = "x"\nversion = "0.1.0"\nedition = "2021"\n' >"${rs_fix}/Cargo.toml"
commit_all "$rs_fix"
prec_detect_profile "$rs_fix"
detected="$(prec_format_detected)"
planned="$(prec_format_planned_jobs)"
if [[ "$detected" == *rust* && "$detected" != *python* && "$detected" != *ts-* ]]; then
  pass_case 'rust-only: detected rust'
else
  fail_case "rust-only: detected rust (got ${detected})"
fi
if [[ "$planned" == *cargo-fmt* && "$planned" == *cargo-clippy* \
  && "$planned" != *python* && "$planned" != *ts-* ]]; then
  pass_case 'rust-only: planned cargo jobs only (ecosystem)'
else
  fail_case "rust-only: planned cargo (got ${planned})"
fi
rm -rf "$rs_fix"

printf '\n=== detect: web-ts fixture ===\n'
web_fix="$(mktemp -d)"
make_git_fixture "$web_fix"
mkdir -p "${web_fix}/web"
printf '{"name":"w","packageManager":"pnpm@9.0.0","scripts":{"typecheck":"tsc"}}\n' \
  >"${web_fix}/web/package.json"
printf 'lock\n' >"${web_fix}/web/pnpm-lock.yaml"
commit_all "$web_fix"
prec_detect_profile "$web_fix"
detected="$(prec_format_detected)"
planned="$(prec_format_planned_jobs)"
if [[ "$detected" == *ts-web* && "$planned" == *ts-web* && "$planned" != *ts-root* ]]; then
  pass_case 'web-ts: detected ts-web job'
else
  fail_case "web-ts: detected ts-web (detected=${detected} planned=${planned})"
fi
rm -rf "$web_fix"

printf '\n=== detect: root pnpm (no web/) ===\n'
root_ts="$(mktemp -d)"
make_git_fixture "$root_ts"
printf '{"name":"r","packageManager":"pnpm@9.0.0","scripts":{"check":"tsc"}}\n' \
  >"${root_ts}/package.json"
printf 'lock\n' >"${root_ts}/pnpm-lock.yaml"
commit_all "$root_ts"
prec_detect_profile "$root_ts"
detected="$(prec_format_detected)"
planned="$(prec_format_planned_jobs)"
if [[ "$detected" == *ts-root* && "$planned" == *ts-root* && "$planned" != *ts-web* ]]; then
  pass_case 'root-ts: detected ts-root job'
else
  fail_case "root-ts: detected ts-root (detected=${detected} planned=${planned})"
fi
rm -rf "$root_ts"

printf '\n=== PRE_PR_CHECKS_SKIP ===\n'
skip_fix="$(mktemp -d)"
make_git_fixture "$skip_fix"
printf '[project]\nname = "x"\n' >"${skip_fix}/pyproject.toml"
commit_all "$skip_fix"
export PRE_PR_CHECKS_SKIP='python-static,shellcheck'
prec_detect_profile "$skip_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" != *python-static* ]]; then
  pass_case 'SKIP removes python-static from planned'
else
  fail_case "SKIP removes python-static (got ${planned})"
fi
unset PRE_PR_CHECKS_SKIP
rm -rf "$skip_fix"

printf '\n=== prec repo-practices sensitive paths ===\n'
if prec_relpath_is_repo_practices_sensitive '.github/workflows/ci.yml' \
  && prec_relpath_is_repo_practices_sensitive '.github/CODEOWNERS' \
  && prec_relpath_is_repo_practices_sensitive 'web/pnpm-workspace.yaml' \
  && prec_relpath_is_repo_practices_sensitive 'release-please-config.json' \
  && prec_relpath_is_repo_practices_sensitive '.cursor/rules/foo.mdc' \
  && prec_relpath_is_repo_practices_sensitive 'scripts/lib/repo-practices-cursor/foo.mdc' \
  && prec_relpath_is_repo_practices_sensitive 'scripts/lib/repo-practices' \
  && ! prec_relpath_is_repo_practices_sensitive 'README.md'; then
  pass_case 'prec_relpath_is_repo_practices_sensitive matches config/workflow/cursor-rule paths'
else
  fail_case 'prec_relpath_is_repo_practices_sensitive matches config/workflow/cursor-rule paths'
fi

printf '\n=== prec org cursor-rule enforcement detection ===\n'
org_enforce_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-org-enforce.XXXXXX")"
make_git_fixture "$org_enforce_fix"
mkdir -p "${org_enforce_fix}/scripts/lib/repo-practices-cursor"
cat >"${org_enforce_fix}/scripts/lib/repo-practices-cursor/new-rule.mdc" <<'EOF'
---
alwaysApply: true
---
EOF
commit_all "$org_enforce_fix"
(
  cd "$org_enforce_fix"
  git branch -M main
  git checkout -q -b feat/new-rule
  printf '\nrollout\n' >>scripts/lib/repo-practices-cursor/new-rule.mdc
  git add scripts/lib/repo-practices-cursor/new-rule.mdc
)
if prec_branch_touches_org_cursor_rule_enforcement "$org_enforce_fix"; then
  pass_case 'prec_branch_touches_org_cursor_rule_enforcement detects template changes'
else
  fail_case 'prec_branch_touches_org_cursor_rule_enforcement detects template changes'
fi
rm -rf "$org_enforce_fix"

printf '\n=== prec repo-practices diff planning ===\n'
rp_diff_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-rp-diff.XXXXXX")"
make_git_fixture "$rp_diff_fix"
mkdir -p "${rp_diff_fix}/.github/workflows"
printf 'name: ci\n' >"${rp_diff_fix}/.github/workflows/ci.yml"
commit_all "$rp_diff_fix"
(
  cd "$rp_diff_fix"
  git branch -M main
  git checkout -q -b feat/workflow-tweak
  printf 'on: push\n' >>.github/workflows/ci.yml
)
export REPOSITORY_HELPERS_DIR="${script_dir}/.."
if prec_should_plan_repo_practices_lint "$rp_diff_fix"; then
  pass_case 'repo-practices-lint planned when workflow path changed on branch'
else
  fail_case 'repo-practices-lint planned when workflow path changed on branch'
fi
printf 'docs\n' >"${rp_diff_fix}/README.md"
if prec_should_plan_repo_practices_lint "$rp_diff_fix"; then
  pass_case 'repo-practices-lint still planned when workflow and docs both changed'
else
  fail_case 'repo-practices-lint still planned when workflow and docs both changed'
fi
rm -rf "$rp_diff_fix"
unset REPOSITORY_HELPERS_DIR

rp_clean_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-rp-clean.XXXXXX")"
make_git_fixture "$rp_clean_fix"
printf 'hello\n' >"${rp_clean_fix}/README.md"
commit_all "$rp_clean_fix"
(
  cd "$rp_clean_fix"
  git branch -M main
  git checkout -q -b feat/docs-only
  printf 'world\n' >>README.md
)
export REPOSITORY_HELPERS_DIR="${script_dir}/.."
if ! prec_should_plan_repo_practices_lint "$rp_clean_fix"; then
  pass_case 'repo-practices-lint not planned for docs-only diff'
else
  fail_case 'repo-practices-lint not planned for docs-only diff'
fi
rm -rf "$rp_clean_fix"
unset REPOSITORY_HELPERS_DIR

printf '\n=== static: repo-practices-lint wiring ===\n'
if grep -qF 'prec_should_plan_repo_practices_lint' "$ecosystem_lib" \
  && grep -qF 'prec_run_repo_practices_lint' "$ecosystem_lib" \
  && grep -qF 'repo-practices-lint' "$pre_pr_checks" \
  && grep -qF 'prec_run_repo_practices_lint' "$pre_pr_checks"; then
  pass_case 'repo-practices-lint detect-first wiring in ecosystem and pre-pr-checks'
else
  fail_case 'repo-practices-lint detect-first wiring in ecosystem and pre-pr-checks'
fi

printf '\n=== static: secret-scan wiring ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'prec_should_plan_secret_scan' "$ecosystem_lib" \
  && grep -qF 'prec_run_secret_scan' "$ecosystem_lib" \
  && grep -qF 'prec_secret_scan_set_range_env' "$ecosystem_lib" \
  && grep -qF 'GITLEAKS_BASE' "$ecosystem_lib" \
  && grep -qF 'scripts/dev/secret-scan' "$ecosystem_lib" \
  && grep -qF '.github/ci/secret-scan' "$ecosystem_lib" \
  && grep -qF "secret-scan) start_parallel_job 'secret-scan' prec_run_secret_scan" "$pre_pr_checks" \
  && grep -qF 'PRE_PR_CHECKS_SKIP=secret-scan' "$pre_pr_checks"; then
  pass_case 'secret-scan detect-first wiring in ecosystem and pre-pr-checks'
else
  fail_case 'secret-scan detect-first wiring in ecosystem and pre-pr-checks'
fi

printf '\n=== detect: secret-scan with .github/ci/secret-scan ===\n'
ss_ci_fix="$(mktemp -d)"
make_git_fixture "$ss_ci_fix"
mkdir -p "${ss_ci_fix}/.github/ci"
printf '#!/usr/bin/env bash\ntrue\n' >"${ss_ci_fix}/.github/ci/secret-scan"
commit_all "$ss_ci_fix"
unset PRE_PR_CHECKS_SKIP
prec_detect_profile "$ss_ci_fix"
planned="$(prec_format_planned_jobs)"
detected="$(prec_format_detected)"
if [[ "$detected" == *secret-scan* && "$planned" == *secret-scan* ]]; then
  pass_case 'ci secret-scan script: plans secret-scan job'
else
  fail_case "ci secret-scan script: plans secret-scan (detected=${detected} planned=${planned})"
fi
rm -rf "$ss_ci_fix"

printf '\n=== detect: helpers-style with scripts/dev/secret-scan ===\n'
ss_hs_fix="$(mktemp -d)"
make_git_fixture "$ss_hs_fix"
mkdir -p "${ss_hs_fix}/scripts/dev" "${ss_hs_fix}/scripts/lib"
printf '#!/usr/bin/env bash\ntrue\n' >"${ss_hs_fix}/scripts/dev/pre-pr-checks"
printf '#!/usr/bin/env bash\ntrue\n' >"${ss_hs_fix}/scripts/dev/secret-scan"
printf '# shellcheck shell=bash\ntrue\n' >"${ss_hs_fix}/scripts/lib/ci-secret-scan"
commit_all "$ss_hs_fix"
prec_detect_profile "$ss_hs_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" == *secret-scan* ]]; then
  pass_case 'helpers-style with secret-scan: plans secret-scan'
else
  fail_case "helpers-style with secret-scan: plans secret-scan (got ${planned})"
fi
export PRE_PR_CHECKS_SKIP='secret-scan'
prec_detect_profile "$ss_hs_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" != *secret-scan* ]]; then
  pass_case 'PRE_PR_CHECKS_SKIP=secret-scan removes job'
else
  fail_case "PRE_PR_CHECKS_SKIP=secret-scan removes job (got ${planned})"
fi
unset PRE_PR_CHECKS_SKIP
rm -rf "$ss_hs_fix"

printf '\n=== detect: helpers-style with lib only does not plan secret-scan ===\n'
ss_lib_only="$(mktemp -d)"
make_git_fixture "$ss_lib_only"
mkdir -p "${ss_lib_only}/scripts/dev" "${ss_lib_only}/scripts/lib"
printf '#!/usr/bin/env bash\ntrue\n' >"${ss_lib_only}/scripts/dev/pre-pr-checks"
printf '# shellcheck shell=bash\ntrue\n' >"${ss_lib_only}/scripts/lib/ci-secret-scan"
commit_all "$ss_lib_only"
prec_detect_profile "$ss_lib_only"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" != *secret-scan* ]]; then
  pass_case 'helpers-style with lib only: does not plan secret-scan'
else
  fail_case "helpers-style with lib only: does not plan secret-scan (got ${planned})"
fi
rm -rf "$ss_lib_only"

printf '\n=== detect: no secret-scan without adoption ===\n'
ss_none_fix="$(mktemp -d)"
make_git_fixture "$ss_none_fix"
printf 'hello\n' >"${ss_none_fix}/README.md"
commit_all "$ss_none_fix"
prec_detect_profile "$ss_none_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" != *secret-scan* ]]; then
  pass_case 'plain repo: does not plan secret-scan'
else
  fail_case "plain repo: does not plan secret-scan (got ${planned})"
fi
rm -rf "$ss_none_fix"

printf '\n=== prec_run_secret_scan leak failure (stub gitleaks) ===\n'
ss_run_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-ss-run.XXXXXX")"
make_git_fixture "$ss_run_fix"
mkdir -p "${ss_run_fix}/.github/ci" "${ss_run_fix}/stub-bin"
cp "${script_dir}/../scripts/lib/ci-secret-scan" "${ss_run_fix}/.github/ci/secret-scan"
chmod +x "${ss_run_fix}/.github/ci/secret-scan"
(
  cd "$ss_run_fix"
  git add -A
  git commit -q -m 'add secret-scan'
  git branch -M main
  git checkout -q -b feat/leak
  # Intentionally fake credential pattern for gitleaks stub path only.
  printf 'aws_access_key_id = AKIAIOSFODNN7EXAMPLE\n' >leak.txt
  git add leak.txt
  git commit -q -m 'plant leak'
)
# shellcheck disable=SC2016  # stub body is literal; prints mitigation-compatible exit
cat >"${ss_run_fix}/stub-bin/gitleaks" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
printf 'leaks found\n' >&2
exit 1
STUB
chmod +x "${ss_run_fix}/stub-bin/gitleaks"
ss_run_out=""
ss_run_rc=0
ss_run_out="$(
  PATH="${ss_run_fix}/stub-bin:${PATH}" \
    prec_run_secret_scan "$ss_run_fix" 2>&1
)" || ss_run_rc=$?
if [[ "$ss_run_rc" -ne 0 ]] && grep -qF 'ERROR: SECRET_SCAN_LEAK' <<<"$ss_run_out"; then
  pass_case 'prec_run_secret_scan fails with SECRET_SCAN_LEAK mitigation on stub leak'
else
  fail_case "prec_run_secret_scan fails with SECRET_SCAN_LEAK (rc=${ss_run_rc} out=${ss_run_out})"
fi
rm -rf "$ss_run_fix"

printf '\n=== prec_run_repo_practices_lint execution ===\n'
exec_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-rp-exec.XXXXXX")"
make_git_fixture "$exec_fix"
mkdir -p "${exec_fix}/.github/workflows" "${exec_fix}/scripts"
printf 'name: ci\n' >"${exec_fix}/.github/workflows/ci.yml"
(
  cd "$exec_fix"
  git remote add origin 'git@github.com:the-hcma/mock-repo.git'
  git branch -M main
  git add -A
  git commit -q -m 'fixture'
  git checkout -q -b feat/workflow
  printf 'on: push\n' >>.github/workflows/ci.yml
)
cat >"${exec_fix}/scripts/github-repo-lint" <<'MOCK_LINT'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == --repo && "${2:-}" == the-hcma/mock-repo && "${3:-}" == --suggest && "${4:-}" == --strict-onboarding ]] \
  || { printf 'unexpected args: %s\n' "$*" >&2; exit 2; }
exit 0
MOCK_LINT
chmod +x "${exec_fix}/scripts/github-repo-lint"
if prec_run_repo_practices_lint "$exec_fix"; then
  pass_case 'prec_run_repo_practices_lint invokes local github-repo-lint with expected args'
else
  fail_case 'prec_run_repo_practices_lint invokes local github-repo-lint with expected args'
fi
mkdir -p "${exec_fix}/scripts/lib/repo-practices-cursor"
cat >"${exec_fix}/scripts/lib/repo-practices-cursor/org-rule.mdc" <<'EOF'
---
alwaysApply: true
---
EOF
(
  cd "$exec_fix"
  git add scripts/lib/repo-practices-cursor/org-rule.mdc
)
cat >"${exec_fix}/scripts/github-repo-lint" <<'MOCK_LINT_ORG'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == --org && "${2:-}" == the-hcma && "${3:-}" == --all \
  && "${4:-}" == --strict-onboarding && "${5:-}" == --compact ]] \
  || { printf 'unexpected org args: %s\n' "$*" >&2; exit 2; }
exit 0
MOCK_LINT_ORG
chmod +x "${exec_fix}/scripts/github-repo-lint"
if prec_run_repo_practices_lint "$exec_fix"; then
  pass_case 'prec_run_repo_practices_lint runs org audit when cursor-rule enforcement changes'
else
  fail_case 'prec_run_repo_practices_lint runs org audit when cursor-rule enforcement changes'
fi
cat >"${exec_fix}/scripts/github-repo-lint" <<'MOCK_LINT_FAIL'
#!/usr/bin/env bash
exit 1
MOCK_LINT_FAIL
chmod +x "${exec_fix}/scripts/github-repo-lint"
if ! prec_run_repo_practices_lint "$exec_fix"; then
  pass_case 'prec_run_repo_practices_lint propagates lint script failure'
else
  fail_case 'prec_run_repo_practices_lint propagates lint script failure'
fi
rm -rf "$exec_fix"

printf '\n=== help mentions detect-first / SKIP ===\n'
help_output=""
help_exit=0
help_output="$(bash "$pre_pr_checks" --help 2>&1)" || help_exit=$?
assert_exit_0 "ecosystem --help" "$help_output" "$help_exit"
assert_contains "ecosystem --help detect" "$help_output" "Detect-first"
assert_contains "ecosystem --help SKIP" "$help_output" "PRE_PR_CHECKS_SKIP"
assert_contains "ecosystem --help pytest-hermetic" "$help_output" "pytest-hermetic"
assert_contains "ecosystem --help --fix" "$help_output" "--fix"
assert_contains "ecosystem --help FORMAT env" "$help_output" "PRE_PR_CHECKS_FORMAT=apply"

printf '\n=== static: format apply before check (--fix) ===\n'
# shellcheck disable=SC2016  # assert literal helper / flag names in source
if grep -qF 'prec_apply_formatters' "$ecosystem_lib" \
  && grep -qF 'ruff format .' "$ecosystem_lib" \
  && grep -qF 'cargo fmt --all' "$ecosystem_lib" \
  && grep -qF 'prec_pr_format_apply' "$pre_pr_checks" \
  && grep -qF -- '--fix' "$pre_pr_checks" \
  && grep -qF 'PRE_PR_CHECKS_FORMAT' "$pre_pr_checks"; then
  pass_case 'pre-pr-checks wires --fix / PRE_PR_CHECKS_FORMAT=apply via prec_apply_formatters'
else
  fail_case 'pre-pr-checks missing format-apply wiring'
fi

# shellcheck disable=SC2016
if [[ -f "${rh_root}/.cursor/rules/pre-pr-checks.mdc" ]] \
  && grep -qF 'Apply formatters before check' "${rh_root}/.cursor/rules/pre-pr-checks.mdc" \
  && grep -qF 'No truncated pre-PR output' "${rh_root}/.cursor/rules/pre-pr-checks.mdc" \
  && [[ -f "${rh_root}/scripts/lib/repo-practices-cursor/pre-pr-checks.mdc" ]] \
  && grep -qF 'Apply formatters before check' \
    "${rh_root}/scripts/lib/repo-practices-cursor/pre-pr-checks.mdc" \
  && grep -qF 'Apply formatters before the gate' "${rh_root}/AGENTS.md" \
  && grep -qF 'PRE_PR_CHECKS_FORMAT=apply' \
    "${rh_root}/.cursor/skills/ship-and-review/SKILL.md"; then
  pass_case 'pre-pr-checks cursor rule + template + AGENTS/skill document format-before-check'
else
  fail_case 'pre-pr-checks rule/template/AGENTS/skill missing format-before-check guidance'
fi

# shellcheck disable=SC2016
if grep -qF 'rp_check_pre_pr_checks_rule' \
  "${rh_root}/scripts/lib/repo-practices" \
  && grep -qF 'rp_pre_pr_checks_rule_path' \
  "${rh_root}/scripts/lib/repo-practices" \
  && grep -qF 'repo-practices-cursor/pre-pr-checks.mdc' \
  "${rh_root}/scripts/lib/repo-practices"; then
  pass_case 'repo-practices audits/applies pre-pr-checks cursor rule template'
else
  fail_case 'repo-practices missing pre-pr-checks rule wiring'
fi

printf '\n=== prec_apply_formatters runtime (stub uv + cargo) ===\n'
fmt_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-fmt-apply.XXXXXX")"
make_git_fixture "$fmt_fix"
printf '[project]\nname = "fmt-fixture"\nversion = "0.0.0"\n' >"${fmt_fix}/pyproject.toml"
printf '[package]\nname = "fmt-fixture"\nversion = "0.0.0"\nedition = "2021"\n' \
  >"${fmt_fix}/Cargo.toml"
mkdir -p "${fmt_fix}/stub-bin" "${fmt_fix}/src"
printf 'fn main() {}\n' >"${fmt_fix}/src/main.rs"
commit_all "$fmt_fix"
fmt_log="${fmt_fix}/formatter-calls.log"
# shellcheck disable=SC2016  # stub records argv; FMT_LOG is expanded at write time
cat >"${fmt_fix}/stub-bin/uv" <<STUB_UV
#!/usr/bin/env bash
set -euo pipefail
printf 'uv %s\n' "\$*" >>"${fmt_log}"
exit 0
STUB_UV
cat >"${fmt_fix}/stub-bin/cargo" <<STUB_CARGO
#!/usr/bin/env bash
set -euo pipefail
printf 'cargo %s\n' "\$*" >>"${fmt_log}"
exit 0
STUB_CARGO
chmod +x "${fmt_fix}/stub-bin/uv" "${fmt_fix}/stub-bin/cargo"
prec_detect_profile "$fmt_fix"
fmt_rc=0
# Run in the current shell so prec_formatters_applied is visible to the harness.
PATH="${fmt_fix}/stub-bin:${PATH}" \
  prec_apply_formatters "$fmt_fix" >/dev/null 2>&1 || fmt_rc=$?
if [[ "$fmt_rc" -eq 0 ]] \
  && [[ "${prec_formatters_applied:-0}" -eq 1 ]] \
  && grep -qF 'uv run ruff format .' "$fmt_log" \
  && grep -qF 'cargo fmt --all' "$fmt_log"; then
  pass_case 'prec_apply_formatters runs stub uv ruff format + cargo fmt when planned'
else
  fail_case "prec_apply_formatters runtime (rc=${fmt_rc} applied=${prec_formatters_applied:-?} log=$(cat "$fmt_log" 2>/dev/null || true))"
fi
# Nothing planned → applied stays 0 and message on stderr
plain_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-fmt-plain.XXXXXX")"
make_git_fixture "$plain_fix"
printf 'readme\n' >"${plain_fix}/README.md"
commit_all "$plain_fix"
prec_detect_profile "$plain_fix"
plain_err="${plain_fix}/apply.err"
plain_rc=0
prec_apply_formatters "$plain_fix" >/dev/null 2>"$plain_err" || plain_rc=$?
if [[ "$plain_rc" -eq 0 ]] \
  && [[ "${prec_formatters_applied:-1}" -eq 0 ]] \
  && grep -qF 'nothing to apply' "$plain_err"; then
  pass_case 'prec_apply_formatters no-op when python-static/cargo-fmt not planned'
else
  fail_case "prec_apply_formatters no-op (rc=${plain_rc} applied=${prec_formatters_applied:-?} err=$(cat "$plain_err" 2>/dev/null || true))"
fi
rm -rf "$fmt_fix" "$plain_fix"

printf '\n=== static: verified-commits wiring ===\n'
# shellcheck disable=SC2016
if grep -qF 'pre-pr-verified-commits' "$ecosystem_lib" \
  && grep -qF 'pre_pr_verified_commits_should_plan' "$ecosystem_lib" \
  && grep -qF 'prec_run_verified_commits' "$ecosystem_lib" \
  && grep -qF 'verified-commits' "$pre_pr_checks" \
  && grep -qF 'PRE_PR_CHECKS_SKIP=verified-commits' "$pre_pr_checks" \
  && [[ -f "${rh_root}/scripts/lib/pre-pr-verified-commits" ]] \
  && grep -qF 'ERROR: UNVERIFIED_COMMIT' \
    "${rh_root}/scripts/lib/pre-pr-verified-commits"; then
  pass_case 'verified-commits detect-first wiring in ecosystem and pre-pr-checks'
else
  fail_case 'verified-commits wiring incomplete'
fi

printf '\n=== functional: verified-commits empty range / unsigned fail / SKIP ===\n'
vc_fix="$(mktemp -d "${TMPDIR:-/tmp}/prec-vc.XXXXXX")"
make_git_fixture "$vc_fix"
(
  cd "$vc_fix"
  git branch -M main
  printf 'a\n' >file.txt
  git add file.txt
  git commit -q -m 'base'
  # Detached origin/main simulation: local main is base; feature has an unsigned tip.
  git checkout -q -b feat/unsigned
  printf 'b\n' >>file.txt
  git add file.txt
  git -c commit.gpgsign=false commit -q --no-gpg-sign -m 'unsigned tip'
)
# Plan should include verified-commits (one commit ahead of main).
unset PRE_PR_CHECKS_SKIP
prec_detect_profile "$vc_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" == *verified-commits* ]]; then
  pass_case 'detect: commits ahead of main plans verified-commits'
else
  fail_case "detect: expected verified-commits in planned (got ${planned})"
fi

set +e
vc_fail_out="$(prec_run_verified_commits "$vc_fix" 2>&1)"
vc_fail_rc=$?
set -e
if [[ "$vc_fail_rc" -ne 0 ]] \
  && grep -qF 'ERROR: UNVERIFIED_COMMIT' <<<"$vc_fail_out" \
  && grep -qF 'reason=local' <<<"$vc_fail_out"; then
  pass_case 'run: unsigned commit fails with ERROR: UNVERIFIED_COMMIT reason=local'
else
  fail_case "run: unsigned should fail locally (rc=${vc_fail_rc}): ${vc_fail_out}"
fi

export PRE_PR_CHECKS_SKIP='verified-commits'
prec_detect_profile "$vc_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" != *verified-commits* ]]; then
  pass_case 'PRE_PR_CHECKS_SKIP=verified-commits removes job'
else
  fail_case "SKIP verified-commits still planned: ${planned}"
fi
unset PRE_PR_CHECKS_SKIP

# Empty range: on main with no ahead commits → should not plan.
(
  cd "$vc_fix"
  git checkout -q main
)
prec_detect_profile "$vc_fix"
planned="$(prec_format_planned_jobs)"
if [[ "$planned" != *verified-commits* ]]; then
  pass_case 'detect: no commits ahead of main does not plan verified-commits'
else
  fail_case "detect: empty range should not plan verified-commits (got ${planned})"
fi
rm -rf "$vc_fix"

# shellcheck disable=SC2016
if grep -qF 'Pre-submit verification' \
  "${rh_root}/.cursor/rules/git-commit-identity.mdc" \
  && grep -qF 'verified-commits' \
    "${rh_root}/.cursor/rules/git-commit-identity.mdc" \
  && grep -qF 'Pre-submit verification' \
    "${rh_root}/scripts/lib/repo-practices-cursor/git-commit-identity.mdc"; then
  pass_case 'git-commit-identity documents pre-submit verified-commits gate'
else
  fail_case 'git-commit-identity missing Pre-submit verification section'
fi

# shellcheck disable=SC2016
if ! grep -qE 'rev-list[[:space:]]+--first-parent' \
  "${rh_root}/scripts/lib/pre-pr-verified-commits" \
  && grep -qF 'rev-list --no-merges' \
  "${rh_root}/scripts/lib/pre-pr-verified-commits" \
  && grep -qF 'detail=rev-list failed' \
  "${rh_root}/scripts/lib/pre-pr-verified-commits"; then
  pass_case 'verified-commits: no first-parent; fail-closed on rev-list'
else
  fail_case 'verified-commits still uses first-parent or fail-open rev-list'
fi

# shellcheck disable=SC2016
if grep -qF 'unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP' "$ecosystem_lib" \
  && awk '
    /prec_run_verified_commits\(\)/ { in_fn=1 }
    in_fn && /unset RUNNER_SESSION_DIR/ { found=1; exit 0 }
    in_fn && /^}/ { exit 1 }
    END { exit !found }
  ' "$ecosystem_lib"; then
  pass_case 'prec_run_verified_commits isolates runner session like secret-scan'
else
  fail_case 'prec_run_verified_commits missing runner session isolation'
fi

printf '\n=== functional: bot author skip is not substring-broad ===\n'
if _pre_pr_verified_commits_author_is_bot 'dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>' \
  && _pre_pr_verified_commits_author_is_bot 'github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>' \
  && ! _pre_pr_verified_commits_author_is_bot 'Alice Abot <alice@example.com>' \
  && ! _pre_pr_verified_commits_author_is_bot 'Bob <dependable@example.com>'; then
  pass_case 'bot skip matches [bot]/dependabot names, not substrings'
else
  fail_case 'bot author skip matching too broad or too narrow'
fi

printf '\n=== summary ===\n'
printf 'passed: %d  failed: %d\n' "$pass" "$fail"
# assert_* helpers use the same pass/fail counters (test_init / pass_case / fail_case).
if (( fail > 0 )); then
  exit 1
fi
