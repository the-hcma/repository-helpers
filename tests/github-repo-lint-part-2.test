#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices — part 2 of 6.
# Split from the former aa-github-repo-lint.test so CI can run the parts in parallel (#692).
# To add a test, read the how-to at the top of tests/lib/github-repo-lint-part-init first.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck source=tests/lib/github-repo-lint-part-init
source "${script_dir}/lib/github-repo-lint-part-init"

pass=0
fail=0

printf '\n=== functional: full check fails without license or copyright ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/repository-helpers/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/README.md'* ]]; then
  printf '%s\n' '{"content":"IyBSZXBvc2l0b3J5Cg=="}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_LOCAL_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/repository-helpers --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'license file' <<<"$output" \
  && grep -qF 'copyright notice' <<<"$output" \
  && grep -qF 'CODEOWNERS' <<<"$output" \
  && grep -qF 'pr-ship-and-review agents rule' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] metadata: missing license, copyright, CODEOWNERS, and pr-ship rule fail with suggestions\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] license-metadata: expected license/copyright failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: CODEOWNERS apply creates a PR ===\n'
if grep -qF 'rp_apply_codeowners_pr' "$lib" \
  && grep -qF 'gh pr create' "$lib" \
  && grep -qF 'rp_authenticated_github_login' "$lib" \
  && grep -qF "* @\${login}" "$lib" \
  && grep -qF 'repo-practices/add-codeowners' "$lib"; then
  printf '[PASS] codeowners-apply: --apply-fix creates a PR with authenticated user as owner\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] codeowners-apply: missing PR-based CODEOWNERS remediation\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: strict onboarding fails without GitHub MQ ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'repos/'*'/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_LOCAL_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/new-service --strict-onboarding 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'missing .github/workflows/ci.yml (required for GitHub merge queue checks)' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] strict-onboarding: missing GitHub MQ wiring fails with remediation hint\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] strict-onboarding: expected missing ci.yml/merge_group failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: GitHub API errors are not missing merge_queue ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/flaky-service/labels'* ]]; then
  printf 'gh: API rate limit exceeded\n' >&2
  exit 1
fi
if [[ "$args" == *'repos/the-hcma/flaky-service/rulesets'* ]]; then
  printf 'gh: API rate limit exceeded\n' >&2
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(
  PATH="${mock_bin}:${PATH}" \
    GITHUB_API_RATE_LIMIT_MAX_RETRIES=1 \
    GITHUB_API_RATE_LIMIT_MAX_WAIT_S=0 \
    bash "$checker" \
    --repo the-hcma/flaky-service --strict-onboarding 2>&1
)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'GitHub API:' <<<"$output" \
  && grep -qE 'could not (read protect-main ruleset|determine whether protect-main is required)' <<<"$output" \
  && ! grep -qF 'protect-main must include a merge_queue rule' <<<"$output" \
  && ! grep -qF 'ci.yml must trigger on merge_group for GitHub merge queue' <<<"$output"; then
  printf '[PASS] gh-api-error: ruleset API failure is not reported as missing merge_queue\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-api-error: expected GitHub API error not missing merge_queue (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== unit: protect-main required_signatures — probe + payload + patcher (repository-helpers#609) ===\n'
rs_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    with_sig='"'"'{"rules":[{"type":"merge_queue"},{"type":"required_signatures"}]}'"'"'
    without_sig='"'"'{"rules":[{"type":"merge_queue"}]}'"'"'
    rp_ruleset_requires_signatures "$with_sig" && printf "probe_with=0\n" || printf "probe_with=1\n"
    rp_ruleset_requires_signatures "$without_sig" && printf "probe_without=0\n" || printf "probe_without=1\n"
    rp_protect_main_create_payload | /usr/bin/jq -e "[.rules[].type] | index(\"required_signatures\") != null" >/dev/null \
      && printf "payload_has_sig=yes\n" || printf "payload_has_sig=no\n"
  ' bash "$lib"
)"
if grep -qxF 'probe_with=0' <<<"$rs_out" \
  && grep -qxF 'probe_without=1' <<<"$rs_out" \
  && grep -qxF 'payload_has_sig=yes' <<<"$rs_out"; then
  printf '[PASS] required_signatures: probe distinguishes the rule; create payload carries it\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] required_signatures probe/payload wrong\n%s\n' "$rs_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_validate_ruleset_required_signatures — routine SUGGESTs, strict/new-repo FAIL (repository-helpers#609) ===\n'
rs_val="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_log_fail() { printf "FAIL:%s\n" "$1" >&2; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    without_sig='"'"'{"rules":[{"type":"merge_queue"}]}'"'"'
    with_sig='"'"'{"rules":[{"type":"merge_queue"},{"type":"required_signatures"}]}'"'"'
    run() { local e=0; rp_validate_ruleset_required_signatures "the-hcma/x" "$1" 2>&1 || e=$?; printf "rc=%s\n" "$e"; }

    printf -- "--- routine (no strict), missing, no --suggest ---\n"
    rp_suggest=0; rp_strict_onboarding=0; rp_new_repo=0
    run "$without_sig"
    printf -- "--- routine --suggest, missing ---\n"
    rp_suggest=1
    run "$without_sig"
    printf -- "--- strict, missing ---\n"
    rp_suggest=0; rp_strict_onboarding=1; rp_new_repo=0
    run "$without_sig"
    printf -- "--- new-repo, missing ---\n"
    rp_strict_onboarding=0; rp_new_repo=1
    run "$without_sig"
    printf -- "--- strict, present ---\n"
    rp_strict_onboarding=1; rp_new_repo=0
    run "$with_sig"
    printf -- "--- empty ruleset json ---\n"
    run ""
  ' bash "$lib"
)"
if [[ "$(grep -c 'rc=0' <<<"$rs_val")" == 4 ]] \
  && [[ "$(grep -c 'rc=1' <<<"$rs_val")" == 2 ]] \
  && [[ "$(grep -c 'SUGGEST:' <<<"$rs_val")" == 1 ]] \
  && [[ "$(grep -c 'FAIL:the-hcma/x: protect-main must include a required_signatures rule' <<<"$rs_val")" == 2 ]]; then
  printf '[PASS] rp_validate_ruleset_required_signatures: routine SUGGEST-only (rc 0); strict / new-repo FAIL (rc 1); present + empty pass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_validate_ruleset_required_signatures ratchet wrong\n%s\n' "$rs_val"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: protect-main require_code_owner_review — probe + create payload + org-admin bypass (repository-helpers#626) ===\n'
cor_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    with='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":true}}],"bypass_actors":[{"actor_id":1,"actor_type":"OrganizationAdmin","bypass_mode":"pull_request"}]}'"'"'
    # GitHub normalises the org-admin actor_id to null on ruleset GET.
    with_null_id='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":true}}],"bypass_actors":[{"actor_id":null,"actor_type":"OrganizationAdmin","bypass_mode":"pull_request"}]}'"'"'
    # bypass_mode "always" also bypasses required_signatures on a direct push (#609) -> not a valid bypass.
    with_always='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":true}}],"bypass_actors":[{"actor_id":null,"actor_type":"OrganizationAdmin","bypass_mode":"always"}]}'"'"'
    without='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":false}}],"bypass_actors":[]}'"'"'
    rp_ruleset_requires_code_owner_review "$with" && printf "cor_with=0\n" || printf "cor_with=1\n"
    rp_ruleset_requires_code_owner_review "$without" && printf "cor_without=0\n" || printf "cor_without=1\n"
    rp_ruleset_has_org_admin_bypass "$with" && printf "bypass_with=0\n" || printf "bypass_with=1\n"
    rp_ruleset_has_org_admin_bypass "$with_null_id" && printf "bypass_null_id=0\n" || printf "bypass_null_id=1\n"
    rp_ruleset_has_org_admin_bypass "$with_always" && printf "bypass_always=0\n" || printf "bypass_always=1\n"
    rp_ruleset_has_org_admin_bypass "$without" && printf "bypass_without=0\n" || printf "bypass_without=1\n"
    p="$(rp_protect_main_create_payload)"
    printf %s "$p" | /usr/bin/jq -e "([.rules[]|select(.type==\"pull_request\")|.parameters.require_code_owner_review]|first)==true" >/dev/null \
      && printf "payload_rule=yes\n" || printf "payload_rule=no\n"
    printf %s "$p" | /usr/bin/jq -e "[.bypass_actors[]|select(.actor_type==\"OrganizationAdmin\" and .actor_id==1 and .bypass_mode==\"pull_request\")]|length==1" >/dev/null \
      && printf "payload_bypass=yes\n" || printf "payload_bypass=no\n"
    rp_github_mq_ruleset_org_compliant "$p" && printf "compliant_fresh=0\n" || printf "compliant_fresh=1\n"
    rp_github_mq_ruleset_org_compliant "'"'"'{"rules":[{"type":"merge_queue","parameters":{"merge_method":"SQUASH","check_response_timeout_minutes":15}},{"type":"required_signatures"},{"type":"pull_request","parameters":{"require_code_owner_review":false}}],"bypass_actors":[]}'"'"'" \
      && printf "compliant_norule=0\n" || printf "compliant_norule=1\n"
  ' bash "$lib"
)"
if grep -qxF 'cor_with=0' <<<"$cor_out" \
  && grep -qxF 'cor_without=1' <<<"$cor_out" \
  && grep -qxF 'bypass_with=0' <<<"$cor_out" \
  && grep -qxF 'bypass_null_id=0' <<<"$cor_out" \
  && grep -qxF 'bypass_always=1' <<<"$cor_out" \
  && grep -qxF 'bypass_without=1' <<<"$cor_out" \
  && grep -qxF 'payload_rule=yes' <<<"$cor_out" \
  && grep -qxF 'payload_bypass=yes' <<<"$cor_out" \
  && grep -qxF 'compliant_fresh=0' <<<"$cor_out" \
  && grep -qxF 'compliant_norule=1' <<<"$cor_out"; then
  printf '[PASS] require_code_owner_review: probes distinguish; create payload carries rule + OrganizationAdmin bypass; compliance requires both\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] require_code_owner_review probe/payload/compliance wrong\n%s\n' "$cor_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_validate_ruleset_code_owner_review — ratchet + always-FAIL on rule-without-bypass (repository-helpers#626) ===\n'
cor_val="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_log_fail() { printf "FAIL:%s\n" "$1" >&2; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    without='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":false}}],"bypass_actors":[]}'"'"'
    rule_no_bypass='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":true}}],"bypass_actors":[]}'"'"'
    rule_always_bypass='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":true}}],"bypass_actors":[{"actor_id":null,"actor_type":"OrganizationAdmin","bypass_mode":"always"}]}'"'"'
    full='"'"'{"rules":[{"type":"pull_request","parameters":{"require_code_owner_review":true}}],"bypass_actors":[{"actor_id":null,"actor_type":"OrganizationAdmin","bypass_mode":"pull_request"}]}'"'"'
    run() { local e=0; rp_validate_ruleset_code_owner_review "the-hcma/x" "$1" 2>&1 || e=$?; printf "rc=%s\n" "$e"; }

    printf -- "--- routine, rule absent, no --suggest ---\n"
    rp_suggest=0; rp_strict_onboarding=0; rp_new_repo=0
    run "$without"
    printf -- "--- routine --suggest, rule absent ---\n"
    rp_suggest=1
    run "$without"
    printf -- "--- strict, rule absent ---\n"
    rp_suggest=0; rp_strict_onboarding=1; rp_new_repo=0
    run "$without"
    printf -- "--- new-repo, rule absent ---\n"
    rp_strict_onboarding=0; rp_new_repo=1
    run "$without"
    printf -- "--- routine (no strict), rule present but no bypass ---\n"
    rp_suggest=0; rp_strict_onboarding=0; rp_new_repo=0
    run "$rule_no_bypass"
    printf -- "--- routine (no strict), rule present but bypass_mode always ---\n"
    run "$rule_always_bypass"
    printf -- "--- strict, rule + pull_request bypass present ---\n"
    rp_strict_onboarding=1
    run "$full"
    printf -- "--- empty ruleset json ---\n"
    run ""
  ' bash "$lib"
)"
if [[ "$(grep -c "rc=0" <<<"$cor_val")" == 4 ]] \
  && [[ "$(grep -c "rc=1" <<<"$cor_val")" == 4 ]] \
  && [[ "$(grep -c "SUGGEST:" <<<"$cor_val")" == 1 ]] \
  && [[ "$(grep -c "FAIL:the-hcma/x: protect-main requires CODEOWNER review with no OrganizationAdmin bypass" <<<"$cor_val")" == 2 ]] \
  && [[ "$(grep -c "FAIL:the-hcma/x: protect-main pull_request rule must set require_code_owner_review" <<<"$cor_val")" == 2 ]]; then
  printf '[PASS] rp_validate_ruleset_code_owner_review: routine SUGGEST-only; strict / new-repo FAIL; rule without pull_request bypass FAILs always; full + empty pass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_validate_ruleset_code_owner_review ratchet wrong\n%s\n' "$cor_val"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_apply_protect_main_github_mq_shape — adds require_code_owner_review + OrganizationAdmin bypass, idempotent (repository-helpers#626) ===\n'
cor_patch="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_log_warn() { :; }
    # Seed a stale Graphite Integration bypass AND an "always"-mode OrganizationAdmin
    # bypass — the patcher must strip the first and rewrite the second to pull_request.
    existing='"'"'{"name":"protect-main","target":"branch","enforcement":"active","conditions":{"ref_name":{"include":["refs/heads/main"],"exclude":[]}},"bypass_actors":[{"actor_id":158384,"actor_type":"Integration","bypass_mode":"always"},{"actor_id":null,"actor_type":"OrganizationAdmin","bypass_mode":"always"}],"rules":[{"type":"deletion"},{"type":"non_fast_forward"},{"type":"pull_request","parameters":{"allowed_merge_methods":["squash"],"require_code_owner_review":false}},{"type":"merge_queue","parameters":{"merge_method":"SQUASH","check_response_timeout_minutes":15}}]}'"'"'
    cur="$existing"
    rp_runner_gh_api_stream() {
      case "$1" in
        *"ruleset id"*) printf "12345" ;;
        *) printf %s "$cur" ;;
      esac
    }
    rp_runner_gh_api_input() {
      # args: label payload -X PUT path
      cur="$2"
    }
    rp_fetch_protect_main_ruleset() { printf %s "$cur"; }

    rp_apply_protect_main_github_mq_shape "the-hcma/x"
    printf %s "$cur" | /usr/bin/jq -e "([.rules[]|select(.type==\"pull_request\")|.parameters.require_code_owner_review]|first)==true" >/dev/null && printf "rule=yes\n" || printf "rule=no\n"
    printf %s "$cur" | /usr/bin/jq -e "[.bypass_actors[]|select(.actor_type==\"OrganizationAdmin\" and .bypass_mode==\"pull_request\")]|length==1" >/dev/null && printf "admin=yes\n" || printf "admin=no\n"
    printf %s "$cur" | /usr/bin/jq -e "[.bypass_actors[]|select(.actor_type==\"OrganizationAdmin\" and .bypass_mode==\"always\")]|length==0" >/dev/null && printf "no_always=yes\n" || printf "no_always=no\n"
    printf %s "$cur" | /usr/bin/jq -e "[.bypass_actors[]|select(.actor_type==\"Integration\")]|length==0" >/dev/null && printf "no_integration=yes\n" || printf "no_integration=no\n"
    printf %s "$cur" | /usr/bin/jq -e "[.bypass_actors[]|select(.actor_id==158384)]|length==0" >/dev/null && printf "graphite_gone=yes\n" || printf "graphite_gone=no\n"

    # second pass must not duplicate actors
    rp_apply_protect_main_github_mq_shape "the-hcma/x"
    printf %s "$cur" | /usr/bin/jq -e ".bypass_actors|length==1" >/dev/null && printf "idempotent=yes\n" || printf "idempotent=no\n"
  ' bash "$lib"
)"
if grep -qxF 'rule=yes' <<<"$cor_patch" \
  && grep -qxF 'admin=yes' <<<"$cor_patch" \
  && grep -qxF 'no_always=yes' <<<"$cor_patch" \
  && grep -qxF 'no_integration=yes' <<<"$cor_patch" \
  && grep -qxF 'graphite_gone=yes' <<<"$cor_patch" \
  && grep -qxF 'idempotent=yes' <<<"$cor_patch"; then
  printf '[PASS] rp_apply_protect_main_github_mq_shape: adds rule, rewrites always->pull_request, strips Graphite, idempotent\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_apply_protect_main_github_mq_shape code-owner-review patch wrong\n%s\n' "$cor_patch"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_check_main_commit_verification — verified / bot / API error / rollout ratchet (repository-helpers#609) ===\n'
mcv_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_log_fail() { printf "FAIL:%s\n" "$1" >&2; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    rp_log_check_ok() { printf "OK:%s\n" "$2" >&2; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_gh_api_fail() { printf "GH_API_FAIL:%s\n" "$2" >&2; }
    rp_github_url() { printf "u\n"; }
    rp_apply_fix=0

    # One call: repos/{slug}/commits. MCV_FAIL forces it to error; MCV_TSV is the
    # parsed .[0] row (sha, verified, reason, author_login).
    mk() {
      eval "rp_runner_gh_api_stream() {
        [[ -n \"\$MCV_FAIL\" ]] && return 1
        printf %s \"\$MCV_TSV\"
      }"
    }
    mk
    run() { local e=0; rp_check_main_commit_verification "the-hcma/x" 2>&1 || e=$?; printf "rc=%s\n" "$e"; }

    printf -- "--- verified (--suggest) ---\n"
    MCV_FAIL=""; MCV_TSV=$(printf "abc123\ttrue\t\tsomeone"); rp_suggest=1; rp_strict_onboarding=0; rp_new_repo=0
    run
    printf -- "--- plain routine (all flags off) is skipped silently ---\n"
    MCV_TSV=$(printf "abc123\tfalse\tbad_email\tsomeone"); rp_suggest=0
    run
    printf -- "--- unverified, --suggest only (routine) -> SUGGEST, rc 0 ---\n"
    rp_suggest=1
    run
    printf -- "--- unverified, --strict-onboarding -> FAIL ---\n"
    rp_suggest=0; rp_strict_onboarding=1
    run
    printf -- "--- unverified, --new-repo -> FAIL ---\n"
    rp_strict_onboarding=0; rp_new_repo=1
    run
    printf -- "--- unverified bot author, --new-repo -> skipped OK ---\n"
    MCV_TSV=$(printf "abc123\tfalse\tunsigned\tdependabot[bot]")
    run
    printf -- "--- gh api failure, --new-repo -> fatal ---\n"
    MCV_FAIL=1; MCV_TSV=""
    run
    printf -- "--- gh api failure, --suggest only -> retry SUGGEST, rc 0 ---\n"
    rp_new_repo=0; rp_suggest=1
    run
  ' bash "$lib"
)"
if [[ "$(grep -c 'rc=0' <<<"$mcv_out")" == 5 ]] \
  && [[ "$(grep -c 'rc=1' <<<"$mcv_out")" == 3 ]] \
  && [[ "$(grep -c 'SUGGEST:' <<<"$mcv_out")" == 2 ]] \
  && [[ "$(grep -c 'FAIL:the-hcma/x: main HEAD abc123 is not a verified commit' <<<"$mcv_out")" == 2 ]] \
  && grep -qF 'OK:main HEAD commit verification (skipped: bot author dependabot[bot])' <<<"$mcv_out" \
  && grep -qF 'SUGGEST:the-hcma/x: retry main HEAD commit verification after GitHub API recovers' <<<"$mcv_out" \
  && grep -qF 'GH_API_FAIL:could not read main HEAD commit verification' <<<"$mcv_out"; then
  printf '[PASS] rp_check_main_commit_verification: verified/bot handled; strict/new-repo FAIL; routine --suggest SUGGEST-only; API error fatal only under strict/new-repo; plain routine skipped\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_main_commit_verification ratchet wrong\n%s\n' "$mcv_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: git context audits only current repo ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
