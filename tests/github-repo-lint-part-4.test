#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices — part 4 of 6.
# Split from the former aa-github-repo-lint.test so CI can run the parts in parallel (#692).
# To add a test, read the how-to at the top of tests/lib/github-repo-lint-part-init first.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck source=tests/lib/github-repo-lint-part-init
source "${script_dir}/lib/github-repo-lint-part-init"

pass=0
fail=0

printf '\n=== functional: missing stacking-tool marker fails with suggestion ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/example-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_CONSUMER_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.github/stacking-tool'* ]]; then
  exit 1
fi
if [[ "$args" == *'contents/.agents/rules/stacking-tool.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_RULE_CONSUMER_B64}\"}"
  exit 0
fi
if [[ "$args" == *'stacking-tool.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_RULE_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/read-agents-and-rules.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_READ_AGENTS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'read-agents-and-rules.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_READ_AGENTS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/git-commit-identity.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_GIT_COMMIT_IDENTITY_B64}\"}"
  exit 0
fi
if [[ "$args" == *'git-commit-identity.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_GIT_COMMIT_IDENTITY_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/no-secret-exposure.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_NO_SECRET_EXPOSURE_B64}\"}"
  exit 0
fi
if [[ "$args" == *'no-secret-exposure.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_NO_SECRET_EXPOSURE_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/remote-timeouts-retries.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_REMOTE_TIMEOUTS_RETRIES_B64}\"}"
  exit 0
fi
if [[ "$args" == *'remote-timeouts-retries.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_REMOTE_TIMEOUTS_RETRIES_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/repo-practices-after-config-change.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_RP_AFTER_CONFIG_B64}\"}"
  exit 0
fi
if [[ "$args" == *'repo-practices-after-config-change.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_RP_AFTER_CONFIG_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/example-repo --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'stacking-tool marker (.github/stacking-tool)' <<<"$output" \
  && grep -qF "add .github/stacking-tool with 'graphite' or 'gh-stack'" <<<"$output"; then
  printf '[PASS] stacking-tool: missing marker fails with clear suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stacking-tool: expected missing-marker failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: stacking docs consistency helpers ===\n'
graphite_only_pr_ship="$(cat <<'EOF'
## 2. Commit and submit
gt create <stack>/<topic> -m 'feat: …'
gt submit --publish --no-interactive
EOF
)"
aligned_pr_ship="$(cat <<'EOF'
## 2. Commit and submit
# Read .github/stacking-tool
gt create <stack>/<topic> -m 'feat: …'
gt submit --publish --no-interactive
gh stack init <stack>/<topic>
gh stack submit --auto --open --remote origin
EOF
)"
comment_only_gh_stack_pr_ship="$(cat <<'EOF'
## 2. Commit and submit
gt create <stack>/<topic> -m 'feat: …'
gt submit --publish --no-interactive
# gh stack init <stack>/<topic>
# gh stack submit --auto --open --remote origin
EOF
)"
bad_agents="$(cat <<'EOF'
- This project uses Graphite (gt) for branch stacking.
- Submit with gt submit --no-interactive --publish.
- To merge, add the merge-it label.
EOF
)"
good_agents="$(cat <<'EOF'
- This project uses GitHub Stacked PRs (gh stack).
- Prefer gh stack init / gh stack submit.
- Do not use Graphite (gt) or the merge-it label.
EOF
)"
gh_stack_only_docs=$'Use gh stack init\n'
gh_stack_and_gt_docs=$'Use gh stack or gt create\n'
gh_stack_negation_with_bare_gt=$'Use gt for stacking. Do not use gh stack.\n'
merge_it_only_agents=$'- To merge, add the merge-it label.\n'
merge_it_forbid_agents=$'- Do not use merge-it — merge via gh pr merge --auto --squash\n'
gt_forbid_agents=$'- Do not use gt create or gt submit — use gh stack submit\n- Prefer gh stack init\n'
if bash -c "source '${lib}'
  rp_pr_ship_has_graphite_only_submit_snippet \"\$1\"
" _ "$graphite_only_pr_ship" \
  && ! bash -c "source '${lib}'
  rp_pr_ship_has_graphite_only_submit_snippet \"\$1\"
" _ "$aligned_pr_ship" \
  && bash -c "source '${lib}'
  rp_pr_ship_has_graphite_only_submit_snippet \"\$1\"
" _ "$comment_only_gh_stack_pr_ship" \
  && bash -c "source '${lib}'
  rp_agents_md_prescribes_graphite_primary_stacking \"\$1\"
" _ "$bad_agents" \
  && ! bash -c "source '${lib}'
  rp_agents_md_prescribes_graphite_primary_stacking \"\$1\"
" _ "$good_agents" \
  && bash -c "source '${lib}'
  rp_agents_md_prescribes_graphite_primary_stacking \"\$1\"
" _ "$merge_it_only_agents" \
  && ! bash -c "source '${lib}'
  rp_agents_md_prescribes_graphite_primary_stacking \"\$1\"
" _ "$merge_it_forbid_agents" \
  && ! bash -c "source '${lib}'
  rp_agents_md_prescribes_graphite_primary_stacking \"\$1\"
" _ "$gt_forbid_agents" \
  && bash -c "source '${lib}'
  rp_docs_prescribe_gh_stack_without_graphite \"\$1\"
" _ "$gh_stack_only_docs" \
  && ! bash -c "source '${lib}'
  rp_docs_prescribe_gh_stack_without_graphite \"\$1\"
" _ "$gh_stack_and_gt_docs" \
  && ! bash -c "source '${lib}'
  rp_docs_prescribe_gh_stack_without_graphite \"\$1\"
" _ "$gh_stack_negation_with_bare_gt"; then
  printf '[PASS] stacking docs helpers: detect Graphite-only vs aligned docs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stacking docs helpers: predicate mismatch\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: pr-ship marker resolver prefers GitHub over local clone ===\n'
marker_mock_dir="$(mktemp -d)"
marker_mock_bin="${marker_mock_dir}/bin"
mkdir -p "$marker_mock_bin" "$marker_mock_dir/scan/example-repo/.github"
printf 'graphite\n' >"$marker_mock_dir/scan/example-repo/.github/stacking-tool"
git -C "$marker_mock_dir/scan/example-repo" init -q
git -C "$marker_mock_dir/scan/example-repo" remote add origin "https://github.com/the-hcma/example-repo.git"
export RUNNER_SESSION_ROOT="${marker_mock_dir}/runner-sessions"
cat >"${marker_mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'contents/.github/stacking-tool'* ]]; then
  printf '%s\n' '{"content":"Z2gtc3RhY2sK"}'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${marker_mock_bin}/gh"
cat >"${marker_mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${marker_mock_bin}/jq"
marker_resolver_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    source "$2"
    export PATH="$3:${PATH}"
    export GITHUB_REPO_LINT_SCAN_ROOT="$4/scan"
    export RP_GH_API_MAX_ATTEMPTS=1
    export RP_GH_API_RETRY_SLEEP_SECS=0
    marker_ec=0
    marker="$(rp_pr_ship_stacking_marker_for_slug the-hcma/example-repo)" || marker_ec=$?
    if (( marker_ec != 0 )); then
      printf "unexpected_ec=%s\n" "$marker_ec"
      exit 1
    fi
    if [[ "$marker" != gh-stack ]]; then
      printf "marker=%s\n" "$marker"
      exit 1
    fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib" "$marker_mock_bin" "$marker_mock_dir"
)" || marker_resolver_out="fail:${marker_resolver_out}"
rm -rf "$marker_mock_dir"
unset RUNNER_SESSION_ROOT
if [[ "$marker_resolver_out" == 'ok' ]]; then
  printf '[PASS] pr-ship marker resolver: GitHub marker wins over local defaults\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-ship marker resolver: GitHub-first resolution (%s)\n' "$marker_resolver_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: pr-ship marker resolver fails on GitHub API error ===\n'
marker_api_err_dir="$(mktemp -d)"
marker_api_err_bin="${marker_api_err_dir}/bin"
mkdir -p "$marker_api_err_bin"
export RUNNER_SESSION_ROOT="${marker_api_err_dir}/runner-sessions"
cat >"${marker_api_err_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
printf 'gh: HTTP 503: unavailable\n' >&2
exit 1
MOCK_GH
chmod +x "${marker_api_err_bin}/gh"
cat >"${marker_api_err_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${marker_api_err_bin}/jq"
marker_api_err_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    source "$2"
    export PATH="$3:${PATH}"
    export RP_GH_API_MAX_ATTEMPTS=1
    export RP_GH_API_RETRY_SLEEP_SECS=0
    marker_ec=0
    marker="$(rp_pr_ship_stacking_marker_for_slug the-hcma/example-repo)" || marker_ec=$?
    if (( marker_ec == 2 )) && [[ -z "$marker" ]]; then
      printf "ok\n"
      exit 0
    fi
    printf "ec=%s marker=%s\n" "$marker_ec" "$marker"
    exit 1
  ' bash "$runner_bootstrap" "$lib" "$marker_api_err_bin"
)" || marker_api_err_out="fail:${marker_api_err_out}"
rm -rf "$marker_api_err_dir"
unset RUNNER_SESSION_ROOT
if [[ "$marker_api_err_out" == 'ok' ]]; then
  printf '[PASS] pr-ship marker resolver: GitHub API error returns exit 2\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-ship marker resolver: expected fetch_ec=2 (%s)\n' "$marker_api_err_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: stacking docs predicates use runner grep probes ===\n'
if grep -qF 'rp_text_probe_grep_f' "$lib" \
  && grep -qF 'rp_text_probe_grep_iE' "$lib" \
  && grep -qF 'runner_exec' "$lib" \
  && grep -qF 'fetch_ec == 2' "$lib" \
  && awk '
    /^rp_pr_ship_stacking_marker_for_slug\(\)/ { in_fn=1 }
    in_fn && /rp_fetch_github_text_file/ { gh_first=1 }
    in_fn && /rp_resolve_local_repo_dir/ { local_after=1 }
    in_fn && /^}/ {
      if (gh_first && local_after) { exit 0 }
      exit 1
    }
    END { if (!in_fn) exit 1 }
  ' "$lib"; then
  printf '[PASS] stacking docs: runner grep probes and GitHub-first marker resolver\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stacking docs: missing runner grep probes or GitHub-first marker\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: pr-ship apply-fix template matches stacking-tool marker ===\n'
pr_ship_marker_unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    graphite_rendered="$(rp_pr_ship_and_review_rule_template_for_marker "$2")"
    gh_stack_rendered="$(rp_pr_ship_and_review_rule_template_for_marker "$3")"
    if ! rp_pr_ship_has_graphite_only_submit_snippet "$graphite_rendered"; then
      printf "graphite_template_not_graphite_only\n"
      exit 1
    fi
    if rp_pr_ship_has_graphite_only_submit_snippet "$gh_stack_rendered"; then
      printf "gh_stack_template_still_graphite_only\n"
      exit 1
    fi
    if ! grep -qE "^gt create " <<<"$graphite_rendered" \
      || ! grep -qE "^# gh stack init" <<<"$graphite_rendered"; then
      printf "graphite_template_submit_block\n"
      exit 1
    fi
    if ! grep -qE "^# gt create " <<<"$gh_stack_rendered" \
      || ! grep -qE "^gh stack init" <<<"$gh_stack_rendered" \
      || ! grep -qE "^gh stack submit" <<<"$gh_stack_rendered"; then
      printf "gh_stack_template_submit_block\n"
      exit 1
    fi
    if ! rp_pr_ship_and_review_rule_is_valid "$graphite_rendered" "the-hcma/example-repo" \
      || ! rp_pr_ship_and_review_rule_is_valid "$gh_stack_rendered" "the-hcma/example-repo"; then
      printf "rendered_template_invalid\n"
      exit 1
    fi
    printf "ok\n"
  ' bash "$lib" graphite gh-stack
)" || pr_ship_marker_unit_out="fail:${pr_ship_marker_unit_out}"
if [[ "$pr_ship_marker_unit_out" == 'ok' ]]; then
  printf '[PASS] pr-ship apply-fix: gh-stack marker uncomments gh stack submit lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-ship apply-fix: marker-aware template render (%s)\n' \
    "$pr_ship_marker_unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gh-stack marker with Graphite-only docs fails ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

grl_graphite_only_pr_ship_b64="$(printf '%s' "$graphite_only_pr_ship"$'\n'"wait-for-agent-review"$'\n'"reply-thread"$'\n'"resolve-thread"$'\n'"<!-- pr-ship-canonical-skill: https://github.com/the-hcma/repository-helpers/blob/main/.agents/skills/ship-and-review/SKILL.md -->"$'\n'"REPOSITORY_HELPERS_DIR" | base64 -w0)"
grl_bad_agents_b64="$(printf '%s' "$bad_agents" | base64 -w0)"
grl_graphite_md_b64="$(printf '%s' '# Graphite\nUse gt create' | base64 -w0)"

cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "\$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "\$args" == *'repos/the-hcma/example-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "\$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "\$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${grl_graphite_only_pr_ship_b64}\"}"
  exit 0
fi
if [[ "\$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.github/stacking-tool'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_MARKER_GH_STACK_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/stacking-tool.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_RULE_CONSUMER_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'stacking-tool.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_RULE_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/AGENTS.md'* ]]; then
  printf '%s\n' "{\"content\":\"${grl_bad_agents_b64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/GRAPHITE.md'* ]]; then
  printf '%s\n' "{\"content\":\"${grl_graphite_md_b64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/read-agents-and-rules.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_READ_AGENTS_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'read-agents-and-rules.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_READ_AGENTS_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/git-commit-identity.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_GIT_COMMIT_IDENTITY_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'git-commit-identity.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_GIT_COMMIT_IDENTITY_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/no-secret-exposure.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_NO_SECRET_EXPOSURE_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'no-secret-exposure.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_NO_SECRET_EXPOSURE_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/remote-timeouts-retries.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_REMOTE_TIMEOUTS_RETRIES_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'remote-timeouts-retries.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_REMOTE_TIMEOUTS_RETRIES_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/repo-practices-after-config-change.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_RP_AFTER_CONFIG_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'repo-practices-after-config-change.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_RP_AFTER_CONFIG_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/example-repo --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'Graphite-only gt create/gt submit' <<<"$output" \
  && grep -qF 'AGENTS.md still prescribes Graphite' <<<"$output" \
  && grep -qF 'root GRAPHITE.md still present' <<<"$output" \
  && grep -qF 'replace .agents/rules/pr-ship-and-review.md with the marker-aware template' <<<"$output" \
  && grep -qF 'delete GRAPHITE.md' <<<"$output"; then
  printf '[PASS] stacking docs: gh-stack marker fails on Graphite leftover docs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stacking docs: expected Graphite leftover failures (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: gh-stack marker with aligned docs passes consistency ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

grl_aligned_pr_ship_b64="$(printf '%s' "$aligned_pr_ship"$'\n'"wait-for-agent-review"$'\n'"reply-thread"$'\n'"resolve-thread"$'\n'"<!-- pr-ship-canonical-skill: https://github.com/the-hcma/repository-helpers/blob/main/.agents/skills/ship-and-review/SKILL.md -->"$'\n'"REPOSITORY_HELPERS_DIR" | base64 -w0)"
grl_good_agents_b64="$(printf '%s' "$good_agents" | base64 -w0)"

cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "\$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
