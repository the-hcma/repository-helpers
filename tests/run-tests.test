#!/usr/bin/env bash
# Tests for scripts/dev/run-tests.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
runner="${script_dir}/../scripts/dev/run-tests"
readonly runner

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
test_init

fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT
mkdir -p "${fixture}/tests"
# shellcheck disable=SC2016  # $TMPDIR must expand when the fixture test runs, not when it is written
for name in a b c d e; do
  printf '#!/usr/bin/env bash\necho "ran %s tmp=$TMPDIR"\n' "$name" >"${fixture}/tests/${name}.test"
done

printf '\n=== functional: shard selection ===\n'
all_files="$("$runner" --dir "$fixture" --list | paste -sd, -)"
assert_contains 'unsharded list is every test, sorted' "$all_files" 'tests/a.test,tests/b.test,tests/c.test,tests/d.test,tests/e.test'
shard_one="$("$runner" --dir "$fixture" --list --shard 1/2 | paste -sd, -)"
shard_two="$("$runner" --dir "$fixture" --list --shard 2/2 | paste -sd, -)"
assert_contains 'shard 1/2 takes files 1, 3, 5' "$shard_one" 'tests/a.test,tests/c.test,tests/e.test'
assert_contains 'shard 2/2 takes files 2, 4' "$shard_two" 'tests/b.test,tests/d.test'
union="$(printf '%s\n%s\n' "${shard_one//,/$'\n'}" "${shard_two//,/$'\n'}" | sort | paste -sd, -)"
assert_contains 'the shards together cover every file exactly once' "$union" 'tests/a.test,tests/b.test,tests/c.test,tests/d.test,tests/e.test'
empty_shard="$("$runner" --dir "$fixture" --list --shard 7/8 | wc -l | tr -d ' ')"
assert_contains 'a shard beyond the file count selects nothing' "$empty_shard" '0'

printf '\n=== functional: running tests ===\n'
rc=0
output="$("$runner" --dir "$fixture" --jobs 3 2>&1)" || rc=$?
assert_contains 'all-passing run exits 0' "rc=${rc}" 'rc=0'
assert_contains 'each passing file prints a PASS line with its duration' "$output" '[PASS] tests/c.test ('
assert_contains 'a passing run ends with the passed marker' "$output" '==> run-tests passed (shard 1/1'
assert_not_contains 'passing logs are hidden without --verbose' "$output" 'ran a tmp='
verbose="$("$runner" --dir "$fixture" --verbose 2>&1)"
assert_contains '--verbose prints the passing test log' "$verbose" 'ran a tmp='
tmpdirs="$(grep -o 'tmp=[^ ]*' <<<"$verbose" | sort -u | wc -l | tr -d ' ')"
assert_contains 'every test file gets its own TMPDIR' "$tmpdirs" '5'

printf '\n=== functional: failures ===\n'
printf '#!/usr/bin/env bash\necho "boom detail"\nexit 4\n' >"${fixture}/tests/f.test"
rc=0
output="$("$runner" --dir "$fixture" --jobs 2 2>&1)" || rc=$?
assert_contains 'a failing file makes the run exit 1' "rc=${rc}" 'rc=1'
assert_contains 'the failing file is reported with its exit status' "$output" '[FAIL] tests/f.test (exit 4'
assert_contains 'the failing log is printed' "$output" 'boom detail'
assert_contains 'the machine-parseable failure line is emitted' "$output" 'ERROR: TESTS_FAILED shard=1/1 failed=1'
assert_contains 'passing files still run when another fails' "$output" '[PASS] tests/e.test ('

printf '\n=== functional: usage errors ===\n'
rc=0
"$runner" --shard 3/2 >/dev/null 2>&1 || rc=$?
assert_contains '--shard I/N with I greater than N exits 2' "rc=${rc}" 'rc=2'
rc=0
"$runner" --shard nonsense >/dev/null 2>&1 || rc=$?
assert_contains 'a malformed --shard exits 2' "rc=${rc}" 'rc=2'
rc=0
"$runner" --jobs 0 >/dev/null 2>&1 || rc=$?
assert_contains '--jobs 0 exits 2' "rc=${rc}" 'rc=2'
help_out="$("$runner" --help)"
assert_contains '--help documents --shard' "$help_out" '--shard I/N'

printf '\n=== functional: step summary ===\n'
summary_file="${fixture}/summary.md"
GITHUB_STEP_SUMMARY="$summary_file" "$runner" --dir "$fixture" --shard 1/2 >/dev/null 2>&1 || true
summary="$(<"$summary_file")"
assert_contains 'the step summary names the shard and lists files with seconds' "$summary" '### Tests shard 1/2'
assert_contains 'the step summary has a table row per slow file' "$summary" '| a |'

printf '\n=== static: ci.yml shard matrix matches the run-tests shard count ===\n'
ci_yml="${script_dir}/../.github/workflows/ci.yml"
matrix_line="$(grep -E '^        shard: \[' "$ci_yml")"
matrix_count="$(tr ',' '\n' <<<"$matrix_line" | wc -l | tr -d ' ')"
run_line="$(grep -F 'scripts/dev/run-tests --shard' "$ci_yml")"
run_total="${run_line##*/}"
run_total="${run_total%%\"*}"
assert_contains 'matrix.shard lists exactly as many shards as the run line divides by' "count=${matrix_count}" "count=${run_total}"
assert_contains 'the CI run line passes --verbose so shard logs stay in the job output' "$run_line" '--verbose'

test_summary
