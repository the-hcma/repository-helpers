printf '\n=== static: GitHub-native security checks wired (repository-helpers#588) ===\n'
# shellcheck disable=SC2016  # intentional literal $slug in source under test
if grep -q '^rp_check_github_security_settings()' "$lib" \
  && grep -q '^rp_check_actions_hardening()' "$lib" \
  && grep -q '^rp_check_actions_workflow_pinning()' "$lib" \
  && grep -q '^rp_check_deployment_env_protection()' "$lib" \
  && grep -q '^rp_check_protection_mechanism_consistency()' "$lib" \
  && grep -qF 'rp_check_github_security_settings "$slug"' "$lib" \
  && grep -qF 'rp_check_actions_hardening "$slug"' "$lib" \
  && grep -qF 'rp_check_actions_workflow_pinning "$slug"' "$lib" \
  && grep -qF 'rp_check_deployment_env_protection "$slug"' "$lib" \
  && grep -qF 'rp_check_protection_mechanism_consistency "$slug"' "$lib"; then
  printf '[PASS] all five #588 checks defined and wired into rp_check_one_repo\n'
  pass=$(( pass + 1 ))
