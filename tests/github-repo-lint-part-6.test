#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices — part 6 of 6.
# Split from the former aa-github-repo-lint.test so CI can run the parts in parallel (#692).
# To add a test, read the how-to at the top of tests/lib/github-repo-lint-part-init first.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck source=tests/lib/github-repo-lint-part-init
source "${script_dir}/lib/github-repo-lint-part-init"

pass=0
fail=0

printf '\n=== functional: HTTP 502 is API error, not missing workflow ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'labels'* ]]; then
  printf '%s\n' '[[{"name":"merge-it"}]]'
  exit 0
fi
if [[ "$args" == *'rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'branches/main/protection'* ]]; then
  exit 1
fi
if [[ "$args" == *'cleanup-merged-branches.yml'* ]]; then
  echo 'gh: HTTP 502' >&2
  exit 1
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  echo 'gh: Not Found (HTTP 404)' >&2
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(
  RP_GH_API_MAX_ATTEMPTS=1 RP_GH_API_RETRY_SLEEP_SECS=0 \
    PATH="${mock_bin}:${PATH}" bash "$checker" \
    --repo the-hcma/example-repo --strict-onboarding --suggest 2>&1
)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'could not read .github/workflows/cleanup-merged-branches.yml (GitHub API: HTTP 502)' \
    <<<"$output" \
  && ! grep -qF 'missing .github/workflows/cleanup-merged-branches.yml' <<<"$output" \
  && ! grep -qF 'should include a schedule trigger' <<<"$output"; then
  printf '[PASS] HTTP 502 on workflow path is reported as GitHub API error\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected API error for HTTP 502, not missing/schedule (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: path check retries transient 502 then succeeds ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"
state_file="${mock_dir}/cleanup-attempts"
printf '0\n' >"$state_file"

# shellcheck disable=SC2016  # mock embeds state file path
cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "\$args" == *'labels'* ]]; then
  printf '%s\\n' '["merge-it"]'
  exit 0
fi
if [[ "\$args" == *'rulesets'* ]]; then
  printf '%s\\n' '[]'
  exit 0
fi
if [[ "\$args" == *'branches/main/protection'* ]]; then
  exit 1
fi
if [[ "\$args" == *'cleanup-merged-branches.yml'* ]]; then
  n="\$(cat '${state_file}')"
  n=\$(( n + 1 ))
  printf '%s\\n' "\$n" >'${state_file}'
  if [[ "\$n" -eq 1 ]]; then
    echo 'gh: HTTP 502' >&2
    exit 1
  fi
  # Second attempt: return a minimal workflow with schedule
  content="\$(printf '%s' "on:\\n  schedule:\\n    - cron: '0 6 * * *'\\n" | base64)"
  printf '{"content":"%s"}\\n' "\$content"
  exit 0
fi
if [[ "\$args" == *'cleanup-branch-on-merge.yml'* ]]; then
  echo 'gh: Not Found (HTTP 404)' >&2
  exit 1
fi
if [[ "\$args" == *'/commits --jq'* ]]; then
  printf '%s\\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "\$args" == *'/contents/'* ]]; then
  echo 'gh: Not Found (HTTP 404)' >&2
  exit 1
fi
printf 'unexpected gh call: %s\\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(
  RP_GH_API_MAX_ATTEMPTS=3 RP_GH_API_RETRY_SLEEP_SECS=0 \
    PATH="${mock_bin}:${PATH}" bash "$checker" \
    --repo the-hcma/example-repo --strict-onboarding --suggest 2>&1
)"
exit_code=$?
set -e
attempts="$(cat "$state_file")"

if [[ "$attempts" -ge 2 ]] \
  && ! grep -qF 'could not read .github/workflows/cleanup-merged-branches.yml (GitHub API: HTTP 502)' \
    <<<"$output" \
  && ! grep -qF 'should include a schedule trigger' <<<"$output"; then
  printf '[PASS] transient HTTP 502 is retried and does not false-fail schedule check\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected retry past HTTP 502 (attempts=%s exit=%s)\n%s\n' \
    "$attempts" "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: python static CI job check wired ===\n'
if grep -qF 'rp_check_python_static_ci_job' "$lib" \
  && grep -qF 'rp_python_static_wrapper_is_canonical' "$lib" \
  && grep -qF 'rp_ci_workflow_has_combined_python_static_job' "$lib" \
  && grep -qF 'rp_ci_workflow_has_split_python_static_jobs' "$lib" \
  && grep -qF 'rp_ci_workflow_has_unsafe_python_static_cutover_aliases' "$lib" \
  && grep -qF 'rp_workflow_has_unsafe_noop_legacy_python_static' "$lib" \
  && grep -qF 'rp_workflow_has_unsafe_checks_action_python_static' "$lib" \
  && grep -qF 'rp_workflow_has_unsafe_python_static_publishers' "$lib" \
  && grep -qF 'rp_fetch_workflow_file_names' "$lib" \
  && grep -qF 'Backend Lint' "$lib" \
  && grep -qF 'rp_repo_uses_ruff_ci' "$lib" \
  && grep -qF 'rp_check_python_static_ci_job() {' "$lib" \
  && [[ "$(grep -cF 'rp_check_python_static_ci_job' "$lib")" -ge 2 ]]; then
  printf '[PASS] python-static: check + helpers defined and wired into rp_check_one_repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] python-static: missing check function or audit wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: python-static wrapper canonicality ===\n'
combined_wrapper='#!/usr/bin/env bash
set -euo pipefail
bash .github/ci/setup-python
uv run ruff check app config
uv run ruff format --check app config
uv run pyright'
mypy_wrapper='#!/usr/bin/env bash
uv run ruff check .
uv run ruff format --check .
uv run mypy src'
partial_wrapper='#!/usr/bin/env bash
uv run ruff check .'
if bash -c "source '${lib}'; rp_python_static_wrapper_is_canonical \"\$1\"" _ "$combined_wrapper" \
  && bash -c "source '${lib}'; rp_python_static_wrapper_is_canonical \"\$1\"" _ "$mypy_wrapper" \
  && ! bash -c "source '${lib}'; rp_python_static_wrapper_is_canonical \"\$1\"" _ "$partial_wrapper"; then
  printf '[PASS] python-static: wrapper canonical for ruff+typecheck, rejects ruff-only\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] python-static: wrapper canonicality check wrong\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: python-static ci.yml job detection ===\n'
combined_ci='jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static'
# Non-job 2-space keys under on:/concurrency: must not confuse job parsing.
combined_with_preamble_ci='name: CI
on:
  pull_request:
  push:
concurrency:
  group: ci
jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static'
# Name and wrapper in different jobs must not count as combined.
split_markers_ci='jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: echo placeholder
  other:
    name: Other
    steps:
      - run: bash .github/ci/python-static'
split_ci='jobs:
  ruff:
    name: Ruff
    steps:
      - run: bash .github/ci/ruff
  pyright:
    name: Pyright
    steps:
      - run: bash .github/ci/pyright'
unsafe_alias_ci='jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static
  ruff:
    name: Ruff
    needs: [guard, python-static]
    if: needs.guard.outputs.skip != '\''true'\''
    steps:
      - run: echo covered'
# Gate on an unrelated job must not mask an unsafe Ruff alias (Vortex #384).
masked_unsafe_ci='jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static
  ruff:
    name: Ruff
    needs: [guard, python-static]
    if: needs.guard.outputs.skip != '\''true'\''
    steps:
      - run: echo covered
  unrelated:
    name: Some Other Job
    if: needs.python-static.result == '\''success'\''
    steps:
      - run: echo ok'
safe_alias_ci='jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static
  backend-lint:
    name: Backend Lint
    needs: [guard, python-static]
    if: needs.guard.outputs.skip != '\''true'\'' && needs.python-static.result == '\''success'\''
    steps:
      - run: echo covered'
# Quoted job name + double-quoted success still count as a safe cutover alias.
quoted_safe_ci='jobs:
  ruff:
    name: "Ruff"
    needs: [guard, python-static]
    if: needs.guard.outputs.skip != '\''true'\'' && needs.python-static.result == "success"
    steps:
      - run: echo covered'
# 4-space job indent (valid YAML) must still be parsed (Vortex #384).
combined_4space_ci='jobs:
    python-static:
        name: Python lint & format checks
        steps:
            - run: bash .github/ci/python-static'
unsafe_4space_ci='jobs:
    python-static:
        name: Python lint & format checks
        steps:
            - run: bash .github/ci/python-static
    ruff:
        name: Ruff
        needs: [guard, python-static]
        if: needs.guard.outputs.skip != '\''true'\''
        steps:
            - run: echo covered'
# Suffixed wrapper path (python-static-v2) must not count as the wrapper.
suffixed_wrapper_ci='jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static-v2'
# Valid YAML key ordering: steps: before name: must still detect the combined job.
combined_reordered_ci='jobs:
  python-static:
    steps:
      - run: bash .github/ci/python-static
    name: Python lint & format checks'
# Valid YAML key ordering: if: before name: must still count as a safe alias.
reordered_safe_alias_ci='jobs:
  ruff:
    if: needs.guard.outputs.skip != '\''true'\'' && needs.python-static.result == '\''success'\''
    name: Ruff
    needs: [guard, python-static]
    steps:
      - run: echo covered'
# Multi-line if: > scalar with the gate on a continuation line is safe.
multiline_if_safe_ci='jobs:
  ruff:
    name: Ruff
    needs: [guard, python-static]
    if: >
      needs.guard.outputs.skip != '\''true'\'' &&
      needs.python-static.result == '\''success'\''
    steps:
      - run: echo covered'
# Matrix primary rows named Ruff/Mypy with cutover-ok are unsafe false-greens (#390).
# shellcheck disable=SC2016  # fixture YAML contains literal ${{ }} expressions
unsafe_matrix_noop='jobs:
  release-pr-checks:
    name: ${{ matrix.check.name }}
    strategy:
      matrix:
        check:
          - name: Python lint & format checks
            script: .github/ci/python-static
          - name: Ruff
            script: .github/ci/cutover-ok
          - name: Mypy
            script: .github/ci/cutover-ok'
# Safe cutover: aliases share the real job conclusion (still leftover end-state).
safe_matrix_aliases='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Python lint & format checks
            script: .github/ci/python-static
            aliases: Ruff Mypy'
# checks-action with hardcoded success is unsafe; outcome-tied is not.
unsafe_checks_action='jobs:
  publish:
    steps:
      - id: run
        run: bash .github/ci/python-static
      - uses: LouisBrunner/checks-action@v3.1.0
        with:
          name: Ruff
          conclusion: success'
# shellcheck disable=SC2016  # fixture YAML contains literal ${{ }} expressions
safe_checks_action='jobs:
  publish:
    steps:
      - id: run
        run: bash .github/ci/python-static
      - uses: LouisBrunner/checks-action@v3.1.0
        with:
          name: Ruff
          conclusion: ${{ steps.run.outcome == '\''success'\'' && '\''success'\'' || '\''failure'\'' }}'
# Mentioning checks-action in a run: string must not count as a publisher.
echo_mentions_checks='jobs:
  publish:
    steps:
      - run: echo "checks-action is bad"
        name: Ruff'
# Multi-line conclusion scalar still counts as outcome-gated.
# shellcheck disable=SC2016  # fixture YAML contains literal ${{ }} expressions
multiline_safe_checks='jobs:
  publish:
    steps:
      - id: run
        run: bash .github/ci/python-static
      - uses: LouisBrunner/checks-action@v3.1.0
        with:
          name: Ruff
          conclusion: >
            ${{ steps.run.outcome == '\''success'\'' && '\''success'\'' || '\''failure'\'' }}'
# Unrelated steps.*.outcome in another with: key must not clear hardcoded conclusion.
# shellcheck disable=SC2016  # fixture YAML contains literal ${{ }} expressions
hardcoded_with_title_outcome='jobs:
  publish:
    steps:
      - uses: LouisBrunner/checks-action@v3.1.0
        with:
          name: Ruff
          conclusion: success
          title: ${{ steps.run.outcome }}'
# name: before uses: must still detect unsafe checks-action (Vortex).
name_before_uses_checks='jobs:
  publish:
    steps:
      - name: Ruff
        uses: LouisBrunner/checks-action@v3.1.0
        with:
          conclusion: success'
# Trailing YAML comments on legacy names must still match (#412 CodeRabbit).
commented_split_ci='jobs:
  ruff:
    name: Ruff # temporary alias
    steps:
      - run: bash .github/ci/ruff'
commented_matrix_noop='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff # temporary alias
            script: .github/ci/cutover-ok'
# Step-level name: Ruff must not count as an unsafe cutover job alias (Vortex).
step_name_not_alias='jobs:
  test:
    name: Pytest
    steps:
      - run: pip install ruff
        name: Ruff'
# cutover-ok in a name/comment must not count as a matrix no-op (Vortex).
cutover_ok_in_name_only='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff cutover-ok note
            script: .github/ci/ruff'
# Substring cutover-ok in a longer script path must not count as a no-op.
cutover_ok_substring_script='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff
            script: .github/ci/validate-cutover-ok-setup'
# Unquoted Covered-by echo is still a cutover no-op.
unquoted_covered_echo='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff
            run: echo Covered by Python lint & format checks'
# aliases: must match whole tokens, not substrings (Vortex).
alias_substring_not_legacy='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Python lint & format checks
            script: .github/ci/python-static
            aliases: mypy-check ruff-extra'
# Lone run: true is a noop; run: true beside a real script is not (Vortex).
matrix_true_only_noop='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff
            run: true'
matrix_true_with_real_script='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff
            script: .github/ci/ruff
            run: true'
# Bare script: cutover-ok (no dir prefix) is still a noop (Vortex).
bare_cutover_ok_script='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff
            script: cutover-ok'
# Bare unquoted Covered by at EOL is still a noop.
bare_covered_by_eol='jobs:
  release-pr-checks:
    strategy:
      matrix:
        check:
          - name: Ruff
            run: echo Covered by'
if bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$combined_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$combined_with_preamble_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$split_markers_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$combined_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$split_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$split_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$unsafe_alias_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$masked_unsafe_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$safe_alias_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$safe_alias_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$quoted_safe_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$quoted_safe_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$combined_4space_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$unsafe_4space_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$suffixed_wrapper_ci" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_combined_python_static_job \"\$1\"" _ "$combined_reordered_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$reordered_safe_alias_ci" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$multiline_if_safe_ci" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$unsafe_matrix_noop" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_python_static_publishers \"\$1\"" _ "$unsafe_matrix_noop" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$safe_matrix_aliases" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$safe_matrix_aliases" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_checks_action_python_static \"\$1\"" _ "$unsafe_checks_action" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_checks_action_python_static \"\$1\"" _ "$safe_checks_action" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$safe_checks_action" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_checks_action_python_static \"\$1\"" _ "$echo_mentions_checks" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_checks_action_python_static \"\$1\"" _ "$multiline_safe_checks" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_checks_action_python_static \"\$1\"" _ "$hardcoded_with_title_outcome" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_checks_action_python_static \"\$1\"" _ "$name_before_uses_checks" \
  && bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$commented_split_ci" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$commented_matrix_noop" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$cutover_ok_in_name_only" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$cutover_ok_substring_script" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$unquoted_covered_echo" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_split_python_static_jobs \"\$1\"" _ "$alias_substring_not_legacy" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$matrix_true_only_noop" \
  && ! bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$matrix_true_with_real_script" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$bare_cutover_ok_script" \
  && bash -c "source '${lib}'; rp_workflow_has_unsafe_noop_legacy_python_static \"\$1\"" _ "$bare_covered_by_eol" \
  && ! bash -c "source '${lib}'; rp_ci_workflow_has_unsafe_python_static_cutover_aliases \"\$1\"" _ "$step_name_not_alias"; then
  printf '[PASS] python-static: detects combined/split jobs and unsafe vs safe cutover aliases\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] python-static: ci.yml job detection wrong\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: python-static split jobs fail audit ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"
split_ci_b64="$(printf '%s' 'name: CI
jobs:
  ruff:
    name: Ruff
    steps:
      - run: bash .github/ci/ruff
  pyright:
    name: Pyright
    steps:
      - run: bash .github/ci/pyright' | base64 -w0)"

cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then exit 0; fi
if [[ "\$args" == *'release-please.yml'* ]]; then exit 1; fi
if [[ "\$args" == *'/labels'* ]]; then printf '%s\n' '[[]]'; exit 0; fi
if [[ "\$args" == *'contents/.github/workflows/ci.yml'* ]]; then
  printf '%s\n' '{"content":"${split_ci_b64}"}'
  exit 0
fi
if [[ "\$args" == *'contents/.github/workflows' ]]; then
  printf '%s\n' '[{"name":"ci.yml","type":"file"}]'
  exit 0
fi
if [[ "\$args" == *'contents/pyproject.toml'* ]]; then printf '%s\n' '{}'; exit 0; fi
if [[ "\$args" == *'contents/.github/ci/python-static'* ]]; then exit 1; fi
if [[ "\$args" == *'/contents/'* ]]; then exit 1; fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"
cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/split-python-ci --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'not gated on the combined job/step succeeding' <<<"$output" \
  && grep -qF "missing combined 'Python lint & format checks' job" <<<"$output" \
  && grep -qF 'missing .github/ci/python-static wrapper' <<<"$output"; then
  printf '[PASS] python-static: unsafe split/alias jobs fail audit with suggestions\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] python-static: expected split-job failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: python-static non-ci.yml matrix no-op fails audit ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"
good_ci_b64="$(printf '%s' 'name: CI
jobs:
  python-static:
    name: Python lint & format checks
    steps:
      - run: bash .github/ci/python-static' | base64 -w0)"
# shellcheck disable=SC2016  # fixture YAML contains literal ${{ }} expressions
bad_rp_b64="$(printf '%s' 'name: Release Please
jobs:
  release-pr-checks:
    name: ${{ matrix.check.name }}
    strategy:
      matrix:
        check:
          - name: Python lint & format checks
            script: .github/ci/python-static
          - name: Ruff
            script: .github/ci/cutover-ok
          - name: Mypy
            script: .github/ci/cutover-ok' | base64 -w0)"
wrapper_b64="$(printf '%s' '#!/usr/bin/env bash
uv run ruff check .
uv run ruff format --check .
uv run mypy .' | base64 -w0)"

cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then exit 0; fi
if [[ "\$args" == *'/labels'* ]]; then printf '%s\n' '[[]]'; exit 0; fi
if [[ "\$args" == *'contents/.github/workflows/ci.yml'* ]]; then
  printf '%s\n' '{"content":"${good_ci_b64}"}'
  exit 0
fi
if [[ "\$args" == *'contents/.github/workflows/release-please.yml'* ]]; then
  printf '%s\n' '{"content":"${bad_rp_b64}"}'
  exit 0
fi
if [[ "\$args" == *'contents/.github/workflows' ]]; then
  printf '%s\n' '[{"name":"ci.yml","type":"file"},{"name":"release-please.yml","type":"file"}]'
  exit 0
fi
if [[ "\$args" == *'contents/pyproject.toml'* ]]; then printf '%s\n' '{}'; exit 0; fi
if [[ "\$args" == *'contents/.github/ci/python-static'* ]]; then
  printf '%s\n' '{"content":"${wrapper_b64}"}'
  exit 0
fi
if [[ "\$args" == *'/contents/'* ]]; then exit 1; fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"
cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/matrix-noop-python --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'release-please.yml' <<<"$output" \
  && grep -qF 'not gated on the combined job/step succeeding' <<<"$output" \
  && grep -qF 'false-green' <<<"$output"; then
  printf '[PASS] python-static: release-please matrix cutover-ok no-ops fail audit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] python-static: expected non-ci.yml matrix failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: org cursor-rule rollout apply-fix helpers ===\n'
if grep -qF 'rp_helpers_primary_checkout_dir' "$lib" \
  && grep -qF 'rp_index_scan_root_clones' "$lib" \
  && grep -qF 'rp_local_repo_scan_root' "$lib" \
  && grep -qF 'rp_resolve_local_repo_dir_from_scan_root' "$lib" \
  && grep -qF 'rp_scan_root_clone_dirs' "$lib" \
  && grep -qF 'rp_candidate_fix_path_is_api_eligible' "$lib" \
  && grep -qF 'rp_apply_file_pr_via_api' "$lib" \
  && grep -qF 'rp_apply_candidate_fixes_via_api' "$lib"; then
  printf '[PASS] org cursor-rule rollout: scan-root resolve and API apply-fix helpers present\n'
  pass=$(( pass + 1 ))
else
