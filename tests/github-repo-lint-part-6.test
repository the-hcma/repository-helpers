printf '\n=== unit: every agent-bootstrap shim path is API apply-fix eligible ===\n'
ab_elig_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${ab_elig_dir}/runner-sessions"
ab_elig_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    fails=""
    for path in "$rp_agent_bootstrap_claude_path" "$rp_agent_bootstrap_copilot_path" \
      "$rp_agent_bootstrap_instructions_path"; do
      rp_candidate_fix_path_is_api_eligible "$path" || fails="$fails ${path}"
    done
    if rp_candidate_fix_path_is_api_eligible .github/instructions/other.instructions.md; then
      fails="$fails other-instructions-accepted"
    fi
    if [[ -n "$fails" ]]; then printf "FAILS:%s\n" "$fails"; exit 1; fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || ab_elig_out="fail:${ab_elig_out}"
rm -rf "$ab_elig_dir"
unset RUNNER_SESSION_ROOT
if [[ "$ab_elig_out" == 'ok' ]]; then
  printf '[PASS] #681: CLAUDE.md, copilot-instructions and the .github/instructions pointer can land via the Contents API (no clone)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #681: agent-bootstrap shim API eligibility (%s)\n' "$ab_elig_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: API apply-fix guards and mixed eligibility ===\n'
# shellcheck disable=SC2016  # assert literal source fragments, not expansions
if grep -qF 'rp_helpers_primary_checkout_dir' "$lib" \
  && grep -qF 'worktree list --porcelain' "$lib" \
  && grep -qF 'rp_scan_root_clone_index_ready' "$lib" \
  && grep -qF 'runner_sh_stdout "repo-practices file-pr base64"' "$lib" \
