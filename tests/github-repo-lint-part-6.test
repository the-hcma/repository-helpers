printf '\n=== unit: rp_uses_ref_is_sha_pinned / rp_workflow_uses_refs / rp_workflow_is_publish_like ===\n'
pin_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${pin_dir}/runner-sessions"
pin_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"

    rp_uses_ref_is_sha_pinned "actions/checkout@$(printf "a%.0s" {1..40})" \
      || { printf "sha-pinned should match\n"; exit 1; }
    ! rp_uses_ref_is_sha_pinned "actions/checkout@v4" \
      || { printf "v4 should not be sha-pinned\n"; exit 1; }
    ! rp_uses_ref_is_sha_pinned "actions/checkout@$(printf "a%.0s" {1..39})" \
      || { printf "39-char hex should not match (not a full SHA)\n"; exit 1; }

    wf=$'"'"'name: CI\non:\n  push:\njobs:\n  build:\n    steps:\n      - uses: ./local-action\n      - uses: actions/checkout@v4\n      - uses: docker://alpine:3\n      - uses: actions/setup-node@v6.4.0 # comment\n'"'"'
    refs="$(rp_workflow_uses_refs "$wf")"
    { grep -qF "actions/checkout@v4" <<<"$refs" \
      && grep -qF "actions/setup-node@v6.4.0" <<<"$refs" \
      && ! grep -qF "./local-action" <<<"$refs" \
      && ! grep -qF "docker://" <<<"$refs"; } \
      || { printf "uses_refs: %s\n" "$refs"; exit 1; }

    rp_workflow_is_publish_like "release.yml" "" \
      || { printf "release.yml should be publish-like by name\n"; exit 1; }
    rp_workflow_is_publish_like "ci.yml" $'"'"'permissions:\n  id-token: write\n'"'"' \
      || { printf "id-token: write should be publish-like\n"; exit 1; }
    rp_workflow_is_publish_like "ci.yml" "uses: pypa/gh-action-pypi-publish@release/v1" \
      || { printf "pypi publish action should be publish-like\n"; exit 1; }
    ! rp_workflow_is_publish_like "ci.yml" "steps: []" \
      || { printf "plain ci.yml should not be publish-like\n"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || pin_out="fail:${pin_out}"
rm -rf "$pin_dir"
unset RUNNER_SESSION_ROOT
if [[ "$pin_out" == 'ok' ]]; then
  printf '[PASS] SHA-pin detection, uses: extraction, and publish-like heuristic\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] workflow pinning helpers (%s)\n' "$pin_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_workflow_environment_names / rp_environment_has_protection ===\n'
env_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${env_dir}/runner-sessions"
env_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"

    wf=$'"'"'jobs:\n  deploy:\n    environment: pypi\n    steps: []\n  build:\n    steps: []\n'"'"'
    names="$(rp_workflow_environment_names "$wf")"
    [[ "$names" == "pypi" ]] || { printf "env names: %s\n" "$names"; exit 1; }

    # Regression (review #591): scalar form with quotes and a trailing comment.
    wf_quoted=$'"'"'jobs:\n  deploy:\n    environment: "pypi" # prod\n'"'"'
    names="$(rp_workflow_environment_names "$wf_quoted")"
    [[ "$names" == "pypi" ]] || { printf "quoted+comment env names: %s\n" "$names"; exit 1; }

    # Regression (review #591): the mapping form (environment: on its own
    # line, followed by name:) was previously dropped entirely.
    wf_mapping=$'"'"'jobs:\n  publish:\n    environment:\n      name: pypi\n      url: https://pypi.org/p/example\n    steps: []\n'"'"'
    names="$(rp_workflow_environment_names "$wf_mapping")"
    [[ "$names" == "pypi" ]] || { printf "mapping-form env names: %s\n" "$names"; exit 1; }

    # Regression (review #591 round 3): a reusable-workflow call'"'"'s `with:`
    # input named `environment` is not this workflow'"'"'s job environment.
    wf_with=$'"'"'jobs:\n  deploy:\n    uses: ./.github/workflows/reusable.yml\n    with:\n      environment: staging\n'"'"'
    names="$(rp_workflow_environment_names "$wf_with")"
    [[ -z "$names" ]] || { printf "with:-nested environment should be skipped: %s\n" "$names"; exit 1; }

    # Regression (review #591 round 3): an expression value is never a
    # literal environment name — percent-encoding it 404s against a
    # completely unrelated (nonexistent) environment.
    wf_expr=$'"'"'jobs:\n  deploy:\n    environment: ${{ inputs.environment }}\n    steps: []\n'"'"'
    names="$(rp_workflow_environment_names "$wf_expr")"
    [[ -z "$names" ]] || { printf "expression environment should be skipped: %s\n" "$names"; exit 1; }

    # The with:/strategy: skip must not swallow a real environment that
    # follows once the nested block ends (indentation drops back down).
    wf_after_with=$'"'"'jobs:\n  deploy:\n    uses: ./.github/workflows/reusable.yml\n    with:\n      environment: staging\n  publish:\n    environment: pypi\n    steps: []\n'"'"'
    names="$(rp_workflow_environment_names "$wf_after_with")"
    [[ "$names" == "pypi" ]] \
      || { printf "environment after a with: block should still be found: %s\n" "$names"; exit 1; }

    # Regression (review #591 round 5): a mapping block'"'"'s name: is not
    # necessarily the first key — url: commonly comes first — so the block
    # must keep scanning by indentation, not reset on the first non-name: key.
    wf_url_before_name=$'"'"'jobs:\n  publish:\n    environment:\n      url: https://pypi.org/p/example\n      name: pypi\n    steps: []\n'"'"'
    names="$(rp_workflow_environment_names "$wf_url_before_name")"
    [[ "$names" == "pypi" ]] \
      || { printf "url: before name: should not lose the environment: %s\n" "$names"; exit 1; }

    rp_environment_has_protection '"'"'{"protection_rules":[{"type":"required_reviewers"}]}'"'"' \
      || { printf "required_reviewers rule should count as protected\n"; exit 1; }
    rp_environment_has_protection '"'"'{"protection_rules":[],"deployment_branch_policy":{"protected_branches":true}}'"'"' \
      || { printf "protected_branches:true should count as protected\n"; exit 1; }
    rp_environment_has_protection '"'"'{"protection_rules":[],"deployment_branch_policy":{"custom_branch_policies":true}}'"'"' \
      || { printf "custom_branch_policies:true should count as protected\n"; exit 1; }
    ! rp_environment_has_protection '"'"'{"protection_rules":[],"deployment_branch_policy":null}'"'"' \
      || { printf "empty rules + null policy should not be protected\n"; exit 1; }
    # Regression (review #591 round 2): a wait_timer-only rule delays the
    # deploy but requires no approval — not a human gate.
    ! rp_environment_has_protection '"'"'{"protection_rules":[{"type":"wait_timer","wait_timer":30}],"deployment_branch_policy":null}'"'"' \
      || { printf "wait_timer-only should not count as protected\n"; exit 1; }
    # Regression (review #591 round 2): a branch policy object with both
    # flags false restricts nothing.
    ! rp_environment_has_protection '"'"'{"protection_rules":[],"deployment_branch_policy":{"protected_branches":false,"custom_branch_policies":false}}'"'"' \
      || { printf "non-restrictive branch policy should not count as protected\n"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || env_out="fail:${env_out}"
rm -rf "$env_dir"
unset RUNNER_SESSION_ROOT
if [[ "$env_out" == 'ok' ]]; then
  printf '[PASS] environment name extraction and protection detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] deployment environment helpers (%s)\n' "$env_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_fetch_environment_protection URL-encodes the environment name ===\n'
# Regression (review #591): the jq @uri encoding step needs -r (raw output),
# or the encoded value comes back JSON-quoted (`"dep-updater"`) and the
# request 404s against a real, protected environment — a false "not
# protected" finding that stubbing rp_fetch_environment_protection in the
# other unit tests here cannot catch. Uses a real gh mock so the actual
# requested path is observable.
urlenc_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${urlenc_dir}/runner-sessions"
urlenc_bin="${urlenc_dir}/bin"
mkdir -p "$urlenc_bin"
cat >"${urlenc_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    repos/*/environments/*)
      printf '%s\n' "$arg" >>"${MOCK_GH_CAPTURE}"
      printf '{"protection_rules":[{"type":"required_reviewers"}]}\n'
      exit 0
      ;;
  esac
done
printf 'unexpected gh call: %s\n' "$*" >&2
exit 1
MOCK_GH
chmod +x "${urlenc_bin}/gh"
capture_file="${urlenc_dir}/captured-path"
: >"$capture_file"
urlenc_out="$(
  MOCK_GH_CAPTURE="$capture_file" PATH="${urlenc_bin}:${PATH}" bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"

    rc=0
    json="$(rp_fetch_environment_protection the-hcma/example-repo "dep-updater")" || rc=$?
    [[ "$rc" -eq 0 ]] || { printf "plain-name fetch failed: rc=%s\n" "$rc"; exit 1; }
    rp_environment_has_protection "$json" \
      || { printf "plain-name should be reported protected\n"; exit 1; }

    rc=0
    json="$(rp_fetch_environment_protection the-hcma/example-repo "my env")" || rc=$?
    [[ "$rc" -eq 0 ]] || { printf "spaced-name fetch failed: rc=%s\n" "$rc"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || urlenc_out="fail:${urlenc_out}"
captured="$(cat "$capture_file")"
rm -rf "$urlenc_dir"
unset RUNNER_SESSION_ROOT
if [[ "$urlenc_out" == 'ok' ]] \
  && grep -qF 'repos/the-hcma/example-repo/environments/dep-updater' <<<"$captured" \
  && grep -qF 'repos/the-hcma/example-repo/environments/my%20env' <<<"$captured"; then
  printf '[PASS] rp_fetch_environment_protection requests the raw (unquoted) percent-encoded path\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_fetch_environment_protection URL-encoding (%s) (captured: %s)\n' \
    "$urlenc_out" "$captured"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_check_github_security_settings (repository-helpers#588) ===\n'
ghsec_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${ghsec_dir}/runner-sessions"
ghsec_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_compact=0; rp_suggest=1; rp_apply_fix=0; rp_strict_onboarding=0; rp_new_repo=0

    rp_fetch_repo_security_settings() {
      printf %s "{\"private\":false,\"security_and_analysis\":{\"secret_scanning\":{\"status\":\"disabled\"}}}"
    }
    rp_fetch_repo_toggle_state() { return 1; }
    rp_fetch_repo_enabled_field() { printf false; return 0; }

    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: enable secret scanning" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: enable Dependabot alerts" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: enable Dependabot security updates" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: enable private vulnerability reporting" <<<"$out"; } \
      || { printf "routine-public-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # Promoted (repository-helpers#588 org-wide rollout complete, see
    # .cursor/rules/org-cursor-rule-rollout.mdc): --strict-onboarding alone
    # now FAILs, matching --new-repo.
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: secret scanning is disabled" <<<"$out" \
      && grep -qF "FAIL: the-hcma/example-repo: Dependabot alerts are disabled" <<<"$out"; } \
      || { printf "strict-onboarding-alone-now-fail: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0

    rp_new_repo=1
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: secret scanning is disabled" <<<"$out" \
      && grep -qF "FAIL: the-hcma/example-repo: Dependabot alerts are disabled" <<<"$out"; } \
      || { printf "new-repo-public-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_new_repo=0

    rp_fetch_repo_security_settings() {
      printf %s "{\"private\":true,\"security_and_analysis\":{\"secret_scanning\":{\"status\":\"disabled\"}}}"
    }
    rp_fetch_repo_toggle_state() { return 0; }
    rp_fetch_repo_enabled_field() { printf true; return 0; }
    rp_new_repo=1
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: secret scanning is off (private repo" <<<"$out"; } \
      || { printf "new-repo-private-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_new_repo=0

    # Same private-repo advisory-only exception under --strict-onboarding
    # (repository-helpers#588 promotion, review #592): the private-repo
    # secret-scanning gap has no user-actionable fix without a plan/GHAS
    # upgrade, so it always SUGGESTs, never FAILs.
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: secret scanning is off (private repo" <<<"$out" \
      && ! grep -qF "FAIL:" <<<"$out"; } \
      || { printf "strict-onboarding-private-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0

    # Regression (review #591, verified live against a real private org repo):
    # private-vulnerability-reporting can 404 for a private repo even when
    # unrelated to Dependabot alerts state — advisory-only there, same as
    # secret scanning, never a FAIL even under --new-repo.
    rp_fetch_repo_security_settings() {
      printf %s "{\"private\":true,\"security_and_analysis\":{\"secret_scanning\":{\"status\":\"enabled\"},\"secret_scanning_push_protection\":{\"status\":\"enabled\"}}}"
    }
    rp_fetch_repo_toggle_state() { return 0; }
    rp_fetch_repo_enabled_field() {
      [[ "$2" == "private-vulnerability-reporting" ]] && { printf false; return 0; }
      printf true; return 0
    }
    rp_new_repo=1
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: private vulnerability reporting is off (private repo" <<<"$out" \
      && ! grep -qF "FAIL:" <<<"$out"; } \
      || { printf "new-repo-private-pvr-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_new_repo=0

    applied=""
    rp_apply_enable_secret_scanning() { applied="${applied}secret_scanning,"; return 0; }
    rp_apply_repo_put_toggle() { applied="${applied}$2,"; return 0; }
    rp_fetch_repo_security_settings() {
      printf %s "{\"private\":false,\"security_and_analysis\":{\"secret_scanning\":{\"status\":\"disabled\"}}}"
    }
    rp_fetch_repo_toggle_state() { return 1; }
    rp_fetch_repo_enabled_field() { printf false; return 0; }
    rp_apply_fix=1
    rp_check_github_security_settings the-hcma/example-repo >/dev/null 2>&1 || true
    { grep -qF "secret_scanning," <<<"$applied" \
      && grep -qF "vulnerability-alerts," <<<"$applied" \
      && grep -qF "automated-security-fixes," <<<"$applied" \
      && grep -qF "private-vulnerability-reporting," <<<"$applied"; } \
      || { printf "apply-fix: applied=%s\n" "$applied"; exit 1; }
    rp_apply_fix=0

    rp_fetch_repo_security_settings() {
      printf %s "{\"private\":false,\"security_and_analysis\":{\"secret_scanning\":{\"status\":\"enabled\"},\"secret_scanning_push_protection\":{\"status\":\"enabled\"}}}"
    }
    rp_fetch_repo_toggle_state() { return 0; }
    rp_fetch_repo_enabled_field() { printf true; return 0; }
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && ! grep -qE "FAIL:|SUGGEST:" <<<"$out"; } \
      || { printf "clean-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || ghsec_out="fail:${ghsec_out}"
rm -rf "$ghsec_dir"
unset RUNNER_SESSION_ROOT
if [[ "$ghsec_out" == 'ok' ]]; then
  printf '[PASS] rp_check_github_security_settings: routine SUGGEST / strict-onboarding+new-repo FAIL / private advisory-only / apply-fix / clean OK\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_github_security_settings (%s)\n' "$ghsec_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_check_actions_hardening (repository-helpers#588) ===\n'
acth_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${acth_dir}/runner-sessions"
acth_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_compact=0; rp_suggest=1; rp_apply_fix=0; rp_strict_onboarding=0; rp_new_repo=0

    rp_fetch_actions_permissions() {
      printf %s "{\"allowed_actions\":\"all\",\"sha_pinning_required\":false}"
    }
    rp_fetch_actions_permissions_workflow() {
      printf %s "{\"default_workflow_permissions\":\"write\",\"can_approve_pull_request_reviews\":true}"
    }
    # Ready-when-pinned gate: treat example-repo as fully SHA-pinned unless a
    # case overrides this mock.
    rp_actions_workflows_all_uses_sha_pinned() { return 0; }
    rp_actions_workflows_setup_pnpm_nested_uses_sha_pinned() { return 0; }

    rc=0; out="$(rp_check_actions_hardening the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: disable Actions" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: set Actions default workflow permissions" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: restrict Actions" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: consider requiring SHA pinning" <<<"$out"; } \
      || { printf "routine-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # Promoted (repository-helpers#588 / #640): --strict-onboarding alone FAILs
    # workflow perms + sha_pinning_required (when uses: are SHA-pinned).
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_actions_hardening the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: Actions can_approve_pull_request_reviews must be false" <<<"$out" \
      && grep -qF "FAIL: the-hcma/example-repo: Actions default_workflow_permissions must be read" <<<"$out" \
      && grep -qF "FAIL: the-hcma/example-repo: Actions sha_pinning_required must be true" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: restrict Actions" <<<"$out"; } \
      || { printf "strict-onboarding-alone-now-fail: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0

    rp_new_repo=1
    rc=0; out="$(rp_check_actions_hardening the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: Actions can_approve_pull_request_reviews must be false" <<<"$out" \
      && grep -qF "FAIL: the-hcma/example-repo: Actions default_workflow_permissions must be read" <<<"$out" \
      && grep -qF "FAIL: the-hcma/example-repo: Actions sha_pinning_required must be true" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: restrict Actions" <<<"$out"; } \
      || { printf "new-repo-off: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_new_repo=0

    # Unpinned uses: under strict — no sha_pinning FAIL (would brick CI).
    rp_actions_workflows_all_uses_sha_pinned() { return 1; }
    rp_strict_onboarding=1
    rp_suggest=0
    rc=0; out="$(rp_check_actions_hardening the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: Actions can_approve_pull_request_reviews must be false" <<<"$out" \
      && ! grep -qF "FAIL: the-hcma/example-repo: Actions sha_pinning_required must be true" <<<"$out"; } \
      || { printf "strict-unpinned-no-sha-fail: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0
    rp_suggest=1
    rp_actions_workflows_all_uses_sha_pinned() { return 0; }

    applied=0
    sha_applied=0
    rp_apply_actions_workflow_permissions() { applied=1; return 0; }
    rp_apply_actions_sha_pinning_required() { sha_applied=1; return 0; }
    rp_apply_fix=1
    rp_check_actions_hardening the-hcma/example-repo >/dev/null 2>&1 || true
    [[ "$applied" -eq 1 ]] || { printf "apply-fix not invoked\n"; exit 1; }
    [[ "$sha_applied" -eq 1 ]] || { printf "sha_pinning apply-fix not invoked\n"; exit 1; }

    # Unsafe: unpinned uses: must not enable sha_pinning_required.
    sha_applied=0
    rp_actions_workflows_all_uses_sha_pinned() { return 1; }
    rp_suggest=1
    out="$(
      rp_check_actions_hardening the-hcma/example-repo 2>&1 || true
      printf "SHA_APPLIED=%s\n" "$sha_applied"
    )"
    { grep -qF "SHA_APPLIED=0" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: skip sha_pinning_required until" <<<"$out"; } \
      || { printf "unsafe-skip: out=%s\n" "$out"; exit 1; }
    rp_apply_fix=0
    rp_suggest=1
    rp_actions_workflows_all_uses_sha_pinned() { return 0; }

    # Stale setup-pnpm-corepack nested tags must not enable sha_pinning_required.
    sha_applied=0
    rp_actions_workflows_setup_pnpm_nested_uses_sha_pinned() { return 1; }
    rp_apply_fix=1
    out="$(
      rp_check_actions_hardening the-hcma/example-repo 2>&1 || true
      printf "SHA_APPLIED=%s\n" "$sha_applied"
    )"
    { grep -qF "SHA_APPLIED=0" <<<"$out" \
      && grep -qF "SUGGEST: the-hcma/example-repo: skip sha_pinning_required until setup-pnpm-corepack nested" <<<"$out"; } \
      || { printf "nested-skip: out=%s\n" "$out"; exit 1; }
    rp_apply_fix=0
    rp_actions_workflows_setup_pnpm_nested_uses_sha_pinned() { return 0; }

    rp_fetch_actions_permissions() {
      printf %s "{\"allowed_actions\":\"selected\",\"sha_pinning_required\":true}"
    }
    rp_fetch_actions_permissions_workflow() {
      printf %s "{\"default_workflow_permissions\":\"read\",\"can_approve_pull_request_reviews\":false}"
    }
    rc=0; out="$(rp_check_actions_hardening the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && ! grep -qE "FAIL:|SUGGEST:" <<<"$out"; } \
      || { printf "clean-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || acth_out="fail:${acth_out}"
rm -rf "$acth_dir"
unset RUNNER_SESSION_ROOT
if [[ "$acth_out" == 'ok' ]]; then
  printf '[PASS] rp_check_actions_hardening: routine SUGGEST / strict-onboarding+new-repo FAIL / apply-fix / clean OK\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_actions_hardening (%s)\n' "$acth_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_check_actions_workflow_pinning (repository-helpers#588) ===\n'
pinchk_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${pinchk_dir}/runner-sessions"
pinchk_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_compact=0; rp_suggest=1; rp_apply_fix=0; rp_strict_onboarding=0; rp_new_repo=0

    rp_fetch_workflow_file_names() { printf "ci.yml\n"; }
    rp_fetch_github_text_file() {
      printf "jobs:\n  build:\n    steps:\n      - uses: actions/checkout@v4\n"
    }
    rc=0; out="$(rp_check_actions_workflow_pinning the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: consider pinning third-party Actions" <<<"$out"; } \
      || { printf "non-publish-unpinned: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rp_fetch_workflow_file_names() { printf "release.yml\n"; }
    rp_fetch_github_text_file() {
      printf "jobs:\n  publish:\n    steps:\n      - uses: pypa/gh-action-pypi-publish@release/v1\n"
    }
    rc=0; out="$(rp_check_actions_workflow_pinning the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: pin release/publish workflow actions" <<<"$out"; } \
      || { printf "publish-unpinned-routine: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # Promoted (repository-helpers#588 org-wide rollout complete): --strict-onboarding
    # alone now FAILs, matching --new-repo.
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_actions_workflow_pinning the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: release/publish workflow(s) use non-SHA-pinned actions" <<<"$out"; } \
      || { printf "strict-onboarding-alone-now-fail: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0

    rp_new_repo=1
    rc=0; out="$(rp_check_actions_workflow_pinning the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo: release/publish workflow(s) use non-SHA-pinned actions" <<<"$out"; } \
      || { printf "new-repo-publish-unpinned: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    # Regression (review #591): the per-reference detail line must come after
    # the FAIL line it explains, not before it.
    fail_line_num="$(grep -n "^FAIL: the-hcma/example-repo: release/publish" <<<"$out" | cut -d: -f1)"
    detail_line_num="$(grep -n "pypa/gh-action-pypi-publish@release/v1" <<<"$out" | cut -d: -f1)"
    { [[ -n "$fail_line_num" && -n "$detail_line_num" && "$detail_line_num" -gt "$fail_line_num" ]]; } \
      || { printf "detail-after-fail: fail_line=%s detail_line=%s out=%s\n" \
        "$fail_line_num" "$detail_line_num" "$out"; exit 1; }
    rp_new_repo=0

    rp_fetch_github_text_file() {
      printf "jobs:\n  publish:\n    steps:\n      - uses: pypa/gh-action-pypi-publish@%s\n" "$(printf "a%.0s" {1..40})"
    }
    rc=0; out="$(rp_check_actions_workflow_pinning the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && ! grep -qE "FAIL:|SUGGEST:" <<<"$out"; } \
      || { printf "sha-pinned-clean: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || pinchk_out="fail:${pinchk_out}"
rm -rf "$pinchk_dir"
unset RUNNER_SESSION_ROOT
if [[ "$pinchk_out" == 'ok' ]]; then
  printf '[PASS] rp_check_actions_workflow_pinning: generic SUGGEST always / publish-like FAIL under strict-onboarding+new-repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_actions_workflow_pinning (%s)\n' "$pinchk_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_check_deployment_env_protection (repository-helpers#588) ===\n'
envchk_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${envchk_dir}/runner-sessions"
envchk_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_compact=0; rp_suggest=1; rp_apply_fix=0; rp_strict_onboarding=0; rp_new_repo=0

    rp_fetch_workflow_file_names() { printf "release.yml\n"; }
    rp_fetch_github_text_file() {
      printf "jobs:\n  publish:\n    environment: pypi\n    steps: []\n"
    }
    rp_fetch_environment_protection() { printf %s "{\"protection_rules\":[]}"; return 0; }

    rc=0; out="$(rp_check_deployment_env_protection the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo:" <<<"$out" \
      && grep -qF "required reviewer or branch policy" <<<"$out" \
      && grep -qF "pypi" <<<"$out"; } \
      || { printf "unprotected-env-routine: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # Promoted (repository-helpers#588 org-wide rollout complete): --strict-onboarding
    # alone now FAILs, matching --new-repo.
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_deployment_env_protection the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo:" <<<"$out" \
      && grep -qF "no protection rules or branch policy" <<<"$out" \
      && grep -qF "pypi" <<<"$out"; } \
      || { printf "strict-onboarding-alone-now-fail: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0

    rp_new_repo=1
    rc=0; out="$(rp_check_deployment_env_protection the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] \
      && grep -qF "FAIL: the-hcma/example-repo:" <<<"$out" \
      && grep -qF "no protection rules or branch policy" <<<"$out" \
      && grep -qF "pypi" <<<"$out"; } \
      || { printf "new-repo-unprotected-env: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_new_repo=0

    rp_fetch_environment_protection() {
      printf %s "{\"protection_rules\":[{\"type\":\"required_reviewers\"}]}"
      return 0
    }
    rc=0; out="$(rp_check_deployment_env_protection the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && ! grep -qE "FAIL:|SUGGEST:" <<<"$out"; } \
      || { printf "protected-env-clean: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rp_fetch_github_text_file() { printf "jobs:\n  build:\n    steps: []\n"; }
    rc=0; out="$(rp_check_deployment_env_protection the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && [[ -z "$out" ]]; } \
      || { printf "no-environment-noop: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || envchk_out="fail:${envchk_out}"
rm -rf "$envchk_dir"
unset RUNNER_SESSION_ROOT
if [[ "$envchk_out" == 'ok' ]]; then
