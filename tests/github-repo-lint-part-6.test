  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_deployment_env_protection (%s)\n' "$envchk_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_gh_api_get_json treats an unmocked/empty-stderr gh call as missing, not an error ===\n'
apiget_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${apiget_dir}/runner-sessions"
apiget_bin="${apiget_dir}/bin"
mkdir -p "$apiget_bin"
cat >"${apiget_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
# No mocked endpoints at all — every call exits 1 with no stderr, exactly
# like a test fixture's `gh` stub that never mentions this new endpoint
# (repository-helpers#588: a check added here must not break every existing
# full-audit test fixture that predates it).
exit 1
MOCK_GH
chmod +x "${apiget_bin}/gh"
apiget_out="$(
  PATH="${apiget_bin}:${PATH}" bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"

    rc=0
    rp_gh_api_get_json "test" "repos/the-hcma/example-repo" >/dev/null 2>&1 || rc=$?
    [[ "$rc" == 1 ]] || { printf "expected classify-as-missing (rc=1), got rc=%s\n" "$rc"; exit 1; }

    rp_compact=0; rp_suggest=1; rp_apply_fix=0; rp_strict_onboarding=1; rp_new_repo=0
    rc=0; out="$(rp_check_github_security_settings the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && [[ -z "$out" ]]; } \
      || { printf "security-settings should skip quietly: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rc=0; out="$(rp_check_actions_hardening the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && [[ -z "$out" ]]; } \
      || { printf "actions-hardening should skip quietly: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || apiget_out="fail:${apiget_out}"
rm -rf "$apiget_dir"
unset RUNNER_SESSION_ROOT
if [[ "$apiget_out" == 'ok' ]]; then
  printf '[PASS] unmocked new-endpoint gh calls degrade to a quiet skip, matching rp_gh_path_check convention\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_gh_api_get_json / new-check graceful skip (%s)\n' "$apiget_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_check_protection_mechanism_consistency (repository-helpers#588) ===\n'
pmc_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${pmc_dir}/runner-sessions"
pmc_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_compact=0; rp_suggest=1; rp_strict_onboarding=1; rp_new_repo=0

    rp_fetch_classic_main_protection_json() {
      printf %s "{\"required_pull_request_reviews\":{\"require_code_owner_reviews\":true}}"
    }
    rp_fetch_protect_main_ruleset() {
      printf %s "{\"rules\":[{\"type\":\"pull_request\",\"parameters\":{\"require_code_owner_review\":false}}]}"
    }
    rc=0; out="$(rp_check_protection_mechanism_consistency the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] \
      && grep -qF "SUGGEST: the-hcma/example-repo: classic protection require_code_owner_reviews=true disagrees" <<<"$out"; } \
      || { printf "disagree-still-rc0: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rp_fetch_protect_main_ruleset() {
      printf %s "{\"rules\":[{\"type\":\"pull_request\",\"parameters\":{\"require_code_owner_review\":true}}]}"
    }
    rc=0; out="$(rp_check_protection_mechanism_consistency the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && [[ -z "$out" ]]; } \
      || { printf "agree-quiet: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rp_fetch_classic_main_protection_json() { printf ""; }
    rc=0; out="$(rp_check_protection_mechanism_consistency the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && [[ -z "$out" ]]; } \
      || { printf "no-classic-quiet: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || pmc_out="fail:${pmc_out}"
rm -rf "$pmc_dir"
unset RUNNER_SESSION_ROOT
if [[ "$pmc_out" == 'ok' ]]; then
  printf '[PASS] rp_check_protection_mechanism_consistency: advisory-only, even under --strict-onboarding\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rp_check_protection_mechanism_consistency (%s)\n' "$pmc_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: rp_discover_ci_status_contexts skips ci-part-* jobs (#692) ===\n'
ctx_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${ctx_dir}/runner-sessions"
ctx_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_fetch_ci_workflow_text() {
      cat <<'"'"'YAML'"'"'
jobs:
  guard:
    name: Guard
  ci-part-tests:
    name: tests
  ci-part-shellcheck:
    name: bash -n + shellcheck
  check:
    name: shellcheck + tests
  secret-scan:
    name: Secret Scan
  lint:
    runs-on: ubuntu-latest
YAML
    }
    rp_discover_ci_status_contexts "the-hcma/example" | paste -sd, -
  ' _ "$runner_bootstrap" "$lib" 2>&1
)"
rm -rf "$ctx_dir"
unset RUNNER_SESSION_ROOT
if [[ "$ctx_out" == 'shellcheck + tests,lint' ]]; then
  printf '[PASS] required contexts are the rollup and plain jobs; ci-part-* parts are skipped\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] required contexts expected "shellcheck + tests,lint"; got %s\n' "$ctx_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: ci.yml rollup keeps the required context (#692) ===\n'
ci_yml="${rh_root}/.github/workflows/ci.yml"
if awk '
    /^  check:/ { in_check = 1; next }
    in_check && /^  [a-zA-Z0-9_-]+:/ { in_check = 0 }
    in_check && /^    name: shellcheck \+ tests$/ { has_name = 1 }
    in_check && /^    needs: \[guard, ci-part-actionlint, ci-part-shellcheck, ci-part-tests\]$/ { has_needs = 1 }
    in_check && /^    if: always\(\) && / { has_always = 1 }
    END { exit !(has_name && has_needs && has_always) }
  ' "$ci_yml"; then
  printf '[PASS] ci.yml check job is named "shellcheck + tests", needs every ci-part job, and runs always()\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ci.yml check rollup must keep name, needs all ci-part jobs, and use always()\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"

if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
