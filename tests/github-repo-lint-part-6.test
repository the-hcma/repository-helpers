  && grep -qF '.agents/rules/**' "$org_rollout_rule" \
  && grep -qF 'scripts/lib/repo-practices-agents/**' "$org_rollout_rule" \
  && grep -qF 'approve-pending-deployments' "$org_rollout_rule" \
