#!/usr/bin/env bash
# Tests for scripts/lib/runner helpers.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"

lib="${script_dir}/../scripts/lib/runner"
readonly lib

test_init
pass=0
fail=0

# ---------------------------------------------------------------------------
# Static: structure
# ---------------------------------------------------------------------------

printf '\n=== static: runner structure ===\n'

lib_text="$(cat "$lib")"
assert_contains "declares run_command"           "$lib_text" "run_command()"
assert_contains "declares run_command_or_die"    "$lib_text" "run_command_or_die()"
assert_contains "declares record_first_failure"  "$lib_text" "record_first_failure()"
assert_contains "declares runner_exec"           "$lib_text" "runner_exec()"
assert_contains "declares runner_session_begin"  "$lib_text" "runner_session_begin()"
assert_contains "artifact stdout file"           "$lib_text" "_runner_artifact_stdout"
assert_contains "artifact stderr file"           "$lib_text" "_runner_artifact_stderr"
assert_contains "artifact exit_status file"      "$lib_text" "_runner_artifact_exit_status"
assert_contains "artifact cmdline file"        "$lib_text" "_runner_artifact_cmdline"
# shellcheck disable=SC2016  # static assert matches literal source text, not expanded vars
assert_contains "delegates to runner_exec"     "$lib_text" 'runner_exec "$label" --stream-stdout'
assert_not_contains "run_command does not call exit" \
  "$(awk '/^run_command\(\) \{/{found=1; next} found && /^\}$/{exit} found' "$lib" \
      | grep -E '^\s+exit\b' || true)" \
  "exit"

# run_command must call record_first_failure on failure
assert_contains "declares runner_last_failure_capture_stderr" "$lib_text" "runner_last_failure_capture_stderr()"
assert_contains "run_command calls record_first_failure on failure" \
  "$(awk '/^run_command\(\) \{/{found=1; next} found && /^\}$/{exit} found' "$lib")" \
  'record_first_failure'

# ---------------------------------------------------------------------------
# Behavioural: source the lib
# ---------------------------------------------------------------------------

# shellcheck disable=SC1090  # dynamic path; resolved at runtime
source "$lib"

# ---------------------------------------------------------------------------
# run_command: success path
# ---------------------------------------------------------------------------

printf '\n=== run_command: success ===\n'

rc=0
out="$(run_command "success test" echo "hello")" || rc=$?
assert_exit_0 "run_command success" "$out" "$rc"
assert_contains "stdout passes through" "$out" "hello"

# No stderr output on success
stderr_out="$(run_command "success quiet" true 2>&1)"
if [[ -z "$stderr_out" ]]; then
  pass_case "run_command: no stderr on success"
else
  printf '[FAIL] run_command: unexpected stderr on success: %s\n' "$stderr_out"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# run_command: failure path
# ---------------------------------------------------------------------------

printf '\n=== run_command: failure ===\n'

rc=0
stderr_out="$(run_command "failure test" bash -c 'echo "diag message" >&2; exit 3' 2>&1)" || rc=$?
assert_exit_nonzero "run_command failure" "$stderr_out" "$rc"

if [[ "$rc" -eq 3 ]]; then
  pass_case "run_command: preserves original exit code (3)"
else
  printf '[FAIL] run_command: expected exit 3, got %d\n' "$rc"
  fail=$(( fail + 1 ))
fi

assert_contains "prints label"      "$stderr_out" "[FAIL] failure test"
assert_contains "prints exit code"  "$stderr_out" "exit code: 3"
assert_contains "prints stderr"     "$stderr_out" "diag message"

# ---------------------------------------------------------------------------
# run_command: empty stderr on failure still prints block
# ---------------------------------------------------------------------------

printf '\n=== run_command: failure with no stderr ===\n'

rc=0
stderr_out="$(run_command "silent fail" bash -c 'exit 2' 2>&1)" || rc=$?
assert_exit_nonzero "run_command silent fail" "$stderr_out" "$rc"
assert_contains "prints label on silent fail"     "$stderr_out" "[FAIL] silent fail"
assert_contains "prints exit code on silent fail" "$stderr_out" "exit code: 2"

# ---------------------------------------------------------------------------
# run_command: stdout passes through (caller can redirect)
# ---------------------------------------------------------------------------

printf '\n=== run_command: stdout redirection ===\n'

tmp_out="$(mktemp)"
rc=0
run_command "stdout redirect" bash -c 'echo "captured"' >"$tmp_out" || rc=$?
assert_exit_0 "stdout redirect: exits 0" "" "$rc"
out_content="$(cat "$tmp_out")"
assert_contains "stdout redirected to file" "$out_content" "captured"
rm -f "$tmp_out"

# ---------------------------------------------------------------------------
# run_command_or_die: success path
# ---------------------------------------------------------------------------

printf '\n=== run_command_or_die: success ===\n'

rc=0
out="$(run_command_or_die "die success" echo "ok")" || rc=$?
assert_exit_0     "run_command_or_die success" "$out" "$rc"
assert_contains   "run_command_or_die stdout"  "$out" "ok"

# ---------------------------------------------------------------------------
# run_command_or_die: failure path (run in subshell to catch exit)
# ---------------------------------------------------------------------------

printf '\n=== run_command_or_die: failure exits ===\n'

rc=0
stderr_out="$(
  bash -c "
    source \"$lib\"
    run_command_or_die \"die label\" bash -c 'echo boom >&2; exit 5'
  " 2>&1
)" || rc=$?

assert_exit_nonzero "run_command_or_die exits on failure" "$stderr_out" "$rc"
if [[ "$rc" -eq 5 ]]; then
  pass_case "run_command_or_die: exits with original code (5)"
else
  printf '[FAIL] run_command_or_die: expected exit 5, got %d\n' "$rc"
  fail=$(( fail + 1 ))
fi
assert_contains "run_command_or_die: prints label"     "$stderr_out" "[FAIL] die label"
assert_contains "run_command_or_die: prints exit code" "$stderr_out" "exit code: 5"
assert_contains "run_command_or_die: prints stderr"    "$stderr_out" "boom"

# ---------------------------------------------------------------------------
# record_first_failure
# ---------------------------------------------------------------------------

printf '\n=== record_first_failure: writes on first call ===\n'

ff_file="$(mktemp)"
RUNNER_FIRST_FAILURE_FILE="$ff_file"
export RUNNER_FIRST_FAILURE_FILE

record_first_failure "first error"
ff_content="$(cat "$ff_file")"
assert_contains "record_first_failure writes reason" "$ff_content" "first error"

printf '\n=== record_first_failure: only first call takes effect ===\n'

record_first_failure "second error"
ff_content2="$(cat "$ff_file")"
assert_contains     "record_first_failure: first call preserved" "$ff_content2" "first error"
assert_not_contains "record_first_failure: second call ignored"  "$ff_content2" "second error"
rm -f "$ff_file"
unset RUNNER_FIRST_FAILURE_FILE

printf '\n=== record_first_failure: no-op when env var unset ===\n'

record_first_failure "should not crash" 2>/dev/null
pass_case "record_first_failure: no-op when RUNNER_FIRST_FAILURE_FILE is unset"

printf '\n=== run_command: writes first failure to RUNNER_FIRST_FAILURE_FILE ===\n'

ff_file2="$(mktemp)"
RUNNER_FIRST_FAILURE_FILE="$ff_file2"
export RUNNER_FIRST_FAILURE_FILE
runner_session_end 2>/dev/null || true
unset RUNNER_SESSION_DIR
runner_session_begin

run_command "my-label" bash -c 'echo "the error" >&2; exit 1' 2>/dev/null || true
ff_content3="$(cat "$ff_file2")"
assert_contains "run_command records label in failure file" "$ff_content3" "my-label"
assert_contains "run_command records stderr in failure file" "$ff_content3" "the error"
rm -f "$ff_file2"
unset RUNNER_FIRST_FAILURE_FILE

# ---------------------------------------------------------------------------
# Session: UUID artifacts
# ---------------------------------------------------------------------------

printf '\n=== runner session: UUID artifacts ===\n'

runner_session_end 2>/dev/null || true
unset RUNNER_SESSION_DIR
RUNNER_SESSION_KEEP=1
export RUNNER_SESSION_KEEP
runner_session_begin

rc=0
runner_exec "artifact ok" -- echo "out-data" >/dev/null || rc=$?
assert_exit_0 "runner_exec success" "" "$rc"

ok_id="$(runner_last_id)"
if [[ -n "$ok_id" ]]; then
  pass_case "runner_last_id returns id"
else
  printf '[FAIL] runner_last_id returned empty\n'
  fail=$(( fail + 1 ))
fi

assert_contains "cmdline artifact exists" "$(runner_read "$ok_id" cmdline)" "echo"
assert_contains "stdout artifact" "$(runner_read "$ok_id" stdout)" "out-data"
assert_contains "exit_status zero" "$(runner_read_exit "$ok_id")" "0"

rc=0
runner_exec "artifact fail" -- bash -c 'echo err >&2; echo out; exit 9' >/dev/null 2>/dev/null || rc=$?
fail_id="$(runner_last_id)"
assert_exit_nonzero "runner_exec failure rc" "" "$rc"
if [[ "$rc" -eq 9 ]]; then
  pass_case "runner_exec preserves exit code 9"
else
  printf '[FAIL] runner_exec: expected exit 9, got %d\n' "$rc"
  fail=$(( fail + 1 ))
fi

failed_ids="$(runner_session_failed_ids)"
assert_contains "failed_ids lists failure" "$failed_ids" "$fail_id"
assert_contains "stderr artifact" "$(runner_read "$fail_id" stderr)" "err"
assert_contains "stdout artifact on failure" "$(runner_read "$fail_id" stdout)" "out"

diag="$(runner_format_failure "$fail_id")"
assert_contains "format_failure label" "$diag" "[FAIL] artifact fail"
assert_contains "format_failure stderr block" "$diag" "err"
assert_contains "format_failure stdout block" "$diag" "out"

printf '\n=== runner_sh: pipeline capture ===\n'

rc=0
runner_sh "pipe test" 'printf one; printf two' >/dev/null || rc=$?
assert_exit_0 "runner_sh success" "" "$rc"
pipe_id="$(runner_last_id)"
assert_contains "runner_sh stdout" "$(runner_read "$pipe_id" stdout)" "onetwo"

runner_session_end
unset RUNNER_SESSION_KEEP RUNNER_SESSION_DIR

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
