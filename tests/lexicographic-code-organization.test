#!/usr/bin/env bash
# Static checks for the org lexicographic code-organization Cursor rule (#474).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

rule="${rh_root}/.agents/rules/lexicographic-code-organization.md"
shim="${rh_root}/.cursor/rules/lexicographic-code-organization.mdc"
readonly rule
readonly shim

pass=0
fail=0

printf '\n=== static: lexicographic-code-organization agents rule ===\n'
if [[ -f "$rule" ]] \
  && [[ -f "$shim" ]] \
  && grep -qF 'alwaysApply: true' "$rule" \
  && grep -qFi 'ASCII lexicographically' "$rule" \
  && grep -qFi 'Insert' "$rule" \
  && grep -qFi 'public' "$rule" \
  && grep -qFi 'private' "$rule" \
  && grep -qFi 'Dunder methods' "$rule" \
  && grep -qFi 'frozenset' "$rule" \
  && grep -qFi 'closed-set' "$rule" \
  && grep -qFi 'Enum members' "$rule" \
  && grep -qFi 'Tuple / list' "$rule" \
  && grep -qFi 'order-sensitive' "$rule" \
  && grep -qFi 'class-level members' "$rule" \
  && grep -qF 'agents-rule-shim: lexicographic-code-organization' "$shim"; then
  printf '[PASS] lexicographic-code-organization agents rule exists with public/private + closed-set guidance (+ shim)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected .agents/rules/lexicographic-code-organization.md with public/private and frozenset/closed-set (+ shim)\n'
  fail=$(( fail + 1 ))
fi

if grep -qE 'lexicographic-code-organization\.(mdc|md)' "${rh_root}/AGENTS.md" \
  && grep -qFi 'copy' "${rh_root}/AGENTS.md" \
  && grep -qFi 'symlink' "${rh_root}/AGENTS.md"; then
  printf '[PASS] AGENTS.md documents lexicographic-code-organization consumer adoption\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] AGENTS.md must mention lexicographic-code-organization with copy/symlink guidance\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf 'Passed: %s\n' "$pass"
printf 'Failed: %s\n' "$fail"
if (( fail > 0 )); then
  exit 1
fi
exit 0
