#!/usr/bin/env bash
# Static checks for the org lexicographic code-organization Cursor rule (#474).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

rule="${rh_root}/.cursor/rules/lexicographic-code-organization.mdc"
readonly rule

pass=0
fail=0

printf '\n=== static: lexicographic-code-organization cursor rule ===\n'
if [[ -f "$rule" ]] \
  && grep -qF 'alwaysApply: true' "$rule" \
  && grep -qF 'public' "$rule" \
  && grep -qF 'private' "$rule" \
  && grep -qFi 'frozenset' "$rule" \
  && grep -qFi 'closed-set' "$rule"; then
  printf '[PASS] lexicographic-code-organization rule exists with public/private + closed-set guidance\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected .cursor/rules/lexicographic-code-organization.mdc with public/private and frozenset/closed-set\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'lexicographic-code-organization.mdc' "${rh_root}/AGENTS.md"; then
  printf '[PASS] AGENTS.md documents lexicographic-code-organization consumer adoption\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] AGENTS.md must mention lexicographic-code-organization.mdc\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf 'Passed: %s\n' "$pass"
printf 'Failed: %s\n' "$fail"
if (( fail > 0 )); then
  exit 1
fi
exit 0
