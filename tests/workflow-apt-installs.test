#!/usr/bin/env bash
# Every apt-get call in a workflow carries timeouts and bounded retries
# (.agents/rules/remote-timeouts-retries.md).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
workflows_dir="${script_dir}/../.github/workflows"
readonly workflows_dir

pass=0
fail=0

printf '\n=== static: apt-get calls in workflows have timeouts and retries ===\n'
checked=0
for wf in "$workflows_dir"/*.yml; do
  # Join backslash continuations so each apt-get invocation is one line.
  joined="$(sed -e ':a' -e '/\\$/N; s/\\\n[[:space:]]*/ /; ta' "$wf")"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    checked=$(( checked + 1 ))
    http_timeout=''
    https_timeout=''
    retries=''
    [[ "$line" =~ Acquire::http::Timeout=([0-9]+) ]] && http_timeout="${BASH_REMATCH[1]}"
    [[ "$line" =~ Acquire::https::Timeout=([0-9]+) ]] && https_timeout="${BASH_REMATCH[1]}"
    [[ "$line" =~ Acquire::Retries=([0-9]+) ]] && retries="${BASH_REMATCH[1]}"
    # Timeouts must be positive and at most 300 seconds; retries a small fixed N (2 to 5), as
    # .agents/rules/remote-timeouts-retries.md asks.
    if [[ -n "$http_timeout" && -n "$https_timeout" && -n "$retries" ]] \
      && (( 10#$http_timeout >= 1 && 10#$http_timeout <= 300 )) \
      && (( 10#$https_timeout >= 1 && 10#$https_timeout <= 300 )) \
      && (( 10#$retries >= 2 && 10#$retries <= 5 )); then
      printf '[PASS] %s: apt-get call has bounded timeouts (%ss/%ss) and retries (%s)\n' \
        "$(basename "$wf")" "$http_timeout" "$https_timeout" "$retries"
      pass=$(( pass + 1 ))
    else
      printf '[FAIL] %s: apt-get call lacks bounded timeouts or retries: %s\n' "$(basename "$wf")" "$line"
      fail=$(( fail + 1 ))
    fi
  done < <(grep -E '(^|[[:space:]])apt-get[[:space:]]' <<<"$joined" || true)
done

if (( checked > 0 )); then
  printf '[PASS] found %d apt-get call(s) to check\n' "$checked"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected to find apt-get calls in the workflows\n'
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
