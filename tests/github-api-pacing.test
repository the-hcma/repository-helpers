#!/usr/bin/env bash
# Tests for the shared GitHub API pacing gate (repository-helpers#710): every caller on the host
# coordinates through one state directory (blocked_until, quota, next_slot, calls) so concurrent
# workers share a single budget and a single backoff. gh and sleep are mocked, so nothing here
# talks to GitHub or waits.
# shellcheck disable=SC2016  # the bash -c programs are literal strings expanded by the child shell
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/github-api-rate-limit"
runner_bootstrap="${script_dir}/../scripts/lib/runner-bootstrap"
readonly lib runner_bootstrap

tmp="$(mktemp -d)"
readonly tmp
trap 'rm -rf "$tmp"' EXIT

mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

# gh: serves core headers for `--include zen` from $MOCK_GH_ZEN, a deliberately wrong "always full"
# core figure for `--include rate_limit`, and logs every call.
cat >"${mock_bin}/gh" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${MOCK_GH_LOG:?}"
case "$*" in
  *'--include zen'*)
    if [[ -n "${MOCK_STATE_DIR:-}" ]]; then
      if [[ -d "${MOCK_STATE_DIR}/lock" ]]; then
        printf 'held\n' >>"${MOCK_STATE_DIR}/../probe-lock-state"
      else
        printf 'free\n' >>"${MOCK_STATE_DIR}/../probe-lock-state"
      fi
    fi
    cat -- "${MOCK_GH_ZEN:?}"
    ;;
  *'--include rate_limit'*)
    printf 'HTTP/2.0 200 OK\r\nX-Ratelimit-Remaining: 5000\r\nX-Ratelimit-Reset: %s\r\nX-Ratelimit-Resource: core\r\n\r\n{}\n' \
      "$(( $(date +%s) + 3600 ))"
    ;;
  *'rate_limit'*'--jq'*)
    printf 'true\n'
    ;;
  *)
    printf 'ok\n'
    ;;
esac
MOCK
# sleep: records the request. Lock-spin sleeps (0.01) are real so concurrent callers still
# interleave; a hook script stands in for "time passed" during pacing waits.
cat >"${mock_bin}/sleep" <<'MOCK'
#!/usr/bin/env bash
if [[ "$1" == "0.05" ]]; then
  exec /bin/sleep 0.05
fi
if [[ "$1" == "0.01" ]]; then
  # Lock-spin sleep. MOCK_LOCK_RELEASE_AFTER=N releases the held lock after N spins, standing in
  # for the holder finishing.
  if [[ -n "${MOCK_LOCK_RELEASE_AFTER:-}" ]]; then
    n="$(cat -- "${MOCK_SPIN_COUNT:?}" 2>/dev/null || printf 0)"
    n=$(( n + 1 ))
    printf '%s' "$n" >"$MOCK_SPIN_COUNT"
    if (( n >= MOCK_LOCK_RELEASE_AFTER )); then
      rm -rf -- "${MOCK_LOCK_DIR:?}"
    fi
  fi
  exec /bin/sleep 0.01
fi
printf '%s\n' "$1" >>"${MOCK_SLEEP_LOG:?}"
if [[ -n "${MOCK_SLEEP_HOOK:-}" && -x "${MOCK_SLEEP_HOOK}" ]]; then
  "${MOCK_SLEEP_HOOK}"
fi
exit 0
MOCK
chmod +x "${mock_bin}/gh" "${mock_bin}/sleep"

zen_headers() {
  local -r remaining="$1" reset="$2"
  printf 'HTTP/2.0 200 OK\r\nX-Ratelimit-Limit: 5000\r\nX-Ratelimit-Remaining: %s\r\nX-Ratelimit-Reset: %s\r\nX-Ratelimit-Resource: core\r\nX-Ratelimit-Used: %s\r\n\r\nKeep it logically awesome.\n' \
    "$remaining" "$reset" "$(( 5000 - remaining ))"
}

# new_case <name>: fresh state dir, logs and a zen fixture; sets case_* globals.
new_case() {
  case_dir="${tmp}/$1"
  case_state="${case_dir}/state"
  mkdir -p "$case_dir"
  case_gh_log="${case_dir}/gh.log"
  case_sleep_log="${case_dir}/sleep.log"
  case_zen="${case_dir}/zen"
  : >"$case_gh_log"
  : >"$case_sleep_log"
  zen_headers 4000 "$(( EPOCHSECONDS + 3000 ))" >"$case_zen"
}

# Like the real --jobs workers, each concurrent caller gets a private runner sub-session: one
# session shares a single .order file, so concurrent probes would read each other's results.
read -r -d '' gate_prelude <<'PRELUDE' || true
spawn_gate_worker() {
  (
    RUNNER_SESSION_DIR="${RUNNER_SESSION_DIR}/gate-$1"
    mkdir -p -- "$RUNNER_SESSION_DIR"
    export RUNNER_SESSION_DIR
    github_api_pace_gate "worker-$1"
  ) &
}
PRELUDE

# run_lib <code>: runs <code> with the library loaded and pacing enabled against $case_state.
run_lib() {
  env PATH="${mock_bin}:${PATH}" \
    GITHUB_API_PACING=1 GITHUB_API_STATE_DIR="$case_state" \
    MOCK_GH_LOG="$case_gh_log" MOCK_GH_ZEN="$case_zen" MOCK_SLEEP_LOG="$case_sleep_log" \
    MOCK_SLEEP_HOOK="${MOCK_SLEEP_HOOK:-}" MOCK_STATE_DIR="$case_state" \
    GITHUB_API_QUOTA_RESERVE="${GITHUB_API_QUOTA_RESERVE:-200}" \
    GITHUB_API_PACE_LOCK="${pace_lock_mode:-}" \
    GATE_PRELUDE="$gate_prelude" \
    bash -c 'source "$1"; source "$2"; eval "$GATE_PRELUDE"; eval "$3"' \
    bash "$runner_bootstrap" "$lib" "$1"
}

read_state() {
  local line=''
  read -r line <"${case_state}/$1" 2>/dev/null || true
  printf '%s' "$line"
}

printf '\n=== pacing: concurrent callers share one quota, slot sequence and call count (mkdir lock) ===\n'
new_case concurrent-mkdir
mkdir -p "$case_state"
now="$EPOCHSECONDS"
printf '%s %s %s\n' 1000 "$(( now + 3000 ))" "$now" >"${case_state}/quota"
start_us="${EPOCHREALTIME/./}"
pace_lock_mode='mkdir'
run_lib '
  for i in 1 2 3 4 5 6 7 8; do
    spawn_gate_worker "$i"
  done
  wait
' >"${case_dir}/out" 2>&1
quota_after="$(read_state quota)"
read -r remaining_after _ <<<"$quota_after"
assert_contains "eight concurrent gates leave exactly 992 of 1000 calls (no lost update) (mkdir lock)" \
  "remaining=${remaining_after}" "remaining=992"
assert_contains "the shared call counter admitted all eight callers (mkdir lock)" \
  "calls=$(read_state calls)" "calls=8"
next_slot="$(read_state next_slot)"
if (( next_slot >= start_us + 8 * 100000 )); then
  pass_case "eight callers reserved eight distinct 100 ms slots"
else
  fail_case "eight callers reserved eight distinct 100 ms slots (next_slot=${next_slot} start=${start_us})"
fi
assert_not_contains "a fresh cached quota is not re-probed (mkdir lock)" "$(cat "$case_gh_log")" "zen"

printf '\n=== pacing: concurrent callers share one quota, slot sequence and call count (default lock) ===\n'
new_case concurrent-default
mkdir -p "$case_state"
now="$EPOCHSECONDS"
printf '%s %s %s\n' 1000 "$(( now + 3000 ))" "$now" >"${case_state}/quota"
start_us="${EPOCHREALTIME/./}"
pace_lock_mode=
run_lib '
  for i in 1 2 3 4 5 6 7 8; do
    spawn_gate_worker "$i"
  done
  wait
' >"${case_dir}/out" 2>&1
quota_after="$(read_state quota)"
read -r remaining_after _ <<<"$quota_after"
assert_contains "eight concurrent gates leave exactly 992 of 1000 calls (no lost update) (default lock)" \
  "remaining=${remaining_after}" "remaining=992"
assert_contains "the shared call counter admitted all eight callers (default lock)" \
  "calls=$(read_state calls)" "calls=8"
next_slot="$(read_state next_slot)"
if (( next_slot >= start_us + 8 * 100000 )); then
  pass_case "eight callers reserved eight distinct 100 ms slots"
else
  fail_case "eight callers reserved eight distinct 100 ms slots (next_slot=${next_slot} start=${start_us})"
fi
assert_not_contains "a fresh cached quota is not re-probed (default lock)" "$(cat "$case_gh_log")" "zen"

printf '\n=== pacing: the gate is silent on stderr when nothing is wrong ===\n'
new_case quiet
quiet_err="$(run_lib 'github_api_pace_gate first; github_api_pace_gate second' 2>&1 >/dev/null)"
assert_contains "first use of a fresh state directory prints nothing to stderr" "stderr=[${quiet_err}]" "stderr=[]"

printf '\n=== pacing: a stale quota is probed once, however many callers race (mkdir lock) ===\n'
new_case singleflight-mkdir
mkdir -p "$case_state"
printf '%s %s %s\n' 10 "$(( EPOCHSECONDS + 3000 ))" "$(( EPOCHSECONDS - 500 ))" >"${case_state}/quota"
zen_headers 4000 "$(( EPOCHSECONDS + 3000 ))" >"$case_zen"
pace_lock_mode='mkdir'
run_lib '
  for i in 1 2 3 4 5 6; do
    spawn_gate_worker "$i"
  done
  wait
' >"${case_dir}/out" 2>&1
probe_count="$(grep -c -- '--include zen' "$case_gh_log" || true)"
assert_contains "six racing callers trigger exactly one quota probe (mkdir lock)" "probes=${probe_count}" "probes=1"
read -r remaining_after _ <<<"$(read_state quota)"
assert_contains "the probed quota (4000) is shared and decremented once per caller (mkdir lock)" \
  "remaining=${remaining_after}" "remaining=3994"

printf '\n=== pacing: a stale quota is probed once, however many callers race (default lock) ===\n'
new_case singleflight-default
mkdir -p "$case_state"
printf '%s %s %s\n' 10 "$(( EPOCHSECONDS + 3000 ))" "$(( EPOCHSECONDS - 500 ))" >"${case_state}/quota"
zen_headers 4000 "$(( EPOCHSECONDS + 3000 ))" >"$case_zen"
pace_lock_mode=
run_lib '
  for i in 1 2 3 4 5 6; do
    spawn_gate_worker "$i"
  done
  wait
' >"${case_dir}/out" 2>&1
probe_count="$(grep -c -- '--include zen' "$case_gh_log" || true)"
assert_contains "six racing callers trigger exactly one quota probe (default lock)" "probes=${probe_count}" "probes=1"
read -r remaining_after _ <<<"$(read_state quota)"
assert_contains "the probed quota (4000) is shared and decremented once per caller (default lock)" \
  "remaining=${remaining_after}" "remaining=3994"

printf '\n=== pacing: a failed quota probe is treated as unknown, never as stale data ===\n'
new_case probefail
mkdir -p "$case_state"
# Stale cached quota that would trip the reserve if it were trusted; the probe returns nothing.
printf '%s %s %s\n' 10 "$(( EPOCHSECONDS + 3000 ))" "$(( EPOCHSECONDS - 500 ))" >"${case_state}/quota"
: >"$case_zen"
out="$(run_lib 'github_api_pace_gate a; github_api_pace_gate b; github_api_pace_gate c; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "callers are not blocked by a stale quota when the probe fails" "$out" "EC=0"
assert_not_contains "no reserve stop is taken from stale data" "$out" "GITHUB_API_PACE_RESERVE"
probe_count="$(grep -c -- '--include zen' "$case_gh_log" || true)"
assert_contains "a failing probe is not retried by every caller within the TTL" "probes=${probe_count}" "probes=1"

printf '\n=== pacing: blocked_until stops every caller until it passes ===\n'
new_case blocked
mkdir -p "$case_state"
printf '%s\n' "$(( EPOCHSECONDS + 40 ))" >"${case_state}/blocked_until"
hook="${case_dir}/hook"
printf '#!/usr/bin/env bash\nprintf "0\\n" >"%s/blocked_until"\n' "$case_state" >"$hook"
chmod +x "$hook"
out="$(MOCK_SLEEP_HOOK="$hook" run_lib 'github_api_pace_gate "late-worker"; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "caller waits for the shared block" "$out" "GITHUB_API_PACE_WAIT label=late-worker"
assert_contains "caller sleeps at most one poll chunk at a time" "$(cat "$case_sleep_log")" "30"
assert_contains "caller proceeds once the block is lifted" "$out" "EC=0"

printf '\n=== pacing: stopping at the reserve waits for the reset instead of failing ===\n'
new_case reserve
mkdir -p "$case_state"
reset_epoch="$(( EPOCHSECONDS + 300 ))"
printf '%s %s %s\n' 150 "$reset_epoch" "$EPOCHSECONDS" >"${case_state}/quota"
hook="${case_dir}/hook"
cat >"$hook" <<HOOK
#!/usr/bin/env bash
cp -- "${case_state}/blocked_until" "${case_dir}/seen_block"
printf '0\n' >"${case_state}/blocked_until"
printf '5000 %s %s\n' "$(( EPOCHSECONDS + 3000 ))" "$EPOCHSECONDS" >"${case_state}/quota"
HOOK
chmod +x "$hook"
out="$(MOCK_SLEEP_HOOK="$hook" run_lib 'github_api_pace_gate "reserve-worker"; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "caller reports it stopped at the reserve" "$out" "GITHUB_API_PACE_RESERVE label=reserve-worker remaining=150 reserve=200"
assert_contains "the shared block is the quota reset plus the clock-skew cushion" \
  "block=$(cat "${case_dir}/seen_block")" "block=$(( reset_epoch + 2 ))"
assert_contains "caller proceeds after the reset" "$out" "EC=0"

printf '\n=== pacing: one rate-limit wait blocks every other caller ===\n'
new_case publish
mkdir -p "$case_state"
reset_epoch="$(( EPOCHSECONDS + 5 ))"
zen_headers 0 "$reset_epoch" >"$case_zen"
out="$(run_lib 'github_api_rate_limit_max_wait_s=7; github_api_wait_for_rate_limit "API rate limit exceeded for user ID 9" "" 1 || true' 2>&1)"
assert_contains "the wait publishes its deadline for other callers" \
  "block=$(read_state blocked_until)" "block=$(( reset_epoch + 2 ))"
assert_contains "primary depletion is read from real response headers" "$out" "source=header_depleted"
assert_not_contains "a full /rate_limit core figure does not select the quota-intact ladder" "$out" "QUOTA_INTACT"

printf '\n=== pacing: fail-open and opt-out ===\n'
new_case unusable
: >"${case_dir}/not-a-dir"
case_state="${case_dir}/not-a-dir/state"
out="$(run_lib 'github_api_pace_gate a; github_api_pace_gate b; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "an unusable state directory fails open with one NOTE" "$out" "GITHUB_API_PACE_DISABLED reason=state_dir_unusable"
assert_contains "an unusable state directory never blocks the caller" "$out" "EC=0"
note_count="$(grep -c 'GITHUB_API_PACE_DISABLED' <<<"$out" || true)"
assert_contains "the fail-open NOTE is printed once" "notes=${note_count}" "notes=1"

new_case disabled
out="$(GITHUB_API_PACING=0 env PATH="${mock_bin}:${PATH}" GITHUB_API_PACING=0 GITHUB_API_STATE_DIR="$case_state" \
  MOCK_GH_LOG="$case_gh_log" MOCK_GH_ZEN="$case_zen" MOCK_SLEEP_LOG="$case_sleep_log" \
  bash -c 'source "$1"; source "$2"; github_api_pace_gate x; printf "EC=%s\n" "$?"' bash "$runner_bootstrap" "$lib" 2>&1)"
assert_contains "GITHUB_API_PACING=0 skips the gate" "$out" "EC=0"
if [[ ! -e "$case_state" ]]; then
  pass_case "GITHUB_API_PACING=0 never creates the state directory"
else
  fail_case "GITHUB_API_PACING=0 never creates the state directory"
fi

printf '\n=== pacing: the mkdir fallback lock respects a live holder and breaks only an old one ===\n'
new_case lockfresh
mkdir -p "${case_state}/lock"
printf '%s\n' "$EPOCHSECONDS" >"${case_state}/lock/since"
printf '%s %s %s\n' 1000 "$(( EPOCHSECONDS + 3000 ))" "$EPOCHSECONDS" >"${case_state}/quota"
pace_lock_mode='mkdir'
out="$(MOCK_LOCK_RELEASE_AFTER=40 MOCK_SPIN_COUNT="${case_dir}/spins" MOCK_LOCK_DIR="${case_state}/lock" \
  run_lib 'github_api_pace_gate holder-wait; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "a caller waits out a fresh lock instead of breaking it" "spins=$(cat "${case_dir}/spins")" "spins=40"
assert_contains "the caller then proceeds normally" "$out" "EC=0"
read -r remaining_after _ <<<"$(read_state quota)"
assert_contains "the caller counted its call once the lock was free" "remaining=${remaining_after}" "remaining=999"

new_case lockstale
mkdir -p "${case_state}/lock"
printf '%s\n' "$(( EPOCHSECONDS - 120 ))" >"${case_state}/lock/since"
printf '%s %s %s\n' 1000 "$(( EPOCHSECONDS + 3000 ))" "$EPOCHSECONDS" >"${case_state}/quota"
pace_lock_mode='mkdir'
out="$(run_lib 'github_api_pace_gate crashed-holder; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "a lock held for over 30 s (crashed holder) is broken" "$out" "EC=0"
assert_not_contains "breaking a stale lock needs no lock-timeout fallback" "$out" "lock_timeout"
read -r remaining_after _ <<<"$(read_state quota)"
assert_contains "the caller counted its call after breaking the stale lock" "remaining=${remaining_after}" "remaining=999"

pace_lock_mode=
printf '\n=== pacing: the quota probe never runs while the state lock is held ===\n'
new_case probeunlocked
mkdir -p "$case_state"
printf '%s %s %s\n' 10 "$(( EPOCHSECONDS + 3000 ))" "$(( EPOCHSECONDS - 500 ))" >"${case_state}/quota"
pace_lock_mode='mkdir'
run_lib 'github_api_pace_gate prober' >"${case_dir}/out" 2>&1
assert_contains "the zen probe runs with the mkdir lock released" "$(cat "${case_dir}/probe-lock-state")" "free"
assert_not_contains "the zen probe never sees the mkdir lock held" "$(cat "${case_dir}/probe-lock-state")" "held"
pace_lock_mode=
assert_contains "the probe has an explicit short timeout" "$(grep -c -- '--probe --timeout 5 -- gh api --include zen' "$lib" || true)" "1"

printf '\n=== pacing: a prober only clears the probe marker it published ===\n'
new_case probemarker
mkdir -p "$case_state"
printf '%s\n' 5000 >"${case_state}/probing_until"
run_lib '_github_api_pace_clear_probe_marker "$GITHUB_API_STATE_DIR" 4000' >"${case_dir}/out" 2>&1 || true
assert_contains "a newer prober's marker survives a slow prober's cleanup" "$(read_state probing_until)" "5000"
run_lib '_github_api_pace_clear_probe_marker "$GITHUB_API_STATE_DIR" 5000' >"${case_dir}/out" 2>&1 || true
assert_contains "the prober's own marker is cleared" "$(read_state probing_until)" "0"
assert_contains "a relock failure after the probe makes a second attempt" \
  "$(awk '/probed="\$\(_github_api_pace_probe_quota\)"/{f=1} f&&/_github_api_pace_lock "\$state_dir"/{c++} /^}/{f=0} END{print c}' "$lib")" "2"

printf '\n=== pacing: a block published since the caller looked is honored under the lock ===\n'
new_case lateblock
mkdir -p "$case_state"
printf '%s %s %s\n' 1000 "$(( EPOCHSECONDS + 3000 ))" "$EPOCHSECONDS" >"${case_state}/quota"
printf '%s\n' "$(( EPOCHSECONDS + 60 ))" >"${case_state}/blocked_until"
out="$(run_lib '_github_api_pace_dir; ec=0; _github_api_pace_claim "$_github_api_pace_dir_value" late || ec=$?; printf "CLAIM=%s\n" "$ec"' 2>&1)"
assert_contains "a stale-zero reader is turned back when a block exists" "$out" "CLAIM=10"
read -r remaining_after _ <<<"$(read_state quota)"
assert_contains "the turned-back caller did not spend a call" "remaining=${remaining_after}" "remaining=1000"
late_block="$(( EPOCHSECONDS + 9000 ))"
printf '%s\n' "$late_block" >"${case_state}/blocked_until"
printf '%s %s %s\n' 100 "$(( EPOCHSECONDS + 300 ))" "$EPOCHSECONDS" >"${case_state}/quota"
out="$(run_lib '_github_api_pace_dir; ec=0; _github_api_pace_claim "$_github_api_pace_dir_value" reserve || ec=$?; printf "CLAIM=%s\n" "$ec"' 2>&1)"
assert_contains "the reserve path does not lower a later published block" "block=$(read_state blocked_until)" "block=${late_block}"

printf '\n=== pacing: an extra core probe is only made when the 403 is inconclusive ===\n'
new_case probeskip
mkdir -p "$case_state"
depleted_hdrs="HTTP/2.0 403 Forbidden\r\nX-Ratelimit-Remaining: 0\r\nX-Ratelimit-Reset: $(( EPOCHSECONDS + 3 ))\r\nX-Ratelimit-Resource: core\r\n\r\n"
run_lib 'github_api_rate_limit_max_wait_s=4; hdrs="$(printf "'"${depleted_hdrs}"'")"; github_api_wait_for_rate_limit "API rate limit exceeded for user ID 9" "$hdrs" 1 || true' >"${case_dir}/out" 2>&1
assert_not_contains "headers already showing depletion cost no extra probe" "$(cat "$case_gh_log")" "zen"
: >"$case_gh_log"
retry_hdrs="HTTP/2.0 403 Forbidden\r\nRetry-After: 2\r\n\r\n"
run_lib 'github_api_rate_limit_max_wait_s=4; hdrs="$(printf "'"${retry_hdrs}"'")"; github_api_wait_for_rate_limit "You have exceeded a secondary rate limit" "$hdrs" 1 || true' >"${case_dir}/out" 2>&1
assert_not_contains "an explicit Retry-After costs no extra probe" "$(cat "$case_gh_log")" "zen"

printf '\n=== pacing: one wait probes the core quota once, not per check ===\n'
new_case probereuse
mkdir -p "$case_state"
: >"$case_gh_log"
run_lib '_github_api_core_probe_clean_at=0; _github_api_quota_intact_suspect || true; _github_api_quota_intact_suspect || true; _github_api_quota_intact_suspect || true' >"${case_dir}/out" 2>&1
assert_contains "repeated intact checks within the TTL probe zen once" "$(grep -c 'zen' "$case_gh_log" || true)" "1"
: >"$case_gh_log"
run_lib 'GITHUB_API_QUOTA_TTL_S=0; _github_api_core_probe_clean_at=0; _github_api_quota_intact_suspect || true; _github_api_quota_intact_suspect || true' >"${case_dir}/out" 2>&1
assert_contains "a zero TTL probes every time" "$(grep -c 'zen' "$case_gh_log" || true)" "2"
: >"$case_gh_log"
run_lib 'GITHUB_API_RATE_LIMIT_QUOTA_INTACT_FAIL_FAST=1; github_api_rate_limit_max_wait_s=4; github_api_wait_for_rate_limit "API rate limit exceeded for user ID 9" "$(printf "HTTP/2.0 403 Forbidden\r\n\r\n")" 1 || true' >"${case_dir}/out" 2>&1
assert_contains "an inconclusive 403 costs one zen probe in total" "$(grep -c 'zen' "$case_gh_log" || true)" "1"

printf '\n=== pacing: stale-lock breaking is verified, not check-then-act ===\n'
new_case breakstale
run_lib '
  mkdir -p "${GITHUB_API_STATE_DIR}/lock"; printf "100\n" >"${GITHUB_API_STATE_DIR}/lock/since"
  _github_api_pace_break_stale "${GITHUB_API_STATE_DIR}/lock" 50
  [[ -d "${GITHUB_API_STATE_DIR}/lock" ]] && printf "DIFFERENT_HOLDER_KEPT\n"
  _github_api_pace_break_stale "${GITHUB_API_STATE_DIR}/lock" 100
  [[ ! -d "${GITHUB_API_STATE_DIR}/lock" ]] && printf "SAME_STALE_REMOVED\n"
  ls "${GITHUB_API_STATE_DIR}" | grep -c "lock.stale" || true
' >"${case_dir}/out" 2>&1
assert_contains "a lock that is not the one judged stale is put back" "$(cat "${case_dir}/out")" "DIFFERENT_HOLDER_KEPT"
assert_contains "the lock that was judged stale is removed" "$(cat "${case_dir}/out")" "SAME_STALE_REMOVED"
assert_contains "no renamed stale directory is left behind" "$(tail -1 "${case_dir}/out")" "0"

printf '\n=== pacing: a put-back never nests the stale lock inside a lock re-created meanwhile ===\n'
new_case putback
mkdir -p "${case_dir}/shim"
cat >"${case_dir}/shim/mv" <<'SHIM'
#!/usr/bin/env bash
real_mv=''
for d in $(printf "%s" "$PATH" | tr ":" " "); do
  [[ "$d" == "$(dirname "$0")" ]] && continue
  [[ -x "$d/mv" ]] && { real_mv="$d/mv"; break; }
done
"$real_mv" "$@"
rc=$?
if [[ "$1" == "--" ]]; then
  # The rename to the grave just happened: a third waiter now creates a fresh lock.
  mkdir -p "$2" && printf '999\n' >"$2/since"
fi
exit "$rc"
SHIM
chmod +x "${case_dir}/shim/mv"
mkdir -p "${case_state}"
PATH="${case_dir}/shim:${PATH}" run_lib '
  mkdir -p "${GITHUB_API_STATE_DIR}/lock"; printf "100\n" >"${GITHUB_API_STATE_DIR}/lock/since"
  _github_api_pace_break_stale "${GITHUB_API_STATE_DIR}/lock" 50
  printf "since=%s\n" "$(cat "${GITHUB_API_STATE_DIR}/lock/since")"
  find "${GITHUB_API_STATE_DIR}" -name "lock.stale*" | wc -l
' >"${case_dir}/out" 2>&1
assert_contains "the lock created in between is untouched" "$(cat "${case_dir}/out")" "since=999"
assert_contains "no stale directory is left nested or beside it" "$(tail -1 "${case_dir}/out" | tr -d ' ')" "0"

printf '\n=== pacing: the state directory lookup is cached in the calling shell ===\n'
new_case dircache
out="$(run_lib 'github_api_pace_gate a; printf "DIR=%s\n" "${_github_api_pace_dir_value:-unset}"' 2>&1)"
assert_contains "the resolved state directory persists after the gate returns" "$out" "DIR=${case_state}"

printf '\n=== pacing: microsecond slots do not depend on the locale decimal separator ===\n'
assert_not_contains "no EPOCHREALTIME decimal-point substitution that a comma locale breaks" \
  "$(grep -c 'EPOCHREALTIME/\./' "$lib" || true)" "1"
comma_locale="$(locale -a 2>/dev/null | grep -iE '^(de_DE|pt_BR|fr_FR)\.(utf-?8)$' | head -1 || true)"
if [[ -n "$comma_locale" ]]; then
  new_case locale
  out="$(LC_ALL="$comma_locale" run_lib 'github_api_pace_gate a; github_api_pace_gate b; printf "NEXT=%s\n" "$(cat "${GITHUB_API_STATE_DIR}/next_slot")"' 2>&1)"
  next_slot="$(sed -n 's/^NEXT=//p' <<<"$out")"
  if [[ "$next_slot" =~ ^[0-9]{16}$ ]]; then
    pass_case "next_slot is a full microsecond epoch under ${comma_locale}"
  else
    fail_case "next_slot is a full microsecond epoch under ${comma_locale} (got ${next_slot})"
  fi
fi

printf '\n=== pacing: flock is the primary lock when available ===\n'
new_case flock
flock_bin="${tmp}/flock-bin"
mkdir -p "$flock_bin"
cat >"${flock_bin}/flock" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${MOCK_FLOCK_LOG:?}"
exit "${MOCK_FLOCK_EXIT:-0}"
MOCK
chmod +x "${flock_bin}/flock"
mkdir -p "$case_state"
printf '%s %s %s\n' 1000 "$(( EPOCHSECONDS + 3000 ))" "$EPOCHSECONDS" >"${case_state}/quota"
out="$(MOCK_FLOCK_LOG="${case_dir}/flock.log" PATH="${flock_bin}:${PATH}" run_lib 'github_api_pace_gate x; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "the gate takes an exclusive flock with a timeout" "$(cat "${case_dir}/flock.log")" "--exclusive --timeout 5"
assert_contains "the gate completes under flock" "$out" "EC=0"
if [[ ! -e "${case_state}/lock" ]]; then
  pass_case "no mkdir lock directory is used when flock exists"
else
  fail_case "no mkdir lock directory is used when flock exists"
fi
out="$(MOCK_FLOCK_EXIT=1 MOCK_FLOCK_LOG="${case_dir}/flock2.log" PATH="${flock_bin}:${PATH}" run_lib 'github_api_pace_gate y; printf "EC=%s\n" "$?"' 2>&1)"
assert_contains "a flock timeout fails open with a NOTE" "$out" "GITHUB_API_PACE_DISABLED reason=lock_timeout"
assert_contains "a flock timeout never blocks the caller" "$out" "EC=0"
out="$(MOCK_FLOCK_EXIT=1 MOCK_FLOCK_LOG="${case_dir}/flock3.log" PATH="${flock_bin}:${PATH}" run_lib 'github_api_pace_gate z; printf "FD=[%s]\n" "${_github_api_pace_lock_fd:-}"' 2>&1)"
assert_contains "a flock timeout leaves no stale lock descriptor behind" "$out" "FD=[]"

printf '\n=== static: every attempt passes the gate ===\n'
# shellcheck disable=SC2016  # awk program is a literal string
if awk '
  /^github_api_exec_with_rate_limit_retry\(\)/ { in_fn=1 }
  in_fn && /^}/ { in_fn=0 }
  in_fn && /github_api_pace_gate "\$label"/ { gate=NR }
  in_fn && /runner_exec "\$label"/ { if (!first_exec) first_exec=NR }
  END { exit (gate && first_exec && gate < first_exec) ? 0 : 1 }
' "$lib"; then
  pass_case "the retry wrapper gates before every runner_exec attempt"
else
  fail_case "the retry wrapper gates before every runner_exec attempt"
fi

printf '\n=== static: audit and fix paths never call gh around the pacing wrapper ===\n'
# shellcheck disable=SC2016  # awk program is a literal string
if awk '
  /^[[:space:]]*#/ { next }
  /-- gh (api|pr) / || /runner_exec(_stdout)? .*-- gh (api|pr) / {
    if (prev !~ /github_api_exec_with_rate_limit_retry/ && $0 !~ /github_api_exec_with_rate_limit_retry/) {
      printf "%d: %s\n", NR, $0 > "/dev/stderr"; bad=1
    }
  }
  { prev=$0 }
  END { exit bad }
' "${script_dir}/../scripts/lib/repo-practices"; then
  pass_case "every gh api / gh pr call in repo-practices goes through the retry wrapper"
else
  fail_case "every gh api / gh pr call in repo-practices goes through the retry wrapper"
fi

printf '\n=== pacing: callers with a readonly global named dir (dep-updater) ===\n'
# dep-updater declares `readonly dir`; a `local dir` in the library then dies with
# "local: dir: readonly variable" (seen in the org dry-run CI). Library locals must not reuse it.
readonly_out="$(bash -c '
  readonly dir=/not/the/state/dir
  source "$1"
  GITHUB_API_STATE_DIR="$2" _github_api_pace_dir
  printf "state=%s\n" "$_github_api_pace_dir_value"
' bash "$lib" "${tmp}/readonly-dir-state" 2>&1)"
assert_contains "the state directory resolves with a readonly global dir in the caller" \
  "$readonly_out" "state=${tmp}/readonly-dir-state"
assert_not_contains "no readonly-variable error is raised" "$readonly_out" "readonly variable"
if grep -nE '^[[:space:]]*local( -[a-zA-Z]+)* (.* )?dir( |=|$)' "$lib" >/dev/null; then
  fail_case "the pacing library never declares a local named dir"
else
  pass_case "the pacing library never declares a local named dir"
fi

test_summary
