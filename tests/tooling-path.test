#!/usr/bin/env bash
# Tests for scripts/lib/tooling-path and cron-interactive-path compatibility.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

lib="${script_dir}/../scripts/lib/tooling-path"
readonly lib
cron_compat="${script_dir}/../scripts/lib/cron-interactive-path"
readonly cron_compat

pass=0
fail=0

printf '\n=== static: library defines bootstrap entry points ===\n'
for fn in tooling_path_bootstrap_node_ecosystem tooling_path_bootstrap_cron_minimal \
  tooling_path_align_node_with_pnpm tooling_path_prepend_nvm_default_node; do
  if grep -qF "${fn}()" "$lib"; then
    printf '[PASS] tooling-path defines %s\n' "$fn"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] tooling-path missing %s\n' "$fn"
    fail=$(( fail + 1 ))
  fi
done

printf '\n=== static: cron-interactive-path delegates to tooling-path ===\n'
# shellcheck disable=SC2016
if grep -qF 'source "${_tooling_path_lib_dir}/tooling-path"' "$cron_compat" \
  && grep -qF 'prepend_nvm_default_node_bin_for_cron()' "$cron_compat" \
  && grep -qF 'tooling_path_prepend_nvm_default_node' "$cron_compat"; then
  printf '[PASS] cron-interactive-path aliases NVM helper via tooling-path\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cron-interactive-path must source tooling-path and alias prepend_nvm\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: dep-updater uses tooling-path bootstrap ===\n'
dep_script="${script_dir}/../scripts/dep-updater"
# shellcheck disable=SC2016
if grep -qF 'source "${dep_script_dir}/lib/tooling-path"' "$dep_script" \
  && grep -qF 'tooling_path_bootstrap_node_ecosystem' "$dep_script" \
  && ! grep -qF 'dep_updater_prepend_node_for_pnpm' "$dep_script"; then
  printf '[PASS] dep-updater: sources tooling-path and calls bootstrap_node_ecosystem\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater must use lib/tooling-path bootstrap_node_ecosystem\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: dep-updater-notifier uses cron bootstrap ===\n'
notifier_script="${script_dir}/../scripts/dep-updater-notifier"
# shellcheck disable=SC2016
if grep -qF 'source "${script_dir}/lib/tooling-path"' "$notifier_script" \
  && grep -qF 'tooling_path_bootstrap_cron_minimal' "$notifier_script"; then
  printf '[PASS] dep-updater-notifier: sources tooling-path bootstrap_cron_minimal\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updater-notifier must use tooling_path_bootstrap_cron_minimal\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: prepend_dir deduplicates PATH ===\n'
tmp_home=""
tmp_home="$(mktemp -d)"
mkdir -p "${tmp_home}/bin"
printf '#!/usr/bin/env bash\necho ok\n' >"${tmp_home}/bin/dummy"
chmod +x "${tmp_home}/bin/dummy"
PATH="/usr/bin:/bin"
# shellcheck disable=SC1090,SC1091
source "$lib"
tooling_path_prepend_dir "${tmp_home}/bin"
first_count="$(printf '%s' "$PATH" | tr ':' '\n' | grep -cF "${tmp_home}/bin" || true)"
tooling_path_prepend_dir "${tmp_home}/bin"
second_count="$(printf '%s' "$PATH" | tr ':' '\n' | grep -cF "${tmp_home}/bin" || true)"
rm -rf "$tmp_home"
if [[ "$first_count" -eq 1 && "$second_count" -eq 1 ]]; then
  printf '[PASS] tooling_path_prepend_dir does not duplicate PATH entries\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling_path_prepend_dir duplicated segment (counts %s %s)\n' \
    "$first_count" "$second_count"
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
