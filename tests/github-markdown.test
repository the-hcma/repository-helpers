#!/usr/bin/env bash
# Tests for scripts/lib/github-markdown and scripts/lint-github-markdown.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/github-markdown"
cli="${script_dir}/../scripts/lint-github-markdown"
readonly lib cli

# shellcheck source=../scripts/lib/github-markdown
# shellcheck disable=SC1091
source "$lib"

assert_str_eq() {
  local -r label="$1"
  local -r expected="$2"
  local -r actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    pass_case "$label"
  else
    printf '[FAIL] %s: expected %q, got %q\n' "$label" "$expected" "$actual" >&2
    fail_case "$label"
  fi
}

printf '\n=== --help ===\n'
help_out=''
help_exit=0
help_out="$(bash "$cli" --help 2>&1)" || help_exit=$?
assert_exit_0 '--help' "$help_out" "$help_exit"
assert_contains '--help mentions body-file' "$help_out" 'body-file'

printf '\n=== pure: clean body passes ===\n'
clean_out=''
clean_rc=0
clean_out="$(
  printf '%s\n' \
    '## Summary' \
    '' \
    '- First item' \
    '' \
    '- Second item' \
    '' \
    '## Test plan' \
    '' \
    'A paragraph.' \
    '' \
    '```bash' \
    'echo hi' \
    '```' \
    | ghm_lint_text
)" || clean_rc=$?
assert_exit_0 'clean body' "$clean_out" "$clean_rc"
assert_str_eq 'clean body has no findings' '' "$clean_out"

printf '\n=== pure: mid-line list marker fails ===\n'
mid_out=''
mid_rc=0
mid_out="$(printf '%s\n' '- First - Second joined' | ghm_lint_text)" || mid_rc=$?
assert_exit_nonzero 'mid-line list marker' "$mid_out" "$mid_rc"
assert_contains 'mid-line finding' "$mid_out" 'list marker appears mid-line'

prose_out=''
prose_rc=0
prose_out="$(printf '%s\n' 'See item 1. below for details.' | ghm_lint_text)" || prose_rc=$?
assert_exit_0 'prose numbered item is not a joined list' "$prose_out" "$prose_rc"

printf '\n=== pure: heading without blank line fails ===\n'
hd_out=''
hd_rc=0
hd_out="$(printf '%s\n' 'Intro paragraph.' '## Heading' | ghm_lint_text)" || hd_rc=$?
assert_exit_nonzero 'heading needs blank line' "$hd_out" "$hd_rc"
assert_contains 'heading finding' "$hd_out" 'heading should be preceded by a blank line'

printf '\n=== pure: fence without preceding blank line fails ===\n'
fence_out=''
fence_rc=0
fence_out="$(printf '%s\n' 'See this:' '```' 'x' '```' | ghm_lint_text)" || fence_rc=$?
assert_exit_nonzero 'fence needs blank line' "$fence_out" "$fence_rc"
assert_contains 'fence finding' "$fence_out" 'fenced code block should be preceded by a blank line'

printf '\n=== pure: content after fence needs blank line ===\n'
after_out=''
after_rc=0
after_out="$(printf '%s\n' '```' 'x' '```' 'next paragraph' | ghm_lint_text)" || after_rc=$?
assert_exit_nonzero 'after fence needs blank' "$after_out" "$after_rc"
assert_contains 'after fence finding' "$after_out" 'content after fenced code block'

printf '\n=== pure: mixed fence markers stay open ===\n'
mixed_out=''
mixed_rc=0
mixed_out="$(printf '%s\n' '```bash' '~~~' 'still in fence' '```' | ghm_lint_text)" || mixed_rc=$?
assert_exit_0 'tilde inside backtick fence is content' "$mixed_out" "$mixed_rc"

printf '\n=== pure: literal \\n escape fails ===\n'
esc_line=$'## Summary\\n\\n- item'
esc_out=''
esc_rc=0
esc_out="$(printf '%s\n' "$esc_line" | ghm_lint_text)" || esc_rc=$?
assert_exit_nonzero 'literal backslash-n fails' "$esc_out" "$esc_rc"
assert_contains 'literal escape finding' "$esc_out" 'literal \n escape'

printf '\n=== pure: \\n inside fenced code is clean ===\n'
infence_out=''
infence_rc=0
infence_out="$(
  printf '%s\n' \
    '## Summary' \
    '' \
    '```bash' \
    "printf 'a\\nb'" \
    '```' \
    | ghm_lint_text
)" || infence_rc=$?
assert_exit_0 'backslash-n inside fence is clean' "$infence_out" "$infence_rc"

printf '\n=== pure: hand-wrapped paragraph fails (#653) ===\n'
wrap_out=''
wrap_rc=0
wrap_out="$(
  printf '%s\n' \
    'This is a paragraph that has been hand-wrapped across multiple' \
    'physical lines using single newlines, the way an agent naturally' \
    'drafts prose without realizing GitHub will render each line as a' \
    'separate hard break instead of joining them into one paragraph.' \
    | ghm_lint_text
)" || wrap_rc=$?
assert_exit_nonzero 'hand-wrapped paragraph' "$wrap_out" "$wrap_rc"
assert_contains 'hand-wrap finding' "$wrap_out" 'hand-wrapped paragraph'

wrap_ok_out=''
wrap_ok_rc=0
wrap_ok_out="$(
  printf '%s\n' \
    'This is a paragraph that has been hand-wrapped across multiple physical lines using single newlines, the way an agent naturally drafts prose without realizing GitHub will render each line as a separate hard break instead of joining them into one paragraph.' \
    | ghm_lint_text
)" || wrap_ok_rc=$?
assert_exit_0 'single-line paragraph is clean' "$wrap_ok_out" "$wrap_ok_rc"

wrap_blank_out=''
wrap_blank_rc=0
wrap_blank_out="$(
  printf '%s\n' \
    'First short paragraph.' \
    '' \
    'Second short paragraph.' \
    | ghm_lint_text
)" || wrap_blank_rc=$?
assert_exit_0 'blank-separated paragraphs are clean' "$wrap_blank_out" "$wrap_blank_rc"

printf '\n=== pure: tight lists and tables are not hand-wrap ===\n'
list_out=''
list_rc=0
list_out="$(printf '%s\n' '- first' '- second' '- third' | ghm_lint_text)" || list_rc=$?
assert_exit_0 'tight list without blank lines is clean' "$list_out" "$list_rc"

table_out=''
table_rc=0
table_out="$(
  printf '%s\n' \
    '| a | b |' \
    '| --- | --- |' \
    '| c | d |' \
    | ghm_lint_text
)" || table_rc=$?
assert_exit_0 'markdown table rows are clean' "$table_out" "$table_rc"

paren_out=''
paren_rc=0
paren_out="$(printf '%s\n' '1) first' '2) second' | ghm_lint_text)" || paren_rc=$?
assert_exit_0 'paren-style ordered list is clean' "$paren_out" "$paren_rc"

setext_out=''
setext_rc=0
setext_out="$(printf '%s\n' 'Title' '=====' | ghm_lint_text)" || setext_rc=$?
assert_exit_0 'setext H1 underline is clean' "$setext_out" "$setext_rc"

printf '\n=== pure: closing keyword not adjacent to issue reference fails (#660) ===\n'
unlinked_out=''
unlinked_rc=0
unlinked_out="$(
  printf '%s\n' \
    'This closes that gap (#651'\''s remaining scope after #652/#654).' \
    | ghm_lint_text
)" || unlinked_rc=$?
assert_exit_nonzero 'closing keyword not adjacent to reference' "$unlinked_out" "$unlinked_rc"
assert_contains 'unlinked closing keyword finding' "$unlinked_out" 'closing keyword'

unlinked_word_between_out=''
unlinked_word_between_rc=0
unlinked_word_between_out="$(printf '%s\n' 'Fixed in #651 after the last release.' | ghm_lint_text)" \
  || unlinked_word_between_rc=$?
assert_exit_nonzero 'word between keyword and reference fails' \
  "$unlinked_word_between_out" "$unlinked_word_between_rc"

printf '\n=== pure: adjacent closing keyword forms are clean (#660) ===\n'
linked_out=''
linked_rc=0
linked_out="$(printf '%s\n' 'Fixes #651.' | ghm_lint_text)" || linked_rc=$?
assert_exit_0 'keyword directly adjacent to reference is clean' "$linked_out" "$linked_rc"

linked_colon_out=''
linked_colon_rc=0
linked_colon_out="$(printf '%s\n' 'Fixes: #651.' | ghm_lint_text)" || linked_colon_rc=$?
assert_exit_0 'keyword with colon before reference is clean' "$linked_colon_out" "$linked_colon_rc"

linked_owner_repo_out=''
linked_owner_repo_rc=0
linked_owner_repo_out="$(
  printf '%s\n' 'Closes the-hcma/repository-helpers#651.' | ghm_lint_text
)" || linked_owner_repo_rc=$?
assert_exit_0 'keyword adjacent to owner/repo#N reference is clean' \
  "$linked_owner_repo_out" "$linked_owner_repo_rc"

linked_repeat_out=''
linked_repeat_rc=0
linked_repeat_out="$(printf '%s\n' 'Resolves #651, resolves #652.' | ghm_lint_text)" || linked_repeat_rc=$?
assert_exit_0 'keyword repeated before each of several references is clean' \
  "$linked_repeat_out" "$linked_repeat_rc"

printf '\n=== pure: second reference without its own keyword is a finding (#660) ===\n'
unlinked_multi_out=''
unlinked_multi_rc=0
unlinked_multi_out="$(printf '%s\n' 'Fixes #651, #652.' | ghm_lint_text)" || unlinked_multi_rc=$?
assert_exit_nonzero 'keyword adjacent only to the first of several references is a finding' \
  "$unlinked_multi_out" "$unlinked_multi_rc"

printf '\n=== pure: bare issue mentions and keyword-only lines are clean (#660) ===\n'
bare_ref_out=''
bare_ref_rc=0
bare_ref_out="$(printf '%s\n' 'See #651 for prior discussion.' | ghm_lint_text)" || bare_ref_rc=$?
assert_exit_0 'bare issue mention without a closing keyword is clean' "$bare_ref_out" "$bare_ref_rc"

bare_keyword_out=''
bare_keyword_rc=0
bare_keyword_out="$(printf '%s\n' 'This fixes a subtle bug in the retry loop.' | ghm_lint_text)" \
  || bare_keyword_rc=$?
assert_exit_0 'closing keyword with no issue reference on the line is clean' \
  "$bare_keyword_out" "$bare_keyword_rc"

printf '\n=== pure: "#N" not preceded by a word boundary is not a reference (#660) ===\n'
non_ref_out=''
non_ref_rc=0
non_ref_out="$(printf '%s\n' 'Fix the C#8 build.' | ghm_lint_text)" || non_ref_rc=$?
assert_exit_0 '"C#8" is not mistaken for an issue reference' "$non_ref_out" "$non_ref_rc"

printf '\n=== pure: inline code spans are stripped before matching (#660) ===\n'
code_span_out=''
code_span_rc=0
# shellcheck disable=SC2016 # literal backticks (inline code span), not command substitution
code_span_out="$(printf '%s\n' 'Add `fix` support; see #660.' | ghm_lint_text)" || code_span_rc=$?
assert_exit_0 'backticked keyword next to an unrelated reference is clean' \
  "$code_span_out" "$code_span_rc"

printf '\n=== functional: lint-github-markdown on temp file ===\n'
tmp="$(mktemp)"
printf '%s\n' '## Summary' '' '- ok' >"$tmp"
file_rc=0
file_out="$(bash "$cli" "$tmp" 2>&1)" || file_rc=$?
assert_exit_0 'cli clean file' "$file_out" "$file_rc"
printf '%s\n' 'Para' '## Bad' >"$tmp"
file_rc=0
file_out="$(bash "$cli" "$tmp" 2>&1)" || file_rc=$?
assert_exit_nonzero 'cli dirty file' "$file_out" "$file_rc"
assert_contains 'cli error marker' "$file_out" 'GITHUB_MARKDOWN_LINT'
rm -f "$tmp"

# unwrap_case <label> <expected> <input-line>… — ghm_unwrap_text fix output.
unwrap_case() {
  local -r label="$1"
  local -r expected="$2"
  shift 2
  local actual

  actual="$(printf '%s\n' "$@" | ghm_unwrap_text fix)"
  assert_str_eq "$label" "$expected" "$actual"
}

printf '\n=== pure: ghm_unwrap_text fix joins continuations ===\n'
unwrap_case 'wrapped paragraph is joined onto one line' \
  'One two three.' \
  'One' 'two' 'three.'
unwrap_case 'wrapped list item continuation is joined into the item' \
  $'- first item continues\n- second' \
  '- first item' '  continues' '- second'
unwrap_case 'wrapped ordered item is joined into the item' \
  '1. **Bold** keeps going here' \
  '1. **Bold** keeps' '   going here'
unwrap_case 'wrapped blockquote is joined and keeps its marker' \
  '> quoted text keeps going' \
  '> quoted text' '> keeps going'
unwrap_case 'trailing space before a join is not doubled' \
  'alpha beta' \
  'alpha ' 'beta'
unwrap_case 'blank-separated paragraphs stay separate' \
  $'one\n\ntwo' \
  'one' '' 'two'

printf '\n=== pure: ghm_unwrap_text fix leaves blocks alone ===\n'
unwrap_case 'front matter is not joined' \
  $'---\ndescription: x\nalwaysApply: true\n---\n\nBody' \
  '---' 'description: x' 'alwaysApply: true' '---' '' 'Body'
unwrap_case 'fenced code lines are not joined' \
  $'```bash\necho one\necho two\n```' \
  '```bash' 'echo one' 'echo two' '```'
unwrap_case 'tilde fence with an info string containing spaces is not joined' \
  $'~~~text title\nline one\nline two\n~~~' \
  '~~~text title' 'line one' 'line two' '~~~'
unwrap_case 'indented code after a heading is not joined' \
  $'# Title\n    code one\n    code two' \
  '# Title' '    code one' '    code two'
unwrap_case 'table rows are not joined' \
  $'| a | b |\n| --- | --- |\n| 1 | 2 |' \
  '| a | b |' '| --- | --- |' '| 1 | 2 |'
unwrap_case 'table header without a leading pipe is not joined onto prose' \
  $'intro\nh1 | h2\n--- | ---' \
  'intro' 'h1 | h2' '--- | ---'
unwrap_case 'multi-line HTML comment is not joined' \
  $'<!--\nkeep\nlines\n-->' \
  '<!--' 'keep' 'lines' '-->'
unwrap_case 'breadcrumb line after an HTML comment stays on its own line' \
  $'<!-- rule-canonical: https://example.test/rule.md -->\nCanonical rule: https://example.test/rule.md' \
  '<!-- rule-canonical: https://example.test/rule.md -->' \
  'Canonical rule: https://example.test/rule.md'
unwrap_case 'heading and following prose are not joined' \
  $'## Heading\nprose' \
  '## Heading' 'prose'
unwrap_case 'new list item is not joined onto prose' \
  $'intro\n- item' \
  'intro' '- item'
unwrap_case 'setext underline is not joined' \
  $'Title\n--' \
  'Title' '--'
unwrap_case 'hard break (two trailing spaces) is kept' \
  $'first  \nsecond' \
  'first  ' 'second'
unwrap_case 'hard break (trailing backslash) is kept' \
  $'first\\\nsecond' \
  "first\\" 'second'
unwrap_case 'lazy blockquote continuation is not joined' \
  $'> quoted\nlazy' \
  '> quoted' 'lazy'
unwrap_case 'link reference definitions are not joined' \
  $'[a]: https://example.test/a\n[b]: https://example.test/b' \
  '[a]: https://example.test/a' '[b]: https://example.test/b'
unwrap_case 'GitHub alert marker stays alone on its line' \
  $'> [!NOTE]\n> Useful information that wraps.' \
  '> [!NOTE]' '> Useful information' '> that wraps.'
unwrap_case 'hard break (two trailing spaces) is kept on CRLF lines' \
  $'first  \r\nsecond\r' \
  $'first  \r' $'second\r'
unwrap_case 'hard break (trailing backslash) is kept on CRLF lines' \
  $'first\\\r\nsecond\r' \
  $'first\\\r' $'second\r'
unwrap_case 'CRLF soft break is joined and keeps the CRLF ending' \
  $'one two\r' \
  $'one\r' $'two\r'
unwrap_case 'tab-indented code after a heading is not joined' \
  $'# Title\n\tcode one\n\tcode two' \
  '# Title' $'\tcode one' $'\tcode two'
unwrap_case 'tab-indented code after a blank line is not joined' \
  $'para\n\n\tcode one\n\tcode two' \
  'para' '' $'\tcode one' $'\tcode two'
unwrap_case 'tab after a list marker still joins its continuation' \
  $'-\titem continues' \
  $'-\titem' '    continues'

printf '\n=== pure: ghm_unwrap_text lint ===\n'
wrap_lint_rc=0
wrap_lint_out="$(printf '%s\n' '- item' '  continues' '' 'para' 'wrapped' | ghm_unwrap_text lint)" \
  || wrap_lint_rc=$?
assert_exit_nonzero 'lint flags wrapped list item and paragraph' "$wrap_lint_out" "$wrap_lint_rc"
assert_contains 'lint reports the list continuation line' "$wrap_lint_out" 'line:2: hand-wrapped'
assert_contains 'lint reports the paragraph continuation line' "$wrap_lint_out" 'line:5: hand-wrapped'
assert_count_equals 'lint reports one finding per continuation line' \
  "$wrap_lint_out" 'hand-wrapped' 2
wrap_lint_rc=0
wrap_lint_out="$(printf '%s\n' '# T' '' 'One line.' '' '```' 'a' 'b' '```' | ghm_unwrap_text lint)" \
  || wrap_lint_rc=$?
assert_exit_0 'lint passes unwrapped Markdown with a code fence' "$wrap_lint_out" "$wrap_lint_rc"
wrap_lint_rc=0
wrap_lint_out="$(printf '%s\n' 'x' | ghm_unwrap_text bogus 2>&1)" || wrap_lint_rc=$?
assert_exit_nonzero 'unknown ghm_unwrap_text mode is rejected' "$wrap_lint_out" "$wrap_lint_rc"

printf '\n=== functional: lint-github-markdown --repo-files ===\n'
tmp="$(mktemp)"
printf '%s\n' '---' 'alwaysApply: true' '---' '' '# Rule' '' 'Wrapped' 'paragraph.' >"$tmp"
file_rc=0
file_out="$(bash "$cli" --repo-files "$tmp" 2>&1)" || file_rc=$?
assert_exit_nonzero 'cli --repo-files flags a wrapped paragraph' "$file_out" "$file_rc"
assert_contains 'cli --repo-files error marker' "$file_out" 'GITHUB_MARKDOWN_WRAP'
file_rc=0
file_out="$(bash "$cli" --repo-files --fix "$tmp" 2>&1)" || file_rc=$?
assert_exit_0 'cli --repo-files --fix succeeds' "$file_out" "$file_rc"
assert_str_eq 'cli --repo-files --fix rewrites the file in place' \
  $'---\nalwaysApply: true\n---\n\n# Rule\n\nWrapped paragraph.' "$(<"$tmp")"
file_rc=0
file_out="$(bash "$cli" --repo-files "$tmp" 2>&1)" || file_rc=$?
assert_exit_0 'cli --repo-files passes after --fix' "$file_out" "$file_rc"
printf '%s\n' 'Para' '## Heading right after' >"$tmp"
file_rc=0
file_out="$(bash "$cli" --repo-files "$tmp" 2>&1)" || file_rc=$?
assert_exit_0 'cli --repo-files ignores body-only findings' "$file_out" "$file_rc"
file_rc=0
file_out="$(bash "$cli" --fix "$tmp" 2>&1)" || file_rc=$?
assert_exit_nonzero 'cli --fix without --repo-files is rejected' "$file_out" "$file_rc"
assert_contains 'cli --fix without --repo-files explains why' "$file_out" '--fix requires --repo-files'
printf 'Wrapped\nparagraph.\n\n\n' >"$tmp"
bash "$cli" --repo-files --fix "$tmp" >/dev/null 2>&1 || true
IFS= read -r -d '' fixed_text <"$tmp" || :
assert_str_eq 'cli --repo-files --fix keeps trailing blank lines' \
  $'Wrapped paragraph.\n\n\n' "$fixed_text"
printf 'Wrapped\nparagraph.' >"$tmp"
bash "$cli" --repo-files --fix "$tmp" >/dev/null 2>&1 || true
IFS= read -r -d '' fixed_text <"$tmp" || :
assert_str_eq 'cli --repo-files --fix does not add a missing final newline' \
  'Wrapped paragraph.' "$fixed_text"
rm -f "$tmp"

test_summary
