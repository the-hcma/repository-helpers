#!/usr/bin/env bash
# Tests for scripts/lib/github-markdown and scripts/lint-github-markdown.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/github-markdown"
cli="${script_dir}/../scripts/lint-github-markdown"
readonly lib cli

# shellcheck source=../scripts/lib/github-markdown
# shellcheck disable=SC1091
source "$lib"

assert_str_eq() {
  local -r label="$1"
  local -r expected="$2"
  local -r actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    pass_case "$label"
  else
    printf '[FAIL] %s: expected %q, got %q\n' "$label" "$expected" "$actual" >&2
    fail_case "$label"
  fi
}

printf '\n=== --help ===\n'
help_out=''
help_exit=0
help_out="$(bash "$cli" --help 2>&1)" || help_exit=$?
assert_exit_0 '--help' "$help_out" "$help_exit"
assert_contains '--help mentions body-file' "$help_out" 'body-file'

printf '\n=== pure: clean body passes ===\n'
clean_out=''
clean_rc=0
clean_out="$(
  printf '%s\n' \
    '## Summary' \
    '' \
    '- First item' \
    '' \
    '- Second item' \
    '' \
    '## Test plan' \
    '' \
    'A paragraph.' \
    '' \
    '```bash' \
    'echo hi' \
    '```' \
    | ghm_lint_text
)" || clean_rc=$?
assert_exit_0 'clean body' "$clean_out" "$clean_rc"
assert_str_eq 'clean body has no findings' '' "$clean_out"

printf '\n=== pure: mid-line list marker fails ===\n'
mid_out=''
mid_rc=0
mid_out="$(printf '%s\n' '- First - Second joined' | ghm_lint_text)" || mid_rc=$?
assert_exit_nonzero 'mid-line list marker' "$mid_out" "$mid_rc"
assert_contains 'mid-line finding' "$mid_out" 'list marker appears mid-line'

prose_out=''
prose_rc=0
prose_out="$(printf '%s\n' 'See item 1. below for details.' | ghm_lint_text)" || prose_rc=$?
assert_exit_0 'prose numbered item is not a joined list' "$prose_out" "$prose_rc"

printf '\n=== pure: heading without blank line fails ===\n'
hd_out=''
hd_rc=0
hd_out="$(printf '%s\n' 'Intro paragraph.' '## Heading' | ghm_lint_text)" || hd_rc=$?
assert_exit_nonzero 'heading needs blank line' "$hd_out" "$hd_rc"
assert_contains 'heading finding' "$hd_out" 'heading should be preceded by a blank line'

printf '\n=== pure: fence without preceding blank line fails ===\n'
fence_out=''
fence_rc=0
fence_out="$(printf '%s\n' 'See this:' '```' 'x' '```' | ghm_lint_text)" || fence_rc=$?
assert_exit_nonzero 'fence needs blank line' "$fence_out" "$fence_rc"
assert_contains 'fence finding' "$fence_out" 'fenced code block should be preceded by a blank line'

printf '\n=== pure: content after fence needs blank line ===\n'
after_out=''
after_rc=0
after_out="$(printf '%s\n' '```' 'x' '```' 'next paragraph' | ghm_lint_text)" || after_rc=$?
assert_exit_nonzero 'after fence needs blank' "$after_out" "$after_rc"
assert_contains 'after fence finding' "$after_out" 'content after fenced code block'

printf '\n=== pure: mixed fence markers stay open ===\n'
mixed_out=''
mixed_rc=0
mixed_out="$(printf '%s\n' '```bash' '~~~' 'still in fence' '```' | ghm_lint_text)" || mixed_rc=$?
assert_exit_0 'tilde inside backtick fence is content' "$mixed_out" "$mixed_rc"

printf '\n=== pure: literal \\n escape fails ===\n'
esc_line=$'## Summary\\n\\n- item'
esc_out=''
esc_rc=0
esc_out="$(printf '%s\n' "$esc_line" | ghm_lint_text)" || esc_rc=$?
assert_exit_nonzero 'literal backslash-n fails' "$esc_out" "$esc_rc"
assert_contains 'literal escape finding' "$esc_out" 'literal \n escape'

printf '\n=== pure: \\n inside fenced code is clean ===\n'
infence_out=''
infence_rc=0
infence_out="$(
  printf '%s\n' \
    '## Summary' \
    '' \
    '```bash' \
    "printf 'a\\nb'" \
    '```' \
    | ghm_lint_text
)" || infence_rc=$?
assert_exit_0 'backslash-n inside fence is clean' "$infence_out" "$infence_rc"

printf '\n=== functional: lint-github-markdown on temp file ===\n'
tmp="$(mktemp)"
printf '%s\n' '## Summary' '' '- ok' >"$tmp"
file_rc=0
file_out="$(bash "$cli" "$tmp" 2>&1)" || file_rc=$?
assert_exit_0 'cli clean file' "$file_out" "$file_rc"
printf '%s\n' 'Para' '## Bad' >"$tmp"
file_rc=0
file_out="$(bash "$cli" "$tmp" 2>&1)" || file_rc=$?
assert_exit_nonzero 'cli dirty file' "$file_out" "$file_rc"
assert_contains 'cli error marker' "$file_out" 'GITHUB_MARKDOWN_LINT'
rm -f "$tmp"

test_summary
