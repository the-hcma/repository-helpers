#!/usr/bin/env bash
# Smoke tests for scripts/setup-service.
#
# Because setup-service interacts with systemd, loginctl, and the filesystem,
# full integration tests are not feasible in CI. These tests cover:
#   1. --help exits 0 and prints expected content.
#   2. Unknown option exits non-zero with an informative message.
#   3. Static analysis: no 'local -r' inside loop bodies.
#   4. Static analysis: shebang is '#!/usr/bin/env bash'.
#   5. Static analysis: 'set -euo pipefail' is present.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/setup-service"
readonly script

pass=0
fail=0

# ---------------------------------------------------------------------------
# Test: --help
# ---------------------------------------------------------------------------

printf '\n=== --help ===\n'
help_output=""
help_exit=0
help_output="$(bash "$script" --help 2>&1)" || help_exit=$?

assert_exit_0     "--help" "$help_output" "$help_exit"
assert_contains   "--help" "$help_output" "USAGE:"
assert_contains   "--help" "$help_output" "-s, --status"
assert_contains   "--help" "$help_output" "-r, --force-restart"
assert_contains   "--help" "$help_output" "-h, --help"
assert_contains   "--help" "$help_output" "--strict-lockfiles"
assert_contains   "--help" "$help_output" "--fix-lockfiles"
assert_contains   "--help" "$help_output" "--condition-host"

# ---------------------------------------------------------------------------
# Test: unknown option
# ---------------------------------------------------------------------------

printf '\n=== unknown option ===\n'
unknown_output=""
unknown_exit=0
unknown_output="$(bash "$script" --not-a-real-option 2>&1)" || unknown_exit=$?

assert_exit_nonzero "unknown option" "$unknown_output" "$unknown_exit"
assert_contains     "unknown option" "$unknown_output" "Unknown option"

# ---------------------------------------------------------------------------
# Test: no service template → exits 0 with informative message
#
# Run the script from a temp dir that has a git repo but no etc/systemd/ template.
# This simulates calling setup-service from a non-service repository.
# ---------------------------------------------------------------------------

printf '\n=== no service template ===\n'
tmp_repo=""
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/no-service-repo.git"
nosvc_output=""
nosvc_exit=0
nosvc_output="$(cd "$tmp_repo" && bash "$script" 2>&1)" || nosvc_exit=$?
rm -rf "$tmp_repo"

assert_exit_0   "no service template" "$nosvc_output" "$nosvc_exit"
assert_contains "no service template" "$nosvc_output" "not a systemd service"

# ---------------------------------------------------------------------------
# Test: --force-restart is accepted (no service template repo)
# ---------------------------------------------------------------------------

printf '\n=== --force-restart accepted ===\n'
tmp_repo=""
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/no-service-repo.git"
force_output=""
force_exit=0
force_output="$(cd "$tmp_repo" && bash "$script" --force-restart 2>&1)" || force_exit=$?
rm -rf "$tmp_repo"

assert_exit_0   "--force-restart accepted" "$force_output" "$force_exit"
assert_contains "--force-restart accepted" "$force_output" "not a systemd service"

# ---------------------------------------------------------------------------
# Static: port detection supports both --port and --http-port
# ---------------------------------------------------------------------------

printf '\n=== static: lockfile drift preflight before on-deploy ===\n'
if grep -qF 'run_lockfile_drift_preflight' "$script" \
  && grep -qF 'lockfile_drift_remediate_repo' "$script" \
  && grep -qF 'run_on_deploy_hook' "$script"; then
  printf '[PASS] lockfile-drift: preflight runs before on-deploy\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] lockfile-drift: expected run_lockfile_drift_preflight before on-deploy\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: port flag variants ===\n'
if grep -qF '(http-)?port \K' "$script"; then
  printf '[PASS] port-detection: regex matches both --port and --http-port\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] port-detection: regex does not match --http-port variant\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no 'local -r' inside loop bodies
# ---------------------------------------------------------------------------

printf '\n=== static: local -r in loops ===\n'
local_r_in_loops="$(awk '
  /^[[:space:]]*(while|for|until)[[:space:]]/ { depth++ }
  /^[[:space:]]*done\b/ { if (depth > 0) depth-- }
  /^}/ { depth=0 }
  /[[:space:]]local[[:space:]]+-[a-zA-Z]*r/ && depth > 0 { print NR": "$0 }
' "$script")"
if [[ -n "$local_r_in_loops" ]]; then
  printf '[FAIL] local-r-in-loops: local -r inside a loop body crashes on 2nd iteration:\n%s\n' \
    "$local_r_in_loops"
  fail=$(( fail + 1 ))
else
  printf '[PASS] local-r-in-loops: no local -r declarations inside loops\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: shebang and safety flags
# ---------------------------------------------------------------------------

printf '\n=== static: shebang and safety flags ===\n'

if head -1 "$script" | grep -qF '#!/usr/bin/env bash'; then
  printf '[PASS] shebang: uses #!/usr/bin/env bash\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] shebang: expected #!/usr/bin/env bash, got: %s\n' "$(head -1 "$script")"
  fail=$(( fail + 1 ))
fi

if grep -qF 'set -euo pipefail' "$script"; then
  printf '[PASS] safety-flags: set -euo pipefail is present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] safety-flags: set -euo pipefail is missing\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: @@REPO_DIR@@ substitution uses repo_dir (calling worktree), not a
# resolved primary worktree variable. The calling worktree is the intended
# deployment target — feature worktrees are used for local testing.
# ---------------------------------------------------------------------------

printf '\n=== static: REPO_DIR comes from calling worktree ===\n'
if grep -qE 'REPO_DIR.*primary' "$script"; then
  printf '[FAIL] repo-dir-source: @@REPO_DIR@@ uses a primary-worktree variable; must use repo_dir (calling worktree)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] repo-dir-source: @@REPO_DIR@@ uses repo_dir (calling worktree)\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: macOS skips loginctl enable-linger (not installed on Darwin)
# ---------------------------------------------------------------------------

printf '\n=== static: macOS skips loginctl enable-linger ===\n'
if grep -qF 'kernel_name' "$script" \
    && grep -qF "[[ \"\$kernel_name\" == \"Darwin\" ]]" "$script" \
    && grep -qF 'loginctl enable-linger' "$script" \
    && grep -qF 'Linux hosts only' "$script"; then
  printf '[PASS] macos-linger: Darwin branch skips loginctl with Linux-only message\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] macos-linger: expected Darwin guard + loginctl enable-linger + Linux-only message\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: macOS bypasses systemd unit installation ===\n'
if grep -qF 'skipping systemd user service installation' "$script" \
  && awk '
    /Main installation flow/ { in_main=1 }
    in_main && /skipping systemd user service installation/ { saw_macos_skip=1 }
    in_main && saw_macos_skip && /mkdir -p "\$target_dir"/ { exit 1 }
    END { exit(saw_macos_skip ? 0 : 1) }
  ' "$script"; then
  printf '[PASS] macos-install: Darwin exits before writing systemd user unit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] macos-install: expected early macOS exit before mkdir target_dir\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: macOS skips on-deploy and lockfile preflight ===\n'
if awk '
    /Main installation flow/ { in_main=1 }
    in_main && /skipping systemd user service installation/ { in_macos=1 }
    in_macos && /run_on_deploy_hook|run_lockfile_drift_preflight/ { exit 1 }
    in_macos && /exit 0/ { saw_macos_exit=1; in_macos=0 }
    END { exit(saw_macos_exit ? 0 : 1) }
' "$script"; then
  printf '[PASS] macos-deploy: Darwin exits before on-deploy and lockfile preflight\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] macos-deploy: Darwin must not run on-deploy or lockfile preflight\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: macOS --status skips systemd checks ===\n'
if awk '
  /^check_status\(\)/ { in_fn=1 }
  in_fn && /^}/ { in_fn=0 }
  in_fn && /systemd user services are not installed/ { saw_macos=1 }
  in_fn && saw_macos && /systemctl --user is-active/ { exit 1 }
  END { exit(saw_macos ? 0 : 1) }
' "$script"; then
  printf '[PASS] macos-status: check_status returns on Darwin before systemctl checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] macos-status: check_status must skip systemctl on Darwin\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: setup-service reports currently running commit SHA
# ---------------------------------------------------------------------------

printf '\n=== static: running commit reporting ===\n'
if grep -qF 'Running commit:' "$script" \
  && grep -qF 'read_deployed_commit_from_pid' "$script" \
  && grep -qF "/proc/\${main_pid}/environ" "$script"; then
  printf '[PASS] running-commit: reads DEPLOYED_COMMIT from process environment\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] running-commit: missing DEPLOYED_COMMIT environ-based running commit reporting\n'
  fail=$(( pass + 1 ))
fi

if grep -qF 'generate_service_unit' "$script" \
  && grep -qF 'Environment=DEPLOYED_COMMIT=' "$script"; then
  printf '[PASS] running-commit: injects DEPLOYED_COMMIT into generated unit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] running-commit: missing DEPLOYED_COMMIT injection in generate_service_unit\n'
  fail=$(( pass + 1 ))
fi

if ! grep -qF "git -C \"\$cwd\" rev-parse" "$script"; then
  printf '[PASS] running-commit: does not infer running commit from git HEAD at cwd\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] running-commit: still uses git HEAD at process cwd (unreliable after pull)\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'deploy_refresh_needed=1' "$script" \
  && grep -qF 'treating as stale (will refresh)' "$script" \
  && grep -qF 'conservative refresh' "$script"; then
  printf '[PASS] running-commit: missing or stale DEPLOYED_COMMIT forces conservative refresh\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] running-commit: missing conservative refresh when DEPLOYED_COMMIT absent\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: on-deploy exit code handling
#
# The on-deploy hook is invoked without `if` so that set -euo pipefail does
# not suppress its exit code.  Exit 0 → code_changed=true; exit 1 → nothing
# changed (fall through); exit 2+ → abort with a clear message.
# ---------------------------------------------------------------------------

printf '\n=== static: on-deploy respects exit codes ===\n'

# Must NOT use bare `if "${repo_dir}/scripts/on-deploy"` (swallows exit codes)
if grep -qE 'if[[:space:]]+"?\$\{?repo_dir\}?/scripts/on-deploy' "$script"; then
  printf '[FAIL] on-deploy-exit: on-deploy is called inside plain if; exit 2+ is silently ignored\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] on-deploy-exit: on-deploy is not called inside plain if\n'
  pass=$(( pass + 1 ))
fi

# Must capture exit code in a variable
if grep -qE 'on_deploy_exit' "$script"; then
  printf '[PASS] on-deploy-exit: exit code is captured in on_deploy_exit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] on-deploy-exit: on_deploy_exit variable not found — exit code not captured\n'
  fail=$(( fail + 1 ))
fi

# Must abort for exit code >= 2
if grep -qE '\[\[.*on_deploy_exit.*-ge 2' "$script"; then
  printf '[PASS] on-deploy-exit: exit code >= 2 causes abort\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] on-deploy-exit: no abort path for exit code >= 2\n'
  fail=$(( fail + 1 ))
fi

# Must capture on-deploy stderr to a temp file so it can be shown on abort
if grep -qE 'on_deploy_stderr.*mktemp' "$script"; then
  printf '[PASS] on-deploy-exit: on-deploy stderr is captured to a temp file\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] on-deploy-exit: on-deploy stderr is not captured — abort message has no context\n'
  fail=$(( fail + 1 ))
fi

# Must print the captured stderr on abort (actionable error message)
if grep -qE 'cat.*on_deploy_stderr' "$script"; then
  printf '[PASS] on-deploy-exit: captured stderr is printed on abort\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] on-deploy-exit: captured stderr is not printed on abort\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: failed start/restart prints service log location
# ---------------------------------------------------------------------------

printf '\n=== static: service failure log hints ===\n'
if grep -qF 'resolve_service_log_file' "$script" \
  && grep -qF 'print_service_failure_hint' "$script" \
  && grep -qF 'systemctl_user_or_fail' "$script" \
  && grep -qF 'Service log:' "$script" \
  && grep -qF 'scratch' "$script"; then
  printf '[PASS] service-failure: start/restart failure prints scratch log path hint\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-failure: missing resolve_service_log_file / print_service_failure_hint\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'Standard(Output|Error)=' "$script" \
  && grep -qF "append:\K" "$script"; then
  printf '[PASS] service-failure: resolves log path from StandardOutput/StandardError append\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-failure: missing StandardOutput/StandardError append log resolution\n'
  fail=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: status output includes service configuration path
# ---------------------------------------------------------------------------

printf '\n=== static: status includes config path ===\n'
if grep -qF 'Config:' "$script" \
  && grep -qF "\${target_service}" "$script"; then
  printf '[PASS] status-config-path: check_status prints service config file path\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] status-config-path: check_status does not print service config file path\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: status prints running pid on success ===\n'
if grep -qF 'service_main_pid' "$script" \
  && grep -qF 'correctly configured and running as pid' "$script"; then
  printf '[PASS] status-running-pid: check_status prints pid when service is running\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] status-running-pid: expected pid wording + service_main_pid usage\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'resolve_service_environment_file' "$script" \
  && grep -qF 'EnvironmentFile=' "$script" \
  && grep -qF 'User cfg:' "$script"; then
  printf '[PASS] status-config-path: check_status prints user EnvironmentFile path\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] status-config-path: check_status does not print user EnvironmentFile path\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: timer install and oneshot skip immediate start
# ---------------------------------------------------------------------------

printf '\n=== static: unit-discovery ===\n'
if grep -qF 'discover_unit_basenames' "$script" \
  && grep -qF 'expanded_units_dir' "$script" \
  && grep -qF 'etc/systemd' "$script" \
  && grep -qF '.config}/share/systemd-units' "$script"; then
  printf '[PASS] unit-discovery: setup-service reads etc/systemd templates and mirrors expanded units\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] unit-discovery: expected etc/systemd templates and ~/.config/share/systemd-units mirroring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: service host ConditionMachineId ===\n'
if grep -qF 'inject_service_host_machine_id_into_unit' "$script" \
  && grep -qF 'ConditionMachineId=' "$script" \
  && grep -qF 'read_local_machine_id' "$script" \
  && grep -qF 'machine_id_is_valid' "$script" \
  && grep -qF 'user-services-machine-id' "$script" \
  && grep -qF 'condition_host_config_path' "$script" \
  && grep -qF 'warn_host_skips_service' "$script" \
  && grep -F -e '--condition-host' "$script" >/dev/null; then
  printf '[PASS] service-host: injects ConditionMachineId and warns on wrong host\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-host: missing ConditionMachineId guard or host warning\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'host_runs_units' "$script" \
  && grep -qF 'Skipping loginctl enable-linger' "$script"; then
  printf '[PASS] service-host: skips linger and start on non-service-host machines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-host: missing linger/start skip on wrong host\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'normalize_machine_id' "$script"; then
  # shellcheck disable=SC2016  # grep for literal ${id,,} bash expansion in setup-service source
  if grep -qF '${id,,}' "$script"; then
    printf '[PASS] service-host: normalizes machine-id to lowercase hex\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] service-host: missing machine-id lowercase normalization\n'
    fail=$(( fail + 1 ))
  fi
else
  printf '[FAIL] service-host: missing machine-id lowercase normalization\n'
  fail=$(( fail + 1 ))
fi

if awk '
  /^inject_service_host_machine_id_into_unit\(\)/ { in_fn=1 }
  in_fn && /^}/ { in_fn=0 }
  in_fn && /grep -vE.*service-host-exec-condition/ { saw_grep=1 }
  in_fn && saw_grep && /\|\| true/ { saw_guard=1 }
  END { exit(saw_guard ? 0 : 1) }
' "$script"; then
  printf '[PASS] service-host: inject filter tolerates empty grep output\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-host: inject filter may abort when no legacy guard lines\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'resolve_service_host_machine_id' "$script" \
  && grep -qF 'status_only' "$script" \
  && grep -qF 'service_host_machine_id_failure' "$script" \
  && grep -qF 'invalid machine-id in' "$script" \
  && grep -qF 'machine-id not configured' "$script"; then
  printf '[PASS] service-host: --status distinguishes missing vs invalid machine-id\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-host: --status must distinguish missing vs invalid machine-id\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'load_machine_id_from_installed_units_for_status' "$script" \
  && grep -qF 'status_can_diff_units' "$script" \
  && grep -qF 'cannot verify template match (machine-id unresolved)' "$script"; then
  printf '[PASS] service-host: --status skips unit diff when machine-id unresolved\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-host: --status must not die when machine-id is unresolved\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'config_file_first_line' "$script"; then
  # shellcheck disable=SC2016  # grep for literal $(< /etc/machine-id) in setup-service source
  if grep -qF '$(< /etc/machine-id)' "$script"; then
    printf '[PASS] service-host: reads machine-id without cat or sed|head pipes\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] service-host: must read /etc/machine-id via bash $(<file)\n'
    fail=$(( fail + 1 ))
  fi
else
  printf '[FAIL] service-host: missing config_file_first_line helper\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # grep for literal $var in setup-service source
if grep -qF 'unit_source_timer_path "$unit_basename" || true' "$script"; then
  printf '[PASS] timer-optional: missing etc/systemd/*.timer does not abort setup\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] timer-optional: setup-service must tolerate repos without timer templates\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # grep for literal $var in setup-service source
if grep -qF 'elif [[ -f "$local_target_timer" ]]' "$script" \
  && grep -qF 'remove_stale_unit_file "$timer_filename"' "$script"; then
  printf '[PASS] timer-optional: removes installed timer when template is dropped\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] timer-optional: must disable timer removed from etc/systemd\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: systemd timer support ===\n'
timer_enable_ok=0
if grep -qF 'generate_timer_unit' "$script" \
  && grep -qF 'unit_source_timer_path' "$script"; then
  # shellcheck disable=SC2016
  if grep -qF 'enable --now "$timer_filename"' "$script" \
    && grep -qF 'host_runs_units' "$script"; then
    timer_enable_ok=1
  fi
fi
if [[ "$timer_enable_ok" == '1' ]]; then
  printf '[PASS] timer-install: generates and enables companion .timer unit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] timer-install: missing timer generation or enable --now\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'service_unit_is_oneshot' "$script" \
  && grep -qF 'remove_stale_managed_units' "$script" \
  && grep -qF 'oneshot — runs on timer schedule' "$script" \
  && grep -qF 'oneshot — no timer' "$script"; then
  printf '[PASS] oneshot-timer: oneshot services skip start; timers optional\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] oneshot-timer: missing oneshot/timer conditional handling\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: stale timer cleanup ===\n'
if grep -qF 'unit_should_remove_stale_timer' "$script" \
  && grep -qF 'unit_timer_activation_service_basename' "$script" \
  && grep -qF 'removed_stale_bases+=' "$script"; then
  printf '[PASS] stale-timer: removes orphaned timers for renamed or removed services\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stale-timer: missing paired-service stale timer cleanup\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
