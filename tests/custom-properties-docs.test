#!/usr/bin/env bash
# Every GitHub custom property the tooling reads must be documented (repository-helpers#861): a `*_property_name`
# constant in scripts/lib that docs/custom-properties.md, AGENTS.md and the README do not mention fails here, so an
# undocumented property cannot be merged. Also keeps the documented values, defaults and cache variables in step
# with the code.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

root="${script_dir}/.."
doc="${root}/docs/custom-properties.md"
readonly root doc

doc_text="$(cat "${doc}")"
agents_text="$(cat "${root}/AGENTS.md")"
readme_text="$(cat "${root}/README.md")"
skill_text="$(cat "${root}/.agents/skills/ship-and-review/SKILL.md")"
env_example="$(cat "${root}/etc/agent-review.env.example")"

printf '\n=== every custom property the libraries read is documented ===\n'
# The property names the code relies on: the value of every *_property_name constant under scripts/lib.
mapfile -t properties < <(grep -rhoE "[a-z_]*property_name='[a-z0-9-]+'" "${root}/scripts/lib" \
  | sed -E "s/.*='([a-z0-9-]+)'/\1/" | sort --unique)
if (( ${#properties[@]} >= 3 )); then
  pass_case "found ${#properties[@]} custom properties in scripts/lib (at least the three known ones)"
else
  fail_case "expected at least 3 *_property_name constants in scripts/lib, found ${#properties[@]}"
fi
for property in "${properties[@]}"; do
  assert_contains "docs/custom-properties.md documents \`${property}\`" "${doc_text}" "\`${property}\`"
  assert_contains "docs/custom-properties.md has a section for \`${property}\`" "${doc_text}" "## \`${property}\`"
  assert_contains "AGENTS.md mentions \`${property}\`" "${agents_text}" "\`${property}\`"
  assert_contains "README.md mentions \`${property}\`" "${readme_text}" "\`${property}\`"
  assert_contains "the ship-and-review skill or the doc names \`${property}\`" \
    "${skill_text}${doc_text}" "\`${property}\`"
done

printf '\n=== the three known properties are all there ===\n'
for property in agent-reviewers agent-review-enabled agent-review-max-rounds; do
  case " ${properties[*]} " in
    *" ${property} "*) pass_case "scripts/lib still reads \`${property}\`" ;;
    *) fail_case "scripts/lib no longer reads \`${property}\`: update docs/custom-properties.md too" ;;
  esac
done

printf '\n=== the documented values, defaults and cache variables match the code ===\n'
allowed_values="$(sed -nE "s/^agent_review_max_rounds_allowed_values='([^']+)'$/\1/p" \
  "${root}/scripts/lib/agent-review-max-rounds")"
default_rounds="$(sed -nE 's/^agent_review_max_rounds_default=([0-9]+)$/\1/p' \
  "${root}/scripts/lib/agent-review-max-rounds")"
known_reviewers="$(sed -nE "s/^agent_review_reviewers_known_chain='([^']+)'$/\1/p" \
  "${root}/scripts/lib/agent-review-reviewers")"
assert_contains 'the code has allowed values for the round cap' "${allowed_values}" '0'
for value in ${allowed_values}; do
  assert_contains "the round cap table lists the allowed value ${value}" "${doc_text}" "\`${value}\`"
done
assert_contains 'the doc states the code default round cap' "${doc_text}" "\`${default_rounds}\`"
for reviewer in ${known_reviewers//,/ }; do
  assert_contains "the doc lists the reviewer ${reviewer}" "${doc_text}" "\`${reviewer}\`"
done
for var in AGENT_REVIEW_MAX_ROUNDS AGENT_REVIEW_MAX_ROUNDS_CACHE_DIR AGENT_REVIEW_REVIEWERS_CACHE_DIR \
  AGENT_REVIEW_QUOTA_FALLBACK_CHAIN; do
  assert_contains "the doc names ${var}" "${doc_text}" "${var}"
  if grep -rqF -- "${var}" "${root}/scripts/lib" "${root}/scripts/wait-for-agent-review"; then
    pass_case "${var} is a variable the scripts really read"
  else
    fail_case "${var} is documented but no script reads it"
  fi
done

printf '\n=== the reference is linked where operators look ===\n'
assert_contains 'AGENTS.md links the reference' "${agents_text}" 'docs/custom-properties.md'
assert_contains 'README.md links the reference' "${readme_text}" 'docs/custom-properties.md'
assert_contains 'the skill links the reference' "${skill_text}" 'docs/custom-properties.md'
assert_contains 'the env example links the reference' "${env_example}" 'docs/custom-properties.md'
assert_contains 'the env example has the AGENT_REVIEW_MAX_ROUNDS override' "${env_example}" 'AGENT_REVIEW_MAX_ROUNDS'

printf '\n=== the doc tells maintainers how to add a property ===\n'
assert_contains 'the doc has the adding-a-property checklist' "${doc_text}" '## Adding another property'
assert_contains 'the checklist points at the repo-practices schema functions' "${doc_text}" 'rp_apply_agent_reviewers_schema'
assert_contains 'the checklist names this test' "${doc_text}" 'tests/custom-properties-docs.test'

test_summary
