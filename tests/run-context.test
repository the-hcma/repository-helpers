#!/usr/bin/env bash
# Tests for scripts/lib/run-context helpers.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"

lib="${script_dir}/../scripts/lib/run-context"
readonly lib

test_init
pass=0
fail=0

printf '\n=== static: run-context structure ===\n'
lib_text="$(cat "$lib")"
assert_contains "declares footer_full" "$lib_text" "repo_helpers_run_context_footer_full()"
assert_contains "declares commit helper" "$lib_text" "repo_helpers_run_context_commit()"

# shellcheck disable=SC1090
source "$lib"

printf '\n=== footer_full: field order ===\n'
footer=""
footer="$(repo_helpers_run_context_footer_full \
  '/path/to/scripts/dep-updater-batch-run' '/path/to/repo' \
  '2026-06-19T10:00:00-04:00' '2026-06-19T10:05:00-04:00' \
  '/tmp/batch.log' '---')"

assert_contains "footer has Run context" "$footer" "Run context:"
assert_contains "footer has Workdir" "$footer" "Workdir:"
assert_contains "footer has Log file" "$footer" "Log file:"
assert_contains "footer has Started" "$footer" "Started:"
assert_contains "footer has Finished" "$footer" "Finished:"

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
