#!/usr/bin/env bash
# Smoke and static tests for scripts/dev/post-pr-submission-checks.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/dev/post-pr-submission-checks"
readonly script

printf '\n=== --help ===\n'
help_out=""
help_exit=0
help_out="$(bash "$script" --help 2>&1)" || help_exit=$?
assert_exit_0 "--help" "$help_out" "$help_exit"
assert_contains "--help usage" "$help_out" "post-pr-submission-checks"

printf '\n=== unknown argument ===\n'
unknown_out=""
unknown_exit=0
unknown_out="$(bash "$script" --nope 2>&1)" || unknown_exit=$?
assert_exit_nonzero "unknown arg" "$unknown_out" "$unknown_exit"
assert_contains "unknown arg" "$unknown_out" "Unknown argument"

printf '\n=== functional: waits for CI success ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json statusCheckRollup'* ]]; then
  # Green required-style check (empty rollup is "missing"/pending under shared gating).
  printf '%s\n' '[{"name":"CI","conclusion":"SUCCESS","status":"COMPLETED","detailsUrl":"x"}]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

set +e
out="$(PATH="${mock_bin}:${PATH}" POST_PR_CHECKS_TIMEOUT=1s POST_PR_CHECKS_POLL_SECS=1 bash "$script" 2>&1)"
exit_code=$?
set -e

assert_exit_0 "ci success" "$out" "$exit_code"
assert_contains "ci success logs" "$out" "CI passed"
rm -rf "$tmp"

printf '\n=== functional: timeout emits WAIT_TIMEOUT line ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cp "${script_dir}/lib/test-assert" "${tmp}/test-assert" >/dev/null 2>&1 || true

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json statusCheckRollup'* ]]; then
  # Pending check (empty conclusion).
  printf '%s\n' '[{"name":"CI","conclusion":null,"detailsUrl":"x"}]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

set +e
out="$(PATH="${mock_bin}:${PATH}" POST_PR_CHECKS_TIMEOUT=1s POST_PR_CHECKS_POLL_SECS=1 bash "$script" 2>&1)"
exit_code=$?
set -e

assert_exit_nonzero "timeout" "$out" "$exit_code"
assert_contains "timeout line" "$out" "ERROR: WAIT_TIMEOUT post-pr-submission-checks"
rm -rf "$tmp"

printf '\n=== functional: CANCELLED-only stays pending until timeout (#454) ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json statusCheckRollup'* ]]; then
  printf '%s\n' '[{"name":"Frontend","conclusion":"CANCELLED","status":"COMPLETED","detailsUrl":"https://example.invalid/job/9"}]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

set +e
out="$(PATH="${mock_bin}:${PATH}" POST_PR_CHECKS_TIMEOUT=1s POST_PR_CHECKS_POLL_SECS=1 bash "$script" 2>&1)"
exit_code=$?
set -e

assert_exit_nonzero "cancelled-only timeout" "$out" "$exit_code"
assert_contains "cancelled-only timeout line" "$out" "ERROR: WAIT_TIMEOUT post-pr-submission-checks"
assert_contains "cancelled-only note" "$out" "NOTE: CANCELLED checks still present"
assert_contains "cancelled-only name" "$out" "Frontend"
if grep -qF 'ERROR: CI failures' <<<"$out"; then
  printf '[FAIL] cancelled-only: must not report ERROR: CI failures\n%s\n' "$out"
  fail=$(( fail + 1 ))
else
  printf '[PASS] cancelled-only: no false CI failures line\n'
  pass=$(( pass + 1 ))
fi
rm -rf "$tmp"

printf '\n=== static: CI failure agent report wiring ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'ci_agent_report_failed_logs_for_pr' "$script" \
  && grep -qF 'CI failure details for coding agent' "$script" \
  && grep -qF 'POST_PR_CHECKS_LOG_LINES' "$script"; then
  printf '[PASS] post-pr-submission-checks: exposes filtered CI failure logs for agents\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] post-pr-submission-checks: missing CI failure agent report wiring\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'ci_rollup_latest_by_name_json' "$script" \
  && grep -qF 'ci_rollup_conclusion_for_gating' "$script" \
  && grep -qF 'ci_rollup_cancelled_lines' "$script" \
  && grep -qF 'ci_rollup_without_agent_product_checks' "$script"; then
  printf '[PASS] post-pr-submission-checks: gates via shared rollup conclusion (#454)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] post-pr-submission-checks: must use ci_rollup_conclusion_for_gating for CI gate\n'
  fail=$(( fail + 1 ))
fi

if grep -qF "MERGED' ]]; then" "$script" \
  && grep -qF 'merged during CI wait' "$script"; then
  printf '[PASS] post-pr-submission-checks: CI wait short-circuits when PR is merged\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] post-pr-submission-checks: missing merge short-circuit in CI wait\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # static assert matches literal || true after the helper call
if grep -qF 'approve-pending-deployments' "$script" \
  && grep -qF 'on operator behalf' "$script" \
  && grep -qF 'ERROR: ENVIRONMENT_APPROVAL_FAILED' "$script" \
  && grep -qF 'raise this to the operator' "$script" \
  && grep -qF 'runner_sh_stdout "post-pr-submission-checks usage"' "$script" \
  && ! grep -qF 'approve-pending-deployments" --pr "$pr" || true' "$script"; then
  printf '[PASS] post-pr-submission-checks: CI wait approves waiting environments on operator behalf\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] post-pr-submission-checks: CI wait must call approve-pending-deployments and raise failures\n'
  fail=$(( fail + 1 ))
fi

ci_lib="${script_dir}/../scripts/lib/ci-check-rollup"
if grep -qF 'ci_agent_filter_failed_log_lines' "$ci_lib" \
  && grep -qF 'ci_failed_workflow_run_id_for_pr' "$ci_lib"; then
  printf '[PASS] ci-check-rollup: failed-run discovery and log filter helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ci-check-rollup: missing agent CI failure report helpers\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: CI failure prints agent log report ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'headRefOid'* ]]; then
  printf 'deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'headRefName'* ]]; then
  printf 'my-branch\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'statusCheckRollup'* ]]; then
  printf '%s\n' '[{"name":"shellcheck + tests","conclusion":"FAILURE","detailsUrl":"https://example.invalid/job/1"}]'
  exit 0
fi
if [[ "$args" == *'run list'* ]]; then
  printf '%s\n' '[{"databaseId":999,"headSha":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeef","conclusion":"failure"}]'
  exit 0
fi
if [[ "$args" == *'run view 999'* && "$args" == *'--json url'* ]]; then
  printf 'https://example.invalid/run/999\n'
  exit 0
fi
if [[ "$args" == *'run view 999'* && "$args" == *'--log-failed'* ]]; then
  printf '%s\n' '[FAIL] mock profile: rejected fixture
--- results: 1 passed, 1 failed ---'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

set +e
out="$(PATH="${mock_bin}:${PATH}" POST_PR_CHECKS_TIMEOUT=1s POST_PR_CHECKS_POLL_SECS=1 bash "$script" 2>&1)"
exit_code=$?
set -e

assert_exit_nonzero "ci failure" "$out" "$exit_code"
assert_contains "ci failure summary" "$out" "ERROR: CI failures for PR #42"
assert_contains "ci failure agent report" "$out" "CI failure details for coding agent"
assert_contains "ci failure log excerpt" "$out" "[FAIL] mock profile: rejected fixture"
rm -rf "$tmp"

printf '\n=== functional: WAITING env approval failure is raised (not WAIT_TIMEOUT) ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json statusCheckRollup'* ]]; then
  printf '%s\n' '[{"name":"org repo-practices audit","status":"WAITING","conclusion":null,"detailsUrl":"https://github.com/the-hcma/mock-repo/actions/runs/9/job/1"}]'
  exit 0
fi
if [[ "$args" == *'--method POST'* ]]; then
  printf 'should not POST\n' >&2
  exit 1
fi
if [[ "$args" == *'pending_deployments'* ]]; then
  printf '%s\n' '[{"environment":{"id":1,"name":"github-repo-lint"},"current_user_can_approve":false}]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

set +e
out="$(PATH="${mock_bin}:${PATH}" POST_PR_CHECKS_TIMEOUT=20s POST_PR_CHECKS_POLL_SECS=1 bash "$script" --pr 42 2>&1)"
exit_code=$?
set -e

assert_exit_nonzero "env approval failed" "$out" "$exit_code"
assert_contains "env approval failed marker" "$out" "ERROR: ENVIRONMENT_APPROVAL_FAILED"
assert_contains "env approval raise to operator" "$out" "raise this to the operator"
if grep -qF 'ERROR: WAIT_TIMEOUT' <<<"$out"; then
  printf '[FAIL] env approval failed: must not fall through to WAIT_TIMEOUT\n%s\n' "$out"
  fail=$(( fail + 1 ))
else
  printf '[PASS] env approval failed: no WAIT_TIMEOUT fallback\n'
  pass=$(( pass + 1 ))
fi
rm -rf "$tmp"

printf '\n=== functional: resolves repo_dir from caller cwd, not its own path (#590) ===\n'
tmp_repo="$(mktemp -d)"
remote_dir="$(mktemp -d)"
caller_branch="test-590-caller-branch"
(
  cd "$tmp_repo"
  git init -q
  git config user.email 'test@example.com'
  git config user.name 'Test'
  printf 'x\n' >README.md
  git add README.md
  git commit -q -m 'init'
  git init -q --bare "$remote_dir"
  git remote add origin "$remote_dir"
  git checkout -q -b "$caller_branch"
  # Local-only upstream tracking (no push): satisfies git rev-parse --abbrev-ref
  # @{u} without a real git operation against remote state (coding guideline).
  git update-ref "refs/remotes/origin/${caller_branch}" HEAD
  git config "branch.${caller_branch}.remote" origin
  git config "branch.${caller_branch}.merge" "refs/heads/${caller_branch}"
)

mock_bin="$(mktemp -d)"
captured="${mock_bin}/captured-branch"
cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
if [[ "\$1 \$2" == 'pr list' ]]; then
  prev=""
  for a in "\$@"; do
    if [[ "\$prev" == '--head' ]]; then
      printf '%s\n' "\$a" >'${captured}'
    fi
    prev="\$a"
  done
  printf '99\n'
  exit 0
fi
args="\$*"
if [[ "\$args" == *'pr view 99'* && "\$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "\$args" == *'pr view 99'* && "\$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "\$args" == *'pr view 99'* && "\$args" == *'--json body'* ]]; then
  printf '%s\n' \$'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

# Real (unmocked) git so branch/upstream resolution reflects the actual repo_dir
# the script computes — a mocked git would hide the bug (it matches on the
# subcommand text only, ignoring which repo -C points at).
caller_out=""
caller_exit=0
caller_out="$(cd "$tmp_repo" && PATH="${mock_bin}:${PATH}" bash "$script" --no-wait 2>&1)" || caller_exit=$?
assert_exit_0 "post-pr-submission-checks from caller repo" "$caller_out" "$caller_exit"
if [[ -f "$captured" ]] && [[ "$(cat "$captured")" == "$caller_branch" ]]; then
  pass_case 'discovers the PR using the caller repo branch, not repository-helpers own (#590)'
else
  fail_case "expected gh pr list --head ${caller_branch}, captured: $(cat "$captured" 2>/dev/null || printf '<none>')"
fi
rm -rf "$tmp_repo" "$remote_dir" "$mock_bin"

test_summary

