printf '\n=== functional: a failure from a cancelled, superseded run is not a result (#884) ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
if [[ "$*" == *'ls-remote --heads origin my-branch'* ]]; then
  printf '%s\trefs/heads/my-branch\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  exit 0
fi
if [[ "$*" == *'rev-parse HEAD'* ]]; then
  printf '%s\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

write_mock_jq_passthrough "${mock_bin}"

# The rollup and the run list come from the environment, so one mock serves every case below.
cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'headRefOid'* ]]; then
  printf 'deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'headRefName'* ]]; then
  printf 'my-branch\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'statusCheckRollup'* ]]; then
  printf '%s\n' "${MOCK_ROLLUP_JSON}"
  exit 0
fi
if [[ "$args" == *'run list'* ]]; then
  if [[ "${MOCK_RUNS_FAIL:-0}" == 1 ]]; then
    exit 1
  fi
  # An older gh has no attempt or event field and fails the whole listing.
  if [[ "${MOCK_RUNS_NO_ATTEMPT:-0}" == 1 && "$args" == *'attempt'* ]]; then
    exit 1
  fi
  # The superseded-run lookup must list the runs of the head commit (--commit <sha>), not of a branch name: a busy
  # branch name would push them out of the listing. A listing by branch (also used by the failure report, which
  # tolerates a failed listing) gets no answer here, so the lookup cannot fall back to it unnoticed.
  if [[ "$args" != *'--commit deadbeefdeadbeefdeadbeefdeadbeefdeadbeef'* ]]; then
    printf 'mock: run list without --commit <head sha>: %s\n' "$args" >&2
    exit 1
  fi
  # Every listing is counted (one per poll that sees a failing row). With MOCK_RUNS_AFTER_JSON set, the first listing
  # returns MOCK_RUNS_JSON and every later one the AFTER json: the newer run finishes during the wait.
  n=0
  if [[ -f "${MOCK_RUNS_COUNTER}" ]]; then n="$(<"${MOCK_RUNS_COUNTER}")"; fi
  n=$(( n + 1 ))
  printf '%s' "$n" >"${MOCK_RUNS_COUNTER}"
  # Only the first listing works: a later one fails, so a gate that lists again cannot see the runs it saw before.
  if [[ "${MOCK_RUNS_FAIL_AFTER_FIRST:-0}" == 1 ]] && (( n > 1 )); then
    exit 1
  fi
  if [[ -n "${MOCK_RUNS_AFTER_JSON:-}" ]] && (( n > 1 )); then
    printf '%s\n' "${MOCK_RUNS_AFTER_JSON}"
    exit 0
  fi
  printf '%s\n' "${MOCK_RUNS_JSON}"
  exit 0
fi
if [[ "$args" == *'api '* && "$args" == *' repos/'* && "$args" == *'/actions/runs/'*'/attempts/'*'/jobs'* ]]; then
  # The jobs of an attempt as the REST API returns them, run through the --jq filter the script passes, so the real
  # filter decides. An outage is a job that never got a runner (no runner, no steps) plus an aggregate job that
  # got one after the first gave up and failed on its dependency, next to a job that passed.
  # MOCK_JOBS_FAIL=1 fails the call; MOCK_JOBS_CONCURRENT=1 adds a real failure that ran alongside the outage;
  # MOCK_JOBS_LATE_REAL=1 adds a late independent real failure; MOCK_OUTAGE_ATTEMPTS (space-separated attempt
  # numbers) makes only those attempts an outage.
  if [[ "${MOCK_JOBS_FAIL:-0}" == 1 ]]; then exit 1; fi
  outage=0
  if [[ -n "${MOCK_OUTAGE_ATTEMPTS:-}" ]]; then
    attempt_no="${args##*/attempts/}"
    attempt_no="${attempt_no%%/*}"
    if [[ " ${MOCK_OUTAGE_ATTEMPTS} " == *" ${attempt_no} "* ]]; then outage=1; fi
  elif [[ "${MOCK_RUNNER_NEVER_ACQUIRED:-0}" == 1 ]]; then
    outage=1
  fi
  jq_filter=""
  prev=""
  for arg in "$@"; do
    if [[ "$prev" == --jq ]]; then jq_filter="$arg"; fi
    prev="$arg"
  done
  jobs_json='{"jobs":['
  if (( outage == 1 )); then
    jobs_json+='{"conclusion":"failure","runner_id":0,"steps":[],"started_at":"2026-11-27T10:00:00Z","completed_at":"2026-11-27T10:15:00Z"},'
    jobs_json+='{"conclusion":"failure","runner_id":9,"steps":[{"name":"Require every part"}],"started_at":"2026-11-27T10:15:05Z","completed_at":"2026-11-27T10:15:30Z"},'
    jobs_json+='{"conclusion":"success","runner_id":3,"steps":[{"name":"build"}],"started_at":"2026-11-27T10:00:00Z","completed_at":"2026-11-27T10:03:00Z"}'
    if [[ "${MOCK_JOBS_CONCURRENT:-0}" == 1 ]]; then
      jobs_json+=',{"conclusion":"failure","runner_id":4,"steps":[{"name":"test"}],"started_at":"2026-11-27T10:05:00Z","completed_at":"2026-11-27T10:06:00Z"}'
    fi
    if [[ "${MOCK_JOBS_LATE_REAL:-0}" == 1 ]]; then
      jobs_json+=',{"conclusion":"failure","runner_id":5,"steps":[{"name":"test"}],"started_at":"2026-11-27T10:20:00Z","completed_at":"2026-11-27T10:21:00Z"}'
    fi
  else
    jobs_json+='{"conclusion":"failure","runner_id":9,"steps":[{"name":"test"}],"started_at":"2026-11-27T10:00:00Z","completed_at":"2026-11-27T10:01:00Z"},'
    jobs_json+='{"conclusion":"skipped","runner_id":0,"steps":[],"started_at":"2026-11-27T10:00:00Z","completed_at":"2026-11-27T10:00:01Z"}'
  fi
  jobs_json+=']}'
  printf '%s' "$jobs_json" | jq -c "$jq_filter"
  exit 0
fi
if [[ "$args" == *'api repos/'* && "$args" == *'/actions/runs/'*'/attempts/'* ]]; then
  # The conclusion of an earlier attempt of a rerun run (#884).
  # MOCK_ATTEMPTS is a space-separated list of conclusions by attempt number (attempt 1 first); without it every
  # attempt answers MOCK_ATTEMPT_CONCLUSION.
  if [[ -n "${MOCK_ATTEMPTS:-}" ]]; then
    read -ra attempt_list <<<"${MOCK_ATTEMPTS}"
    attempt_no="${args##*/attempts/}"
    attempt_no="${attempt_no%% *}"
    printf '%s\n' "${attempt_list[$(( attempt_no - 1 ))]:-}"
    exit 0
  fi
  printf '%s\n' "${MOCK_ATTEMPT_CONCLUSION:-}"
  exit 0
fi
if [[ "$args" == *'run view'* ]]; then
  printf 'https://example.invalid/run\n'
  exit 0
fi
if [[ "$args" == *'api repos/'* && "$args" == *'squash_merge_commit_title'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "$args" == *'pr view'* && "$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: mock title'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

# A logical clock for the polling cases: `date +%s` reads it and `sleep` advances it, so the number of polls depends
# on the timeout and the poll interval and never on host speed. Any other `date` call goes to the real one.
cat >"${mock_bin}/date" <<'MOCK_DATE'
#!/usr/bin/env bash
if [[ "$*" == '+%s' && -f "${MOCK_CLOCK:-}" ]]; then
  cat "${MOCK_CLOCK}"
  exit 0
fi
exec "${MOCK_REAL_DATE}" "$@"
MOCK_DATE
cat >"${mock_bin}/sleep" <<'MOCK_SLEEP'
#!/usr/bin/env bash
if [[ -f "${MOCK_CLOCK:-}" ]]; then
  now="$(<"${MOCK_CLOCK}")"
  add=$(( ${1%%.*} ))
  if [[ "$1" == *.* ]]; then add=$(( add + 1 )); fi  # a fractional sleep still moves the clock forward
  printf '%s' "$(( now + add ))" >"${MOCK_CLOCK}"
  exit 0
fi
exec "${MOCK_REAL_SLEEP}" "$@"
MOCK_SLEEP
chmod +x "${mock_bin}/date" "${mock_bin}/sleep"

head_sha='deadbeefdeadbeefdeadbeefdeadbeefdeadbeef'
# assert_rc_is <label> <output> <status> and assert_rc_is_not: the output has a line that is exactly rc=<status>
# (a needle that starts with a newline would make grep -F match every line).
assert_rc_is() {
  if grep -qx -- "rc=$3" <<<"$2"; then pass_case "$1"; else printf '  expected rc=%s, got:\n%s\n' "$3" "$2" >&2; fail_case "$1"; fi
}
assert_rc_is_not() {
  if grep -qx -- "rc=$3" <<<"$2"; then printf '  unexpected rc=%s in:\n%s\n' "$3" "$2" >&2; fail_case "$1"; else pass_case "$1"; fi
}
# run_superseded_case <rollup-json> <runs-json> [runs-fail]: runs the gate against the mock; prints the output
# and then "rc=<status>".
run_superseded_case() {
  local out rc=0 real_date real_sleep
  # Absolute paths of the real tools, taken before the mock directory goes first: the mocks fall back to them.
  real_date="$(command -v date)"
  real_sleep="$(command -v sleep)"
  rm -f "${tmp}/runs-counter"
  printf '1000' >"${tmp}/clock"
  out="$(PATH="${mock_bin}:${PATH}" GITHUB_API_PACING=0 MOCK_REAL_DATE="${real_date}" MOCK_REAL_SLEEP="${real_sleep}" MOCK_CLOCK="${tmp}/clock" MOCK_ROLLUP_JSON="$1" MOCK_RUNS_JSON="$2" MOCK_RUNS_FAIL="${3:-0}" \
    MOCK_RUNS_AFTER_JSON="${4:-}" MOCK_RUNS_COUNTER="${tmp}/runs-counter" \
    POST_PR_CHECKS_TIMEOUT="${POST_PR_TIMEOUT:-1s}" POST_PR_CHECKS_POLL_SECS=1 bash "$script" 2>&1)" || rc=$?
  printf '%s\nrc=%s\n' "$out" "$rc"
}
# The #882 shape: an aggregate job failed inside a run GitHub marked cancelled, and a newer run of the same
# workflow on the head succeeded.
shape_rollup='[
  {"name":"shellcheck + tests","conclusion":"FAILURE","startedAt":"2026-11-18T16:18:23Z","detailsUrl":"https://github.com/o/r/actions/runs/200/job/1"},
  {"name":"actionlint","conclusion":"SUCCESS","startedAt":"2026-11-18T16:22:04Z","detailsUrl":"https://github.com/o/r/actions/runs/300/job/2"}
]'
runs_superseded='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"cancelled","status":"completed","workflowDatabaseId":7}
]'
out="$(run_superseded_case "$shape_rollup" "$runs_superseded")"
assert_rc_is 'the failure of a cancelled run with a newer run of its workflow does not fail the gate' "$out" 0
assert_contains 'and one NOTE names the check and the run' "$out" 'NOTE: CI_FAILURE_SUPERSEDED pr=42 check=shellcheck + tests run=200 reason=run_cancelled_and_superseded'
assert_not_contains 'and no failure report is printed' "$out" 'ERROR: CI failures for PR #42'

runs_real_failure='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":7}
]'
out="$(run_superseded_case "$shape_rollup" "$runs_real_failure")"
assert_contains 'a failure whose own run really failed still fails the gate' "$out" 'ERROR: CI failures for PR #42'
assert_not_contains 'and is not reported as superseded' "$out" 'CI_FAILURE_SUPERSEDED'

runs_no_newer='[
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"cancelled","status":"completed","workflowDatabaseId":7},
  {"databaseId":500,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":9}
]'
out="$(run_superseded_case "$shape_rollup" "$runs_no_newer")"
assert_contains 'a cancelled run that nothing superseded keeps its failure (a newer run of another workflow does not count)' "$out" 'ERROR: CI failures for PR #42'

runs_newer_in_progress='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"","status":"in_progress","workflowDatabaseId":7},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"cancelled","status":"completed","workflowDatabaseId":7}
]'
out="$(POST_PR_TIMEOUT=4s run_superseded_case "$shape_rollup" "$runs_newer_in_progress")"
assert_rc_is_not 'a newer run still in progress with no row yet for the check does not let the gate pass' "$out" 0
assert_contains 'the gate keeps waiting for it (WAIT_TIMEOUT)' "$out" 'ERROR: WAIT_TIMEOUT'
assert_contains 'and the NOTE says the newer run has not finished' "$out" 'reason=run_cancelled_newer_run_not_finished'
assert_equals_note_count() {
  local n
  n="$(grep -c 'NOTE: CI_FAILURE_SUPERSEDED' <<<"$2" || true)"
  if [[ "$n" == "$3" ]]; then pass_case "$1"; else printf '  expected %s NOTE line(s), got %s in:\n%s\n' "$3" "$n" "$2" >&2; fail_case "$1"; fi
}
assert_equals_note_count 'the NOTE is printed once for the whole wait, not on every poll' "$out" 1
polls="$(cat "${tmp}/runs-counter" 2>/dev/null || echo 0)"
if (( polls >= 2 )); then pass_case 'and the gate polled at least twice, so the single NOTE shows the deduplication'; else printf '  only %s poll(s) ran\n' "$polls" >&2; fail_case 'and the gate polled at least twice, so the single NOTE shows the deduplication'; fi

# The newer run is still in progress on the first poll and has completed with success on the next ones: the row stays
# pending, then is dropped, and the gate ends successfully.
out="$(POST_PR_TIMEOUT=6s run_superseded_case "$shape_rollup" "$runs_newer_in_progress" 0 "$runs_superseded")"
assert_rc_is 'a newer run that finishes during the wait turns the pending row into a success' "$out" 0
assert_contains 'the first NOTE says the newer run has not finished' "$out" 'reason=run_cancelled_newer_run_not_finished'
assert_contains 'the second NOTE says the row was superseded' "$out" 'reason=run_cancelled_and_superseded'
assert_equals_note_count 'and each reason is named once' "$out" 2

for ended in cancelled skipped startup_failure failure timed_out; do
  runs_newest_ended='[
    {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"'"${ended}"'","status":"completed","workflowDatabaseId":7},
    {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"cancelled","status":"completed","workflowDatabaseId":7}
  ]'
  out="$(run_superseded_case "$shape_rollup" "$runs_newest_ended")"
  assert_contains "a newer run that ended ${ended} does not supersede the failure of the cancelled one" "$out" 'ERROR: CI failures for PR #42'
  assert_not_contains "and the row is not dropped for a run that ended ${ended}" "$out" 'CI_FAILURE_SUPERSEDED'
done

runs_older_head='[
  {"databaseId":900,"headSha":"0000000000000000000000000000000000000000","conclusion":"success","status":"completed","workflowDatabaseId":7},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"cancelled","status":"completed","workflowDatabaseId":7}
]'
out="$(run_superseded_case "$shape_rollup" "$runs_older_head")"
assert_contains 'a newer run on another head does not supersede a cancelled run on this head' "$out" 'ERROR: CI failures for PR #42'
assert_not_contains 'and is not reported as superseded either' "$out" 'CI_FAILURE_SUPERSEDED'

pending_rollup='[
  {"name":"shellcheck + tests","conclusion":"FAILURE","startedAt":"2026-11-18T16:18:23Z","detailsUrl":"https://github.com/o/r/actions/runs/200/job/1"},
  {"name":"tests (shard 1/4)","status":"IN_PROGRESS","conclusion":"","startedAt":"2026-11-18T16:19:04Z","detailsUrl":"https://github.com/o/r/actions/runs/300/job/3"}
]'
out="$(run_superseded_case "$pending_rollup" "$runs_superseded")"
assert_not_contains 'a superseded failure beside a newer run still in progress is not reported as a failure' "$out" 'ERROR: CI failures for PR #42'
assert_contains 'and the gate keeps waiting for the newer run (WAIT_TIMEOUT, not success)' "$out" 'ERROR: WAIT_TIMEOUT'
out="$(run_superseded_case "$shape_rollup" '[]' 1)"
assert_contains 'when the runs cannot be listed the original failure stands' "$out" 'ERROR: CI failures for PR #42'
assert_not_contains 'and nothing is called superseded' "$out" 'CI_FAILURE_SUPERSEDED'

# A green rollup is still a failure when a run failed first on the same head: a flake is fixed, never accepted (#884).
green_rollup='[
  {"name":"shellcheck + tests","conclusion":"SUCCESS","startedAt":"2026-11-18T16:22:04Z","detailsUrl":"https://github.com/o/r/actions/runs/300/job/2"}
]'
runs_clean='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1}
]'
out="$(run_superseded_case "$green_rollup" "$runs_clean")"
assert_rc_is 'a green head whose runs all passed first time passes the gate' "$out" 0
assert_not_contains 'and reports no flake' "$out" 'CI_FLAKE_DETECTED'

runs_rerun_after_failure='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":2}
]'
out="$(MOCK_ATTEMPT_CONCLUSION=failure run_superseded_case "$green_rollup" "$runs_rerun_after_failure")"
assert_rc_is_not 'a run that passed on a rerun after a failed attempt does not pass the gate' "$out" 0
assert_contains 'and the flake is named with the run and attempts' "$out" 'run=300 attempt=2 passed after attempt 1 failure'
assert_contains 'and the report says a flake is fixed, not accepted' "$out" 'A flaky test is never accepted'

out="$(MOCK_ATTEMPT_CONCLUSION=cancelled run_superseded_case "$green_rollup" "$runs_rerun_after_failure")"
assert_rc_is 'a rerun after a cancelled attempt is not a flake' "$out" 0

runs_failed_then_passed='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"}
]'
out="$(run_superseded_case "$green_rollup" "$runs_failed_then_passed")"
assert_rc_is_not 'a newer run that passed after a failed run of the same workflow does not pass the gate' "$out" 0
assert_contains 'and the flake names both runs' "$out" 'workflow=7 failed_run=200 passing_run=300'

runs_other_workflow_failed='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":9,"attempt":1,"event":"pull_request"}
]'
out="$(run_superseded_case "$green_rollup" "$runs_other_workflow_failed")"
assert_rc_is 'a failed run of another workflow is not a flake of this one' "$out" 0

out="$(run_superseded_case "$green_rollup" "$runs_rerun_after_failure" 1)"
assert_rc_is 'when the runs cannot be listed the green verdict stands' "$out" 0

runs_rerun_three='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":3}
]'
out="$(MOCK_ATTEMPTS='failure cancelled' run_superseded_case "$green_rollup" "$runs_rerun_three")"
assert_rc_is_not 'attempt 1 failed, attempt 2 was cancelled, attempt 3 passed: still a flake' "$out" 0
assert_contains 'and the failed earlier attempt is named' "$out" 'run=300 attempt=3 passed after attempt 1 failure'
out="$(MOCK_ATTEMPTS='cancelled cancelled' run_superseded_case "$green_rollup" "$runs_rerun_three")"
assert_rc_is 'attempts that were only ever cancelled before the pass are not a flake' "$out" 0

out="$(MOCK_ATTEMPT_CONCLUSION=failure MOCK_RUNNER_NEVER_ACQUIRED=1 run_superseded_case "$green_rollup" "$runs_rerun_after_failure")"
assert_rc_is 'a rerun after a runner that was never acquired is an outage, not a flake' "$out" 0
assert_contains 'and the outage is noted' "$out" 'NOTE: CI_RERUN_RUNNER_NOT_ACQUIRED pr=42 run=300 attempt=1'
assert_not_contains 'and no flake is reported' "$out" 'CI_FLAKE_DETECTED'

out="$(MOCK_RUNNER_NEVER_ACQUIRED=1 run_superseded_case "$green_rollup" "$runs_failed_then_passed")"
assert_rc_is 'a failed run that never got a runner, followed by a passing run, is not a flake' "$out" 0
assert_contains 'and its outage is noted' "$out" 'NOTE: CI_RERUN_RUNNER_NOT_ACQUIRED pr=42 run=200 attempt=1'

runs_failed_twice_then_passed='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":7,"attempt":2,"event":"pull_request"}
]'
out="$(MOCK_ATTEMPTS='failure failure' MOCK_OUTAGE_ATTEMPTS='2' run_superseded_case "$green_rollup" "$runs_failed_twice_then_passed")"
assert_rc_is_not 'attempt 1 failed for real and attempt 2 was an outage: still a flake' "$out" 0
assert_contains 'and the failed run is named' "$out" 'workflow=7 failed_run=200 passing_run=300'
out="$(MOCK_ATTEMPTS='failure failure' MOCK_OUTAGE_ATTEMPTS='1 2' run_superseded_case "$green_rollup" "$runs_failed_twice_then_passed")"
assert_rc_is 'a run whose every failed attempt was an outage is not a flake' "$out" 0

runs_push_failed_pr_passed='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"push"}
]'
out="$(run_superseded_case "$green_rollup" "$runs_push_failed_pr_passed")"
assert_rc_is 'a failed push run and a passing pull_request run of one workflow are not a retry' "$out" 0
runs_pr_failed_pr_passed='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"}
]'
out="$(run_superseded_case "$green_rollup" "$runs_pr_failed_pr_passed")"
assert_rc_is_not 'a failed and a passing run of the same event are still a flake' "$out" 0

out="$(MOCK_JOBS_FAIL=1 run_superseded_case "$green_rollup" "$runs_failed_then_passed")"
assert_rc_is_not 'an unreadable job list for a failed run counts as a real failure' "$out" 0
assert_contains 'and it is reported as a flake' "$out" 'ERROR: CI_FLAKE_DETECTED'
assert_not_contains 'and is not called an outage' "$out" 'CI_RERUN_RUNNER_NOT_ACQUIRED'

out="$(MOCK_ATTEMPTS='' MOCK_OUTAGE_ATTEMPTS='2' run_superseded_case "$green_rollup" "$runs_failed_twice_then_passed")"
assert_rc_is 'an earlier attempt that cannot be read is not counted, in the failed-then-passed check too' "$out" 0

out="$(MOCK_ATTEMPT_CONCLUSION=failure MOCK_RUNNER_NEVER_ACQUIRED=1 MOCK_JOBS_CONCURRENT=1 run_superseded_case "$green_rollup" "$runs_rerun_after_failure")"
assert_rc_is_not 'an outage with a real failure that ran alongside it is still a flake' "$out" 0
assert_contains 'and it is reported as a flake' "$out" 'ERROR: CI_FLAKE_DETECTED'
assert_not_contains 'and is not called an outage' "$out" 'CI_RERUN_RUNNER_NOT_ACQUIRED'

# Known limit (the jobs API does not say which job needs which): a late independent job that failed for real is
# taken for an aggregate, so the attempt still counts as an outage.
out="$(MOCK_ATTEMPT_CONCLUSION=failure MOCK_RUNNER_NEVER_ACQUIRED=1 MOCK_JOBS_LATE_REAL=1 run_superseded_case "$green_rollup" "$runs_rerun_after_failure")"
assert_rc_is 'known limit: a late independent failure after the outage gave up is taken for the aggregate' "$out" 0

runs_failed_then_cancelled_rerun='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"cancelled","status":"completed","workflowDatabaseId":7,"attempt":2,"event":"pull_request"}
]'
out="$(MOCK_ATTEMPTS='failure cancelled' run_superseded_case "$green_rollup" "$runs_failed_then_cancelled_rerun")"
assert_rc_is_not 'attempt 1 failed and the rerun was cancelled, then a newer run passed: still a flake' "$out" 0
assert_contains 'and it is reported as a flake' "$out" 'ERROR: CI_FLAKE_DETECTED'
assert_contains 'and the run with the failed attempt is named' "$out" 'workflow=7 failed_run=200 passing_run=300'
out="$(MOCK_ATTEMPTS='cancelled cancelled' run_superseded_case "$green_rollup" "$runs_failed_then_cancelled_rerun")"
assert_rc_is 'a rerun that was cancelled after only cancelled attempts is a superseded run, not a flake' "$out" 0
assert_not_contains 'and no outage is noted for it' "$out" 'CI_RERUN_RUNNER_NOT_ACQUIRED'
out="$(MOCK_ATTEMPTS='failure cancelled' MOCK_OUTAGE_ATTEMPTS='1' run_superseded_case "$green_rollup" "$runs_failed_then_cancelled_rerun")"
assert_rc_is 'a failed first attempt that was an outage, then a cancelled rerun and a pass, is not a flake' "$out" 0
assert_contains 'and the outage is named at the attempt where it happened' "$out" 'NOTE: CI_RERUN_RUNNER_NOT_ACQUIRED pr=42 run=200 attempt=1'

# A workflow whose only checks are ones the gate ignores (the merged-PR closer here) is not scanned: re-running it is
# not a flaky test. A workflow that also supplies a gating check stays in the scan.
runs_closer='[
  {"databaseId":600,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":11,"attempt":1,"event":"pull_request"},
  {"databaseId":500,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":11,"attempt":1,"event":"pull_request"},
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"}
]'
closer_rollup='[
  {"name":"shellcheck + tests","conclusion":"SUCCESS","startedAt":"2026-11-18T16:22:04Z","detailsUrl":"https://github.com/o/r/actions/runs/300/job/2"},
  {"name":"close-merged-prs","conclusion":"SUCCESS","startedAt":"2026-11-18T16:20:04Z","detailsUrl":"https://github.com/o/r/actions/runs/500/job/9"}
]'
out="$(MOCK_ATTEMPT_CONCLUSION=failure run_superseded_case "$closer_rollup" "$runs_closer")"
assert_rc_is 'a failed then passed run of a workflow with only ignored checks is not a flake' "$out" 0
assert_not_contains 'and nothing is reported' "$out" 'CI_FLAKE_DETECTED'
mixed_rollup='[
  {"name":"shellcheck + tests","conclusion":"SUCCESS","startedAt":"2026-11-18T16:22:04Z","detailsUrl":"https://github.com/o/r/actions/runs/300/job/2"},
  {"name":"close-merged-prs","conclusion":"SUCCESS","startedAt":"2026-11-18T16:20:04Z","detailsUrl":"https://github.com/o/r/actions/runs/200/job/9"}
]'
out="$(MOCK_ATTEMPT_CONCLUSION=failure run_superseded_case "$mixed_rollup" "$runs_failed_then_passed")"
assert_rc_is_not 'a workflow that also supplies a gating check stays in the scan' "$out" 0
assert_contains 'and its flake is reported' "$out" 'ERROR: CI_FLAKE_DETECTED'

# Runs without event metadata (an older gh) are never paired: a failed push run and a passing pull_request run
# would look alike.
runs_no_event='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"failure","status":"completed","workflowDatabaseId":7}
]'
out="$(MOCK_RUNS_NO_ATTEMPT=1 run_superseded_case "$green_rollup" "$runs_no_event")"
assert_rc_is 'without event metadata a failed and a passing run are not paired' "$out" 0
assert_contains 'and the degraded flake check is noted' "$out" 'NOTE: CI_FLAKE_CHECK_DEGRADED'

# A rerun that is still running whose first attempt failed, next to a newer run that passed, is a candidate: the
# newer success must not hide the failed first attempt.
runs_pending_rerun='[
  {"databaseId":300,"headSha":"'"${head_sha}"'","conclusion":"success","status":"completed","workflowDatabaseId":7,"attempt":1,"event":"pull_request"},
  {"databaseId":200,"headSha":"'"${head_sha}"'","conclusion":"","status":"in_progress","workflowDatabaseId":7,"attempt":2,"event":"pull_request"}
]'
out="$(MOCK_ATTEMPTS='failure' run_superseded_case "$green_rollup" "$runs_pending_rerun")"
assert_rc_is_not 'a failed first attempt whose rerun is still running, with a newer run that passed, is a flake' "$out" 0
assert_contains 'and it is reported as a flake' "$out" 'ERROR: CI_FLAKE_DETECTED'

# The listing that found the candidate is the one used: a second listing that fails must not hide it.
out="$(MOCK_RUNS_FAIL_AFTER_FIRST=1 MOCK_ATTEMPTS='failure cancelled' run_superseded_case "$shape_rollup" "$runs_failed_then_cancelled_rerun")"
assert_rc_is_not 'the run listing that dropped the failed row is reused for the flake check' "$out" 0
assert_contains 'and the flake is reported' "$out" 'ERROR: CI_FLAKE_DETECTED'

# An older gh has no attempt or event field: the superseded-run logic keeps working and the degraded flake check is noted.
out="$(MOCK_RUNS_NO_ATTEMPT=1 run_superseded_case "$shape_rollup" "$runs_superseded")"
assert_rc_is 'an older gh keeps the superseded-run logic working' "$out" 0
assert_contains 'and says the flake check is degraded' "$out" 'NOTE: CI_FLAKE_CHECK_DEGRADED'

out="$(MOCK_ATTEMPT_CONCLUSION='' run_superseded_case "$green_rollup" "$runs_rerun_after_failure")"
assert_rc_is 'when the earlier attempt cannot be read the green verdict stands' "$out" 0
assert_not_contains 'and no flake is reported for it' "$out" 'CI_FLAKE_DETECTED'
rm -rf "$tmp"

printf '\n=== functional: WAITING env approval failure is raised (not WAIT_TIMEOUT) ===\n'
tmp="$(mktemp -d)"
mock_bin="${tmp}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  printf '%s\n' 'origin/my-branch'
  exit 0
fi
if [[ "$*" == *'ls-remote --heads origin my-branch'* ]]; then
  printf '%s\trefs/heads/my-branch\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  exit 0
fi
if [[ "$*" == *'rev-parse HEAD'* ]]; then
  printf '%s\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  exit 0
fi
printf 'unexpected git call: %s\n' "$*" >&2
exit 1
MOCK_GIT
chmod +x "${mock_bin}/git"

write_mock_jq_passthrough "${mock_bin}"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json statusCheckRollup'* ]]; then
  printf '%s\n' '[{"name":"org repo-practices audit","status":"WAITING","conclusion":null,"detailsUrl":"https://github.com/the-hcma/mock-repo/actions/runs/9/job/1"}]'
  exit 0
fi
if [[ "$args" == *'--method POST'* ]]; then
  printf 'should not POST\n' >&2
  exit 1
fi
if [[ "$args" == *'pending_deployments'* ]]; then
  printf '%s\n' '[{"environment":{"id":1,"name":"github-repo-lint"},"current_user_can_approve":false}]'
  exit 0
fi
# Conventional Commits title gate (#651): squash signal + compliant title.
# Match only the repo settings GET (jq names), not other repos/... API paths.
if [[ "$args" == *'api repos/'* && "$args" == *'squash_merge_commit_title'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "$args" == *'pr view'* && "$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: mock title'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

set +e
out="$(PATH="${mock_bin}:${PATH}" POST_PR_CHECKS_TIMEOUT=20s POST_PR_CHECKS_POLL_SECS=1 bash "$script" --pr 42 2>&1)"
exit_code=$?
set -e

assert_exit_nonzero "env approval failed" "$out" "$exit_code"
assert_contains "env approval failed marker" "$out" "ERROR: ENVIRONMENT_APPROVAL_FAILED"
assert_contains "env approval raise to operator" "$out" "raise this to the operator"
if grep -qF 'ERROR: WAIT_TIMEOUT' <<<"$out"; then
  printf '[FAIL] env approval failed: must not fall through to WAIT_TIMEOUT\n%s\n' "$out"
  fail=$(( fail + 1 ))
else
  printf '[PASS] env approval failed: no WAIT_TIMEOUT fallback\n'
  pass=$(( pass + 1 ))
fi
rm -rf "$tmp"

printf '\n=== functional: resolves repo_dir from caller cwd, not its own path (#590) ===\n'
tmp_repo="$(mktemp -d)"
remote_dir="$(mktemp -d)"
caller_branch="test-590-caller-branch"
(
  cd "$tmp_repo"
  git init -q
  git config user.email 'test@example.com'
  git config user.name 'Test'
  printf 'x\n' >README.md
  git add README.md
  git commit -q -m 'init'
  git init -q --bare "$remote_dir"
  git remote add origin "$remote_dir"
  git checkout -q -b "$caller_branch"
  # Push HEAD to the throwaway local bare repo so ensure_branch_is_pushed's
  # `git ls-remote --heads origin <branch>` finds it at HEAD. This is a tmpdir
  # bare repo, not real remote/GitHub state (coding guideline is about the latter).
  git push -q origin "HEAD:refs/heads/${caller_branch}"
)

mock_bin="$(mktemp -d)"
captured="${mock_bin}/captured-branch"
cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
if [[ "\$1 \$2" == 'pr list' ]]; then
  prev=""
  for a in "\$@"; do
    if [[ "\$prev" == '--head' ]]; then
      printf '%s\n' "\$a" >'${captured}'
    fi
    prev="\$a"
  done
  printf '99\n'
  exit 0
fi
args="\$*"
if [[ "\$args" == *'repo view'* && "\$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/caller-fixture\n'
  exit 0
fi
if [[ "\$args" == *'pr view 99'* && "\$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "\$args" == *'pr view 99'* && "\$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "\$args" == *'pr view 99'* && "\$args" == *'--json body'* ]]; then
  printf '%s\n' \$'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
# Conventional Commits title gate (#651): squash signal + compliant title.
# Match only the repo settings GET (jq names), not other repos/... API paths.
if [[ "\$args" == *'api repos/'* && "\$args" == *'squash_merge_commit_title'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "\$args" == *'pr view'* && "\$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: mock title'
  exit 0
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

# Real (unmocked) git so branch/upstream resolution reflects the actual repo_dir
# the script computes — a mocked git would hide the bug (it matches on the
# subcommand text only, ignoring which repo -C points at).
caller_out=""
caller_exit=0
caller_out="$(cd "$tmp_repo" && PATH="${mock_bin}:${PATH}" bash "$script" --no-wait 2>&1)" || caller_exit=$?
assert_exit_0 "post-pr-submission-checks from caller repo" "$caller_out" "$caller_exit"
if [[ -f "$captured" ]] && [[ "$(cat "$captured")" == "$caller_branch" ]]; then
  pass_case 'discovers the PR using the caller repo branch, not repository-helpers own (#590)'
else
  fail_case "expected gh pr list --head ${caller_branch}, captured: $(cat "$captured" 2>/dev/null || printf '<none>')"
fi
rm -rf "$tmp_repo" "$remote_dir" "$mock_bin"

# ppc_push_check_case <label> <ls_remote_stdout> <ls_remote_exit> <head_sha> \
#                     <expect_exit_zero:0|1> <needle> [upstream_configured:0|1] [pr_arg]
# Runs post-pr-submission-checks --no-wait with a scripted `git ls-remote --heads
# origin <branch>` result, then asserts the exit status and an output substring.
# upstream_configured toggles whether `@{u}` resolves — the sync check must run
# and fail on an out-of-sync remote *regardless* of local tracking config (#596).
# pr_arg, when set, passes `--pr <n>`: the push check must then be skipped
# entirely (the PR is identified by number; the checkout is irrelevant).
ppc_push_check_case() {
  local -r label="$1"
  local -r ls_remote_stdout="$2"
  local -r ls_remote_exit="$3"
  local -r head_sha="$4"
  local -r expect_exit_zero="$5"
  local -r needle="$6"
  local -r upstream_configured="${7:-0}"
  local -r pr_arg="${8:-}"
  local case_tmp case_bin case_out case_exit at_u_block
  local -a run_args=(--no-wait)
  [[ -n "$pr_arg" ]] && run_args+=(--pr "$pr_arg")

  case_tmp="$(mktemp -d)"
  case_bin="${case_tmp}/bin"
  mkdir -p "$case_bin"

  if [[ "$upstream_configured" == '1' ]]; then
    at_u_block="printf '%s\\n' 'origin/my-branch'; exit 0"
  else
    at_u_block="printf 'fatal: no upstream configured\\n' >&2; exit 128"
  fi

  cat >"${case_bin}/git" <<MOCK_GIT
#!/usr/bin/env bash
set -euo pipefail
if [[ "\$*" == *'rev-parse --show-toplevel'* ]]; then
  printf '%s\n' '/mock/repo'
  exit 0
fi
if [[ "\$*" == *'branch --show-current'* ]]; then
  printf '%s\n' 'my-branch'
  exit 0
fi
if [[ "\$*" == *'rev-parse --abbrev-ref @{u}'* ]]; then
  ${at_u_block}
fi
if [[ "\$*" == *'ls-remote --heads origin my-branch'* ]]; then
  printf '%s' '${ls_remote_stdout}'
  exit ${ls_remote_exit}
fi
if [[ "\$*" == *'rev-parse HEAD'* ]]; then
  printf '%s\n' '${head_sha}'
  exit 0
fi
printf 'unexpected git call: %s\n' "\$*" >&2
exit 1
MOCK_GIT
  chmod +x "${case_bin}/git"

  write_mock_jq_passthrough "${case_bin}"

  cat >"${case_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repo view'* && "$args" == *'nameWithOwner'* ]]; then
  printf 'the-hcma/mock-repo\n'
  exit 0
fi
if [[ "$args" == *'pr list'* ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json state'* ]]; then
  printf 'OPEN\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json isDraft'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'pr view 42'* && "$args" == *'--json body'* ]]; then
  printf '%s\n' $'## Summary\n- ok\n\n## Test plan\n- ok\n'
  exit 0
fi
# Conventional Commits title gate (#651): squash signal + compliant title.
# Match only the repo settings GET (jq names), not other repos/... API paths.
if [[ "$args" == *'api repos/'* && "$args" == *'squash_merge_commit_title'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "$args" == *'pr view'* && "$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: mock title'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
  chmod +x "${case_bin}/gh"

  set +e
  case_out="$(PATH="${case_bin}:${PATH}" bash "$script" "${run_args[@]}" 2>&1)"
  case_exit=$?
  set -e

  if [[ "$expect_exit_zero" == '0' ]]; then
    assert_exit_0 "$label" "$case_out" "$case_exit"
  else
    assert_exit_nonzero "$label" "$case_out" "$case_exit"
  fi
  assert_contains "$label" "$case_out" "$needle"
  rm -rf "$case_tmp"
}

printf '\n=== functional: branch pushed without upstream tracking (#596) ===\n'
ppc_push_check_case 'pushed, no @{u}, remote in sync passes' \
  $'1111111111111111111111111111111111111111\trefs/heads/my-branch\n' 0 \
  '1111111111111111111111111111111111111111' 0 \
  'is present on origin at HEAD' 0

printf '\n=== functional: branch never pushed still fails (#596) ===\n'
ppc_push_check_case 'no @{u}, no remote branch fails' \
  '' 0 '1111111111111111111111111111111111111111' 1 \
  'is not on origin' 0

printf '\n=== functional: remote branch out of sync fails (#596) ===\n'
ppc_push_check_case 'no @{u}, remote sha differs fails' \
  $'2222222222222222222222222222222222222222\trefs/heads/my-branch\n' 0 \
  '1111111111111111111111111111111111111111' 1 \
  'out of sync with local HEAD' 0

printf '\n=== functional: configured @{u} does not skip the remote-sync check (#596) ===\n'
# CodeRabbit: `@{u}` proves only that a tracking ref exists, not that HEAD was
# pushed — so a configured upstream with an out-of-sync remote tip must still fail.
ppc_push_check_case 'configured @{u}, remote sha differs still fails' \
  $'2222222222222222222222222222222222222222\trefs/heads/my-branch\n' 0 \
  '1111111111111111111111111111111111111111' 1 \
  'out of sync with local HEAD' 1

printf '\n=== functional: explicit --pr skips the local push check (#596 review) ===\n'
# mergestorm-vortex: with --pr N the PR is identified by number, so an out-of-sync
# (or stale-main) checkout must not hard-fail before any PR state is read.
ppc_push_check_case 'explicit --pr with out-of-sync checkout still proceeds' \
  $'2222222222222222222222222222222222222222\trefs/heads/my-branch\n' 0 \
  '1111111111111111111111111111111111111111' 0 \
  'PR: #42' 1 42

printf '\n=== static: push check verifies the remote tip, not just @{u} (#596) ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
# ensure_branch_is_pushed must sit inside the auto-discovery block (between the
# `-z "$pr_number"` guard and the discovery call) so explicit --pr N skips it.
# shellcheck disable=SC2016  # literal source patterns, not shell expansions
push_check_line="$(grep -n 'ensure_branch_is_pushed "\$branch"' "$script" | head -1 | cut -d: -f1)"
# shellcheck disable=SC2016
guard_line="$(grep -n 'if \[\[ -z "\$pr_number" \]\]; then' "$script" | head -1 | cut -d: -f1)"
# shellcheck disable=SC2016
discover_line="$(grep -n 'discover_pr_number_for_branch "\$branch"' "$script" | head -1 | cut -d: -f1)"
if grep -qF 'ls-remote --heads origin' "$script" \
  && grep -qF 'is present on origin at HEAD' "$script" \
  && grep -qF 'out of sync with local HEAD' "$script" \
  && [[ -n "$push_check_line" && -n "$guard_line" && -n "$discover_line" ]] \
  && (( guard_line < push_check_line && push_check_line < discover_line )) \
  && ! grep -qF "rev-parse --abbrev-ref '@{u}'" "$script"; then
  printf '[PASS] post-pr-submission-checks: HEAD-vs-origin check gated to auto-discovery, no @{u} shortcut\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] post-pr-submission-checks: push check must verify remote tip and be --pr-gated\n'
  fail=$(( fail + 1 ))
fi

test_summary

