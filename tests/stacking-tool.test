#!/usr/bin/env bash
# Tests for scripts/lib/stacking-tool and .github/stacking-tool.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

lib="${rh_root}/scripts/lib/stacking-tool"
marker="${rh_root}/.github/stacking-tool"
readonly lib marker

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
pass=0
fail=0
test_init

printf '\n=== static: library and marker exist ===\n'
if [[ -f "$lib" ]]; then
  pass_case 'scripts/lib/stacking-tool exists'
else
  fail_case 'scripts/lib/stacking-tool exists'
fi
if [[ -f "$marker" ]]; then
  pass_case '.github/stacking-tool exists'
else
  fail_case '.github/stacking-tool exists'
fi

printf '\n=== static: marker value for this repo ===\n'
marker_value="$(tr -d '[:space:]' <"$marker" || true)"
if [[ "$marker_value" == 'gh-stack' ]]; then
  pass_case 'repository-helpers marker is gh-stack (trial)'
else
  fail_case "repository-helpers marker is gh-stack (got '${marker_value}')"
fi

printf '\n=== static: library API surface ===\n'
if grep -qF "stacking_tool_marker_relpath='.github/stacking-tool'" "$lib" \
  && grep -qF "stacking_tool_value_graphite='graphite'" "$lib" \
  && grep -qF "stacking_tool_value_gh_stack='gh-stack'" "$lib" \
  && grep -qF 'stacking_tool_org_default=' "$lib" \
  && grep -qF 'stacking_tool_read' "$lib" \
  && grep -qF 'stacking_tool_read_optional' "$lib" \
  && grep -qF 'stacking_tool_read_or_org_default' "$lib" \
  && grep -qF 'stacking_tool_is_valid' "$lib" \
  && grep -qF 'stacking_tool_require_cli' "$lib" \
  && grep -qF 'stacking_tool_submit' "$lib" \
  && grep -qF 'stacking_tool_submit_as' "$lib" \
  && grep -qF 'stacking_tool_restack' "$lib" \
  && grep -qF 'stacking_tool_session_sync' "$lib" \
  && grep -qF 'stacking_tool_session_sync_as' "$lib" \
  && grep -qF 'stacking_tool_graphite_usable' "$lib"; then
  pass_case 'stacking-tool defines marker constants and operation helpers'
else
  fail_case 'stacking-tool defines marker constants and operation helpers'
fi

printf '\n=== static: backends use runner helpers ===\n'
# shellcheck disable=SC2016  # intentional literal match for source path in library
if grep -qF 'source "${_stacking_tool_lib_dir}/runner-ensure"' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gt submit"' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gh stack submit"' "$lib" \
  && grep -qF 'gh stack submit --auto --open' "$lib" \
  && grep -qF 'gt submit --publish --no-interactive' "$lib"; then
  pass_case 'stacking-tool dispatches via runner_sh for both backends'
else
  fail_case 'stacking-tool dispatches via runner_sh for both backends'
fi

printf '\n=== static: session sync and restack use --timeout ===\n'
if grep -qF 'runner_sh "stacking-tool session git fetch" --timeout 20' "$lib" \
  && grep -qF 'runner_sh "stacking-tool session gt sync" --timeout 20' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gt sync" --timeout 20' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gh stack sync" --timeout 20' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gt submit after restack" --timeout 120' "$lib" \
  && grep -qF '&& exec gt sync' "$lib" \
  && grep -qF '&& exec git fetch --prune origin' "$lib" \
  && grep -qF 'stacking_tool_graphite_usable' "$lib" \
  && grep -qF 'skipping gt sync (git fetch only)' "$lib"; then
  pass_case 'session sync / restack envelope network calls with --timeout'
else
  fail_case 'session sync / restack envelope network calls with --timeout'
fi

# shellcheck disable=SC2016  # intentional literal match for restack body
restack_body="$(awk '/^stacking_tool_restack\(\)/,/^}$/' "$lib")"
if printf '%s' "$restack_body" | grep -qF '|| return 1' \
  && ! printf '%s' "$restack_body" | grep -qF 'stacking_tool_die'; then
  pass_case 'stacking_tool_restack returns on operational failure (no die/exit)'
else
  fail_case 'stacking_tool_restack returns on operational failure (no die/exit)'
fi

# shellcheck disable=SC1090,SC1091
source "$lib"

printf '\n=== functional: stacking_tool_is_valid ===\n'
if stacking_tool_is_valid 'graphite' && stacking_tool_is_valid 'gh-stack'; then
  pass_case 'stacking_tool_is_valid accepts graphite and gh-stack'
else
  fail_case 'stacking_tool_is_valid accepts graphite and gh-stack'
fi
if ! stacking_tool_is_valid 'graphite-cli' && ! stacking_tool_is_valid '' && ! stacking_tool_is_valid 'GT'; then
  pass_case 'stacking_tool_is_valid rejects invalid values'
else
  fail_case 'stacking_tool_is_valid rejects invalid values'
fi

printf '\n=== functional: stacking_tool_normalize ===\n'
norm_out="$(stacking_tool_normalize $'  gh-stack\n')"
assert_contains 'normalize trims whitespace' "$norm_out" 'gh-stack'
if [[ "$norm_out" == 'gh-stack' ]]; then
  pass_case 'normalize returns exact gh-stack token'
else
  fail_case "normalize returns exact gh-stack token (got '${norm_out}')"
fi

printf '\n=== functional: stacking_tool_read this repo ===\n'
read_out="$(stacking_tool_read "$rh_root")"
assert_contains 'read returns gh-stack for this worktree' "$read_out" 'gh-stack'
if [[ "$read_out" == 'gh-stack' ]]; then
  pass_case 'read value equals gh-stack exactly'
else
  fail_case "read value equals gh-stack exactly (got '${read_out}')"
fi

printf '\n=== functional: stacking_tool_read missing/invalid ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$tmp_repo" -c user.name=test -c user.email=test@example.com \
  commit --allow-empty -q -m 'init'

missing_exit=0
missing_out="$(stacking_tool_read "$tmp_repo" 2>&1)" || missing_exit=$?
if [[ "$missing_exit" -ne 0 ]] && printf '%s' "$missing_out" | grep -qF 'missing .github/stacking-tool'; then
  pass_case 'read dies when marker is missing'
else
  fail_case "read dies when marker is missing (exit=${missing_exit})"
fi

mkdir -p "${tmp_repo}/.github"
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
invalid_exit=0
invalid_out="$(stacking_tool_read "$tmp_repo" 2>&1)" || invalid_exit=$?
if [[ "$invalid_exit" -ne 0 ]] && printf '%s' "$invalid_out" | grep -qF 'invalid'; then
  pass_case 'read dies when marker is invalid'
else
  fail_case "read dies when marker is invalid (exit=${invalid_exit})"
fi

printf 'graphite\n' >"${tmp_repo}/.github/stacking-tool"
graphite_out="$(stacking_tool_read "$tmp_repo")"
assert_contains 'read accepts graphite in temp repo' "$graphite_out" 'graphite'

printf '\n=== functional: stacking_tool_read_optional ===\n'
optional_out="$(stacking_tool_read_optional "$tmp_repo")"
assert_contains 'read_optional returns graphite' "$optional_out" 'graphite'
rm -f "${tmp_repo}/.github/stacking-tool"
optional_missing_exit=0
stacking_tool_read_optional "$tmp_repo" >/dev/null 2>&1 || optional_missing_exit=$?
if [[ "$optional_missing_exit" -ne 0 ]]; then
  pass_case 'read_optional returns non-zero when marker is missing'
else
  fail_case 'read_optional returns non-zero when marker is missing'
fi
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
optional_invalid_exit=0
stacking_tool_read_optional "$tmp_repo" >/dev/null 2>&1 || optional_invalid_exit=$?
if [[ "$optional_invalid_exit" -ne 0 ]]; then
  pass_case 'read_optional returns non-zero when marker is invalid'
else
  fail_case 'read_optional returns non-zero when marker is invalid'
fi
printf 'gh-stack\n' >"${tmp_repo}/.github/stacking-tool"

printf '\n=== functional: stacking_tool_read_or_org_default ===\n'
or_default_out="$(stacking_tool_read_or_org_default "$tmp_repo" 2>/dev/null)"
assert_contains 'read_or_org_default returns gh-stack when valid' "$or_default_out" 'gh-stack'
rm -f "${tmp_repo}/.github/stacking-tool"
or_default_log="$(stacking_tool_read_or_org_default "$tmp_repo" 2>&1)"
or_default_value="$(stacking_tool_read_or_org_default "$tmp_repo" 2>/dev/null)"
if printf '%s' "$or_default_log" | grep -qF "using org default 'graphite'" \
  && [[ "$or_default_value" == 'graphite' ]]; then
  pass_case 'read_or_org_default logs and returns org default when marker missing'
else
  fail_case 'read_or_org_default logs and returns org default when marker missing'
fi
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
or_default_invalid_exit=0
# stacking_tool_die uses exit; run in a subshell so the suite continues.
( stacking_tool_read_or_org_default "$tmp_repo" >/dev/null 2>&1 ) || or_default_invalid_exit=$?
if [[ "$or_default_invalid_exit" -ne 0 ]]; then
  pass_case 'read_or_org_default dies when marker is invalid'
else
  fail_case 'read_or_org_default dies when marker is invalid'
fi
printf 'gh-stack\n' >"${tmp_repo}/.github/stacking-tool"

printf '\n=== functional: stacking_tool_submit_as ===\n'
fake_bin="$(mktemp -d)"
gt_log="${fake_bin}/gt.log"
gh_log="${fake_bin}/gh.log"
cat >"${fake_bin}/gt" <<'MOCK_GT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GT_LOG:?}"
MOCK_GT
chmod +x "${fake_bin}/gt"
cat >"${fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GH_LOG:?}"
if [[ "$*" == *'stack --help'* ]]; then
  exit 0
fi
exit 0
MOCK_GH
chmod +x "${fake_bin}/gh"
submit_as_exit=0
(
  PATH="${fake_bin}:${PATH}" GT_LOG="$gt_log" GH_LOG="$gh_log" \
    stacking_tool_submit_as 'graphite' "$tmp_repo"
) || submit_as_exit=$?
if [[ "$submit_as_exit" -eq 0 ]] \
  && grep -qF 'submit --publish --no-interactive' "$gt_log"; then
  pass_case 'submit_as graphite invokes gt submit'
else
  fail_case "submit_as graphite invokes gt submit (exit=${submit_as_exit})"
fi
: >"$gt_log"
: >"$gh_log"
submit_as_exit=0
(
  PATH="${fake_bin}:${PATH}" GT_LOG="$gt_log" GH_LOG="$gh_log" \
    stacking_tool_submit_as 'gh-stack' "$tmp_repo"
) || submit_as_exit=$?
if [[ "$submit_as_exit" -eq 0 ]] \
  && grep -qF 'stack submit --auto --open' "$gh_log"; then
  pass_case 'submit_as gh-stack invokes gh stack submit'
else
  fail_case "submit_as gh-stack invokes gh stack submit (exit=${submit_as_exit})"
fi
rm -rf "$fake_bin"

printf '\n=== functional: session_sync_as skips gt sync when Graphite unusable ===\n'
fake_bin="$(mktemp -d)"
gt_log="${fake_bin}/gt.log"
session_repo="$(mktemp -d)"
git -C "$session_repo" init --initial-branch=main -q
git -C "$session_repo" config user.email 't@example.com'
git -C "$session_repo" config user.name 't'
git -C "$session_repo" commit --allow-empty -q -m 'init'
# Bare remote so git fetch --prune origin succeeds.
session_remote="$(mktemp -d)"
git -C "$session_remote" init --bare -q --initial-branch=main
git -C "$session_repo" remote add origin "$session_remote"
git -C "$session_repo" push -u origin main -q

cat >"${fake_bin}/gt" <<'MOCK_GT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GT_LOG:?}"
# Simulate expired / unused Graphite auth.
if [[ "${1:-}" == 'auth' ]]; then
  printf 'ERROR: Your Graphite auth token is invalid/expired.\n' >&2
  exit 1
fi
exit 0
MOCK_GT
chmod +x "${fake_bin}/gt"

session_exit=0
session_log="$(
  PATH="${fake_bin}:${PATH}" GT_LOG="$gt_log" \
    stacking_tool_session_sync_as 'graphite' "$session_repo" 2>&1
)" || session_exit=$?
if [[ "$session_exit" -eq 0 ]] \
  && grep -qF 'skipping gt sync (git fetch only)' <<<"$session_log" \
  && ! grep -qE '(^|[[:space:]])sync([[:space:]]|$)' "$gt_log" \
  && grep -qF 'auth' "$gt_log"; then
  pass_case 'session_sync_as graphite falls back to git fetch when gt auth fails'
else
  fail_case "session_sync_as graphite falls back to git fetch when gt auth fails (exit=${session_exit})"
  printf '%s\n' "$session_log" >&2
  cat "$gt_log" >&2 || true
fi

# Missing gt entirely → also fetch-only (no die).
rm -f "${fake_bin}/gt"
session_exit=0
session_log="$(
  PATH="${fake_bin}:/usr/bin:/bin" \
    stacking_tool_session_sync_as 'graphite' "$session_repo" 2>&1
)" || session_exit=$?
if [[ "$session_exit" -eq 0 ]] \
  && grep -qF 'skipping gt sync (git fetch only)' <<<"$session_log"; then
  pass_case 'session_sync_as graphite falls back when gt is missing'
else
  fail_case "session_sync_as graphite falls back when gt is missing (exit=${session_exit})"
fi
rm -rf "$fake_bin" "$session_repo" "$session_remote"

rm -rf "$tmp_repo"

printf '\n=== functional: stacking_tool_require_cli ===\n'
# require_cli dies (exit) when the backend CLI is missing — run in a subshell.
require_exit=0
( stacking_tool_require_cli 'gh-stack' ) >/dev/null 2>&1 || require_exit=$?
if [[ "$require_exit" -eq 0 ]]; then
  pass_case 'require_cli accepts available gh-stack extension'
else
  printf '[SKIP] require_cli: gh-stack extension not installed (CI/hosts without gh-stack)\n'
fi

fake_bin="$(mktemp -d)"
# No gt on PATH → graphite prereq should fail. Run in a subshell: require_cli dies via exit.
require_exit=0
( PATH="${fake_bin}:/usr/bin:/bin" stacking_tool_require_cli 'graphite' ) 2>/dev/null || require_exit=$?
if [[ "$require_exit" -ne 0 ]]; then
  pass_case 'require_cli fails when gt is missing for graphite'
else
  fail_case 'require_cli fails when gt is missing for graphite'
fi
rm -rf "$fake_bin"

printf '\n=== static: skills and stacking-tool rule ===\n'
if [[ -f "${rh_root}/.cursor/skills/graphite/SKILL.md" ]] \
  && grep -qF 'name: graphite' "${rh_root}/.cursor/skills/graphite/SKILL.md"; then
  pass_case 'graphite skill exists under .cursor/skills/graphite/'
else
  fail_case 'graphite skill exists under .cursor/skills/graphite/'
fi
if [[ -f "${rh_root}/.cursor/skills/gh-stack/SKILL.md" ]] \
  && grep -qF 'name: gh-stack' "${rh_root}/.cursor/skills/gh-stack/SKILL.md"; then
  pass_case 'gh-stack skill exists under .cursor/skills/gh-stack/'
else
  fail_case 'gh-stack skill exists under .cursor/skills/gh-stack/'
fi
if [[ ! -f "${rh_root}/GRAPHITE.md" ]]; then
  pass_case 'root GRAPHITE.md removed (skill is SSOT)'
else
  fail_case 'root GRAPHITE.md removed (skill is SSOT)'
fi
if [[ -f "${rh_root}/.cursor/rules/stacking-tool.mdc" ]] \
  && grep -qF '.github/stacking-tool' "${rh_root}/.cursor/rules/stacking-tool.mdc" \
  && grep -qF '.cursor/skills/gh-stack/SKILL.md' "${rh_root}/.cursor/rules/stacking-tool.mdc" \
  && grep -qF '.cursor/skills/graphite/SKILL.md' "${rh_root}/.cursor/rules/stacking-tool.mdc"; then
  pass_case 'stacking-tool rule references marker and both skills'
else
  fail_case 'stacking-tool rule references marker and both skills'
fi

printf '\n=== static: scripts that invoke gt/gh stack must gate on stacking-tool ===\n'
# Ratchet: bare Graphite / gh-stack CLI use outside scripts/lib/stacking-tool must
# source the shared lib and reference a marker-aware gate (issue #387 follow-up).
ratchet_fail=0
ratchet_report="$(mktemp)"
while IFS= read -r -d '' script_path; do
  base="$(basename "$script_path")"
  if [[ "$base" == 'stacking-tool' ]]; then
    continue
  fi
  # Non-comment lines that look like real gt / gh stack CLI usage (not install hints).
  invoke_lines="$(
    { grep -nE '(^|[^[:alnum:]_-])gt[[:space:]]+(auth|submit|sync|restack|track|create|info|modify|branch)\b' "$script_path" || true
      grep -nE '(^|[^[:alnum:]_-])gh[[:space:]]+stack[[:space:]]' "$script_path" || true
    } | grep -vE '^[0-9]+:[[:space:]]*#' || true
  )"
  if [[ -z "${invoke_lines}" ]]; then
    continue
  fi
  if ! grep -qF 'lib/stacking-tool' "$script_path"; then
    printf 'missing stacking-tool source: %s\n' "$script_path" >>"$ratchet_report"
    ratchet_fail=1
    continue
  fi
  if ! grep -qE \
    'stacking_tool_read|stacking_tool_read_optional|stacking_tool_read_or_org_default|stacking_tool_submit|stacking_tool_restack|stacking_tool_session_sync|stacking_tool_require_cli|stacking_tool_submit_as|dep_stacking_is_|start_dev_stacking_tool_value|rp_stacking_tool_marker_content_for_apply_fix' \
    "$script_path"; then
    printf 'missing marker-aware gate: %s\n' "$script_path" >>"$ratchet_report"
    ratchet_fail=1
  fi
done < <(find "${rh_root}/scripts" "${rh_root}/scripts/dev" "${rh_root}/scripts/lib" \
  -maxdepth 1 -type f ! -name '*.md' ! -name '*.yml' ! -name '*.yaml' ! -name '*.json' \
  -print0 | sort -z)

if [[ "$ratchet_fail" -eq 0 ]]; then
  pass_case 'scripts invoking gt/gh stack source stacking-tool and gate on marker'
else
  fail_case 'scripts invoking gt/gh stack source stacking-tool and gate on marker'
  cat "$ratchet_report" >&2 || true
fi
rm -f "$ratchet_report"

printf '\n=== summary ===\n'
printf 'pass=%s fail=%s\n' "$pass" "$fail"
if [[ "$fail" -ne 0 ]]; then
  exit 1
fi
exit 0
