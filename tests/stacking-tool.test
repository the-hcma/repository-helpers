#!/usr/bin/env bash
# Tests for scripts/lib/stacking-tool and .github/stacking-tool.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

lib="${rh_root}/scripts/lib/stacking-tool"
marker="${rh_root}/.github/stacking-tool"
readonly lib marker

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
# These tests run gh stubs under a minimal PATH that may lack timeout(1); the per-attempt cap is not under test here.
export GITHUB_API_ATTEMPT_TIMEOUT_S=0
pass=0
fail=0
test_init

printf '\n=== static: library and marker exist ===\n'
if [[ -f "$lib" ]]; then
  pass_case 'scripts/lib/stacking-tool exists'
else
  fail_case 'scripts/lib/stacking-tool exists'
fi
if [[ -f "$marker" ]]; then
  pass_case '.github/stacking-tool exists'
else
  fail_case '.github/stacking-tool exists'
fi

printf '\n=== static: marker value for this repo ===\n'
marker_value="$(tr -d '[:space:]' <"$marker" || true)"
if [[ "$marker_value" == 'gh-stack' ]]; then
  pass_case 'repository-helpers marker is gh-stack (trial)'
else
  fail_case "repository-helpers marker is gh-stack (got '${marker_value}')"
fi

printf '\n=== static: library API surface ===\n'
if grep -qF "stacking_tool_marker_relpath='.github/stacking-tool'" "$lib" \
  && grep -qF "stacking_tool_value_graphite='graphite'" "$lib" \
  && grep -qF "stacking_tool_value_gh_stack='gh-stack'" "$lib" \
  && grep -qF 'stacking_tool_org_default=' "$lib" \
  && grep -qF 'stacking_tool_read' "$lib" \
  && grep -qF 'stacking_tool_read_optional' "$lib" \
  && grep -qF 'stacking_tool_read_or_default' "$lib" \
  && grep -qF 'stacking_tool_read_or_org_default' "$lib" \
  && grep -qF 'stacking_tool_is_valid' "$lib" \
  && grep -qF 'stacking_tool_require_cli' "$lib" \
  && grep -qF 'stacking_tool_submit' "$lib" \
  && grep -qF 'stacking_tool_submit_as' "$lib" \
  && grep -qF 'stacking_tool_restack' "$lib" \
  && grep -qF 'stacking_tool_restack_as' "$lib" \
  && grep -qF 'stacking_tool_session_sync' "$lib" \
  && grep -qF 'stacking_tool_session_sync_as' "$lib" \
  && grep -qF 'stacking_tool_retired_message' "$lib" \
  && ! grep -qF 'stacking_tool_graphite_usable' "$lib"; then
  pass_case 'stacking-tool defines marker constants and operation helpers'
else
  fail_case 'stacking-tool defines marker constants and operation helpers'
fi

printf '\n=== static: backends use runner helpers ===\n'
# shellcheck disable=SC2016  # intentional literal match for source path in library
if grep -qF 'source "${_stacking_tool_lib_dir}/runner-ensure"' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gh stack submit"' "$lib" \
  && grep -qF 'gh stack submit --auto --open' "$lib" \
  && ! grep -qE '(runner_sh|exec) .*\bgt (submit|sync|restack|auth)' "$lib"; then
  pass_case 'stacking-tool dispatches via runner_sh and never runs gt'
else
  fail_case 'stacking-tool dispatches via runner_sh and never runs gt'
fi

printf '\n=== static: session sync and restack use --timeout ===\n'
if grep -qF 'runner_sh "stacking-tool session git fetch" --timeout 20' "$lib" \
  && grep -qF 'runner_sh "stacking-tool gh stack sync" --timeout 20' "$lib" \
  && grep -qF '&& exec git fetch --prune origin' "$lib" \
  && ! grep -qF 'gt sync' "$lib"; then
  pass_case 'session sync / restack envelope network calls with --timeout'
else
  fail_case 'session sync / restack envelope network calls with --timeout'
fi

# shellcheck disable=SC2016  # intentional literal match for restack body
restack_as_body="$(awk '/^stacking_tool_restack_as\(\)/,/^}$/' "$lib")"
if printf '%s' "$restack_as_body" | grep -qF '|| return 1' \
  && ! printf '%s' "$restack_as_body" | grep -qE '^[[:space:]]*exit '; then
  pass_case 'stacking_tool_restack_as returns on operational failure (no exit)'
else
  fail_case 'stacking_tool_restack_as returns on operational failure (no exit)'
fi
restack_wrap_body="$(awk '/^stacking_tool_restack\(\)/,/^}$/' "$lib")"
if printf '%s' "$restack_wrap_body" | grep -qF 'stacking_tool_read' \
  && printf '%s' "$restack_wrap_body" | grep -qF 'stacking_tool_restack_as'; then
  pass_case 'stacking_tool_restack dispatches via restack_as after reading the marker'
else
  fail_case 'stacking_tool_restack must dispatch via restack_as after reading the marker'
fi

# shellcheck disable=SC1090,SC1091
source "$lib"

printf '\n=== functional: stacking_tool_is_valid ===\n'
if stacking_tool_is_valid 'graphite' && stacking_tool_is_valid 'gh-stack'; then
  pass_case 'stacking_tool_is_valid accepts graphite and gh-stack'
else
  fail_case 'stacking_tool_is_valid accepts graphite and gh-stack'
fi
if ! stacking_tool_is_valid 'graphite-cli' && ! stacking_tool_is_valid '' && ! stacking_tool_is_valid 'GT'; then
  pass_case 'stacking_tool_is_valid rejects invalid values'
else
  fail_case 'stacking_tool_is_valid rejects invalid values'
fi

printf '\n=== functional: stacking_tool_normalize ===\n'
norm_out="$(stacking_tool_normalize $'  gh-stack\n')"
assert_contains 'normalize trims whitespace' "$norm_out" 'gh-stack'
if [[ "$norm_out" == 'gh-stack' ]]; then
  pass_case 'normalize returns exact gh-stack token'
else
  fail_case "normalize returns exact gh-stack token (got '${norm_out}')"
fi

printf '\n=== functional: stacking_tool_read this repo ===\n'
read_out="$(stacking_tool_read "$rh_root")"
assert_contains 'read returns gh-stack for this worktree' "$read_out" 'gh-stack'
if [[ "$read_out" == 'gh-stack' ]]; then
  pass_case 'read value equals gh-stack exactly'
else
  fail_case "read value equals gh-stack exactly (got '${read_out}')"
fi

printf '\n=== functional: stacking_tool_read missing/invalid ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$tmp_repo" -c user.name=test -c user.email=test@example.com \
  commit --allow-empty -q -m 'init'

missing_exit=0
missing_out="$(stacking_tool_read "$tmp_repo" 2>&1)" || missing_exit=$?
if [[ "$missing_exit" -ne 0 ]] && printf '%s' "$missing_out" | grep -qF 'missing .github/stacking-tool'; then
  pass_case 'read dies when marker is missing'
else
  fail_case "read dies when marker is missing (exit=${missing_exit})"
fi

mkdir -p "${tmp_repo}/.github"
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
invalid_exit=0
invalid_out="$(stacking_tool_read "$tmp_repo" 2>&1)" || invalid_exit=$?
if [[ "$invalid_exit" -ne 0 ]] && printf '%s' "$invalid_out" | grep -qF 'invalid'; then
  pass_case 'read dies when marker is invalid'
else
  fail_case "read dies when marker is invalid (exit=${invalid_exit})"
fi

printf 'graphite\n' >"${tmp_repo}/.github/stacking-tool"
graphite_out="$(stacking_tool_read "$tmp_repo")"
assert_contains 'read accepts graphite in temp repo' "$graphite_out" 'graphite'

printf '\n=== functional: stacking_tool_read_optional ===\n'
optional_out="$(stacking_tool_read_optional "$tmp_repo")"
assert_contains 'read_optional returns graphite' "$optional_out" 'graphite'
rm -f "${tmp_repo}/.github/stacking-tool"
optional_missing_exit=0
stacking_tool_read_optional "$tmp_repo" >/dev/null 2>&1 || optional_missing_exit=$?
if [[ "$optional_missing_exit" -ne 0 ]]; then
  pass_case 'read_optional returns non-zero when marker is missing'
else
  fail_case 'read_optional returns non-zero when marker is missing'
fi
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
optional_invalid_exit=0
stacking_tool_read_optional "$tmp_repo" >/dev/null 2>&1 || optional_invalid_exit=$?
if [[ "$optional_invalid_exit" -ne 0 ]]; then
  pass_case 'read_optional returns non-zero when marker is invalid'
else
  fail_case 'read_optional returns non-zero when marker is invalid'
fi
printf 'gh-stack\n' >"${tmp_repo}/.github/stacking-tool"

printf '\n=== functional: stacking_tool_read_or_org_default ===\n'
or_default_out="$(stacking_tool_read_or_org_default "$tmp_repo" 2>/dev/null)"
assert_contains 'read_or_org_default returns gh-stack when valid' "$or_default_out" 'gh-stack'
rm -f "${tmp_repo}/.github/stacking-tool"
or_default_log="$(stacking_tool_read_or_org_default "$tmp_repo" 2>&1)"
or_default_value="$(stacking_tool_read_or_org_default "$tmp_repo" 2>/dev/null)"
if printf '%s' "$or_default_log" | grep -qF "using org default 'gh-stack'" \
  && [[ "$or_default_value" == 'gh-stack' ]]; then
  pass_case 'read_or_org_default logs and returns org default when marker missing'
else
  fail_case 'read_or_org_default logs and returns org default when marker missing'
fi
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
or_default_invalid_exit=0
# stacking_tool_die uses exit; run in a subshell so the suite continues.
( stacking_tool_read_or_org_default "$tmp_repo" >/dev/null 2>&1 ) || or_default_invalid_exit=$?
if [[ "$or_default_invalid_exit" -ne 0 ]]; then
  pass_case 'read_or_org_default dies when marker is invalid'
else
  fail_case 'read_or_org_default dies when marker is invalid'
fi
printf 'gh-stack\n' >"${tmp_repo}/.github/stacking-tool"

printf '\n=== functional: stacking_tool_read_or_default ===\n'
rm -f "${tmp_repo}/.github/stacking-tool"
read_or_default_log="$(stacking_tool_read_or_default "$tmp_repo" 'gh-stack' 'dep-updater' 2>&1)"
read_or_default_value="$(stacking_tool_read_or_default "$tmp_repo" 'gh-stack' 'dep-updater' 2>/dev/null)"
if printf '%s' "$read_or_default_log" | grep -qF "using missing-marker default 'gh-stack'" \
  && [[ "$read_or_default_value" == 'gh-stack' ]]; then
  pass_case 'read_or_default logs and returns gh-stack when marker missing'
else
  fail_case 'read_or_default logs and returns gh-stack when marker missing'
fi
mkdir -p "${tmp_repo}/.github"
printf 'graphite\n' >"${tmp_repo}/.github/stacking-tool"
graphite_default_out="$(stacking_tool_read_or_default "$tmp_repo" 'gh-stack' 2>/dev/null)"
if [[ "$graphite_default_out" == 'graphite' ]]; then
  pass_case 'read_or_default returns graphite when marker is graphite'
else
  fail_case "read_or_default returns graphite when marker is graphite (got '${graphite_default_out}')"
fi
printf 'gh-stack\n' >"${tmp_repo}/.github/stacking-tool"
gh_stack_default_out="$(stacking_tool_read_or_default "$tmp_repo" 'graphite' 2>/dev/null)"
if [[ "$gh_stack_default_out" == 'gh-stack' ]]; then
  pass_case 'read_or_default returns gh-stack when marker is gh-stack'
else
  fail_case "read_or_default returns gh-stack when marker is gh-stack (got '${gh_stack_default_out}')"
fi
printf 'not-a-tool\n' >"${tmp_repo}/.github/stacking-tool"
read_or_default_invalid_exit=0
( stacking_tool_read_or_default "$tmp_repo" 'gh-stack' >/dev/null 2>&1 ) \
  || read_or_default_invalid_exit=$?
if [[ "$read_or_default_invalid_exit" -ne 0 ]]; then
  pass_case 'read_or_default dies when marker is invalid'
else
  fail_case 'read_or_default dies when marker is invalid'
fi
printf 'gh-stack\n' >"${tmp_repo}/.github/stacking-tool"

printf '\n=== functional: stacking_tool_submit_as ===\n'
fake_bin="$(mktemp -d)"
gt_log="${fake_bin}/gt.log"
gh_log="${fake_bin}/gh.log"
cat >"${fake_bin}/gt" <<'MOCK_GT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GT_LOG:?}"
MOCK_GT
chmod +x "${fake_bin}/gt"
cat >"${fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GH_LOG:?}"
if [[ "$*" == *'stack --help'* ]]; then
  exit 0
fi
exit 0
MOCK_GH
chmod +x "${fake_bin}/gh"
submit_as_exit=0
submit_as_out="$(
  PATH="${fake_bin}:${PATH}" GT_LOG="$gt_log" GH_LOG="$gh_log" \
    stacking_tool_submit_as 'graphite' "$tmp_repo" 2>&1
)" || submit_as_exit=$?
if [[ "$submit_as_exit" -ne 0 ]] \
  && grep -qF 'Graphite is retired' <<<"$submit_as_out" \
  && [[ ! -s "$gt_log" ]]; then
  pass_case 'submit_as graphite is refused as retired and never runs gt'
else
  fail_case "submit_as graphite is refused as retired and never runs gt (exit=${submit_as_exit})"
fi
: >"$gt_log"
: >"$gh_log"
submit_as_exit=0
(
  PATH="${fake_bin}:${PATH}" GT_LOG="$gt_log" GH_LOG="$gh_log" \
    stacking_tool_submit_as 'gh-stack' "$tmp_repo"
) || submit_as_exit=$?
if [[ "$submit_as_exit" -eq 0 ]] \
  && grep -qF 'stack submit --auto --open' "$gh_log"; then
  pass_case 'submit_as gh-stack invokes gh stack submit'
else
  fail_case "submit_as gh-stack invokes gh stack submit (exit=${submit_as_exit})"
fi
rm -rf "$fake_bin"

printf '\n=== functional: stacking_tool_ensure_stack_conventional_titles ===\n'
stack_repo="$(mktemp -d)"
git -C "$stack_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$stack_repo" remote add origin 'https://github.com/the-hcma/squash-repo.git'

stack_fake_bin="$(mktemp -d)"
stack_edit_log="${stack_fake_bin}/edit.log"
: >"$stack_edit_log"
cat >"${stack_fake_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'stack view --json'* ]]; then
  printf '%s\n' '{"trunk":"main","currentBranch":"b2","branches":[{"name":"b1","pr":{"number":701}},{"name":"b2","pr":{"number":702}}]}'
  exit 0
fi
if [[ "\$args" == *'api repos/the-hcma/squash-repo'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "\$args" == *'pr view 701'* && "\$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: already good'
  exit 0
fi
if [[ "\$args" == *'pr view 702'* && "\$args" == *'--json title'* ]]; then
  printf '%s\n' 'branch name wt'
  exit 0
fi
if [[ "\$args" == *'pr view 702'* && "\$args" == *'--json commits'* ]]; then
  printf '%s\n' 'fix: the bug'
  exit 0
fi
if [[ "\$args" == *'pr edit 702'* && "\$args" == *'--title'* ]]; then
  printf '%s\n' "\$*" >>'${stack_edit_log}'
  exit 0
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${stack_fake_bin}/gh"

ensure_stack_rc=0
ensure_stack_out=''
ensure_stack_out="$(
  PATH="${stack_fake_bin}:/usr/bin:/bin" \
    stacking_tool_ensure_stack_conventional_titles "$stack_repo" 2>&1
)" || ensure_stack_rc=$?
assert_exit_0 'ensure_stack_conventional_titles fixes every PR in the stack' "$ensure_stack_out" "$ensure_stack_rc"
assert_contains 'checks pr 701' "$ensure_stack_out" 'pr=701'
assert_contains 'derives pr 702 title' "$ensure_stack_out" 'to=fix: the bug'
if grep -q -- '--title fix: the bug' "$stack_edit_log"; then
  pass_case 'gh pr edit received derived title (via stacking-tool)'
else
  fail_case 'gh pr edit received derived title (via stacking-tool)'
fi

printf '\n=== functional: stacking_tool_ensure_stack_conventional_titles fails on unfixable title ===\n'
cat >"${stack_fake_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'stack view --json'* ]]; then
  printf '%s\n' '{"trunk":"main","currentBranch":"b1","branches":[{"name":"b1","pr":{"number":703}}]}'
  exit 0
fi
if [[ "\$args" == *'api repos/the-hcma/squash-repo'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "\$args" == *'pr view 703'* && "\$args" == *'--json title'* ]]; then
  printf '%s\n' 'wip stuff'
  exit 0
fi
if [[ "\$args" == *'pr view 703'* && "\$args" == *'--json commits'* ]]; then
  printf '%s\n' 'WIP'
  exit 0
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${stack_fake_bin}/gh"

fail_stack_rc=0
fail_stack_out=''
fail_stack_out="$(
  PATH="${stack_fake_bin}:/usr/bin:/bin" \
    stacking_tool_ensure_stack_conventional_titles "$stack_repo" 2>&1
)" || fail_stack_rc=$?
assert_exit_nonzero 'ensure_stack_conventional_titles fails on unfixable title' "$fail_stack_out" "$fail_stack_rc"
assert_contains 'reports noncompliant PR' "$fail_stack_out" 'PR_CC_TITLE_NONCOMPLIANT'

printf '\n=== functional: stacking_tool_ensure_stack_conventional_titles excludes merged branches ===\n'
cat >"${stack_fake_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'stack view --json'* ]]; then
  printf '%s\n' '{"trunk":"main","currentBranch":"b2","branches":[{"name":"b1","isMerged":true,"pr":{"number":704}},{"name":"b2","isMerged":false,"pr":{"number":705}}]}'
  exit 0
fi
if [[ "\$args" == *'api repos/the-hcma/squash-repo'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "\$args" == *'pr view 705'* && "\$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: fine'
  exit 0
fi
if [[ "\$args" == *'pr view 704'* ]]; then
  printf 'unexpected gh call on merged PR 704: %s\n' "\$args" >&2
  exit 1
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${stack_fake_bin}/gh"

merged_rc=0
merged_out=''
merged_out="$(
  PATH="${stack_fake_bin}:/usr/bin:/bin" \
    stacking_tool_ensure_stack_conventional_titles "$stack_repo" 2>&1
)" || merged_rc=$?
assert_exit_0 'excludes merged branches from the title check' "$merged_out" "$merged_rc"
assert_contains 'checks the open PR' "$merged_out" 'pr=705'
if grep -qF 'pr=704' <<<"$merged_out"; then
  fail_case 'merged PR 704 was not checked'
else
  pass_case 'merged PR 704 was not checked'
fi

printf '\n=== functional: stacking_tool_ensure_stack_conventional_titles fails closed on stack-view failure ===\n'
cat >"${stack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf 'gh: some transient error\n' >&2
exit 1
MOCK_GH
chmod +x "${stack_fake_bin}/gh"

view_fail_rc=0
view_fail_out=''
view_fail_out="$(
  PATH="${stack_fake_bin}:/usr/bin:/bin" \
    stacking_tool_ensure_stack_conventional_titles "$stack_repo" 2>&1
)" || view_fail_rc=$?
assert_exit_nonzero 'fails closed when gh stack view fails' "$view_fail_out" "$view_fail_rc"
assert_contains 'reports the stack-view failure' "$view_fail_out" 'ERROR: gh stack view --json failed'

printf '\n=== functional: stacking_tool_ensure_stack_conventional_titles fails closed on unparseable stack view output ===\n'
cat >"${stack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'stack view --json'* ]]; then
  printf 'not json\n'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${stack_fake_bin}/gh"

parse_fail_rc=0
parse_fail_out=''
parse_fail_out="$(
  PATH="${stack_fake_bin}:/usr/bin:/bin" \
    stacking_tool_ensure_stack_conventional_titles "$stack_repo" 2>&1
)" || parse_fail_rc=$?
assert_exit_nonzero 'fails closed on unparseable stack view output' "$parse_fail_out" "$parse_fail_rc"
assert_contains 'reports the parse failure' "$parse_fail_out" 'ERROR: could not parse gh stack view output'

printf '\n=== functional: stacking_tool_ensure_stack_conventional_titles skips without origin ===\n'
no_origin_repo="$(mktemp -d)"
git -C "$no_origin_repo" -c user.name=test -c user.email=test@example.com init -q
no_origin_rc=0
no_origin_out=''
no_origin_out="$(stacking_tool_ensure_stack_conventional_titles "$no_origin_repo" 2>&1)" || no_origin_rc=$?
assert_exit_0 'skips quietly with no origin remote' "$no_origin_out" "$no_origin_rc"
assert_contains 'skip note' "$no_origin_out" 'could not resolve origin'

rm -rf "$stack_repo" "$stack_fake_bin" "$no_origin_repo"

printf '\n=== functional: stacking_tool_restack_as gh-stack fallback checks stack titles ===\n'
restack_repo="$(mktemp -d)"
git -C "$restack_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$restack_repo" remote add origin 'https://github.com/the-hcma/squash-repo.git'

restack_fake_bin="$(mktemp -d)"
cat >"${restack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'stack --help'* ]]; then
  exit 0
fi
if [[ "$args" == *'stack sync --remote origin'* ]]; then
  exit 1
fi
if [[ "$args" == *'stack rebase --remote origin'* ]]; then
  exit 0
fi
if [[ "$args" == *'stack submit --auto --open --remote origin'* ]]; then
  exit 0
fi
if [[ "$args" == *'stack view --json'* ]]; then
  printf '%s\n' '{"trunk":"main","currentBranch":"b1","branches":[{"name":"b1","pr":{"number":706}}]}'
  exit 0
fi
if [[ "$args" == *'api repos/the-hcma/squash-repo'* ]]; then
  printf '%s\n' '{"allow_squash_merge":true,"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  exit 0
fi
if [[ "$args" == *'pr view 706'* && "$args" == *'--json title'* ]]; then
  printf '%s\n' 'feat: fine'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${restack_fake_bin}/gh"

restack_rc=0
restack_out=''
restack_out="$(
  PATH="${restack_fake_bin}:${PATH}" \
    stacking_tool_restack_as 'gh-stack' "$restack_repo" 2>&1
)" || restack_rc=$?
if [[ "$restack_rc" -eq 0 ]] && grep -qF 'pr=706' <<<"$restack_out"; then
  pass_case 'restack gh-stack fallback also checks stack PR titles'
else
  fail_case "restack gh-stack fallback also checks stack PR titles (rc=${restack_rc})"
  printf '%s\n' "$restack_out" >&2
fi

rm -rf "$restack_repo" "$restack_fake_bin"

printf '\n=== functional: session_sync_as refuses Graphite and fetches for gh-stack ===\n'
fake_bin="$(mktemp -d)"
gt_log="${fake_bin}/gt.log"
session_repo="$(mktemp -d)"
git -C "$session_repo" init --initial-branch=main -q
git -C "$session_repo" config user.email 't@example.com'
git -C "$session_repo" config user.name 't'
git -C "$session_repo" commit --allow-empty -q -m 'init'
# Bare remote so git fetch --prune origin succeeds.
session_remote="$(mktemp -d)"
git -C "$session_remote" init --bare -q --initial-branch=main
git -C "$session_repo" remote add origin "$session_remote"
git -C "$session_repo" push -u origin main -q

# An authenticated gt on PATH must still never be run.
cat >"${fake_bin}/gt" <<'MOCK_GT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GT_LOG:?}"
exit 0
MOCK_GT
chmod +x "${fake_bin}/gt"
: >"$gt_log"

session_exit=0
session_log="$(
  PATH="${fake_bin}:${PATH}" GT_LOG="$gt_log" \
    stacking_tool_session_sync_as 'graphite' "$session_repo" 2>&1
)" || session_exit=$?
if [[ "$session_exit" -ne 0 ]] \
  && grep -qF 'Graphite is retired' <<<"$session_log" \
  && [[ ! -s "$gt_log" ]]; then
  pass_case 'session_sync_as graphite is refused as retired and never runs gt'
else
  fail_case "session_sync_as graphite is refused as retired and never runs gt (exit=${session_exit})"
  printf '%s\n' "$session_log" >&2
fi

# gh-stack session sync only needs git: a host without the gh stack extension must still fetch.
: >"$gt_log"
printf '#!/usr/bin/env bash\nexit 1\n' >"${fake_bin}/gh"
chmod +x "${fake_bin}/gh"
session_exit=0
session_log="$(
  PATH="${fake_bin}:${PATH}" \
    stacking_tool_session_sync_as 'gh-stack' "$session_repo" 2>&1
)" || session_exit=$?
if [[ "$session_exit" -eq 0 ]] && ! grep -qF 'gh stack extension not available' <<<"$session_log"; then
  pass_case 'session_sync_as gh-stack fetches without the gh stack extension'
else
  fail_case "session_sync_as gh-stack fetches without the gh stack extension (exit=${session_exit})"
  printf '%s\n' "$session_log" >&2
fi
rm -rf "$fake_bin" "$session_repo" "$session_remote"

rm -rf "$tmp_repo"

printf '\n=== functional: stacking_tool_require_cli ===\n'
# require_cli dies (exit) when the backend CLI is missing — run in a subshell.
require_exit=0
( stacking_tool_require_cli 'gh-stack' ) >/dev/null 2>&1 || require_exit=$?
if [[ "$require_exit" -eq 0 ]]; then
  pass_case 'require_cli accepts available gh-stack extension'
else
  printf '[SKIP] require_cli: gh-stack extension not installed (CI/hosts without gh-stack)\n'
fi

fake_bin="$(mktemp -d)"
# Graphite is retired: require_cli refuses it even when gt is on PATH. Run in a subshell: it dies via exit.
printf '#!/usr/bin/env bash\nexit 0\n' >"${fake_bin}/gt"
chmod +x "${fake_bin}/gt"
require_exit=0
require_out="$( PATH="${fake_bin}:${PATH}" stacking_tool_require_cli 'graphite' 2>&1 )" || require_exit=$?
if [[ "$require_exit" -ne 0 ]] && grep -qF 'Graphite is retired' <<<"$require_out"; then
  pass_case 'require_cli refuses graphite as retired even when gt is installed'
else
  fail_case 'require_cli refuses graphite as retired even when gt is installed'
fi
rm -rf "$fake_bin"

printf '\n=== static: skills and stacking-tool rule ===\n'
if [[ ! -e "${rh_root}/.agents/skills/graphite" ]]; then
  pass_case 'the graphite skill is gone (Graphite is retired)'
else
  fail_case 'the graphite skill is gone (Graphite is retired)'
fi
if [[ -f "${rh_root}/.agents/skills/gh-stack/SKILL.md" ]] \
  && grep -qF 'name: gh-stack' "${rh_root}/.agents/skills/gh-stack/SKILL.md"; then
  pass_case 'gh-stack skill exists under .agents/skills/gh-stack/'
else
  fail_case 'gh-stack skill exists under .agents/skills/gh-stack/'
fi
if [[ ! -f "${rh_root}/GRAPHITE.md" ]]; then
  pass_case 'root GRAPHITE.md removed (skill is SSOT)'
else
  fail_case 'root GRAPHITE.md removed (skill is SSOT)'
fi
if [[ -f "${rh_root}/.cursor/rules/stacking-tool.mdc" ]] \
  && grep -qF '<!-- agents-rule-shim: stacking-tool -->' \
    "${rh_root}/.cursor/rules/stacking-tool.mdc" \
  && [[ -f "${rh_root}/.agents/rules/stacking-tool.md" ]] \
  && grep -qF '.github/stacking-tool' "${rh_root}/.agents/rules/stacking-tool.md" \
  && grep -qF '.agents/skills/gh-stack/SKILL.md' "${rh_root}/.agents/rules/stacking-tool.md" \
  && ! grep -qF '.agents/skills/graphite' "${rh_root}/.agents/rules/stacking-tool.md" \
  && grep -qF 'Marker cutover checklist' "${rh_root}/.agents/rules/stacking-tool.md"; then
  pass_case 'stacking-tool agents rule references the marker and the gh-stack skill only; Cursor shim present'
else
  fail_case 'stacking-tool agents rule references the marker and the gh-stack skill only; Cursor shim present'
fi

printf '\n=== static: scripts that invoke gt/gh stack must gate on stacking-tool ===\n'
# Ratchet: bare Graphite / gh-stack CLI use outside scripts/lib/stacking-tool must
# source the shared lib and reference a marker-aware gate (issue #387 follow-up).
ratchet_fail=0
ratchet_report="$(mktemp)"
while IFS= read -r -d '' script_path; do
  base="$(basename "$script_path")"
  if [[ "$base" == 'stacking-tool' ]]; then
    continue
  fi
  # Non-comment lines that look like real gt / gh stack CLI usage (not install hints).
  invoke_lines="$(
    { grep -nE '(^|[^[:alnum:]_-])gt[[:space:]]+(auth|submit|sync|restack|track|create|info|modify|branch)\b' "$script_path" || true
      grep -nE '(^|[^[:alnum:]_-])gh[[:space:]]+stack[[:space:]]' "$script_path" || true
    } | grep -vE '^[0-9]+:[[:space:]]*#' || true
  )"
  if [[ -z "${invoke_lines}" ]]; then
    continue
  fi
  if ! grep -qF 'lib/stacking-tool' "$script_path"; then
    printf 'missing stacking-tool source: %s\n' "$script_path" >>"$ratchet_report"
    ratchet_fail=1
    continue
  fi
  if ! grep -qE \
    'stacking_tool_read|stacking_tool_read_optional|stacking_tool_read_or_default|stacking_tool_read_or_org_default|stacking_tool_submit|stacking_tool_restack|stacking_tool_restack_as|stacking_tool_session_sync|dep_stacking_is_|start_dev_stacking_tool_value|rp_stacking_tool_marker_content_for_apply_fix' \
    "$script_path"; then
    printf 'missing marker-aware gate: %s\n' "$script_path" >>"$ratchet_report"
    ratchet_fail=1
  fi
done < <(find "${rh_root}/scripts" "${rh_root}/scripts/dev" "${rh_root}/scripts/lib" \
  -maxdepth 1 -type f ! -name '*.md' ! -name '*.yml' ! -name '*.yaml' ! -name '*.json' \
  -print0 | sort -z)

if [[ "$ratchet_fail" -eq 0 ]]; then
  pass_case 'scripts invoking gt/gh stack source stacking-tool and gate on marker'
else
  fail_case 'scripts invoking gt/gh stack source stacking-tool and gate on marker'
  cat "$ratchet_report" >&2 || true
fi
rm -f "$ratchet_report"

printf '\n=== functional: stacking_tool_ensure_registered (repository-helpers#744) ===\n'
reg_repo="$(mktemp -d)"
git -C "$reg_repo" init --quiet --initial-branch=main
git -C "$reg_repo" -c user.name=t -c user.email=t@example.invalid commit --quiet --allow-empty --no-gpg-sign -m init
git -C "$reg_repo" checkout --quiet -b feature-x
reg_bin="$(mktemp -d)"
reg_log="${reg_bin}/gh.log"
# Fake gh: `gh stack view --json` fails like gh does for an unregistered branch until `gh stack init` ran
# (it drops a marker file), then succeeds; everything is logged.
cat >"${reg_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${GH_LOG:?}"
case "$1 $2" in
  'stack view')
    if [[ -n "${REG_VIEW_RC:-}" ]]; then exit "${REG_VIEW_RC}"; fi
    if [[ -f "${REG_MARK:?}" ]]; then exit 0; fi
    printf 'current branch is not part of a stack\n' >&2
    exit 2
    ;;
  'stack init')
    printf 'init-env rerere=%s\n' "${GIT_CONFIG_VALUE_0:-unset}" >>"${GH_LOG}"
    if [[ -n "${REG_INIT_FAIL:-}" ]]; then
      if [[ -n "${REG_MARK_ON_FAIL:-}" ]]; then : >"${REG_MARK}"; fi
      exit "${REG_INIT_FAIL}"
    fi
    : >"${REG_MARK}"
    exit 0
    ;;
esac
exit 0
MOCK_GH
chmod +x "${reg_bin}/gh"
reg_mark="${reg_bin}/registered"
reg_run() { # <tool> [env…] — runs ensure_registered for the repo, prints exit code
  local -r tool="$1"
  shift
  local rc=0
  ( env PATH="${reg_bin}:${PATH}" GH_LOG="$reg_log" REG_MARK="$reg_mark" "$@" bash -c "
      source '${lib}'
      stacking_tool_ensure_registered '${tool}' '${reg_repo}'" ) >/dev/null 2>&1 || rc=$?
  printf '%s' "$rc"
}
: >"$reg_log"
reg_rc="$(reg_run gh-stack)"
if [[ "$reg_rc" == '0' ]] && grep -qF 'stack init feature-x' "$reg_log" && grep -qF 'init-env rerere=true' "$reg_log"; then
  pass_case 'an unregistered feature branch is adopted with gh stack init, with the rerere prompt disabled for the call'
else
  fail_case "an unregistered feature branch is adopted with gh stack init (rc=${reg_rc})"
fi
: >"$reg_log"
reg_rc="$(reg_run gh-stack)"
if [[ "$reg_rc" == '0' ]] && ! grep -qF 'stack init' "$reg_log"; then
  pass_case 'a branch already in a stack is left alone (idempotent)'
else
  fail_case "a branch already in a stack is left alone (rc=${reg_rc})"
fi
rm -f "$reg_mark"
: >"$reg_log"
reg_rc="$(reg_run graphite)"
if [[ "$reg_rc" == '0' ]] && [[ ! -s "$reg_log" ]]; then
  pass_case 'the graphite backend needs no stack registration'
else
  fail_case "the graphite backend needs no stack registration (rc=${reg_rc})"
fi
reg_rc="$(reg_run gh-stack REG_INIT_FAIL=1)"
if [[ "$reg_rc" != '0' ]]; then
  pass_case 'a failed gh stack init is an error'
else
  fail_case 'a failed gh stack init is an error'
fi
rm -f "$reg_mark"
reg_rc="$(reg_run gh-stack REG_INIT_FAIL=5 REG_MARK_ON_FAIL=1)"
if [[ "$reg_rc" == '0' ]]; then
  pass_case 'gh stack init exit 5 is accepted when the branch is now in a stack (registered concurrently)'
else
  fail_case "gh stack init exit 5 is accepted when the branch is now in a stack (rc=${reg_rc})"
fi
rm -f "$reg_mark"
reg_rc="$(reg_run gh-stack REG_INIT_FAIL=5)"
if [[ "$reg_rc" != '0' ]]; then
  pass_case 'gh stack init exit 5 stays an error when the branch is still not in a stack (invalid arguments)'
else
  fail_case 'gh stack init exit 5 stays an error when the branch is still not in a stack (invalid arguments)'
fi
rm -f "$reg_mark"
: >"$reg_log"
reg_rc="$(reg_run gh-stack REG_VIEW_RC=1)"
if [[ "$reg_rc" != '0' ]] && ! grep -qF 'stack init' "$reg_log"; then
  pass_case 'a gh stack view failure other than "not in a stack" never leads to a registration'
else
  fail_case "a gh stack view failure other than \"not in a stack\" never leads to a registration (rc=${reg_rc})"
fi
git -C "$reg_repo" checkout --quiet main
: >"$reg_log"
reg_rc="$(reg_run gh-stack)"
if [[ "$reg_rc" != '0' ]] && ! grep -qF 'stack init' "$reg_log"; then
  pass_case 'the trunk branch is never registered as a stack'
else
  fail_case "the trunk branch is never registered as a stack (rc=${reg_rc})"
fi
git -C "$reg_repo" checkout --quiet --detach
reg_rc="$(reg_run gh-stack)"
if [[ "$reg_rc" != '0' ]]; then
  pass_case 'a detached HEAD is refused'
else
  fail_case 'a detached HEAD is refused'
fi
rm -rf "$reg_repo" "$reg_bin"

printf '\n=== static: submit-stack and start-development register the branch (#744) ===\n'
submit_text="$(<"${rh_root}/scripts/dev/submit-stack")"
start_text="$(<"${rh_root}/scripts/dev/start-development")"
# Registration must come before the long pre-PR run, or the failure it prevents happens after ten minutes.
# shellcheck disable=SC2016  # literal source text to look for, not an expansion
if [[ "${submit_text}" == *stacking_tool_ensure_registered*'"${script_dir}/pre-pr-checks"'* ]]; then
  pass_case 'submit-stack registers the branch before it runs pre-pr-checks'
else
  fail_case 'submit-stack registers the branch before it runs pre-pr-checks'
fi
# shellcheck disable=SC2016  # literal source text to look for, not an expansion
if [[ "${start_text}" == *'stacking_tool_ensure_registered "$stacking_tool_value_gh_stack" "$selected_path"'* ]]; then
  pass_case 'start-development registers the new worktree branch for gh-stack'
else
  fail_case 'start-development registers the new worktree branch for gh-stack'
fi

printf '\n=== static: merge guidance names the stacked-PR exception (#748) ===\n'
# Every agent-facing rule that tells agents to merge with `gh pr merge --auto` must also say that a PR in a
# gh stack cannot use auto-merge and is landed with `gh stack merge`, or an agent follows the plain command
# and the merge silently never happens. The scripts/lib/repo-practices-agents copies are what consumers get.
doc_files=(AGENTS.md README.md .github/copilot-instructions.md)
for doc_path in "${rh_root}"/.agents/rules/*.md "${rh_root}"/.agents/skills/*/SKILL.md \
  "${rh_root}"/scripts/lib/repo-practices-agents/rules/*.md; do
  doc_files+=("${doc_path#"${rh_root}"/}")
done
for doc in "${doc_files[@]}"; do
  doc_text="$(<"${rh_root}/${doc}")"
  if [[ "$doc_text" == *'gh pr merge'*'--auto'* && "$doc_text" != *'gh stack merge'* ]]; then
    fail_case "${doc} tells agents to auto-merge without the gh stack merge exception"
  else
    pass_case "${doc} names the gh stack merge exception wherever it says gh pr merge --auto"
  fi
done

printf '\n=== static: dev scripts no longer describe a Graphite submit path (#772) ===\n'
dev_graphite_hits=''
for dev_script in submit-stack ship-and-review merge-stack; do
  if grep -qE 'gt submit|gt or gh stack' "${rh_root}/scripts/dev/${dev_script}"; then
    dev_graphite_hits="${dev_graphite_hits} ${dev_script}"
  fi
done
if [[ -z "$dev_graphite_hits" ]]; then
  pass_case "submit-stack, ship-and-review and merge-stack never mention gt submit"
else
  fail_case "scripts still describe a gt submit path:${dev_graphite_hits}"
fi

printf '\n=== summary ===\n'
printf 'pass=%s fail=%s\n' "$pass" "$fail"
if [[ "$fail" -ne 0 ]]; then
  exit 1
fi
exit 0
