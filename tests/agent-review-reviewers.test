#!/usr/bin/env bash
# Tests for scripts/lib/agent-review-reviewers (agent-reviewers custom property, #716).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/agent-review"
quota_lib="${script_dir}/../scripts/lib/agent-review-quota"
reviewers_lib="${script_dir}/../scripts/lib/agent-review-reviewers"
wait_script="${script_dir}/../scripts/wait-for-agent-review"
readonly wait_script
readonly lib quota_lib reviewers_lib

work_dir="$(mktemp -d)"
readonly work_dir
trap 'rm -rf "${work_dir}"' EXIT
fake_bin="${work_dir}/bin"
gh_log="${work_dir}/gh.log"
fixture="${work_dir}/properties.json"
mkdir -p "${fake_bin}"

# Fake gh: logs the call, fails when FAKE_GH_FAIL=1, else applies the caller's --jq to the fixture.
cat >"${fake_bin}/gh" <<'FAKE'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${FAKE_GH_LOG}"
if [[ "${FAKE_GH_FAIL:-0}" == '1' ]]; then
  printf 'HTTP 403: Resource not accessible\n' >&2
  exit 1
fi
filter='.'
while (( $# > 0 )); do
  if [[ "$1" == '--jq' ]]; then
    filter="$2"
    shift
  fi
  shift
done
exec jq -r "${filter}" "${FAKE_GH_FIXTURE}"
FAKE
chmod +x "${fake_bin}/gh"

# run_chain <fixture-json> [env assignments…] — prints stdout of the effective chain for a repo.
run_case() {
  local -r json="$1"
  local -r snippet="$2"
  shift 2

  printf '%s' "${json}" >"${fixture}"
  : >"${gh_log}"
  rm -rf "${work_dir}/cache"
  env -u AGENT_REVIEW_QUOTA_FALLBACK_CHAIN -u AGENT_REVIEW_GITHUB_REPO \
    PATH="${fake_bin}:${PATH}" FAKE_GH_LOG="${gh_log}" FAKE_GH_FIXTURE="${fixture}" \
    AGENT_REVIEW_REVIEWERS_CACHE_DIR="${work_dir}/cache" "$@" \
    bash -c "source '${lib}'; source '${quota_lib}'; ${snippet}" 2>&1
}

printf '\n=== property filters the default chain ===\n'
out="$(run_case '[{"property_name":"agent-reviewers","value":["bugbot","copilot"]}]' \
  "agent_review_reviewers_effective_chain the-hcma/example")"
assert_contains "property [bugbot, copilot] keeps the fixed escalation order" "$out" "copilot,bugbot"
assert_not_contains "a disabled agent is dropped from the chain" "$out" "coderabbit"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"}]' \
  "printf '[%s]' \"\$(agent_review_reviewers_effective_chain the-hcma/example)\"")"
assert_contains "agent-review-enabled=false yields an empty chain" "$out" "[]"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"}]' \
  "agent_review_reviewers_is_enabled copilot the-hcma/example && echo enabled || echo disabled")"
assert_contains "agent-review-enabled=false disables copilot" "$out" "disabled"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"}]' \
  "agent_review_reviewers_is_disabled the-hcma/example && echo disabled || echo active")"
assert_contains "agent-review-enabled=false marks agent review disabled" "$out" "disabled"

out="$(run_case '[{"property_name":"agent-reviewers","value":["copilot"]}]' \
  "agent_review_reviewers_is_disabled the-hcma/example && echo disabled || echo active")"
assert_contains "property copilot leaves agent review active" "$out" "active"

printf '\n=== unset or empty property falls back to the default ===\n'
out="$(run_case '[{"property_name":"other","value":"x"}]' \
  "agent_review_reviewers_effective_chain the-hcma/example")"
assert_contains "absent property uses the default chain" "$out" "coderabbit"

out="$(run_case '[{"property_name":"agent-reviewers","value":null}]' \
  "agent_review_reviewers_effective_chain the-hcma/example")"
assert_contains "null property value uses the default chain" "$out" "coderabbit"

out="$(run_case '[{"property_name":"agent-reviewers","value":["nonsense"]}]' \
  "agent_review_reviewers_effective_chain the-hcma/example")"
assert_contains "property with no known reviewer warns" "$out" "has no known reviewer; using default"
assert_contains "property with no known reviewer uses the default chain" "$out" "coderabbit"
assert_not_contains "the default chain is coderabbit only" "$out" "copilot"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"true"}]' \
  "agent_review_reviewers_effective_chain the-hcma/example")"
assert_contains "agent-review-enabled=true alone keeps the default chain" "$out" "coderabbit"
assert_not_contains "agent-review-enabled=true alone does not add copilot" "$out" "copilot"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"},{"property_name":"agent-reviewers","value":["copilot"]}]' \
  "agent_review_reviewers_is_disabled the-hcma/example && echo disabled || echo active")"
assert_contains "agent-review-enabled=false wins over the reviewer list" "$out" "disabled"

out="$(run_case '[{"property_name":"agent-reviewers","value":["none","copilot"]},{"property_name":"agent-review-enabled","value":"true"}]' \
  "agent_review_reviewers_effective_chain the-hcma/example")"
assert_contains "none mixed into agent-reviewers warns as invalid" "$out" "none is not a reviewer"
assert_contains "none mixed into agent-reviewers falls back to the default chain" "$out" "coderabbit"
out="$(run_case '[{"property_name":"agent-reviewers","value":["none","copilot"]}]' \
  "printf '[%s]' \"\$(agent_review_reviewers_effective_chain the-hcma/example 2>/dev/null)\"")"
assert_contains "none mixed into agent-reviewers yields exactly the default chain" "$out" "[coderabbit]"

printf '\n=== API failure falls back with a warning ===\n'
out="$(run_case '[]' "agent_review_reviewers_effective_chain the-hcma/example" FAKE_GH_FAIL=1)"
assert_contains "failed property read warns" "$out" "could not read agent-reviewers for the-hcma/example"
assert_contains "failed property read uses the default chain" "$out" "coderabbit"

printf '\n=== explicit env override wins over the property ===\n'
out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"}]' \
  "agent_review_reviewers_effective_chain the-hcma/example" \
  AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=bugbot)"
assert_contains "AGENT_REVIEW_QUOTA_FALLBACK_CHAIN overrides the property" "$out" "bugbot"
if [[ -s "${gh_log}" ]]; then
  fail_case "env override does not read the property (gh was called: $(tr '\n' ';' <"${gh_log}"))"
else
  pass_case "env override does not read the property"
fi

printf '\n=== property read is cached ===\n'
run_case '[{"property_name":"agent-reviewers","value":["copilot"]}]' \
  "agent_review_reviewers_effective_chain the-hcma/example >/dev/null
   agent_review_reviewers_effective_chain the-hcma/example >/dev/null
   agent_review_reviewers_effective_chain the-hcma/example >/dev/null" >/dev/null
assert_count_equals "three lookups hit the properties API once" "$(cat "${gh_log}")" "properties/values" 1
assert_contains "the API call targets the repo properties endpoint" \
  "$(cat "${gh_log}")" "repos/the-hcma/example/properties/values"

printf '\n=== chain and candidates follow the property ===\n'
out="$(run_case '[{"property_name":"agent-reviewers","value":["bugbot"]}]' \
  "AGENT_REVIEW_GITHUB_REPO=the-hcma/example
   agent_review_quota_escalation_agent_ids | tr '\n' ' '" )"
assert_contains "escalation ids list only the enabled agent" "$out" "bugbot"
assert_not_contains "escalation ids omit disabled copilot" "$out" "copilot"

out="$(run_case '[{"property_name":"agent-reviewers","value":["bugbot"]}]' \
  "AGENT_REVIEW_GITHUB_REPO=the-hcma/example
   agent_review_requestable_agent_candidates copilot | tr '\n' ' '")"
assert_contains "requestable candidates include the enabled agent" "$out" "bugbot"
assert_not_contains "a disabled preferred agent is not requestable" "$out" "copilot"

printf '\n=== all-quotas-exhausted follows the chain ===\n'
out="$(run_case '[{"property_name":"agent-reviewers","value":["copilot"]}]' \
  "export AGENT_REVIEW_GITHUB_REPO=the-hcma/example
   export AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${work_dir}/copilot.env'
   export AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE='${work_dir}/bugbot.env'
   export AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${work_dir}/coderabbit.env'
   agent_review_copilot_quota_write_cache 1 observed 'Copilot exhausted.'
   agent_review_all_quotas_exhausted && echo all-exhausted || echo not-all-exhausted")"
assert_contains "exhausting the only enabled agent exhausts the chain" "$out" "all-exhausted"
assert_not_contains "a disabled agent's quota does not keep the chain alive" "$out" "not-all-exhausted"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"}]' \
  "export AGENT_REVIEW_GITHUB_REPO=the-hcma/example
   agent_review_all_quotas_exhausted && echo all-exhausted || echo not-all-exhausted")"
assert_contains "a disabled repo is not reported as quota-exhausted" "$out" "not-all-exhausted"

printf '\n=== commands skip the wait when agent review is disabled ===\n'
printf '%s' '[{"property_name":"agent-review-enabled","value":"false"}]' >"${fixture}"
for sub in wait request; do
  : >"${gh_log}"
  rc=0
  out="$(env -u AGENT_REVIEW_QUOTA_FALLBACK_CHAIN PATH="${fake_bin}:${PATH}" FAKE_GH_LOG="${gh_log}" \
    FAKE_GH_FIXTURE="${fixture}" AGENT_REVIEW_REVIEWERS_CACHE_DIR="${work_dir}/cache-${sub}" \
    AGENT_REVIEW_ENV_FILE=/dev/null \
    bash "${script_dir}/../scripts/wait-for-agent-review" "${sub}" --repo the-hcma/example --pr 1 2>&1)" || rc=$?
  assert_exit_0 "${sub} exits 0 when agent review is disabled" "$out" "$rc"
  assert_contains "${sub} says agent review is disabled" "$out" "agent review disabled for the-hcma/example"
done

printf '\n=== the active agent follows the repo property ===\n'
out="$(run_case '[{"property_name":"agent-reviewers","value":["bugbot"]}]' \
  "AGENT_REVIEW_AGENT=copilot
   agent_review_reviewers_select_agent the-hcma/example; echo \"agent=\${AGENT_REVIEW_AGENT}\"" )"
assert_contains "a disabled preferred agent is replaced by the first enabled reviewer" "$out" "agent=bugbot"
assert_contains "the switch is announced" "$out" "copilot is not an enabled reviewer for the-hcma/example; using bugbot"

out="$(run_case '[]' \
  "AGENT_REVIEW_AGENT=copilot
   agent_review_reviewers_select_agent the-hcma/example; echo \"agent=\${AGENT_REVIEW_AGENT}\"")"
assert_contains "with nothing configured the default agent becomes coderabbit" "$out" "agent=coderabbit"

out="$(run_case '[{"property_name":"agent-reviewers","value":["copilot","bugbot"]}]' \
  "AGENT_REVIEW_AGENT=copilot
   agent_review_reviewers_select_agent the-hcma/example; echo \"agent=\${AGENT_REVIEW_AGENT}\"")"
assert_contains "an enabled preferred agent is kept" "$out" "agent=copilot"
assert_not_contains "no switch is announced for an enabled agent" "$out" "using"

out="$(run_case '[{"property_name":"agent-review-enabled","value":"false"}]' \
  "agent_review_reviewers_select_agent the-hcma/example && echo selected || echo none-enabled")"
assert_contains "a disabled repo has no agent to select" "$out" "none-enabled"

wait_body="$(awk '/^cmd_(wait|request)\(\) \{/{f=1} f{print} f&&/^\}/{f=0}' "${script_dir}/../scripts/wait-for-agent-review")"
assert_count_equals "wait and request both select an enabled agent" "$wait_body" \
  "agent_review_reviewers_select_agent" 2

printf '\n=== failed reads are cached briefly ===\n'
out="$(run_case '[]' \
  "agent_review_reviewers_effective_chain the-hcma/example >/dev/null
   agent_review_reviewers_effective_chain the-hcma/example >/dev/null
   agent_review_reviewers_effective_chain the-hcma/example >/dev/null" FAKE_GH_FAIL=1)"
assert_count_equals "three lookups after a failed read call the API once" "$(cat "${gh_log}")" "properties/values" 1
assert_count_equals "three lookups after a failed read warn once" "$out" "could not read agent-reviewers" 1

printf '\n=== cache writes leave no temp files ===\n'
run_case '[{"property_name":"agent-reviewers","value":["copilot"]}]' \
  "agent_review_reviewers_effective_chain the-hcma/example >/dev/null" >/dev/null
leftovers="$(find "${work_dir}/cache" -type f ! -name 'the-hcma__example' 2>/dev/null | wc -l)"
assert_count_equals "only the final cache file remains after a write" "${leftovers}" "0" 1
assert_contains "the cache file holds the property value" "$(cat "${work_dir}/cache/the-hcma__example")" "copilot"

printf '\n=== env override entries are trimmed ===\n'
out="$(run_case '[]' \
  "printf '[%s]' \"\$(agent_review_reviewers_effective_chain the-hcma/example)\"" \
  'AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=coderabbit, copilot ,bugbot')"
assert_contains "spaces around override entries are trimmed" "$out" "[coderabbit,copilot,bugbot]"
out="$(run_case '[]' \
  "agent_review_reviewers_is_enabled copilot the-hcma/example && echo enabled || echo disabled" \
  'AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=coderabbit, copilot')"
assert_contains "a spaced override entry still enables its reviewer" "$out" "enabled"

printf '\n=== an empty override is no override ===\n'
out="$(run_case '[{"property_name":"agent-reviewers","value":["bugbot"]}]' \
  "printf '[%s]' \"\$(agent_review_reviewers_effective_chain the-hcma/example)\"" \
  'AGENT_REVIEW_QUOTA_FALLBACK_CHAIN= , ,')"
assert_contains "an override of only spaces and commas falls back to the property" "$out" "[bugbot]"
out="$(run_case '[]' \
  "agent_review_reviewers_is_disabled the-hcma/example && echo disabled || echo active" \
  'AGENT_REVIEW_QUOTA_FALLBACK_CHAIN= , ,')"
assert_contains "an empty override does not disable agent review" "$out" "active"

printf '\n=== env override none disables agent review ===\n'
out="$(run_case '[]' \
  "printf '[%s]' \"\$(agent_review_reviewers_effective_chain the-hcma/example)\"
   agent_review_reviewers_is_disabled the-hcma/example && echo disabled || echo active" \
  AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=none)"
assert_contains "AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=none yields an empty chain" "$out" "[]"
assert_contains "AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=none disables agent review" "$out" "disabled"

printf '\n=== static: status gate ===\n'
# shellcheck disable=SC2016  # the needle is literal source text, not an expansion
needle='agent_review_reviewers_is_disabled "${repo}"'
if grep -qF "$needle" "$lib"; then
  pass_case "complete_ready skips the agent sign-off requirement when agent review is disabled"
else
  fail_case "complete_ready skips the agent sign-off requirement when agent review is disabled"
fi
if grep -qF "$needle" "$wait_script"; then
  pass_case "the loop idle gate skips the agent sign-off requirement when agent review is disabled"
else
  fail_case "the loop idle gate skips the agent sign-off requirement when agent review is disabled"
fi

printf '\n=== static: loop skips CodeRabbit waits when it is not enabled ===\n'
loop_body="$(awk '/^cmd_loop\(\) \{/{f=1} f{print} f&&/^\}/{exit}' "${script_dir}/../scripts/wait-for-agent-review")"
assert_contains "the loop computes whether CodeRabbit is enabled" "$loop_body" \
  "agent_review_reviewers_is_enabled coderabbit"
assert_contains "the pending CodeRabbit workflow wait is gated" "$loop_body" \
  "if (( coderabbit_active == 1 )) \\"
assert_contains "the CodeRabbit rate-limit handler is gated" "$loop_body" \
  "rate_exit=1"

printf '\n=== static: sign-off only counts enabled reviewers ===\n'
signoff_body="$(awk '/^agent_review_delivered_recognized_pass_on_head\(\) \{/{f=1} f{print} f&&/^\}/{exit}' "$lib")"
assert_contains "a disabled reviewer is skipped before its sign-off is evaluated" "$signoff_body" \
  "if ! agent_review_reviewers_is_enabled \"\${agent}\" \"\${repo}\"; then"

printf '\n=== static: env example ===\n'
if ! grep -qE '^AGENT_REVIEW_AGENT=' "${script_dir}/../etc/agent-review.env.example"; then
  pass_case "the env example leaves the preferred agent unset so the repo settings decide"
else
  fail_case "the env example leaves the preferred agent unset so the repo settings decide"
fi
if ! grep -qE '^AGENT_REVIEW_QUOTA_FALLBACK_CHAIN=' "${script_dir}/../etc/agent-review.env.example"; then
  pass_case "the env example leaves the chain override commented out so the property applies"
else
  fail_case "the env example leaves the chain override commented out so the property applies"
fi

printf '\n=== static: reviewers lib ===\n'
if ! grep -nE '(^|[^_[:alnum:]/-])(tr|date|stat|cat|mkdir|mktemp|mv|rm) ' "$reviewers_lib" \
  | grep -vE '^[0-9]+:\s*#|runner_exec|run_quiet|"agent-reviewers|then$' >/dev/null; then
  pass_case "reviewers lib calls no external utility outside the runner"
else
  fail_case "reviewers lib calls no external utility outside the runner"
fi
if ! grep -nE '(^|[^_[:alnum:]])gh (api|pr|issue)' "$reviewers_lib" \
  | grep -vE 'github_api_exec_with_rate_limit_retry|^[0-9]+:\s*#|gh api "repos' >/dev/null; then
  pass_case "reviewers lib has no unwrapped gh call"
else
  fail_case "reviewers lib has an unwrapped gh call"
fi

test_summary
