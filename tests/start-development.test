#!/usr/bin/env bash
# Smoke tests for scripts/dev/start-development.
#
# start-development interacts with git remotes, gh, gt, and systemd — full
# integration tests are not feasible in CI. These tests cover:
#   1. --help exits 0 and prints expected content.
#   2. Unknown argument exits non-zero with an informative message.
#   3. Static analysis: no 'local -r' inside loop bodies.
#   4. Static analysis: shebang is '#!/usr/bin/env bash'.
#   5. Static analysis: 'set -euo pipefail' is present.
#   6. Static analysis: script uses $() not backticks for command substitution.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/dev/start-development"
readonly script

pass=0
fail=0

# ---------------------------------------------------------------------------
# Test: --help
# ---------------------------------------------------------------------------

printf '\n=== --help ===\n'
help_output=""
help_exit=0
help_output="$(bash "$script" --help 2>&1)" || help_exit=$?

assert_exit_0   "--help" "$help_output" "$help_exit"
assert_contains "--help" "$help_output" "Usage:"
assert_contains "--help" "$help_output" "--refresh"
assert_contains "--help" "$help_output" "--resume"
assert_contains "--help" "$help_output" "--no-interactive"
assert_contains "--help" "$help_output" "--worktree"

# ---------------------------------------------------------------------------
# Test: unknown argument
# ---------------------------------------------------------------------------

printf '\n=== unknown argument ===\n'
unknown_output=""
unknown_exit=0
unknown_output="$(bash "$script" --not-a-real-argument 2>&1)" || unknown_exit=$?

assert_exit_nonzero "unknown argument" "$unknown_output" "$unknown_exit"
assert_contains     "unknown argument" "$unknown_output" "Unknown argument"

# ---------------------------------------------------------------------------
# Test: --no-interactive fails fast without --worktree
# ---------------------------------------------------------------------------
#
# In CI we must avoid network / side-effectful operations. --no-interactive with no
# --worktree should exit before doing any git/gh/gt work.

printf '\n=== --no-interactive requires --worktree ===\n'
noninteractive_output=""
noninteractive_exit=0
noninteractive_output="$(bash "$script" --no-interactive 2>&1)" || noninteractive_exit=$?

assert_exit_nonzero "--no-interactive missing --worktree" "$noninteractive_output" "$noninteractive_exit"
assert_contains     "--no-interactive missing --worktree" "$noninteractive_output" "No stack name provided (--worktree <name>)"

# ---------------------------------------------------------------------------
# Static: no 'local -r' inside loop bodies
# ---------------------------------------------------------------------------

printf '\n=== static: local -r in loops ===\n'
local_r_in_loops="$(awk '
  /^[[:space:]]*(while|for|until)[[:space:]]/ { depth++ }
  /^[[:space:]]*done\b/ { if (depth > 0) depth-- }
  /^}/ { depth=0 }
  /[[:space:]]local[[:space:]]+-[a-zA-Z]*r/ && depth > 0 { print NR": "$0 }
' "$script")"
if [[ -n "$local_r_in_loops" ]]; then
  printf '[FAIL] local-r-in-loops: local -r inside a loop body crashes on 2nd iteration:\n%s\n' \
    "$local_r_in_loops"
  fail=$(( fail + 1 ))
else
  printf '[PASS] local-r-in-loops: no local -r declarations inside loops\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: shebang and safety flags
# ---------------------------------------------------------------------------

printf '\n=== static: shebang and safety flags ===\n'

if head -1 "$script" | grep -qF '#!/usr/bin/env bash'; then
  printf '[PASS] shebang: uses #!/usr/bin/env bash\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] shebang: expected #!/usr/bin/env bash, got: %s\n' "$(head -1 "$script")"
  fail=$(( fail + 1 ))
fi

if grep -qF 'set -euo pipefail' "$script"; then
  printf '[PASS] safety-flags: set -euo pipefail is present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] safety-flags: set -euo pipefail is missing\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no backtick command substitution
# ---------------------------------------------------------------------------

printf '\n=== static: no backtick substitution ===\n'
backtick_count="$(grep -c '`' "$script" || true)"
if [[ "$backtick_count" -eq 0 ]]; then
  printf '[PASS] no-backticks: command substitution uses dollar-paren form\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] no-backticks: found %d backtick(s) — use dollar-paren form instead\n' "$backtick_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: PR lookup uses 'gh pr list --head' not 'gh pr view <branch>'
# ---------------------------------------------------------------------------
# 'gh pr view <branch>' silently returns NOT_FOUND for branch names containing
# slashes (Graphite-style stacked branch names like "stack/fix-foo"). Using
# 'gh pr list --head <branch> --state all' is unambiguous and handles slashes.

printf '\n=== static: PR lookup uses gh pr list --head ===\n'
if grep -qF 'gh pr view' "$script"; then
  printf '[FAIL] pr-lookup: script uses gh pr view — replace with gh pr list --head --state all\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] pr-lookup: script uses gh pr list --head (no gh pr view)\n'
  pass=$(( pass + 1 ))
fi

# We should print PR numbers when present, so keep querying for number as well as state.
printf '\n=== static: PR query includes number ===\n'
if grep -qF -- '--json number,state' "$script"; then
  printf '[PASS] pr-query-number: gh pr list includes --json number,state\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-query-number: expected gh pr list to include --json number,state\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: output includes PR number formatting ===\n'
if grep -qF -- "(#\${pr_number})" "$script" || grep -qF -- "(#\${orphan_number})" "$script"; then
  printf '[PASS] pr-number-format: output includes (#<number>) formatting\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-number-format: expected output to include (#<number>) formatting\n'
  fail=$(( fail + 1 ))
fi

# gt sync --delete-all triggers GitHub API lookups for every branch; the script
# already handles branch cleanup manually, so --delete-all is never needed here.
printf '\n=== static: gt sync does not use --delete-all ===\n'
if grep -qE 'gt sync.*(--delete-all|-d\b)' "$script"; then
  printf '[FAIL] gt-sync-delete-all: gt sync uses --delete-all/-d; remove it (script prunes branches manually)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] gt-sync-delete-all: gt sync does not use --delete-all/-d\n'
  pass=$(( pass + 1 ))
fi

# After pulling main, a raw systemctl restart must not be issued — on-deploy (via
# setup-service) owns the restart decision so that build steps (migrations, asset
# builds) always run before the service is started with new code.
printf '\n=== static: no raw restart after pull ===\n'
# Look for systemctl restart inside the block that follows the merge --ff-only line.
# We check that the only systemctl restart calls appear inside the --refresh block
# (after "setup-service") and not as a direct consequence of the pull.
if awk '
  /merge --ff-only/ { in_pull=1 }
  in_pull && /systemctl.*restart/ { found=1; exit }
  /setup-service/ { in_pull=0 }
  END { exit !found }
' "$script"; then
  printf '[FAIL] no-raw-restart-after-pull: raw systemctl restart found after pull; let setup-service/on-deploy decide\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] no-raw-restart-after-pull: no raw systemctl restart immediately after pull\n'
  pass=$(( pass + 1 ))
fi

# setup-service must be resolved relative to BASH_SOURCE[0], not $main_repo.
# When start-development is called from a different repo (e.g. my-tracks),
# $main_repo points to that repo — not repository-helpers — so
# "$main_repo/scripts/setup-service" would not exist and the --refresh path
# would fall through to a bare systemctl start (skipping on-deploy / build steps).
printf '\n=== static: setup-service resolved via BASH_SOURCE[0] ===\n'
if grep -q 'BASH_SOURCE\[0\]' "$script" && grep -q 'setup_service=' "$script"; then
  printf '[PASS] setup-service: resolved via BASH_SOURCE[0] (not hardcoded to main_repo)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] setup-service: not resolved via BASH_SOURCE[0] — will break when called from another repo\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: dep-updates/* branches with no PR are deleted (not kept)
# ---------------------------------------------------------------------------
# machine-generated dep-updates/* branches are always paired with a PR.
# An unsubmitted branch (no PR, not merged) must be deleted so stale branches
# from interrupted dep-updater runs don't accumulate.

printf '\n=== static: dep-updates/* no-PR branches are deleted ===\n'
if grep -qF "dep-updates/*" "$script" && grep -qF "machine-generated dep-updates branch" "$script"; then
  printf '[PASS] dep-updates-no-pr: dep-updates/* branches with no PR are deleted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updates-no-pr: missing deletion logic for dep-updates/* branches with no PR\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
