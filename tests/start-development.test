#!/usr/bin/env bash
# Smoke tests for scripts/dev/start-development.
#
# start-development interacts with git remotes, gh, gt, and systemd — full
# integration tests are not feasible in CI. These tests cover:
#   1. --help exits 0 and prints expected content.
#   2. Unknown argument exits non-zero with an informative message.
#   3. Static analysis: no 'local -r' inside loop bodies.
#   4. Static analysis: shebang is '#!/usr/bin/env bash'.
#   5. Static analysis: 'set -euo pipefail' is present.
#   6. Static analysis: script uses $() not backticks for command substitution.
#   7. Static analysis: prerequisites (timeout_cmd, gh, ERROR lines) before session work.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/dev/start-development"
readonly script

pass=0
fail=0

# ---------------------------------------------------------------------------
# Test: --help
# ---------------------------------------------------------------------------

printf '\n=== --help ===\n'
help_output=""
help_exit=0
help_output="$(bash "$script" --help 2>&1)" || help_exit=$?

assert_exit_0   "--help" "$help_output" "$help_exit"
assert_contains "--help" "$help_output" "Usage:"
assert_contains "--help" "$help_output" "--refresh"
assert_contains "--help" "$help_output" "--resume"
assert_contains "--help" "$help_output" "--no-interactive"
assert_contains "--help" "$help_output" "--worktree"
assert_contains "--help" "$help_output" "--strict-lockfiles"

# ---------------------------------------------------------------------------
# Test: unknown argument
# ---------------------------------------------------------------------------

printf '\n=== unknown argument ===\n'
unknown_output=""
unknown_exit=0
unknown_output="$(bash "$script" --not-a-real-argument 2>&1)" || unknown_exit=$?

assert_exit_nonzero "unknown argument" "$unknown_output" "$unknown_exit"
assert_contains     "unknown argument" "$unknown_output" "Unknown argument"

# ---------------------------------------------------------------------------
# Test: --no-interactive fails fast without --worktree
# ---------------------------------------------------------------------------
#
# In CI we must avoid network / side-effectful operations. --no-interactive with no
# --worktree should exit before doing any git/gh/gt work.

printf '\n=== --no-interactive requires --worktree ===\n'
noninteractive_output=""
noninteractive_exit=0
noninteractive_output="$(bash "$script" --no-interactive 2>&1)" || noninteractive_exit=$?

assert_exit_nonzero "--no-interactive missing --worktree" "$noninteractive_output" "$noninteractive_exit"
assert_contains     "--no-interactive missing --worktree" "$noninteractive_output" "No stack name provided (--worktree <name>)"

# ---------------------------------------------------------------------------
# Static: prerequisites before session work (one check)
# ---------------------------------------------------------------------------

printf '\n=== static: prerequisites before session work ===\n'
readonly_line="$(grep -n '^readonly timeout_cmd$' "$script" | head -1 | cut -d: -f1)"
first_sep_line="$(grep -n '^echo "=========================================="$' "$script" | head -1 | cut -d: -f1)"
report_line="$(grep -n 'tooling_prereq_report_finish' "$script" | head -1 | cut -d: -f1)"
if [[ -n "$readonly_line" && -n "$first_sep_line" && -n "$report_line" ]] \
  && [[ "$readonly_line" =~ ^[0-9]+$ && "$first_sep_line" =~ ^[0-9]+$ && "$report_line" =~ ^[0-9]+$ ]] \
  && (( report_line < readonly_line && readonly_line < first_sep_line )) \
  && grep -qF 'tooling_prereq_report_note_any' "$script" \
  && grep -qF 'tooling_prereq_collect_gnu_userland' "$script" \
  && grep -qF 'runner_exec_stdout "start-development gh pr list"' "$script" \
  && grep -qF 'runner_exec_stdout "start-development gt info"' "$script" \
  && ! grep -qF 'ERROR: Missing prerequisite: neither timeout(1) nor gtimeout(1) on PATH' "$script"; then
  printf '[PASS] prereq-static: consolidated report + timeout_cmd precede session banner\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereq-static: expected shared prereq report before session banner\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no 'local -r' inside loop bodies
# ---------------------------------------------------------------------------

printf '\n=== static: local -r in loops ===\n'
local_r_in_loops="$(awk '
  /^[[:space:]]*(while|for|until)[[:space:]]/ { depth++ }
  /^[[:space:]]*done\b/ { if (depth > 0) depth-- }
  /^}/ { depth=0 }
  /[[:space:]]local[[:space:]]+-[a-zA-Z]*r/ && depth > 0 { print NR": "$0 }
' "$script")"
if [[ -n "$local_r_in_loops" ]]; then
  printf '[FAIL] local-r-in-loops: local -r inside a loop body crashes on 2nd iteration:\n%s\n' \
    "$local_r_in_loops"
  fail=$(( fail + 1 ))
else
  printf '[PASS] local-r-in-loops: no local -r declarations inside loops\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: shebang and safety flags
# ---------------------------------------------------------------------------

printf '\n=== static: shebang and safety flags ===\n'

if head -1 "$script" | grep -qF '#!/usr/bin/env bash'; then
  printf '[PASS] shebang: uses #!/usr/bin/env bash\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] shebang: expected #!/usr/bin/env bash, got: %s\n' "$(head -1 "$script")"
  fail=$(( fail + 1 ))
fi

if grep -qF 'set -euo pipefail' "$script"; then
  printf '[PASS] safety-flags: set -euo pipefail is present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] safety-flags: set -euo pipefail is missing\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no backtick command substitution
# ---------------------------------------------------------------------------

printf '\n=== static: no backtick substitution ===\n'
backtick_count="$(grep -c '`' "$script" || true)"
if [[ "$backtick_count" -eq 0 ]]; then
  printf '[PASS] no-backticks: command substitution uses dollar-paren form\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] no-backticks: found %d backtick(s) — use dollar-paren form instead\n' "$backtick_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: PR lookup uses 'gh pr list --head' not 'gh pr view <branch>'
# ---------------------------------------------------------------------------
# 'gh pr view <branch>' silently returns NOT_FOUND for branch names containing
# slashes (Graphite-style stacked branch names like "stack/fix-foo"). Using
# 'gh pr list --head <branch> --state all' is unambiguous and handles slashes.

printf '\n=== static: PR lookup uses gh pr list --head ===\n'
if grep -qF 'gh pr view' "$script"; then
  printf '[FAIL] pr-lookup: script uses gh pr view — replace with gh pr list --head --state all\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] pr-lookup: script uses gh pr list --head (no gh pr view)\n'
  pass=$(( pass + 1 ))
fi

# We should query number, state, and mergedAt (mergedAt is the authoritative merge signal).
printf '\n=== static: PR query includes number and mergedAt ===\n'
if grep -qF -- '--json number,state,mergedAt' "$script"; then
  printf '[PASS] pr-query-number: gh pr list includes --json number,state,mergedAt\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-query-number: expected gh pr list to include --json number,state,mergedAt\n'
  fail=$(( fail + 1 ))
fi

# mergedAt must be used to promote state to MERGED so stale OPEN from API cache is corrected.
printf '\n=== static: PR query uses mergedAt to detect merged PRs ===\n'
if grep -qF '.mergedAt' "$script"; then
  printf '[PASS] pr-mergedat: gh_pr_info uses mergedAt field\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-mergedat: gh_pr_info does not use mergedAt — stale OPEN state will not be corrected\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: output includes PR number formatting ===\n'
if grep -qF -- "(#\${pr_number})" "$script" || grep -qF -- "(#\${orphan_number})" "$script"; then
  printf '[PASS] pr-number-format: output includes (#<number>) formatting\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-number-format: expected output to include (#<number>) formatting\n'
  fail=$(( fail + 1 ))
fi

# gt sync --delete-all triggers GitHub API lookups for every branch; the script
# already handles branch cleanup manually, so --delete-all is never needed here.
printf '\n=== static: gt sync does not use --delete-all ===\n'
if grep -qE 'gt sync.*(--delete-all|-d\b)' "$script"; then
  printf '[FAIL] gt-sync-delete-all: gt sync uses --delete-all/-d; remove it (script prunes branches manually)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] gt-sync-delete-all: gt sync does not use --delete-all/-d\n'
  pass=$(( pass + 1 ))
fi

# After pulling main, a raw systemctl restart must not be issued — on-deploy (via
# setup-service) owns the restart decision so that build steps (migrations, asset
# builds) always run before the service is started with new code.
printf '\n=== static: no raw restart after pull ===\n'
# Look for systemctl restart inside the block that follows the merge --ff-only line.
# We check that the only systemctl restart calls appear inside the --refresh block
# (after "setup-service") and not as a direct consequence of the pull.
if awk '
  /merge --ff-only/ { in_pull=1 }
  in_pull && /systemctl.*restart/ { found=1; exit }
  /setup-service/ { in_pull=0 }
  END { exit !found }
' "$script"; then
  printf '[FAIL] no-raw-restart-after-pull: raw systemctl restart found after pull; let setup-service/on-deploy decide\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] no-raw-restart-after-pull: no raw systemctl restart immediately after pull\n'
  pass=$(( pass + 1 ))
fi

# setup-service must be resolved relative to BASH_SOURCE[0], not $main_repo.
# When start-development is called from a different repo (e.g. my-tracks),
# $main_repo points to that repo — not repository-helpers — so
# "$main_repo/scripts/setup-service" would not exist and the --refresh path
# would fall through to a bare systemctl start (skipping on-deploy / build steps).
printf '\n=== static: setup-service resolved via BASH_SOURCE[0] ===\n'
if grep -q 'BASH_SOURCE\[0\]' "$script" && grep -q 'setup_service=' "$script"; then
  printf '[PASS] setup-service: resolved via BASH_SOURCE[0] (not hardcoded to main_repo)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] setup-service: not resolved via BASH_SOURCE[0] — will break when called from another repo\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: refresh auto-fixes lockfile drift via setup-service ===\n'
if grep -qF 'setup_service_args=(--fix-lockfiles)' "$script" \
  && grep -qF 'setup_service_args+=(--strict-lockfiles)' "$script"; then
  printf '[PASS] refresh-lockfiles: refresh passes --fix-lockfiles to setup-service\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] refresh-lockfiles: expected refresh to pass --fix-lockfiles to setup-service\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: dep-updates/* branches with no PR are deleted (not kept)
# ---------------------------------------------------------------------------
# machine-generated dep-updates/* branches are always paired with a PR.
# An unsubmitted branch (no PR, not merged) must be deleted so stale branches
# from interrupted dep-updater runs don't accumulate.

printf '\n=== static: dep-updates/* no-PR branches are deleted ===\n'
if grep -qF "dep-updates/*" "$script" && grep -qF "machine-generated dep-updates branch" "$script"; then
  printf '[PASS] dep-updates-no-pr: dep-updates/* branches with no PR are deleted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep-updates-no-pr: missing deletion logic for dep-updates/* branches with no PR\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: worktree post-sync merged cleanup after session sync ===\n'
if grep -qF 'Re-checking worktrees after session sync' "$script" \
  && grep -qF 'post_sync_merged_only' "$script"; then
  printf '[PASS] post-sync-wt: re-checks worktrees after session sync for merged PRs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] post-sync-wt: missing post-session-sync merged worktree pass\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: open PR prints GitHub and Graphite URLs ===\n'
if grep -qF 'app.graphite.com/github/pr' "$script" \
  && grep -qF 'print_pr_urls_github_graphite' "$script" \
  && awk '/^print_pr_urls_github_graphite\(\)/,/^}/' "$script" \
    | grep -qF 'start_dev_consult_graphite_for_pr_state'; then
  printf '[PASS] pr-urls: GitHub URL always; Graphite URL when Graphite is in use\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-urls: expected Graphite/GitHub URL helpers gated on stacking tool\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: stale no-PR worktrees use 12h threshold ===\n'
if grep -qF '12 * 60 * 60' "$script" && grep -qF 'secondary_worktree_head_epoch' "$script"; then
  printf '[PASS] stale-wt: stale no-PR worktree removal uses 12h HEAD age\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stale-wt: missing 12h stale worktree logic\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: merge detection prefers Graphite gt info over GitHub ===\n'
if grep -qF 'resolve_pr_state_for_branch' "$script" \
  && grep -qF 'start_dev_consult_graphite_for_pr_state' "$script" \
  && grep -qF 'gt info --branch' "$script" \
  && grep -qF 'Graphite is authoritative for' "$script"; then
  printf '[PASS] graphite-merge: resolve_pr_state_for_branch consults gt info before gh when Graphite\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] graphite-merge: missing Graphite-first PR resolution\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: gh-stack skips gt info for PR state ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'start_dev_consult_graphite_for_pr_state' "$script" \
  && grep -qF 'stacking_tool_value_gh_stack' "$script" \
  && awk '/^start_dev_consult_graphite_for_pr_state\(\)/,/^}/' "$script" \
    | grep -qF 'stacking_tool_value_gh_stack' \
  && awk '/^start_dev_consult_graphite_for_pr_state\(\)/,/^}/' "$script" \
    | grep -qF 'start_dev_stacking_tool_value' \
  && awk '/^resolve_pr_state_for_branch\(\)/,/^}/' "$script" \
    | grep -qF 'start_dev_consult_graphite_for_pr_state'; then
  printf '[PASS] gh-stack-skip-gt: resolve_pr_state skips gt info when marker is gh-stack\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-stack-skip-gt: missing stacking-tool gate before gt info\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: squash-merged orphan branches use git cherry ===\n'
if grep -qF 'branch_patch_already_on_main' "$script" \
  && grep -qF 'cherry -v main' "$script" \
  && grep -qF 'merge-base --is-ancestor' "$script" \
  && grep -qF 'patch content already on main' "$script"; then
  printf '[PASS] squash-orphan: orphan branches delete when patch is already on main\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] squash-orphan: missing git cherry / ancestor orphan-branch cleanup\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: expected-nonzero git probes use runner --probe ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'sd_runner_git_c <repo> <label> [--probe] [--timeout SECONDS]' "$script" \
  && grep -qF 'exec_opts+=(--probe)' "$script" \
  && grep -qF 'start-development merge-base ancestor" --probe' "$script" \
  && grep -qF 'start-development show-ref branch" --probe' "$script"; then
  printf '[PASS] git-probes: merge-base ancestor and show-ref use runner --probe\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] git-probes: expected --probe on merge-base ancestor and show-ref checks\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: merge-queue staging branches with no PR are deleted ===\n'
if grep -qF 'pr-[0-9]+-merge' "$script" \
  && grep -qF 'merge-queue staging branch' "$script"; then
  printf '[PASS] mq-staging: pr-N-merge branches with no PR are deleted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mq-staging: missing pr-N-merge orphan-branch cleanup\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: start-development runner adoption ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'lib/runner-bootstrap' "$script" \
  && grep -qF 'sd_runner_git_c_stdout()' "$script" \
  && grep -qF 'runner_exec_stdout "start-development gh pr list"' "$script" \
  && grep -qF 'stacking_tool_session_sync_as' "$script" \
  && grep -qF 'stacking_tool_read_or_org_default' "$script" \
  && ! grep -qF 'runner_sh "start-development gt sync"' "$script"; then
  printf '[PASS] start-development: git/gh via runner helpers; session sync via stacking-tool\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] start-development: missing runner adoption / org-default session sync wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: fetch origin main uses runner --timeout ===\n'
# shellcheck disable=SC2016  # match literal $timeout_sec in source under test
if grep -qF 'start-development fetch origin main" --timeout 20' "$script" \
  && grep -qF 'exec_opts+=(--timeout "$timeout_sec")' "$script" \
  && grep -qF 'runner_validate_timeout_sec "sd_runner_git_c"' "$script"; then
  printf '[PASS] fetch-timeout: origin/main fetch and sd_runner_git_c accept --timeout\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] fetch-timeout: missing --timeout on fetch origin main / sd_runner_git_c\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: resilient worktree directory removal ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'force_remove_directory()' "$script" \
  && grep -qF 'sd_absolutize_path()' "$script" \
  && grep -qF 'sd_free_worktree_path_holders()' "$script" \
  && grep -qF 'sd_path_is_under_prefix()' "$script" \
  && grep -qF 'chmod -R u+w' "$script" \
  && grep -qF '/proc/[0-9]*' "$script" \
  && awk '/^remove_secondary_worktree\(\)/,/^}/' "$script" | grep -qF 'force_remove_directory "$path"'; then
  printf '[PASS] force-remove-dir: retry chmod/rm with /proc holder release wired into remove_secondary_worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] force-remove-dir: missing force_remove_directory helper or wiring in remove_secondary_worktree\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
