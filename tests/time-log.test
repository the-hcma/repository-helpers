#!/usr/bin/env bash
# Tests for scripts/lib/time-log shared helpers.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"

lib="${script_dir}/../scripts/lib/time-log"
readonly lib

test_init

printf '\n=== static: time-log implementation ===\n'
lib_text="$(cat "$lib")"

assert_not_contains "does not rely on date %3N" "$lib_text" "date '+%H:%M:%S.%3N'"
assert_contains "uses EPOCHREALTIME for millis" "$lib_text" "EPOCHREALTIME"
assert_contains "includes calendar date in timestamp" "$lib_text" "%Y-%m-%d"
assert_contains "includes timezone offset in timestamp" "$lib_text" "%z"
assert_contains "exports warning text" "$lib_text" "Falling back to UTC timestamps"
assert_contains "time_log_date_utc prefers date -u" "$lib_text" "date -u \"+\${fmt}\""
assert_contains "time_log_iso8601_utc_to_epoch supports BSD date -j" "$lib_text" "date -j -u -f"
# shellcheck disable=SC2016  # assert matches literal ${epoch} in source
assert_contains "time_log_epoch_to_iso8601_utc supports BSD date -r" "$lib_text" 'date -u -r "${epoch}"'

printf '\n=== behavioural: time_log_date_utc on macOS/GNU ===\n'
# shellcheck source=/dev/null
source "$lib"
utc_compact="$(time_log_date_utc '%Y%m%dT%H%M%S')"
if [[ "$utc_compact" =~ ^[0-9]{8}T[0-9]{6}$ ]]; then
  pass_case "time_log_date_utc compact format"
else
  printf '[FAIL] time_log_date_utc compact format: "%s"\n' "$utc_compact"
  fail=$(( fail + 1 ))
fi
epoch_now="$(time_log_now_utc_epoch)"
if [[ "$epoch_now" =~ ^[0-9]+$ ]]; then
  pass_case "time_log_now_utc_epoch returns digits"
else
  printf '[FAIL] time_log_now_utc_epoch: "%s"\n' "$epoch_now"
  fail=$(( fail + 1 ))
fi
parsed="$(time_log_iso8601_utc_to_epoch '2026-05-20T12:00:00.000Z' || true)"
if [[ "$parsed" =~ ^[0-9]+$ ]]; then
  pass_case "time_log_iso8601_utc_to_epoch parses registry timestamp"
else
  printf '[FAIL] time_log_iso8601_utc_to_epoch: "%s"\n' "$parsed"
  fail=$(( fail + 1 ))
fi
iso_from_epoch="$(time_log_epoch_to_iso8601_utc "$parsed" || true)"
if [[ "$iso_from_epoch" == '2026-05-20T12:00:00Z' ]]; then
  pass_case "time_log_epoch_to_iso8601_utc formats epoch as RFC 3339 Z"
else
  printf '[FAIL] time_log_epoch_to_iso8601_utc: "%s"\n' "$iso_from_epoch"
  fail=$(( fail + 1 ))
fi

ts="$(time_log_timestamp)"
if [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}[[:space:]][+-][0-9]{4}$ ]]; then
  pass_case "timestamp matches YYYY-MM-DD HH:MM:SS.mmm ±HHMM"
else
  printf '[FAIL] timestamp format mismatch: "%s"\n' "$ts"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: TZ warning prints once ===\n'
tmp_bin="$(mktemp -d)"
trap 'rm -rf "$tmp_bin"' EXIT

cat >"${tmp_bin}/date" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
fmt="${1:-}"
case "$fmt" in
  '+%Y-%m-%d %H:%M:%S') printf '%s\n' '2026-05-07 12:34:56' ;;
  '+%z')                printf '%s\n' '+0000' ;;
  '+%z %Z')             printf '%s\n' '+0000 UTC' ;;
  *)                    printf '%s\n' 'UNEXPECTED_DATE_FORMAT' ;;
esac
EOF
chmod +x "${tmp_bin}/date"

warn_out="$(
  TZ='EST5EDT' TIME_LOG_ENABLED=1 TIME_LOG_WARN_TZ=1 TIME_LOG_WARN_PREFIX='WARNING:' \
    PATH="${tmp_bin}:${PATH}" \
    bash -c 'source "'"$lib"'"; log "first"; log "second"' 2>&1 >/dev/null
)"

assert_count_equals "warn prints only once (tz treated as utc)" "$warn_out" \
  "Falling back to UTC timestamps." "1"

test_summary

