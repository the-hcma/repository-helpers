#!/usr/bin/env bash
# Shared setup for tests/github-repo-lint-part-*.test (split from the former aa-github-repo-lint.test, #692).
#
# Source this from a part file AFTER defining `script_dir` (the tests/ directory). It defines the
# paths under test (checker, lib, runner_bootstrap, merge_wrapper, templates_dir, rh_root), loads the
# shared assertion + gh-mock fixtures, and exports the GRL_*_B64 fixtures the gh mocks read.
#
# HOW TO ADD A TEST FOR github-repo-lint / repo-practices
#   1. Pick the part file with the fewest/lightest sections (check `bash tests/github-repo-lint-part-N.test`
#      timings, or the "Results" table in docs/ci-timing.md) and add a `=== section ===` there.
#      Each part must stay under ~60s so CI shards stay balanced.
#   2. A section is self-contained: `printf '\n=== kind: what is checked ===\n'`, assertions that print
#      [PASS]/[FAIL] and bump `pass`/`fail`. Create your own temp dirs and clean them up; do not rely on
#      variables set by sections in other parts (parts run in separate processes, in parallel).
#   3. Need a new fixture or helper shared by several parts? Put it in tests/lib/ (not in one part).
#   4. Do not add a new part just to avoid editing an existing one; add a part only when every part is at
#      the time budget, then name it tests/github-repo-lint-part-<N+1>.test with the same four-line header.
#   5. The CI matrix and pre-pr-checks discover tests/*.test by file, so a new file is picked up
#      automatically. Keep tests deterministic (no real network, no sleep for timing).

# shellcheck disable=SC2034  # variables are consumed by the part files that source this file
rh_root="${script_dir}/.."
readonly rh_root

checker="${rh_root}/scripts/github-repo-lint"
lib="${rh_root}/scripts/lib/repo-practices"
runner_bootstrap="${rh_root}/scripts/lib/runner-bootstrap"
merge_wrapper="${rh_root}/scripts/check-merge-settings"
templates_dir="${rh_root}/scripts/lib/repo-practices-workflows"
readonly checker lib runner_bootstrap merge_wrapper templates_dir

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
# shellcheck source=tests/lib/github-repo-lint-ci-mocks
source "${script_dir}/lib/github-repo-lint-ci-mocks"
grl_test_ci_secret_scan_init "$rh_root"
export GRL_LOCAL_B64="${grl_mock_pr_ship_rule_local_b64}"
export GRL_CONSUMER_B64="${grl_mock_pr_ship_rule_consumer_b64}"
export GRL_STACKING_MARKER_GRAPHITE_B64="${grl_mock_stacking_marker_graphite_b64}"
export GRL_STACKING_MARKER_GH_STACK_B64="${grl_mock_stacking_marker_gh_stack_b64}"
export GRL_STACKING_RULE_LOCAL_B64="${grl_mock_stacking_rule_local_b64}"
export GRL_STACKING_RULE_CONSUMER_B64="${grl_mock_stacking_rule_consumer_b64}"
export GRL_READ_AGENTS_B64="${grl_mock_read_agents_and_rules_b64}"
export GRL_GIT_COMMIT_IDENTITY_B64="${grl_mock_git_commit_identity_b64}"
export GRL_NO_SECRET_EXPOSURE_B64="${grl_mock_no_secret_exposure_b64}"
export GRL_REMOTE_TIMEOUTS_RETRIES_B64="${grl_mock_remote_timeouts_retries_b64}"
export GRL_RP_AFTER_CONFIG_B64="${grl_mock_repo_practices_after_config_b64}"
export GRL_PRE_PR_CHECKS_B64="${grl_mock_pre_pr_checks_b64}"
export GRL_PR_SHIP_SHIM_B64="${grl_mock_pr_ship_shim_b64}"
export GRL_STACKING_RULE_SHIM_B64="${grl_mock_stacking_rule_shim_b64}"
export GRL_READ_AGENTS_SHIM_B64="${grl_mock_read_agents_and_rules_shim_b64}"
export GRL_GIT_COMMIT_IDENTITY_SHIM_B64="${grl_mock_git_commit_identity_shim_b64}"
export GRL_NO_SECRET_EXPOSURE_SHIM_B64="${grl_mock_no_secret_exposure_shim_b64}"
export GRL_REMOTE_TIMEOUTS_RETRIES_SHIM_B64="${grl_mock_remote_timeouts_retries_shim_b64}"
export GRL_PRE_PR_CHECKS_SHIM_B64="${grl_mock_pre_pr_checks_shim_b64}"
export GRL_RP_AFTER_CONFIG_SHIM_B64="${grl_mock_repo_practices_after_config_shim_b64}"
export GRL_GITHUB_API_THROTTLE_B64="${grl_mock_github_api_throttle_b64}"
export GRL_GITHUB_API_THROTTLE_SHIM_B64="${grl_mock_github_api_throttle_shim_b64}"
export GRL_GITHUB_CONTENT_FORMATTING_B64="${grl_mock_github_content_formatting_b64}"
export GRL_GITHUB_CONTENT_FORMATTING_SHIM_B64="${grl_mock_github_content_formatting_shim_b64}"

pass=0
