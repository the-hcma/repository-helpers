#!/usr/bin/env bash
# grep_q_all — `grep -q` for the end of a pipeline, safe under `set -o pipefail` (#803).
#
# `cmd | grep -q PATTERN` exits as soon as grep matches. If cmd is still writing, it dies of SIGPIPE
# and pipefail then reports the whole pipeline as failed although the text matched, which showed up
# as an intermittent test failure under load. This helper reads all of stdin into a temp file first,
# so the upstream command always finishes, then runs `grep -q` on that file: the input reaches grep
# byte for byte, so empty input and trailing blank lines behave exactly as with a plain pipe.
# Only for a grep that reads stdin; with a file operand use `grep -q` directly. Arguments go to grep.
#
# Usage: some_command | grep_q_all [-F|-E|-i|…] PATTERN
grep_q_all() {
  local input_file rc=0

  input_file="$(mktemp)"
  cat >"$input_file"
  grep -q "$@" <"$input_file" || rc=$?
  rm -f "$input_file"
  return "$rc"
}
