#!/usr/bin/env bash
# Shared assertion helpers for tests/*.
set -euo pipefail

# Tests never share the host pacing state or wait on it (tests/github-api-pacing.test opts in).
: "${GITHUB_API_PACING:=0}"
export GITHUB_API_PACING

# test_init resets counters used by pass_case/fail_case.
test_init() {
  pass=0
  fail=0
}

pass_case() {
  printf '[PASS] %s\n' "$1"
  pass=$(( pass + 1 ))
}

fail_case() {
  printf '[FAIL] %s\n' "$1"
  fail=$(( fail + 1 ))
}

assert_contains() {
  local -r label="$1"
  local -r haystack="$2"
  local -r needle="$3"
  # Prefer a here-string over printf|grep -q: under set -o pipefail, grep -q can
  # exit early on a match and SIGPIPE the writer, falsely failing the assert.
  if grep -qF -- "$needle" <<<"$haystack"; then
    pass_case "$label"
  else
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  fi
}

# rp_assert_no_hardcoded_consumer_repo_names <lib-path>
# Return 0 when lib has no org/slug literals for repos other than rp_THIS_REPO_NAME.
rp_assert_no_hardcoded_consumer_repo_names() {
  local -r lib_path="$1"
  local org this_repo violations

  org="$(awk -F"'" '/^rp_DEFAULT_ORG=/ { print $2; exit }' "$lib_path")"
  this_repo="$(awk -F"'" '/^rp_THIS_REPO_NAME=/ { print $2; exit }' "$lib_path")"

  violations="$(
    {
      grep -nE "${org}/[a-z0-9-]+" "$lib_path" | grep -vF "${org}/${this_repo}" || true
      grep -nE '\(see [a-z][a-z0-9-]+ and ' "$lib_path" || true
      grep -nF "from ${this_repo}" "$lib_path" | grep -v 'rp_THIS_REPO_NAME=' || true
      grep -nF "merge ${this_repo}," "$lib_path" || true
      grep -nF "merge the ${this_repo} PR" "$lib_path" || true
    } | sed '/^$/d'
  )"

  if [[ -z "$violations" ]]; then
    return 0
  fi
  printf '%s\n' "$violations" >&2
  return 1
}

assert_not_contains() {
  local -r label="$1"
  local -r haystack="$2"
  local -r needle="$3"
  if grep -qF -- "$needle" <<<"$haystack"; then
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  else
    pass_case "$label"
  fi
}

assert_exit_0() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -eq 0 ]]; then
    pass_case "${label}: exits 0"
  else
    printf '[FAIL] %s: expected exit 0, got %d\n' "$label" "$exit_code" >&2
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$output" >&2
    printf '%s\n' '--------------' >&2
    fail=$(( fail + 1 ))
  fi
}

assert_exit_nonzero() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -ne 0 ]]; then
    pass_case "${label}: exits non-zero (${exit_code})"
  else
    printf '[FAIL] %s: expected non-zero exit, got 0\n' "$label" >&2
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$output" >&2
    printf '%s\n' '--------------' >&2
    fail=$(( fail + 1 ))
  fi
}

assert_count_equals() {
  # Args: label haystack needle expected_count
  local -r label="$1"
  local -r haystack="$2"
  local -r needle="$3"
  local -r expected="$4"
  local count
  count="$(printf '%s' "$haystack" | grep -cF -- "$needle" || true)"
  if [[ "$count" == "$expected" ]]; then
    pass_case "$label"
  else
    printf '[FAIL] %s: expected count=%s, got=%s for needle "%s"\n' \
      "$label" "$expected" "$count" "$needle" >&2
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  fi
}

test_summary() {
  printf '\n--- results: %s passed, %s failed ---\n' "$pass" "$fail"
  if (( fail > 0 )); then
    exit 1
  fi
}

# Resolve the real jq once, at source time, before any test prepends a mock bin to PATH.
test_real_jq="$(command -v jq || true)"
readonly test_real_jq

# real_jq_path prints the jq resolved at source time.
real_jq_path() {
  printf '%s\n' "$test_real_jq"
}

# write_mock_jq_passthrough <mock_bin_dir>
# Writes an executable `jq` into the mock bin that execs the host's real jq, so tests that
# narrow or shadow PATH still resolve jq wherever it is installed (never hardcode /usr/bin/jq).
write_mock_jq_passthrough() {
  local -r dir="$1"
  if [[ -z "$test_real_jq" ]]; then
    printf 'write_mock_jq_passthrough: jq not found on PATH\n' >&2
    return 1
  fi
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$test_real_jq" >"${dir}/jq"
  chmod +x "${dir}/jq"
}

# assert_no_hardcoded_system_jq <tests-dir>
# Fails when any test (or lib) hardcodes an absolute system jq path (/usr/bin, /usr/local/bin,
# /opt/homebrew/bin); jq lives in different places per host.
assert_no_hardcoded_system_jq() {
  local -r dir="$1"
  local hits
  hits="$(grep -rnE --exclude=test-assert '/(usr(/local)?|opt/homebrew)/bin/jq' "$dir" || true)"
  if [[ -z "$hits" ]]; then
    pass_case "no test hardcodes /usr/bin/jq"
  else
    fail_case "no test hardcodes /usr/bin/jq"
    printf '%s\n' "$hits" >&2
  fi
}
