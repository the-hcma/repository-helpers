#!/usr/bin/env bash
# Shared assertion helpers for tests/*.
set -euo pipefail

# test_init resets counters used by pass_case/fail_case.
test_init() {
  pass=0
  fail=0
}

pass_case() {
  printf '[PASS] %s\n' "$1"
  pass=$(( pass + 1 ))
}

fail_case() {
  printf '[FAIL] %s\n' "$1"
  fail=$(( fail + 1 ))
}

assert_contains() {
  local -r label="$1"
  local -r haystack="$2"
  local -r needle="$3"
  if printf '%s' "$haystack" | grep -qF -- "$needle"; then
    pass_case "$label"
  else
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  fi
}

# rp_assert_no_hardcoded_consumer_repo_names <lib-path>
# Return 0 when lib has no org/slug literals for repos other than rp_THIS_REPO_NAME.
rp_assert_no_hardcoded_consumer_repo_names() {
  local -r lib_path="$1"
  local org this_repo violations

  org="$(awk -F"'" '/^rp_DEFAULT_ORG=/ { print $2; exit }' "$lib_path")"
  this_repo="$(awk -F"'" '/^rp_THIS_REPO_NAME=/ { print $2; exit }' "$lib_path")"

  violations="$(
    {
      grep -nE "${org}/[a-z0-9-]+" "$lib_path" | grep -vF "${org}/${this_repo}" || true
      grep -nE '\(see [a-z][a-z0-9-]+ and ' "$lib_path" || true
      grep -nF "from ${this_repo}" "$lib_path" | grep -v 'rp_THIS_REPO_NAME=' || true
      grep -nF "merge ${this_repo}," "$lib_path" || true
      grep -nF "merge the ${this_repo} PR" "$lib_path" || true
    } | sed '/^$/d'
  )"

  if [[ -z "$violations" ]]; then
    return 0
  fi
  printf '%s\n' "$violations" >&2
  return 1
}

assert_not_contains() {
  local -r label="$1"
  local -r haystack="$2"
  local -r needle="$3"
  if printf '%s' "$haystack" | grep -qF -- "$needle"; then
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  else
    pass_case "$label"
  fi
}

assert_exit_0() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -eq 0 ]]; then
    pass_case "${label}: exits 0"
  else
    printf '[FAIL] %s: expected exit 0, got %d\n' "$label" "$exit_code" >&2
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$output" >&2
    printf '%s\n' '--------------' >&2
    fail=$(( fail + 1 ))
  fi
}

assert_exit_nonzero() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -ne 0 ]]; then
    pass_case "${label}: exits non-zero (${exit_code})"
  else
    printf '[FAIL] %s: expected non-zero exit, got 0\n' "$label" >&2
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$output" >&2
    printf '%s\n' '--------------' >&2
    fail=$(( fail + 1 ))
  fi
}

assert_count_equals() {
  # Args: label haystack needle expected_count
  local -r label="$1"
  local -r haystack="$2"
  local -r needle="$3"
  local -r expected="$4"
  local count
  count="$(printf '%s' "$haystack" | grep -cF -- "$needle" || true)"
  if [[ "$count" == "$expected" ]]; then
    pass_case "$label"
  else
    printf '[FAIL] %s: expected count=%s, got=%s for needle "%s"\n' \
      "$label" "$expected" "$count" "$needle" >&2
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  fi
}

test_summary() {
  printf '\n--- results: %s passed, %s failed ---\n' "$pass" "$fail"
  if (( fail > 0 )); then
    exit 1
  fi
}

