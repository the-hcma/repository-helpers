grl_test_stacking_tool_fixtures_init() {
  local local_rule consumer_rule read_agents_rule rp_after_config_rule

  grl_mock_stacking_marker_graphite_b64="$(printf '%s' 'graphite' | base64 -w0)"
  grl_mock_stacking_marker_gh_stack_b64="$(printf '%s' 'gh-stack' | base64 -w0)"
  local_rule="$(cat <<'EOF'
---
description: stacking
alwaysApply: true
---
.github/stacking-tool
graphite
gh-stack
.cursor/skills/graphite/SKILL.md
.cursor/skills/gh-stack/SKILL.md
EOF
)"
  consumer_rule="$(cat <<'EOF'
---
description: stacking
alwaysApply: true
---
.github/stacking-tool
graphite
gh-stack
<!-- stacking-tool-canonical-graphite-skill: https://github.com/the-hcma/repository-helpers/blob/main/.cursor/skills/graphite/SKILL.md -->
<!-- stacking-tool-canonical-gh-stack-skill: https://github.com/the-hcma/repository-helpers/blob/main/.cursor/skills/gh-stack/SKILL.md -->
EOF
)"
  read_agents_rule="$(cat <<'EOF'
---
description: On every new agent session, read AGENTS.md and .cursor/rules before acting
alwaysApply: true
---

# Session start: read AGENTS.md and project rules

At the **start of every new agent session**, read AGENTS.md and .cursor/rules.
EOF
)"
  rp_after_config_rule="$(cat <<'EOF'
---
description: Run github-repo-lint after repo config or workflow changes
alwaysApply: false
---

Run scripts/github-repo-lint --repo OWNER/NAME --suggest --strict-onboarding before submit.
Use --apply-fix for Release Please merge settings.
Copy release-please-uv-lock-extra-files.snippet.json (@.name.value jsonpath).
EOF
)"
  grl_mock_stacking_rule_local_b64="$(printf '%s' "$local_rule" | base64 -w0)"
  grl_mock_stacking_rule_consumer_b64="$(printf '%s' "$consumer_rule" | base64 -w0)"
  grl_mock_read_agents_and_rules_b64="$(printf '%s' "$read_agents_rule" | base64 -w0)"
  grl_mock_repo_practices_after_config_b64="$(printf '%s' "$rp_after_config_rule" | base64 -w0)"
}

# grl_test_gh_mock_stacking_tool <args>
# Prints mock gh api JSON for stacking-tool marker/rule and read-agents-and-rules,
# and returns 0 when handled.
grl_test_gh_mock_stacking_tool() {
  local args="$1"

  if [[ -z "$grl_mock_stacking_marker_graphite_b64" ]]; then
    grl_test_stacking_tool_fixtures_init
  fi

  if [[ "$args" == *'contents/.github/stacking-tool'* ]]; then
    if [[ "$args" == *'repository-helpers'* ]]; then
      printf '%s\n' "{\"content\":\"${grl_mock_stacking_marker_gh_stack_b64}\"}"
    else
      printf '%s\n' "{\"content\":\"${grl_mock_stacking_marker_graphite_b64}\"}"
    fi
    return 0
  fi
  if [[ "$args" == *'stacking-tool.mdc'* ]]; then
    if [[ "$args" == *'repository-helpers'* ]]; then
      printf '%s\n' "{\"content\":\"${grl_mock_stacking_rule_local_b64}\"}"
    else
      printf '%s\n' "{\"content\":\"${grl_mock_stacking_rule_consumer_b64}\"}"
    fi
    return 0
  fi
  if [[ "$args" == *'read-agents-and-rules.mdc'* ]]; then
    printf '%s\n' "{\"content\":\"${grl_mock_read_agents_and_rules_b64}\"}"
    return 0
  fi
  if [[ "$args" == *'repo-practices-after-config-change.mdc'* ]]; then
    printf '%s\n' "{\"content\":\"${grl_mock_repo_practices_after_config_b64}\"}"
    return 0
  fi
  return 1
}

grl_test_ci_secret_scan_init() {
  local repo_helpers_root="$1"
  local grl_templates_dir ci_yaml
  grl_test_stacking_tool_fixtures_init
  grl_templates_dir="${repo_helpers_root}/scripts/lib/repo-practices-workflows"
  ci_yaml="$(cat <<YAML
name: CI
on:
  pull_request:
    types: [opened, reopened, synchronize, ready_for_review, edited]
$(cat "${grl_templates_dir}/ci-push-trigger.snippet"; echo)
$(cat "${grl_templates_dir}/ci-concurrency.snippet"; echo)
jobs:
  guard:
    permissions:
      contents: read
      pull-requests: read
    outputs:
      skip: \${{ steps.set-skip.outputs.skip }}
    steps:
      - id: set-skip
        env:
          GH_TOKEN: \${{ github.token }}
          HEAD_REF: \${{ github.head_ref || github.ref_name }}
        run: |
          if [[ "\$HEAD_REF" == gtmq_merge_* ]]; then
            echo "skip=true" >> "\$GITHUB_OUTPUT"
            exit 0
          fi
$(cat "${grl_templates_dir}/ci-guard-push-dedup.snippet"; echo)          echo "skip=false" >> "\$GITHUB_OUTPUT"
      - run: gtmq_merge_skip
$(cat "${grl_templates_dir}/ci-secret-scan-job.snippet"; echo)
YAML
)"
  grl_test_ci_yml_b64="$(printf '%s' "$ci_yaml" | base64 -w0)"
  grl_test_secret_scan_b64="$(base64 -w0 "${repo_helpers_root}/scripts/lib/ci-secret-scan")"
}

# grl_test_gh_mock_secret_scan_and_ci <args>
# Prints mock gh api JSON/lines and returns 0 when handled.
grl_test_gh_mock_secret_scan_and_ci() {
  local args="$1"

  if [[ "$args" == *'contents/.github/workflows/ci.yml'* ]] \
    || [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
    printf '%s\n' "{\"content\":\"${grl_test_ci_yml_b64}\"}"
    return 0
  fi
  if [[ "$args" == *'contents/.github/ci/secret-scan'* ]]; then
    printf '%s\n' "{\"content\":\"${grl_test_secret_scan_b64}\"}"
    return 0
  fi
  if grl_test_gh_mock_stacking_tool "$args"; then
    return 0
  fi
  if [[ "$args" == *'gitleaks/gitleaks/releases --paginate'* ]]; then
    printf '%s\n' 'v8.30.1'
    return 0
  fi
  if [[ "$args" == *'gitleaks/gitleaks/releases/tags/v8.30.1'* ]]; then
    if [[ "$args" == *'published_at'* ]]; then
      date -u -d '30 days ago' +%Y-%m-%dT%H:%M:%SZ
    elif [[ "$args" == *'assets[].name'* ]]; then
      printf 'gitleaks_8.30.1_linux_x64.tar.gz\n'
    fi
    return 0
  fi
  return 1
}
