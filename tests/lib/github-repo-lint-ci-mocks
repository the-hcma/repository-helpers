# Build a valid Cursor agents-rule-shim body for NAME.
grl_test_cursor_shim_text() {
  local -r name="$1"
  cat <<EOF
---
description: test
alwaysApply: true
---

<!-- agents-rule-shim: ${name} -->
Canonical rule: [\`.agents/rules/${name}.md\`](../../.agents/rules/${name}.md)
EOF
}

grl_test_stacking_tool_fixtures_init() {
  local local_rule consumer_rule read_agents_rule git_commit_identity_rule
  local pre_pr_checks_rule rp_after_config_rule github_api_throttle_rule
  local mocks_dir template_path agents_dir shim_text

  grl_mock_stacking_marker_graphite_b64="$(printf '%s' 'graphite' | base64 -w0)"
  grl_mock_stacking_marker_gh_stack_b64="$(printf '%s' 'gh-stack' | base64 -w0)"
  local_rule="$(cat <<'EOF'
---
description: stacking
alwaysApply: true
---
.github/stacking-tool
graphite
gh-stack
.agents/skills/graphite/SKILL.md
.agents/skills/gh-stack/SKILL.md
EOF
)"
  consumer_rule="$(cat <<'EOF'
---
description: stacking
alwaysApply: true
---
.github/stacking-tool
graphite
gh-stack
<!-- stacking-tool-canonical-graphite-skill: https://github.com/the-hcma/repository-helpers/blob/main/.agents/skills/graphite/SKILL.md -->
<!-- stacking-tool-canonical-gh-stack-skill: https://github.com/the-hcma/repository-helpers/blob/main/.agents/skills/gh-stack/SKILL.md -->
EOF
)"
  read_agents_rule="$(cat <<'EOF'
---
description: On every new agent session, read AGENTS.md and .agents/rules before acting
alwaysApply: true
---

# Session start: read AGENTS.md and project rules

At the **start of every new agent session**, read AGENTS.md and .agents/rules.
EOF
)"
  git_commit_identity_rule="$(cat <<'EOF'
---
description: Commits and PRs attribute only the committer — no agent or machine co-authors
alwaysApply: true
---

# Git commit identity

Do not add Co-authored-by, Made-with: Cursor, or --trailer.
Use git config user.name and user.email.
Survey commit.gpgsign and user.signingkey; alert and surface setup instructions
if signing is missing.
Read ~/.cursor/cli-config.json and alert if attributeCommitsToAgent: false or
attributePRsToAgent: false is missing (both must be false). Surface setup
instructions when attribution is not disabled.
EOF
)"
  # Consumer-shaped fixture (helper-path probe #579).
  pre_pr_checks_rule="$(cat <<'EOF'
---
description: Block PR submit until pre-pr-checks pass; format before check; no truncated gate output
alwaysApply: true
---

# Pre-PR checks (required)

Run "${REPOSITORY_HELPERS_DIR:-$HOME/work/ai/repository-helpers}/scripts/dev/pre-pr-checks"
from the feature worktree (must exit 0).

## Apply formatters before check (required)

"${REPOSITORY_HELPERS_DIR:-$HOME/work/ai/repository-helpers}/scripts/dev/pre-pr-checks" --fix

## No truncated pre-PR output

Do not pipe pre-pr-checks to tail/head.
EOF
)"
  rp_after_config_rule="$(cat <<'EOF'
---
description: Run github-repo-lint after repo config or workflow changes
globs:
  - .agents/rules/**
  - .agents/skills/**
  - .cursor/rules/**
  - .github/**
  - pnpm-workspace.yaml
  - release-please-config.json
  - .release-please-manifest.json
  - scripts/lib/repo-practices-workflows/**
  - web/pnpm-workspace.yaml
alwaysApply: false
---

Run scripts/github-repo-lint --repo OWNER/NAME --suggest --strict-onboarding before submit.
Use --apply-fix for Release Please merge settings.
Copy release-please-uv-lock-extra-files.snippet.json (@.name.value jsonpath).
EOF
)"
  github_api_throttle_rule="$(cat <<'EOF'
---
description: Run agent gh calls through repository-helpers/scripts/gh-api
alwaysApply: true
---

# GitHub API rate-limit throttle

Use "${REPOSITORY_HELPERS_DIR:-$HOME/work/ai/repository-helpers}/scripts/gh-api".

<!-- github-api-throttle-canonical: https://github.com/the-hcma/repository-helpers/blob/main/.agents/rules/github-api-throttle.md -->
Canonical rule: https://github.com/the-hcma/repository-helpers/blob/main/.agents/rules/github-api-throttle.md
EOF
)"
