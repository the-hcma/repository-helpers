# Stacking-tool marker + cursor-rule fixtures (base64 filled by init).
# shellcheck disable=SC2034
grl_mock_stacking_marker_graphite_b64=''
# shellcheck disable=SC2034
grl_mock_stacking_marker_gh_stack_b64=''
# shellcheck disable=SC2034
grl_mock_stacking_rule_local_b64=''
