#!/usr/bin/env bash
# Shared sendmail mock installer for tests that must not send real email.
set -euo pipefail

install_mock_sendmail() {
  # Args:
  #   bin_dir: directory to write sendmail shim into
  #
  # The shim reads stdin and discards it, then exits 0.
  local -r bin_dir="$1"
  mkdir -p "$bin_dir"

  cat >"${bin_dir}/sendmail" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cat >/dev/null
exit 0
EOF
  chmod +x "${bin_dir}/sendmail"
}

