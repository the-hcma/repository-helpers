#!/usr/bin/env bash
# Shared sendmail mock installer for tests that must not send real email.
set -euo pipefail

install_mock_sendmail() {
  # Args:
  #   bin_dir: directory to write sendmail shim into
  #   breadcrumb_file: path to touch when shim runs (optional)
  #
  # The shim reads stdin and discards it, then exits 0.
  local -r bin_dir="$1"
  local -r breadcrumb_file="${2:-}"
  mkdir -p "$bin_dir"

  cat >"${bin_dir}/sendmail" <<EOF
#!/usr/bin/env bash
set -euo pipefail
breadcrumb_file="${breadcrumb_file}"
if [[ -n "\$breadcrumb_file" ]]; then
  : >"\$breadcrumb_file"
fi
cat >/dev/null
exit 0
EOF
  chmod +x "${bin_dir}/sendmail"
}

