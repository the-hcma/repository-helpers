set -euo pipefail
args="$*"

if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi

if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi

if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi

if [[ "$args" == *'contents/.github/workflows' ]]; then
  printf '%s\n' '[{"name":"ci.yml","type":"file"},{"name":"release-please.yml","type":"file"}]'
  exit 0
fi

