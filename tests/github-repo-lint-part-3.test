write_mock_jq_passthrough "${mock_bin}"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/uv-python-missing-cve --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'missing .github/workflows/cve-check.yml for uv Python repos' <<<"$output" \
  && grep -qF 'SUGGEST: the-hcma/uv-python-missing-cve: add .github/workflows/cve-check.yml (canonical template: cve-check.yml)' <<<"$output"; then
  printf '[PASS] cve-check: missing workflow fails with add suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cve-check: expected missing workflow failure + suggestion (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: uv+pyproject requires cve-check.yml workflow (non-canonical) ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

bad_cve_yaml="$(cat <<'BAD_CVE'
name: CVE Check

on:
  schedule:
    - cron: '0 9 * * *'
  workflow_dispatch:
  workflow_call:

permissions:
  contents: read

jobs:
  cve-check:
    name: pip-audit
    runs-on: ubuntu-latest

    steps:
      - name: Set up Python
        run: uv python install 3.14
BAD_CVE
)"
bad_cve_b64="$(printf '%s' "$bad_cve_yaml" | base64 -w0)"
export BAD_CVE_B64="$bad_cve_b64"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"

if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi

