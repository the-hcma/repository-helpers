chmod +x "${mock_bin}/gh"

write_mock_jq_passthrough "${mock_bin}"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/uv-python-noncanonical-cve --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'must match hardened canonical config for uv Python repos' <<<"$output"; then
  printf '[PASS] cve-check: non-canonical workflow fails\n'
  pass=$(( pass + 1 ))
else
