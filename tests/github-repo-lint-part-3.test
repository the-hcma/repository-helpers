#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices — part 3 of 6.
# Split from the former aa-github-repo-lint.test so CI can run the parts in parallel (#692).
# To add a test, read the how-to at the top of tests/lib/github-repo-lint-part-init first.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck source=tests/lib/github-repo-lint-part-init
source "${script_dir}/lib/github-repo-lint-part-init"

pass=0
fail=0

printf '\n=== functional: workflow .yaml extension fails ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows' ]]; then
  printf '%s\n' '[{"name":"ci.yaml","type":"file"},{"name":"release-please.yml","type":"file"}]'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_LOCAL_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/repository-helpers --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'workflow ci.yaml must use the standard .yml extension' <<<"$output" \
  && grep -qF 'rename .github/workflows/ci.yaml to .github/workflows/ci.yml' \
    <<<"$output"; then
  printf '[PASS] workflow-extension: .yaml workflows fail with rename suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] workflow-extension: expected .yaml failure and suggestion (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: uv+pyproject requires cve-check.yml workflow (missing) ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
