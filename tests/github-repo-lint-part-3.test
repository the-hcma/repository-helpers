printf '\n=== unit: release-please uv.lock extra-files helpers (#457) ===\n'
good_rp_config='{
  "packages": {
    ".": {
      "release-type": "python",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='\''example-pkg'\'')].version"
        }
      ]
    }
  }
}'
bad_plain_name_config='{
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='\''example-pkg'\'')].version"
        }
      ]
    }
  }
}'
bad_placeholder_config='{
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='\''<project.name>'\'')].version"
        }
      ]
    }
  }
}'
if bash -c "
  source '${script_dir}/../scripts/lib/runner-bootstrap'
  source '${lib}'
  [[ \"\$(rp_release_please_config_relpath_from_workflow \$'with:\n  config-file: custom-rp.json\n')\" == 'custom-rp.json' ]] \
    && [[ \"\$(rp_release_please_config_relpath_from_workflow 'name: Release Please')\" == 'release-please-config.json' ]] \
    && [[ \"\$(rp_release_please_config_relpath_from_workflow \$'# config-file: stale.json\nwith:\n  config-file: custom-rp.json\n')\" == 'custom-rp.json' ]] \
    && rp_release_please_config_has_uv_lock_extra_files \"\$1\" \
    && ! rp_release_please_config_has_uv_lock_extra_files \"\$2\" \
    && ! rp_release_please_config_has_uv_lock_extra_files \"\$3\" \
    && ! rp_release_please_config_has_uv_lock_extra_files '{\"packages\":{\".\":{\"release-type\":\"python\"}}}'
" _ "$good_rp_config" "$bad_plain_name_config" "$bad_placeholder_config"; then
  printf '[PASS] uv-rp-lock: config path + extra-files predicate helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-rp-lock: expected path default/override and @.name.value vs plain @.name gate\n'
  fail=$(( fail + 1 ))
fi

if bash -c "
  source '${script_dir}/../scripts/lib/runner-bootstrap'
  source '${lib}'
  rp_repo_mentions_uv_lock_version_assert 'run: bash .github/ci/assert-uv-lock-version' \
    && rp_repo_mentions_uv_lock_version_assert 'assert-uv-lock-version' \
    && ! rp_repo_mentions_uv_lock_version_assert '# keep uv.lock in sync with pyproject.toml version'
"; then
  printf '[PASS] uv-rp-lock: assert mention helper requires canonical script name\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-rp-lock: expected assert mention helper to ignore loose uv.lock/pyproject co-mentions\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: uv+Release Please missing uv.lock extra-files fails (#457) ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"

if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi

if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi

if [[ "$args" == *'contents/.github/workflows'* ]] && [[ "$args" != *'/contents/.github/workflows/'* ]]; then
  printf '%s\n' '[{"name":"ci.yml","type":"file"},{"name":"release-please.yml","type":"file"},{"name":"cve-check.yml","type":"file"}]'
  exit 0
fi

if [[ "$args" == *'contents/uv.lock'* ]]; then
  printf '%s\n' '{}'
  exit 0
fi

if [[ "$args" == *'contents/pyproject.toml'* ]]; then
  printf '%s\n' '{}'
  exit 0
fi

if [[ "$args" == *'contents/.github/workflows/release-please.yml'* ]]; then
  # Minimal workflow; default config path release-please-config.json
  body="$(printf '%s\n' 'name: Release Please' 'on: push' 'jobs:' '  release-please:' '    runs-on: ubuntu-latest' '    steps:' '      - uses: googleapis/release-please-action@v5' | base64 -w0)"
  printf '{"content":"%s"}\n' "$body"
  exit 0
fi

if [[ "$args" == *'contents/release-please-config.json'* ]]; then
  exit 1
fi

if [[ "$args" == *'contents/.github/workflows/cve-check.yml'* ]]; then
  # Satisfy CVE check so only the lock-sync failure is asserted.
  body="$(base64 -w0 < "${GRL_CVE_CANONICAL_PATH}")"
  printf '{"content":"%s"}\n' "$body"
  exit 0
fi

if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi

if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi

if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_CONSUMER_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi

if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi

printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

# Canonical-enough cve-check workflow so the CVE check can pass and only the
# lock-sync failure is asserted below.
GRL_CVE_CANONICAL_PATH="${mock_dir}/cve-stub.yml"
export GRL_CVE_CANONICAL_PATH
cat >"$GRL_CVE_CANONICAL_PATH" <<'CVE'
name: CVE check
on:
  schedule:
    - cron: '0 8 * * *'
  workflow_dispatch:
  workflow_call:
permissions:
  contents: read
  issues: write
jobs:
  cve:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
      - run: uv sync --frozen
      - run: |
          rm -f "${audit_json}"
          uv run --no-progress --with pip --with pip-audit pip-audit --skip-editable --format=json
          audit_rc=$?
          if (( audit_rc != 0 && audit_rc != 1 )); then
            echo transient
          fi
          numbers="$(gh issue list --json number --jq '.[].number')" || return 1
      - run: echo cve-check: classify-json-outcome
      - run: jq -e 'type == "object" and (.dependencies | type == "array")'
      - run: jq -e '.dependencies | length > 0'
      - run: jq -e 'has("skip_reason")'
      - run: jq -e 'has("vulns") and (.vulns | type == "array")'
      - run: gh issue create --label security/cve || echo 'ERROR: pip-audit found CVEs but failed to create security/cve issue'
      - run: gh issue comment || echo 'ERROR: pip-audit found CVEs but failed to comment on security/cve issue'
CVE

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/uv-python-missing-rp-lock --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'missing release-please-config.json with uv.lock extra-files for Release Please + uv' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output" \
  && grep -qF 'googleapis/release-please#2561' <<<"$output"; then
  printf '[PASS] uv-rp-lock: missing config fails with #2561 suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-rp-lock: expected missing extra-files failure + suggestion (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: uv Release Please lock sync wiring (#457) ===\n'
# Prefer file-level greps (avoid awk|grep -q under pipefail / SIGPIPE).
# shellcheck disable=SC2016 # intentional literal $slug in source under test
if grep -qF 'rp_check_uv_release_please_lock_sync' "$lib" \
  && awk '/rp_check_one_repo\(/,/^}/' "$lib" | grep -qF 'rp_check_uv_release_please_lock_sync' \
  && grep -qF "rp_gh_path_check \"\$slug\" '.github/workflows/release-please.yml'" "$lib" \
  && grep -qF 'could not detect Release Please workflow' "$lib" \
  && grep -qF 'suggest_probe_uncertain' "$lib" \
  && [[ -f "${templates_dir}/release-please-uv-lock-extra-files.snippet.json" ]] \
  && [[ -f "${templates_dir}/assert-uv-lock-version.snippet" ]]; then
  printf '[PASS] uv-rp-lock: check wired into audit + snippets present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-rp-lock: expected rp_check_uv_release_please_lock_sync wiring and snippets\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: missing workflows directory avoids jq error ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[{"name":"merge-it"}]]'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows' ]] && [[ "$args" != *'/contents/.github/workflows/'* ]]; then
  printf '%s\n' '{"message":"Not Found","documentation_url":"https://docs.github.com/rest/repos/contents#get-repository-content","status":"404"}'
  exit 0
fi
if [[ "$args" == *'contents/'* ]]; then
  exit 1
fi
if [[ "$args" == *'/rulesets'* ]]; then
  exit 1
fi
if [[ "$args" == *'/branches/main/protection'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/empty-repo --suggest 2>&1)"
exit_code=$?
set -e

if ! grep -qF 'Cannot index string with string "type"' <<<"$output" \
  && grep -qF 'workflow file extensions (.yml)' <<<"$output"; then
  printf '[PASS] workflow-listing: API error JSON does not crash jq\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] workflow-listing: expected no jq type error (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: apply-fix emits workflow stack from local clone ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
target_repo="${mock_dir}/target"
target_wt="${target_repo}/.worktrees/repo-practices-candidate-fixes-wt"
gt_log="${mock_dir}/gt.log"
mkdir -p "$mock_bin" "$target_repo"

git -C "$target_repo" init --initial-branch=main -q
git -C "$target_repo" config user.name repo-practices-test
git -C "$target_repo" config user.email repo-practices-test@example.com
printf 'target\n' >"${target_repo}/README.md"
git -C "$target_repo" add README.md
git -C "$target_repo" commit -q -m 'chore: init'
git -C "$target_repo" remote add origin https://github.com/the-hcma/target.git
git -C "$target_repo" update-ref refs/remotes/origin/main HEAD
mkdir -p "${target_repo}/.worktrees"
git -C "$target_repo" worktree add -q "$target_wt" HEAD

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'api repos/the-hcma/target --jq .default_branch'* ]]; then
  printf 'main\n'
  exit 0
fi
if [[ "${1:-}" == 'pr' && "${2:-}" == 'list' ]]; then
  printf '42\n'
  exit 0
fi
if [[ "${1:-}" == 'pr' && "${2:-}" == 'edit' ]]; then
  prev=''
  for a in "$@"; do
    if [[ "$prev" == '--body-file' ]]; then
      cp "$a" "${PR_BODY_FILE:?}"
    fi
    prev="$a"
  done
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/gt" <<'MOCK_GT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s :: %s\n' "$PWD" "$*" >>"${GT_LOG:?}"
MOCK_GT
chmod +x "${mock_bin}/gt"

cat >"${mock_dir}/run-candidate-stack" <<EOF
#!/usr/bin/env bash
set -euo pipefail
# shellcheck disable=SC1091
source "${lib}"
rp_apply_fix=1
rp_queue_candidate_file_fix 'the-hcma/target' \
  '.github/workflows/cleanup-branch-on-merge.yml' \
  "\$(rp_candidate_cleanup_branch_on_merge_workflow)" \
  'add-cleanup-branch-on-merge' \
  'chore: add branch cleanup workflow'
rp_apply_candidate_fix_stack 'the-hcma/target'
EOF
chmod +x "${mock_dir}/run-candidate-stack"

pr_body_file="${mock_dir}/pr_body.txt"
set +e
output="$(
  cd "$target_repo" \
    && PATH="${mock_bin}:${PATH}" GT_LOG="$gt_log" PR_BODY_FILE="$pr_body_file" \
      "${mock_dir}/run-candidate-stack" 2>&1
)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] \
  && [[ -f "${target_wt}/.github/workflows/cleanup-branch-on-merge.yml" ]] \
  && grep -qF 'Delete merged PR branch' \
    "${target_wt}/.github/workflows/cleanup-branch-on-merge.yml" \
  && grep -qF 'track --parent main' "$gt_log" \
  && grep -qF 'submit --publish --no-interactive' "$gt_log" \
  && grep -qF 'created candidate branch repo-practices/add-cleanup-branch-on-merge' \
    <<<"$output" \
  && grep -qF 'Org rollout candidate' "$pr_body_file" \
  && grep -qF 'org-cursor-rule-rollout.md' "$pr_body_file"; then
  printf '[PASS] apply-fix: local clone gets candidate worktree and Graphite stack (ORG_DEFAULT)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] apply-fix: expected candidate worktree stack (exit=%s)\n%s\npr_body:\n%s\n' \
    "$exit_code" "$output" "$(cat "$pr_body_file" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: apply-fix gh-stack path uses gh stack init + submit ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
target_repo="${mock_dir}/target"
target_wt="${target_repo}/.worktrees/repo-practices-candidate-fixes-wt"
gh_log="${mock_dir}/gh.log"
mkdir -p "$mock_bin" "$target_repo"

git -C "$target_repo" init --initial-branch=main -q
git -C "$target_repo" config user.name repo-practices-test
git -C "$target_repo" config user.email repo-practices-test@example.com
printf 'target\n' >"${target_repo}/README.md"
mkdir -p "${target_repo}/.github"
printf 'gh-stack\n' >"${target_repo}/.github/stacking-tool"
git -C "$target_repo" add README.md .github/stacking-tool
git -C "$target_repo" commit -q -m 'chore: init'
git -C "$target_repo" remote add origin https://github.com/the-hcma/target.git
git -C "$target_repo" update-ref refs/remotes/origin/main HEAD
mkdir -p "${target_repo}/.worktrees"
git -C "$target_repo" worktree add -q "$target_wt" HEAD

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
printf '%s :: %s\n' "$PWD" "$*" >>"${GH_LOG:?}"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'api repos/the-hcma/target --jq .default_branch'* ]]; then
  printf 'main\n'
  exit 0
fi
if [[ "$args" == 'stack --help' || "$args" == *'stack --help'* ]]; then
  exit 0
fi
if [[ "$args" == *'stack submit'* ]]; then
  exit 0
fi
if [[ "$args" == *'stack view --json'* ]]; then
  printf '%s\n' '{"trunk":"main","currentBranch":"repo-practices/add-cleanup-branch-on-merge","branches":[{"name":"repo-practices/add-cleanup-branch-on-merge"}]}'
  exit 0
fi
# Mirror real CLI: gh stack init --base <trunk> <branch> [branches...]
# (see `gh stack init --help` — existing branches are adopted as positional args).
if [[ "$args" == *'stack init'* ]]; then
  if [[ "$args" =~ stack\ init\ --base\ [^[:space:]]+\ [^[:space:]] ]]; then
    exit 0
  fi
  printf 'mock gh: stack init requires --base <trunk> and at least one branch: %s\n' \
    "$args" >&2
  exit 1
fi
if [[ "${1:-}" == 'pr' && "${2:-}" == 'list' ]]; then
  printf '42\n'
  exit 0
fi
if [[ "${1:-}" == 'pr' && "${2:-}" == 'edit' ]]; then
  prev=''
  for a in "$@"; do
    if [[ "$prev" == '--body-file' ]]; then
      cp "$a" "${PR_BODY_FILE:?}"
    fi
    prev="$a"
  done
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_dir}/run-candidate-stack" <<EOF
#!/usr/bin/env bash
set -euo pipefail
# shellcheck disable=SC1091
source "${lib}"
rp_apply_fix=1
rp_queue_candidate_file_fix 'the-hcma/target' \
  '.github/workflows/cleanup-branch-on-merge.yml' \
  "\$(rp_candidate_cleanup_branch_on_merge_workflow)" \
  'add-cleanup-branch-on-merge' \
  'chore: add branch cleanup workflow'
rp_apply_candidate_fix_stack 'the-hcma/target'
EOF
chmod +x "${mock_dir}/run-candidate-stack"

pr_body_file="${mock_dir}/pr_body.txt"
set +e
output="$(
  cd "$target_repo" \
    && PATH="${mock_bin}:${PATH}" GH_LOG="$gh_log" PR_BODY_FILE="$pr_body_file" \
      "${mock_dir}/run-candidate-stack" 2>&1
)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] \
  && [[ -f "${target_wt}/.github/workflows/cleanup-branch-on-merge.yml" ]] \
  && grep -qF 'stack init --base main repo-practices/add-cleanup-branch-on-merge' \
    "$gh_log" \
  && grep -qF 'stack submit --auto --open' "$gh_log" \
  && ! grep -qF 'gt track' "$gh_log" \
  && grep -qF 'created candidate branch repo-practices/add-cleanup-branch-on-merge' \
    <<<"$output" \
  && grep -qF 'Org rollout candidate' "$pr_body_file" \
  && grep -qF 'org-cursor-rule-rollout.md' "$pr_body_file"; then
  printf '[PASS] apply-fix: gh-stack marker uses gh stack init + submit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] apply-fix: expected gh-stack candidate path (exit=%s)\n%s\ngh_log:\n%s\npr_body:\n%s\n' \
    "$exit_code" "$output" "$(cat "$gh_log" 2>/dev/null || true)" \
    "$(cat "$pr_body_file" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: org discovery skips private repos by default ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'orgs/the-hcma/repos'* && "$args" == *'private == false'* ]]; then
  printf '%s\n' 'public-repo'
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' 'public-repo'
  printf '%s\n' 'private-repo'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

discovered=""
discovered="$(PATH="${mock_bin}:${PATH}" bash -c "
  # shellcheck disable=SC1091
  source '${lib}'
  rp_include_private=0
  rp_discover_org_repos the-hcma
")"

if [[ "$discovered" == $'public-repo' ]]; then
  printf '[PASS] rp_discover_org_repos excludes private repos by default\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected only public-repo from org discovery (got %q)\n' "$discovered"
  fail=$(( fail + 1 ))
fi

discovered_all=""
discovered_all="$(PATH="${mock_bin}:${PATH}" bash -c "
  # shellcheck disable=SC1091
  source '${lib}'
  rp_include_private=1
  rp_discover_org_repos the-hcma
")"

if [[ "$discovered_all" == $'public-repo\nprivate-repo' ]] \
  || [[ "$discovered_all" == $'public-repo'$'\n''private-repo' ]]; then
  printf '[PASS] rp_discover_org_repos includes private repos with --include-private\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected public and private repos with include-private (got %q)\n' "$discovered_all"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: pr-ship-and-review rule required ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/example-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  exit 1
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  exit 1
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/example-repo --suggest 2>&1)"
exit_code=$?
set -e

if grep -qF 'add .agents/rules/pr-ship-and-review.md + .cursor/rules/pr-ship-and-review.mdc' <<<"$output" \
  && grep -qF 'scripts/lib/repo-practices-agents/rules/' <<<"$output"; then
  printf '[PASS] pr-ship-rule: missing agents rule suggests dual-path templates\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-ship-rule: expected missing-rule failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"

if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
