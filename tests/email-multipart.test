#!/usr/bin/env bash
# Tests for scripts/lib/email-multipart.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/email-multipart"
readonly lib

pass=0
fail=0

printf '\n=== static: multipart writer ===\n'
if grep -qF 'repo_helpers_email_write_multipart' "$lib" \
  && grep -qF 'multipart/alternative' "$lib" \
  && grep -qF 'text/html' "$lib"; then
  printf '[PASS] email-multipart: exports multipart/alternative writer\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: missing multipart writer\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== output includes headers and body ===\n'
out=""
# shellcheck disable=SC1090,SC1091
source "$lib"
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' 'Subject line' $'line one\nline two')"
if grep -qF 'To: to@test' <<<"$out" \
  && grep -qF 'Subject: Subject line' <<<"$out" \
  && grep -qF 'line one' <<<"$out"; then
  printf '[PASS] email-multipart: writes RFC-822 multipart message\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: output missing expected headers/body\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== html part linkifies https URLs ===\n'
out=""
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' 'Links' $'PR: https://github.com/org/repo/pull/1')"
if grep -qF '<a href="https://github.com/org/repo/pull/1">https://github.com/org/repo/pull/1</a>' <<<"$out"; then
  printf '[PASS] email-multipart: HTML pre block wraps URLs in anchor tags\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: expected clickable URL in HTML part\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== html part keeps escaped body (not empty) ===\n'
# Regression for notifier: piping body into sed must populate the HTML part.
# A runner_exec here-string around sed produced empty HTML while plain text
# still had content — HTML-preferring clients showed a blank email.
out=""
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' \
  'Updates' $'Dependency updates are available\nfoo <bar> & baz')"
html_part=""
html_part="$(awk '
  BEGIN { in_html = 0 }
  /^Content-Type: text\/html/ { in_html = 1; next }
  in_html && /^--/ { exit }
  in_html { print }
' <<<"$out")"
if grep -qF 'Dependency updates are available' <<<"$html_part" \
  && grep -qF 'foo &lt;bar&gt; &amp; baz' <<<"$html_part" \
  && [[ -n "$html_part" ]]; then
  printf '[PASS] email-multipart: HTML part contains escaped body text\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: HTML part missing or empty (got %d bytes)\n' \
    "${#html_part}"
  fail=$(( fail + 1 ))
fi

printf '\n=== html part strips trailing punctuation from href ===\n'
out=""
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' \
  'Punct' $'See https://example.com/path.')"
if grep -qF '<a href="https://example.com/path">https://example.com/path</a>.' <<<"$out"; then
  printf '[PASS] email-multipart: trailing period stays outside href\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: expected period outside href\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== html part linkifies query string with amp ===\n'
out=""
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' \
  'Query' $'Open https://example.com/search?q=1&b=2 now')"
if grep -qF \
  '<a href="https://example.com/search?q=1&amp;b=2">https://example.com/search?q=1&amp;b=2</a>' \
  <<<"$out"; then
  printf '[PASS] email-multipart: query & becomes &amp; in href and text\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: expected &amp; in linkified query URL\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: html_from_plain helper ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'repo_helpers_email_html_from_plain' "$lib" \
  && grep -qF 'repo_helpers_email_html_from_plain "$em_body"' "$lib"; then
  printf '[PASS] email-multipart: linkify/escape via html_from_plain helper\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: missing html_from_plain helper wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: locals avoid script-level subject/body names ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if ! grep -qE 'local -r (subject|body|to_addr|from_addr|reply_to|plain)=' "$lib" \
  && grep -qF 'local -r em_subject=' "$lib" \
  && grep -qF 'local -r em_body=' "$lib"; then
  printf '[PASS] email-multipart: uses em_* locals (no subject/body shadow)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: must not local subject/body (readonly callers)\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== works under script-level readonly subject/body ===\n'
# Regression: dep-updater-notifier marks subject readonly before calling the
# writer. Bash rejects `local subject` when subject is already readonly.
out=""
out="$(
  readonly subject='[notifier] dependency updates needed'
  readonly body=$'line one\nline two'
  # shellcheck disable=SC1090,SC1091
  source "$lib"
  repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' \
    "$subject" "$body"
)"
if grep -qF 'Subject: [notifier] dependency updates needed' <<<"$out" \
  && grep -qF 'line one' <<<"$out"; then
  printf '[PASS] email-multipart: succeeds with readonly subject/body in caller\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: failed under readonly subject/body\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
