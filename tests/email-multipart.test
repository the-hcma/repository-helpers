#!/usr/bin/env bash
# Tests for scripts/lib/email-multipart.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/email-multipart"
readonly lib

pass=0
fail=0

printf '\n=== static: multipart writer ===\n'
if grep -qF 'repo_helpers_email_write_multipart' "$lib" \
  && grep -qF 'multipart/alternative' "$lib" \
  && grep -qF 'text/html' "$lib"; then
  printf '[PASS] email-multipart: exports multipart/alternative writer\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: missing multipart writer\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== output includes headers and body ===\n'
out=""
# shellcheck disable=SC1090,SC1091
source "$lib"
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' 'Subject line' $'line one\nline two')"
if grep -qF 'To: to@test' <<<"$out" \
  && grep -qF 'Subject: Subject line' <<<"$out" \
  && grep -qF 'line one' <<<"$out"; then
  printf '[PASS] email-multipart: writes RFC-822 multipart message\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: output missing expected headers/body\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== html part linkifies https URLs ===\n'
out=""
out="$(repo_helpers_email_write_multipart 'to@test' 'from@test' 'from@test' 'Links' $'PR: https://github.com/org/repo/pull/1')"
if grep -qF '<a href="https://github.com/org/repo/pull/1">https://github.com/org/repo/pull/1</a>' <<<"$out"; then
  printf '[PASS] email-multipart: HTML pre block wraps URLs in anchor tags\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email-multipart: expected clickable URL in HTML part\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
