#!/usr/bin/env bash
# Tests for scripts/check-merge-settings (static + mocked gh).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

checker="${rh_root}/scripts/check-merge-settings"
readonly checker

pass=0
fail=0

printf '\n=== static: script and defaults ===\n'
if [[ -f "$checker" ]]; then
  printf '[PASS] check-merge-settings script is present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing check-merge-settings script\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'DEFAULT_REPOS' "$checker" \
  && grep -qF 'GRAPHITE_APP_ACTOR_ID' "$checker" \
  && grep -qF 'domesti-bot' "$checker" \
  && grep -qF 'my-tracks' "$checker" \
  && grep -qF 'gtmq_merge_' "$checker"; then
  printf '[PASS] defaults and Graphite merge-queue checks are defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected DEFAULT_REPOS, GRAPHITE_APP_ACTOR_ID, and gtmq_merge_ checks\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'squash_merge_commit_message=BLANK' "$checker" \
  && grep -qF 'release-please.yml' "$checker" \
  && grep -qF 'merged-pr-closer.yml' "$checker"; then
  printf '[PASS] script covers Release Please and Graphite workflow paths\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] script should reference release-please and merged-pr-closer\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: mocked gh passes for compliant repo ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows/merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":"Z3JhcGhpdGUtYXBwCkdyYXBoaXRlIG1lcmdlIHF1ZXVlCg=="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows/ci.yml'* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/good-repo/rulesets/'* ]]; then
  printf '%s\n' '{"name":"protect-main","bypass_actors":[{"actor_id":158384,"actor_type":"Integration","bypass_mode":"always"}],"rules":[{"type":"pull_request","parameters":{"allowed_merge_methods":["squash"]}}]}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/good-repo/rulesets'* ]]; then
  printf '%s\n' '[{"id":1,"name":"protect-main"}]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/good-repo'* && "$args" != *contents* ]]; then
  printf '%s\n' '{"allow_merge_commit":false,"allow_rebase_merge":false,"allow_squash_merge":true,"squash_merge_commit_message":"BLANK","squash_merge_commit_title":"PR_TITLE"}'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/good-repo 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] \
  && grep -qF 'OK: the-hcma/good-repo: release-please merge settings' <<<"$output" \
  && grep -qF 'OK: the-hcma/good-repo: Graphite merge queue GitHub wiring' <<<"$output"; then
  printf '[PASS] mocked compliant repo exits 0 with release-please and Graphite OK lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected exit 0 and both OK lines (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: mocked gh fails for merge-commit repo ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows/merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":"Z3JhcGhpdGUtYXBwCkdyYXBoaXRlIG1lcmdlIHF1ZXVlCg=="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows/ci.yml'* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/bad-repo'* && "$args" != *contents* && "$args" != *rulesets* ]]; then
  printf '%s\n' '{"allow_merge_commit":true,"allow_rebase_merge":true,"allow_squash_merge":true,"squash_merge_commit_message":"COMMIT_MESSAGES","squash_merge_commit_title":"COMMIT_OR_PR_TITLE"}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/bad-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/bad-repo 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'allow_merge_commit must be false' <<<"$output" \
  && grep -qF 'squash_merge_commit_message must be BLANK' <<<"$output"; then
  printf '[PASS] mocked non-compliant repo exits non-zero with expected FAIL lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected non-zero exit and FAIL lines (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: mocked gh fails when merge-it label is missing ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'ci.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'repos/the-hcma/no-label-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/no-label-repo 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] && grep -qF "missing Graphite enqueue label 'merge-it'" <<<"$output"; then
  printf '[PASS] missing merge-it label fails Graphite merge-queue check\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected merge-it label FAIL (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
