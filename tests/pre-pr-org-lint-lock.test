#!/usr/bin/env bash
# Tests for the one-org-audit-per-host lock in pre-pr-checks (#824): a second concurrent org-wide audit waits for the
# first and reuses its passing result, or fails with one machine-parseable line when the wait runs out.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/pre-pr-ecosystem"

work_dir="$(mktemp -d)"
readonly work_dir
trap 'rm -rf "${work_dir}"' EXIT

fixture="${work_dir}/repo"
mkdir -p "${fixture}/scripts/lib/repo-practices-agents"
(
  cd "$fixture"
  git init -q
  git config user.email 'test@example.com'
  git config user.name 'Test'
  printf '#!/usr/bin/env bash\n' >scripts/github-repo-lint
  printf 'template v1\n' >scripts/lib/repo-practices-agents/rule.md
  # shellcheck disable=SC2016  # the fake helper must read the variable when it runs, not now
  printf '#!/usr/bin/env bash\ncat -- "$FAKE_REMOTE_FILE" || exit 1\n' >scripts/gh-api
  chmod +x scripts/gh-api
  git add -A
  git commit -q -m init
)

export FAKE_REMOTE_FILE="${work_dir}/remote.txt"
unset PRE_PR_CHECKS_ORG_LINT_CACHE_TTL
export PRE_PR_CHECKS_CACHE_DIR="${work_dir}/cache"
printf 'the-hcma/a sha-a1\nthe-hcma/b sha-b1\n' >"$FAKE_REMOTE_FILE"

# Stubs for the parts that touch GitHub or the diff; the fingerprint and the cache are the real code.
runs_file="${work_dir}/runs"
: >"$runs_file"
lint_rc=0
# count_runs — how many audits have run (a file, because run_job captures output in a subshell).
count_runs() { wc -l <"$runs_file" | tr -d ' '; }
gh_slug_from_repo_dir() { printf 'the-hcma/repository-helpers\n'; }
prec_org_wide_lint_trigger() { printf 'scripts/lib/repo-practices-agents/rule.md\n'; }
run_command() {
  # the audit child must not inherit the lock: a survivor of a timeout would keep it held
  if { true >&200; } 2>/dev/null; then printf 'leaked\n' >>"${work_dir}/leaks"; fi
  printf 'run\n' >>"$runs_file"
  return "$lint_rc"
}

# run_job — runs the audit job; leaves its output in job_out and its exit status in job_rc.
run_job() {
  job_rc=0
  job_out="$(prec_run_repo_practices_lint "$fixture" 2>&1)" || job_rc=$?
}

lock_file="$(prec_org_lint_lock_file the-hcma)"
cache_file="$(prec_org_lint_cache_file the-hcma)"
mkdir -p "${work_dir}/cache"

# hold_lock — a background process holding the lock until the release fifo is written; sets holder_pid.
release_fifo="${work_dir}/release"
mkfifo "$release_fifo"
hold_lock() {
  (
    exec 9>>"$lock_file"
    flock --exclusive 9
    printf 'held\n' >"${work_dir}/held"
    read -r _ <"$release_fifo"
  ) &
  holder_pid=$!
  local tries=0
  until [[ -f "${work_dir}/held" ]]; do
    tries=$(( tries + 1 ))
    (( tries < 400 )) || break
    sleep 0.025
  done
}
release_lock() {
  printf 'go\n' >"$release_fifo"
  wait "$holder_pid"
  rm -f -- "${work_dir}/held"
}

touch "${work_dir}/leaks"
printf '\n=== a free lock does not wait ===\n'
run_job
assert_not_contains 'no wait note when nothing else is auditing' "$job_out" 'ORG_AUDIT_WAIT'
assert_contains 'the audit runs' "runs=$(count_runs)" 'runs=1'
assert_contains 'the lock is released afterwards' "free=$(flock --exclusive --nonblock "$lock_file" true && echo yes)" 'free=yes'

assert_contains 'the audit child does not inherit the lock descriptor' "leaks=$(wc -l <"${work_dir}/leaks" | tr -d ' ')" 'leaks=0'

printf '\n=== a second audit waits for the first and reuses its pass ===\n'
printf 'the-hcma/a sha-a2\n' >"$FAKE_REMOTE_FILE"
hold_lock
runs_before="$(count_runs)"
bg_out="${work_dir}/bg-out"
: >"$bg_out"
( PRE_PR_CHECKS_ORG_LINT_LOCK_WAIT=60 prec_run_repo_practices_lint "$fixture" >"$bg_out" 2>&1; printf 'rc=%s\n' "$?" >>"$bg_out" ) &
waiter_pid=$!
# the waiter prints its note before it blocks on the lock, so the note means it is parked
tries=0
until grep -q 'ORG_AUDIT_WAIT' "$bg_out"; do
  tries=$(( tries + 1 ))
  (( tries < 400 )) || break
  sleep 0.025
done
assert_contains 'the waiter has not run an audit while the lock is held' "runs=$(( $(count_runs) - runs_before ))" 'runs=0'
# the first audit finishes: it records its pass for the fingerprint the waiter will compute, then lets go
fp="$(prec_org_lint_fingerprint "$fixture" the-hcma "${fixture}/scripts/github-repo-lint")"
printf '%s %s\n' "$fp" "$EPOCHSECONDS" >"$cache_file"
release_lock
wait "$waiter_pid"
bg_text="$(cat "$bg_out")"
assert_contains 'the waiter said it was waiting, in one parseable line' "$bg_text" \
  'NOTE: ORG_AUDIT_WAIT org=the-hcma lock='
assert_contains 'the waiter then skipped the audit' "$bg_text" 'skipped org-wide audit'
assert_contains 'the waiter ran no audit' "runs=$(( $(count_runs) - runs_before ))" 'runs=0'
assert_contains 'the waiter passes' "$bg_text" 'rc=0'

printf '\n=== a wait that runs out fails with one line and runs nothing ===\n'
rm -f -- "$cache_file"
hold_lock
runs_before="$(count_runs)"
PRE_PR_CHECKS_ORG_LINT_LOCK_WAIT=1 run_job
release_lock
assert_contains 'the timeout is one machine-parseable line' "$job_out" 'ERROR: WAIT_TIMEOUT what=org-audit-lock org=the-hcma waited=1s'
assert_eq_lines() { printf '%s\n' "$1" | grep -c 'WAIT_TIMEOUT'; }
assert_contains 'exactly one timeout line' "lines=$(assert_eq_lines "$job_out")" 'lines=1'
assert_contains 'the timeout fails the job' "rc=${job_rc}" 'rc=1'
assert_contains 'no audit ran next to the other one' "runs=$(( $(count_runs) - runs_before ))" 'runs=0'
assert_contains 'the lock is free after the timeout' "free=$(flock --exclusive --nonblock "$lock_file" true && echo yes)" 'free=yes'

printf '\n=== an invalid wait is an error ===\n'
PRE_PR_CHECKS_ORG_LINT_LOCK_WAIT=soon run_job
assert_contains 'an invalid wait fails with one line' "$job_out" \
  'ERROR: PRE_PR_CHECKS_ORG_LINT_LOCK_WAIT must be a positive integer'
assert_contains 'an invalid wait exits 2' "rc=${job_rc}" 'rc=2'

printf '\n=== a failing audit releases the lock ===\n'
lint_rc=1
run_job
lint_rc=0
assert_contains 'the failure is returned' "rc=${job_rc}" 'rc=1'
assert_contains 'the lock is free after a failing audit' "free=$(flock --exclusive --nonblock "$lock_file" true && echo yes)" 'free=yes'

printf '\n=== the lock is dropped in the calling shell, on a skip and after an audit ===\n'
# run in this shell (not a $(...) subshell, whose exit would release it anyway)
prec_run_repo_practices_lint "$fixture" >/dev/null 2>&1 || true
assert_contains 'the lock is free after an audit in this shell' \
  "free=$(flock --exclusive --nonblock "$lock_file" true && echo yes)" 'free=yes'
prec_run_repo_practices_lint "$fixture" >/dev/null 2>&1 || true
assert_contains 'the lock is free after a skip in this shell' \
  "free=$(flock --exclusive --nonblock "$lock_file" true && echo yes)" 'free=yes'

test_summary
