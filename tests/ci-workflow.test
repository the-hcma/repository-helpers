#!/usr/bin/env bash
# Static tests for .github/workflows/ci.yml job layout and guard rules (#692).
# shellcheck disable=SC2016  # the needles are literal workflow text, not shell expansions
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
ci_yml="${script_dir}/../.github/workflows/ci.yml"
readonly ci_yml

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
test_init

printf '\n=== static: actionlint job uses the pinned shellcheck (#594) ===\n'
actionlint_job="$(awk '/^  ci-part-actionlint:/ { in_job = 1; print; next } /^  [a-zA-Z0-9_-]+:/ { in_job = 0 } in_job' "$ci_yml")"
assert_contains 'the actionlint job installs the pinned shellcheck before running actionlint' "$actionlint_job" 'ci_shellcheck_ensure'

printf '\n=== static: every ci-part job waits for the guard ===\n'
parts="$(grep -cE '^  ci-part-[a-z-]+:' "$ci_yml")"
guarded="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    needs: guard$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job has needs: guard' "guarded=${guarded}" "guarded=${parts}"
skip_gated="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    if: needs.guard.outputs.skip != .true.$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job is skipped when the guard says skip' "skip_gated=${skip_gated}" "skip_gated=${parts}"

printf '\n=== static: every ci-part job has a timeout ===\n'
timeouts="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    timeout-minutes: [0-9]+$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job sets timeout-minutes so a hung job cannot hold the rollup' "timeouts=${timeouts}" "timeouts=${parts}"

printf '\n=== static: macOS tests run in their own non-blocking workflow (#871) ===\n'
macos_yml="${script_dir}/../.github/workflows/ci-macos.yml"
macos_job="$(awk '/^  tests-macos:/ { in_job = 1; print; next } /^  [a-zA-Z0-9_-]+:/ { in_job = 0 } in_job' "$macos_yml")"
macos_triggers="$(awk '/^on:/ { in_on = 1; print; next } /^[a-z]/ { in_on = 0 } in_on' "$macos_yml")"
assert_not_contains 'ci.yml has no macOS job, so github-repo-lint never derives one as a required check' \
  "$(tr '[:upper:]' '[:lower:]' <"$ci_yml")" 'macos'
assert_contains 'the macOS job runs on an explicitly pinned macOS image' "$macos_job" 'runs-on: macos-15'
assert_not_contains 'the macOS job does not follow macos-latest' "$macos_job" 'macos-latest'
assert_contains 'the workflow says when to bump the pinned label' "$(<"$macos_yml")" \
  'Bump it deliberately when GitHub retires macos-15'
assert_contains 'the workflow says why it is not part of ci.yml' "$(<"$macos_yml")" 'therefore always ends up blocking'
assert_contains 'the macOS job has a timeout' "$macos_job" 'timeout-minutes: 30'
assert_contains 'the macOS job installs the documented GNU userland and bash 5' "$macos_job" \
  'brew install bash coreutils gnu-sed grep util-linux findutils ripgrep'
assert_contains 'the macOS job puts the GNU tools on PATH for later steps' "$macos_job" 'GITHUB_PATH'
assert_not_contains 'the macOS job does not brew install procps, so BSD pgrep stays' \
  "$(grep -F 'brew install' <<<"$macos_job")" 'procps'
assert_contains 'the macOS job runs the whole suite through run-tests' "$macos_job" 'scripts/dev/run-tests --jobs 3 --verbose'
assert_contains 'the macOS workflow runs on pull requests' "$macos_triggers" 'pull_request:'
assert_contains 'the macOS workflow can be started by hand' "$macos_triggers" 'workflow_dispatch:'
assert_not_contains 'the macOS workflow does not run on push, which would double the runs on a PR branch' "$macos_triggers" 'push:'
assert_not_contains 'the macOS workflow does not run in the merge queue, so the queue never waits for a macOS runner' \
  "$macos_triggers" 'merge_group'
assert_not_contains 'a PR description edit does not start a macOS run' "$macos_triggers" 'edited'

printf '\n=== static: shard jobs do not stop each other ===\n'
tests_job="$(awk '/^  ci-part-tests:/ { in_job = 1; print; next } /^  [a-zA-Z0-9_-]+:/ { in_job = 0 } in_job' "$ci_yml")"
assert_contains 'the tests matrix sets fail-fast: false so every shard reports' "$tests_job" 'fail-fast: false'

test_summary
