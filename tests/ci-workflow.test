#!/usr/bin/env bash
# Static tests for .github/workflows/ci.yml job layout and guard rules (#692).
# shellcheck disable=SC2016  # the needles are literal workflow text, not shell expansions
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
ci_yml="${script_dir}/../.github/workflows/ci.yml"
readonly ci_yml

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
test_init

printf '\n=== static: actionlint job uses the pinned shellcheck (#594) ===\n'
actionlint_job="$(awk '/^  ci-part-actionlint:/ { in_job = 1; print; next } /^  [a-zA-Z0-9_-]+:/ { in_job = 0 } in_job' "$ci_yml")"
assert_contains 'the actionlint job installs the pinned shellcheck before running actionlint' "$actionlint_job" 'ci_shellcheck_ensure'

printf '\n=== static: every ci-part job waits for the guard ===\n'
parts="$(grep -cE '^  ci-part-[a-z-]+:' "$ci_yml")"
guarded="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    needs: guard$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job has needs: guard' "guarded=${guarded}" "guarded=${parts}"
skip_gated="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    if: needs.guard.outputs.skip != .true.$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job is skipped when the guard says skip' "skip_gated=${skip_gated}" "skip_gated=${parts}"

printf '\n=== static: every ci-part job has a timeout ===\n'
timeouts="$(grep -c '^    timeout-minutes: 15$' "$ci_yml")"
assert_contains 'each ci-part job sets timeout-minutes so a hung job cannot hold the rollup' "timeouts=${timeouts}" "timeouts=${parts}"

printf '\n=== static: shard jobs do not stop each other ===\n'
tests_job="$(awk '/^  ci-part-tests:/ { in_job = 1; print; next } /^  [a-zA-Z0-9_-]+:/ { in_job = 0 } in_job' "$ci_yml")"
assert_contains 'the tests matrix sets fail-fast: false so every shard reports' "$tests_job" 'fail-fast: false'

test_summary
