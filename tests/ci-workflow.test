#!/usr/bin/env bash
# Static tests for .github/workflows/ci.yml job layout and guard rules (#692).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
ci_yml="${script_dir}/../.github/workflows/ci.yml"
readonly ci_yml

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
test_init

printf '\n=== static: guard skips title/body edits (#692) ===\n'
guard_script="$(awk '/^  guard:/ { in_guard = 1 } /^  ci-part-actionlint:/ { in_guard = 0 } in_guard' "$ci_yml")"
assert_contains 'guard reads the base-change field of the edited event' "$guard_script" 'BASE_CHANGED_FROM: ${{ github.event.changes.base.ref.from }}'
assert_contains 'guard skips an edited pull_request that did not change the base' "$guard_script" '[[ -z "${BASE_CHANGED_FROM}" ]]'
assert_contains 'guard logs why the title/body edit was skipped' "$guard_script" 'title/body edit without a base change'

printf '\n=== static: every ci-part job waits for the guard ===\n'
parts="$(grep -cE '^  ci-part-[a-z-]+:' "$ci_yml")"
guarded="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    needs: guard$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job has needs: guard' "guarded=${guarded}" "guarded=${parts}"
skip_gated="$(awk '
  /^  ci-part-[a-z-]+:/ { in_part = 1; next }
  /^  [a-zA-Z0-9_-]+:/ { in_part = 0 }
  in_part && /^    if: needs.guard.outputs.skip != .true.$/ { n++ }
  END { print n + 0 }
' "$ci_yml")"
assert_contains 'each ci-part job is skipped when the guard says skip' "skip_gated=${skip_gated}" "skip_gated=${parts}"

printf '\n=== static: shard jobs do not stop each other ===\n'
tests_job="$(awk '/^  ci-part-tests:/ { in_job = 1; print; next } /^  [a-zA-Z0-9_-]+:/ { in_job = 0 } in_job' "$ci_yml")"
assert_contains 'the tests matrix sets fail-fast: false so every shard reports' "$tests_job" 'fail-fast: false'

test_summary
