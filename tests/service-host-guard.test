#!/usr/bin/env bash
# Tests for scripts/lib/service-host-guard (ConditionHost injection).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
lib="${script_dir}/../scripts/lib/service-host-guard"
readonly lib

pass=0
fail=0

# shellcheck disable=SC1091  # test-assert is a sibling lib, not a package
source "${script_dir}/lib/test-assert"
# shellcheck disable=SC1090  # lib path is built from script_dir at runtime
source "$lib"

printf '=== service-host-guard: inject unit lines ===\n'

sample_unit='[Unit]
Description=demo

[Service]
Type=oneshot
ExecStart=/bin/true
'

injected="$(service_host_guard_inject_into_unit "$sample_unit" 'meerkat' 'meerkat.house.hcma' '7aeaef81ca2647d09d2c2ef67e36bc84')"
assert_contains 'inject includes machine-id ConditionHost' "$injected" \
  'ConditionHost=|7aeaef81ca2647d09d2c2ef67e36bc84'
assert_contains 'inject includes hostname ConditionHost' "$injected" \
  'ConditionHost=|meerkat'
if grep -qE '^ConditionHost=\|' <<<"$injected" \
  && grep -qE '^ConditionHost=\|meerkat$' <<<"$injected" \
  && [[ "$(grep -cE '^ConditionHost=' <<<"$injected" || true)" -eq 2 ]]; then
  printf '[PASS] inject emits machine-id and hostname ConditionHost lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] inject should emit machine-id and hostname ConditionHost lines\n'
  fail=$(( fail + 1 ))
fi
legacy_prefix="$(service_host_guard_legacy_bogus_prefix_value)"
if grep -qF "${legacy_prefix}" <<<"$injected"; then
  printf '[FAIL] inject must not emit legacy bogus machine-id unit key\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] inject does not emit legacy bogus machine-id unit key\n'
  pass=$(( pass + 1 ))
fi

reinjected="$(service_host_guard_inject_into_unit "$injected" 'meerkat' 'meerkat.house.hcma' '7aeaef81ca2647d09d2c2ef67e36bc84')"
count_mid="$(grep -cE '^ConditionHost=\|7aeaef81ca2647d09d2c2ef67e36bc84$' <<<"$reinjected" || true)"
count_host="$(grep -cE '^ConditionHost=\|meerkat$' <<<"$reinjected" || true)"
if [[ "$count_mid" -eq 1 && "$count_host" -eq 1 ]]; then
  printf '[PASS] re-inject replaces legacy guard lines once\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] re-inject should leave one machine-id and one hostname ConditionHost line (mid=%s host=%s)\n' \
    "$count_mid" "$count_host"
  fail=$(( fail + 1 ))
fi

printf '\n=== service-host-guard: parse machine-id from unit file ===\n'

tmp_unit="$(mktemp)"
printf '%s\n' "$injected" >"$tmp_unit"
parsed="$(service_host_guard_machine_id_from_unit_file "$tmp_unit")"
assert_contains 'parse machine-id from injected unit' "$parsed" '7aeaef81ca2647d09d2c2ef67e36bc84'
legacy_prefix="$(service_host_guard_legacy_bogus_prefix_value)"
printf '%s\n' "[Unit]
${legacy_prefix}abcdef0123456789abcdef0123456789
[Service]
Type=oneshot
ExecStart=/bin/true
" >"$tmp_unit"
legacy_parsed="$(service_host_guard_machine_id_from_unit_file "$tmp_unit")"
assert_contains 'parse machine-id from legacy bogus unit line' "$legacy_parsed" 'abcdef0123456789abcdef0123456789'
rm -f "$tmp_unit"

printf '\n=== summary ===\n'
printf 'pass=%s fail=%s\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
exit 0
