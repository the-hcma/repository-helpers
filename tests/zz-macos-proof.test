#!/usr/bin/env bash
# Throwaway proof for #871: GNU pgrep takes --newest, BSD pgrep (macOS) rejects long options with exit 2.
set -euo pipefail

rc=0
pgrep --newest --parent "$$" >/dev/null 2>&1 || rc=$?
if (( rc <= 1 )); then
  printf '[PASS] pgrep --newest is understood (exit %s)\n' "$rc"
else
  printf '[FAIL] pgrep --newest is rejected (exit %s)\n' "$rc"
  exit 1
fi
