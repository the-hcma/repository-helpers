wait_ci_body="$(awk '/^wait_for_ci\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016
if printf '%s' "$wait_ci_body" | grep -qF 'dep_updater_handle_ci_failure "$pr_num" "$branch"'; then
  printf '[PASS] ci-failure: wait_for_ci delegates failures to handle_ci_failure\n'
