fi

# Dead gh-run-list conclusion helper must stay removed (SC2317 / issue #430).
# shellcheck disable=SC2016
if ! grep -qF 'ci_conclusion_for_head()' "$script"; then
  printf '[PASS] ci_conclusion_for_head: removed; gating uses ci_conclusion_for_pr only\n'
  pass=$(( pass + 1 ))
else
