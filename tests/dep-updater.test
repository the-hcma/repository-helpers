# require_resume_ci_gate must use the same PR-rollup success gate (issue #430).
# shellcheck disable=SC2016
resume_gate_body="$(awk '/^require_resume_ci_gate\(\)/,/^}/' "$script")"
if grep -qF 'ci_conclusion_for_pr' <<<"$resume_gate_body" \
  && ! grep -qE 'success\|skipped\|neutral' <<<"$resume_gate_body" \
  && ! grep -qF 'ci_conclusion_for_head' <<<"$resume_gate_body"; then
