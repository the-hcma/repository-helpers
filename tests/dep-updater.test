printf '\n=== static: die writes directly to stderr ===\n'

die_body="$(awk '/^die\(\) \{/{found=1; next} found && /^\}$/{exit} found' "$script")"

# Must use printf ... >&2 (not log)
if printf '%s\n' "$die_body" | grep -qE 'printf.*>&2'; then
  printf '[PASS] die: uses printf ... >&2\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] die: does not use printf ... >&2 — errors will be silenced in --quiet mode\n'
  fail=$(( fail + 1 ))
fi

# Must NOT call log (which TIME_LOG_ENABLED=0 suppresses)
if printf '%s\n' "$die_body" | grep -qE '^\s+log\b'; then
  printf '[FAIL] die: calls log — will be silent when TIME_LOG_ENABLED=0 (quiet/report-json mode)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] die: does not route through log (not silenced by quiet mode)\n'
  pass=$(( pass + 1 ))
fi

