  fail=$(( fail + 1 ))
fi

# Both gh merge entry points must omit --delete-branch (GitHub MQ-safe).
enqueue_merge_body="$(awk '/^dep_enqueue_pr_for_merge_queue\(\)/,/^\}/' "$script")"
enqueue_merge_argv="$(printf '%s\n' "$enqueue_merge_body" | awk '
  /dep_runner_gh_stdout "dep-updater gh pr merge auto" -- pr merge/ {grab=1}
  grab {print}
  grab && /\)" \|\| merge_exit/ {exit}
')"
if grep -qF -- '--auto' <<<"$enqueue_merge_argv" \
  && grep -qF -- '--squash' <<<"$enqueue_merge_argv" \
  && ! grep -qF -- '--delete-branch' <<<"$enqueue_merge_argv"; then
  printf '[PASS] merge-via: dep_enqueue_pr_for_merge_queue also omits --delete-branch\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-via: dep_enqueue_pr_for_merge_queue must use --auto --squash without --delete-branch\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016
if grep -qF 'child_args+=(--merge-via "$merge_via")' "$script"; then
