#!/usr/bin/env bash
# Basic smoke tests for dep-updater dry-run mode.
#
# These tests run the script with --dry-run against this repository (which has
# no npm or Python ecosystem) and verify:
#   1. The script exits 0.
#   2. A worktree is created  (log line "[worktree] Creating worktree at:").
#   3. The worktree is removed (log line "[worktree] Removed:").
#   4. The output indicates that no dependencies need updating.
#
# Both non-batch and --batch modes are exercised to confirm the code paths
# do not diverge on these invariants.
#
# Prerequisites (must be on PATH): git, gt, gh, jq, rg
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

# shellcheck disable=SC1091
source "${script_dir}/../scripts/lib/gnu-sed"

# dep_test_path_no_gh_gt [extra_dirs…]
# PATH for tests that must not resolve host gh/gt, but still need rg, jq, gsed, etc.
dep_test_path_no_gh_gt() {
  local -a out=() seen_dirs=()
  local tool dir dup seen

  for dir in "$@"; do
    [[ -n "$dir" ]] && out+=("$dir")
  done

  for tool in rg jq git gsed; do
    dir="$(dirname "$(command -v "$tool" 2>/dev/null || true)")"
    [[ -n "$dir" && "$dir" != '.' ]] || continue
    dup=0
    for seen in "${seen_dirs[@]}"; do
      if [[ "$seen" == "$dir" ]]; then
        dup=1
        break
      fi
    done
    if (( dup == 0 )); then
      out+=("$dir")
      seen_dirs+=("$dir")
    fi
  done

  out+=('/usr/bin' '/bin')
  local IFS=:
  printf '%s' "${out[*]}"
}

script="${script_dir}/../scripts/dep-updater"
readonly script

pass=0
fail=0

release_age_defaults="${script_dir}/../scripts/lib/release-age-defaults"
readonly release_age_defaults

printf '\n=== static: npm minimumReleaseAge (dep-updater day gate) ===\n'
if [[ -f "$release_age_defaults" ]]; then
  printf '[PASS] release-age: scripts/lib/release-age-defaults exists\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: scripts/lib/release-age-defaults is missing\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2016  # grep for literal strings in the script under test
if grep -qF 'source "${dep_script_dir}/lib/release-age-defaults"' "$script" \
  && grep -qF 'dep_updater_minimum_release_age_minutes="$release_age_dep_updater_minutes"' "$script" \
  && grep -q '^npm_version_meets_minimum_release_age()' "$script" \
  && grep -q '^npm_minimum_release_age_minutes()' "$script" \
  && grep -q '^py_version_meets_minimum_release_age()' "$script" \
  && grep -q '^gha_version_meets_minimum_release_age()' "$script"; then
  printf '[PASS] release-age: dep-updater floor constant and gate helpers are defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: missing release-age defaults source, constant wiring, or gate helpers\n'
  fail=$(( fail + 1 ))
fi
release_age_npm_outdated_fn="$(
  awk '
    BEGIN { in_fn = 0; depth = 0 }
    /^npm_outdated\(\)[[:space:]]*\{/ {
      in_fn = 1
      depth = 1
      print
      next
    }
    in_fn {
      print
      depth += gsub(/\{/, "{")
      depth -= gsub(/\}/, "}")
      if (depth <= 0) {
        exit
      }
    }
  ' "$script"
)"
if grep -qF 'npm_version_meets_minimum_release_age' <<<"$release_age_npm_outdated_fn"; then
  printf '[PASS] release-age: npm_outdated applies minimumReleaseAge before proposing bumps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: npm_outdated must call npm_version_meets_minimum_release_age\n'
  fail=$(( fail + 1 ))
fi
release_age_prefetch_closure_fn="$(awk '/^npm_version_prefetch_closure\(\)/,/^\}/' "$script")"
if grep -qF 'npm_version_meets_minimum_release_age' <<<"$release_age_prefetch_closure_fn"; then
  printf '[PASS] release-age: npm_version_prefetch_closure enforces age on transitive exact deps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: npm_version_prefetch_closure must check minimumReleaseAge\n'
  fail=$(( fail + 1 ))
fi
release_age_cve_age_fn="$(awk '/^npm_version_meets_minimum_release_age\(\)/,/^\}/' "$script")"
if grep -q '^npm_pkg_has_cve_fix_in_audit()' "$script" \
  && grep -qF 'npm_pkg_has_cve_fix_in_audit' <<<"$release_age_cve_age_fn"; then
  printf '[PASS] release-age: CVE-marked npm packages bypass minimumReleaseAge in dep-updater\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: npm_version_meets_minimum_release_age must bypass for CVE audit entries\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2016  # intentional literal grep for assignment in script
if grep -qF 'npm_cve_fix_audit_lines="$npm_audit_lines"' "$script"; then
  printf '[PASS] release-age: audit lines are set before npm_outdated for CVE bypass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: must assign npm_cve_fix_audit_lines before npm_outdated\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2016  # intentional literal grep for assignment in script
if grep -qF 'py_cve_fix_audit_lines="$py_audit_lines"' "$script" \
  && grep -q '^py_pkg_has_cve_fix_in_audit()' "$script"; then
  printf '[PASS] release-age: pip-audit lines are set before py_outdated for CVE bypass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: must assign py_cve_fix_audit_lines before py_outdated\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: Graphite tracking recovery ===\n'
graphite_info_fn="$(awk '/^dep_stack_graphite_branch_info_ok\(\)/,/^\}/' "$script")"
graphite_local_main_fn="$(awk '/^dep_stack_graphite_local_main_present\(\)/,/^\}/' "$script")"
graphite_track_fn="$(awk '/^dep_stack_graphite_track\(\)/,/^\}/' "$script")"
ensure_tracked_fn="$(awk '/^ensure_gt_tracked\(\)/,/^\}/' "$script")"
register_branch_fn="$(awk '/^dep_stack_register_branch\(\)/,/^\}/' "$script")"
offer_reset_fn="$(awk '/^offer_worktree_reset\(\)/,/^\}/' "$script")"
prepare_worktree_fn="$(awk '/^prepare_worktree\(\)/,/^ensure_gt_tracked\(\)/' "$script")"
# Match literal shell expressions in the implementation under test.
# shellcheck disable=SC2016
if grep -qF -- '--timeout "$dep_graphite_command_timeout_seconds"' <<<"$graphite_info_fn" \
  && grep -qF -- '--timeout "$dep_graphite_command_timeout_seconds"' <<<"$graphite_track_fn"; then
  printf '[PASS] Graphite tracking probes and writes have bounded runtimes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] Graphite tracking probes and writes must have bounded runtimes\n'
  fail=$(( fail + 1 ))
fi
# Match the literal array expansion passed by the implementation under test.
# shellcheck disable=SC2016
if grep -qF 'refs/heads/main' <<<"$graphite_local_main_fn" \
  && grep -qF 'dep_stack_graphite_local_main_present' <<<"$ensure_tracked_fn" \
  && grep -qF 'track_args+=(-p main)' <<<"$ensure_tracked_fn" \
  && grep -qF 'dep_stack_graphite_track "${track_args[@]}"' <<<"$ensure_tracked_fn"; then
  printf '[PASS] Graphite tracking uses main when present and preserves trunk auto-detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] Graphite tracking must preserve non-main trunk auto-detection\n'
  fail=$(( fail + 1 ))
fi
# Continuation-line `git` is counted as a bare invocation; keep it beside runner_exec.
if grep -qE 'runner_exec "git main branch probe".*[[:space:]]git -C' <<<"$graphite_local_main_fn"; then
  printf '[PASS] Graphite main-branch probe keeps git on the runner_exec line\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] Graphite main-branch probe must keep git on the runner_exec line\n'
  fail=$(( fail + 1 ))
fi
# Match literal wt_base parent handling in the implementation under test.
# shellcheck disable=SC2016
if grep -qF 'parent_branch" == "$wt_base_branch"' <<<"$register_branch_fn" \
  && grep -qF 'dep_stack_graphite_local_main_present' <<<"$register_branch_fn" \
  && grep -qF 'track_args+=(-p main)' <<<"$register_branch_fn" \
  && grep -qF 'dep_stack_graphite_track "${track_args[@]}"' <<<"$register_branch_fn" \
  && ! grep -qF 'dep_stack_graphite_track -p main' <<<"$register_branch_fn"; then
  printf '[PASS] Graphite first-branch registration preserves non-main trunk auto-detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] Graphite first-branch registration must not hardcode -p main\n'
  fail=$(( fail + 1 ))
fi
if grep -qF 'branch_info_status == 124' <<<"$ensure_tracked_fn" \
  && grep -qF 'branch_info_status == 124' <<<"$prepare_worktree_fn" \
  && grep -qF 'preserving existing worktree' <<<"$prepare_worktree_fn"; then
  printf '[PASS] Graphite probe timeouts fail without resetting existing worktrees\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] Graphite probe timeouts must not reset existing worktrees\n'
  fail=$(( fail + 1 ))
fi
# Match literal timeout handling in the Graphite write path under test.
# shellcheck disable=SC2016
if grep -qF 'track_status == 124' <<<"$graphite_track_fn" \
  && grep -qF 'WAIT_TIMEOUT Graphite track timed out' <<<"$graphite_track_fn" \
  && grep -qF 'preserving existing worktree' <<<"$graphite_track_fn"; then
  printf '[PASS] Graphite track timeouts die without falling through to generic cleanup\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] Graphite track timeouts must die with a preserve-worktree WAIT_TIMEOUT\n'
  fail=$(( fail + 1 ))
fi
cleanup_on_error_fn="$(awk '/^cleanup_on_error\(\)/,/^}/' "$script")"
if grep -qF 'preserving existing worktree' <<<"$cleanup_on_error_fn" \
  && grep -qF 'preserve_worktree=1' <<<"$cleanup_on_error_fn" \
  && grep -qF 'Preserving worktree after timeout' <<<"$cleanup_on_error_fn"; then
  printf '[PASS] cleanup_on_error preserves worktrees on Graphite timeout dies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cleanup_on_error must preserve worktrees on Graphite timeout dies\n'
  fail=$(( fail + 1 ))
fi
# Match literal state-variable guards in the implementation under test.
# shellcheck disable=SC2016
if grep -qF '[[ -z "$branches_csv" && -z "$prs_csv" ]]' <<<"$offer_reset_fn" \
  && grep -qF 'Auto-recovering abandoned untracked worktree' <<<"$offer_reset_fn"; then
  printf '[PASS] abandoned untracked worktrees without stack state auto-recover\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] abandoned untracked worktrees without stack state must auto-recover\n'
  fail=$(( fail + 1 ))
fi
tracking_line="$(grep -nF 'dep_stack_ensure_tracked' "$script" | tail -n 1 | cut -d: -f1)"
tracking_setup="$(
  awk '
    /existing_prs=.*state_get/ { in_setup = 1 }
    in_setup { print }
    in_setup && /dep_stack_ensure_tracked/ { exit }
  ' "$script"
)"
# Match the literal no-stack-state guard in the implementation under test.
# shellcheck disable=SC2016
if [[ -n "$tracking_line" ]] \
  && grep -qF '[[ -z "$existing_branches" && -z "$existing_prs" ]]' <<<"$tracking_setup" \
  && grep -qF '_cleanup_trap_active=1' <<<"$tracking_setup"; then
  printf '[PASS] fresh-worktree cleanup is armed before Graphite tracking\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] fresh-worktree cleanup must be armed before Graphite tracking\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: GitHub Actions ecosystem
# ---------------------------------------------------------------------------

printf '\n=== static: github-actions ecosystem ===\n'

# gha_outdated must handle "- uses:" YAML list entries (common in workflows).
if grep -qF "sed -E 's/^[[:space:]]*-?[[:space:]]*uses:[[:space:]]*//'" "$script"; then
  printf '[PASS] gha_outdated: strips optional leading \"-\" from uses lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: does not strip optional leading \"-\" from uses lines\n'
  fail=$(( fail + 1 ))
fi

# has_gha global variable must be declared
if grep -q '^has_gha=0' "$script"; then
  printf '[PASS] has_gha: global variable declared with default 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] has_gha: global variable not declared\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated() function must be defined
if grep -q '^gha_outdated()' "$script"; then
  printf '[PASS] gha_outdated: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one() function must be defined
if grep -q '^gha_update_one()' "$script"; then
  printf '[PASS] gha_update_one: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# detect_ecosystem() must set has_gha=1 when gha or auto ecosystem
if grep -A5 "ecosystem.*'gha'.*auto\|ecosystem.*gha.*auto" "$script" | grep -q 'has_gha=1'; then
  printf '[PASS] detect_ecosystem: sets has_gha=1 for gha/auto ecosystem\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] detect_ecosystem: has_gha=1 not set for gha/auto ecosystem\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must skip commit-SHA pins (40 hex chars)
# Note: awk ERE {n} quantifiers are not supported by all awk implementations
# (e.g. mawk); use grep -P or search for the literal pattern text instead.
if grep -qP '0-9a-fA-F\]\{40\}' "$script" 2>/dev/null \
    || grep -q '0-9a-fA-F]{40}' "$script"; then
  printf '[PASS] gha_outdated: skips commit-SHA pins (40 hex chars)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: commit-SHA pin guard not found\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must list semver releases/tags and pick the newest eligible ref
if grep -q '^_gha_semver_release_tags_desc()' "$script" \
  && grep -q '^_gha_pick_eligible_new_ref()' "$script"; then
  printf '[PASS] gha_outdated: lists semver releases and picks newest eligible ref\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing semver release/tag helpers for eligible ref selection\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must skip local actions starting with ./
if awk '/^gha_outdated\(\)/{found=1} found && /\.\//{ ok=1 } found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: skips local actions (./path/to/action)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: local action guard not found\n'
  fail=$(( fail + 1 ))
fi

# gha helpers normalize major-only pins for semver comparison
# shellcheck disable=SC2016  # intentional literal grep for script source pattern
if grep -qF 'printf '\''%s.0.0'\'' "$ver"' "$script" \
  && grep -q '^_gha_ref_sortable_version()' "$script"; then
  printf '[PASS] gha_outdated: normalizes major-only pins (^vN) to N.0.0 for comparison\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing _gha_ref_sortable_version major-only normalization\n'
  fail=$(( fail + 1 ))
fi

# gha helpers consult releases and tags endpoints for semver candidates
if grep -qF '/releases?per_page=100' "$script" \
  && grep -qF '/tags?per_page=100' "$script"; then
  printf '[PASS] gha_outdated: queries releases and tags for semver candidates\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing releases/tags query for semver candidates\n'
  fail=$(( fail + 1 ))
fi

# gha helpers use sort -V for semver ordering (never downgrade)
if awk '/^_gha_pick_eligible_new_ref\(\)/{found=1} found && /sort -V/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: uses sort -V for semver comparison in eligible-ref picker\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: sort -V not found in _gha_pick_eligible_new_ref\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must track the oldest pin per action (not first-seen only) — #360
# shellcheck disable=SC2016  # assert literal source identifiers
if awk '/^gha_outdated\(\)/{found=1} found && /oldest_ref_by_action/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script" \
  && awk '/^gha_outdated\(\)/{found=1} found && /_gha_ref_sortable_version/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script" \
  && ! awk '/^gha_outdated\(\)/{found=1} found && /already_seen/{bad=1} found && /^}/{found=0} END{exit !bad}' "$script"; then
  printf '[PASS] gha_outdated: aggregates oldest pin per action (not first-seen only)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: expected oldest_ref_by_action aggregation without already_seen skip\n'
  fail=$(( fail + 1 ))
fi

# Functional: latest pin listed before stale pin still emits a bump (#360)
printf '\n=== functional: gha_outdated oldest pin when newer appears first ===\n'
gha_mixed_tmp=""
gha_mixed_tmp="$(mktemp -d)"
mkdir -p "${gha_mixed_tmp}/.github/workflows"
cat >"${gha_mixed_tmp}/.github/workflows/ci.yml" <<'EOF'
jobs:
  secret-scan:
    steps:
      - uses: actions/checkout@v7.0.0
  validate:
    steps:
      - uses: actions/checkout@v6.0.3
EOF
gha_mixed_out=""
gha_mixed_out="$(
  # Stubs are invoked from eval'd gha_outdated; shellcheck cannot see that.
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC2317,SC2329
  _gha_ref_sortable_version() {
    local -r ref="$1"
    local ver="${ref#v}"
    if [[ "$ver" =~ ^[0-9]+$ ]]; then
      printf '%s.0.0' "$ver"
    else
      printf '%s' "$ver"
    fi
  }
  # shellcheck disable=SC2317,SC2329
  _gha_semver_release_tags_desc() { printf 'v7.0.0\n'; }
  # shellcheck disable=SC2317,SC2329
  _gha_pick_eligible_new_ref() {
    local -r action="$1"
    local -r ref="$2"
    if [[ "$action" == 'actions/checkout' && "$ref" == 'v6.0.3' ]]; then
      printf 'v7.0.0'
      return 0
    fi
    return 1
  }
  # Extract gha_outdated from the script under test.
  # shellcheck disable=SC1090
  eval "$(awk '/^gha_outdated\(\)/{p=1} p{print} p && /^}/{exit}' "$script")"
  gha_outdated "$gha_mixed_tmp"
)"
if [[ "$gha_mixed_out" == $'actions/checkout\tv6.0.3\tv7.0.0' ]]; then
  printf '[PASS] gha_outdated: emits stale pin when newer pin appears first\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: expected tab-delimited \"actions/checkout<TAB>v6.0.3<TAB>v7.0.0\", got \"%s\"\n' \
    "$gha_mixed_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$gha_mixed_tmp"

# Repro for repository-helpers#599: a SHA-pinned action with a trailing
# "# vX.Y.Z" comment (the org-standard secure pin style) was never recognized
# as a SHA pin (the comment broke the 40-hex-char check), so it was treated as
# a bumpable floating ref and corrupted by the downstream sed replacement.
printf '\n=== functional: gha_outdated resolves a SHA-pinned action with a version comment to a new SHA (#599) ===\n'
gha_sha_tmp="$(mktemp -d)"
mkdir -p "${gha_sha_tmp}/.github/workflows"
cat >"${gha_sha_tmp}/.github/workflows/ci.yml" <<'EOF'
jobs:
  build:
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
EOF
gha_sha_out="$(
  # Stubs are invoked from eval'd gha_outdated; shellcheck cannot see that.
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC2317,SC2329
  _gha_ref_sortable_version() {
    local -r ref="$1"
    local ver="${ref#v}"
    if [[ "$ver" =~ ^[0-9]+$ ]]; then
      printf '%s.0.0' "$ver"
    else
      printf '%s' "$ver"
    fi
  }
  # shellcheck disable=SC2317,SC2329
  _gha_semver_release_tags_desc() { printf 'v7.0.2\n'; }
  # shellcheck disable=SC2317,SC2329
  _gha_pick_eligible_new_ref() {
    local -r action="$1"
    local -r ref="$2"
    if [[ "$action" == 'actions/checkout' && "$ref" == 'v7.0.1' ]]; then
      printf 'v7.0.2'
      return 0
    fi
    return 1
  }
  # shellcheck disable=SC2317,SC2329
  _gha_resolve_tag_commit_sha() {
    local -r action="$1"
    local -r tag="$2"
    if [[ "$action" == 'actions/checkout' && "$tag" == 'v7.0.2' ]]; then
      printf 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
      return 0
    fi
    return 1
  }
  # Extract gha_outdated from the script under test.
  # shellcheck disable=SC1090
  eval "$(awk '/^gha_outdated\(\)/{p=1} p{print} p && /^}/{exit}' "$script")"
  gha_outdated "$gha_sha_tmp"
)"
gha_sha_expected=$'actions/checkout\t3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # v7.0.2'
if [[ "$gha_sha_out" == "$gha_sha_expected" ]]; then
  printf '[PASS] gha_outdated: SHA-pinned action with a version comment resolves to a new SHA + comment (#599)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: expected %q, got %q\n' "$gha_sha_expected" "$gha_sha_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$gha_sha_tmp"

# Review finding on #599 (CodeRabbit / mergestorm-vortex): the original trim
# ("${pin_comment# }" / "${action% }") only stripped exactly one space, so a
# pin with two-or-more spaces before "#" left a trailing space on the SHA,
# failed the 40-hex check, and silently fell through to the floating-ref bump
# path — the exact supply-chain regression this fix exists to prevent.
printf '\n=== functional: gha_outdated tolerates multiple spaces before the version comment (#599 review) ===\n'
gha_sha_ws_tmp="$(mktemp -d)"
mkdir -p "${gha_sha_ws_tmp}/.github/workflows"
cat >"${gha_sha_ws_tmp}/.github/workflows/ci.yml" <<'EOF'
jobs:
  build:
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1   #   v7.0.1
EOF
gha_sha_ws_out="$(
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC2317,SC2329
  _gha_ref_sortable_version() {
    local -r ref="$1"
    local ver="${ref#v}"
    if [[ "$ver" =~ ^[0-9]+$ ]]; then
      printf '%s.0.0' "$ver"
    else
      printf '%s' "$ver"
    fi
  }
  # shellcheck disable=SC2317,SC2329
  _gha_semver_release_tags_desc() { printf 'v7.0.2\n'; }
  # shellcheck disable=SC2317,SC2329
  _gha_pick_eligible_new_ref() {
    local -r action="$1"
    local -r ref="$2"
    if [[ "$action" == 'actions/checkout' && "$ref" == 'v7.0.1' ]]; then
      printf 'v7.0.2'
      return 0
    fi
    return 1
  }
  # shellcheck disable=SC2317,SC2329
  _gha_resolve_tag_commit_sha() {
    local -r action="$1"
    local -r tag="$2"
    if [[ "$action" == 'actions/checkout' && "$tag" == 'v7.0.2' ]]; then
      printf 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
      return 0
    fi
    return 1
  }
  # shellcheck disable=SC1090
  eval "$(awk '/^gha_outdated\(\)/{p=1} p{print} p && /^}/{exit}' "$script")"
  gha_outdated "$gha_sha_ws_tmp"
)"
gha_sha_ws_expected=$'actions/checkout\t3d3c42e5aac5ba805825da76410c181273ba90b1   #   v7.0.1\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # v7.0.2'
if [[ "$gha_sha_ws_out" == "$gha_sha_ws_expected" ]]; then
  printf '[PASS] gha_outdated: multi-space "# vX.Y.Z" comment still classifies as a SHA pin and resolves cleanly\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: expected %q, got %q\n' "$gha_sha_ws_expected" "$gha_sha_ws_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$gha_sha_ws_tmp"

# Hermetic test for the resolver itself (annotated-tag branch): stub the
# underlying dep_runner_gh_api_jq calls, not _gha_resolve_tag_commit_sha, so
# the two-hop annotated-tag path (tag ref -> tag object -> commit) is actually
# exercised, per CodeRabbit's #599 review comment.
printf '\n=== functional: _gha_resolve_tag_commit_sha resolves an annotated tag to its commit (#599 review) ===\n'
gha_resolve_out="$(
  # shellcheck disable=SC2317,SC2329
  dep_runner_gh_api_jq() {
    local endpoint jq_filter
    if [[ "${1:-}" == '--probe' ]]; then shift; fi
    shift # label
    if [[ "${1:-}" == '--probe' ]]; then shift; fi
    endpoint="$1"
    jq_filter="$2"
    case "$endpoint" in
      repos/actions/checkout/git/ref/tags/v7.0.2)
        case "$jq_filter" in
          '.object.sha // empty') printf 'tagobjsha0000000000000000000000000000000' ;;
          '.object.type // empty') printf 'tag' ;;
        esac
        ;;
      repos/actions/checkout/git/tags/tagobjsha0000000000000000000000000000000)
        [[ "$jq_filter" == '.object.sha // empty' ]] && printf 'commitsha11111111111111111111111111111'
        ;;
    esac
  }
  # shellcheck disable=SC1090
  eval "$(awk '/^_gha_resolve_tag_commit_sha\(\)/{p=1} p{print} p && /^}/{exit}' "$script")"
  _gha_resolve_tag_commit_sha 'actions/checkout' 'v7.0.2'
)"
if [[ "$gha_resolve_out" == 'commitsha11111111111111111111111111111' ]]; then
  printf '[PASS] _gha_resolve_tag_commit_sha: annotated tag resolves through the tag object to its commit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] _gha_resolve_tag_commit_sha: expected the resolved commit sha, got %q\n' "$gha_resolve_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gha_outdated leaves a SHA-pinned action with no version comment untouched (#599) ===\n'
gha_nocmt_tmp="$(mktemp -d)"
mkdir -p "${gha_nocmt_tmp}/.github/workflows"
cat >"${gha_nocmt_tmp}/.github/workflows/ci.yml" <<'EOF'
jobs:
  build:
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
EOF
gha_nocmt_out="$(
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC1090
  eval "$(awk '/^gha_outdated\(\)/{p=1} p{print} p && /^}/{exit}' "$script")"
  gha_outdated "$gha_nocmt_tmp"
)"
if [[ -z "$gha_nocmt_out" ]]; then
  printf '[PASS] gha_outdated: SHA pin with no version comment stays untouched (no safe baseline)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: expected no output for a bare SHA pin, got %q\n' "$gha_nocmt_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$gha_nocmt_tmp"

# End-to-end proof the original corruption (repository-helpers#599) cannot
# recur: run the exact sed pattern gha_update_one/batch mode use, fed with the
# tab-delimited current_ref/new_ref gha_outdated now emits for a SHA pin, and
# assert the resulting line is a clean single pin — not the doubled-comment
# garbage ("actions/checkout@# v7.0.1 7.0.1 # v7.0.1") that broke six repos.
printf '\n=== functional: gha_update_one sed replacement does not corrupt a SHA-pinned + commented line (#599) ===\n'
gha_sed_tmp="$(mktemp -d)"
mkdir -p "${gha_sed_tmp}/.github/workflows"
cat >"${gha_sed_tmp}/.github/workflows/ci.yml" <<'EOF'
jobs:
  build:
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
EOF
gha_sed_gnu_sed="$(command -v gsed 2>/dev/null || command -v sed)"
gha_sed_action='actions/checkout'
gha_sed_current='3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1'
gha_sed_new='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # v7.0.2'
find "${gha_sed_tmp}/.github/workflows" -maxdepth 1 \( -name '*.yml' -o -name '*.yaml' \) \
  -exec "$gha_sed_gnu_sed" -i \
    -e "s|uses: ${gha_sed_action}@${gha_sed_current}|uses: ${gha_sed_action}@${gha_sed_new}|g" \
    {} +
gha_sed_result="$(grep 'uses: actions/checkout' "${gha_sed_tmp}/.github/workflows/ci.yml")"
gha_sed_expected='      - uses: actions/checkout@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # v7.0.2'
if [[ "$gha_sed_result" == "$gha_sed_expected" ]]; then
  printf '[PASS] gha_update_one sed pattern cleanly replaces a full SHA+comment pin, no doubled comment (#599)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one sed pattern corrupted the pin: got %q\n' "$gha_sed_result"
  fail=$(( fail + 1 ))
fi
rm -rf "$gha_sed_tmp"

# End-to-end proof that the multi-space case doesn't just classify correctly
# but the emitted cur_ref actually finds-and-replaces the real file content —
# the failure mode the reviewers flagged was a canonicalized cur_ref silently
# failing to match a file whose original spacing differs, leaving the pin
# untouched with no error rather than corrupting it outright.
printf '\n=== functional: gha_outdated cur_ref for a multi-space pin sed-matches the original file byte-for-byte (#599 review) ===\n'
gha_sed_ws_tmp="$(mktemp -d)"
mkdir -p "${gha_sed_ws_tmp}/.github/workflows"
cat >"${gha_sed_ws_tmp}/.github/workflows/ci.yml" <<'EOF'
jobs:
  build:
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1   #   v7.0.1
EOF
gha_sed_ws_out="$(
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC2317,SC2329
  _gha_ref_sortable_version() {
    local -r ref="$1"
    local ver="${ref#v}"
    if [[ "$ver" =~ ^[0-9]+$ ]]; then
      printf '%s.0.0' "$ver"
    else
      printf '%s' "$ver"
    fi
  }
  # shellcheck disable=SC2317,SC2329
  _gha_semver_release_tags_desc() { printf 'v7.0.2\n'; }
  # shellcheck disable=SC2317,SC2329
  _gha_pick_eligible_new_ref() {
    local -r action="$1"
    local -r ref="$2"
    if [[ "$action" == 'actions/checkout' && "$ref" == 'v7.0.1' ]]; then
      printf 'v7.0.2'
      return 0
    fi
    return 1
  }
  # shellcheck disable=SC2317,SC2329
  _gha_resolve_tag_commit_sha() {
    local -r action="$1"
    local -r tag="$2"
    if [[ "$action" == 'actions/checkout' && "$tag" == 'v7.0.2' ]]; then
      printf 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
      return 0
    fi
    return 1
  }
  # shellcheck disable=SC1090
  eval "$(awk '/^gha_outdated\(\)/{p=1} p{print} p && /^}/{exit}' "$script")"
  gha_outdated "$gha_sed_ws_tmp"
)"
IFS=$'\t' read -r gha_sed_ws_action gha_sed_ws_cur gha_sed_ws_new <<<"$gha_sed_ws_out"
gha_sed_ws_gnu_sed="$(command -v gsed 2>/dev/null || command -v sed)"
find "${gha_sed_ws_tmp}/.github/workflows" -maxdepth 1 \( -name '*.yml' -o -name '*.yaml' \) \
  -exec "$gha_sed_ws_gnu_sed" -i \
    -e "s|uses: ${gha_sed_ws_action}@${gha_sed_ws_cur}|uses: ${gha_sed_ws_action}@${gha_sed_ws_new}|g" \
    {} +
gha_sed_ws_result="$(grep 'uses: actions/checkout' "${gha_sed_ws_tmp}/.github/workflows/ci.yml")"
gha_sed_ws_expected='      - uses: actions/checkout@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # v7.0.2'
if [[ "$gha_sed_ws_result" == "$gha_sed_ws_expected" ]]; then
  printf '[PASS] gha_outdated cur_ref for a multi-space pin sed-matches the original file, not a silent no-op\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated cur_ref failed to sed-match the original multi-space pin: got %q\n' "$gha_sed_ws_result"
  fail=$(( fail + 1 ))
fi
rm -rf "$gha_sed_ws_tmp"

printf '\n=== static: gha_outdated resolves SHA-pinned actions to a new commit SHA, and all gha_lines consumers are tab-delimited (#599) ===\n'
gha_outdated_fn="$(awk '/^gha_outdated\(\)/,/^}$/' "$script")"
if grep -qF '_gha_resolve_tag_commit_sha' <<<"$gha_outdated_fn" \
  && grep -qF "printf '%s\\t%s\\t%s\\n'" "$script" \
  && [[ "$(grep -c "while IFS=\$'\\\\t' read -r action cur_ref new_ref" "$script")" -eq 8 ]] \
  && [[ "$(grep -c "while IFS=' ' read -r action cur_ref new_ref" "$script")" -eq 0 ]]; then
  printf '[PASS] gha_outdated: SHA-pin resolution wired in; every gha_lines consumer reads tab-delimited fields\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing SHA resolution or a gha_lines consumer still reads space-delimited fields\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must use dep-updates/gha- branch prefix
if awk '/^gha_update_one\(\)/{found=1} found && /dep-updates\/gha-/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_update_one: uses dep-updates/gha- branch prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: dep-updates/gha- branch prefix not found\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must use find + sed to patch workflow files (not a hardcoded filename)
# find and sed -i are on separate continuation lines, so check for both separately.
find_in_gha="$(awk '/^gha_update_one\(\)/{found=1} found && /find.*\.github\/workflows/{ok=1} found && /^}/{found=0} END{print ok+0}' "$script")"
sed_in_gha="$(awk '/^gha_update_one\(\)/{found=1} found && /tooling_prereq_gnu_sed_path/{ok=1} found && /^}/{found=0} END{print ok+0}' "$script")"
if [[ "$find_in_gha" == '1' && "$sed_in_gha" == '1' ]]; then
  printf '[PASS] gha_update_one: uses find + GNU sed to patch all workflow files\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: find + sed workflow patching not found (find=%s, sed=%s)\n' \
    "$find_in_gha" "$sed_in_gha"
  fail=$(( fail + 1 ))
fi

# gha_update_one must stage .github/workflows/ via git add
if awk '/^gha_update_one\(\)/{found=1} found && /git.*add.*\.github\/workflows/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_update_one: stages .github/workflows/ after patching\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: git add .github/workflows/ not found\n'
  fail=$(( fail + 1 ))
fi

# gha_lines must be gathered in the dry-run block
# shellcheck disable=SC2016  # single-quoted: searching for literal $() in source
if grep -q 'gha_lines="$(gha_outdated' "$script"; then
  printf '[PASS] main: gha_lines gathered via gha_outdated() in both modes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: gha_lines gathering via gha_outdated() not found\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must be called in the update loop
# shellcheck disable=SC2016  # single-quoted: searching for literal $var in source
if grep -q 'gha_update_one "$action" "$cur_ref" "$new_ref"' "$script"; then
  printf '[PASS] main: gha_update_one called in update loop\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: gha_update_one not called in update loop\n'
  fail=$(( fail + 1 ))
fi

# parse_args ecosystem validation must accept gha and rust
if grep -q 'npm|python|rust|gha|auto' "$script"; then
  printf '[PASS] parse_args: rust and gha accepted as valid --ecosystem values\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] parse_args: rust or gha not in --ecosystem validation\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Isolated repo for dry-run smoke tests (avoids mutating the stack/primary clone).
# ---------------------------------------------------------------------------

dry_run_make_isolated_repo() {
  DRY_RUN_ISOLATED_REPO="$(mktemp -d)"
  DRY_RUN_ISOLATED_ORIGIN="$(mktemp -d)"
  git -C "$DRY_RUN_ISOLATED_ORIGIN" init -q --bare
  git -C "$DRY_RUN_ISOLATED_REPO" init -q
  git -C "$DRY_RUN_ISOLATED_REPO" checkout -b main >/dev/null 2>&1 || true
  git -C "$DRY_RUN_ISOLATED_REPO" \
    -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
    commit --allow-empty -q -m init
  git -C "$DRY_RUN_ISOLATED_REPO" remote add origin "$DRY_RUN_ISOLATED_ORIGIN"
  git -C "$DRY_RUN_ISOLATED_REPO" push -u origin main -q
}

dry_run_cleanup_isolated_repo() {
  rm -rf "${DRY_RUN_ISOLATED_REPO:-}" "${DRY_RUN_ISOLATED_ORIGIN:-}"
  unset DRY_RUN_ISOLATED_REPO DRY_RUN_ISOLATED_ORIGIN
}

# ---------------------------------------------------------------------------
# Run one dry-run invocation and capture output + exit code.
# ---------------------------------------------------------------------------

run_dry_run() {
  local -r label="$1"
  local -r extra_flags="${2:-}"
  local output exit_code tmp_repo
  local tmpfile
  tmpfile="$(mktemp)"
  dry_run_make_isolated_repo
  tmp_repo="$DRY_RUN_ISOLATED_REPO"
  set +e
  # shellcheck disable=SC2086  # word-split intentional for extra_flags
  "$script" --dry-run --dir "$tmp_repo" $extra_flags >"$tmpfile" 2>&1
  exit_code=$?
  set -e
  output="$(cat "$tmpfile")"
  rm -f "$tmpfile"
  dry_run_cleanup_isolated_repo

  assert_exit_0   "$label" "$output" "$exit_code"
  # Worktree lifecycle — the core invariant: created and destroyed on every dry-run
  assert_contains "$label" "$output" "[worktree] Creating worktree at:"
  assert_contains "$label" "$output" "[worktree] Ready:"
  assert_contains "$label" "$output" "[worktree] Removed:"
  # Worktree must be under TMPDIR / /tmp, never next to the source repo
  assert_contains "$label" "$output" "[worktree] Creating worktree at: ${TMPDIR:-/tmp}/"
  # No ecosystem → no change
  assert_contains "$label" "$output" "No supported ecosystem detected"
}

# ---------------------------------------------------------------------------
# Test: non-batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== static: dry-run uses isolated temp repo ===\n'
# shellcheck disable=SC2016  # intentional literal grep for dry-run --dir wiring
if grep -q '^dry_run_make_isolated_repo()' "${script_dir}/dep-updater.test" \
  && grep -qF 'dry_run_make_isolated_repo' "${script_dir}/dep-updater.test" \
  && grep -qF -- '--dry-run --dir "$tmp_repo"' "${script_dir}/dep-updater.test"; then
  printf '[PASS] dry-run smoke: uses isolated temp repo instead of script_dir\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dry-run smoke: expected isolated temp repo helper for dry-run tests\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== non-batch dry-run ===\n'
run_dry_run "non-batch" ""

# ---------------------------------------------------------------------------
# Test: batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== batch dry-run ===\n'
run_dry_run "batch" "--batch"

# ---------------------------------------------------------------------------
# Test: --batch --all dry-run from a non-git cwd (two child repos)
# ---------------------------------------------------------------------------

printf '\n=== batch --all dry-run ===\n'
batch_all_tmp="$(mktemp -d)"
batch_home="${batch_all_tmp}/home"
mkdir -p "${batch_all_tmp}/roots/alpha" "${batch_all_tmp}/roots/beta" \
  "${batch_home}/.local/bin"
# CI runners often have no global git identity; -c matches other tests in this file.
git -C "${batch_all_tmp}/roots/alpha" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  init -q
git -C "${batch_all_tmp}/roots/alpha" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/alpha.git'
git -C "${batch_all_tmp}/roots/alpha" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init
git -C "${batch_all_tmp}/roots/beta" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  init -q
git -C "${batch_all_tmp}/roots/beta" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/beta.git'
git -C "${batch_all_tmp}/roots/beta" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

cat >"${batch_home}/.local/bin/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == 'stack --help' ]]; then
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' $'alpha\tfalse\tfalse' $'beta\tfalse\tfalse'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${batch_home}/.local/bin/gh"

roots_real=""
roots_real="$(realpath "${batch_all_tmp}/roots")"

batch_all_out=""
batch_all_exit=0
set +e
batch_all_out="$(
  cd "$batch_all_tmp" \
    && HOME="$batch_home" PATH="${batch_home}/.local/bin:${PATH}" \
      "$script" --batch --all --dry-run --scan-root "${batch_all_tmp}/roots" 2>&1
)"
batch_all_exit=$?
set -e

rm -rf "$batch_all_tmp"

assert_exit_0 "batch --all dry-run (two repos)" "$batch_all_out" "$batch_all_exit"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] Top-level scan directories:"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all]   ${roots_real}"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] Org: the-hcma"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] --- alpha"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] --- beta"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] All repos completed successfully."
# batch-all runs child dep-updater processes; their worktree logs are captured separately.

printf '\n=== batch --all skips private GitHub repos by default ===\n'
private_batch_tmp="$(mktemp -d)"
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
# tooling_path_bootstrap_node_ecosystem prepends $HOME/.local/bin; put the mock there so it
# wins over a real ~/.local/bin/gh on developer machines (CI often has no such binary).
private_home="${private_batch_tmp}/home"
mkdir -p "$mock_bin" "${private_home}/.local/bin" \
  "${private_batch_tmp}/roots/public-repo" "${private_batch_tmp}/roots/private-repo"

git -C "${private_batch_tmp}/roots/public-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com init -q
git -C "${private_batch_tmp}/roots/public-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/public-repo.git'
git -C "${private_batch_tmp}/roots/public-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

git -C "${private_batch_tmp}/roots/private-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com init -q
git -C "${private_batch_tmp}/roots/private-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/private-repo.git'
git -C "${private_batch_tmp}/roots/private-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
# Child --dir runs probe gh stack after the missing-marker default (issue #493).
if [[ "$args" == 'stack --help' ]]; then
  exit 0
fi
# Org discovery returns full membership TSV (name, private, archived).
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' $'public-repo\tfalse\tfalse' $'private-repo\ttrue\tfalse'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"
cp "${mock_bin}/gh" "${private_home}/.local/bin/gh"

private_batch_out=""
private_batch_exit=0
set +e
private_batch_out="$(
  cd "$private_batch_tmp" \
    && HOME="${private_home}" PATH="${mock_bin}:${PATH}" \
      "$script" --batch --all --dry-run --scan-root "${private_batch_tmp}/roots" 2>&1
)"
private_batch_exit=$?
set -e
rm -rf "$private_batch_tmp" "$mock_dir"

assert_exit_0 "batch --all skips private repo" "$private_batch_out" "$private_batch_exit"
assert_contains "batch --all skips private repo" "$private_batch_out" "[batch-all] --- public-repo"
assert_not_contains "batch --all skips private repo" "$private_batch_out" "[batch-all] --- private-repo"
assert_contains "batch --all skips private repo" "$private_batch_out" \
  "[batch-all] Skipping the-hcma/private-repo: private org repository (use --include-private)"
assert_not_contains "batch --all skips private repo" "$private_batch_out" \
  "local clone not in org membership"

printf '\n=== batch --all skips archived GitHub repos ===\n'
archived_batch_tmp="$(mktemp -d)"
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
archived_home="${archived_batch_tmp}/home"
mkdir -p "$mock_bin" "${archived_home}/.local/bin" \
  "${archived_batch_tmp}/roots/active-repo" "${archived_batch_tmp}/roots/archived-repo"

git -C "${archived_batch_tmp}/roots/active-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com init -q
git -C "${archived_batch_tmp}/roots/active-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/active-repo.git'
