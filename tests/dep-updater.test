fi

if grep -qF 'pnpm_in_project()' "$script" \
  && ! grep -E '^[[:space:]]*[^#].*pnpm --dir' "$script"; then
  printf '[PASS] pnpm-in-project: uses pnpm_in_project instead of pnpm --dir\n'
  pass=$(( pass + 1 ))
else
  if grep -qF 'pnpm_in_project()' "$script"; then
    printf '[FAIL] pnpm-in-project: pnpm --dir still invoked in code — use pnpm_in_project\n'
    fail=$(( fail + 1 ))
  else
    printf '[FAIL] pnpm-in-project: missing pnpm_in_project helper\n'
    fail=$(( fail + 1 ))
  fi
fi

printf '\n=== static: batch gh merge via finalize_prs ===\n'
# shellcheck disable=SC2016
if grep -q '^finalize_prs()' "$script" \
  && grep -q '^merge_prs_via_gh()' "$script" \
  && grep -qF "merge_via='gh'" "$script" \
  && grep -qF -- '--merge-via' "$script"; then
  printf '[PASS] merge-via: finalize_prs and gh merge helpers are defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-via: expected finalize_prs, merge_prs_via_gh, and --merge-via flag\n'
  fail=$(( fail + 1 ))
fi

# Org default is GitHub MQ via gh --auto (issue #466); leftover merge-it must not
# select Graphite label enqueue.
# shellcheck disable=SC2016
gh_merge_body="$(awk '/^merge_pr_via_gh_single\(\)/,/^\}/' "$script")"
if grep -qF 'Enabling auto-merge for PR' <<<"$gh_merge_body" \
  && grep -qF -- '--auto --squash' <<<"$gh_merge_body" \
  && ! grep -qF 'Repo uses Graphite merge queue' <<<"$gh_merge_body" \
  && ! grep -qF 'falling back to merge-it' <<<"$gh_merge_body"; then
  printf '[PASS] merge-via: gh path always uses --auto --squash (no merge-it enqueue)\n'
  pass=$(( pass + 1 ))
else
