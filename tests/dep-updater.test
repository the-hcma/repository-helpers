#!/usr/bin/env bash
# Basic smoke tests for dep-updater dry-run mode.
#
# These tests run the script with --dry-run against this repository (which has
# no npm or Python ecosystem) and verify:
#   1. The script exits 0.
#   2. A worktree is created  (log line "[worktree] Creating worktree at:").
#   3. The worktree is removed (log line "[worktree] Removed:").
#   4. The output indicates that no dependencies need updating.
#
# Both non-batch and --batch modes are exercised to confirm the code paths
# do not diverge on these invariants.
#
# Prerequisites (must be on PATH): git, gt, gh, jq, rg
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

script="${script_dir}/../scripts/dep-updater"
readonly script

pass=0
fail=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

assert_exit_0() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -eq 0 ]]; then
    printf '[PASS] %s: exits 0\n' "$label"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: expected exit 0, got %d\n' "$label" "$exit_code"
    printf '       output:\n%s\n' "$output"
    fail=$(( fail + 1 ))
  fi
}

assert_contains() {
  local -r label="$1"
  local -r output="$2"
  local -r needle="$3"
  if printf '%s' "$output" | grep -qF "$needle"; then
    printf '[PASS] %s: output contains "%s"\n' "$label" "$needle"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: output does NOT contain "%s"\n' "$label" "$needle"
    printf '       output:\n%s\n' "$output"
    fail=$(( fail + 1 ))
  fi
}

# ---------------------------------------------------------------------------
# Run one dry-run invocation and capture output + exit code.
# ---------------------------------------------------------------------------

run_dry_run() {
  local -r label="$1"
  local -r extra_flags="${2:-}"
  local output exit_code
  local tmpfile
  tmpfile="$(mktemp)"
  set +e
  # shellcheck disable=SC2086  # word-split intentional for extra_flags
  "$script" --dry-run --dir "$script_dir" $extra_flags >"$tmpfile" 2>&1
  exit_code=$?
  set -e
  output="$(cat "$tmpfile")"
  rm -f "$tmpfile"

  assert_exit_0   "$label" "$output" "$exit_code"
  # Worktree lifecycle — the core invariant: created and destroyed on every dry-run
  assert_contains "$label" "$output" "[worktree] Creating worktree at:"
  assert_contains "$label" "$output" "[worktree] Ready:"
  assert_contains "$label" "$output" "[worktree] Removed:"
  # Worktree must be under TMPDIR / /tmp, never next to the source repo
  assert_contains "$label" "$output" "[worktree] Creating worktree at: ${TMPDIR:-/tmp}/"
  # No ecosystem → no change
  assert_contains "$label" "$output" "No supported ecosystem detected"
}

# ---------------------------------------------------------------------------
# Test: non-batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== non-batch dry-run ===\n'
run_dry_run "non-batch" ""

# ---------------------------------------------------------------------------
# Test: batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== batch dry-run ===\n'
run_dry_run "batch" "--batch"

# ---------------------------------------------------------------------------
# Static: no 'local -r' inside loop bodies
#
# In bash, 'local' is function-scoped. Declaring 'local -r foo=x' inside a
# loop that runs more than once will fail on the second iteration with:
#   "local: foo: readonly variable"
# Neither 'bash -n' nor shellcheck catches this — it only manifests at runtime.
# ---------------------------------------------------------------------------

printf '\n=== static: local -r in loops ===\n'
local_r_in_loops="$(awk '
  /^[[:space:]]*(while|for|until)[[:space:]]/ { depth++ }
  /^[[:space:]]*done\b/ { if (depth > 0) depth-- }
  /^}/ { depth=0 }
  /[[:space:]]local[[:space:]]+-[a-zA-Z]*r/ && depth > 0 { print NR": "$0 }
' "$script")"
if [[ -n "$local_r_in_loops" ]]; then
  printf '[FAIL] local-r-in-loops: local -r inside a loop body crashes on 2nd iteration:\n%s\n' \
    "$local_r_in_loops"
  fail=$(( fail + 1 ))
else
  printf '[PASS] local-r-in-loops: no local -r declarations inside loops\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: pinned-package detection is present
# ---------------------------------------------------------------------------

printf '\n=== static: pinned package detection ===\n'

# py_is_pinned() must be defined (still used for pip/pipenv/poetry)
if grep -q '^py_is_pinned()' "$script"; then
  printf '[PASS] py_is_pinned: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_is_pinned: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# py_is_pinned must NOT have a uv case — uv == pins are not intentional freezes;
# they should be updated and converted to >= by py_update_one.
if ! grep -A20 '^py_is_pinned()' "$script" | grep -q 'uv)'; then
  printf '[PASS] py_is_pinned: no uv case (uv == pins are updated, not skipped)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_is_pinned: uv case present — uv == pins would be silently skipped\n'
  fail=$(( fail + 1 ))
fi

# py_update_one must handle == constraint op for uv by converting to >=new (not re-pinning).
# The sed pattern must match both >= and == operators.
if grep -q '">=|==" ]]\|\[\[ .*uv_constraint_op.*==.*>=.*==\|>=|==' "$script" ||
   grep -qP 'uv_constraint_op.*==.*>=.*\|\|.*uv_constraint_op.*==.*==' "$script" ||
   grep -q '">=\|=="' "$script"; then
  printf '[PASS] py_update_one: uv handles both >= and == constraint ops\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: uv does not handle == constraint op\n'
  fail=$(( fail + 1 ))
fi

# The sed pattern in py_update_one must replace both >= and == with >= (never re-pin).
if grep -q '(?:>=|==)' "$script"; then
  printf '[PASS] py_update_one: sed converts both >= and == to >= (no re-pinning)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: sed does not handle == operator conversion\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must pass --arg semver_only to jq (semver-only uses .wanted)
if grep -q '\-\-arg semver_only' "$script"; then
  printf '[PASS] npm_outdated: passes semver_only to jq filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: --arg semver_only missing from jq call\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must pass --argjson specs to jq (local/git reference filtering)
if grep -q '\-\-argjson specs' "$script"; then
  printf '[PASS] npm_outdated: passes package.json specs to jq filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: --argjson specs missing from jq call\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must NOT skip exact-pinned packages (e.g. "3.0.0"); only local/git refs are skipped
if ! grep -q '"^\[=\]?\[0-9\]' "$script"; then
  printf '[PASS] npm_outdated: exact-pinned npm packages are not skipped (only local/git refs excluded)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: exact-pinned npm skip pattern still present — should have been removed\n'
  fail=$(( fail + 1 ))
fi

# package.json update patches must use jq explode/index to preserve range prefix
prefix_count="$(grep -c 'explode | map(. >= 48' "$script" || true)"
if (( prefix_count >= 2 )); then
  printf '[PASS] npm update patches: both use explode/index to preserve range prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm update patches: expected >=2 explode/index calls for range prefix, found %d\n' \
    "$prefix_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: CI gates separated from PR creation
# ---------------------------------------------------------------------------

printf '\n=== static: ci gates separated from pr creation ===\n'

# gate_all_created_prs() must be defined — it is the single post-creation gate pass.
if grep -q '^gate_all_created_prs()' "$script"; then
  printf '[PASS] gate_all_created_prs: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gate_all_created_prs: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# gate_all_created_prs must be called in the main flow (before maybe_label_top_pr_for_merge).
if grep -q 'gate_all_created_prs$' "$script"; then
  printf '[PASS] gate_all_created_prs: called in main flow\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gate_all_created_prs: not called as a standalone statement in main flow\n'
  fail=$(( fail + 1 ))
fi

# npm_update_group must NOT contain a per-PR CI gate (no_wait_ci check inside it).
# Extract just the npm_update_group function body and verify the gate was removed.
npm_gate_count="$(awk '/^npm_update_group\(\)/{found=1} found && /^}$/{found=0} found && /no_wait_ci/' "$script" | wc -l | tr -d ' ')"
if [[ "$npm_gate_count" -eq 0 ]]; then
  printf '[PASS] npm_update_group: per-PR CI gate removed (no no_wait_ci check inside)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_update_group: per-PR CI gate still present (%s occurrences of no_wait_ci)\n' \
    "$npm_gate_count"
  fail=$(( fail + 1 ))
fi

# py_update_one must NOT contain a per-PR CI gate.
py_gate_count="$(awk '/^py_update_one\(\)/{found=1} found && /^}$/{found=0} found && /no_wait_ci/' "$script" | wc -l | tr -d ' ')"
if [[ "$py_gate_count" -eq 0 ]]; then
  printf '[PASS] py_update_one: per-PR CI gate removed (no no_wait_ci check inside)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: per-PR CI gate still present (%s occurrences of no_wait_ci)\n' \
    "$py_gate_count"
  fail=$(( fail + 1 ))
fi

# batch_update_all must NOT contain a per-PR CI gate.
batch_gate_count="$(awk '/^batch_update_all\(\)/{found=1} found && /^}$/{found=0} found && /no_wait_ci/' "$script" | wc -l | tr -d ' ')"
if [[ "$batch_gate_count" -eq 0 ]]; then
  printf '[PASS] batch_update_all: per-PR CI gate removed (no no_wait_ci check inside)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch_update_all: per-PR CI gate still present (%s occurrences of no_wait_ci)\n' \
    "$batch_gate_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: constraint-dependencies isolation
# ---------------------------------------------------------------------------

printf '\n=== static: constraint-dependencies isolation ===\n'

# py_outdated ge-floor extraction must use awk section tracking, not rg -o, so
# constraint-dependencies entries (which rg -o cannot filter from context) are excluded.
if grep -q 'in_direct = 1' "$script"; then
  printf '[PASS] py_outdated: uses awk section tracking to skip constraint-dependencies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: awk section tracking (in_direct) not found; constraint-dependencies may leak\n'
  fail=$(( fail + 1 ))
fi

# The output loop in py_outdated must validate PEP 508 package names to drop
# any mangled strings (e.g. "constraint-dependencies=[...") that slip through.
if grep -A3 'while IFS=.*read.*pkg cur new' "$script" \
    | grep -q 'A-Za-z0-9.*A-Za-z0-9\._-'; then
  printf '[PASS] py_outdated: output loop validates PEP 508 package names\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: PEP 508 name validation missing from output loop\n'
  fail=$(( fail + 1 ))
fi

# py_outdated must probe resolvability with 'uv pip install --dry-run' so that
# packages blocked by transitive constraints (e.g. amqtt pinning click<8.2) are
# filtered from the report before being shown as available updates.
if grep -q 'uv pip install --dry-run' "$script"; then
  printf '[PASS] py_outdated: probes resolvability with uv pip install --dry-run\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: uv pip install --dry-run probe missing\n'
  fail=$(( fail + 1 ))
fi

# The probe must pass all installed packages as pinned requirements (not just
# --constraint), so that the resolver sees transitive Requires-Dist from other
# packages and fails when they conflict with the candidate upgrade.
if grep -q -- '-r /dev/stdin' "$script"; then
  printf '[PASS] py_outdated: probe uses -r /dev/stdin (requirements, not constraints)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: probe must use -r /dev/stdin to catch Requires-Dist conflicts\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Behavioural: uv transitive-constraint probe
# ---------------------------------------------------------------------------

printf '\n=== behavioural: uv transitive-constraint probe ===\n'

# The probe pipes all installed packages (with pkg replaced by new_ver) as
# requirements to 'uv pip install --dry-run'.  Test the jq pipeline directly:
# given a synthetic installed_json, it must emit pkg==new_ver for the target
# package and name==current_ver for all others, with editable installs excluded.
if ! command -v jq >/dev/null 2>&1; then
  printf '[SKIP] jq not on PATH — skipping probe jq-pipeline test\n'
else
  synthetic_json='[
    {"name":"click","version":"8.1.8"},
    {"name":"typer","version":"0.15.4"},
    {"name":"my-pkg","version":"0.1.0","editable_project_location":"/src/my-pkg"}
  ]'
  probe_output="$(printf '%s' "$synthetic_json" \
    | jq -r --arg p "click" --arg v "8.3.2" \
        '.[] | select(has("editable_project_location") | not)
             | if (.name | ascii_downcase) == ($p | ascii_downcase)
               then "\(.name)==" + $v
               else "\(.name)==\(.version)"
               end')"
  expected="$(printf 'click==8.3.2\ntyper==0.15.4')"
  if [[ "$probe_output" == "$expected" ]]; then
    printf '[PASS] probe jq pipeline: target replaced, others pinned, editable excluded\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] probe jq pipeline: unexpected output\n'
    printf '       expected: %s\n' "$expected"
    printf '       got:      %s\n' "$probe_output"
    fail=$(( fail + 1 ))
  fi
fi

# Live probe: run the real uv dry-run against the my-tracks venv if present.
# This validates the full pipeline catches a transitive constraint violation
# (amqtt→typer==0.15.4→click<8.2 blocks click 8.3.2).
my_tracks_dir="${HOME}/work/ai/my-tracks"
if ! command -v uv >/dev/null 2>&1; then
  printf '[SKIP] uv not on PATH — skipping live probe test\n'
elif [[ ! -d "${my_tracks_dir}/.venv" ]]; then
  printf '[SKIP] my-tracks venv not found — skipping live probe test\n'
else
  if ! cd "$my_tracks_dir"; then
    live_installed_json=""
  else
    live_installed_json="$(uv pip list --format=json 2>/dev/null || true)"
  fi
  if [[ -z "$live_installed_json" ]]; then
    printf '[SKIP] uv pip list failed in my-tracks — skipping live probe test\n'
  else
    # click==8.3.2 must be blocked (typer==0.15.4 requires click<8.2)
    live_blocked=0
    if printf '%s' "$live_installed_json" \
        | jq -r --arg p "click" --arg v "8.3.2" \
            '.[] | select(has("editable_project_location") | not)
                 | if (.name | ascii_downcase) == ($p | ascii_downcase)
                   then "\(.name)==" + $v
                   else "\(.name)==\(.version)"
                   end' \
        | (cd "$my_tracks_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
      live_blocked=1  # exit 0 = probe thinks it's fine — wrong
    fi
    if [[ "$live_blocked" -eq 0 ]]; then
      printf '[PASS] live probe: click==8.3.2 blocked by my-tracks transitive constraints\n'
      pass=$(( pass + 1 ))
    else
      printf '[FAIL] live probe: click==8.3.2 was NOT blocked — transitive constraint not detected\n'
      fail=$(( fail + 1 ))
    fi

    # An unblocked upgrade (shellcheck-py) must pass through the probe.
    live_sc_ver="$(printf '%s' "$live_installed_json" \
      | jq -r '.[] | select(.name == "shellcheck-py") | .version' 2>/dev/null || true)"
    if [[ -n "$live_sc_ver" ]]; then
      live_sc_ok=0
      if printf '%s' "$live_installed_json" \
          | jq -r --arg p "shellcheck-py" --arg v "0.11.0.1" \
              '.[] | select(has("editable_project_location") | not)
                   | if (.name | ascii_downcase) == ($p | ascii_downcase)
                     then "\(.name)==" + $v
                     else "\(.name)==\(.version)"
                     end' \
          | (cd "$my_tracks_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
        live_sc_ok=1
      fi
      if [[ "$live_sc_ok" -eq 1 ]]; then
        printf '[PASS] live probe: shellcheck-py==0.11.0.1 allowed in my-tracks\n'
        pass=$(( pass + 1 ))
      else
        printf '[FAIL] live probe: shellcheck-py==0.11.0.1 was incorrectly rejected\n'
        fail=$(( fail + 1 ))
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Static: >= floor revert on failure
# ---------------------------------------------------------------------------

printf '\n=== static: >= floor revert on failure ===\n'

# py_update_one must revert pyproject.toml when uv lock fails after a sed patch
# so the file is not left dirty and does not corrupt subsequent update attempts.
revert_count=0
revert_count="$(grep -c 'checkout -- pyproject.toml' "$script" 2>/dev/null || true)"
if (( revert_count >= 2 )); then
  printf '[PASS] pyproject.toml revert: present in both py_update_one and batch_update_all\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pyproject.toml revert: expected >=2 occurrences, found %d\n' "$revert_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: uv >= constraint floor detection
# ---------------------------------------------------------------------------

printf '\n=== static: uv >= floor detection ===\n'

# py_constraint_op() must be defined — used to preserve >= vs == when updating
if grep -q '^py_constraint_op()' "$script"; then
  printf '[PASS] py_constraint_op: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_constraint_op: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# py_outdated must contain the stale-floor detection variable ge_floor
if grep -q 'ge_floor' "$script"; then
  printf '[PASS] py_outdated: contains ge_floor stale-floor detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: ge_floor stale-floor detection missing\n'
  fail=$(( fail + 1 ))
fi

# py_update_one must call py_constraint_op to preserve the original operator
if grep -q 'py_constraint_op' "$script"; then
  printf '[PASS] py_update_one: calls py_constraint_op to detect >= vs ==\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: py_constraint_op call missing\n'
  fail=$(( fail + 1 ))
fi

# batch_update_all must use staged pyproject.toml diff to determine actual changes
# (not py_lines_arg directly) so transitive-only packages are excluded from the PR body
if grep -q 'diff --cached -- pyproject.toml' "$script"; then
  printf '[PASS] batch_update_all: uses staged diff to build actual Python update list\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch_update_all: staged diff for actual_py_lines not found\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: worktree naming and leak guards
# ---------------------------------------------------------------------------

printf '\n=== static: worktree naming and leak guards ===\n'

# Worktree directory name must use dep-updater-wt- prefix (not the old repo-name-dep-update- form)
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${timestamp} in source
if grep -q 'dep-updater-wt-\${timestamp}' "$script"; then
  printf '[PASS] create_worktree: uses dep-updater-wt- prefix for directory name\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] create_worktree: dep-updater-wt- prefix not found\n'
  fail=$(( fail + 1 ))
fi

# Old repo-name-dep-update- pattern must be gone
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${repo_name} in source
if grep -q '\${repo_name}-dep-update-' "$script"; then
  printf '[FAIL] create_worktree: old repo_name-dep-update- pattern still present\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] create_worktree: old repo_name-dep-update- pattern removed\n'
  pass=$(( pass + 1 ))
fi

# _cleanup_trap_active must be set to 1 immediately after create_worktree in dry-run
# (guards the worktree against leaks when a command in the dry-run block fails)
dry_run_block="$(awk '/^if \[\[ "\$dry_run" == .1. \]\]; then/,/^fi$/' "$script")"
if printf '%s' "$dry_run_block" | grep -q '_cleanup_trap_active=1'; then
  printf '[PASS] dry-run block: _cleanup_trap_active=1 set after create_worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dry-run block: _cleanup_trap_active=1 missing — dry-run worktrees will leak on error\n'
  fail=$(( fail + 1 ))
fi

# _dry_run_teardown must reset _cleanup_trap_active=0 before removing the worktree
# (prevents the EXIT trap from double-invoking cleanup_on_error)
teardown_block="$(awk '/^_dry_run_teardown\(\) \{/,/^}/' "$script")"
if printf '%s' "$teardown_block" | grep -q '_cleanup_trap_active=0'; then
  printf '[PASS] _dry_run_teardown: resets _cleanup_trap_active=0 before removal\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] _dry_run_teardown: missing _cleanup_trap_active=0 reset\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: state file scratch location
# ---------------------------------------------------------------------------

printf '\n=== static: state file scratch location ===\n'

# State file must live in the scratch/tmp dir, not in ${dir}
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${dir}/ in source
if grep -q 'state_file="${dir}/' "$script"; then
  printf '[FAIL] init_state_file: state_file still set to ${dir}/... (must use scratch dir)\n'
  fail=$(( fail + 1 ))
else
  # shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${dir}/ in source
  printf '[PASS] init_state_file: state_file does not use ${dir}/ prefix\n'
  pass=$(( pass + 1 ))
fi

# State file must use the new .dep-updater-state name (not .dep-update-state)
if grep -q '\.dep-update-state' "$script"; then
  printf '[FAIL] state file: old .dep-update-state name still present\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] state file: old .dep-update-state name removed\n'
  pass=$(( pass + 1 ))
fi

if grep -q '\.dep-updater-state' "$script"; then
  printf '[PASS] state file: new .dep-updater-state name present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] state file: new .dep-updater-state name not found\n'
  fail=$(( fail + 1 ))
fi

# State file path must include a repo-unique hash derived from $dir
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${repo_hash} in source
if grep -q 'dep-updater-state-\${repo_hash}' "$script"; then
  # shellcheck disable=SC2016  # single-quoted pattern is intentional
  printf '[PASS] init_state_file: path includes ${repo_hash} for per-repo uniqueness\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] init_state_file: per-repo hash suffix not found\n'
  fail=$(( fail + 1 ))
fi

# ensure_gitignore must no longer exist (state file is not in the repo)
if grep -q 'ensure_gitignore' "$script"; then
  printf '[FAIL] ensure_gitignore: function or call still present (state file moved out of repo)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] ensure_gitignore: removed (state file no longer lives in the repo)\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no hardcoded /tmp/ PR body-file paths (file leakage)
# ---------------------------------------------------------------------------

printf '\n=== static: no hardcoded /tmp/ PR body-file paths ===\n'

# All PR body files must use mktemp (caller-provided path) so they are uniquely
# named, not shared across concurrent runs, and deleted after use.
# A hardcoded /tmp/dep-updater-pr-* path leaks into /tmp on every run and can
# expose PR body content to other local users.  The older /tmp/dep-update-pr-*
# (typo, missing trailing 'r') is also forbidden.
if grep -qE '"/tmp/dep-updat(e|er)-pr-' "$script"; then
  printf '[FAIL] body-file-leakage: hardcoded /tmp/dep-updat(e|er)-pr-* path found\n'
  grep -nE '"/tmp/dep-updat(e|er)-pr-' "$script" | while IFS= read -r match; do
    printf '       %s\n' "$match"
  done
  fail=$(( fail + 1 ))
else
  printf '[PASS] body-file-leakage: no hardcoded /tmp/dep-updat*-pr-* paths\n'
  pass=$(( pass + 1 ))
fi

# write_npm_pr_body and write_pr_body must accept a body_file parameter
# (5th and 7th arg respectively) rather than deriving the path internally.
if awk '/^write_npm_pr_body\(\)/{found=1} found && /body_file="\$5"/{ok=1} found && /^}$/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] write_npm_pr_body: accepts body_file as 5th argument\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] write_npm_pr_body: 5th-arg body_file not found — function still hardcodes path\n'
  fail=$(( fail + 1 ))
fi

if awk '/^write_pr_body\(\)/{found=1} found && /body_file="\$7"/{ok=1} found && /^}$/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] write_pr_body: accepts body_file as 7th argument\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] write_pr_body: 7th-arg body_file not found — function still hardcodes path\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: py_audit runs uv with --frozen ===\n'

# py_audit must pass --frozen to uv run so it does not sync (and potentially
# rewrite uv.lock) in the source repository before running pip-audit.
# Without --frozen, uv run updates uv.lock as a side effect, leaving
# uncommitted changes behind in the source repo's working tree.
if awk '/^py_audit\(\)/{found=1} found && /uv run --frozen/{ok=1} found && /^}$/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] py_audit: uv run uses --frozen to prevent lockfile updates\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_audit: uv run --frozen not found — may write uv.lock in the source repo\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: create_worktree fast-forwards working tree after update-ref ===\n'

# After fast-forwarding the branch pointer via git update-ref, create_worktree
# must also update the working tree when main is checked out and clean.
# Without this, the source repo's working tree stays at the old commit and
# appears dirty relative to the fast-forwarded HEAD.
if awk '/git -C "\$dir" update-ref refs\/heads\/main/{ found=1 }
        found && /git -C "\$dir" reset --hard "\$main_sha"/ { ok=1 }
        END { exit !ok }' "$script"; then
  printf '[PASS] create_worktree: resets working tree after fast-forwarding main\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] create_worktree: git reset --hard after update-ref not found — working tree will appear dirty\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: GitHub Actions ecosystem
# ---------------------------------------------------------------------------

printf '\n=== static: github-actions ecosystem ===\n'

# has_gha global variable must be declared
if grep -q '^has_gha=0' "$script"; then
  printf '[PASS] has_gha: global variable declared with default 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] has_gha: global variable not declared\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated() function must be defined
if grep -q '^gha_outdated()' "$script"; then
  printf '[PASS] gha_outdated: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one() function must be defined
if grep -q '^gha_update_one()' "$script"; then
  printf '[PASS] gha_update_one: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# detect_ecosystem() must set has_gha=1 when gha or auto ecosystem
if grep -A5 "ecosystem.*'gha'.*auto\|ecosystem.*gha.*auto" "$script" | grep -q 'has_gha=1'; then
  printf '[PASS] detect_ecosystem: sets has_gha=1 for gha/auto ecosystem\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] detect_ecosystem: has_gha=1 not set for gha/auto ecosystem\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must skip commit-SHA pins (40 hex chars)
# Note: awk ERE {n} quantifiers are not supported by all awk implementations
# (e.g. mawk); use grep -P or search for the literal pattern text instead.
if grep -qP '0-9a-fA-F\]\{40\}' "$script" 2>/dev/null \
    || grep -q '0-9a-fA-F]{40}' "$script"; then
  printf '[PASS] gha_outdated: skips commit-SHA pins (40 hex chars)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: commit-SHA pin guard not found\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must skip local actions starting with ./
if awk '/^gha_outdated\(\)/{found=1} found && /\.\//{ ok=1 } found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: skips local actions (./path/to/action)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: local action guard not found\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must detect major-only pins (v[0-9]+) and only bump on major increment
if awk '/^gha_outdated\(\)/{found=1} found && /\^v\[0-9\]\+\$/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: detects major-only pin style (^v[0-9]+$)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: major-only pin detection regex not found\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must use sort -V for full-semver version comparison (never downgrade)
if awk '/^gha_outdated\(\)/{found=1} found && /sort -V/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: uses sort -V for full-semver version comparison\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: sort -V not found in gha_outdated\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must use dep-updates/gha- branch prefix
if awk '/^gha_update_one\(\)/{found=1} found && /dep-updates\/gha-/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_update_one: uses dep-updates/gha- branch prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: dep-updates/gha- branch prefix not found\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must use find + sed to patch workflow files (not a hardcoded filename)
# find and sed -i are on separate continuation lines, so check for both separately.
find_in_gha="$(awk '/^gha_update_one\(\)/{found=1} found && /find.*\.github\/workflows/{ok=1} found && /^}/{found=0} END{print ok+0}' "$script")"
sed_in_gha="$(awk '/^gha_update_one\(\)/{found=1} found && /sed -i/{ok=1} found && /^}/{found=0} END{print ok+0}' "$script")"
if [[ "$find_in_gha" == '1' && "$sed_in_gha" == '1' ]]; then
  printf '[PASS] gha_update_one: uses find + sed to patch all workflow files\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: find + sed workflow patching not found (find=%s, sed=%s)\n' \
    "$find_in_gha" "$sed_in_gha"
  fail=$(( fail + 1 ))
fi

# gha_update_one must stage .github/workflows/ via git add
if awk '/^gha_update_one\(\)/{found=1} found && /git.*add.*\.github\/workflows/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_update_one: stages .github/workflows/ after patching\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: git add .github/workflows/ not found\n'
  fail=$(( fail + 1 ))
fi

# gha_lines must be gathered in the dry-run block
# shellcheck disable=SC2016  # single-quoted: searching for literal $() in source
if grep -q 'gha_lines="$(gha_outdated)"' "$script"; then
  printf '[PASS] main: gha_lines gathered via gha_outdated() in both modes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: gha_lines gathering via gha_outdated() not found\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must be called in the update loop
# shellcheck disable=SC2016  # single-quoted: searching for literal $var in source
if grep -q 'gha_update_one "$action" "$cur_ref" "$new_ref"' "$script"; then
  printf '[PASS] main: gha_update_one called in update loop\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: gha_update_one not called in update loop\n'
  fail=$(( fail + 1 ))
fi

# parse_args ecosystem validation must accept gha
if grep -q 'npm|python|gha|auto' "$script"; then
  printf '[PASS] parse_args: gha accepted as valid --ecosystem value\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] parse_args: gha not in --ecosystem validation\n'
  fail=$(( fail + 1 ))
fi

# Behavioural: gha_outdated logic for major-only pins
# Given a current_major and latest_major, the new_ref should be v${latest_major}
# when latest_major > current_major, and empty otherwise.
printf '\n=== behavioural: gha pin-style comparison logic ===\n'

# Major-only: v6 → v8 (latest_major=8 > current_major=6) → new_ref=v8
major_bump_result=""
major_bump_result="$(
  current_ref="v6"
  current_major="${current_ref#v}"
  latest_tag="v8.1.0"
  latest_major="$(printf '%s' "$latest_tag" | sed -E 's/^v?([0-9]+).*/\1/')"
  new_ref=""
  if (( latest_major > current_major )); then
    new_ref="v${latest_major}"
  fi
  printf '%s' "$new_ref"
)"
if [[ "$major_bump_result" == 'v8' ]]; then
  printf '[PASS] major-only pin: v6 bumped to v8 when latest is v8.1.0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] major-only pin: expected v8, got "%s"\n' "$major_bump_result"
  fail=$(( fail + 1 ))
fi

# Major-only: v6 → no update when latest is v6.0.2
major_no_bump_result=""
major_no_bump_result="$(
  current_ref="v6"
  current_major="${current_ref#v}"
  latest_tag="v6.0.2"
  latest_major="$(printf '%s' "$latest_tag" | sed -E 's/^v?([0-9]+).*/\1/')"
  new_ref=""
  if (( latest_major > current_major )); then
    new_ref="v${latest_major}"
  fi
  printf '%s' "$new_ref"
)"
if [[ -z "$major_no_bump_result" ]]; then
  printf '[PASS] major-only pin: v6 not bumped when latest is v6.0.2 (same major)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] major-only pin: unexpected new_ref "%s" for v6 when latest is v6.0.2\n' "$major_no_bump_result"
  fail=$(( fail + 1 ))
fi

# Full semver with v-prefix: v1.7.12 → v1.7.13 (with v preserved)
full_semver_v_result=""
full_semver_v_result="$(
  current_ref="v1.7.12"
  latest_tag="v1.7.13"
  current_ver="${current_ref#v}"
  latest_ver="${latest_tag#v}"
  new_ref=""
  if [[ "$current_ver" != "$latest_ver" ]]; then
    sort_winner="$(printf '%s\n%s\n' "$current_ver" "$latest_ver" | sort -V | tail -1)"
    if [[ "$sort_winner" == "$latest_ver" ]]; then
      new_ref="v${latest_ver}"
    fi
  fi
  printf '%s' "$new_ref"
)"
if [[ "$full_semver_v_result" == 'v1.7.13' ]]; then
  printf '[PASS] full-semver pin: v1.7.12 bumped to v1.7.13 (v-prefix preserved)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-semver pin: expected v1.7.13, got "%s"\n' "$full_semver_v_result"
  fail=$(( fail + 1 ))
fi

# Full semver without v-prefix: 0.35.0 → 0.36.0 (no v added)
full_semver_no_v_result=""
full_semver_no_v_result="$(
  current_ref="0.35.0"
  latest_tag="v0.36.0"
  current_ver="${current_ref#v}"
  latest_ver="${latest_tag#v}"
  new_ref=""
  if [[ "$current_ver" != "$latest_ver" ]]; then
    sort_winner="$(printf '%s\n%s\n' "$current_ver" "$latest_ver" | sort -V | tail -1)"
    if [[ "$sort_winner" == "$latest_ver" ]]; then
      # Preserve the absence of 'v'
      if [[ "$current_ref" == v* ]]; then
        new_ref="v${latest_ver}"
      else
        new_ref="$latest_ver"
      fi
    fi
  fi
  printf '%s' "$new_ref"
)"
if [[ "$full_semver_no_v_result" == '0.36.0' ]]; then
  printf '[PASS] full-semver pin (no v): 0.35.0 bumped to 0.36.0 (no v-prefix added)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-semver pin (no v): expected 0.36.0, got "%s"\n' "$full_semver_no_v_result"
  fail=$(( fail + 1 ))
fi

# No downgrade: sort -V must select latest when it is genuinely newer
no_downgrade_result=""
no_downgrade_result="$(
  current_ver="1.7.13"
  latest_ver="1.7.12"
  sort_winner="$(printf '%s\n%s\n' "$current_ver" "$latest_ver" | sort -V | tail -1)"
  if [[ "$sort_winner" == "$latest_ver" && "$current_ver" != "$latest_ver" ]]; then
    printf 'downgraded'
  else
    printf 'no-downgrade'
  fi
)"
if [[ "$no_downgrade_result" == 'no-downgrade' ]]; then
  printf '[PASS] full-semver pin: no downgrade when current (%s) > latest (%s)\n' "1.7.13" "1.7.12"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-semver pin: downgrade would occur — sort -V logic broken\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
