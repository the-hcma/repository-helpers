gh_merge_body="$(awk '/^merge_pr_via_gh_single\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # grep for literal merge vars in script under test
if printf '%s' "$gh_merge_body" | grep -qF 'wait_for_ci "$merge_branch" "$merge_head" "$pr_num"' \
  && printf '%s' "$gh_merge_body" | grep -qF 'refusing gh merge without a successful CI wait'; then
  printf '[PASS] ci-gate: gh merge waits for CI when status is not success\n'
