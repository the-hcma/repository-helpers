  fail=$(( fail + 1 ))
fi

printf '\n=== hermetic: dep_init_stacking_tool marker cases ===\n'
# shellcheck disable=SC1091  # stacking-tool sourced for hermetic init helper
source "${script_dir}/../scripts/lib/stacking-tool"
init_fn="$(awk '/^dep_init_stacking_tool\(\)/,/^}/' "$script")"
tmp_init_repo="$(mktemp -d)"
git -C "$tmp_init_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$tmp_init_repo" -c user.name=test -c user.email=test@example.com \
  commit --allow-empty -q -m 'init'
mkdir -p "${tmp_init_repo}/.github"

run_dep_init_stacking_tool() {
  local out
  out="$(
    dir="$tmp_init_repo"
    dep_stacking_tool=''
    eval "$init_fn"
    dep_init_stacking_tool
    printf '%s' "$dep_stacking_tool"
  )"
  printf '%s' "$out"
}

missing_init_log="$(
  rm -f "${tmp_init_repo}/.github/stacking-tool"
  dir="$tmp_init_repo"
  dep_stacking_tool=''
  eval "$init_fn"
  dep_init_stacking_tool 2>&1 >/dev/null
  printf '%s' "$dep_stacking_tool"
)"
missing_init_value="$(
  rm -f "${tmp_init_repo}/.github/stacking-tool"
  run_dep_init_stacking_tool 2>/dev/null
)"
if printf '%s' "$missing_init_log" | grep -qF "using missing-marker default 'gh-stack'" \
  && [[ "$missing_init_value" == 'gh-stack' ]]; then
  printf '[PASS] hermetic: missing marker selects gh-stack and logs the default\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: missing marker must select gh-stack and log the default\n'
  fail=$(( fail + 1 ))
  printf '%s\n' "$missing_init_log" >&2
fi

printf 'graphite\n' >"${tmp_init_repo}/.github/stacking-tool"
graphite_init_value="$(run_dep_init_stacking_tool 2>/dev/null)"
if [[ "$graphite_init_value" == 'graphite' ]]; then
  printf '[PASS] hermetic: graphite marker retains Graphite\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: graphite marker must retain Graphite (got %s)\n' \
    "$graphite_init_value"
  fail=$(( fail + 1 ))
fi

printf 'gh-stack\n' >"${tmp_init_repo}/.github/stacking-tool"
gh_stack_init_value="$(run_dep_init_stacking_tool 2>/dev/null)"
if [[ "$gh_stack_init_value" == 'gh-stack' ]]; then
  printf '[PASS] hermetic: gh-stack marker retains gh-stack\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: gh-stack marker must retain gh-stack (got %s)\n' \
    "$gh_stack_init_value"
  fail=$(( fail + 1 ))
fi

printf 'not-a-tool\n' >"${tmp_init_repo}/.github/stacking-tool"
invalid_init_exit=0
(
  dir="$tmp_init_repo"
  dep_stacking_tool=''
  eval "$init_fn"
  dep_init_stacking_tool
) >/dev/null 2>&1 || invalid_init_exit=$?
if [[ "$invalid_init_exit" -ne 0 ]]; then
  printf '[PASS] hermetic: invalid marker fails explicitly\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: invalid marker must fail explicitly\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_init_repo"

printf '\n=== functional: gh-stack register adopts via init before submit ===\n'
gh_stack_adopt_dir="$(mktemp -d)"
gh_stack_fake_bin="${gh_stack_adopt_dir}/bin"
gh_stack_log="${gh_stack_adopt_dir}/gh.log"
gh_stack_state="${gh_stack_adopt_dir}/state"
gh_stack_wt="${gh_stack_adopt_dir}/wt"
mkdir -p "$gh_stack_fake_bin" "$gh_stack_wt"
: >"$gh_stack_log"
: >"$gh_stack_state"

git -C "$gh_stack_wt" init --initial-branch=main -q
git -C "$gh_stack_wt" config user.name dep-updater-test
git -C "$gh_stack_wt" config user.email dep-updater-test@example.com
git -C "$gh_stack_wt" commit --allow-empty -q -m 'chore: init'
git -C "$gh_stack_wt" checkout -q -b dep-updates/npm-first
git -C "$gh_stack_wt" commit --allow-empty -q -m 'chore(deps): first'

cat >"${gh_stack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GH_STACK_LOG:?}"
if [[ "$*" == 'stack --help' || "$*" == *'stack --help'* ]]; then
  exit 0
fi
if [[ "$*" == *'stack view --json'* ]]; then
  # No local stack until init; match real gh-stack exit for unstacked branch.
  exit 2
fi
if [[ "$*" == *'stack unstack --local'* ]]; then
  exit 0
fi
if [[ "$*" == *'stack init --base main'* ]]; then
  exit 0
fi
if [[ "$*" == *'stack submit'* ]]; then
  exit 0
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 1
MOCK_GH
chmod +x "${gh_stack_fake_bin}/gh"

gh_stack_helpers="$(awk '
  /^dep_stack_gh_stack_adopt_current\(\)/ {p=1}
  /^dep_stack_register_branch\(\)/ {p=1}
  /^dep_stack_submit_gh_pr_fallback\(\)/ {p=1}
  /^dep_stack_submit_current\(\)/ {p=1}
  p {print}
  p && /^}/ {p=0}
' "$script")"

set +e
gh_stack_probe_out="$(
  PATH="${gh_stack_fake_bin}:${PATH}" \
  GH_STACK_LOG="$gh_stack_log" \
  bash -c '
    set -euo pipefail
    worktree_path="$1"
    state_file="$2"
    dep_stacking_tool="gh-stack"
    wt_base_branch="dep-updater-wt-base"
    repo_owner="OWNER"
    repo_name="mock-repo"
    die() { printf "DIE: %s\n" "$*" >&2; exit 1; }
    log() { :; }
    state_get() {
      local -r key="$1"
      rg -m1 "^${key}=" "$state_file" 2>/dev/null | cut -d= -f2- || true
    }
    csv_contains() {
      local -r csv="$1"
      local -r needle="$2"
      [[ -n "$csv" ]] || return 1
      [[ ",${csv}," == *",${needle},"* ]]
    }
    run_command() { shift; "$@"; }
    run_in_worktree() { (cd "$worktree_path" && "$@"); }
    runner_sh() {
      local label="$1"; shift
      local probe=0
      [[ "${1:-}" == "--probe" ]] && { probe=1; shift; }
      [[ "${1:-}" == "--" ]] && shift
      local -r script="$1"
      bash -c "$script"
    }
    dep_runner_sh() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_sh_stdout() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_gh() {
      shift
      [[ "${1:-}" == "--" ]] && shift
      gh "$@"
    }
    dep_runner_git_c_stdout() {
      shift
      local -r repo="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      git -C "$repo" "$@"
    }
    dep_stacking_is_gh_stack() { [[ "$dep_stacking_tool" == "gh-stack" ]]; }
    dep_stacking_is_graphite() { [[ "$dep_stacking_tool" == "graphite" ]]; }
    dep_stack_branch_info_ok() {
      run_in_worktree gh stack view --json >/dev/null 2>&1
    }
    eval "$3"
    dep_stack_register_branch "$wt_base_branch"
    dep_stack_submit_current
  ' _ "$gh_stack_wt" "$gh_stack_state" "$gh_stack_helpers" 2>&1
)"
gh_stack_probe_exit=$?
set -e

if [[ "$gh_stack_probe_exit" -eq 0 ]] \
  && grep -qF 'stack init --base main dep-updates/npm-first' "$gh_stack_log" \
  && grep -qF 'stack submit --auto --open --remote origin' "$gh_stack_log" \
  && awk '
      /stack init --base main/ { init=1 }
      /stack submit/ { submit=1; if (!init) exit 1 }
      END { exit (init && submit) ? 0 : 1 }
    ' "$gh_stack_log"; then
  printf '[PASS] gh-stack register: init adopts branch before submit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-stack register: expected init-before-submit (exit=%s)\n%s\ngh_log:\n%s\n' \
    "$gh_stack_probe_exit" "$gh_stack_probe_out" "$(cat "$gh_stack_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi

# Layer 2: prior branch in state + existing local stack → unstack --local then re-init.
printf 'branches=dep-updates/npm-first\n' >"$gh_stack_state"
: >"$gh_stack_log"
git -C "$gh_stack_wt" checkout -q -b dep-updates/npm-second
git -C "$gh_stack_wt" commit --allow-empty -q -m 'chore(deps): second'

cat >"${gh_stack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GH_STACK_LOG:?}"
# Pretend bottom branch is already stacked so adopt clears local tracking.
if [[ "$*" == *'stack view --json'* ]]; then
  printf '%s\n' '{"trunk":"main","branches":[{"name":"dep-updates/npm-first"}]}'
  exit 0
fi
if [[ "$*" == *'stack unstack --local'* ]]; then
  exit 0
fi
if [[ "$*" == *'stack init --base main'* ]]; then
  exit 0
fi
if [[ "$*" == *'stack submit'* ]]; then
  exit 0
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 1
MOCK_GH
chmod +x "${gh_stack_fake_bin}/gh"

set +e
gh_stack_probe2_out="$(
  PATH="${gh_stack_fake_bin}:${PATH}" \
  GH_STACK_LOG="$gh_stack_log" \
  bash -c '
    set -euo pipefail
    worktree_path="$1"
    state_file="$2"
    dep_stacking_tool="gh-stack"
    wt_base_branch="dep-updater-wt-base"
    repo_owner="OWNER"
    repo_name="mock-repo"
    die() { printf "DIE: %s\n" "$*" >&2; exit 1; }
    log() { :; }
    state_get() {
      local -r key="$1"
      rg -m1 "^${key}=" "$state_file" 2>/dev/null | cut -d= -f2- || true
    }
    csv_contains() {
      local -r csv="$1"
      local -r needle="$2"
      [[ -n "$csv" ]] || return 1
      [[ ",${csv}," == *",${needle},"* ]]
    }
    run_command() { shift; "$@"; }
    run_in_worktree() { (cd "$worktree_path" && "$@"); }
    runner_sh() {
      local label="$1"; shift
      [[ "${1:-}" == "--probe" ]] && shift
      [[ "${1:-}" == "--" ]] && shift
      bash -c "$1"
    }
    dep_runner_sh() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_sh_stdout() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_gh() {
      shift
      [[ "${1:-}" == "--" ]] && shift
      gh "$@"
    }
    dep_runner_git_c_stdout() {
      shift
      local -r repo="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      git -C "$repo" "$@"
    }
    dep_stacking_is_gh_stack() { [[ "$dep_stacking_tool" == "gh-stack" ]]; }
    dep_stacking_is_graphite() { [[ "$dep_stacking_tool" == "graphite" ]]; }
    eval "$3"
    dep_stack_register_branch "dep-updates/npm-first"
    dep_stack_submit_current
  ' _ "$gh_stack_wt" "$gh_stack_state" "$gh_stack_helpers" 2>&1
)"
gh_stack_probe2_exit=$?
set -e

if [[ "$gh_stack_probe2_exit" -eq 0 ]] \
  && grep -qF 'stack unstack --local' "$gh_stack_log" \
  && grep -qF 'stack init --base main dep-updates/npm-first dep-updates/npm-second' \
    "$gh_stack_log" \
  && awk '
      /stack unstack --local/ { u=1 }
      /stack init --base main/ { if (!u) exit 1; i=1 }
      /stack submit/ { if (!i) exit 1 }
      END { exit (u && i) ? 0 : 1 }
    ' "$gh_stack_log"; then
  printf '[PASS] gh-stack register: second layer unstack --local then re-init before submit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-stack register: expected unstack+re-init for layer 2 (exit=%s)\n%s\ngh_log:\n%s\n' \
    "$gh_stack_probe2_exit" "$gh_stack_probe2_out" "$(cat "$gh_stack_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi

# Layer 3: Stacked PRs not enabled → fall back to gh pr create.
: >"$gh_stack_log"
git -C "$gh_stack_wt" checkout -q dep-updates/npm-second
cat >"${gh_stack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GH_STACK_LOG:?}"
if [[ "$*" == *'stack submit'* ]]; then
  printf '⚠ Stacked PRs are not enabled for this repository\n' >&2
  exit 9
fi
if [[ "$*" == *'pr create'* ]]; then
  printf 'https://github.com/OWNER/mock-repo/pull/1\n'
  exit 0
fi
if [[ "$*" == *'pr view'* ]]; then
  printf '1\n'
  exit 0
fi
if [[ "$*" == *'pr edit'* ]]; then
  exit 0
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 1
MOCK_GH
chmod +x "${gh_stack_fake_bin}/gh"
# Fake git push so fallback does not need a remote.
cat >"${gh_stack_fake_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
joined="$*"
if [[ "$joined" == *'push --set-upstream origin HEAD'* ]]; then
  exit 0
fi
PATH="${PATH#"${0%/*}:"}"
exec git "$@"
MOCK_GIT
chmod +x "${gh_stack_fake_bin}/git"

set +e
gh_stack_fallback_out="$(
  PATH="${gh_stack_fake_bin}:${PATH}" \
  GH_STACK_LOG="$gh_stack_log" \
  bash -c '
    set -euo pipefail
    worktree_path="$1"
    state_file="$2"
    dep_stacking_tool="gh-stack"
    wt_base_branch="dep-updater-wt-base"
    repo_owner="OWNER"
    repo_name="mock-repo"
    die() { printf "DIE: %s\n" "$*" >&2; exit 1; }
    log() { printf "LOG: %s\n" "$*"; }
    state_get() {
      case "$1" in
        base_branch) echo trunk ;;
        *) true ;;
      esac
    }
    run_command() { shift; "$@"; }
    run_in_worktree() { (cd "$worktree_path" && "$@"); }
    dep_runner_sh() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_sh_stdout() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_gh() {
      shift
      [[ "${1:-}" == "--" ]] && shift
      gh "$@"
    }
    dep_runner_gh_stdout() {
      shift
      [[ "${1:-}" == "--" ]] && shift
      gh "$@"
    }
    dep_runner_git_c_stdout() {
      shift
      local -r repo="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      git -C "$repo" "$@"
    }
    dep_stacking_is_gh_stack() { [[ "$dep_stacking_tool" == "gh-stack" ]]; }
    dep_stacking_is_graphite() { return 1; }
    eval "$3"
    dep_stack_submit_current
  ' _ "$gh_stack_wt" "$gh_stack_state" "$gh_stack_helpers" 2>&1
)"
gh_stack_fallback_exit=$?
set -e

if [[ "$gh_stack_fallback_exit" -eq 0 ]] \
  && grep -qF 'stack submit' "$gh_stack_log" \
  && grep -qF 'pr create' "$gh_stack_log" \
  && grep -qF -- '--base trunk' "$gh_stack_log" \
  && grep -qiF 'falling back to gh pr create' <<<"$gh_stack_fallback_out"; then
  printf '[PASS] gh-stack submit: falls back to gh pr create when Stacked PRs disabled\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-stack submit: expected Stacked PRs fallback (exit=%s)\n%s\ngh_log:\n%s\n' \
    "$gh_stack_fallback_exit" "$gh_stack_fallback_out" "$(cat "$gh_stack_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi

# Layer 4: push fails but PR already exists → recover without pr create.
: >"$gh_stack_log"
cat >"${gh_stack_fake_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${GH_STACK_LOG:?}"
if [[ "$*" == *'stack submit'* ]]; then
  printf '⚠ Stacked PRs are not enabled for this repository\n' >&2
  exit 9
fi
if [[ "$*" == 'pr view dep-updates/npm-second --repo OWNER/mock-repo --json number --jq .number' \
  || "$*" == 'pr view dep-updates/npm-second --repo OWNER/mock-repo --json number -q .number' \
  || "$*" == 'pr view dep-updates/npm-second --repo OWNER/mock-repo --json number,state --jq if .state == "OPEN" then .number else empty end' ]]; then
  printf '42\n'
  exit 0
fi
if [[ "$*" == *'pr view'* && "$*" == *'dep-updates/npm-second'* ]]; then
  printf 'unexpected pr view shape: %s\n' "$*" >&2
  exit 1
fi
if [[ "$*" == *'pr create'* ]]; then
  printf 'unexpected pr create when PR already exists\n' >&2
  exit 1
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 1
MOCK_GH
chmod +x "${gh_stack_fake_bin}/gh"
cat >"${gh_stack_fake_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
set -euo pipefail
joined="$*"
if [[ "$joined" == *'push --set-upstream origin HEAD'* ]]; then
  exit 1
fi
PATH="${PATH#"${0%/*}:"}"
exec git "$@"
MOCK_GIT
chmod +x "${gh_stack_fake_bin}/git"

set +e
gh_stack_recover_out="$(
  PATH="${gh_stack_fake_bin}:${PATH}" \
  GH_STACK_LOG="$gh_stack_log" \
  bash -c '
    set -euo pipefail
    worktree_path="$1"
    state_file="$2"
    dep_stacking_tool="gh-stack"
    wt_base_branch="dep-updater-wt-base"
    repo_owner="OWNER"
    repo_name="mock-repo"
    die() { printf "DIE: %s\n" "$*" >&2; exit 1; }
    log() { printf "LOG: %s\n" "$*"; }
    state_get() {
      case "$1" in
        base_branch) echo main ;;
        *) true ;;
      esac
    }
    run_command() { shift; "$@"; }
    run_in_worktree() { (cd "$worktree_path" && "$@"); }
    dep_runner_sh() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_sh_stdout() {
      local -r label="$1"; shift
      [[ "${1:-}" == "--" ]] || return 2
      shift
      bash -c "$*"
    }
    dep_runner_gh() {
      shift
      [[ "${1:-}" == "--" ]] && shift
      gh "$@"
    }
    dep_runner_gh_stdout() {
      shift
      [[ "${1:-}" == "--" ]] && shift
      gh "$@"
    }
    dep_runner_git_c_stdout() {
      shift
      local -r repo="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      git -C "$repo" "$@"
    }
    dep_stacking_is_gh_stack() { [[ "$dep_stacking_tool" == "gh-stack" ]]; }
    dep_stacking_is_graphite() { return 1; }
    eval "$3"
    dep_stack_submit_current
  ' _ "$gh_stack_wt" "$gh_stack_state" "$gh_stack_helpers" 2>&1
)"
gh_stack_recover_exit=$?
set -e

if [[ "$gh_stack_recover_exit" -eq 0 ]] \
  && ! grep -qF 'pr create' "$gh_stack_log" \
  && grep -qF 'pr view' "$gh_stack_log" \
  && grep -qiF 'already has open PR #42' <<<"$gh_stack_recover_out"; then
  printf '[PASS] gh-stack submit: recovers when push fails but PR already exists\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-stack submit: expected push-fail PR recovery (exit=%s)\n%s\ngh_log:\n%s\n' \
    "$gh_stack_recover_exit" "$gh_stack_recover_out" "$(cat "$gh_stack_log" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi

# Static: fallback must not use gh pr view --head (pr create --head is fine).
fallback_body="$(awk '
  /^dep_stack_submit_gh_pr_fallback\(\)/ {p=1}
  p {print}
  p && /^}/ {exit}
' "$script")"
# Collapse line continuations portably, then flag pr view ... --head (not pr create).
fallback_collapsed="$(awk '
  {
    line = $0
    while (line ~ /\\$/) {
      sub(/\\$/, "", line)
      if ((getline nxt) <= 0) break
      line = line nxt
    }
    print line
  }
' <<<"$fallback_body")"
# shellcheck disable=SC2016  # grep -qF needle is a literal source token
if grep -E 'pr[[:space:]]+view' <<<"$fallback_collapsed" | grep -qF -- '--head'; then
  printf '[FAIL] gh-stack fallback: must not use gh pr view --head (use positional branch)\n'
  fail=$(( fail + 1 ))
elif grep -qF 'pr view "$branch"' <<<"$fallback_body" \
  && grep -qF 'return 0' <<<"$fallback_body"; then
  printf '[PASS] gh-stack fallback: positional pr view + early return when PR exists\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh-stack fallback: missing positional pr view or early return on existing PR\n'
  fail=$(( fail + 1 ))
fi

rm -rf "$gh_stack_adopt_dir"

printf '\n=== static: die records first failure ===\n'
die_body="$(awk '/^die\(\) \{/{found=1; next} found && /^\}$/{exit} found' "$script")"
if grep -qF 'record_first_failure' <<<"$die_body" \
  && grep -qF 'record_first_failure "$*" || true' <<<"$die_body" \
  && grep -qF 'printf' <<<"$die_body" \
  && grep -qF '|| true' <<<"$die_body"; then
  printf '[PASS] die: calls record_first_failure (|| true) then ERROR on stderr (#556)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] die: expected record_first_failure || true before ERROR printf\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: die writes directly to stderr ===\n'

die_body="$(awk '/^die\(\) \{/{found=1; next} found && /^\}$/{exit} found' "$script")"

# Must use printf ... >&2 (not log)
if grep -qE 'printf.*>&2' <<<"$die_body"; then
  printf '[PASS] die: uses printf ... >&2\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] die: does not use printf ... >&2 — errors will be silenced in --quiet mode\n'
  fail=$(( fail + 1 ))
fi

# Must NOT call log (which TIME_LOG_ENABLED=0 suppresses)
if grep -qE '^\s+log\b' <<<"$die_body"; then
  printf '[FAIL] die: calls log — will be silent when TIME_LOG_ENABLED=0 (quiet/report-json mode)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] die: does not route through log (not silenced by quiet mode)\n'
  pass=$(( pass + 1 ))
fi

printf '\n=== static: prerequisite helpers use log_prereq (not log) ===\n'
if grep -qE '^log_prereq\(\)' "$script"; then
  printf '[PASS] prereq: log_prereq helper is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereq: log_prereq helper missing\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'tooling_prereq_check_tools "[tooling]"' "$script"; then
  printf '[PASS] prereq: core tooling check uses tooling-prereqs (stderr via log_prereq)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereq: must call tooling_prereq_check_tools for core tooling header\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: dep-updater sources tooling-prereqs ===\n'
# shellcheck disable=SC2016
if grep -qF 'source "${dep_script_dir}/lib/tooling-prereqs"' "$script" \
  && grep -qF 'tooling_prereq_check_tools' "$script"; then
  printf '[PASS] tooling-prereqs: dep-updater sources lib/tooling-prereqs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling-prereqs: dep-updater must source lib/tooling-prereqs\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: dep-updater sources tooling-path for PATH bootstrap ===\n'
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${dep_script_dir} in script source
main_body="$(
  awk '
    BEGIN { in_fn = 0; depth = 0 }
    /^main\(\)[[:space:]]*\{/ {
      in_fn = 1
      depth = 1
      next
    }
    in_fn {
      print
      depth += gsub(/\{/, "{")
      depth -= gsub(/\}/, "}")
      if (depth <= 0) {
        exit
      }
    }
  ' "$script"
)"
# shellcheck disable=SC2016  # grep for literal ${dep_script_dir} in dep-updater source
if grep -qF 'source "${dep_script_dir}/lib/tooling-path"' "$script" \
  && grep -qF 'dep_updater_bootstrap_path()' "$script" \
  && grep -qF 'tooling_path_bootstrap_node_ecosystem' "$script" \
  && grep -qF 'dep_updater_bootstrap_path' <<<"$main_body"; then
  printf '[PASS] tooling-path: dep-updater sources lib/tooling-path and bootstraps PATH from main\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling-path: dep-updater must source lib/tooling-path and bootstrap from main\n'
  fail=$(( fail + 1 ))
fi

if ! grep -qE '^tooling_path_bootstrap_node_ecosystem$' "$script"; then
  printf '[PASS] tooling-path: bootstrap is not invoked at top level (set -e silent exit)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tooling-path: must not call bootstrap at top level before runner init\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: early runner init before PATH bootstrap (issue #411) ===\n'
if grep -qF 'dep_updater_early_init()' "$script" \
  && grep -qF 'dep_updater_early_init' <<<"$main_body" \
  && [[ "$(printf '%s\n' "$main_body" | grep -n 'dep_updater_early_init' | head -1 | cut -d: -f1)" \
       -lt "$(printf '%s\n' "$main_body" | grep -n 'dep_updater_bootstrap_path' | head -1 | cut -d: -f1)" ]] \
  && [[ "$(printf '%s\n' "$main_body" | grep -n 'dep_updater_bootstrap_path' | head -1 | cut -d: -f1)" \
       -lt "$(printf '%s\n' "$main_body" | grep -n 'parse_args' | head -1 | cut -d: -f1)" ]]; then
  printf '[PASS] early-init: main initializes runner session before bootstrap and parse_args\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] early-init: expected dep_updater_early_init → bootstrap → parse_args in main\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: pnpm PATH alignment and in-project invocation ===\n'
tooling_lib="${script_dir}/../scripts/lib/tooling-path"
if grep -qF 'tooling_path_align_node_with_pnpm' "$tooling_lib"; then
