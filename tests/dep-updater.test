git -C "$tmp_repo" init -q
git -C "$tmp_repo" checkout -b main >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init
