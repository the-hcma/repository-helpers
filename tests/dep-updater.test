# Test: --report-json can discover pnpm via fnm env
# ---------------------------------------------------------------------------

printf '\n=== report-json: discovers pnpm via fnm ===\n'
tmp_home="$(mktemp -d)"
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" checkout -b main >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

cat >"${tmp_repo}/package.json" <<'EOF'
{"name":"x","private":true,"devDependencies":{"left-pad":"1.3.0"}}
EOF
touch "${tmp_repo}/pnpm-lock.yaml"

fnm_path="${tmp_home}/fnm-multishell/bin"
mkdir -p "$fnm_path"
mkdir -p "${tmp_home}/.local/share/fnm"

cat >"${tmp_home}/.local/share/fnm/fnm" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "env" ]]; then
  echo 'export PATH="__FNM_PATH__":"$PATH"'
  exit 0
fi
echo "fnm stub: unsupported args: \$*" >&2
exit 2
EOF
sed -i "s|__FNM_PATH__|${fnm_path}|g" "${tmp_home}/.local/share/fnm/fnm"
chmod +x "${tmp_home}/.local/share/fnm/fnm"

cat >"${fnm_path}/pnpm" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--dir" ]]; then
  shift 2
fi
case "${1:-}" in
  --version|-v|version) echo "9.0.0"; exit 0;;
  install) exit 0;;
  outdated) echo "{}"; exit 0;;
  audit) echo "[]"; exit 0;;
  list)
    cat <<'JSON'
[
  {
    "name": "x",
    "path": ".",
    "devDependencies": {
      "left-pad": {"version": "1.3.0"}
    }
  }
]
JSON
    exit 0
    ;;
  view)
    # pnpm view <pkg> version
    pkg="${2:-}"
    field="${3:-}"
    if [[ "$field" != "version" ]]; then
      exit 2
    fi
    # No updates in this stub project.
    echo "1.3.0"
    exit 0
    ;;
esac
echo "pnpm stub: unsupported args: $*" >&2
exit 2
EOF
chmod +x "${fnm_path}/pnpm"

report_output=""
report_exit=0
report_err_file="$(mktemp)"
set +e
report_output="$(env HOME="$tmp_home" PATH="/usr/bin:/bin" \
  "$script" --report-json --dir "$tmp_repo" 2>"$report_err_file")"
report_exit=$?
set -e
report_err="$(cat "$report_err_file" 2>/dev/null || true)"
rm -f "$report_err_file"

rm -rf "$tmp_home" "$tmp_repo"

assert_exit_0 "report-json (fnm pnpm discovery)" "${report_output}${report_err:+$'\n'}${report_err}" "$report_exit"
if printf '%s' "$report_output" | jq -e . >/dev/null 2>&1; then
  printf '[PASS] report-json (fnm pnpm discovery): output is valid JSON\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report-json (fnm pnpm discovery): output is not valid JSON\n'
  printf '       output:\n%s\n' "$report_output"
  fail=$(( fail + 1 ))
fi

