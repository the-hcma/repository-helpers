fi

printf '\n=== static: ignored-builds probe uses runner --probe (issue #411) ===\n'
ignored_builds_body="$(awk '/^pnpm_output_has_ignored_builds\(\) \{/,/^\}$/' "$script")"
if grep -qF -- 'dep_runner_rg --probe "pnpm ignored builds marker"' <<<"$ignored_builds_body"; then
  printf '[PASS] ignored-builds: pnpm_output_has_ignored_builds uses dep_runner_rg --probe\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ignored-builds: expected dep_runner_rg --probe for absent-marker checks\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ignored-builds absent marker emits no runner [FAIL] (issue #411) ===\n'
probe_tmp="$(mktemp -d)"
probe_scan="${probe_tmp}/scan"
probe_repo="${probe_scan}/repo"
probe_bin="${probe_tmp}/bin"
probe_home="${probe_tmp}/home"
mkdir -p "$probe_bin" "$probe_repo" "${probe_home}/.local/bin"

git -C "$probe_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$probe_repo" -c user.name=test -c user.email=test@example.com checkout -b main 2>/dev/null \
  || git -C "$probe_repo" -c user.name=test -c user.email=test@example.com checkout -q -b main
git -C "$probe_repo" -c user.name=test -c user.email=test@example.com \
  remote add origin 'https://github.com/the-hcma/repo.git'
printf 'x\n' >"$probe_repo/README.md"
printf '{"name":"probe-repo","version":"1.0.0","private":true}\n' >"$probe_repo/package.json"
printf 'lockfileVersion: 9.0\n' >"$probe_repo/pnpm-lock.yaml"
git -C "$probe_repo" -c user.name=test -c user.email=test@example.com add README.md package.json pnpm-lock.yaml
git -C "$probe_repo" -c user.name=test -c user.email=test@example.com commit -q -m init

cat >"${probe_bin}/pnpm" <<'MOCK_PNPM_PROBE'
#!/usr/bin/env bash
printf 'pnpm install failed for unrelated reason\n' >&2
exit 1
MOCK_PNPM_PROBE
chmod +x "${probe_bin}/pnpm"

cat >"${probe_home}/.local/bin/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == 'stack --help' ]]; then
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' $'repo\tfalse\tfalse'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${probe_home}/.local/bin/gh"

probe_parent_stderr="${probe_tmp}/parent.stderr"
probe_parent_exit=0
HOME="$probe_home" PATH="${probe_home}/.local/bin:${probe_bin}:${PATH}" \
  "$script" --batch --all --dry-run --scan-root "$probe_scan" --tmpdir "${probe_tmp}/wt" \
  >"${probe_tmp}/parent.stdout" 2>"$probe_parent_stderr" || probe_parent_exit=$?

probe_fail_line=""
if [[ -f "$probe_parent_stderr" ]]; then
  probe_fail_line="$(grep -F '[FAIL] pnpm ignored builds marker' "$probe_parent_stderr" || true)"
fi
rm -rf "$probe_tmp"

if [[ "$probe_parent_exit" -ne 0 ]] && [[ -z "$probe_fail_line" ]]; then
  printf '[PASS] ignored-builds probe: absent marker does not emit runner [FAIL] in batch-all parent\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ignored-builds probe: expected batch-all failure without [FAIL] pnpm ignored builds marker (exit=%s)\n' \
    "$probe_parent_exit"
  if [[ -n "$probe_fail_line" ]]; then
    printf '%s\n' "$probe_fail_line"
  fi
  fail=$(( fail + 1 ))
fi

printf '\n=== batch child: capture_stderr from runner git failure ===\n'
capture_tmp="$(mktemp -d)"
capture_report="${capture_tmp}/child-report.json"
capture_repo="${capture_tmp}/repo"
capture_bin="${capture_tmp}/bin"
mkdir -p "$capture_bin" "$capture_repo"

git -C "$capture_repo" -c user.name=test -c user.email=test@example.com init -q
git -C "$capture_repo" -c user.name=test -c user.email=test@example.com checkout -b main 2>/dev/null \
  || git -C "$capture_repo" -c user.name=test -c user.email=test@example.com checkout -q -b main
printf 'x\n' >"$capture_repo/README.md"
git -C "$capture_repo" -c user.name=test -c user.email=test@example.com add README.md
git -C "$capture_repo" -c user.name=test -c user.email=test@example.com commit -q -m init

cat >"${capture_bin}/git" <<'MOCK_GIT'
#!/usr/bin/env bash
if [[ "${1:-}" == "-C" ]]; then
  cdir="$2"
  shift 2
  if [[ "${1:-}" == "worktree" && "${2:-}" == "add" ]]; then
    printf 'fatal: mock worktree add denied\n' >&2
    exit 128
  fi
  exec /usr/bin/git -C "$cdir" "$@"
fi
exec /usr/bin/git "$@"
MOCK_GIT
chmod +x "${capture_bin}/git"

capture_exit=0
PATH="${capture_bin}:${PATH}" DEP_UPDATER_RUN_REPORT="$capture_report" \
  "$script" --batch --dry-run --dir "$capture_repo" 2>/dev/null || capture_exit=$?

capture_stderr=""
capture_primary=""
if [[ -f "$capture_report" ]]; then
  capture_stderr="$(jq -r '.capture_stderr // empty' "$capture_report" 2>/dev/null || true)"
  capture_primary="$(jq -r '.primary // empty' "$capture_report" 2>/dev/null || true)"
fi
rm -rf "$capture_tmp"

if [[ -n "$capture_stderr" ]] \
  && grep -qF 'fatal:' <<<"$capture_stderr"; then
  printf '[PASS] batch child report includes runner capture_stderr on git failure\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch child report missing capture_stderr from runner (exit=%s stderr=%s)\n' \
    "$capture_exit" "${capture_stderr:-empty}"
  fail=$(( fail + 1 ))
fi

if [[ -n "$capture_primary" ]] \
  && [[ "$capture_primary" != "dep-updater exited with code 1" ]] \
  && [[ "$capture_primary" != "dep-updater exited with code ${capture_exit}" ]]; then
  printf '[PASS] batch child report primary is actionable on runner failure (issue #411)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch child report primary is generic (exit=%s primary=%s)\n' \
    "$capture_exit" "${capture_primary:-empty}"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: npm_audit parses real yarn audit-advisory JSON (#593) ===\n'
# Discovered while implementing the pnpm branch above (which shares this exact jq
# expression): `any(.paths[]; ...)` applies the generator to the *array* .findings
# itself, not to each element, so real yarn advisory JSON (.findings is an array)
# always errored with "Cannot index array with string \"paths\"" — silently
# swallowed by `dep_runner_jq_with_args ... 2>/dev/null || true`, so yarn's branch
# always returned nothing too. This was untested before #593. Fixed alongside pnpm:
# `any(.[].paths[]?; ...)` iterates findings first, then each finding's paths.
# Second advisory (transitive-pkg) covers a later review finding on this same PR
# (repository-helpers#593 review, mergestorm-vortex/CodeRabbit): yarn/pnpm paths
# are ">"-separated chains, not "/"-separated, so the direct-dep check must count
# ">" hops, not test for an absent "/" (which never appears in a real path either
# way and so rejected nothing).
yarn_audit_fixture=$'{"type":"auditAdvisory","data":{"advisory":{"module_name":"lodash","findings":[{"version":"4.17.15","paths":["."]}],"patched_versions":">=4.17.21","cves":["CVE-2021-23337"],"id":1523}}}\n{"type":"auditAdvisory","data":{"advisory":{"module_name":"transitive-pkg","findings":[{"version":"1.0.0","paths":["lodash>through>transitive-pkg"]}],"patched_versions":">=1.0.1","cves":["CVE-2026-11111"],"id":1524}}}'
yarn_audit_out="$(
  set -euo pipefail
  # shellcheck disable=SC2317,SC2329  # invoked indirectly by the sourced npm_audit body
  dep_runner_jq_with_args() { local json="$3"; shift 3; jq "$@" <<<"$json"; }
  # shellcheck disable=SC2317,SC2329
  dep_runner_sh_stdout() { printf '%s' "$yarn_audit_fixture"; }
  # shellcheck disable=SC1090
  source <(awk '/^npm_audit\(\)/,/^}$/' "$script")
  # shellcheck disable=SC2034  # consumed by the sourced npm_audit body
  npm_tool='yarn'
  npm_audit '/tmp/probe-project'
)"
if [[ "$yarn_audit_out" == 'lodash 4.17.15 4.17.21 CVE-2021-23337' ]]; then
  printf '[PASS] npm_audit: yarn advisory JSON is parsed without a jq indexing error (#593)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_audit: expected a single lodash row, got: %s\n' "$yarn_audit_out"
  fail=$(( fail + 1 ))
fi
if ! grep -qF 'transitive-pkg' <<<"$yarn_audit_out"; then
  printf '[PASS] npm_audit: yarn transitive-only advisory (multi-hop ">" path) is excluded\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_audit: transitive-pkg is reachable only via lodash>through and must not be surfaced: %s\n' "$yarn_audit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: npm_audit parses pnpm legacy audit-v1 schema (#593) ===\n'
# pnpm audit --json emits the legacy npm-audit-v1 schema (top-level .advisories
# keyed by id; .vulnerabilities is just a {info,low,moderate,high,critical} summary
# count, not a per-package map with isDirect/fixAvailable like npm v7+). Confirmed
# against a real the-hcma/my-tracks repro (repository-helpers#593): before this fix,
# npm_audit() always returned nothing for pnpm projects regardless of severity.
# postcss here is deliberately transitive-only (reachable via vitest>vite) to
# assert it is excluded, matching npm_audit's documented direct-dep-only contract.
pnpm_audit_fixture='{
  "actions": [],
  "advisories": {
    "1139510": {
      "module_name": "postcss",
      "findings": [{"version": "8.5.14", "paths": [".>vitest>vite>postcss"]}],
      "patched_versions": ">=8.5.18",
      "cves": ["CVE-2026-73646"],
      "severity": "high",
      "id": 1139510
    },
    "1139511": {
      "module_name": "brace-expansion",
      "findings": [{"version": "1.1.11", "paths": ["."]}],
      "patched_versions": "<0.0.0",
      "cves": [],
      "severity": "low",
      "id": 1139511
    },
    "1139512": {
      "module_name": "direct-pkg",
      "findings": [{"version": "1.0.0", "paths": [".>direct-pkg"]}],
      "patched_versions": ">=1.0.1",
      "cves": ["CVE-2026-99999"],
      "severity": "high",
      "id": 1139512
    }
  },
  "muted": [],
  "metadata": {}
}'
pnpm_audit_out="$(
  set -euo pipefail
  # shellcheck disable=SC2317,SC2329  # invoked indirectly by the sourced npm_audit body
  dep_runner_jq_with_args() { local json="$3"; shift 3; jq "$@" <<<"$json"; }
  # shellcheck disable=SC2317,SC2329
  pnpm_in_project() { printf '%s' "$pnpm_audit_fixture"; }
  # shellcheck disable=SC1090
  source <(awk '/^npm_audit\(\)/,/^}$/' "$script")
  # shellcheck disable=SC2034  # consumed by the sourced npm_audit body
  npm_tool='pnpm'
  npm_audit '/tmp/probe-project'
)"
if [[ "$pnpm_audit_out" == 'direct-pkg 1.0.0 1.0.1 CVE-2026-99999' ]]; then
  printf '[PASS] npm_audit: pnpm legacy-schema direct-dep advisory is parsed (module_name/findings/patched_versions/cves)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_audit: expected a single direct-pkg row, got: %s\n' "$pnpm_audit_out"
  fail=$(( fail + 1 ))
fi
if ! grep -qF 'brace-expansion' <<<"$pnpm_audit_out"; then
  printf "[PASS] npm_audit: pnpm advisory with patched_versions '<0.0.0' (no fix) is excluded\n"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_audit: brace-expansion has no available fix and must not be surfaced: %s\n' "$pnpm_audit_out"
  fail=$(( fail + 1 ))
fi
if ! grep -qF 'postcss' <<<"$pnpm_audit_out"; then
  printf '[PASS] npm_audit: pnpm transitive-only advisory (multi-hop ">" path) is excluded\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_audit: postcss is reachable only via vitest>vite and must not be surfaced: %s\n' "$pnpm_audit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: npm_audit gives pnpm its own parsing branch, not npm'"'"'s .vulnerabilities map (#593) ===\n'
npm_audit_fn="$(awk '/^npm_audit\(\)/,/^}$/' "$script")"
if grep -qF "npm_tool\" == 'pnpm'" <<<"$npm_audit_fn" \
  && grep -qF '.advisories' <<<"$npm_audit_fn" \
  && grep -qF 'dep-updater npm audit pnpm rows' <<<"$npm_audit_fn"; then
  printf '[PASS] npm_audit: pnpm branch parses .advisories, distinct from the npm v7+ .vulnerabilities branch\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_audit: missing a dedicated pnpm .advisories parsing branch\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
