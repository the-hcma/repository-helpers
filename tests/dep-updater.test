chmod +x "${tmp_home}/.local/share/fnm/fnm"

cat >"${fnm_path}/gt" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exit 0
EOF
chmod +x "${fnm_path}/gt"

cat >"${fnm_path}/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "stack" ]]; then
  exit 0
fi
exit 0
EOF
chmod +x "${fnm_path}/gh"

dry_output=""
dry_exit=0
set +e
dry_output="$(env HOME="$tmp_home" PATH="${fnm_path}:$(dep_test_path_no_gh_gt)" \
  "$script" --dry-run --dir "$tmp_repo" 2>&1)"
dry_exit=$?
set -e
rm -rf "$tmp_home" "$tmp_repo"

assert_exit_0 "dry-run (fnm gt discovery)" "$dry_output" "$dry_exit"

# ---------------------------------------------------------------------------
# Static: no 'local -r' inside loop bodies
#
# In bash, 'local' is function-scoped. Declaring 'local -r foo=x' inside a
# loop that runs more than once will fail on the second iteration with:
#   "local: foo: readonly variable"
# Neither 'bash -n' nor shellcheck catches this — it only manifests at runtime.
# ---------------------------------------------------------------------------

printf '\n=== static: local -r in loops ===\n'
local_r_in_loops="$(awk '
  /^[[:space:]]*(while|for|until)[[:space:]]/ { depth++ }
  /^[[:space:]]*done\b/ { if (depth > 0) depth-- }
  /^}/ { depth=0 }
  /[[:space:]]local[[:space:]]+-[a-zA-Z]*r/ && depth > 0 { print NR": "$0 }
' "$script")"
if [[ -n "$local_r_in_loops" ]]; then
  printf '[FAIL] local-r-in-loops: local -r inside a loop body crashes on 2nd iteration:\n%s\n' \
    "$local_r_in_loops"
  fail=$(( fail + 1 ))
else
  printf '[PASS] local-r-in-loops: no local -r declarations inside loops\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: timezone override flag is supported
# ---------------------------------------------------------------------------

printf '\n=== static: tz override flag ===\n'
if grep -qF -- '--tz <tz>' "$script"; then
  printf '[PASS] tz-flag: usage documents --tz\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tz-flag: expected usage to include --tz\n'
  fail=$(( fail + 1 ))
fi
if grep -qF -- '--tz)' "$script"; then
  printf '[PASS] tz-flag: parse_args handles --tz\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] tz-flag: expected parse_args to handle --tz\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no repetitive "already has merge-it label" noise
# ---------------------------------------------------------------------------

printf '\n=== static: no noisy merge-it label log ===\n'
if grep -qF 'already has merge-it label' "$script"; then
  printf '[FAIL] noisy-merge-it-log: script still contains "already has merge-it label"\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] noisy-merge-it-log: no repetitive "already has merge-it label" log line\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: merge-it label query and apply hardening
# ---------------------------------------------------------------------------

printf '\n=== static: merge enqueue hardening ===\n'
if grep -qE '^pr_has_merge_enqueue_pending\(\)' "$script"; then
  printf '[PASS] merge-enqueue-helper: pr_has_merge_enqueue_pending is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-enqueue-helper: expected pr_has_merge_enqueue_pending function\n'
  fail=$(( fail + 1 ))
fi
if grep -qF "has_label=\"\$(pr_has_merge_enqueue_pending \"\$top_pr\")\"" "$script"; then
  printf '[PASS] merge-enqueue-helper: maybe_label_top_pr_for_merge uses pr_has_merge_enqueue_pending\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-enqueue-helper: maybe_label_top_pr_for_merge should use pr_has_merge_enqueue_pending\n'
  fail=$(( fail + 1 ))
fi
if awk '/^maybe_label_top_pr_for_merge\(\)/,/^}/' "$script" | grep -qF "|| echo 'false'"; then
  printf '[FAIL] merge-enqueue-helper: maybe_label must not default API failure to false\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] merge-enqueue-helper: maybe_label does not treat API errors as absent label\n'
  pass=$(( pass + 1 ))
fi
if grep -qF 'skipping apply this cycle' "$script" \
  && grep -qF 'Re-applying merge enqueue on top PR' "$script"; then
  printf '[PASS] merge-enqueue-helper: logs unknown skip and re-apply reasons\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-enqueue-helper: expected skip-on-unknown and re-apply log lines\n'
  fail=$(( fail + 1 ))
fi
if grep -qF "_merge_it_poll_had_label=\"\$top_has_label\"" "$script"; then
  printf '[PASS] merge-enqueue-helper: poll_until_merged records last enqueue observation\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-enqueue-helper: poll_until_merged should set _merge_it_poll_had_label\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: merge wait line is explicit about what we are waiting for
# ---------------------------------------------------------------------------

printf '\n=== static: merge wait line is explicit ===\n'
if grep -qF 'Still waiting for merge:' "$script"; then
  printf '[PASS] merge-wait-line: uses "Still waiting for merge:"\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-wait-line: expected "Still waiting for merge:" in script output\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: CI wait lines are explicit about what is being waited on
# ---------------------------------------------------------------------------

printf '\n=== static: CI wait lines are explicit ===\n'
if grep -qF 'Still waiting for CI scheduling:' "$script" && grep -qF 'Still waiting for CI completion:' "$script"; then
  printf '[PASS] ci-wait-lines: include explicit scheduling + completion wait messages\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ci-wait-lines: expected explicit CI scheduling/completion wait messages\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: merge conflict/mergeable waits are explicit
# ---------------------------------------------------------------------------

printf '\n=== static: mergeable wait lines are explicit ===\n'
if grep -qF 'Still waiting for merge conflict status:' "$script" \
  && grep -qF 'Still waiting for merge conflict status (quick):' "$script"; then
  printf '[PASS] mergeable-wait-lines: include explicit merge conflict wait messages\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mergeable-wait-lines: expected explicit merge conflict wait messages\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: mergeable UNKNOWN compare fallback
# ---------------------------------------------------------------------------

printf '\n=== static: mergeable UNKNOWN compare fallback ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'gh_pr_compare_ff_mergeable_for_number()' "$script" \
  && grep -qF 'repos/${repo_owner}/${repo_name}/compare/${base_ref}...${head_sha}' "$script" \
  && grep -qF 'compare fallback (ahead, behind_by=0)' "$script" \
  && grep -qF 'mergeable UNKNOWN after' "$script" \
  && grep -qF 'gh_pr_base_ref_for_number()' "$script" \
  && grep -qF 'gh_pr_post_mergeable_compare_fallback_comment_optional()' "$script" \
  && grep -qF 'gh pr compare fallback comment' "$script" \
  && [[ "$(grep -cF 'gh_pr_compare_ff_mergeable_for_number "$pr_num"' "$script")" -ge 2 ]]; then
  printf '[PASS] mergeable-compare-fallback: compare ahead/behind_by=0 when mergeable UNKNOWN\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mergeable-compare-fallback: expected compare fallback for UNKNOWN mergeable\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: pinned-package detection is present
# ---------------------------------------------------------------------------

printf '\n=== static: pinned package detection ===\n'

# py_is_pinned() must be defined (still used for pip/pipenv/poetry)
if grep -q '^py_is_pinned()' "$script"; then
  printf '[PASS] py_is_pinned: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_is_pinned: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# py_is_pinned must NOT have a uv case — uv == pins are not intentional freezes;
# they should be updated and converted to >= by py_update_one.
if ! grep -A20 '^py_is_pinned()' "$script" | grep -q 'uv)'; then
  printf '[PASS] py_is_pinned: no uv case (uv == pins are updated, not skipped)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_is_pinned: uv case present — uv == pins would be silently skipped\n'
  fail=$(( fail + 1 ))
fi

# py_update_one must handle == constraint op for uv by converting to >=new (not re-pinning).
# The sed pattern must match both >= and == operators.
if grep -q '">=|==" ]]\|\[\[ .*uv_constraint_op.*==.*>=.*==\|>=|==' "$script" ||
   grep -qP 'uv_constraint_op.*==.*>=.*\|\|.*uv_constraint_op.*==.*==' "$script" ||
   grep -q '">=\|=="' "$script"; then
  printf '[PASS] py_update_one: uv handles both >= and == constraint ops\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: uv does not handle == constraint op\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: py_update_one uv path includes ~= floor bump ===\n'
if grep -qF "|| \"\$uv_constraint_op\" == \"~=\"" "$script"; then
  printf '[PASS] py-uv-tilde: uv_constraint_op gate includes ~=\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-tilde: uv ~= constraint not handled in py_update_one\n'
  fail=$(( fail + 1 ))
fi

# The uv floor bump uses py_uv_rewrite_version_floor + gnu_sed_inplace -E (GNU sed).
# then split "pkg" >= …; operators include ~=; no Perl (?:…) groups.
if grep -q '^py_uv_rewrite_version_floor()' "$script" \
  && grep -qF 'bundled before split' "$script" \
  && grep -qF '(~=|>=|==)' "$script" \
  && grep -qF 'gnu_sed_inplace -E' "$script" \
  && ! grep -q '(?:>=|==)' "$script"; then
  printf '[PASS] py_update_one: py_uv_rewrite_version_floor uses gnu_sed_inplace -E\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: missing py_uv_rewrite_version_floor gnu_sed_inplace -E wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: uv sed uses safe extras class in py_uv_rewrite_version_floor ===\n'
if grep -q '^py_uv_rewrite_version_floor()' "$script" \
  && grep -qF '\\[[a-zA-Z0-9,_=.-]+\\]' "$script"; then
  printf '[PASS] py-sed-extras: optional PEP 508 extras use alphanumeric class\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-sed-extras: missing safe extras pattern in py_uv_rewrite_version_floor\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: py_uv_rewrite_version_floor compound specifiers ===\n'
compound_rewrite_tmp="$(mktemp -d)"
compound_pyproject="${compound_rewrite_tmp}/pyproject.toml"
cat >"$compound_pyproject" <<'EOF'
[project]
name = "demo"
version = "0.1.0"
dependencies = [
  "demo-pkg>=1.0.0,<2",
  "demo-pkg[extra]>=1.0.0,<2",
  "marker-pkg>=1.0.0,<2; sys_platform == 'win32'",
  "plain-marker>=1.0.0; python_version < '3.11'",
  "split-pkg" >= 1.0.0, <2,
]
EOF
(
  # shellcheck disable=SC1091
  source "${script_dir}/../scripts/lib/gnu-sed"
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_rewrite_version_floor\(\)/,/^}$/' "$script")
  py_uv_rewrite_version_floor "$compound_pyproject" "demo-pkg" "2.0.0"
  py_uv_rewrite_version_floor "$compound_pyproject" "marker-pkg" "2.0.0"
  py_uv_rewrite_version_floor "$compound_pyproject" "plain-marker" "2.0.0"
  py_uv_rewrite_version_floor "$compound_pyproject" "split-pkg" "2.0.0"
)
if grep -qF '"demo-pkg>=2.0.0"' "$compound_pyproject" \
  && grep -qF '"demo-pkg[extra]>=2.0.0"' "$compound_pyproject" \
  && grep -qF 'marker-pkg>=2.0.0; sys_platform' "$compound_pyproject" \
  && grep -qF 'plain-marker>=2.0.0; python_version' "$compound_pyproject" \
  && grep -qF '"split-pkg" >= 2.0.0' "$compound_pyproject" \
  && ! grep -qF ',<' "$compound_pyproject"; then
  printf '[PASS] py-uv-compound: bundled, extras, and split caps rewrite to >= floor\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: compound specifier rewrite failed\n'
  cat "$compound_pyproject" >&2
  fail=$(( fail + 1 ))
fi
# No-op when the package line is absent.
if (
  # shellcheck disable=SC1091
  source "${script_dir}/../scripts/lib/gnu-sed"
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_rewrite_version_floor\(\)/,/^}$/' "$script")
  ! py_uv_rewrite_version_floor "$compound_pyproject" "missing-pkg" "9.9.9"
); then
  printf '[PASS] py-uv-compound: rewrite returns non-zero on no-op\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: rewrite must fail when constraint line is unchanged\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$compound_rewrite_tmp"

printf '\n=== static: uv compound floor verify helpers ===\n'
if grep -q '^py_uv_parse_verify_filter_pkg()' "$script" \
  && grep -qF 'lock did not land' "$script" \
  && ! grep -qF 'constraint rewrite was a no-op for' "$script" \
  && grep -qF 'py_uv_parse_verify_filter_pkg' <<<"$(awk '/^py_uv_filter_outdated_lines\(\)/,/^\}/' "$script")" \
  && grep -qF 'uv_floor_lines' <<<"$(awk '/^batch_update_all\(\)/,/^\}/' "$script")"; then
  printf '[PASS] py-uv-compound: verify parser, filter drops, batch defers Update log\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: missing verify parser, filter wiring, or batch log deferral\n'
  fail=$(( fail + 1 ))
fi

try_lock_fn="$(awk '/^py_uv_try_lockfile_with_updates\(\)/,/^}$/' "$script")"
py_update_one_fn="$(awk '/^py_update_one\(\)/,/^}$/' "$script")"
batch_update_fn="$(awk '/^batch_update_all\(\)/,/^}$/' "$script")"
# shellcheck disable=SC2016  # assert literal rewrite-or-true + floor_pkgs in source
if grep -qF 'py_uv_rewrite_version_floor "$pyproject" "$pkg" "$new_ver" || true' <<<"$try_lock_fn" \
  && grep -qF 'floor_pkgs+=("$pkg")' <<<"$try_lock_fn" \
  && grep -qF 'Floor already at target; still lock' <<<"$py_update_one_fn" \
  && ! grep -qF 'constraint rewrite was a no-op.' <<<"$py_update_one_fn" \
  && grep -qF 'py_uv_version_at_least "$floor_highest" "$new_ver"' <<<"$py_update_one_fn" \
  && grep -qF 'py_uv_rewrite_version_floor "${worktree_path}/pyproject.toml" "$pkg" "$new_ver" || true' \
    <<<"$batch_update_fn" \
  && ! grep -qF 'ERROR: batch re-rewrite failed' <<<"$batch_update_fn"; then
  printf '[PASS] py-uv-compound: no-op rewrite still floor-locks (filter, apply, batch)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: no-op rewrite must still run floor lock, not drop the pkg\n'
  fail=$(( fail + 1 ))
fi

batch_update_uv_loop="$(awk '/^batch_update_all\(\)/,/^\}/' "$script" \
  | awk '/while IFS=. read -r pkg _old new_ver; do/,/done <<< "\$py_lines_arg"/')"
# shellcheck disable=SC2016  # assert literal batch log template in source
if ! grep -qF 'log "[python/${py_tool}] Update: ${pkg} → ${new_ver}"' <<<"$batch_update_uv_loop" \
  && grep -qF 'uv_floor_lines' <<<"$(awk '/^batch_update_all\(\)/,/^\}/' "$script")"; then
  printf '[PASS] py-uv-compound: batch uv floor path does not log Update before rewrite\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: batch must not log Update before uv floor rewrite\n'
  fail=$(( fail + 1 ))
fi

batch_update_fn="$(awk '/^batch_update_all\(\)/,/^}$/' "$script")"
if awk '
  /uv_floor_lines=\(\)/ { in_apply = 1 }
  in_apply && /pyproject_bak=/ && /mktemp/ { bak = 1; next }
  in_apply && bak && /while IFS=/ && /pkg _old new_ver/ { ok = 1 }
  END { exit(ok ? 0 : 1) }
' <<<"$batch_update_fn"; then
  printf '[PASS] py-uv-compound: batch snapshots pyproject.toml before floor rewrites\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: pyproject_bak must be taken before the floor rewrite loop\n'
  fail=$(( fail + 1 ))
fi

if grep -q '^py_uv_floor_lock()' "$script" \
  && grep -qF -- '--exclude-newer-package' "$script" \
  && grep -qF 'py_uv_floor_lock "uv lock"' "$script" \
  && grep -qF 'py_uv_floor_lock "uv lock verify"' "$script"; then
  printf '[PASS] py-uv-compound: floor locks pass --exclude-newer-package for each pkg\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: missing py_uv_floor_lock age gate on floor uv lock paths\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # assert literal Update/orig_floor_pkgs tokens in source
verify_ln="$(grep -nF 'uv batch lock verify' <<<"$batch_update_fn" | head -n 1 | cut -d: -f1)"
# shellcheck disable=SC2016  # assert literal Update: ${floor_pkg} in source
update_ln="$(grep -nF 'Update: ${floor_pkg}' <<<"$batch_update_fn" | tail -n 1 | cut -d: -f1)"
# shellcheck disable=SC2016  # assert literal orig_floor_pkgs assignment in source
orig_ln="$(grep -nF 'orig_floor_pkgs=("${floor_pkgs[@]}")' <<<"$batch_update_fn" | head -n 1 | cut -d: -f1)"
# shellcheck disable=SC2016  # assert literal Update: ${floor_pkg} count in source
update_count="$(grep -cF 'Update: ${floor_pkg}' <<<"$batch_update_fn" || true)"
# shellcheck disable=SC2016  # assert literal orig_floor_pkgs expansion in source
if [[ -n "$verify_ln" && -n "$update_ln" && -n "$orig_ln" ]] \
  && grep -qF '"${orig_floor_pkgs[@]}"' <<<"$batch_update_fn" \
  && (( update_count == 1 && update_ln > verify_ln && orig_ln < verify_ln )); then
  printf '[PASS] py-uv-compound: batch Update log waits for re-lock; re-lock age-gates orig floors\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: batch must log Update after re-lock and age-gate orig_floor_pkgs\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: py_uv_lock_highest_version PEP 503 dotted names ===\n'
dotted_lock="$(mktemp)"
cat >"$dotted_lock" <<'EOF'
[[package]]
name = "zope-interface"
version = "7.2"
EOF
dotted_ver="$(
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_lock_highest_version\(\)/,/^}$/' "$script")
  py_uv_lock_highest_version "$dotted_lock" "zope.interface"
)"
rm -f "$dotted_lock"
if [[ "$dotted_ver" == '7.2' ]]; then
  printf '[PASS] py-uv-compound: lock highest version matches PEP 503 dotted names\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: expected zope.interface → 7.2, got %s\n' "$dotted_ver"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: marker-gated uv deps are discovered on a foreign platform ===\n'
# A dep marked for another platform never installs on the batch host, so
# uv-outdated and the >= floor scan both miss it. Discovery must fall back to
# the universal lockfile (issue #532).
marker_gated_tmp="$(mktemp -d)"
cat >"${marker_gated_tmp}/pyproject.toml" <<'EOF'
[project]
name = "probe"
requires-python = ">=3.12"
dependencies = [
    "requests>=2.32.0",
]

[project.optional-dependencies]
macos = [
    "pyobjc-core==12.2.1; sys_platform == 'darwin'",
    "Win_Only_Pkg>=3.0; sys_platform == 'win32'",
    "Synced_Floor_Pkg>=4.0; sys_platform == 'win32'",
    "PyVer_Pkg==5.0; python_version >= '3.12'",
]
EOF
cat >"${marker_gated_tmp}/uv.lock" <<'EOF'
[[package]]
name = "pyobjc-core"
version = "12.2.3"

[[package]]
name = "win-only-pkg"
version = "3.4.0"

[[package]]
name = "synced-floor-pkg"
version = "4.0"

[[package]]
name = "pyver-pkg"
version = "5.0"
EOF
marker_gated_rows_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^_py_uv_marker_gated_requirements\(\)/,/^}$/' "$script")
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_lock_highest_version\(\)/,/^}$/' "$script")
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_marker_gated_rows\(\)/,/^}$/' "$script")
  py_uv_marker_gated_rows "$marker_gated_tmp"
)"
# == uses the lock as both cur and new (12.2.3, not the declared 12.2.1) so only
# a strictly newer release triggers the >= promotion. A >= floor keeps the
# declared floor as cur so a floor below the lock still syncs upward, and the
# marker's own >= operator must not be mistaken for a package specifier.
if [[ "$marker_gated_rows_out" == 'pyobjc-core 12.2.3 12.2.3
Win_Only_Pkg 3.0 3.4.0
Synced_Floor_Pkg 4.0 4.0
PyVer_Pkg 5.0 5.0' ]]; then
  printf '[PASS] marker-gated: == seeds from lock, >= keeps declared floor as cur\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: unexpected rows: %s\n' "$marker_gated_rows_out"
  fail=$(( fail + 1 ))
fi

marker_gated_pkgs_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^_py_uv_marker_gated_requirements\(\)/,/^}$/' "$script")
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_marker_gated_pkgs\(\)/,/^}$/' "$script")
  py_uv_marker_gated_pkgs "$marker_gated_tmp" | tr '\n' ' '
)"
rm -rf "$marker_gated_tmp"
# Unmarked requests must not appear; names normalize to PEP 503 form.
# Output is sorted and deduped, so the expectation is in ASCII order.
marker_gated_pkgs_want='pyobjc-core pyver-pkg synced-floor-pkg win-only-pkg '
if [[ "$marker_gated_pkgs_out" == "$marker_gated_pkgs_want" ]]; then
  printf '[PASS] marker-gated: pkgs normalizes names and ignores unmarked deps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: expected "%s", got "%s"\n' \
    "$marker_gated_pkgs_want" \
    "$marker_gated_pkgs_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: py_pkg_in_list PEP 508 name equality ===\n'
pkg_in_list_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^py_pkg_in_list\(\)/,/^}$/' "$script")
  pkg_in_list_names='pyobjc-core
win-only-pkg'
  for probe in pyobjc_core PyObjC-Core Win.Only.Pkg ruff; do
    if py_pkg_in_list "$probe" "$pkg_in_list_names"; then
      printf 'hit:%s ' "$probe"
    else
      printf 'miss:%s ' "$probe"
    fi
  done
)"
if [[ "$pkg_in_list_out" == 'hit:pyobjc_core hit:PyObjC-Core hit:Win.Only.Pkg miss:ruff ' ]]; then
  printf '[PASS] marker-gated: py_pkg_in_list treats case, dot and underscore as equal\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: py_pkg_in_list results: %s\n' "$pkg_in_list_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: marker detection ignores operators inside the marker ===\n'
# Markers contain operators ("sys_platform == 'darwin'"), so a whole-string
# specifier test would match deps that carry no package version at all and seed
# spurious rows. Only the portion before ';' may be inspected (PR #537 review).
marker_operator_tmp="$(mktemp -d)"
cat >"${marker_operator_tmp}/pyproject.toml" <<'EOF'
[project]
name = "probe"
dependencies = [
    "unversioned-pkg; sys_platform == 'darwin'",
    "versioned-pkg==1.0.0; sys_platform == 'darwin'",
    "tilde-pkg~=2.0; sys_platform == 'win32'",
    "plain-pkg>=3.0",
]
EOF
marker_operator_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^_py_uv_marker_gated_requirements\(\)/,/^}$/' "$script")
  _py_uv_marker_gated_requirements "${marker_operator_tmp}/pyproject.toml" | tr '\n' '|'
)"
rm -rf "$marker_operator_tmp"
if [[ "$marker_operator_out" == "versioned-pkg==1.0.0; sys_platform == 'darwin'|tilde-pkg~=2.0; sys_platform == 'win32'|" ]]; then
  printf '[PASS] marker-gated: unversioned marker-only deps are not seeded\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: requirement extraction returned: %s\n' "$marker_operator_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: py_pkg_installed_version normalizes PEP 503 names ===\n'
installed_version_out="$(
  # shellcheck disable=SC2317,SC2329
  dep_runner_jq_with_args() { local json="$2"; shift 2; jq "$@" <<<"$json"; }
  # shellcheck disable=SC1090
  source <(awk '/^py_pkg_installed_version\(\)/,/^}$/' "$script")
  installed_probe_json='[{"name":"PyObjC_Core","version":"12.2.1"}]'
  printf '%s,%s,%s' \
    "$(py_pkg_installed_version 'pyobjc-core' "$installed_probe_json")" \
    "$(py_pkg_installed_version 'PyObjC.Core' "$installed_probe_json")" \
    "$(py_pkg_installed_version 'absent-pkg' "$installed_probe_json")"
)"
if [[ "$installed_version_out" == '12.2.1,12.2.1,' ]]; then
  printf '[PASS] marker-gated: installed lookup matches normalized names, empty when absent\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: installed lookup returned: %s\n' "$installed_version_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: seeded marker rows are dropped when nothing is newer ===\n'
# A seeded row starts at new == cur and the release-age check passes for any
# older lock version, so without this guard the row reaches
# py_uv_rewrite_version_floor and rewrites == to >= with no version change,
# committing an empty batch PR (PR #537 review).
# shellcheck disable=SC2016  # assert on the literal source text, not expansions
marker_gated_noop_guard="$(awk '/^py_outdated\(\)/{f=1} f && /\[\[ "\$new" == "\$cur" \]\] && py_pkg_in_list "\$pkg" "\$marker_gated_list"/{ok=1} f && /^}$/{f=0} END{print ok+0}' "$script")"
if [[ "$marker_gated_noop_guard" == '1' ]]; then
  printf '[PASS] marker-gated: no-op seeded rows are dropped before becoming candidates\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: missing new==cur guard for seeded rows\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: py_outdated bypasses current-platform probe for marker-gated deps ===\n'
# The dry-run probe is current-platform only and always rejects a dep whose
# marker excludes this host; the lockfile filter is the real gate (issue #532).
# shellcheck disable=SC2016  # assert on the literal source text, not expansions
marker_gated_seed="$(awk '/^py_outdated\(\)/{f=1} f && /marker_gated_list="\$\(py_uv_marker_gated_pkgs/{ok=1} f && /^}$/{f=0} END{print ok+0}' "$script")"
# The bypass must be conditional on the package being absent from this
# environment; a satisfied marker means the dep is installed and probeable.
# shellcheck disable=SC2016  # assert on the literal source text, not expansions
marker_gated_bypass="$(awk '/^py_outdated\(\)/{f=1} f && /\[\[ -z "\$marker_gated_installed" \]\] && py_pkg_in_list "\$pkg" "\$marker_gated_list"/{ok=1} f && /^}$/{f=0} END{print ok+0}' "$script")"
if [[ "$marker_gated_seed" == '1' && "$marker_gated_bypass" == '1' ]]; then
  printf '[PASS] marker-gated: py_outdated seeds marker rows and skips the probe only when absent\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] marker-gated: py_outdated wiring missing (seed=%s bypass=%s)\n' \
    "$marker_gated_seed" "$marker_gated_bypass"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: py_uv_parse_verify_filter_pkg log messages ===\n'
verify_parser_log="$(mktemp)"
printf '%s\n' 'lock did not land django at 6.1 (highest 6.0.8)' >"$verify_parser_log"
verify_parser_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^py_uv_parse_verify_filter_pkg\(\)/,/^}$/' "$script")
  py_uv_parse_verify_filter_pkg "$verify_parser_log"
)"
rm -f "$verify_parser_log"
if [[ "$verify_parser_out" == 'django' ]]; then
  printf '[PASS] py-uv-compound: verify parser reads lock-did-not-land lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: verify parser got django=%s\n' "$verify_parser_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: py_uv_filter keeps compound cap rewrite with mock uv lock ===\n'
compound_filter_tmp="$(mktemp -d)"
mock_uv_bin="${compound_filter_tmp}/bin"
mkdir -p "$mock_uv_bin"
cat >"${mock_uv_bin}/uv" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == 'lock' ]]; then
  cat >uv.lock <<'LOCK'
version = 1
requires-python = ">=3.11"

[[package]]
name = "idna"
version = "3.10"
source = { registry = "https://pypi.org/simple" }
LOCK
  exit 0
fi
printf 'mock uv: unsupported args: %s\n' "$*" >&2
exit 1
EOF
chmod +x "${mock_uv_bin}/uv"
cat >"${compound_filter_tmp}/pyproject.toml" <<'EOF'
[project]
name = "compound-filter-demo"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = ["idna>=3.0,<3.1"]
EOF
cat >"${compound_filter_tmp}/uv.lock" <<'EOF'
version = 1
requires-python = ">=3.11"

[[package]]
name = "idna"
version = "3.0"
source = { registry = "https://pypi.org/simple" }
EOF
compound_filter_out_file="$(mktemp)"
compound_filter_rc=0
(
  dir="$compound_filter_tmp"
  # shellcheck disable=SC1091
  source "${script_dir}/../scripts/lib/gnu-sed"
  # shellcheck disable=SC1090
  source <(
    awk '/^py_constraint_op\(\)/,/^}$/' "$script"
    awk '/^py_uv_version_at_least\(\)/,/^}$/' "$script"
    awk '/^py_uv_lock_highest_version\(\)/,/^}$/' "$script"
    awk '/^py_uv_rewrite_version_floor\(\)/,/^}$/' "$script"
    awk '/^py_uv_parse_verify_filter_pkg\(\)/,/^}$/' "$script"
    awk '/^py_uv_parse_blame_direct_dep\(\)/,/^}$/' "$script"
    awk '/^py_uv_try_lockfile_with_updates\(\)/,/^}$/' "$script"
    awk '/^py_uv_filter_outdated_lines\(\)/,/^}$/' "$script"
  )
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC2317,SC2329
  dep_runner_uv_dir_capture() {
    local _label="$1"
    local scan_root="$2"
    shift 2
    [[ "$1" == '--' ]] && shift
    (cd "$scan_root" && PATH="${mock_uv_bin}:${PATH}" uv "$@")
  }
  # shellcheck disable=SC2317,SC2329
  py_uv_floor_lock() {
    local _label="$1"
    local scan_root="$2"
    shift 2
    dep_runner_uv_dir_capture "$_label" "$scan_root" -- lock
  }
  py_uv_filter_outdated_lines "$compound_filter_tmp" "idna 3.0 3.10"
) >"$compound_filter_out_file" || compound_filter_rc=$?
compound_filter_out="$(cat "$compound_filter_out_file")"
rm -f "$compound_filter_out_file"
if [[ "$compound_filter_rc" -eq 0 ]] \
  && [[ "$compound_filter_out" == 'idna 3.0 3.10' ]]; then
  printf '[PASS] py-uv-compound: filter keeps idna after compound cap rewrite + mock lock\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: filter expected idna 3.0 3.10, rc=%s out=%s\n' \
    "$compound_filter_rc" "$compound_filter_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$compound_filter_tmp"

printf '\n=== behavioural: py_uv_filter keeps no-op rewrite when lock lands ===\n'
noop_filter_tmp="$(mktemp -d)"
mock_uv_bin="${noop_filter_tmp}/bin"
mkdir -p "$mock_uv_bin"
cat >"${mock_uv_bin}/uv" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == 'lock' ]]; then
  cat >uv.lock <<'LOCK'
version = 1
requires-python = ">=3.11"

[[package]]
name = "django"
version = "6.1"
source = { registry = "https://pypi.org/simple" }
LOCK
  exit 0
fi
printf 'mock uv: unsupported args: %s\n' "$*" >&2
exit 1
EOF
chmod +x "${mock_uv_bin}/uv"
cat >"${noop_filter_tmp}/pyproject.toml" <<'EOF'
[project]
name = "noop-filter-demo"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = ["django>=6.1"]
EOF
cat >"${noop_filter_tmp}/uv.lock" <<'EOF'
version = 1
requires-python = ">=3.11"

[[package]]
name = "django"
version = "6.0.8"
source = { registry = "https://pypi.org/simple" }
EOF
noop_filter_out_file="$(mktemp)"
noop_filter_rc=0
(
  dir="$noop_filter_tmp"
  # shellcheck disable=SC1091
  source "${script_dir}/../scripts/lib/gnu-sed"
  # shellcheck disable=SC1090
  source <(
    awk '/^py_constraint_op\(\)/,/^}$/' "$script"
    awk '/^py_uv_version_at_least\(\)/,/^}$/' "$script"
    awk '/^py_uv_lock_highest_version\(\)/,/^}$/' "$script"
    awk '/^py_uv_rewrite_version_floor\(\)/,/^}$/' "$script"
    awk '/^py_uv_parse_verify_filter_pkg\(\)/,/^}$/' "$script"
    awk '/^py_uv_parse_blame_direct_dep\(\)/,/^}$/' "$script"
    awk '/^py_uv_try_lockfile_with_updates\(\)/,/^}$/' "$script"
    awk '/^py_uv_filter_outdated_lines\(\)/,/^}$/' "$script"
  )
  # shellcheck disable=SC2317,SC2329
  log() { :; }
  # shellcheck disable=SC2317,SC2329
  dep_runner_uv_dir_capture() {
    local _label="$1"
    local scan_root="$2"
    shift 2
    [[ "$1" == '--' ]] && shift
    (cd "$scan_root" && PATH="${mock_uv_bin}:${PATH}" uv "$@")
  }
  # shellcheck disable=SC2317,SC2329
  py_uv_floor_lock() {
    local _label="$1"
    local scan_root="$2"
    shift 2
    dep_runner_uv_dir_capture "$_label" "$scan_root" -- lock
  }
  py_uv_filter_outdated_lines "$noop_filter_tmp" "django 6.0.8 6.1"
) >"$noop_filter_out_file" || noop_filter_rc=$?
noop_filter_out="$(cat "$noop_filter_out_file")"
rm -f "$noop_filter_out_file"
if [[ "$noop_filter_rc" -eq 0 ]] \
  && [[ "$noop_filter_out" == 'django 6.0.8 6.1' ]]; then
  printf '[PASS] py-uv-compound: filter keeps django when rewrite is no-op and lock lands\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-uv-compound: no-op filter expected django 6.0.8 6.1, rc=%s out=%s\n' \
    "$noop_filter_rc" "$noop_filter_out"
  fail=$(( fail + 1 ))
fi
rm -rf "$noop_filter_tmp"

printf '\n=== static: npm packument helper and pnpm stale-high clamp ===\n'
if grep -q '^npm_registry_dist_tag_latest()' "$script" \
  && grep -qF 'DEP_UPDATER_SKIP_NPM_REGISTRY' "$script" \
  && grep -qF 'strictly above registry latest' "$script"; then
  printf '[PASS] npm-registry: dist-tags helper + stale-high clamp documented\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-registry: missing packument helper or clamp comment\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: npm newest eligible version (release-age fallback) ===\n'
if grep -q '^npm_pick_eligible_new_version()' "$script" \
  && grep -q '^_npm_registry_stable_versions_desc()' "$script" \
  && grep -qF 'npm_pick_eligible_new_version' "$script" \
  && grep -qF 'newest eligible; dist-tags.latest' "$script"; then
  printf '[PASS] npm-eligible: pick newest eligible stable version when latest is too new\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-eligible: missing npm_pick_eligible_new_version or fallback log\n'
  fail=$(( fail + 1 ))
fi

release_age_npm_pick_fn="$(awk '/^npm_pick_eligible_new_version\(\)/,/^\}/' "$script")"
prefetch_pkg_needle="npm_version_prefetch \"\$pkg\""
if grep -qF "$prefetch_pkg_needle" <<<"$release_age_npm_pick_fn" \
  && ! grep -qF 'npm_version_prefetch_closure' <<<"$release_age_npm_pick_fn" \
  && grep -qF 'npm_pnpm_filter_outdated_lines' <<<"$release_age_npm_pick_fn"; then
  printf '[PASS] npm-eligible: age walk + top-level prefetch; lockfile filter validates closure\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-eligible: npm_pick_eligible_new_version must age-walk and defer closure to lockfile filter\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: typescript major bumps are held (#401) ===\n'
if grep -q '^npm_should_skip_typescript_major()' "$script" \
  && grep -q '^npm_semver_major()' "$script" \
  && grep -qF 'npm_should_skip_typescript_major' <<<"$release_age_npm_pick_fn" \
  && grep -qF 'typescript-eslint lacks TS major support' "$script" \
  && grep -cF 'typescript-eslint lacks TS major support' "$script" | grep -qE '^[3-9]$|^[1-9][0-9]' \
  && grep -qF 'TypeScript major bumps are held' "${script_dir}/../AGENTS.md"; then
  printf '[PASS] typescript-major: pick skips majors and AGENTS.md documents the hold\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] typescript-major: missing skip helper, pick wiring, or AGENTS.md policy\n'
  fail=$(( fail + 1 ))
fi

# Behavioural: same-major stays; major without CVE is skipped.
ts_helpers="$(awk '
  /^npm_semver_major\(\)/ {p=1}
  /^npm_should_skip_typescript_major\(\)/ {p=1}
  p {print}
  p && /^}/ {p=0}
' "$script")"
ts_probe_out="$(
  bash -c '
    set -euo pipefail
    npm_pkg_has_cve_fix_in_audit() { return 1; }
    eval "$1"
    if npm_should_skip_typescript_major "6.0.3" "7.0.2"; then
      printf "skip-major "
    else
      printf "allow-major "
    fi
    if npm_should_skip_typescript_major "6.0.3" "6.0.4"; then
      printf "skip-patch"
    else
      printf "allow-patch"
    fi
  ' _ "$ts_helpers"
)"
if [[ "$ts_probe_out" == 'skip-major allow-patch' ]]; then
  printf '[PASS] typescript-major: skips 6→7 and allows same-major patch\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] typescript-major: unexpected probe result: %s\n' "$ts_probe_out"
  fail=$(( fail + 1 ))
fi

ts_malformed_out="$(
  bash -c '
    set -euo pipefail
    npm_pkg_has_cve_fix_in_audit() { return 1; }
    eval "$1"
    if npm_should_skip_typescript_major "abc" "7.0.2"; then
      printf "skip"
    else
      printf "allow"
    fi
  ' _ "$ts_helpers"
)"
if [[ "$ts_malformed_out" == 'allow' ]]; then
  printf '[PASS] typescript-major: malformed current major does not force a skip\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] typescript-major: expected allow for malformed current; got %s\n' "$ts_malformed_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: python newest eligible version (release-age fallback) ===\n'
if grep -q '^py_pick_eligible_new_version()' "$script" \
  && grep -q '^_pypi_stable_versions_desc_from_body()' "$script" \
  && grep -qF 'py_pick_eligible_new_version' "$script" \
  && grep -qF 'newest eligible; latest' "$script"; then
  printf '[PASS] py-eligible: pick newest eligible stable version when latest is too new\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-eligible: missing py_pick_eligible_new_version or fallback log\n'
  fail=$(( fail + 1 ))
fi

release_age_py_pick_fn="$(awk '/^py_pick_eligible_new_version\(\)/,/^\}/' "$script")"
py_age_from_json_needle="_py_version_meets_minimum_release_age_from_json \"\$body\" \"\$pkg\" \"\$ver\""
py_stable_from_body_needle="_pypi_stable_versions_desc_from_body \"\$body\""
py_outdated_pick_needle="py_pick_eligible_new_version \"\$pkg\" \"\$cur\""
# shellcheck disable=SC2016  # grep -qF needles are literal source tokens, not shell expansions
if grep -qF "$py_age_from_json_needle" <<<"$release_age_py_pick_fn" \
  && grep -qF "$py_stable_from_body_needle" <<<"$release_age_py_pick_fn" \
  && grep -qF "$py_outdated_pick_needle" "$script"; then
  printf '[PASS] py-eligible: age walk from cached PyPI project JSON; py_outdated calls pick\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-eligible: py_pick_eligible_new_version must age-walk packument and wire into py_outdated\n'
  fail=$(( fail + 1 ))
fi

# Floor-only bumps set new=installed; must still walk (do not gate pick on
# "$new" != "$installed_new"). Regression: bunnify Dependabot #222 (ruff).
py_outdated_pick_fn="$(awk '/^py_outdated\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # assert absence of the old installed-only skip gate
if grep -qF "$py_outdated_pick_needle" <<<"$py_outdated_pick_fn" \
  && ! grep -qF '"$new" != "$installed_new"' <<<"$py_outdated_pick_fn"; then
  printf '[PASS] py-eligible: floor bumps (new==installed) still walk for eligible version\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py-eligible: py_outdated must walk even when new equals installed (floor bumps)\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: uv dir helpers require -- before uv subcommand ===\n'
if ! grep -E 'dep_runner_uv_dir(_stdout|_capture|) "' "$script" \
  | grep -vE '\(\) \{|^#' \
  | grep -vE ' -- ' \
  | grep -q .; then
  printf '[PASS] uv-dir: all dep_runner_uv_dir* call sites pass -- before uv args\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-dir: dep_runner_uv_dir* call missing -- separator\n'
  grep -E 'dep_runner_uv_dir(_stdout|_capture|) "' "$script" \
    | grep -vE '\(\) \{|^#' \
    | grep -vE ' -- ' || true
  fail=$(( fail + 1 ))
fi

printf '\n=== static: cargo dir helpers require -- before cargo subcommand ===\n'
if ! grep -E 'dep_runner_cargo_dir(_stdout|_capture|) "' "$script" \
  | grep -vE '\(\) \{|^#' \
  | grep -vE ' -- ' \
  | grep -q .; then
  printf '[PASS] cargo-dir: all dep_runner_cargo_dir* call sites pass -- before cargo args\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cargo-dir: dep_runner_cargo_dir* call missing -- separator\n'
  grep -E 'dep_runner_cargo_dir(_stdout|_capture|) "' "$script" \
    | grep -vE '\(\) \{|^#' \
    | grep -vE ' -- ' || true
  fail=$(( fail + 1 ))
fi

printf '\n=== static: auth prereqs avoid grep -P (macOS BSD grep) ===\n'
if ! awk '/^check_auth_prereqs\(\)/,/^}/' "$script" | grep -q 'grep -oP'; then
  printf '[PASS] auth: check_auth_prereqs does not use grep -oP\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] auth: check_auth_prereqs still uses grep -oP\n'
  fail=$(( fail + 1 ))
fi

if awk '/^check_auth_prereqs\(\)/,/^}/' "$script" | grep -qF 'dep_runner_gh_stdout "gh api user login"'; then
  printf '[PASS] auth: gh user resolved via gh api\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] auth: expected gh api user login in check_auth_prereqs\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # intentional literal match for source tokens
auth_prereq_body="$(awk '/^check_auth_prereqs\(\)/,/^}/' "$script")"
if printf '%s' "$auth_prereq_body" | grep -qF 'dep_stacking_is_graphite' \
  && printf '%s' "$auth_prereq_body" | grep -qF 'gt auth' \
  && printf '%s' "$auth_prereq_body" | grep -qF 'runner_sh_stdout "gt auth status" --timeout 20' \
  && awk '
    /^check_auth_prereqs\(\)/ { in_fn=1 }
    in_fn && /dep_stacking_is_graphite/ { gated=1 }
    in_fn && gated && /gt auth/ { ok=1 }
    in_fn && /^}/ { exit }
    END { exit(ok ? 0 : 1) }
  ' "$script"; then
  printf '[PASS] auth: gt auth gated on dep_stacking_is_graphite (gh-stack skips)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] auth: gt auth must be inside dep_stacking_is_graphite gate\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== hermetic: check_auth_prereqs skips gt auth for gh-stack ===\n'
tmp_auth_log="$(mktemp)"
auth_fn="$(awk '/^check_auth_prereqs\(\)/,/^}/' "$script")"
auth_out=''
if auth_out="$(bash -c "
  set -euo pipefail
  dep_stacking_tool='gh-stack'
  dep_stacking_is_graphite() { return 1; }
  dep_stacking_is_gh_stack() { return 0; }
  log() { printf '%s\n' \"\$*\"; }
  die() { printf 'DIE:%s\n' \"\$*\" >&2; exit 1; }
  dep_runner_gh_stdout() { printf 'test-user\n'; }
  dep_runner_gh() { return 0; }
  runner_sh_stdout() {
    printf 'UNEXPECTED_GT_AUTH:%s\n' \"\$1\" >>'${tmp_auth_log}'
    return 1
  }
  ${auth_fn}
  check_auth_prereqs
  ! grep -q . '${tmp_auth_log}'
")" \
  && grep -qF 'gh: logged in as test-user' <<<"${auth_out}" \
  && ! grep -qF 'gt: authenticated' <<<"${auth_out}" \
  && ! grep -qF 'UNEXPECTED_GT_AUTH' "${tmp_auth_log}"; then
  printf '[PASS] hermetic: gh-stack check_auth_prereqs skips gt auth\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: gh-stack check_auth_prereqs still invoked gt auth\n'
  fail=$(( fail + 1 ))
  printf '%s\n' "${auth_out:-}" >&2
  cat "${tmp_auth_log}" >&2 || true
fi
rm -f "${tmp_auth_log}"

printf '\n=== static: state_set uses gnu_sed_inplace ===\n'
if awk '/^state_set\(\)/,/^}/' "$script" | grep -qF 'gnu_sed_inplace' \
  && ! awk '/^state_set\(\)/,/^}/' "$script" | grep -qF "sed -i ''"; then
  printf '[PASS] state: state_set uses gnu_sed_inplace\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] state: state_set must use gnu_sed_inplace (not BSD sed branch)\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: ecosystem failures are collected without aborting ===\n'
if grep -q '^dep_updater_append_ecosystem_failure()' "$script" \
  && grep -qF 'dep_updater_append_ecosystem_failure' "$script" \
  && grep -qF '[ecosystem-failures]' "$script"; then
  printf '[PASS] eco-fail: ecosystem failure helpers and banner present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] eco-fail: missing ecosystem failure collection or banner\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must pass --arg semver_only to jq (semver-only uses .wanted)
if grep -q '\-\-arg semver_only' "$script"; then
  printf '[PASS] npm_outdated: passes semver_only to jq filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: --arg semver_only missing from jq call\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must pass --argjson specs to jq (local/git reference filtering)
if grep -q '\-\-argjson specs' "$script"; then
  printf '[PASS] npm_outdated: passes package.json specs to jq filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: --argjson specs missing from jq call\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must NOT skip exact-pinned packages (e.g. "3.0.0"); only local/git refs are skipped
if ! grep -q '"^\[=\]?\[0-9\]' "$script"; then
  printf '[PASS] npm_outdated: exact-pinned npm packages are not skipped (only local/git refs excluded)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: exact-pinned npm skip pattern still present — should have been removed\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must skip packages where package.json spec already equals latest (stale node_modules)
if grep -q 'ltrimstr("=")' "$script"; then
  printf '[PASS] npm_outdated: skips packages where spec already equals latest (stale node_modules guard)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: missing stale node_modules guard (ltrimstr("=") comparison)\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must skip packages where lockfile already resolves range to latest (wanted == latest)
if grep -q '.value.wanted != .value.latest' "$script"; then
  printf '[PASS] npm_outdated: skips packages where lockfile already resolves to latest (wanted == latest guard)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: missing wanted==latest guard (range resolved to latest in lockfile)\n'
  fail=$(( fail + 1 ))
fi

# package.json update patches must use jq explode/index to preserve range prefix
prefix_count="$(grep -c 'explode | map(. >= 48' "$script" || true)"
if (( prefix_count >= 2 )); then
  printf '[PASS] npm update patches: both use explode/index to preserve range prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm update patches: expected >=2 explode/index calls for range prefix, found %d\n' \
    "$prefix_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: CI gates separated from PR creation
# ---------------------------------------------------------------------------

printf '\n=== static: ci gates separated from pr creation ===\n'

# gate_all_created_prs() must be defined — it is the single post-creation gate pass.
if grep -q '^gate_all_created_prs()' "$script"; then
  printf '[PASS] gate_all_created_prs: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gate_all_created_prs: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# gate_all_created_prs must be called in the main flow (before finalize_prs).
if grep -q 'gate_all_created_prs$' "$script"; then
  printf '[PASS] gate_all_created_prs: called in main flow\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gate_all_created_prs: not called as a standalone statement in main flow\n'
  fail=$(( fail + 1 ))
fi

# npm_update_group must NOT contain a per-PR CI gate (no_wait_ci check inside it).
# Extract just the npm_update_group function body and verify the gate was removed.
npm_gate_count="$(awk '/^npm_update_group\(\)/{found=1} found && /^}$/{found=0} found && /no_wait_ci/' "$script" | wc -l | tr -d ' ')"
if [[ "$npm_gate_count" -eq 0 ]]; then
  printf '[PASS] npm_update_group: per-PR CI gate removed (no no_wait_ci check inside)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_update_group: per-PR CI gate still present (%s occurrences of no_wait_ci)\n' \
    "$npm_gate_count"
  fail=$(( fail + 1 ))
fi

# py_update_one must NOT contain a per-PR CI gate.
py_gate_count="$(awk '/^py_update_one\(\)/{found=1} found && /^}$/{found=0} found && /no_wait_ci/' "$script" | wc -l | tr -d ' ')"
if [[ "$py_gate_count" -eq 0 ]]; then
  printf '[PASS] py_update_one: per-PR CI gate removed (no no_wait_ci check inside)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: per-PR CI gate still present (%s occurrences of no_wait_ci)\n' \
    "$py_gate_count"
  fail=$(( fail + 1 ))
fi

# batch_update_all must NOT contain a per-PR CI gate.
batch_gate_count="$(awk '/^batch_update_all\(\)/{found=1} found && /^}$/{found=0} found && /no_wait_ci/' "$script" | wc -l | tr -d ' ')"
if [[ "$batch_gate_count" -eq 0 ]]; then
  printf '[PASS] batch_update_all: per-PR CI gate removed (no no_wait_ci check inside)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch_update_all: per-PR CI gate still present (%s occurrences of no_wait_ci)\n' \
    "$batch_gate_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: constraint-dependencies isolation
# ---------------------------------------------------------------------------

printf '\n=== static: constraint-dependencies isolation ===\n'

# py_outdated ge-floor extraction must use awk section tracking, not rg -o, so
# constraint-dependencies entries (which rg -o cannot filter from context) are excluded.
if grep -q 'in_direct = 1' "$script"; then
  printf '[PASS] py_outdated: uses awk section tracking to skip constraint-dependencies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: awk section tracking (in_direct) not found; constraint-dependencies may leak\n'
  fail=$(( fail + 1 ))
fi

# The eligibility loop in py_outdated must validate PEP 508 package names to drop
# any mangled strings (e.g. "constraint-dependencies=[...") that slip through.
py_outdated_pep508="$(awk '/^py_outdated\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # grep -qF needles are literal source tokens
if grep -qF 'read -r pkg cur new' <<<"$py_outdated_pep508" \
  && grep -qE 'A-Za-z0-9.*A-Za-z0-9\._-' <<<"$py_outdated_pep508"; then
  printf '[PASS] py_outdated: output loop validates PEP 508 package names\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: PEP 508 name validation missing from output loop\n'
  fail=$(( fail + 1 ))
fi

# py_outdated must probe transitive-only upgrades with per-package dry-run
# (e.g. amqtt pinning click<8.2). Direct pyproject.toml bumps use batch uv lock.
py_probe_fn="$(awk '/^py_uv_probe_transitive_upgrade\(\)/,/^\}/' "$script")"
if grep -q '^py_uv_probe_transitive_upgrade()' "$script" \
  && grep -q 'pip install --dry-run' <<<"$py_probe_fn"; then
  printf '[PASS] py_outdated: transitive probe uses uv pip install --dry-run\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: py_uv_probe_transitive_upgrade with dry-run missing\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # static assert matches literal source text, not expanded vars
if grep -qF 'pip install --dry-run -r "$dry_req_tmp"' <<<"$py_probe_fn"; then
  printf '[PASS] py_outdated: transitive probe uses -r requirements file\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: transitive probe must use -r requirements file\n'
  fail=$(( fail + 1 ))
fi

py_outdated_fn="$(awk '/^py_outdated\(\)/,/^\}/' "$script")"
if grep -qF 'py_uv_filter_outdated_lines' <<<"$py_outdated_fn" \
  && grep -qF 'direct_failing' <<<"$py_outdated_fn" \
  && grep -qF 'direct_passing' <<<"$py_outdated_fn" \
  && grep -qF 'py_uv_probe_transitive_upgrade' <<<"$py_outdated_fn" \
  && [[ "$(grep -cF 'py_uv_filter_outdated_lines' <<<"$py_outdated_fn" || true)" -ge 2 ]]; then
  printf '[PASS] py_outdated: lockfile-filters direct_passing and direct_failing; probes transitives\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: must batch-filter direct_passing and direct_failing; probe transitives\n'
  fail=$(( fail + 1 ))
fi

# Unverifiable uv lock must not silently drop dry-run-passing directs.
# shellcheck disable=SC2016  # needles are literal source tokens
py_filter_fn="$(awk '/^py_uv_filter_outdated_lines\(\)/,/^\}/' "$script")"
if grep -qF 'return 1' <<<"$py_filter_fn" \
  && grep -qF 'could not verify proposed updates against lockfile' <<<"$py_filter_fn" \
  && grep -qF 'falling back to dry-run-passing direct updates' <<<"$py_outdated_fn" \
  && grep -qF 'emitted dry-run-passing directs without lockfile filter' <<<"$py_outdated_fn" \
  && grep -qF 'union_direct' <<<"$py_outdated_fn" \
  && grep -qF 'batch uv lock failed (non-resolution; floors reverted)' "$script"; then
  printf '[PASS] py_outdated: unverifiable lock falls back + reports; batch non-resolution marks failure\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: missing unverifiable-lock fallback / ecosystem failure reporting\n'
  fail=$(( fail + 1 ))
fi

# Capture awk snippets before grep -q: under pipefail, grep -q closes the pipe
# early and awk's SIGPIPE (141) fails the pipeline even when the match exists.
py_constraint_snip="$(awk '/^py_constraint_op\(\)/,/^\}/' "$script")"
py_outdated_snip="$(awk '/^py_outdated\(\)/,/^\}/' "$script")"
if grep -qF 'constraint-dependencies' "$script" \
  && grep -qF 'in_direct' <<<"$py_constraint_snip"; then
  printf '[PASS] py_constraint_op: scopes operator lookup to project dependencies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_constraint_op: must ignore tool.uv constraint-dependencies\n'
  fail=$(( fail + 1 ))
fi

# PEP 735 [dependency-groups] (bunnify pyright/ruff) must be treated as direct —
# otherwise stale floors are never proposed and Dependabot wins the race.
# shellcheck disable=SC2016  # assert literal awk patterns in source
if grep -qF 'dependency-groups' <<<"$py_constraint_snip" \
  && grep -qF 'dependency-groups' <<<"$py_outdated_snip"; then
  printf '[PASS] pyproject scanners: include PEP 735 dependency-groups as direct deps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pyproject scanners: dependency-groups must be in py_constraint_op and py_outdated\n'
  fail=$(( fail + 1 ))
fi

# Behavioural: floor extractor must emit dependency-groups >= specs (and still
# skip tool.uv constraint-dependencies). Keep this awk in lockstep with
# py_outdated's inline scanner (asserted above to include dependency-groups).
synth_pyproject="$(mktemp "${TMPDIR:-/tmp}/dep-updater-depgroups.XXXXXX")"
cat >"$synth_pyproject" <<'EOF'
[project]
dependencies = [
    "click>=8.0.0",
]

[dependency-groups]
dev = [
    "pyright>=1.1.410",
    "ruff>=0.15.17",
]

[tool.uv]
constraint-dependencies = [
    "urllib3>=2.0.0",
]
EOF
floor_out="$(awk '
  BEGIN { in_direct = 0 }
  /^\[[[:space:]]*(project|project\.[^]]*|dependency-groups)[[:space:]]*\]/ {
    in_direct = 1
    next
  }
  /^\[/ { in_direct = 0; next }
  !in_direct { next }
  /constraint-dependencies/ { next }
  {
    s = $0
    while (1) {
      if (match(s, /"[A-Za-z0-9][A-Za-z0-9._-]*[^"=<>!~,]*>=[^"]*"/)) {
        print substr(s, RSTART+1, RLENGTH-2)
        s = substr(s, RSTART+RLENGTH)
      } else break
    }
  }
' "$synth_pyproject")"
rm -f "$synth_pyproject"
if grep -qxF 'pyright>=1.1.410' <<<"$floor_out" \
  && grep -qxF 'ruff>=0.15.17' <<<"$floor_out" \
  && grep -qxF 'click>=8.0.0' <<<"$floor_out" \
  && ! grep -qF 'urllib3' <<<"$floor_out"; then
  printf '[PASS] py_outdated floor awk: emits dependency-groups floors; skips constraint-dependencies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated floor awk: unexpected floors\n'
  printf '       got:\n%s\n' "$floor_out"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Behavioural: uv transitive-constraint probe
# ---------------------------------------------------------------------------

printf '\n=== behavioural: uv transitive-constraint probe ===\n'

# The probe pipes all installed packages (with pkg replaced by new_ver) as
# requirements to 'uv pip install --dry-run'.  Test the jq pipeline directly:
# given a synthetic installed_json, it must emit pkg==new_ver for the target
# package and name==current_ver for all others, with editable installs excluded.
if ! command -v jq >/dev/null 2>&1; then
  printf '[SKIP] jq not on PATH — skipping probe jq-pipeline test\n'
else
  synthetic_json='[
    {"name":"click","version":"8.1.8"},
    {"name":"typer","version":"0.15.4"},
    {"name":"my-pkg","version":"0.1.0","editable_project_location":"/src/my-pkg"}
  ]'
  probe_output="$(printf '%s' "$synthetic_json" \
    | jq -r --arg p "click" --arg v "8.3.2" \
        '.[] | select(has("editable_project_location") | not)
             | if (.name | ascii_downcase) == ($p | ascii_downcase)
               then "\(.name)==" + $v
               else "\(.name)==\(.version)"
               end')"
  expected="$(printf 'click==8.3.2\ntyper==0.15.4')"
  if [[ "$probe_output" == "$expected" ]]; then
    printf '[PASS] probe jq pipeline: target replaced, others pinned, editable excluded\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] probe jq pipeline: unexpected output\n'
    printf '       expected: %s\n' "$expected"
    printf '       got:      %s\n' "$probe_output"
    fail=$(( fail + 1 ))
  fi
fi

# Live probe: run the real uv dry-run against the my-tracks venv if present.
# This validates the full pipeline catches a transitive constraint violation
# (amqtt→typer==0.15.4→click<8.2 blocks click 8.3.2).
my_tracks_dir="${HOME}/work/ai/my-tracks"
if ! command -v uv >/dev/null 2>&1; then
  printf '[SKIP] uv not on PATH — skipping live probe test\n'
elif [[ ! -d "${my_tracks_dir}/.venv" ]]; then
  printf '[SKIP] my-tracks venv not found — skipping live probe test\n'
else
  live_installed_json=""
  if live_installed_json="$(cd "$my_tracks_dir" && uv pip list --format=json 2>/dev/null)"; then
    :
  else
    live_installed_json=""
  fi
  if [[ -z "$live_installed_json" ]]; then
    printf '[SKIP] uv pip list failed in my-tracks — skipping live probe test\n'
  else
    # click==8.3.2 must be blocked (typer==0.15.4 requires click<8.2)
    live_blocked=0
    if printf '%s' "$live_installed_json" \
        | jq -r --arg p "click" --arg v "8.3.2" \
            '.[] | select(has("editable_project_location") | not)
                 | if (.name | ascii_downcase) == ($p | ascii_downcase)
                   then "\(.name)==" + $v
                   else "\(.name)==\(.version)"
                   end' \
        | (cd "$my_tracks_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
      live_blocked=1  # exit 0 = probe thinks it's fine — wrong for the old fixture
    fi
    if [[ "$live_blocked" -eq 0 ]]; then
      printf '[PASS] live probe: click==8.3.2 blocked by my-tracks transitive constraints\n'
      pass=$(( pass + 1 ))
    else
      # my-tracks may have moved past typer==0.15.4 / click<8.2; skip rather than
      # fail the whole suite when the host fixture no longer encodes that constraint.
      printf '[SKIP] live probe: click==8.3.2 not blocked (my-tracks transitive click pin absent)\n'
    fi

    # An unblocked upgrade (shellcheck-py) must pass through the probe.
    live_sc_ver="$(printf '%s' "$live_installed_json" \
      | jq -r '.[] | select(.name == "shellcheck-py") | .version' 2>/dev/null || true)"
    if [[ -n "$live_sc_ver" ]]; then
      live_sc_ok=0
      if printf '%s' "$live_installed_json" \
          | jq -r --arg p "shellcheck-py" --arg v "0.11.0.1" \
              '.[] | select(has("editable_project_location") | not)
                   | if (.name | ascii_downcase) == ($p | ascii_downcase)
                     then "\(.name)==" + $v
                     else "\(.name)==\(.version)"
                     end' \
          | (cd "$my_tracks_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
        live_sc_ok=1
      fi
      if [[ "$live_sc_ok" -eq 1 ]]; then
        printf '[PASS] live probe: shellcheck-py==0.11.0.1 allowed in my-tracks\n'
        pass=$(( pass + 1 ))
      else
        printf '[FAIL] live probe: shellcheck-py==0.11.0.1 was incorrectly rejected\n'
        fail=$(( fail + 1 ))
      fi
    fi
  fi
fi

printf '\n=== static: uv batch lockfile verification restores manifests ===\n'
# shellcheck disable=SC2016  # intentional literal grep for cp "$bak_proj" in script
if grep -q '^py_uv_try_lockfile_with_updates()' "$script" \
  && grep -qF 'cp "$bak_proj" "$pyproject"' "$script" \
  && grep -qF 'cp "$bak_lock" "$lockfile"' "$script" \
  && grep -qF 'py_uv_filter_outdated_lines' "$script"; then
  printf '[PASS] uv-lockfile-verify: dry-run lock restores pyproject.toml and uv.lock\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-lockfile-verify: expected py_uv_try_lockfile_with_updates with restore\n'
  fail=$(( fail + 1 ))
fi

batch_update_fn="$(awk '/^batch_update_all\(\)/,/^\}/' "$script")"
if grep -qF 'py_uv_floor_lock "uv batch lock"' <<<"$batch_update_fn" \
  && grep -qF 'py_uv_floor_lock "uv batch lock verify"' <<<"$batch_update_fn" \
  && grep -qF 'uv_floor_batch' <<<"$batch_update_fn"; then
  printf '[PASS] uv-batch-apply: age-gated uv lock after all pyproject floor rewrites\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-batch-apply: batch_update_all must run py_uv_floor_lock for floor bumps\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: >= floor revert on failure ===\n'

# py_update_one must restore pyproject.toml when uv lock fails after a sed patch
# so the file is not left dirty and does not corrupt subsequent update attempts.
# Prefer snapshot restore (handles untracked locks); bare checkout still counts.
revert_count=0
revert_count="$(grep -cE 'checkout -- pyproject\.toml|py_uv_restore_after_failed_floor_lock' "$script" 2>/dev/null || true)"
if (( revert_count >= 2 )); then
  printf '[PASS] pyproject.toml revert: present via checkout and/or snapshot restore\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pyproject.toml revert: expected >=2 restore/checkout occurrences, found %d\n' "$revert_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: uv >= constraint floor detection
# ---------------------------------------------------------------------------

printf '\n=== static: uv >= floor detection ===\n'

# py_constraint_op() must be defined — used to preserve >= vs == when updating
if grep -q '^py_constraint_op()' "$script"; then
  printf '[PASS] py_constraint_op: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_constraint_op: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# py_outdated must contain the stale-floor detection variable ge_floor
if grep -q 'ge_floor' "$script"; then
  printf '[PASS] py_outdated: contains ge_floor stale-floor detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: ge_floor stale-floor detection missing\n'
  fail=$(( fail + 1 ))
fi

# Stale-floor rows must merge even when uv-outdated already lists the package
# (bunnify #285: floor 0.16.0, lock 0.16.1, outdated 0.16.1→0.16.2 too new).
# shellcheck disable=SC2016  # assert literal source tokens
if grep -qF '${ge_pkg} ${ge_floor} ${ge_installed}' <<<"$py_outdated_snip" \
  && ! grep -qF 'Only add if not already present in raw_lines' <<<"$py_outdated_snip"; then
  printf '[PASS] py_outdated: stale-floor merges when uv-outdated already lists pkg\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: must merge stale-floor rows even if pkg is in raw_lines\n'
  fail=$(( fail + 1 ))
fi

if grep -qF '_py_outdated_collapse_lowest_cur_lines raw_line_arr' <<<"$py_outdated_snip" \
  && grep -qF '_py_outdated_dedupe_candidate_lines candidate_lines' <<<"$py_outdated_snip"; then
  printf '[PASS] py_outdated: collapses to lowest cur before pick; dedupes after\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: must collapse lowest-cur rows before PyPI pick\n'
  fail=$(( fail + 1 ))
fi

collapse_fn="$(awk '/^_py_outdated_collapse_lowest_cur_lines\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # assert literal source tokens
if grep -qF "tr '[:upper:]' '[:lower:]'" <<<"$collapse_fn" \
  && grep -qF "tr '_' '-'" <<<"$collapse_fn" \
  && grep -qF 'sort -V | head -1' <<<"$collapse_fn"; then
  printf '[PASS] py_outdated collapse: keeps lowest cur per PEP 508 name\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated collapse: must keep lowest cur (not drop floor rows)\n'
  fail=$(( fail + 1 ))
fi

dedupe_fn="$(awk '/^_py_outdated_dedupe_candidate_lines\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # assert literal source tokens
if grep -qF "tr '[:upper:]' '[:lower:]'" <<<"$dedupe_fn" \
  && grep -qF "tr '_' '-'" <<<"$dedupe_fn" \
  && grep -qF '| sort' <<<"$dedupe_fn"; then
  printf '[PASS] py_outdated dedupe: normalizes PEP 508 names and sorts output\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated dedupe: must normalize pkg keys and sort rows\n'
  fail=$(( fail + 1 ))
fi

# py_update_one must call py_constraint_op to preserve the original operator
if grep -q 'py_constraint_op' "$script"; then
  printf '[PASS] py_update_one: calls py_constraint_op to detect >= vs ==\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: py_constraint_op call missing\n'
  fail=$(( fail + 1 ))
fi

# batch_update_all must use staged pyproject.toml + uv.lock ground truth for
# actual_py_lines (never fall back to planned py_lines_arg for uv — that
# re-reported failed/skipped packages such as autobahn in my-tracks#1262).
# Non-uv tools may still use planned lines via report_py_lines when apply succeeded.
if grep -q 'diff --cached -- pyproject.toml' "$script" \
  && grep -qF 'py_uv_actual_lines_from_lock' "$script" \
  && grep -qF 'report_py_lines' "$script" \
  && grep -qF "actual_py_lines=''" "$script" \
  && ! grep -qE 'actual_py_lines:-\$\{py_lines_arg' "$script"; then
  printf '[PASS] batch_update_all: actual_py_lines from staged diff/lock; report_py_lines gates non-uv fallback\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch_update_all: must not fall back to py_lines_arg for uv PR/summary reporting\n'
  fail=$(( fail + 1 ))
fi

# Extras on constraint lines must strip so cryptography[ssh] reports as cryptography.
# shellcheck disable=SC2016  # assert literal awk regex spelling in source
if grep -qF 'gsub(/\[[^]]*\]/, "", line)' "$script" \
  && ! grep -qF 'gsub(/\\[[^]]*\\]/, "", line)' "$script"; then
  printf '[PASS] actual_py_lines awk: extras gsub matches TOML [extra] (single backslash)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] actual_py_lines awk: extras gsub must use /\\[[^]]*\\]/ (not doubled backslashes)\n'
  fail=$(( fail + 1 ))
fi
extras_awk_out="$(
  printf '%s\n' \
    '- "cryptography[ssh]>=42.0.0"' \
    '+ "cryptography[ssh]>=43.0.0"' \
    '__LISTED__' \
    'cryptography 42.0.0 43.0.0' | awk '
      /^__LISTED__$/ { in_listed = 1; next }
      in_listed {
        split($0, f, " ")
        if (f[1] == "") next
        p = tolower(f[1])
        fallback_old[p] = f[2]
        fallback_name[p] = f[1]
        next
      }
      /^---/ || /^[+][+][+]/ { next }
      {
        sign = substr($0, 1, 1)
        if (sign != "+" && sign != "-") next
        line = substr($0, 2)
        gsub(/^[[:space:]"]+/, "", line)
        gsub(/\[[^]]*\]/, "", line)
        op = ""
        i = index(line, ">=")
        if (i > 0) { op = ">="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) }
        if (op == "") next
        gsub(/[[:space:]]/, "", pkg)
        if (pkg !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) next
        gsub(/[",:[:space:]].*/, "", ver)
        if (pkg == "" || ver == "") next
        pk = tolower(pkg)
        if (sign == "-") { d_old[pk] = ver; d_old_name[pk] = pkg }
        else              { d_new[pk] = ver; d_new_name[pk] = pkg }
      }
      END {
        for (pk in d_new) {
          nv = d_new[pk]
          if (pk in d_old) {
            if (d_old[pk] == nv) continue
            ov = d_old[pk]
            nm = d_old_name[pk]
          } else if (pk in fallback_old) {
            ov = fallback_old[pk]
            nm = fallback_name[pk]
          } else { continue }
          print nm " " ov " " nv
        }
      }
    '
)"
if [[ "$extras_awk_out" == 'cryptography 42.0.0 43.0.0' ]]; then
  printf '[PASS] actual_py_lines awk: reports extras-constrained floor bumps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] actual_py_lines awk: extras bump expected cryptography row, got: %s\n' "$extras_awk_out"
  fail=$(( fail + 1 ))
fi

# Transitive uv bumps must use lock --upgrade-package (marker-aware), not uv add.
# Age-gate the target only (--exclude-newer-package); never global --exclude-newer
# (that breaks same-run CVE pins newer than the cutoff).
upgrade_fn="$(awk '/^py_uv_lock_upgrade_package\(\)/,/^}$/' "$script")"
exclude_fn="$(awk '/^py_uv_exclude_newer_cutoff_iso\(\)/,/^}$/' "$script")"
# shellcheck disable=SC2016 # assert literal --exclude-newer flag shapes in source
if grep -qF 'py_uv_lock_upgrade_package' "$script" \
  && grep -qF -- '--upgrade-package' <<<"$upgrade_fn" \
  && grep -qF -- '--exclude-newer-package' <<<"$upgrade_fn" \
  && ! grep -qF -- '--exclude-newer "$cutoff"' <<<"$upgrade_fn" \
  && grep -qF 'time_log_now_utc_epoch' <<<"$exclude_fn" \
  && grep -qF 'time_log_epoch_to_iso8601_utc' <<<"$exclude_fn" \
  && ! grep -qE 'date -u -d|date \+%s' <<<"$exclude_fn"; then
  printf '[PASS] uv transitive apply: upgrade-package + per-package exclude-newer via time_log\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv transitive apply: expected upgrade-package, --exclude-newer-package only, time_log cutoff\n'
  fail=$(( fail + 1 ))
fi

normalize_fn="$(awk '/^py_uv_normalize_lock\(\)/,/^}$/' "$script")"
strip_fn="$(awk '/^py_uv_strip_exclude_newer_from_lock\(\)/,/^}$/' "$script")"
lock_check_fn="$(awk '/^py_uv_lock_check\(\)/,/^}$/' "$script")"
# shellcheck disable=SC2016  # assert literal uv lock subcommand tokens in source
if grep -qF 'py_uv_normalize_lock' "$script" \
  && grep -qF 'py_uv_strip_exclude_newer_from_lock' "$script" \
  && grep -qF 'py_uv_lock_check' "$script" \
  && grep -qF 'lock --check' <<<"$lock_check_fn" \
  && grep -qF 'options.exclude-newer-package' <<<"$strip_fn" \
  && grep -qF 'py_uv_strip_exclude_newer_from_lock' <<<"$normalize_fn" \
  && ! grep -qF 'dep_runner_uv_dir_capture "$label" "$uv_dir" -- lock' <<<"$normalize_fn" \
  && ! grep -qF -- '--exclude-newer-package' <<<"$normalize_fn"; then
  printf '[PASS] uv lock normalize: strip options in-place + --check (no re-resolve lock)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv lock normalize: expected strip helper + py_uv_lock_check without plain lock\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # assert strip probe uses runner_exec argv (not runner_sh bash -c grep)
if grep -qF 'runner_exec "uv lock strip probe" --probe --' <<<"$strip_fn" \
  && grep -qF 'runner_exec_stdout "uv lock strip tempfile"' <<<"$strip_fn" \
  && grep -qF 'runner_sh "uv lock strip exclude-newer" --probe --' <<<"$strip_fn" \
  && grep -qF 'runner_sh "uv lock strip install" --probe --' <<<"$strip_fn" \
  && grep -qF 'cp -f' <<<"$strip_fn" \
  && ! grep -qE 'runner_sh "uv lock strip probe"' <<<"$strip_fn" \
  && ! grep -qF 'mv -f' <<<"$strip_fn"; then
  printf '[PASS] uv lock strip: probe via runner_exec argv; awk/cp probed; no mv mode clobber\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv lock strip: expected runner_exec probe + probed awk/cp (not runner_sh argv / mv)\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: strip exclude-newer-package from uv.lock ===\n'
strip_tmp="$(mktemp -d)"
cat >"${strip_tmp}/uv.lock" <<'EOF'
version = 1
revision = 2
requires-python = ">=3.12"

[[package]]
name = "demo"
version = "1.0.0"

[options]
exclude-newer = "2026-01-01T00:00:00Z"

[options.exclude-newer-package]
demo = "2026-01-01T00:00:00Z"
extra = "2026-01-02T00:00:00Z"
EOF
chmod 644 "${strip_tmp}/uv.lock"
# Fresh bash: harness keeps `script` readonly; runner_sh also declares `local script`.
strip_rc=0
bash -c '
  set -euo pipefail
  source "$1/../scripts/lib/runner-bootstrap"
  # shellcheck disable=SC1090
  source <(awk "/^py_uv_strip_exclude_newer_from_lock\\(\\)/,/^}$/" "$2")
  py_uv_strip_exclude_newer_from_lock "$3/uv.lock"
' bash "$script_dir" "$script" "$strip_tmp" || strip_rc=$?
strip_mode="$(stat -c '%a' "${strip_tmp}/uv.lock" 2>/dev/null || stat -f '%OLp' "${strip_tmp}/uv.lock")"
if (( strip_rc == 0 )) \
  && ! grep -qF '[options.exclude-newer-package]' "${strip_tmp}/uv.lock" \
  && grep -qF 'name = "demo"' "${strip_tmp}/uv.lock" \
  && grep -qF '[options]' "${strip_tmp}/uv.lock" \
  && grep -qF 'exclude-newer = "2026-01-01T00:00:00Z"' "${strip_tmp}/uv.lock" \
  && [[ "$strip_mode" == "644" ]]; then
  printf '[PASS] uv lock strip: removes exclude-newer-package section, keeps packages, preserves mode\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv lock strip: rc=%s mode=%s content:\n%s\n' \
    "$strip_rc" "$strip_mode" "$(cat "${strip_tmp}/uv.lock")"
  fail=$(( fail + 1 ))
fi
rm -rf "$strip_tmp"

if grep -qF 'py_uv_normalize_lock "uv lock normalize"' "$script" \
  && grep -qF 'py_uv_normalize_lock "uv batch lock normalize"' "$script" \
  && grep -qF 'py_uv_lock_check "uv batch lock --check"' "$script"; then
  printf '[PASS] uv lock normalize: single and batch paths normalize before git add\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv lock normalize: missing normalize/--check before staging uv.lock\n'
  fail=$(( fail + 1 ))
fi


# shellcheck disable=SC2016  # assert py_update_one normalize failures record ecosystem failure
floor_eco_block="$(awk '
  /uv_constraint_op.*>=.*==.*~=/ {grab=1}
  grab {print}
  grab && /files_changed="pyproject\.toml \+ uv\.lock"/ {exit}
' "$script")"
trans_eco_block="$(awk '
  /Transitive \/ unconstrained: prefer marker-aware/,/files_changed="uv\.lock"/
' "$script")"
if grep -qF 'dep_updater_append_ecosystem_failure "python|lock normalization failed"' <<<"$floor_eco_block" \
  && grep -qF 'dep_updater_append_ecosystem_failure "python|lock --check failed after normalize"' <<<"$floor_eco_block" \
  && grep -qF 'dep_updater_append_ecosystem_failure "python|lock normalization failed"' <<<"$trans_eco_block" \
  && grep -qF 'dep_updater_append_ecosystem_failure "python|lock --check failed after normalize"' <<<"$trans_eco_block"; then
  printf '[PASS] uv update-one normalize: records ecosystem failure on normalize/--check skip\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv update-one normalize: expected ecosystem failure on normalize/--check skip\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # assert direct-floor path snapshots before normalize
floor_norm_block="$(awk '
  /uv_constraint_op.*>=.*==.*~=/ {grab=1}
  grab {print}
  grab && /files_changed="pyproject\.toml \+ uv\.lock"/ {exit}
' "$script")"
if grep -qF 'uv_lock_bak' <<<"$floor_norm_block" \
  && grep -qF 'py_uv_restore_after_failed_floor_lock' <<<"$floor_norm_block" \
  && grep -qF 'lock normalization failed' <<<"$floor_norm_block" \
  && ! grep -qF 'checkout -- uv.lock' <<<"$floor_norm_block"; then
  printf '[PASS] uv floor normalize: snapshot restore on normalize/--check failure\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv floor normalize: expected uv_lock_bak + restore helper (no bare checkout)\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # assert security normalize restore + ecosystem failure
if grep -qF 'dep_updater_append_ecosystem_failure "python|security lock normalization failed"' "$script" \
  && grep -qF 'dep_updater_append_ecosystem_failure "python|security uv lock --check failed after normalize"' "$script" \
  && grep -qF 'sec_lock_bak' <<<"$(awk '/^py_security_update\(\)/,/^}$/' "$script")" \
  && grep -qF 'py_uv_restore_after_failed_floor_lock' \
    <<<"$(awk '/^py_security_update\(\)/,/^}$/' "$script")" \
  && ! grep -qF 'checkout -- pyproject.toml uv.lock' \
    <<<"$(awk '/^py_security_update\(\)/,/^}$/' "$script")"; then
  printf '[PASS] uv security normalize: snapshot restore + ecosystem failure (no combined checkout)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv security normalize: expected pre-add snapshot restore + ecosystem failure\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # assert batch PR body gates Python CVEs on any_py
if grep -qF 'py_audit_lines_arg" && "$any_py" == '\''1'\''' \
    <<<"$(awk '/^batch_update_all\(\)/,/^}$/' "$script")" \
  && grep -qF 'if [[ "$any_py" == '\''1'\'' ]]; then' \
    <<<"$(awk '/^batch_update_all\(\)/,/^}$/' "$script")"; then
  printf '[PASS] uv batch normalize: Python CVE report/summary gated on any_py\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv batch normalize: Python CVE reporting must require any_py=1\n'
  fail=$(( fail + 1 ))
fi

batch_norm_block="$(awk '/^batch_update_all\(\)/,/^}$/' "$script")"
# shellcheck disable=SC2016  # assert batch normalize failure resets to HEAD (literal $ in grep)
if grep -qF 'dep_updater_append_ecosystem_failure "python|batch lock normalization failed"' <<<"$batch_norm_block" \
  && grep -qF 'dep_updater_append_ecosystem_failure "python|batch uv lock --check failed after normalize"' <<<"$batch_norm_block" \
  && grep -qF 'py_uv_restore_after_failed_floor_lock "$worktree_path" "" ""' <<<"$batch_norm_block" \
  && ! grep -qF 'batch_norm_lock_bak' <<<"$batch_norm_block"; then
  printf '[PASS] uv batch normalize: failure resets python files to HEAD + records ecosystem failure\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv batch normalize: expected HEAD reset (empty bak) + ecosystem failure, no batch_norm bak\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # assert literal uv_lock_bak restore in transitive source
if awk '/Transitive \/ unconstrained: prefer marker-aware/,/files_changed="uv\.lock"/' "$script" | awk '
    { prev = line; line = $0 }
    /py_uv_normalize_lock "uv lock normalize"/ {
      if (prev ~ /rm -f "\$uv_lock_bak"/) exit 1
      found = 1
    }
    END { exit (found ? 0 : 1) }
  ' \
  && awk '/Transitive \/ unconstrained: prefer marker-aware/,/files_changed="uv\.lock"/' "$script" \
    | grep -qF 'lock normalization failed' \
  && awk '/Transitive \/ unconstrained: prefer marker-aware/,/files_changed="uv\.lock"/' "$script" \
    | grep -qF 'cp "$uv_lock_bak" "${worktree_path}/uv.lock"'; then
  printf '[PASS] uv transitive normalize: keeps uv_lock_bak until normalize/--check succeed\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv transitive normalize: uv_lock_bak must survive until after normalize/--check\n'
  fail=$(( fail + 1 ))
fi

# Missing HEAD uv.lock must not drop staged lock landings from reports.
printf '\n=== behavioural: lock report with missing HEAD uv.lock ===\n'
lock_report_tmp="$(mktemp -d)"
(
  cd "$lock_report_tmp"
  git init --quiet
  git config user.email 'test@example.com'
  git config user.name 'test'
  git commit --allow-empty --quiet -m 'init'
  cat >uv.lock <<'EOF'
version = 1

[[package]]
name = "autobahn"
version = "26.7.1"
EOF
  git add uv.lock
)
lock_report_out="$(
  # shellcheck disable=SC1090  # extracted helpers from script under test
  source <(
    awk '/^py_uv_lock_highest_version\(\)/,/^}$/' "$script"
    awk '/^py_uv_actual_lines_from_lock\(\)/,/^}$/' "$script"
  )
  py_uv_actual_lines_from_lock "$lock_report_tmp" $'autobahn 25.12.2 26.7.1'
)"
rm -rf "$lock_report_tmp"
if [[ "$lock_report_out" == 'autobahn 25.12.2 26.7.1' ]]; then
  printf '[PASS] lock report: missing HEAD uv.lock still reports staged landing\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] lock report: expected staged landing line, got: %s\n' "$lock_report_out"
  fail=$(( fail + 1 ))
fi

# Batch floor lock failure must snapshot/restore uv.lock — never git clean it away.
printf '\n=== behavioural: floor lock failure restores snapshotted uv.lock ===\n'
floor_restore_tmp="$(mktemp -d)"
(
  cd "$floor_restore_tmp"
  git init --quiet
  git config user.email 'test@example.com'
  git config user.name 'test'
  printf 'name = "demo"\nversion = "0.1.0"\n' >pyproject.toml
  printf 'ORIGINAL_LOCK\n' >uv.lock
  git add pyproject.toml
  git commit --quiet -m 'init'
)
floor_bak="$(mktemp)"
cp "${floor_restore_tmp}/uv.lock" "$floor_bak"
printf 'CORRUPTED_BY_FAILED_LOCK\n' >"${floor_restore_tmp}/uv.lock"
printf 'name = "demo"\nversion = "0.2.0"\n' >"${floor_restore_tmp}/pyproject.toml"
(
  # Stub run_command for the extracted helper (shellcheck cannot see indirect calls).
  # shellcheck disable=SC2317,SC2329
  run_command() { shift; "$@" || true; }
  # shellcheck disable=SC1090  # extracted helper from script under test
  source <(awk '/^py_uv_restore_after_failed_floor_lock\(\)/,/^}$/' "$script")
  py_uv_restore_after_failed_floor_lock "$floor_restore_tmp" "$floor_bak"
)
if [[ "$(cat "${floor_restore_tmp}/uv.lock")" == 'ORIGINAL_LOCK' ]] \
  && [[ "$(cat "${floor_restore_tmp}/pyproject.toml")" == $'name = "demo"\nversion = "0.1.0"' ]] \
  && [[ ! -f "$floor_bak" ]] \
  && grep -qF 'py_uv_restore_after_failed_floor_lock' "$script" \
  && ! grep -qE 'clean --force -- uv\.lock' "$script"; then
  printf '[PASS] uv-batch-floor: restore helper returns snapshotted uv.lock (no git clean)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-batch-floor: restore helper did not restore lock/pyproject or git clean remains\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$floor_restore_tmp"

printf '\n=== behavioural: floor lock failure keeps security pyproject snapshot ===\n'
floor_sec_tmp="$(mktemp -d)"
(
  cd "$floor_sec_tmp"
  git init --quiet
  git config user.email 'test@example.com'
  git config user.name 'test'
  printf 'name = "demo"\nversion = "0.1.0"\n' >pyproject.toml
  printf 'ORIGINAL_LOCK\n' >uv.lock
  git add pyproject.toml uv.lock
  git commit --quiet -m 'init'
)
floor_sec_lock_bak="$(mktemp)"
floor_sec_proj_bak="$(mktemp)"
cp "${floor_sec_tmp}/uv.lock" "$floor_sec_lock_bak"
printf 'name = "demo"\nversion = "0.1.0"\nidna==3.10\n' >"${floor_sec_tmp}/pyproject.toml"
cp "${floor_sec_tmp}/pyproject.toml" "$floor_sec_proj_bak"
printf 'name = "demo"\nversion = "0.2.0"\nidna==3.10\n' >"${floor_sec_tmp}/pyproject.toml"
printf 'CORRUPTED_BY_FAILED_LOCK\n' >"${floor_sec_tmp}/uv.lock"
(
  # shellcheck disable=SC2317,SC2329
  run_command() { shift; "$@" || true; }
  # shellcheck disable=SC1090  # extracted helper from script under test
  source <(awk '/^py_uv_restore_after_failed_floor_lock\(\)/,/^}$/' "$script")
  py_uv_restore_after_failed_floor_lock "$floor_sec_tmp" "$floor_sec_lock_bak" "$floor_sec_proj_bak"
)
# shellcheck disable=SC2016  # assert literal 3-arg restore call in source
if [[ "$(cat "${floor_sec_tmp}/uv.lock")" == 'ORIGINAL_LOCK' ]] \
  && grep -qF 'idna==3.10' "${floor_sec_tmp}/pyproject.toml" \
  && ! grep -qF '0.2.0' "${floor_sec_tmp}/pyproject.toml" \
  && grep -cF 'py_uv_restore_after_failed_floor_lock "$worktree_path" "$lock_bak" "$pyproject_bak"' \
    "$script" | grep -qx '2'; then
  printf '[PASS] uv-batch-floor: restore from pyproject_bak keeps security constraint\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-batch-floor: failed lock must restore pyproject_bak, not HEAD\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$floor_sec_tmp"
rm -f "$floor_sec_proj_bak"


# batch path must call py_uv_lock_upgrade_package (not only py_update_one) and must
# not uv add unconstrained packages (forces universal pins).
batch_update_fn="$(awk '/^batch_update_all\(\)/,/^}$/' "$script")"
if grep -qF 'py_uv_lock_upgrade_package' <<<"$batch_update_fn" \
  && ! grep -qE 'uv batch add|uv_add_specs' <<<"$batch_update_fn"; then
  printf '[PASS] uv-batch-apply: batch_update_all uses upgrade-package (not uv add)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] uv-batch-apply: batch_update_all must call py_uv_lock_upgrade_package and not uv add\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: worktree naming and leak guards
# ---------------------------------------------------------------------------

printf '\n=== static: worktree naming and leak guards ===\n'

# Worktree directory name must use dep-updater-wt- prefix and include repo slug
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${timestamp} in source
if grep -q 'dep-updater-wt-\${timestamp}-\${repo_slug}' "$script" \
  && grep -q '^dep_updater_worktree_repo_slug()' "$script"; then
  printf '[PASS] create_worktree: uses dep-updater-wt- prefix with repo slug\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] create_worktree: dep-updater-wt- prefix with repo slug not found\n'
  fail=$(( fail + 1 ))
fi

# Old repo-name-dep-update- pattern must be gone
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${repo_name} in source
if grep -q '\${repo_name}-dep-update-' "$script"; then
  printf '[FAIL] create_worktree: old repo_name-dep-update- pattern still present\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] create_worktree: old repo_name-dep-update- pattern removed\n'
  pass=$(( pass + 1 ))
fi

# _cleanup_trap_active must be set to 1 immediately after create_worktree in dry-run
# (guards the worktree against leaks when a command in the dry-run block fails)
dry_run_block="$(awk '/^if \[\[ "\$dry_run" == .1. \]\]; then/,/^fi$/' "$script")"
if grep -q '_cleanup_trap_active=1' <<<"$dry_run_block"; then
  printf '[PASS] dry-run block: _cleanup_trap_active=1 set after create_worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dry-run block: _cleanup_trap_active=1 missing — dry-run worktrees will leak on error\n'
  fail=$(( fail + 1 ))
fi

# _dry_run_teardown must reset _cleanup_trap_active=0 before removing the worktree
# (prevents the EXIT trap from double-invoking cleanup_on_error)
teardown_block="$(awk '/^_dry_run_teardown\(\) \{/,/^}/' "$script")"
if grep -q '_cleanup_trap_active=0' <<<"$teardown_block"; then
  printf '[PASS] _dry_run_teardown: resets _cleanup_trap_active=0 before removal\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] _dry_run_teardown: missing _cleanup_trap_active=0 reset\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: state file scratch location
# ---------------------------------------------------------------------------

printf '\n=== static: state file scratch location ===\n'

# State file must live in the scratch/tmp dir, not in ${dir}
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${dir}/ in source
if grep -q 'state_file="${dir}/' "$script"; then
  printf '[FAIL] init_state_file: state_file still set to ${dir}/... (must use scratch dir)\n'
  fail=$(( fail + 1 ))
else
  # shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${dir}/ in source
  printf '[PASS] init_state_file: state_file does not use ${dir}/ prefix\n'
  pass=$(( pass + 1 ))
fi

# State file must use the new .dep-updater-state name (not .dep-update-state)
if grep -q '\.dep-update-state' "$script"; then
  printf '[FAIL] state file: old .dep-update-state name still present\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] state file: old .dep-update-state name removed\n'
  pass=$(( pass + 1 ))
fi

if grep -q '\.dep-updater-state' "$script"; then
  printf '[PASS] state file: new .dep-updater-state name present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] state file: new .dep-updater-state name not found\n'
  fail=$(( fail + 1 ))
fi

# State file path must include a repo-unique hash derived from $dir
# shellcheck disable=SC2016  # single-quoted pattern is intentional: grep for literal ${repo_hash} in source
if grep -q 'dep-updater-state-\${repo_hash}' "$script"; then
  # shellcheck disable=SC2016  # single-quoted pattern is intentional
  printf '[PASS] init_state_file: path includes ${repo_hash} for per-repo uniqueness\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] init_state_file: per-repo hash suffix not found\n'
  fail=$(( fail + 1 ))
fi

# ensure_gitignore must no longer exist (state file is not in the repo)
if grep -q 'ensure_gitignore' "$script"; then
  printf '[FAIL] ensure_gitignore: function or call still present (state file moved out of repo)\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] ensure_gitignore: removed (state file no longer lives in the repo)\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: no hardcoded /tmp/ PR body-file paths (file leakage)
# ---------------------------------------------------------------------------

printf '\n=== static: no hardcoded /tmp/ PR body-file paths ===\n'

# All PR body files must use mktemp (caller-provided path) so they are uniquely
# named, not shared across concurrent runs, and deleted after use.
# A hardcoded /tmp/dep-updater-pr-* path leaks into /tmp on every run and can
# expose PR body content to other local users.  The older /tmp/dep-update-pr-*
# (typo, missing trailing 'r') is also forbidden.
if grep -qE '"/tmp/dep-updat(e|er)-pr-' "$script"; then
  printf '[FAIL] body-file-leakage: hardcoded /tmp/dep-updat(e|er)-pr-* path found\n'
  grep -nE '"/tmp/dep-updat(e|er)-pr-' "$script" | while IFS= read -r match; do
    printf '       %s\n' "$match"
  done
  fail=$(( fail + 1 ))
else
  printf '[PASS] body-file-leakage: no hardcoded /tmp/dep-updat*-pr-* paths\n'
  pass=$(( pass + 1 ))
fi

# write_npm_pr_body and write_pr_body must accept a body_file parameter
# (5th and 7th arg respectively) rather than deriving the path internally.
if awk '/^write_npm_pr_body\(\)/{found=1} found && /body_file="\$5"/{ok=1} found && /^}$/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] write_npm_pr_body: accepts body_file as 5th argument\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] write_npm_pr_body: 5th-arg body_file not found — function still hardcodes path\n'
  fail=$(( fail + 1 ))
fi

if awk '/^write_pr_body\(\)/{found=1} found && /body_file="\$7"/{ok=1} found && /^}$/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] write_pr_body: accepts body_file as 7th argument\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] write_pr_body: 7th-arg body_file not found — function still hardcodes path\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: batch PR body includes summary table ===\n'
if grep -qF '## Dependency update summary' "$script" \
  && grep -qF '| Ecosystem | Package | From | To | CVE? | CVEs |' "$script"; then
  printf '[PASS] batch PR body: includes combined dependency update summary table\n'
