cat >"${api_fail_home}/.local/bin/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == 'stack --help' ]]; then
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf 'gh: Not Found\n' >&2
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${api_fail_home}/.local/bin/gh"

api_fail_out=""
api_fail_exit=0
set +e
api_fail_out="$(
  cd "$api_fail_tmp" \
    && HOME="$api_fail_home" PATH="${api_fail_home}/.local/bin:${PATH}" \
      "$script" --batch --all --dry-run --scan-root "${api_fail_tmp}/roots" 2>&1
)"
api_fail_exit=$?
set -e
rm -rf "$api_fail_tmp"

if [[ "$api_fail_exit" -ne 0 ]] \
  && grep -qF 'Failed to list org repositories' <<<"$api_fail_out" \
  && ! grep -qF '[batch-all] --- only-repo' <<<"$api_fail_out"; then
  printf '[PASS] batch --all org API failure: exit non-zero without processing clones\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch --all org API failure: exit=%s output:\n%s\n' "$api_fail_exit" "$api_fail_out"
  fail=$(( fail + 1 ))
fi

