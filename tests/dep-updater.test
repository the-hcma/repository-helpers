  fail=$(( fail + 1 ))
fi

gh_merge_body="$(awk '/^merge_pr_via_gh_single\(\)/,/^\}/' "$script")"
# Extract the pr-merge argv only (ignore comments that mention delete-branch).
gh_merge_argv="$(printf '%s\n' "$gh_merge_body" | awk '
  /dep_runner_gh_stdout "gh pr" -- pr merge/ {grab=1}
  grab {print}
  grab && /\)" \|\| merge_exit/ {exit}
')"
if grep -qF 'dep_runner_gh_stdout "gh pr" -- pr merge' "$script" \
  && grep -qF -- '--auto' <<<"$gh_merge_argv" \
  && grep -qF -- '--squash' <<<"$gh_merge_argv" \
  && ! grep -qF -- '--delete-branch' <<<"$gh_merge_argv" \
  && grep -qE 'pr merge' <<<"$gh_merge_body"; then
  printf '[PASS] merge-via: gh path uses auto squash merge without --delete-branch\n'
