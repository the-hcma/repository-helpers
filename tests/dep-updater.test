poll_merged_body="$(awk '/^poll_until_merged\(\)/,/^}/' "$script")"
if grep -qF 'ci_conclusion_for_pr' <<<"$poll_merged_body" \
  && ! grep -qF 'ci_conclusion_for_head' <<<"$poll_merged_body"; then
