# ---------------------------------------------------------------------------
# Test: pnpm latest-mode detects range updates (lockfile behind)
# ---------------------------------------------------------------------------

printf '\n=== report-json: pnpm detects range updates ===\n'
tmp_home="$(mktemp -d)"
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" checkout -b main >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

cat >"${tmp_repo}/package.json" <<'EOF'
{
  "name": "x",
  "private": true,
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "vite": "^8.0.10"
  }
}
EOF
touch "${tmp_repo}/pnpm-lock.yaml"
git -C "$tmp_repo" add package.json pnpm-lock.yaml >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit -q -m "add pnpm project"

tmp_bin="${tmp_home}/bin"
mkdir -p "$tmp_bin"

cat >"${tmp_bin}/pnpm" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

dir=""
if [[ "${1:-}" == "--dir" ]]; then
  dir="${2:-}"
  shift 2
fi

cmd="${1:-}"
shift || true

case "$cmd" in
  install)
    # Ensure node_modules exists so dep-updater doesn't re-install.
    if [[ -n "$dir" ]]; then
      mkdir -p "${dir}/node_modules"
    else
      mkdir -p "./node_modules"
    fi
    # Simulate ERR_PNPM_IGNORED_BUILDS: pnpm returns non-zero but leaves enough
    # state for other updates to proceed.
    echo "[ERR_PNPM_IGNORED_BUILDS] Ignored build scripts: esbuild@0.27.7, esbuild@0.28.0" >&2
    echo "Run \"pnpm approve-builds\" to pick which dependencies should be allowed to run scripts." >&2
    exit 1
    ;;
  outdated)
    # Simulate the pnpm behaviour that misses range updates when lockfile is behind.
    printf '%s\n' '{}'
    exit 0
    ;;
  list)
    # --depth 0 --json
    cat <<'JSON'
[
  {
    "name": "x",
    "path": ".",
    "dependencies": {
      "react": {"version": "19.2.5"},
      "react-dom": {"version": "19.2.5"}
    },
    "devDependencies": {
      "vite": {"version": "8.0.10"}
    }
  }
]
JSON
    exit 0
    ;;
  view)
    # pnpm view <pkg>[@<version>] version
    # npm_version_prefetch calls: pnpm view pkg@ver version
    pkg="${1:-}"
    field="${2:-}"
    if [[ "$field" != "version" ]]; then
      exit 2
    fi
    # Strip @version suffix so cases match both "react" and "react@19.2.6"
    pkg_name="${pkg%%@*}"
    case "$pkg_name" in
      react) echo "19.2.6"; exit 0 ;;
      react-dom) echo "19.2.6"; exit 0 ;;
      vite) echo "8.0.11"; exit 0 ;;
    esac
    exit 2
    ;;
  store)
    # store add <pkg>@<ver> — simulate a successful tarball fetch
    exit 0
    ;;
  --version|-v|version)
    echo "11.0.8"
    exit 0
    ;;
esac

echo "pnpm stub: unsupported args: $cmd $*" >&2
exit 2
EOF
chmod +x "${tmp_bin}/pnpm"

report_output=""
report_exit=0
set +e
report_output="$(env HOME="$tmp_home" PATH="$(dep_test_path_no_gh_gt "$tmp_bin")" \
  DEP_UPDATER_SKIP_NPM_REGISTRY=1 \
  "$script" --report-json --dir "$tmp_repo" 2>/dev/null)"
report_exit=$?
set -e

rm -rf "$tmp_home" "$tmp_repo"

assert_exit_0 "report-json (pnpm range updates)" "$report_output" "$report_exit"
if printf '%s' "$report_output" | jq -e '
  .updates
  | map(select(.ecosystem == "npm"))
  | map({package, from, to})
  | (any(.package=="react" and .from=="19.2.5" and .to=="19.2.6"))
    and (any(.package=="react-dom" and .from=="19.2.5" and .to=="19.2.6"))
    and (any(.package=="vite" and .from=="8.0.10" and .to=="8.0.11"))
' >/dev/null 2>&1; then
  printf '[PASS] report-json (pnpm range updates): detects react/react-dom/vite bumps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report-json (pnpm range updates): expected bumps missing\n'
  printf '       output:\n%s\n' "$report_output"
  fail=$(( fail + 1 ))
fi

