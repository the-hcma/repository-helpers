    pass=$(( pass + 1 ))
  else
    printf '[FAIL] pip-audit JSON shape: .dependencies[] classifier must detect CVE rows\n'
    fail=$(( fail + 1 ))
  fi
  if jq -e '[.[]? | select((.vulns // []) | length > 0)] | length > 0' \
      <<<"$pip_audit_object_json" >/dev/null 2>&1; then
    printf '[FAIL] pip-audit JSON shape: top-level array pattern must not match object output\n'
    fail=$(( fail + 1 ))
  else
