printf '\n=== static: dry-run must not checkout main on primary restore ===\n'
restore_body="$(awk '/^primary_repo_restore\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016
if printf '%s' "$restore_body" | grep -qF '"$dry_run" != '\''1'\''' \
