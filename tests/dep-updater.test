  fail=$(( fail + 1 ))
fi

# cleanup_on_error must leave PRs open (with a comment) on merge/auto-merge failures.
# shellcheck disable=SC2016
cleanup_body="$(awk '/^cleanup_on_error\(\)/,/^}/' "$script")"
if grep -qF 'leave_prs_open' <<<"$cleanup_body" \
  && grep -qF 'enablePullRequestAutoMerge' <<<"$cleanup_body" \
  && grep -qF 'pr comment' <<<"$cleanup_body" \
  && grep -qF -- '--comment' <<<"$cleanup_body"; then
