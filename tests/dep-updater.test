printf '\n=== static: update mode scans from origin/main worktree only ===\n'

update_mode_block="$(awk '/^# Update mode$/{flag=1} flag{print} /^main "\$@"/{if (flag) exit}' "$script")"
update_scan_uses_primary=0
# Needles are literal source text containing $dir / $py_tool (not expansions).
