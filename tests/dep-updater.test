printf '\n=== static: report-json path uses runner jq helpers ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'dep_runner_jq_with_args()' "$script" \
  && grep -qF 'dep_runner_jq_file_args()' "$script" \
  && grep -qF 'dep_runner_jq_n()' "$script" \
  && grep -qF 'dep_runner_git_c_stdout()' "$script" \
  && grep -qF 'dep_runner_gh_stdout()' "$script" \
  && grep -qF '_emit_report_json()' "$script" \
  && grep -qF 'dep_runner_jq_n "dep-updater report-json emit"' "$script" \
  && grep -qF 'dep_runner_jq_with_args "dep-updater py audit validate"' "$script" \
  && grep -qF 'dep_runner_jq_with_args "dep-updater uv outdated rows"' "$script"; then
  printf '[PASS] report-json: _emit_report_json and audit/outdated jq use dep_runner helpers\n'
  pass=$(( pass + 1 ))
