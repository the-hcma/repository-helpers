  fail=$(( fail + 1 ))
fi

gate_body="$(awk '/^gate_all_created_prs\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # grep for literal $pr_num in script under test
if printf '%s' "$gate_body" | grep -qF 'gh_pr_number_resolve_for_gate' \
  && printf '%s' "$gate_body" | grep -qF 'gate_open_pr_for_ci' \
  && printf '%s' "$gate_body" | grep -qF 'CI wait was skipped for tracked PR' \
  && ! printf '%s' "$gate_body" | grep -qF '[[ -z "$pr_num" ]] && continue'; then
  printf '[PASS] ci-gate: gate_all_created_prs resolves PRs and fails on skipped waits\n'
  pass=$(( pass + 1 ))
