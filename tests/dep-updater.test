  pass=$(( pass + 1 ))
else
  printf '[FAIL] cleanup_on_error: must leave PRs open on merge failures and comment on close (#430)\n'
  fail=$(( fail + 1 ))
fi

# maybe_label must gate on PR rollup success (not skipped/neutral from gh run list).
# shellcheck disable=SC2016
maybe_label_body="$(awk '/^maybe_label_top_pr_for_merge\(\)/,/^}/' "$script")"
if grep -qF 'ci_conclusion_for_pr' <<<"$maybe_label_body" \
  && ! grep -qE 'success\|skipped\|neutral' <<<"$maybe_label_body"; then
  printf '[PASS] maybe_label: merge-ready gate uses ci_conclusion_for_pr success only\n'
