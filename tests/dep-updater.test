  "$script" --report-json --dir "$tmp_repo" 2>"$report_err_file")"
report_exit=$?
set -e
report_err="$(cat "$report_err_file" 2>/dev/null || true)"
rm -f "$report_err_file"

rm -rf "$tmp_home" "$tmp_repo"

assert_exit_0 "report-json (fnm pnpm discovery)" "${report_output}${report_err:+$'\n'}${report_err}" "$report_exit"
if printf '%s' "$report_output" | jq -e . >/dev/null 2>&1; then
  printf '[PASS] report-json (fnm pnpm discovery): output is valid JSON\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report-json (fnm pnpm discovery): output is not valid JSON\n'
  printf '       output:\n%s\n' "$report_output"
  fail=$(( fail + 1 ))
fi

