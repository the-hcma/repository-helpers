  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016
enqueue_body="$(awk '/^dep_enqueue_pr_for_merge_queue\(\)/,/^\}/' "$script")"
if grep -qF -- '--auto --squash' <<<"$enqueue_body" \
  && ! grep -qF 'labels[]=merge-it' <<<"$enqueue_body"; then
