fi

printf '\n=== dry-run restores stashed primary-clone changes ===\n'
dry_run_make_isolated_repo
stash_probe_repo="$DRY_RUN_ISOLATED_REPO"
printf 'probe-local-change\n' >"${stash_probe_repo}/local-probe.txt"
pre_stash_content="$(cat "${stash_probe_repo}/local-probe.txt")"
stash_probe_out=""
stash_probe_exit=0
set +e
"$script" --dry-run --dir "$stash_probe_repo" >"${stash_probe_repo}.out" 2>&1
stash_probe_exit=$?
set -e
stash_probe_out="$(cat "${stash_probe_repo}.out")"
rm -f "${stash_probe_repo}.out"
post_stash_content="$(cat "${stash_probe_repo}/local-probe.txt" 2>/dev/null || true)"
post_stash_list="$(git -C "$stash_probe_repo" stash list 2>/dev/null || true)"
dry_run_cleanup_isolated_repo

if (( stash_probe_exit == 0 )) \
  && grep -qF 'Stashing primary-clone local changes' <<<"$stash_probe_out" \
  && grep -qF 'Restoring stashed primary-clone local changes' <<<"$stash_probe_out" \
  && [[ "$pre_stash_content" == "$post_stash_content" ]] \
  && ! grep -qF 'dep-updater: preserved local changes' <<<"$post_stash_list"; then
  printf '[PASS] dry-run: stashes and restores dirty primary-clone working tree\n'
  pass=$(( pass + 1 ))
else
