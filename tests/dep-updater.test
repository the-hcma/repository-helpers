printf '\n=== static: CI gate uses shared rollup conclusion ===\n'
ci_gate_body="$(awk '/^ci_conclusion_for_pr\(\)/,/^\}/' "$script")"
rollup_lib="${script_dir}/../scripts/lib/ci-check-rollup"
if printf '%s' "$ci_gate_body" | grep -qF 'ci_rollup_json_for_pr' \
  && printf '%s' "$ci_gate_body" | grep -qF 'ci_rollup_conclusion_for_gating' \
  && grep -qF 'detect_ci_required_contexts' "$script" \
  && grep -qF 'ci_discover_required_contexts_from_ci_yml_text' "$rollup_lib"; then
  printf '[PASS] ci-gate: wait and merge share ci_rollup_conclusion_for_gating\n'
