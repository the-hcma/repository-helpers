# ---------------------------------------------------------------------------
# Static: Rust / Cargo ecosystem
# ---------------------------------------------------------------------------

printf '\n=== static: rust/cargo ecosystem ===\n'

if grep -q '^has_rust=0' "$script"; then
  printf '[PASS] has_rust: global variable declared with default 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] has_rust: global variable not declared\n'
  fail=$(( fail + 1 ))
fi

for rust_fn in rust_outdated rust_update_one rust_is_pinned rust_workspace_enabled \
  rust_recover_post_bump_clippy rust_revert_post_bump_workdir _rust_log_output_tail \
  rust_clippy_failure_is_host_incompatible; do
  if grep -q "^${rust_fn}()" "$script"; then
    printf '[PASS] %s: function is defined\n' "$rust_fn"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: function is missing from script\n' "$rust_fn"
    fail=$(( fail + 1 ))
  fi
done

# Post-bump clippy recovery (issue #433 / rusty-jack dialoguer 0.12): mechanical
# --fix then re-check; unrecovered failures log RUST_CLIPPY_RECOVER_FAILED and
# revert (do not die / abort other ecosystems or later crates). Host-incompatible
# build failures (e.g. coreaudio-sys on Linux) skip clippy and allow the bump.
rust_recover_call_needle="rust_recover_post_bump_clippy \"\$worktree_path\""
rust_revert_call_needle="rust_revert_post_bump_workdir \"\$worktree_path\""
# shellcheck disable=SC2016  # grep -qF needles are literal source tokens, not shell expansions
rust_recover_call_count="$(grep -cF "$rust_recover_call_needle" "$script" || true)"
rust_revert_call_count="$(grep -cF "$rust_revert_call_needle" "$script" || true)"
rust_revert_fn="$(awk '/^rust_revert_post_bump_workdir\(\)/,/^}/' "$script")"
rust_recover_fn="$(awk '/^rust_recover_post_bump_clippy\(\)/,/^}/' "$script")"
if grep -qF 'clippy --all-targets' "$script" \
  && grep -qF 'clippy --fix' "$script" \
  && grep -qF 'ERROR: RUST_CLIPPY_RECOVER_FAILED' "$script" \
  && grep -qF 'rust_clippy_failure_is_host_incompatible' <<<"$rust_recover_fn" \
  && grep -qF 'requires macos or ios' "$script" \
  && ! grep -qE 'linker \.\* not found' "$script" \
  && (( rust_recover_call_count >= 2 )) \
  && (( rust_revert_call_count >= 2 )) \
  && grep -qF '*/Cargo.toml' <<<"$rust_revert_fn" \
  && ! grep -qE 'die[[:space:]]+"RUST_CLIPPY_RECOVER_FAILED' "$script" \
  && ! awk '/^rust_recover_post_bump_clippy\(\)/,/^}/' "$script" | grep -qE '(^|[|[:space:]])tail[[:space:]]'; then
  printf '[PASS] rust clippy recover: --fix hook reverts on failure; host-incompatible skip; wired into update_one and batch\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust clippy recover: missing --fix/revert/host-skip wiring (issue #433)\n'
  fail=$(( fail + 1 ))
fi

# Behavior: host-incompatible predicate accepts platform errors, rejects host gaps.
host_incompat_fn="$(awk '
  /^rust_clippy_failure_is_host_incompatible\(\)/ {p=1}
  p {print}
  p && /^}/ {exit}
' "$script")"
host_incompat_rc_platform=0
host_incompat_rc_toolchain=0
# shellcheck disable=SC2016  # literal clippy output with backticks, not shell expansion
host_incompat_toolchain_sample='error: linking with `cc` failed: linker `cc` not found'
bash -c "$host_incompat_fn"'
  rust_clippy_failure_is_host_incompatible "error: coreaudio-sys requires macos or ios"
' || host_incompat_rc_platform=$?
HOST_INCOMPAT_SAMPLE="$host_incompat_toolchain_sample" bash -c "$host_incompat_fn"'
  rust_clippy_failure_is_host_incompatible "$HOST_INCOMPAT_SAMPLE"
' || host_incompat_rc_toolchain=$?
if (( host_incompat_rc_platform == 0 )) && (( host_incompat_rc_toolchain != 0 )); then
  printf '[PASS] rust clippy host-incompat: matches platform errors, rejects host toolchain gaps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust clippy host-incompat: platform=%s toolchain=%s\n' \
    "$host_incompat_rc_platform" "$host_incompat_rc_toolchain"
  fail=$(( fail + 1 ))
fi

if grep -A8 "ecosystem.*'rust'.*auto" "$script" | grep -q 'has_rust=1'; then
  printf '[PASS] detect_ecosystem: sets has_rust=1 for rust/auto ecosystem\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] detect_ecosystem: has_rust=1 not set for rust/auto ecosystem\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # single-quoted: searching for literal $() in source
if grep -q 'cargo outdated --format json' "$script" \
  || grep -qF 'cargo outdated "${outdated_args' "$script" \
  || grep -qF 'dep_runner_cargo_dir_stdout "cargo outdated"' "$script"; then
  printf '[PASS] rust_outdated: uses cargo outdated JSON output\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_outdated: cargo outdated JSON invocation not found\n'
  fail=$(( fail + 1 ))
fi

if awk '/^rust_outdated\(\)/{found=1} found && /--root-deps-only/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] rust_outdated: limits scan to direct/root dependencies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_outdated: --root-deps-only not found\n'
  fail=$(( fail + 1 ))
fi

# cargo-outdated uses "---" (not null) when no in-range upgrade exists. jq's //
# does not treat "---" as missing, so rust_outdated must explicitly fall through
# to .latest (rusty-jack tungstenite 0.29→0.30).
# Capture before grep -q to avoid pipefail SIGPIPE false failures (see above).
rust_outdated_snip="$(awk '/^rust_outdated\(\)/,/^\}/' "$script")"
# shellcheck disable=SC2016  # assert literal jq fragments in source
if grep -qF '$d.compat != "---"' <<<"$rust_outdated_snip" \
  && grep -qF 'else $d.latest' <<<"$rust_outdated_snip"; then
  printf '[PASS] rust_outdated: falls through to latest when compat is ---\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_outdated: must use latest when compat sentinel is ---\n'
  fail=$(( fail + 1 ))
fi

if ! command -v jq >/dev/null 2>&1; then
  printf '[SKIP] jq not on PATH — skipping rust_outdated jq fallback test\n'
else
  # Mirror the rust_outdated jq filter against a tungstenite-shaped payload,
  # including a platform-specific dep (spaces in cfg must stay one TSV field).
  rust_jq_out="$(printf '%s' '{
    "crate_name": "rusty-jack",
    "dependencies": [
      {
        "name": "tungstenite",
        "project": "0.29.0",
        "compat": "---",
        "latest": "0.30.0",
        "kind": "Normal"
      },
      {
        "name": "clap",
        "project": "4.6.3",
        "compat": "4.6.4",
        "latest": "4.7.0",
        "kind": "Normal"
      },
      {
        "name": "system-configuration",
        "project": "0.7.0",
        "compat": "---",
        "latest": "0.8.0",
        "kind": "Normal",
        "platform": "cfg(target_os = \"macos\")"
      },
      {
        "name": "already-latest",
        "project": "1.0.0",
        "compat": "---",
        "latest": "1.0.0",
        "kind": "Normal"
      }
    ]
  }' | jq -r '
    (if type == "array" then .[] else . end)
    | .crate_name as $crate
    | .dependencies[]?
    | select(.name != null and .project != null)
    | select(.latest != null and .latest != "---")
    | . as $d
    | (if ($d.compat != null and $d.compat != "---")
       then $d.compat
       else $d.latest
       end) as $target
    | select($target != "---" and $d.project != $target)
    | [
        ($d.name | split(" -> ") | last),
        $d.project,
        $target,
        ($d.kind // "Normal"),
        ($crate // "-"),
        (if ($d.platform == null or $d.platform == "") then "-" else $d.platform end)
      ]
    | join("\t")
  ')"
  if grep -qxF $'tungstenite\t0.29.0\t0.30.0\tNormal\trusty-jack\t-' <<<"$rust_jq_out" \
    && grep -qxF $'clap\t4.6.3\t4.6.4\tNormal\trusty-jack\t-' <<<"$rust_jq_out" \
    && grep -qxF $'system-configuration\t0.7.0\t0.8.0\tNormal\trusty-jack\tcfg(target_os = "macos")' <<<"$rust_jq_out" \
    && ! grep -qF 'already-latest' <<<"$rust_jq_out"; then
    printf '[PASS] rust_outdated jq: TSV rows; platform cfg preserved; latest when compat is ---\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] rust_outdated jq: unexpected rows\n'
    printf '       got:\n%s\n' "$rust_jq_out"
    fail=$(( fail + 1 ))
  fi
fi

if awk '/^rust_is_pinned\(\)/{found=1} found && /dep_table/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] rust_is_pinned: checks exact pins per dependency table\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_is_pinned: dependency-table exact pin guard not found\n'
  fail=$(( fail + 1 ))
fi

if awk '/^rust_update_one\(\)/{found=1} found && /dep-updates\/rust-/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] rust_update_one: uses dep-updates/rust- branch prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_update_one: dep-updates/rust- branch prefix not found\n'
  fail=$(( fail + 1 ))
fi

if awk '
  /^rust_update_one\(\)/ { found = 1 }
  found && /--dev/ { has_dev = 1 }
  found && /--build/ { has_build = 1 }
  found && /^}/ { found = 0 }
  END { exit !(has_dev && has_build) }
' "$script"; then
  printf '[PASS] rust_update_one: preserves dev/build dependency kind\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_update_one: dev/build cargo add flags not found\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # single-quoted: searching for literal $var in source
if grep -qF -- '--package "$dep_package"' "$script"; then
  printf '[PASS] rust_update_one: targets workspace package with --package\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust_update_one: workspace --package targeting not found\n'
  fail=$(( fail + 1 ))
fi

# Platform-specific crates (e.g. [target.'cfg(target_os = "macos")'.dependencies])
# must pass cargo add --target so the existing pin is updated in place.
# shellcheck disable=SC2016  # single-quoted: searching for literal $var in source
if awk '
  /^rust_update_one\(\)/ { found = 1 }
  found && /--target "\$dep_platform"/ { has_target = 1 }
  found && /^}/ { found = 0 }
  END { exit !has_target }
' "$script" \
  && grep -qF 'cargo_add_args=(--target "$dep_platform"' "$script" \
  && grep -qF 'join("\t")' "$script" \
  && grep -qF 'dep_platform' "$script"; then
  printf '[PASS] rust: cargo add --target for platform-specific deps (TSV platform field)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rust: missing --target / platform TSV wiring for cargo add\n'
  fail=$(( fail + 1 ))
fi

# Dry-run must shell-quote platform cfg strings (spaces/parens) for paste-safe cmds.
# shellcheck disable=SC2016  # single-quoted: searching for literal printf %q in source
if grep -qF "printf '%q' \"\$dep_platform\"" "$script"; then
  # Reconstruct the dry-run suffix the same way dep-updater does and require it
  # to parse as two argv tokens under bash (--target + cfg string).
  dry_suffix="--target $(printf '%q' 'cfg(target_os = "macos")')"
  # shellcheck disable=SC2086  # intentional: verify %q output is one word for eval
  eval "set -- $dry_suffix"
  if [[ "$#" -eq 2 && "$1" == '--target' && "$2" == 'cfg(target_os = "macos")' ]]; then
    printf '[PASS] rust dry-run: --target platform is shell-quoted (printf %%q)\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] rust dry-run: platform quoting does not round-trip through bash\n'
    fail=$(( fail + 1 ))
  fi
else
  printf '[FAIL] rust dry-run: missing printf %%q for --target platform\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # single-quoted: searching for literal $() in source
if grep -qF 'rust_lines="$(rust_outdated' "$script"; then
  printf '[PASS] main: rust_lines gathered via rust_outdated() in both modes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: rust_lines gathering via rust_outdated() not found\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # single-quoted: searching for literal $var in source
if grep -qF 'rust_update_one "$pkg" "$old_ver" "$new_ver" "$dep_kind" "$dep_package" "$dep_platform"' "$script"; then
  printf '[PASS] main: rust_update_one called with platform arg\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: rust_update_one not called with platform arg\n'
  fail=$(( fail + 1 ))
fi

if grep -q 'cargo install cargo-outdated' "$script"; then
  printf '[PASS] prereqs: documents cargo-outdated install hint\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereqs: missing cargo-outdated install hint\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: missing host tooling exits 3, not 1 (#535) ===\n'
# check_ecosystem_prereqs must distinguish "this host lacks a toolchain" from
# "work failed", so a --batch --all parent can skip instead of failing the run.
missing_tool_out=""
missing_tool_rc=0
set +e
# SC2317/SC2034: stubs and script-level vars are consumed by the sourced function,
# which shellcheck cannot see through the process substitution.
# shellcheck disable=SC2317,SC2034
missing_tool_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^check_ecosystem_prereqs\(\)/,/^}$/' "$script")
  dep_updater_exit_missing_tooling=3
  npm_tool='pnpm'
  py_tool='uv'
  # No-op log(), as --quiet and --report-json produce: the tool name must still
  # reach stderr, or the notifier reports a bare exit 3 with no reason.
  log() { :; }
  record_first_failure() { :; }
  tooling_prereq_check_ecosystem_tools() { return 0; }
  tooling_prereq_report_last_ids() { printf ''; }
  # Hide cargo so the Rust branch reports it absent.
  command() {
    if [[ "$1" == '-v' && "$2" == 'cargo' ]]; then
      return 1
    fi
    builtin command "$@"
  }
  check_ecosystem_prereqs 0 '' 1 2>&1
)"
missing_tool_rc=$?
set -e
if [[ "$missing_tool_rc" -eq 3 ]]; then
  printf '[PASS] prereqs: absent cargo exits 3 (missing tooling), not 1\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereqs: expected exit 3, got %s\n%s\n' "$missing_tool_rc" "$missing_tool_out"
  fail=$(( fail + 1 ))
fi
# Exit 3 is non-zero, so an operator who pointed dep-updater at a single repo still
# gets a hard failure — only the --batch --all parent downgrades it to a skip.
if [[ "$missing_tool_rc" -ne 0 ]]; then
  printf '[PASS] prereqs: single-repo run still fails loudly on missing tooling\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereqs: single-repo run must not silently skip missing tooling\n'
  fail=$(( fail + 1 ))
fi
if grep -qF 'ERROR: MISSING_ECOSYSTEM_TOOLING tools=cargo' <<<"$missing_tool_out"; then
  printf '[PASS] prereqs: MISSING_ECOSYSTEM_TOOLING reaches stderr even when log() is a no-op\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereqs: missing MISSING_ECOSYSTEM_TOOLING line\n%s\n' "$missing_tool_out"
  fail=$(( fail + 1 ))
fi

# A healthy host must not trip the skip path.
set +e
ok_tool_rc=0
# shellcheck disable=SC2317,SC2034
(
  # shellcheck disable=SC1090
  source <(awk '/^check_ecosystem_prereqs\(\)/,/^}$/' "$script")
  dep_updater_exit_missing_tooling=3
  npm_tool='pnpm'
  py_tool='uv'
  log() { :; }
  record_first_failure() { :; }
  tooling_prereq_check_ecosystem_tools() { return 0; }
  tooling_prereq_report_last_ids() { printf ''; }
  check_ecosystem_prereqs 0 '' 0
) >/dev/null 2>&1
ok_tool_rc=$?
set -e
if [[ "$ok_tool_rc" -eq 0 ]]; then
  printf '[PASS] prereqs: nothing missing exits 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prereqs: expected exit 0 with no Rust check, got %s\n' "$ok_tool_rc"
  fail=$(( fail + 1 ))
fi

printf '\n=== behavioural: batch-all names the missing tools (#535) ===\n'
missing_log="$(mktemp)"
printf '%s\n' \
  'some earlier line' \
  'ERROR: MISSING_ECOSYSTEM_TOOLING tools=cargo cargo-outdated' \
  '       Install the missing tool(s) above and retry.' >"$missing_log"
missing_tools_out="$(
  # shellcheck disable=SC1090
  source <(awk '/^batch_all_missing_tooling_from_log\(\)/,/^}$/' "$script")
  batch_all_missing_tooling_from_log "$missing_log"
)"
if [[ "$missing_tools_out" == 'cargo cargo-outdated' ]]; then
  printf '[PASS] batch-all: extracts the missing tool list from the child log\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-all: expected "cargo cargo-outdated", got "%s"\n' "$missing_tools_out"
  fail=$(( fail + 1 ))
fi
printf '%s\n' 'no tooling line here' >"$missing_log"
missing_tools_fallback="$(
  # shellcheck disable=SC1090
  source <(awk '/^batch_all_missing_tooling_from_log\(\)/,/^}$/' "$script")
  batch_all_missing_tooling_from_log "$missing_log"
)"
if [[ "$missing_tools_fallback" == 'unknown' ]]; then
  printf '[PASS] batch-all: falls back to "unknown" so the skip line is never empty\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-all: expected "unknown", got "%s"\n' "$missing_tools_fallback"
  fail=$(( fail + 1 ))
fi
rm -f "$missing_log"

printf '\n=== static: batch-all skips missing tooling without failing the run (#535) ===\n'
# The skip must run before the generic failure branch, leave worst_exit alone, and
# drop the ephemeral clone (nothing in it to repair — the fix is on the host).
if awk '
    /^batch_all_dispatch\(\)/ { in_fn=1 }
    in_fn && /child_exit" -eq "\$dep_updater_exit_missing_tooling/ { found_guard=1 }
    in_fn && found_guard && /missing host tooling/ { found_log=1 }
    in_fn && found_guard && !seen_fail && /rm -rf "\$repo"/ { found_rm=1 }
    in_fn && found_guard && /child_exit" -ne 0/ { seen_fail=1 }
    END { exit (found_guard && found_log && found_rm && seen_fail) ? 0 : 1 }
  ' "$script"; then
  printf '[PASS] batch-all: exit 3 skips, logs, and removes the clone before the failure branch\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-all: missing-tooling skip path not wired ahead of the failure branch\n'
  fail=$(( fail + 1 ))
fi
# worst_exit must not be assigned inside the skip branch. Comments are ignored: the
# block explains that it deliberately leaves worst_exit alone.
if awk '
    /child_exit" -eq "\$dep_updater_exit_missing_tooling/ { in_skip=1; next }
    in_skip && /^    fi$/ { in_skip=0; next }
    in_skip && /^[[:space:]]*#/ { next }
    in_skip && /worst_exit[[:space:]]*=/ { bad=1 }
    END { exit bad ? 1 : 0 }
  ' "$script"; then
  printf '[PASS] batch-all: missing-tooling skip leaves worst_exit unchanged\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-all: missing-tooling skip must not modify worst_exit\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: Rust toolchain dependency is documented (#535) ===\n'
agents_md="${script_dir}/../AGENTS.md"
readme_md="${script_dir}/../README.md"
if grep -qF 'cargo install cargo-outdated --locked' "$agents_md" \
  && grep -qF 'cargo-outdated' "$agents_md" \
  && grep -qF 'rustup' "$agents_md"; then
  printf '[PASS] docs: AGENTS.md names the Rust toolchain dependency and install line\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] docs: AGENTS.md must name cargo-outdated and the rustup caveat\n'
  fail=$(( fail + 1 ))
fi
if grep -qF 'cargo install cargo-outdated --locked' "$readme_md" \
  && grep -qF 'rustup' "$readme_md"; then
  printf '[PASS] docs: README.md names the Rust toolchain dependency and install line\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] docs: README.md must name cargo-outdated and the rustup caveat\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2088  # literal doc text, not a path to expand
if grep -qF '~/.cargo/bin' "$agents_md" && grep -qF '~/.cargo/bin' "$readme_md"; then
  printf '[PASS] docs: both files warn that ~/.cargo/bin is absent from a cron PATH\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] docs: missing the ~/.cargo/bin cron PATH caveat\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: org-repo-discovery cursor rule ===\n'
org_disc_rule="${script_dir}/../.cursor/rules/org-repo-discovery.mdc"
if [[ -f "$org_disc_rule" ]] \
  && grep -qF 'alwaysApply: true' "$org_disc_rule" \
  && grep -qF 'rp_discover_org_repos' "$org_disc_rule" \
  && grep -qF 'missing-clone' "$org_disc_rule" \
  && grep -qF 'dep-updater --batch --all' "$org_disc_rule"; then
  printf '[PASS] org-repo-discovery: alwaysApply rule documents API SSOT\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] org-repo-discovery: missing or incomplete .cursor/rules/org-repo-discovery.mdc\n'
  fail=$(( fail + 1 ))
fi

# --batch --all multi-repo driver
# shellcheck disable=SC2016  # assert literal orgs/${org}/repos in source
if grep -q '\-\-all' "$script" && grep -q '^discover_batch_all_repos()' "$script" \
  && grep -q '^discover_batch_all_org_repo_membership_tsv()' "$script" \
  && grep -q '^discover_batch_all_index_local_clones()' "$script" \
  && grep -q '^batch_all_materialize_checkout()' "$script" \
  && grep -q '^batch_all_ephemeral_clone_safe_to_remove()' "$script" \
  && grep -qF 'batch_all_ephemeral_clone_safe_to_remove "$child_exit"' "$script" \
  && grep -qF 'Keeping ephemeral clones for follow-up:' "$script" \
  && grep -qF '_batch_all_retained_clones > 0' "$script" \
  && grep -q '^batch_all_reap_stale_ephemeral_roots()' "$script" \
  && grep -qF '_batch_all_pending_ephemeral_clone' "$script" \
  && grep -qF '_runner_interrupted:-0' "$script" \
  && grep -qF 'worst_exit="$clone_rc"' "$script" \
  && grep -q '^batch_all_dispatch()' "$script" \
  && grep -q '^log_batch_all_top_level_dirs()' "$script" \
  && grep -qF 'lib/dep-updater-org-clone' "$script" \
  && grep -qF 'include-private' "$script" \
  && grep -qF 'orgs/${org}/repos' "$script" \
  && grep -qF 'Ephemeral clone (depth 1):' "$script" \
  && grep -qF 'ephemeral clone failed' "$script" \
  && grep -qF 'local clone not in org membership' "$script" \
  && grep -qF 'private org repository (use --include-private)' "$script" \
  && grep -qF 'archived org repository' "$script" \
  && grep -qF 'Failed to list org repositories' "$script" \
  && grep -qF 'DEP_UPDATER_INCLUDE_PRIVATE' "$script" \
  && grep -qF 'DEP_UPDATER_ORG' "$script"; then
  printf '[PASS] batch --all: org API discovery, ephemeral clone, and helpers present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch --all: missing org API discovery or helper functions\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: usage Modes / Options / parse_args in lexicographic order ===\n'
usage_modes_lines=""
usage_modes_lines="$(awk '
  /^Modes:/ { m=1; next }
  /^Options:/ { if (m) exit 0 }
  m && $1 ~ /^--[a-z0-9-]+$/ { print $1 }
' "$script")"
if diff -q <(printf '%s\n' "$usage_modes_lines") \
  <(printf '%s\n' "$usage_modes_lines" | LC_ALL=C sort) >/dev/null 2>&1; then
  printf '[PASS] usage Modes: flag lines are lexicographically sorted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] usage Modes: flag lines out of order:\n%s\n' "$usage_modes_lines"
  fail=$(( fail + 1 ))
fi

usage_options_lines=""
usage_options_lines="$(awk '
  /^Options:/ { o=1; next }
  /^Supported ecosystems:/ { if (o) exit 0 }
  o && /^  -h,/ { print "-h|--help"; next }
  o && $1 ~ /^--[a-z0-9-]+$/ { print $1 }
' "$script")"
if diff -q <(printf '%s\n' "$usage_options_lines") \
  <(printf '%s\n' "$usage_options_lines" | LC_ALL=C sort) >/dev/null 2>&1; then
  printf '[PASS] usage Options: primary flag lines are lexicographically sorted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] usage Options: primary flag lines out of order:\n%s\n' "$usage_options_lines"
  fail=$(( fail + 1 ))
fi

parse_case_lines=""
parse_case_lines="$(awk -v marker='case "$1" in' '
  /^parse_args\(\)/ { fn=1; next }
  fn && index($0, marker) { c=1; next }
  c && /^    esac$/ { exit 0 }
  c && /^      \*\)/ { next }
  c && index($0, "-h|--help)") > 0 { print "-h|--help"; next }
  c && match($0, /--[a-z0-9-]+\)/) { print substr($0, RSTART, RLENGTH - 1) }
' "$script")"
if diff -q <(printf '%s\n' "$parse_case_lines") \
  <(printf '%s\n' "$parse_case_lines" | LC_ALL=C sort) >/dev/null 2>&1; then
  printf '[PASS] parse_args: case patterns are lexicographically sorted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] parse_args: case patterns out of order:\n%s\n' "$parse_case_lines"
  fail=$(( fail + 1 ))
fi

# Behavioural: gha_outdated logic for major-only pins
# Given a current_major and latest_major, the new_ref should be v${latest_major}
# when latest_major > current_major, and empty otherwise.
printf '\n=== behavioural: gha pin-style comparison logic ===\n'

# Major-only: v6 → v7.0.0 when latest release is in the next major.
major_bump_result=""
major_bump_result="$(
  current_ref="v6"
  current_major="${current_ref#v}"
  latest_tag="v7.0.0"
  latest_ver="${latest_tag#v}"
  latest_major="${latest_ver%%.*}"
  new_ref=""
  if (( latest_major > current_major )); then
    new_ref="v${latest_ver}"
  elif (( latest_major == current_major )) && [[ "$latest_ver" != "$current_major" ]]; then
    new_ref="v${latest_ver}"
  fi
  printf '%s' "$new_ref"
)"
if [[ "$major_bump_result" == 'v7.0.0' ]]; then
  printf '[PASS] major-only pin: v6 bumped to v7.0.0 when latest release is v7.0.0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] major-only pin: expected v7.0.0, got "%s"\n' "$major_bump_result"
  fail=$(( fail + 1 ))
fi

# Major-only: v6 → v6.0.2 when latest release is a patch within the same major.
major_patch_bump_result=""
major_patch_bump_result="$(
  current_ref="v6"
  current_major="${current_ref#v}"
  latest_tag="v6.0.2"
  latest_ver="${latest_tag#v}"
  latest_major="${latest_ver%%.*}"
  new_ref=""
  if (( latest_major > current_major )); then
    new_ref="v${latest_ver}"
  elif (( latest_major == current_major )) && [[ "$latest_ver" != "$current_major" ]]; then
    new_ref="v${latest_ver}"
  fi
  printf '%s' "$new_ref"
)"
if [[ "$major_patch_bump_result" == 'v6.0.2' ]]; then
  printf '[PASS] major-only pin: v6 bumped to v6.0.2 when latest release is v6.0.2\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] major-only pin: expected v6.0.2, got "%s"\n' "$major_patch_bump_result"
  fail=$(( fail + 1 ))
fi

# Major-only: v7 → v8.1.0 when the action dropped major tags but publishes semver releases.
major_no_tag_result=""
major_no_tag_result="$(
  current_ref="v7"
  current_major="${current_ref#v}"
  latest_tag="v8.1.0"
  latest_ver="${latest_tag#v}"
  latest_major="${latest_ver%%.*}"
  new_ref=""
  if (( latest_major > current_major )); then
    new_ref="v${latest_ver}"
  elif (( latest_major == current_major )) && [[ "$latest_ver" != "$current_major" ]]; then
    new_ref="v${latest_ver}"
  fi
  printf '%s' "$new_ref"
)"
if [[ "$major_no_tag_result" == 'v8.1.0' ]]; then
  printf '[PASS] major-only pin: v7 bumped to v8.1.0 without a v8 major tag\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] major-only pin: expected v8.1.0, got "%s"\n' "$major_no_tag_result"
  fail=$(( fail + 1 ))
fi

# Full semver with v-prefix: v1.7.12 → v1.7.13 (with v preserved)
full_semver_v_result=""
full_semver_v_result="$(
  current_ref="v1.7.12"
  latest_tag="v1.7.13"
  current_ver="${current_ref#v}"
  latest_ver="${latest_tag#v}"
  new_ref=""
  if [[ "$current_ver" != "$latest_ver" ]]; then
    sort_winner="$(printf '%s\n%s\n' "$current_ver" "$latest_ver" | sort -V | tail -1)"
    if [[ "$sort_winner" == "$latest_ver" ]]; then
      new_ref="v${latest_ver}"
    fi
  fi
  printf '%s' "$new_ref"
)"
if [[ "$full_semver_v_result" == 'v1.7.13' ]]; then
  printf '[PASS] full-semver pin: v1.7.12 bumped to v1.7.13 (v-prefix preserved)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-semver pin: expected v1.7.13, got "%s"\n' "$full_semver_v_result"
  fail=$(( fail + 1 ))
fi

# Full semver without v-prefix: 0.35.0 → 0.36.0 (no v added)
full_semver_no_v_result=""
full_semver_no_v_result="$(
  current_ref="0.35.0"
  latest_tag="v0.36.0"
  current_ver="${current_ref#v}"
  latest_ver="${latest_tag#v}"
  new_ref=""
  if [[ "$current_ver" != "$latest_ver" ]]; then
    sort_winner="$(printf '%s\n%s\n' "$current_ver" "$latest_ver" | sort -V | tail -1)"
    if [[ "$sort_winner" == "$latest_ver" ]]; then
      # Preserve the absence of 'v'
      if [[ "$current_ref" == v* ]]; then
        new_ref="v${latest_ver}"
      else
        new_ref="$latest_ver"
      fi
    fi
  fi
  printf '%s' "$new_ref"
)"
if [[ "$full_semver_no_v_result" == '0.36.0' ]]; then
  printf '[PASS] full-semver pin (no v): 0.35.0 bumped to 0.36.0 (no v-prefix added)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-semver pin (no v): expected 0.36.0, got "%s"\n' "$full_semver_no_v_result"
  fail=$(( fail + 1 ))
fi

# No downgrade: sort -V must select latest when it is genuinely newer
no_downgrade_result=""
no_downgrade_result="$(
  current_ver="1.7.13"
  latest_ver="1.7.12"
  sort_winner="$(printf '%s\n%s\n' "$current_ver" "$latest_ver" | sort -V | tail -1)"
  if [[ "$sort_winner" == "$latest_ver" && "$current_ver" != "$latest_ver" ]]; then
    printf 'downgraded'
  else
    printf 'no-downgrade'
  fi
)"
if [[ "$no_downgrade_result" == 'no-downgrade' ]]; then
  printf '[PASS] full-semver pin: no downgrade when current (%s) > latest (%s)\n' "1.7.13" "1.7.12"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] full-semver pin: downgrade would occur — sort -V logic broken\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: pnpm install retry behaviour
# ---------------------------------------------------------------------------

printf '\n=== static: pnpm install retry behaviour ===\n'

# pnpm_install_worktree must NOT retry ERR_PNPM_NO_MATCHING_VERSION.
# That error is not transient — the version does not exist and retrying wastes
# minutes.  npm_version_prefetch is the gatekeeper: it verifies downloadability
# before the package is ever added to the update list.
pnpm_install_fn="$(awk '/^pnpm_install_worktree\(\)/,/^\}/' "$script")"
if ! grep -qF 'ERR_PNPM_NO_MATCHING_VERSION' <<<"$pnpm_install_fn" \
   || grep -qF 'return 2' <<<"$pnpm_install_fn"; then
  printf '[PASS] pnpm-retry: pnpm_install_worktree signals skip (exit 2) rather than retrying on no-matching-version\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: pnpm_install_worktree retries ERR_PNPM_NO_MATCHING_VERSION (should signal caller with exit 2 instead)\n'
  fail=$(( fail + 1 ))
fi

# pnpm_install_worktree must return exit 2 for ERR_PNPM_NO_MATCHING_VERSION
# so callers can skip the group rather than killing the whole run.
if grep -qF 'return 2' <<<"$pnpm_install_fn"; then
  printf '[PASS] pnpm-retry: pnpm_install_worktree returns exit 2 for no-matching-version (skip sentinel)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: pnpm_install_worktree missing "return 2" skip sentinel for no-matching-version\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'ERR_PNPM_LOCKFILE_CONFIG_MISMATCH' <<<"$pnpm_install_fn" \
  && grep -qF 'pnpm_install_worktree no-frozen' <<<"$pnpm_install_fn"; then
  printf '[PASS] pnpm-retry: lockfile config mismatch retries with --no-frozen-lockfile\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: missing lockfile config mismatch fallback to no-frozen\n'
  fail=$(( fail + 1 ))
fi

# npm_update_group must handle exit 2 from pnpm_install_worktree gracefully
# (skip the group, restore manifests) rather than calling die.
npm_update_group_fn="$(awk '/^npm_update_group\(\)/,/^\}/' "$script")"
if grep -qE 'pnpm_rc.*-eq 2|eq 2.*pnpm_rc' <<<"$npm_update_group_fn"; then
  printf '[PASS] pnpm-retry: npm_update_group handles exit 2 (skip group on no-matching-version)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: npm_update_group does not handle exit 2 from pnpm_install_worktree\n'
  fail=$(( fail + 1 ))
fi

# The retry must use sleep for backoff (not just re-invoke pnpm immediately).
if grep -qF 'sleep' <<<"$pnpm_install_fn"; then
  printf '[PASS] pnpm-retry: sleep backoff present in pnpm_install_worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: sleep backoff missing from pnpm_install_worktree\n'
  fail=$(( fail + 1 ))
fi

# The retry must be bounded (not an infinite loop) — a finite attempt list must
# appear in the function.
if grep -qE 'for attempt in [0-9 ]+;' <<<"$pnpm_install_fn"; then
  printf '[PASS] pnpm-retry: bounded attempt loop present in pnpm_install_worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: no bounded attempt loop found in pnpm_install_worktree\n'
  fail=$(( fail + 1 ))
fi

# pnpm_install_worktree must also retry on transient network errors.
if grep -qiE 'ECONNRESET|ETIMEDOUT|ENOTFOUND' <<<"$pnpm_install_fn"; then
  printf '[PASS] pnpm-retry: network error patterns present in pnpm_install_worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-retry: network error patterns missing from pnpm_install_worktree\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: install_with_net_retry covers all other ecosystems
# ---------------------------------------------------------------------------

printf '\n=== static: install_with_net_retry helper ===\n'

# The helper function must be defined.
if grep -q '^install_with_net_retry()' "$script"; then
  printf '[PASS] net-retry: install_with_net_retry function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] net-retry: install_with_net_retry function is missing\n'
  fail=$(( fail + 1 ))
fi

net_retry_fn="$(awk '/^install_with_net_retry\(\)/,/^\}/' "$script")"

# The helper must contain a sleep for backoff.
if grep -qF 'sleep' <<<"$net_retry_fn"; then
  printf '[PASS] net-retry: sleep backoff present in install_with_net_retry\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] net-retry: sleep backoff missing from install_with_net_retry\n'
  fail=$(( fail + 1 ))
fi

# The helper must cover common network error patterns.
if grep -qiE 'ECONNRESET|ETIMEDOUT|ENOTFOUND|network error|ConnectTimeout' <<<"$net_retry_fn"; then
  printf '[PASS] net-retry: network error patterns present in install_with_net_retry\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] net-retry: network error patterns missing from install_with_net_retry\n'
  fail=$(( fail + 1 ))
fi

# create_worktree must use install_with_net_retry for npm, yarn, uv, poetry, pipenv.
# Avoid range patterns that can terminate early when a line begins with "}".
create_worktree_fn="$(
  awk '
    BEGIN { in_fn = 0; depth = 0 }
    /^create_worktree\(\)[[:space:]]*\{/ {
      in_fn = 1
      depth = 1
      print
      next
    }
    in_fn {
      print
      # Count braces (best-effort; this is a test helper, not a parser).
      depth += gsub(/\{/, "{")
      depth -= gsub(/\}/, "}")
      if (depth <= 0) {
        exit
      }
    }
  ' "$script"
)"
for ecosystem_check in \
    'install_with_net_retry npm' \
    'install_with_net_retry yarn' \
    'install_with_net_retry uv' \
    'install_with_net_retry poetry' \
    'install_with_net_retry pipenv' \
    'install_with_net_retry cargo'; do
  ecosystem_label="${ecosystem_check#install_with_net_retry }"
  if grep -qF "$ecosystem_check" <<<"$create_worktree_fn"; then
    printf '[PASS] net-retry: create_worktree uses install_with_net_retry for %s\n' "$ecosystem_label"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] net-retry: create_worktree does not use install_with_net_retry for %s\n' "$ecosystem_label"
    fail=$(( fail + 1 ))
  fi
done

# ---------------------------------------------------------------------------
# Static: npm_version_prefetch proactive verification
# ---------------------------------------------------------------------------

printf '\n=== static: npm_version_prefetch proactive verification ===\n'

# Function must be defined.
if grep -q '^npm_version_prefetch()' "$script"; then
  printf '[PASS] npm-prefetch: npm_version_prefetch function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: npm_version_prefetch function is missing\n'
  fail=$(( fail + 1 ))
fi

prefetch_fn="$(awk '/^npm_version_prefetch\(\)/,/^\}/' "$script")"

# Must use pnpm store add to pre-warm the content-addressable store.
if grep -qF 'pnpm store add' <<<"$prefetch_fn"; then
  printf '[PASS] npm-prefetch: pre-warms pnpm store with "pnpm store add"\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: does not call "pnpm store add" to pre-warm the store\n'
  fail=$(( fail + 1 ))
fi

# pnpm store add must gate the return — its exit code must be checked so that a
# failed download (tarball not yet on the mirror) causes a retry or skip, not a
# silent success.  The old bug was "pnpm store add ... || true" which swallowed
# download failures and let undownloadable versions reach pnpm install.
if grep -qE 'if pnpm store add|store_exit=0' <<<"$prefetch_fn"; then
  printf '[PASS] npm-prefetch: pnpm store add exit code is checked (gates return 0)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: pnpm store add exit code is not checked — wrap in "if pnpm store add"\n'
  fail=$(( fail + 1 ))
fi

# Specifically: "pnpm store add" must not be followed by "|| true".
# (pnpm view ... || true is fine — it handles unknown packages gracefully.)
if ! grep -qF 'pnpm store add.*|| true' <<<"$prefetch_fn" \
   && ! printf '%s' "$prefetch_fn" | grep -E 'pnpm store add.+$' | grep -qF '|| true'; then
  printf '[PASS] npm-prefetch: "pnpm store add" exit code is not suppressed with "|| true"\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: "pnpm store add" uses "|| true" — download failures are silenced\n'
  fail=$(( fail + 1 ))
fi

# Must use curl to query the registry HTTP API directly (bypasses pnpm metadata
# cache which can return stale results for versions that don't exist).
if grep -qF 'curl' <<<"$prefetch_fn"; then
  printf '[PASS] npm-prefetch: uses curl to verify version via registry HTTP API (cache-bypassing)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: missing curl registry HTTP API check — pnpm view cache can return stale results\n'
  fail=$(( fail + 1 ))
fi

# Must check HTTP 200 status to distinguish "version exists" from "404 not found".
if grep -qF '"200"' <<<"$prefetch_fn"; then
  printf '[PASS] npm-prefetch: checks for HTTP 200 from registry\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: does not check for HTTP 200 — non-existent versions may pass\n'
  fail=$(( fail + 1 ))
fi

# Must retry with sleep backoff (not fail immediately).
if grep -qF 'sleep' <<<"$prefetch_fn"; then
  printf '[PASS] npm-prefetch: has sleep backoff for registry propagation lag\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: no sleep backoff in npm_version_prefetch\n'
  fail=$(( fail + 1 ))
fi

# Must be called from npm_outdated (both discovery paths).
npm_outdated_fn="$(awk '/^npm_outdated\(\)/,/^\}/' "$script")"
if grep -qF 'npm_version_prefetch_closure' <<<"$npm_outdated_fn" \
  && grep -qF 'npm_pnpm_filter_outdated_lines' <<<"$npm_outdated_fn"; then
  printf '[PASS] npm-prefetch: npm_outdated uses closure prefetch and lockfile batch filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm-prefetch: npm_outdated must call npm_version_prefetch_closure and npm_pnpm_filter_outdated_lines\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: pnpm lockfile batch verification restores manifests ===\n'
# shellcheck disable=SC2016  # intentional literal grep for cp "$bak_pkg" in script
if grep -q '^npm_pnpm_try_lockfile_with_updates()' "$script" \
  && grep -qF 'cp "$bak_pkg" "$pkg_json"' "$script" \
  && grep -qF 'install --lockfile-only' "$script"; then
  printf '[PASS] pnpm-lockfile-verify: dry-run install restores package.json and lockfile\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pnpm-lockfile-verify: expected npm_pnpm_try_lockfile_with_updates with restore\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: die() always writes to stderr (not via log which quiet mode silences)
#
# --report-json implies --quiet which sets TIME_LOG_ENABLED=0, silencing log().
# die() must use printf ... >&2 directly so errors are always visible to the
# notifier's run_command stderr capture — even in --quiet / --report-json mode.
printf '\n=== static: nested npm project root helpers ===\n'
if grep -q '^npm_project_root()' "$script" \
  && grep -q '^npm_repo_rel_path()' "$script" \
  && grep -qF 'Using nested package.json at:' "$script" \
  && grep -qF "npm_project_root \"\$worktree_path\"" "$script"; then
  update_mode_block="$(awk '/^# Update mode$/,/^main "\$@"/{print}' "$script")"
  # shellcheck disable=SC2016  # needle is literal source text containing $dir
  if grep -qF 'npm_project_root "$dir"' <<<"$update_mode_block"; then
    printf '[FAIL] nested-npm: update mode must not scan npm from primary clone\n'
    fail=$(( fail + 1 ))
  else
    printf '[PASS] nested-npm: helpers and worktree scan paths use npm_project_root\n'
    pass=$(( pass + 1 ))
  fi
else
  printf '[FAIL] nested-npm: expected npm_project_root / npm_repo_rel_path / nested log / scan wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: dep_runner_git_c_stdout preserves last line for while read ===\n'
# shellcheck disable=SC2016
if awk '/^dep_runner_git_c_stdout\(\)/,/^}$/ {print}' "$script" \
  | grep -qF "out+=$'\n'"; then
  printf '[PASS] dep_runner_git_c_stdout: appends trailing newline when git omits it\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dep_runner_git_c_stdout: must append newline for line-oriented callers (issue #330)\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: git ls-tree stdout last line survives while read ===\n'
_sim_git_lines="uv.lock"$'\n'"web"
unfixed_n=0
while IFS= read -r _sim_entry; do
  unfixed_n=$((unfixed_n + 1))
done < <(printf '%s' "$_sim_git_lines")
fixed_lines="$_sim_git_lines"
if [[ "$fixed_lines" != *$'\n' ]]; then
  fixed_lines+=$'\n'
fi
fixed_n=0
while IFS= read -r _sim_entry; do
  fixed_n=$((fixed_n + 1))
done < <(printf '%s' "$fixed_lines")
if [[ "$unfixed_n" -eq 1 && "$fixed_n" -eq 2 ]]; then
  printf '[PASS] trailing newline: while read sees last ls-tree entry (web)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] trailing newline repro: unfixed=%s fixed=%s (expected 1 then 2)\n' \
    "$unfixed_n" "$fixed_n"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: batch-all cycles repo header colors ===\n'
# Single quotes intentional: this is a literal grep pattern, not an expansion.
# shellcheck disable=SC2016
color_apply_pattern='TIME_LOG_COLOR_START="$_this_color"'
