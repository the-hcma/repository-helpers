all_only_out="$("$script" --all --dry-run 2>&1)"
all_only_exit=$?
set -e
if [[ "$all_only_exit" -ne 0 ]] \
  && grep -q -- '--all requires --batch' <<<"$all_only_out"; then
  printf '[PASS] --all without --batch is rejected\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected --all requires --batch; exit=%s output:\n%s\n' \
    "$all_only_exit" "$all_only_out"
  fail=$(( fail + 1 ))
fi

