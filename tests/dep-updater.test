#!/usr/bin/env bash
# Basic smoke tests for dep-updater dry-run mode.
#
# These tests run the script with --dry-run against this repository (which has
# no npm or Python ecosystem) and verify:
#   1. The script exits 0.
#   2. A worktree is created  (log line "[worktree] Creating worktree at:").
#   3. The worktree is removed (log line "[worktree] Removed:").
#   4. The output indicates that no dependencies need updating.
#
# Both non-batch and --batch modes are exercised to confirm the code paths
# do not diverge on these invariants.
#
# Prerequisites (must be on PATH): git, gt, gh, jq, rg
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/dep-updater"
readonly script

pass=0
fail=0

release_age_defaults="${script_dir}/../scripts/lib/release-age-defaults"
readonly release_age_defaults

printf '\n=== static: npm minimumReleaseAge (dep-updater day gate) ===\n'
# Run before any dep-updater dry-run: create_worktree may reset the primary checkout.
if [[ -f "$release_age_defaults" ]]; then
  printf '[PASS] release-age: scripts/lib/release-age-defaults exists\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: scripts/lib/release-age-defaults is missing\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2016  # grep for literal strings in the script under test
if grep -qF 'source "${dep_script_dir}/lib/release-age-defaults"' "$script" \
  && grep -qF 'dep_updater_minimum_release_age_minutes="$release_age_dep_updater_minutes"' "$script" \
  && grep -q '^npm_version_meets_minimum_release_age()' "$script" \
  && grep -q '^npm_minimum_release_age_minutes()' "$script" \
  && grep -q '^py_version_meets_minimum_release_age()' "$script" \
  && grep -q '^gha_version_meets_minimum_release_age()' "$script"; then
  printf '[PASS] release-age: dep-updater floor constant and gate helpers are defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: missing release-age defaults source, constant wiring, or gate helpers\n'
  fail=$(( fail + 1 ))
fi
release_age_npm_outdated_fn="$(
  awk '
    BEGIN { in_fn = 0; depth = 0 }
    /^npm_outdated\(\)[[:space:]]*\{/ {
      in_fn = 1
      depth = 1
      print
      next
    }
    in_fn {
      print
      depth += gsub(/\{/, "{")
      depth -= gsub(/\}/, "}")
      if (depth <= 0) {
        exit
      }
    }
  ' "$script"
)"
if printf '%s' "$release_age_npm_outdated_fn" | grep -qF 'npm_version_meets_minimum_release_age'; then
  printf '[PASS] release-age: npm_outdated applies minimumReleaseAge before proposing bumps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: npm_outdated must call npm_version_meets_minimum_release_age\n'
  fail=$(( fail + 1 ))
fi
release_age_prefetch_closure_fn="$(awk '/^npm_version_prefetch_closure\(\)/,/^\}/' "$script")"
if printf '%s' "$release_age_prefetch_closure_fn" | grep -qF 'npm_version_meets_minimum_release_age'; then
  printf '[PASS] release-age: npm_version_prefetch_closure enforces age on transitive exact deps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: npm_version_prefetch_closure must check minimumReleaseAge\n'
  fail=$(( fail + 1 ))
fi
release_age_cve_age_fn="$(awk '/^npm_version_meets_minimum_release_age\(\)/,/^\}/' "$script")"
if grep -q '^npm_pkg_has_cve_fix_in_audit()' "$script" \
  && printf '%s' "$release_age_cve_age_fn" | grep -qF 'npm_pkg_has_cve_fix_in_audit'; then
  printf '[PASS] release-age: CVE-marked npm packages bypass minimumReleaseAge in dep-updater\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: npm_version_meets_minimum_release_age must bypass for CVE audit entries\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2016  # intentional literal grep for assignment in script
if grep -qF 'npm_cve_fix_audit_lines="$npm_audit_lines"' "$script"; then
  printf '[PASS] release-age: audit lines are set before npm_outdated for CVE bypass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: must assign npm_cve_fix_audit_lines before npm_outdated\n'
  fail=$(( fail + 1 ))
fi
# shellcheck disable=SC2016  # intentional literal grep for assignment in script
if grep -qF 'py_cve_fix_audit_lines="$py_audit_lines"' "$script" \
  && grep -q '^py_pkg_has_cve_fix_in_audit()' "$script"; then
  printf '[PASS] release-age: pip-audit lines are set before py_outdated for CVE bypass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] release-age: must assign py_cve_fix_audit_lines before py_outdated\n'
  fail=$(( fail + 1 ))
fi

# Run before any dep-updater dry-run: create_worktree restores the primary checkout to main.
# ---------------------------------------------------------------------------
# Static: GitHub Actions ecosystem
# ---------------------------------------------------------------------------

printf '\n=== static: github-actions ecosystem ===\n'

# gha_outdated must handle "- uses:" YAML list entries (common in workflows).
if grep -qF "sed -E 's/^[[:space:]]*-?[[:space:]]*uses:[[:space:]]*//'" "$script"; then
  printf '[PASS] gha_outdated: strips optional leading \"-\" from uses lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: does not strip optional leading \"-\" from uses lines\n'
  fail=$(( fail + 1 ))
fi

# has_gha global variable must be declared
if grep -q '^has_gha=0' "$script"; then
  printf '[PASS] has_gha: global variable declared with default 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] has_gha: global variable not declared\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated() function must be defined
if grep -q '^gha_outdated()' "$script"; then
  printf '[PASS] gha_outdated: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one() function must be defined
if grep -q '^gha_update_one()' "$script"; then
  printf '[PASS] gha_update_one: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# detect_ecosystem() must set has_gha=1 when gha or auto ecosystem
if grep -A5 "ecosystem.*'gha'.*auto\|ecosystem.*gha.*auto" "$script" | grep -q 'has_gha=1'; then
  printf '[PASS] detect_ecosystem: sets has_gha=1 for gha/auto ecosystem\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] detect_ecosystem: has_gha=1 not set for gha/auto ecosystem\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must skip commit-SHA pins (40 hex chars)
# Note: awk ERE {n} quantifiers are not supported by all awk implementations
# (e.g. mawk); use grep -P or search for the literal pattern text instead.
if grep -qP '0-9a-fA-F\]\{40\}' "$script" 2>/dev/null \
    || grep -q '0-9a-fA-F]{40}' "$script"; then
  printf '[PASS] gha_outdated: skips commit-SHA pins (40 hex chars)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: commit-SHA pin guard not found\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must list semver releases/tags and pick the newest eligible ref
if grep -q '^_gha_semver_release_tags_desc()' "$script" \
  && grep -q '^_gha_pick_eligible_new_ref()' "$script"; then
  printf '[PASS] gha_outdated: lists semver releases and picks newest eligible ref\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing semver release/tag helpers for eligible ref selection\n'
  fail=$(( fail + 1 ))
fi

# gha_outdated must skip local actions starting with ./
if awk '/^gha_outdated\(\)/{found=1} found && /\.\//{ ok=1 } found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: skips local actions (./path/to/action)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: local action guard not found\n'
  fail=$(( fail + 1 ))
fi

# gha helpers normalize major-only pins for semver comparison
# shellcheck disable=SC2016  # intentional literal grep for script source pattern
if grep -qF 'printf '\''%s.0.0'\'' "$ver"' "$script" \
  && grep -q '^_gha_ref_sortable_version()' "$script"; then
  printf '[PASS] gha_outdated: normalizes major-only pins (^vN) to N.0.0 for comparison\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing _gha_ref_sortable_version major-only normalization\n'
  fail=$(( fail + 1 ))
fi

# gha helpers consult releases and tags endpoints for semver candidates
if grep -qF '/releases?per_page=100' "$script" \
  && grep -qF '/tags?per_page=100' "$script"; then
  printf '[PASS] gha_outdated: queries releases and tags for semver candidates\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: missing releases/tags query for semver candidates\n'
  fail=$(( fail + 1 ))
fi

# gha helpers use sort -V for semver ordering (never downgrade)
if awk '/^_gha_pick_eligible_new_ref\(\)/{found=1} found && /sort -V/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_outdated: uses sort -V for semver comparison in eligible-ref picker\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_outdated: sort -V not found in _gha_pick_eligible_new_ref\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must use dep-updates/gha- branch prefix
if awk '/^gha_update_one\(\)/{found=1} found && /dep-updates\/gha-/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_update_one: uses dep-updates/gha- branch prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: dep-updates/gha- branch prefix not found\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must use find + sed to patch workflow files (not a hardcoded filename)
# find and sed -i are on separate continuation lines, so check for both separately.
find_in_gha="$(awk '/^gha_update_one\(\)/{found=1} found && /find.*\.github\/workflows/{ok=1} found && /^}/{found=0} END{print ok+0}' "$script")"
sed_in_gha="$(awk '/^gha_update_one\(\)/{found=1} found && /sed -i/{ok=1} found && /^}/{found=0} END{print ok+0}' "$script")"
if [[ "$find_in_gha" == '1' && "$sed_in_gha" == '1' ]]; then
  printf '[PASS] gha_update_one: uses find + sed to patch all workflow files\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: find + sed workflow patching not found (find=%s, sed=%s)\n' \
    "$find_in_gha" "$sed_in_gha"
  fail=$(( fail + 1 ))
fi

# gha_update_one must stage .github/workflows/ via git add
if awk '/^gha_update_one\(\)/{found=1} found && /git.*add.*\.github\/workflows/{ok=1} found && /^}/{found=0} END{exit !ok}' "$script"; then
  printf '[PASS] gha_update_one: stages .github/workflows/ after patching\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gha_update_one: git add .github/workflows/ not found\n'
  fail=$(( fail + 1 ))
fi

# gha_lines must be gathered in the dry-run block
# shellcheck disable=SC2016  # single-quoted: searching for literal $() in source
if grep -q 'gha_lines="$(gha_outdated' "$script"; then
  printf '[PASS] main: gha_lines gathered via gha_outdated() in both modes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: gha_lines gathering via gha_outdated() not found\n'
  fail=$(( fail + 1 ))
fi

# gha_update_one must be called in the update loop
# shellcheck disable=SC2016  # single-quoted: searching for literal $var in source
if grep -q 'gha_update_one "$action" "$cur_ref" "$new_ref"' "$script"; then
  printf '[PASS] main: gha_update_one called in update loop\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] main: gha_update_one not called in update loop\n'
  fail=$(( fail + 1 ))
fi

# parse_args ecosystem validation must accept gha and rust
if grep -q 'npm|python|rust|gha|auto' "$script"; then
  printf '[PASS] parse_args: rust and gha accepted as valid --ecosystem values\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] parse_args: rust or gha not in --ecosystem validation\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Run one dry-run invocation and capture output + exit code.
# ---------------------------------------------------------------------------

run_dry_run() {
  local -r label="$1"
  local -r extra_flags="${2:-}"
  local output exit_code
  local tmpfile
  tmpfile="$(mktemp)"
  set +e
  # shellcheck disable=SC2086  # word-split intentional for extra_flags
  "$script" --dry-run --dir "$script_dir" $extra_flags >"$tmpfile" 2>&1
  exit_code=$?
  set -e
  output="$(cat "$tmpfile")"
  rm -f "$tmpfile"

  assert_exit_0   "$label" "$output" "$exit_code"
  # Worktree lifecycle — the core invariant: created and destroyed on every dry-run
  assert_contains "$label" "$output" "[worktree] Creating worktree at:"
  assert_contains "$label" "$output" "[worktree] Ready:"
  assert_contains "$label" "$output" "[worktree] Removed:"
  # Worktree must be under TMPDIR / /tmp, never next to the source repo
  assert_contains "$label" "$output" "[worktree] Creating worktree at: ${TMPDIR:-/tmp}/"
  # No ecosystem → no change
  assert_contains "$label" "$output" "No supported ecosystem detected"
}

# ---------------------------------------------------------------------------
# Test: non-batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== non-batch dry-run ===\n'
run_dry_run "non-batch" ""

# ---------------------------------------------------------------------------
# Test: batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== batch dry-run ===\n'
run_dry_run "batch" "--batch"

# ---------------------------------------------------------------------------
# Test: --batch --all dry-run from a non-git cwd (two child repos)
# ---------------------------------------------------------------------------

printf '\n=== batch --all dry-run ===\n'
batch_all_tmp="$(mktemp -d)"
mkdir -p "${batch_all_tmp}/roots/alpha" "${batch_all_tmp}/roots/beta"
# CI runners often have no global git identity; -c matches other tests in this file.
git -C "${batch_all_tmp}/roots/alpha" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  init -q
git -C "${batch_all_tmp}/roots/alpha" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init
git -C "${batch_all_tmp}/roots/beta" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  init -q
git -C "${batch_all_tmp}/roots/beta" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

roots_real=""
roots_real="$(realpath "${batch_all_tmp}/roots")"

batch_all_out=""
batch_all_exit=0
set +e
batch_all_out="$(
  cd "$batch_all_tmp" && "$script" --batch --all --dry-run --scan-root "${batch_all_tmp}/roots" 2>&1
)"
batch_all_exit=$?
set -e

rm -rf "$batch_all_tmp"

assert_exit_0 "batch --all dry-run (two repos)" "$batch_all_out" "$batch_all_exit"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] Top-level scan directories:"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all]   ${roots_real}"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] --- alpha"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] --- beta"
assert_contains "batch --all dry-run (two repos)" "$batch_all_out" "[batch-all] All repos completed successfully."
# batch-all runs child dep-updater processes; their worktree logs are captured separately.

printf '\n=== batch --all skips private GitHub repos by default ===\n'
private_batch_tmp="$(mktemp -d)"
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin" "${private_batch_tmp}/roots/public-repo" "${private_batch_tmp}/roots/private-repo"

git -C "${private_batch_tmp}/roots/public-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com init -q
git -C "${private_batch_tmp}/roots/public-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/public-repo.git'
git -C "${private_batch_tmp}/roots/public-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

git -C "${private_batch_tmp}/roots/private-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com init -q
git -C "${private_batch_tmp}/roots/private-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  remote add origin 'https://github.com/the-hcma/private-repo.git'
git -C "${private_batch_tmp}/roots/private-repo" \
  -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'repos/the-hcma/public-repo'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/private-repo'* ]]; then
  printf 'true\n'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

private_batch_out=""
private_batch_exit=0
set +e
private_batch_out="$(
  cd "$private_batch_tmp" \
    && PATH="${mock_bin}:${PATH}" \
      "$script" --batch --all --dry-run --scan-root "${private_batch_tmp}/roots" 2>&1
)"
private_batch_exit=$?
set -e
rm -rf "$private_batch_tmp" "$mock_dir"

assert_exit_0 "batch --all skips private repo" "$private_batch_out" "$private_batch_exit"
assert_contains "batch --all skips private repo" "$private_batch_out" "[batch-all] --- public-repo"
assert_not_contains "batch --all skips private repo" "$private_batch_out" "[batch-all] --- private-repo"
assert_contains "batch --all skips private repo" "$private_batch_out" \
  "[batch-all] Skipping private repository: private-repo (the-hcma/private-repo)"

printf '\n=== batch --all: rejects combined --dir ===\n'
fb_dir_out=""
fb_dir_exit=0
set +e
fb_dir_out="$("$script" --batch --all --dir "$script_dir" --scan-root /tmp 2>&1)"
fb_dir_exit=$?
set -e
if [[ "$fb_dir_exit" -ne 0 ]] \
  && printf '%s' "$fb_dir_out" | grep -qF 'scan-root'; then
  printf '[PASS] batch --all rejects --dir (must use --scan-root)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch --all should reject --dir; exit=%s output:\n%s\n' "$fb_dir_exit" "$fb_dir_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== --scan-root requires batch --all ===\n'
scan_only_out=""
scan_only_exit=0
set +e
scan_only_out="$("$script" --scan-root /tmp 2>&1)"
scan_only_exit=$?
set -e
if [[ "$scan_only_exit" -ne 0 ]] \
  && printf '%s' "$scan_only_out" | grep -q -- '--batch' \
  && printf '%s' "$scan_only_out" | grep -q -- '--all'; then
  printf '[PASS] --scan-root without batch --all is rejected\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected rejection of lone --scan-root; exit=%s output:\n%s\n' \
    "$scan_only_exit" "$scan_only_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== --all requires --batch ===\n'
all_only_out=""
all_only_exit=0
set +e
all_only_out="$("$script" --all --dry-run 2>&1)"
all_only_exit=$?
set -e
if [[ "$all_only_exit" -ne 0 ]] \
  && printf '%s' "$all_only_out" | grep -q -- '--all requires --batch'; then
  printf '[PASS] --all without --batch is rejected\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected --all requires --batch; exit=%s output:\n%s\n' \
    "$all_only_exit" "$all_only_out"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Test: --report-json does not require gh/gt
# ---------------------------------------------------------------------------

printf '\n=== report-json: no gh/gt required ===\n'
tmp_home="$(mktemp -d)"
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" checkout -b main >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

report_output=""
report_exit=0
set +e
report_output="$(env HOME="$tmp_home" PATH="/usr/bin:/bin" \
  "$script" --report-json --dir "$tmp_repo" 2>/dev/null)"
report_exit=$?
set -e

rm -rf "$tmp_home" "$tmp_repo"

assert_exit_0 "report-json (no gh/gt)" "$report_output" "$report_exit"
if printf '%s' "$report_output" | jq -e . >/dev/null 2>&1; then
  printf '[PASS] report-json (no gh/gt): output is valid JSON\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report-json (no gh/gt): output is not valid JSON\n'
  printf '       output:\n%s\n' "$report_output"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Test: --report-json stdout must not include post-emit git status lines
# ---------------------------------------------------------------------------

printf '\n=== report-json: stdout has no trailing git status ===\n'
tmp_home="$(mktemp -d)"
tmp_repo="$(mktemp -d)"
origin_bare="$(mktemp -d)"
git -C "$origin_bare" init -q --bare
git -C "$tmp_repo" init -q
git -C "$tmp_repo" checkout -b main >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init
git -C "$tmp_repo" remote add origin "$origin_bare"
git -C "$tmp_repo" push -u origin main -q

report_output=""
report_exit=0
set +e
report_output="$(env HOME="$tmp_home" \
  "$script" --report-json --dir "$tmp_repo" 2>/dev/null)"
report_exit=$?
set -e

rm -rf "$tmp_home" "$tmp_repo" "$origin_bare"

assert_exit_0 "report-json (origin remote)" "$report_output" "$report_exit"
report_json_clean=1
if ! printf '%s' "$report_output" | jq -e . >/dev/null 2>&1; then
  report_json_clean=0
fi
if printf '%s\n' "$report_output" | grep -qE '^(Your branch is up to date|HEAD is now at)'; then
  report_json_clean=0
fi
if (( report_json_clean == 1 )); then
  printf '[PASS] report-json (origin remote): stdout is only JSON (no post-emit git lines)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report-json (origin remote): stdout contains trailing non-JSON git output\n'
  printf '       output:\n%s\n' "$report_output"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Test: pnpm latest-mode detects range updates (lockfile behind)
# ---------------------------------------------------------------------------

printf '\n=== report-json: pnpm detects range updates ===\n'
tmp_home="$(mktemp -d)"
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" checkout -b main >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit --allow-empty -q -m init

cat >"${tmp_repo}/package.json" <<'EOF'
{
  "name": "x",
  "private": true,
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "vite": "^8.0.10"
  }
}
EOF
touch "${tmp_repo}/pnpm-lock.yaml"
git -C "$tmp_repo" add package.json pnpm-lock.yaml >/dev/null 2>&1 || true
git -C "$tmp_repo" -c user.name=dep-updater-test -c user.email=dep-updater-test@example.com \
  commit -q -m "add pnpm project"

tmp_bin="${tmp_home}/bin"
mkdir -p "$tmp_bin"

cat >"${tmp_bin}/pnpm" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

dir=""
if [[ "${1:-}" == "--dir" ]]; then
  dir="${2:-}"
  shift 2
fi

cmd="${1:-}"
shift || true

case "$cmd" in
  install)
    # Ensure node_modules exists so dep-updater doesn't re-install.
    if [[ -n "$dir" ]]; then
      mkdir -p "${dir}/node_modules"
    else
      mkdir -p "./node_modules"
    fi
    # Simulate ERR_PNPM_IGNORED_BUILDS: pnpm returns non-zero but leaves enough
    # state for other updates to proceed.
    echo "[ERR_PNPM_IGNORED_BUILDS] Ignored build scripts: esbuild@0.27.7, esbuild@0.28.0" >&2
    echo "Run \"pnpm approve-builds\" to pick which dependencies should be allowed to run scripts." >&2
    exit 1
    ;;
  outdated)
    # Simulate the pnpm behaviour that misses range updates when lockfile is behind.
    printf '%s\n' '{}'
    exit 0
    ;;
  list)
    # --depth 0 --json
    cat <<'JSON'
[
  {
    "name": "x",
    "path": ".",
    "dependencies": {
      "react": {"version": "19.2.5"},
      "react-dom": {"version": "19.2.5"}
    },
    "devDependencies": {
      "vite": {"version": "8.0.10"}
    }
  }
]
JSON
    exit 0
    ;;
  view)
    # pnpm view <pkg>[@<version>] version
    # npm_version_prefetch calls: pnpm view pkg@ver version
    pkg="${1:-}"
    field="${2:-}"
    if [[ "$field" != "version" ]]; then
      exit 2
    fi
    # Strip @version suffix so cases match both "react" and "react@19.2.6"
    pkg_name="${pkg%%@*}"
    case "$pkg_name" in
      react) echo "19.2.6"; exit 0 ;;
      react-dom) echo "19.2.6"; exit 0 ;;
      vite) echo "8.0.11"; exit 0 ;;
    esac
    exit 2
    ;;
  store)
    # store add <pkg>@<ver> — simulate a successful tarball fetch
    exit 0
    ;;
  --version|-v|version)
    echo "11.0.8"
    exit 0
    ;;
esac

echo "pnpm stub: unsupported args: $cmd $*" >&2
exit 2
EOF
chmod +x "${tmp_bin}/pnpm"

report_output=""
report_exit=0
set +e
report_output="$(env HOME="$tmp_home" PATH="${tmp_bin}:/usr/bin:/bin" \
  DEP_UPDATER_SKIP_NPM_REGISTRY=1 \
  "$script" --report-json --dir "$tmp_repo" 2>/dev/null)"
report_exit=$?
set -e

rm -rf "$tmp_home" "$tmp_repo"

assert_exit_0 "report-json (pnpm range updates)" "$report_output" "$report_exit"
if printf '%s' "$report_output" | jq -e '
  .updates
  | map(select(.ecosystem == "npm"))
  | map({package, from, to})
  | (any(.package=="react" and .from=="19.2.5" and .to=="19.2.6"))
    and (any(.package=="react-dom" and .from=="19.2.5" and .to=="19.2.6"))
    and (any(.package=="vite" and .from=="8.0.10" and .to=="8.0.11"))
' >/dev/null 2>&1; then
  printf '[PASS] report-json (pnpm range updates): detects react/react-dom/vite bumps\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] report-json (pnpm range updates): expected bumps missing\n'
  printf '       output:\n%s\n' "$report_output"
  fail=$(( fail + 1 ))
fi

