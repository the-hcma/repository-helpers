  && [[ "$(printf '%s\n' "$on_exit_body" | grep -n 'dep_updater_write_batch_child_report_json' | head -1 | cut -d: -f1)" \
       -lt "$(printf '%s\n' "$on_exit_body" | grep -nE 'cleanup_on_error "' | head -1 | cut -d: -f1)" ]]; then
