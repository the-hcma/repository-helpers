fi

finalize_body="$(awk '/^finalize_prs\(\)/,/^\}/' "$script")"
if grep -qF 'merge_prs_via_gh' <<<"$finalize_body" \
  && grep -qF 'maybe_label_top_pr_for_merge' <<<"$finalize_body" \
  && grep -qF 'poll_until_merged' <<<"$finalize_body"; then
  printf '[PASS] merge-via: finalize_prs dispatches gh and merge-queue paths\n'
