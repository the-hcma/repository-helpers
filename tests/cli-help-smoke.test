#!/usr/bin/env bash
# Smoke: every documented CLI tool prints --help (exit 0, usage-like output).
#
# Keeps the README Command-line tools catalog runnable without network or
# mutating git/systemd state.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="$(cd "${script_dir}/.." && pwd)"
readonly rh_root

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

# ASCII lexicographic by path (matches README tool catalogs).
cli_tools=(
  scripts/check-lockfile-drift
  scripts/check-merge-settings
  scripts/dep-updater
  scripts/dep-updater-batch-run
  scripts/dev/approve-pending-deployments
  scripts/dev/post-pr-submission-checks
  scripts/dev/pre-pr-checks
  scripts/dev/secret-scan
  scripts/dev/ship-and-review
  scripts/dev/start-development
  scripts/dev/submit-stack
  scripts/github-repo-lint
  scripts/grandfather-pnpm-release-age
  scripts/on-deploy
  scripts/setup-github-repo-lint
  scripts/setup-service
  scripts/show-services
  scripts/trigger-agent-review
  scripts/wait-for-agent-review
)
readonly cli_tools

printf '\n=== cli --help smoke ===\n'

rel=''
abs=''
help_out=''
help_exit=0
for rel in "${cli_tools[@]}"; do
  abs="${rh_root}/${rel}"
  help_out=''
  help_exit=0
  help_out="$(bash "$abs" --help 2>&1)" || help_exit=$?

  assert_exit_0 "${rel} --help exits 0" "$help_out" "$help_exit"
  if [[ -n "$help_out" ]]; then
    pass_case "${rel} --help prints output"
  else
    fail_case "${rel} --help prints output"
  fi
  # Accept Usage:/USAGE:/or the script basename as a smoke signal.
  if grep -qiE -- 'usage:|--help' <<<"$help_out" \
    || grep -qF -- "$(basename "$rel")" <<<"$help_out"; then
    pass_case "${rel} --help looks like usage text"
  else
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$help_out" >&2
    printf '%s\n' '--------------' >&2
    fail_case "${rel} --help looks like usage text"
  fi
done

# Static: list stays sorted (ASCII) so new tools insert in place.
printf '\n=== static: cli_tools list is ASCII-sorted ===\n'
sorted=''
sorted="$(printf '%s\n' "${cli_tools[@]}" | LC_ALL=C sort)"
if [[ "$(printf '%s\n' "${cli_tools[@]}")" == "$sorted" ]]; then
  pass_case "cli_tools array is ASCII lexicographic"
else
  fail_case "cli_tools array is ASCII lexicographic"
fi

test_summary "cli-help-smoke"
