#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

checker="${rh_root}/scripts/github-repo-lint"
lib="${rh_root}/scripts/lib/repo-practices"
merge_wrapper="${rh_root}/scripts/check-merge-settings"
templates_dir="${rh_root}/scripts/lib/repo-practices-workflows"
readonly checker lib merge_wrapper templates_dir

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
# shellcheck source=tests/lib/github-repo-lint-ci-mocks
source "${script_dir}/lib/github-repo-lint-ci-mocks"
grl_test_ci_secret_scan_init "$rh_root"
export GRL_LOCAL_B64="${grl_mock_pr_ship_rule_local_b64}"
export GRL_CONSUMER_B64="${grl_mock_pr_ship_rule_consumer_b64}"

pass=0
fail=0

printf '\n=== static: scripts and library ===\n'
if [[ -f "$checker" && -f "$lib" && -f "$merge_wrapper" ]]; then
  printf '[PASS] github-repo-lint, lib/repo-practices, and merge wrapper exist\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing github-repo-lint entrypoints\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_log_manual_step' "$lib" \
  && grep -qF 'rp_log_check_ok' "$lib" \
  && grep -qF 'rp_github_url' "$lib" \
  && grep -qF 'rp_print_final_status' "$lib" \
  && grep -qF 'rp_resolve_git_context_slug' "$lib" \
  && grep -qF 'rp_validate_workflow_file_extensions' "$lib" \
  && grep -qF 'rp_validate_branch_cleanup_workflows' "$lib" \
  && grep -qF 'rp_print_new_repo_checklist' "$lib" \
  && grep -qF 'rp_check_protect_main_ruleset' "$lib" \
  && grep -qF 'rp_check_classic_main_protection' "$lib" \
  && grep -qF 'rp_check_license_metadata' "$lib" \
  && grep -qF 'rp_check_pr_ship_and_review_rule' "$lib" \
  && grep -qF 'rp_pr_ship_and_review_rule_is_valid' "$lib" \
  && grep -qF 'repo-practices-cursor/pr-ship-and-review.mdc' "$lib" \
  && grep -qF 'rp_fetch_repo_license_file' "$lib" \
  && grep -qF 'rp_text_has_copyright_notice' "$lib" \
  && grep -qF 'rp_fetch_repo_codeowners_file' "$lib" \
  && grep -qF 'rp_apply_codeowners_pr' "$lib" \
  && grep -qF 'rp_apply_candidate_fix_stack' "$lib" \
  && grep -qF -- '--apply-fix|--apply' "$lib" \
  && grep -qF 'rp_authenticated_github_login' "$lib" \
  && grep -qF 'rp_discover_ci_status_contexts' "$lib" \
  && grep -qF 'rp_compact_print_report' "$lib" \
  && grep -qF 'rp_print_failure_summary' "$lib" \
  && grep -qF 'rp_track_failures' "$lib" \
  && grep -qF 'rp_repo_requires_protect_main_ruleset' "$lib" \
  && grep -qF 'rp_protect_main_create_payload' "$lib" \
  && grep -qF 'cleanup-merged-branches.yml' "$lib" \
  && grep -qF 'rp_cleanup_merged_branches_workflow_is_canonical' "$lib"; then
  printf '[PASS] library defines branch cleanup, metadata, CODEOWNERS, and checklist helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected branch cleanup and new-repo helpers in lib/repo-practices\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: repo-practices has no hardcoded consumer repo names ===\n'
if rp_assert_no_hardcoded_consumer_repo_names "$lib"; then
  printf '[PASS] repo-practices avoids hardcoded consumer org repo slugs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices contains hardcoded consumer org repo slugs\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: private repo discovery filter ===\n'
if grep -qF 'rp_include_private' "$lib" \
  && grep -qF 'include-private' "$lib" \
  && grep -qF 'select(.private == false)' "$lib" \
  && grep -qF 'GITHUB_REPO_LINT_INCLUDE_PRIVATE' "$lib" \
  && grep -qF 'github-repo-slug' "$lib"; then
  printf '[PASS] repo-practices skips private repos in org discovery by default\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected private-repo filter helpers in lib/repo-practices\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'gh_repo_is_private' "$checker" \
  && grep -qF 'Skipping private repository' "$checker" \
  && grep -qF 'rp_include_private=1' "$checker"; then
  printf '[PASS] github-repo-lint enforcer skips private local clones by default\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected enforcer private-repo skip in github-repo-lint\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_main' "$merge_wrapper" && grep -q 'merge-only' "$merge_wrapper"; then
  printf '[PASS] check-merge-settings delegates to repo-practices with --merge-only\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] check-merge-settings should source lib and pass --merge-only\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: workflow apply-fix prepares stacked candidate PRs ===\n'
if grep -qF 'rp_queue_candidate_file_fix' "$lib" \
  && grep -qF 'rp_candidate_cleanup_branch_on_merge_workflow' "$lib" \
  && grep -qF 'rp_candidate_cleanup_merged_branches_workflow' "$lib" \
  && grep -qF 'rp_candidate_merged_pr_closer_workflow' "$lib" \
  && grep -qF 'rp_candidate_dependabot_auto_merge_workflow' "$lib" \
  && grep -qF 'rp_candidate_secret_scan_script' "$lib" \
  && grep -qF 'rp_fix_ci_workflow_secret_scan_job' "$lib" \
  && grep -qF 'rp_check_ci_secret_scan_gitleaks_pin' "$lib" \
  && grep -qF 'rp_add_ci_secret_scan_job_to_workflow' "$lib" \
  && grep -qF 'rp_ci_workflow_has_secret_scan_coverage' "$lib" \
  && grep -qF 'ci.yml must include a secret-scan job' "$lib" \
  && grep -qF 'rp_ci_workflow_has_hardened_concurrency' "$lib" \
  && grep -qF 'rp_ci_workflow_secret_scan_job_is_canonical' "$lib" \
  && grep -qF 'ci-secret-scan-policy' "$lib" \
  && grep -qF 'ci-secret-scan' "$lib" \
  && grep -qF 'repo-practices-workflows' "$lib" \
  && grep -qF '.worktrees/repo-practices-candidate-fixes-wt' "$lib" \
  && grep -qF 'worktree add --detach' "$lib" \
  && grep -qF 'gt submit --publish --no-interactive' "$lib" \
  && grep -qF "gt track --parent \"\$parent_branch\"" "$lib"; then
  printf '[PASS] apply-fix: missing workflows are emitted through a stacked worktree\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] apply-fix: expected dedicated worktree and Graphite stack helpers\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: candidate workflow templates lint ===\n'
template_fail=0
lint_tmp="$(mktemp -d)"
for template in \
  cleanup-branch-on-merge.yml \
  cleanup-merged-branches.yml \
  dependabot-auto-merge.yml \
  merged-pr-closer.yml; do
  template_path="${templates_dir}/${template}"
  run_block="${lint_tmp}/${template}.bash"
  if [[ ! -f "$template_path" ]]; then
    printf '[FAIL] workflow-template: missing %s\n' "$template"
    template_fail=1
    continue
  fi
  if grep -q $'\t' "$template_path" \
    || ! grep -q '^name:' "$template_path" \
    || ! grep -q '^on:' "$template_path" \
    || ! grep -q '^permissions:' "$template_path" \
    || ! grep -q '^jobs:' "$template_path"; then
    printf '[FAIL] workflow-template: malformed %s\n' "$template"
    template_fail=1
    continue
  fi
  awk '
    /^[[:space:]]*run: \|[[:space:]]*$/ {
      in_run = 1
      next
    }
    in_run {
      if ($0 ~ /^          /) {
        sub(/^          /, "")
        print
        next
      }
      if ($0 ~ /^[[:space:]]*$/) {
        print ""
        next
      }
      in_run = 0
    }
  ' "$template_path" >"$run_block"
  if [[ -s "$run_block" ]] && ! bash -n "$run_block"; then
    printf '[FAIL] workflow-template: run block is not valid bash in %s\n' "$template"
    template_fail=1
  fi
done
rm -rf "$lint_tmp"
if [[ "$template_fail" -eq 0 ]]; then
  printf '[PASS] workflow-template: candidates have required keys and valid run blocks\n'
  pass=$(( pass + 1 ))
else
  fail=$(( fail + 1 ))
fi

printf '\n=== static: cleanup-merged-branches deletes Graphite MQ branches ===\n'
gtmq_template="${templates_dir}/cleanup-merged-branches.yml"
if grep -qF 'gtmq_batch_' "$gtmq_template" \
  && grep -qF 'gtmq_merge_' "$gtmq_template" \
  && grep -qF 'gtmq_base_no_ci_batch_' "$gtmq_template" \
  && grep -qF 'graphite-base/*' "$gtmq_template" \
  && grep -qF 'repo-practices/*' "$gtmq_template" \
  && grep -qF "7 days ago" "$gtmq_template" \
  && grep -qF 'delete_branch_ref' "$gtmq_template" \
  && grep -qF 'is_graphite_mq_branch' "$gtmq_template"; then
  printf '[PASS] cleanup-merged-branches template sweeps Graphite ephemeral branches\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cleanup-merged-branches template missing Graphite ephemeral branch sweep\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: merged-pr-closer closes stale Graphite MQ drafts ===\n'
closer_template="${templates_dir}/merged-pr-closer.yml"
if grep -qF 'gtmq_batch_' "$closer_template" \
  && grep -qF '[Graphite MQ] Draft PR GROUP' "$closer_template" \
  && grep -qE '^  push:' "$closer_template" \
  && grep -qF 'graphite-app' "$closer_template" \
  && grep -qF 'Graphite merge queue' "$closer_template" \
  && grep -qF 'delete_head_branch' "$closer_template" \
  && grep -qF 'contents: write' "$closer_template"; then
  printf '[PASS] merged-pr-closer template closes stale Graphite MQ draft group PRs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merged-pr-closer template missing stale Graphite MQ draft cleanup\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'rp_merged_pr_closer_workflow_has_push_to_main_trigger' "$lib" \
  && grep -qF 'rp_merged_pr_closer_workflow_has_mq_draft_cleanup' "$lib" \
  && grep -qF 'rp_merged_pr_closer_workflow_deletes_head_branch' "$lib" \
  && grep -qF 'merged-pr-closer.yml must run on main push, close stale Graphite MQ drafts, and delete head branches' "$lib"; then
  printf '[PASS] repo-practices lint enforces stale Graphite MQ draft cleanup\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices should lint merged-pr-closer MQ draft cleanup\n'
  fail=$(( fail + 1 ))
fi

legacy_closer='name: Close Graphite-Merged PRs
on:
  issue_comment:
    types: [created]
'
if grep -qF 'gtmq_batch_' <<<"$legacy_closer"; then
  printf '[FAIL] legacy comment-trigger closer should not pass MQ draft cleanup check\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] legacy comment-trigger closer lacks MQ draft cleanup markers\n'
  pass=$(( pass + 1 ))
fi

printf '\n=== functional: --merge-only skips branch cleanup failure ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/sparse-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$merge_wrapper" --repo the-hcma/sparse-repo 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] && ! grep -qF 'branch cleanup' <<<"$output"; then
  printf '[PASS] --merge-only does not require branch cleanup workflows\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] merge-only should skip branch cleanup (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: full check fails without branch cleanup workflows ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'release-please.yml'* ]]; then
  exit 1
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":""}'
  exit 0
fi
if [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_CONSUMER_B64}\"}"
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'cleanup-branch-on-merge.yml' <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] full audit fails branch cleanup and prints SUGGEST lines\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected branch cleanup FAIL with SUGGEST (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== static: release-age policy lint uses release-age-defaults ===\n'
defaults="${rh_root}/scripts/lib/release-age-defaults"
# shellcheck disable=SC1090,SC1091
source "$defaults"
# shellcheck disable=SC2016  # grep for literal strings in the library under test
if grep -qF 'source "${rp_lib_dir}/release-age-defaults"' "$lib" \
  && grep -q '^rp_dependabot_has_release_age_cooldown()' "$lib" \
  && grep -q '^rp_check_dependabot_release_age_policy()' "$lib" \
  && grep -q '^rp_check_pnpm_release_age_policy()' "$lib" \
  && grep -qF 'required_days="$release_age_dependabot_days"' "$lib" \
  && grep -qF 'required_minutes="$release_age_dep_updater_minutes"' "$lib" \
  && ! grep -q 'rp_dependabot_has_npm_cooldown_10_days' "$lib"; then
  printf '[PASS] repo-practices: dependabot and pnpm release-age checks source release-age-defaults\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] repo-practices: expected dependabot/pnpm release-age lint wired to release-age-defaults\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: dependabot cooldown enforced ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":""}'
  exit 0
fi
if [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/dependabot.yml'* ]]; then
  # dependabot.yml without cooldown -> should fail
  printf '%s\n' '{"content":"dmVyc2lvbjogMgp1cGRhdGVzOgogIC0gcGFja2FnZS1lY29zeXN0ZW06ICJucG0iCiAgICBkaXJlY3Rvcnk6ICIvIgogICAgc2NoZWR1bGU6CiAgICAgIGludGVydmFsOiAid2Vla2x5Igo="}'
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  if [[ "$args" == *'repository-helpers'* ]]; then
    printf '%s\n' "{\"content\":\"${GRL_LOCAL_B64}\"}"
  else
    printf '%s\n' "{\"content\":\"${GRL_CONSUMER_B64}\"}"
  fi
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

# shellcheck disable=SC2154  # set by scripts/lib/release-age-defaults (sourced above)
if [[ "$exit_code" -ne 0 ]] \
  && grep -qF "dependabot.yml must set cooldown default-days: ${release_age_dependabot_days} on every updates entry" <<<"$output" \
  && grep -qF "one day after dep-updater ${release_age_dep_updater_days}-day gate" <<<"$output" \
  && grep -qF 'SUGGEST:' <<<"$output"; then
  printf '[PASS] dependabot-cooldown: missing cooldown fails with suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dependabot-cooldown: expected failure and suggestion (exit=%s)\n%s\n' "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: dependabot cooldown required on every ecosystem entry ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":""}'
  exit 0
fi
if [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/dependabot.yml'* ]]; then
  # npm has cooldown; cargo entry does not
  printf '%s\n' '{"content":""}'
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  if [[ "$args" == *'repository-helpers'* ]]; then
    printf '%s\n' "{\"content\":\"${GRL_LOCAL_B64}\"}"
  else
    printf '%s\n' "{\"content\":\"${GRL_CONSUMER_B64}\"}"
  fi
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" --repo the-hcma/mq-repo --suggest 2>&1)"
exit_code=$?
set -e

# shellcheck disable=SC2154  # set by scripts/lib/release-age-defaults (sourced above)
if [[ "$exit_code" -ne 0 ]] \
  && grep -qF "dependabot.yml must set cooldown default-days: ${release_age_dependabot_days} on every updates entry" <<<"$output"; then
  printf '[PASS] dependabot-cooldown: cargo entry without cooldown fails when npm has cooldown\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dependabot-cooldown: expected failure when any ecosystem entry lacks cooldown (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: dependabot cooldown rejects wrong default-days ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/mq-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'merged-pr-closer.yml'* ]]; then
  printf '%s\n' '{"content":""}'
  exit 0
fi
if [[ "$args" == *'ci.yml'* && "$args" == *contents* ]]; then
  printf '%s\n' '{"content":"Z3RtcV9tZXJnZV8q"}'
  exit 0
