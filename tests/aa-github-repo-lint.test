    fi
    if rp_pr_ship_has_graphite_only_submit_snippet "$gh_stack_rendered"; then
      printf "gh_stack_template_still_graphite_only\n"
      exit 1
    fi
    if ! grep -qE "^gt create " <<<"$graphite_rendered" \
      || ! grep -qE "^# gh stack init" <<<"$graphite_rendered"; then
      printf "graphite_template_submit_block\n"
      exit 1
    fi
    if ! grep -qE "^# gt create " <<<"$gh_stack_rendered" \
      || ! grep -qE "^gh stack init" <<<"$gh_stack_rendered" \
      || ! grep -qE "^gh stack submit" <<<"$gh_stack_rendered"; then
      printf "gh_stack_template_submit_block\n"
      exit 1
    fi
    if ! rp_pr_ship_and_review_rule_is_valid "$graphite_rendered" "the-hcma/example-repo" \
      || ! rp_pr_ship_and_review_rule_is_valid "$gh_stack_rendered" "the-hcma/example-repo"; then
      printf "rendered_template_invalid\n"
      exit 1
    fi
    printf "ok\n"
  ' bash "$lib" graphite gh-stack
)" || pr_ship_marker_unit_out="fail:${pr_ship_marker_unit_out}"
