cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/repository-helpers --suggest 2>&1)"
exit_code=$?
set -e

if [[ "$exit_code" -ne 0 ]] \
  && grep -qF 'workflow ci.yaml must use the standard .yml extension' <<<"$output" \
  && grep -qF 'rename .github/workflows/ci.yaml to .github/workflows/ci.yml' \
    <<<"$output"; then
  printf '[PASS] workflow-extension: .yaml workflows fail with rename suggestion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] workflow-extension: expected .yaml failure and suggestion (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: missing workflows directory avoids jq error ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '["merge-it"]'
  exit 0
fi
if [[ "$args" == *'contents/.github/workflows' ]] && [[ "$args" != *'/contents/.github/workflows/'* ]]; then
  printf '%s\n' '{"message":"Not Found","documentation_url":"https://docs.github.com/rest/repos/contents#get-repository-content","status":"404"}'
  exit 0
fi
if [[ "$args" == *'contents/'* ]]; then
  exit 1
fi
if [[ "$args" == *'/rulesets'* ]]; then
  exit 1
fi
if [[ "$args" == *'/branches/main/protection'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/empty-repo --suggest 2>&1)"
exit_code=$?
set -e

if ! grep -qF 'Cannot index string with string "type"' <<<"$output" \
  && grep -qF 'workflow file extensions (.yml)' <<<"$output"; then
  printf '[PASS] workflow-listing: API error JSON does not crash jq\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] workflow-listing: expected no jq type error (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: apply-fix emits workflow stack from local clone ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
target_repo="${mock_dir}/target"
target_wt="${target_repo}/.worktrees/repo-practices-candidate-fixes-wt"
gt_log="${mock_dir}/gt.log"
mkdir -p "$mock_bin" "$target_repo"

git -C "$target_repo" init --initial-branch=main -q
git -C "$target_repo" config user.name repo-practices-test
git -C "$target_repo" config user.email repo-practices-test@example.com
printf 'target\n' >"${target_repo}/README.md"
git -C "$target_repo" add README.md
git -C "$target_repo" commit -q -m 'chore: init'
git -C "$target_repo" remote add origin https://github.com/the-hcma/target.git
git -C "$target_repo" update-ref refs/remotes/origin/main HEAD
mkdir -p "${target_repo}/.worktrees"
git -C "$target_repo" worktree add -q "$target_wt" HEAD

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'api repos/the-hcma/target --jq .default_branch'* ]]; then
  printf 'main\n'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/gt" <<'MOCK_GT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s :: %s\n' "$PWD" "$*" >>"${GT_LOG:?}"
MOCK_GT
chmod +x "${mock_bin}/gt"

cat >"${mock_dir}/run-candidate-stack" <<EOF
#!/usr/bin/env bash
set -euo pipefail
# shellcheck disable=SC1091
source "${lib}"
rp_apply_fix=1
rp_queue_candidate_file_fix 'the-hcma/target' \
  '.github/workflows/cleanup-branch-on-merge.yml' \
  "\$(rp_candidate_cleanup_branch_on_merge_workflow)" \
  'add-cleanup-branch-on-merge' \
  'chore: add branch cleanup workflow'
rp_apply_candidate_fix_stack 'the-hcma/target'
EOF
chmod +x "${mock_dir}/run-candidate-stack"

set +e
output="$(
  cd "$target_repo" \
    && PATH="${mock_bin}:${PATH}" GT_LOG="$gt_log" "${mock_dir}/run-candidate-stack" 2>&1
)"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]] \
  && [[ -f "${target_wt}/.github/workflows/cleanup-branch-on-merge.yml" ]] \
  && grep -qF 'Delete merged PR branch' \
    "${target_wt}/.github/workflows/cleanup-branch-on-merge.yml" \
  && grep -qF 'track --parent main' "$gt_log" \
  && grep -qF 'submit --publish --no-interactive' "$gt_log" \
  && grep -qF 'created candidate branch repo-practices/add-cleanup-branch-on-merge' \
    <<<"$output"; then
  printf '[PASS] apply-fix: local clone gets candidate worktree and Graphite stack\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] apply-fix: expected candidate worktree stack (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: org discovery skips private repos by default ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'orgs/the-hcma/repos'* && "$args" == *'private == false'* ]]; then
  printf '%s\n' 'public-repo'
  exit 0
fi
if [[ "$args" == *'orgs/the-hcma/repos'* ]]; then
  printf '%s\n' 'public-repo'
  printf '%s\n' 'private-repo'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

discovered=""
discovered="$(PATH="${mock_bin}:${PATH}" bash -c "
  # shellcheck disable=SC1091
  source '${lib}'
  rp_include_private=0
  rp_discover_org_repos the-hcma
")"

if [[ "$discovered" == $'public-repo' ]]; then
  printf '[PASS] rp_discover_org_repos excludes private repos by default\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected only public-repo from org discovery (got %q)\n' "$discovered"
  fail=$(( fail + 1 ))
fi

discovered_all=""
discovered_all="$(PATH="${mock_bin}:${PATH}" bash -c "
  # shellcheck disable=SC1091
  source '${lib}'
  rp_include_private=1
  rp_discover_org_repos the-hcma
")"

if [[ "$discovered_all" == $'public-repo\nprivate-repo' ]] \
  || [[ "$discovered_all" == $'public-repo'$'\n''private-repo' ]]; then
  printf '[PASS] rp_discover_org_repos includes private repos with --include-private\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected public and private repos with include-private (got %q)\n' "$discovered_all"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

