printf '\n=== static: pr-ship apply-fix queues candidate branch ===\n'
if grep -qF 'add-pr-ship-and-review' "$lib" \
  && grep -qF 'sync-pr-ship-and-review' "$lib" \
  && grep -qF 'rp_pr_ship_and_review_rule_template' "$lib"; then
