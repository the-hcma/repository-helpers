if [[ "$cve_list_exit" -ne 0 ]] \
  && ! grep -qF 'should not create on list failure' <<<"$cve_list_output"; then
  printf '[PASS] cve-check template exits non-zero when gh issue list fails\n'
  pass=$(( pass + 1 ))
else
