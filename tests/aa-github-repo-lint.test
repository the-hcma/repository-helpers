          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='\''example-pkg'\'')].version"
        }
      ]
    }
  }
}'
bad_placeholder_config='{
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='\''<project.name>'\'')].version"
        }
      ]
