#!/usr/bin/env bash
# Tests for scripts/grandfather-pnpm-release-age (cutover wildcard only).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

lib="${rh_root}/scripts/lib/pnpm-release-age"
grandfather="${rh_root}/scripts/grandfather-pnpm-release-age"
readonly lib grandfather

pass=0
fail=0

# shellcheck disable=SC1090,SC1091
source "$lib"

printf '\n=== static: scripts exist; prune removed ===\n'
if [[ -f "$lib" && -f "$grandfather" ]]; then
  printf '[PASS] grandfather script and library are present\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing grandfather script or library\n'
  fail=$(( fail + 1 ))
fi
if [[ ! -f "${rh_root}/scripts/prune-pnpm-release-age-grandfather" ]]; then
  printf '[PASS] prune-pnpm-release-age-grandfather was removed\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] prune script should be removed for cutover-only policy\n'
  fail=$(( fail + 1 ))
fi
if ! grep -qE -- '--tracked|--wildcard|grandfather\.tsv' "$grandfather"; then
  printf '[PASS] grandfather script has no TSV or tracked-mode options\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] grandfather script should not reference TSV or --tracked\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: writes wildcard workspace yaml ===\n'
tmp_repo="$(mktemp -d)"
printf 'lockfileVersion: 9.0\n\npackages:\n\nsnapshots:\n' >"${tmp_repo}/pnpm-lock.yaml"
printf '  sample@1.0.0:\n    resolution: {integrity: x}\n' >>"${tmp_repo}/pnpm-lock.yaml"
bash "$grandfather" "$tmp_repo" >/dev/null
if grep -q 'minimumReleaseAge: 14400' "${tmp_repo}/pnpm-workspace.yaml" \
  && grep -qF '  - "*"' "${tmp_repo}/pnpm-workspace.yaml"; then
  printf '[PASS] grandfather writes minimumReleaseAge and wildcard exclude\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected minimumReleaseAge 14400 and exclude "*"\n'
  fail=$(( fail + 1 ))
fi
if [[ ! -f "${tmp_repo}/pnpm-release-age-grandfather.tsv" ]]; then
  printf '[PASS] grandfather does not create a TSV registry file\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] grandfather must not write pnpm-release-age-grandfather.tsv\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== functional: preserves allowBuilds block ===\n'
tmp_repo="$(mktemp -d)"
printf 'lockfileVersion: 9.0\n\npackages:\n\nsnapshots:\n' >"${tmp_repo}/pnpm-lock.yaml"
printf '  x@1.0.0:\n    resolution: {integrity: x}\n' >>"${tmp_repo}/pnpm-lock.yaml"
{
  printf '%s\n' 'packages:'
  printf '%s\n' "  - '.'"
  printf '%s\n' 'allowBuilds:'
  printf '%s\n' '  esbuild: true'
} >"${tmp_repo}/pnpm-workspace.yaml"
bash "$grandfather" "$tmp_repo" >/dev/null
if grep -q '^allowBuilds:' "${tmp_repo}/pnpm-workspace.yaml" \
  && grep -q 'esbuild: true' "${tmp_repo}/pnpm-workspace.yaml" \
  && grep -qF '  - "*"' "${tmp_repo}/pnpm-workspace.yaml"; then
  printf '[PASS] grandfather preserves allowBuilds and writes wildcard exclude\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] allowBuilds block missing or duplicate excludes in workspace yaml\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
