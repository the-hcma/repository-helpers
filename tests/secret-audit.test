#!/usr/bin/env bash
# Tests for scripts/secret-audit and scripts/lib/secret-audit.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

entry="${rh_root}/scripts/secret-audit"
lib="${rh_root}/scripts/lib/secret-audit"
readonly entry lib

pass=0
fail=0

pass_case() {
  printf '[PASS] %s\n' "$1"
  pass=$((pass + 1))
}

fail_case() {
  printf '[FAIL] %s\n' "$1"
  fail=$((fail + 1))
}

printf '\n=== static: entrypoints ===\n'
if [[ -f "$entry" && -f "$lib" ]]; then
  pass_case 'secret-audit script and library exist'
else
  fail_case 'missing secret-audit entrypoints'
fi

printf '\n=== static: trufflehog contract ===\n'
# shellcheck disable=SC2016  # assert literal pin and flag strings in source
if grep -qF "secret_audit_trufflehog_version='3.97.0'" "$lib" \
  && grep -qF 'secret_audit_trufflehog_leak_exit=183' "$lib" \
  && grep -qF 'ERROR: SECRET_AUDIT_LEAK' "$lib" \
  && grep -qF 'ERROR: SECRET_AUDIT_SCAN_FAILED' "$lib" \
  && grep -qF -- '--no-update' "$lib" \
  && grep -qF 'secret_audit_intake_ledger_default' "$lib" \
  && grep -qF 'secret-audit-intake.json' "$lib"; then
  pass_case 'trufflehog pin, --no-update, GITHUB_TOKEN env (never --token argv), errors present'
else
  fail_case 'trufflehog contract incomplete in secret-audit lib'
fi

printf '\n=== static: in-repo release SHA-256 pins (not release checksums.txt) ===\n'
# shellcheck disable=SC2016  # assert literal digests and helper names in source
if grep -qF 'secret_audit_trufflehog_pinned_sha256' "$lib" \
  && grep -qF '037e4aeb197870555ff515432bb5f1f2c98dce5f1214631a689112b5e0e4c9fd' "$lib" \
  && grep -qF 'ad0a99bd48d6df80eabab24d11d0fd771e245fc55ed347f943cafb5e5f497c5c' "$lib" \
  && grep -qF '62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4' "$lib" \
  && grep -qF 'f48f57e3d4343377865b1b64653f96d381d61a7792d89d026e85524732039fde' "$lib" \
  && ! grep -qE 'trufflehog_\$\{version\}_checksums|releases/download/.*/.*_checksums' "$lib" \
  && grep -qF 'tooling_path_ensure_gnu_userland' "$entry" \
  && grep -qF 'sha256sum required' "$lib"; then
  pass_case 'release asset SHA-256 pinned in-repo; CLI ensures GNU sha256sum'
else
  fail_case 'missing in-repo SHA-256 pins or GNU sha256sum gate'
fi

printf '\n=== static: gh auth token not captured via runner_exec_stdout ===\n'
# shellcheck disable=SC2016  # assert helper wiring literals
if grep -qF 'secret_audit_resolve_github_token' "$lib" \
  && grep -qF 'gh auth token >"$1"' "$lib" \
  && ! grep -qE 'runner_exec_stdout.*"secret-audit gh auth token"' "$lib"; then
  pass_case 'gh auth token written to 0600 tempfile, not runner stdout artifact'
else
  fail_case 'gh auth token must not use runner_exec_stdout capture'
fi

printf '\n=== static: intake recorded only after a clean scan ===\n'
# shellcheck disable=SC2016  # assert control-flow literals in CLI source
if grep -qF 'secret_audit_run_git_scan' "$entry" \
  && grep -qF 'sa_record_intake' "$entry" \
  && awk '
    /secret_audit_run_git_scan/ { scan=NR }
    /sa_record_intake/ { rec=NR }
    END { exit !(scan && rec && rec > scan) }
  ' "$entry" \
  && grep -qF 'if (( scan_rc != 0 )); then' "$entry" \
  && ! grep -qF 'secret_audit_write_marker' "$entry"; then
  pass_case 'CLI records intake only after a successful scan; no working-tree marker write'
else
  fail_case 'intake recording is not gated on clean scan_rc (or still writes a marker file)'
fi

sa_all_fn="$(awk '
  /^sa_scan_all_repos\(\)/ { keep=1 }
  keep { print }
  keep && /^}/ { exit }
' "$entry")"

printf '\n=== static: plain --all uses the fast aggregate org scan and returns its exit ===\n'
# shellcheck disable=SC2016  # grep for literal identifiers in CLI source
if grep -qF 'secret_audit_run_github_org_scan "$sa_org"' <<<"$sa_all_fn" \
  && awk '
    /secret_audit_run_github_org_scan/ { org=NR }
    /return "\$org_rc"/ { if (org && !ret) ret=NR }
    /sa_write_marker.*-ne 1/ { if (ret && !skip) skip=NR }
    /return 0/ { if (skip && !plain_ret) plain_ret=NR }
    END { exit !(org && ret && skip && plain_ret && org < ret && ret < skip && skip < plain_ret) }
  ' <<<"$sa_all_fn"; then
  pass_case 'plain --all -> one trufflehog github --org sweep; its exit returned; !write-marker returns 0'
else
  fail_case 'plain --all no longer does the fast aggregate org sweep'
fi

printf '\n=== static: --all --write-marker = aggregate sweep (exit) + best-effort per-repo refresh ===\n'
# shellcheck disable=SC2016  # grep for literal identifiers (incl. $sa_org / $slug) in CLI source
if grep -qF 'secret_audit_run_github_org_scan "$sa_org"' <<<"$sa_all_fn" \
  && grep -qF 'sa_scan_one_repo "$slug"' <<<"$sa_all_fn" \
  && awk '
    /secret_audit_run_github_org_scan/ { org=NR }
    /return "\$org_rc"/ { if (org && !ret) ret=NR }
    /sa_scan_one_repo/ { if (ret && !loop) loop=NR }
    END { exit !(org && ret && loop && ret < loop) }
  ' <<<"$sa_all_fn" \
  && grep -qF 'SECRET_AUDIT_SCAN_FAILED could not list repos' <<<"$sa_all_fn" \
  && grep -qF '0 repos attested' <<<"$sa_all_fn" \
  && ! grep -qF 'secret_audit_ledger_upsert' <<<"$sa_all_fn"; then
  pass_case '--all --write-marker: org sweep drives exit; per-repo refresh is best-effort; discovery failure fails the run'
else
  fail_case '--all --write-marker exit no longer driven by the aggregate sweep, or discovery failure not detected'
fi

printf '\n=== static: ledger writes route external commands through the runner ===\n'
# shellcheck disable=SC2016  # assert literal command forms in lib source
if grep -qF 'ledger_dir="${ledger%/*}"' "$lib" \
  && grep -qF 'runner_exec "secret-audit mkdir ledger dir"' "$lib" \
  && grep -qF 'runner_exec "secret-audit mv ledger into place"' "$lib" \
  && ! grep -qE '^\s*mkdir -p "\$ledger_dir"' "$lib" \
  && ! grep -qE '^\s*mv -f "\$tmp"' "$lib" \
  && ! grep -qF "sed -n '2,21p'" "$entry"; then
  pass_case 'dirname via parameter expansion; mkdir/mv via runner_exec; usage() is a bash loop (no sed)'
else
  fail_case 'ledger upsert still shells out to bare dirname/mkdir/mv (or usage() still pipes sed)'
fi

# shellcheck disable=SC1090,SC1091
source "${rh_root}/scripts/lib/runner-bootstrap"
# shellcheck disable=SC1090,SC1091
source "$lib"

fresh_entry() {
  jq -nc --arg scanned_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{
      status: "clean",
      scanned_at: $scanned_at,
      scanner: "trufflehog",
      scanner_version: "3.97.0",
      results_filter: "verified"
    } + (if $ARGS.positional | length > 0 then {git_tip: $ARGS.positional[0]} else {} end)' \
    --args "$@"
}

printf '\n=== intake entry validation: fresh (with + without git_tip) ===\n'
valid_entry="$(fresh_entry 'abc1234567890abcdef1234567890abcdef1234')"
no_tip_entry="$(fresh_entry)"
if secret_audit_validate_intake_entry "$valid_entry" \
  && secret_audit_validate_intake_entry "$no_tip_entry"; then
  pass_case 'fresh intake entry valid; git_tip is optional'
else
  fail_case 'fresh intake entry (or git_tip-less entry) rejected'
fi

printf '\n=== intake entry validation: wrong status / missing field / non-object ===\n'
bad_ok=1
if secret_audit_validate_intake_entry "$(jq '.status = "dirty"' <<<"$valid_entry")" 2>/dev/null; then
  bad_ok=0; fail_case 'non-clean status accepted'
fi
if secret_audit_validate_intake_entry "$(jq 'del(.results_filter)' <<<"$valid_entry")" 2>/dev/null; then
  bad_ok=0; fail_case 'missing results_filter accepted'
fi
for non_object in '[]' 'null' '123' '"x"'; do
  if secret_audit_validate_intake_entry "$non_object" 2>/dev/null; then
    bad_ok=0; fail_case "non-object entry accepted: ${non_object}"
  fi
done
if [[ "$bad_ok" -eq 1 ]]; then
  pass_case 'bad status / missing field / non-object entries rejected without crashing'
fi

printf '\n=== intake entry validation: future / near-future / stale scanned_at ===\n'
time_ok=1
future_entry="$(jq '.scanned_at = "2099-01-01T00:00:00Z"' <<<"$valid_entry")"
if secret_audit_validate_intake_entry "$future_entry" 2>/dev/null; then
  time_ok=0; fail_case 'future scanned_at accepted'
fi
near_epoch=$(( $(time_log_now_utc_epoch) + 12 * 3600 ))
if ! near_future_at="$(date -u -d "@${near_epoch}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"; then
  near_future_at="$(date -u -r "${near_epoch}" +%Y-%m-%dT%H:%M:%SZ)"
fi
if secret_audit_validate_intake_entry "$(jq --arg s "$near_future_at" '.scanned_at = $s' <<<"$valid_entry")" 2>/dev/null; then
  time_ok=0; fail_case 'near-future (<24h) scanned_at accepted (day-math truncation bug)'
fi
if secret_audit_validate_intake_entry "$(jq '.scanned_at = "2020-01-01T00:00:00Z"' <<<"$valid_entry")" 2>/dev/null; then
  time_ok=0; fail_case 'stale scanned_at accepted'
fi
if [[ "$time_ok" -eq 1 ]]; then
  pass_case 'future / near-future / >90d scanned_at all rejected (epoch compare)'
fi

printf '\n=== functional: ledger upsert + entry lookup ===\n'
ledger_out="$(
  bash -c '
    set -uo pipefail
    export SECRET_AUDIT_LIB_ONLY=1
    # shellcheck disable=SC1090
    source "$1"; source "$2"; source "$3"
    set +e
    L="$(mktemp -u)"; export SECRET_AUDIT_INTAKE_LEDGER="$L"
    trap '\''rm -f "$L" "$L".tmp.*'\'' EXIT

    rc=0; secret_audit_ledger_entry the-hcma/x >/dev/null 2>&1 || rc=$?
    [[ $rc -eq 1 ]] || { echo "no_file_rc:$rc"; exit 1; }
    secret_audit_ledger_upsert the-hcma/zebra deadbeefcafe verified || { echo upsert1; exit 1; }
    secret_audit_ledger_upsert the-hcma/alpha "" verified || { echo upsert2; exit 1; }
    [[ -f "$L" ]] || { echo no_ledger_written; exit 1; }
    keys="$(jq -rc ".repos|keys" "$L")"
    [[ "$keys" == "[\"the-hcma/alpha\",\"the-hcma/zebra\"]" ]] || { echo "unsorted:$keys"; exit 1; }
    jq -e ".repos[\"the-hcma/zebra\"].git_tip == \"deadbeefcafe\"" "$L" >/dev/null || { echo tip_missing; exit 1; }
    jq -e ".repos[\"the-hcma/alpha\"]|has(\"git_tip\")|not" "$L" >/dev/null || { echo tip_should_be_absent; exit 1; }
    rc=0; secret_audit_ledger_entry the-hcma/nope >/dev/null 2>&1 || rc=$?
    [[ $rc -eq 2 ]] || { echo "missing_entry_rc:$rc"; exit 1; }
    got="$(secret_audit_ledger_entry the-hcma/zebra)"
    secret_audit_validate_intake_entry "$got" || { echo roundtrip_invalid; exit 1; }
    secret_audit_ledger_upsert the-hcma/zebra "" verified || { echo upsert3; exit 1; }
    [[ "$(jq -r ".repos|length" "$L")" == "2" ]] || { echo dup_key; exit 1; }
    # corrupt ledger -> entry lookup rc 3; upsert refuses (secret_audit_die, no wipe)
    printf "not json {{{" > "$L"
    rc=0; secret_audit_ledger_entry the-hcma/zebra >/dev/null 2>&1 || rc=$?
    [[ $rc -eq 3 ]] || { echo "corrupt_rc:$rc"; exit 1; }
    rc=0; ( secret_audit_ledger_upsert the-hcma/new "" verified ) >/dev/null 2>&1 || rc=$?
    [[ $rc -ne 0 ]] || { echo "corrupt_upsert_swallowed"; exit 1; }
    grep -qF "{{{" "$L" || { echo "corrupt_ledger_clobbered"; exit 1; }
    printf "ok\n"
  ' bash "${rh_root}/scripts/lib/runner-bootstrap" "$lib" "$entry"
)" || ledger_out="fail:${ledger_out}"
if [[ "$ledger_out" == 'ok' ]]; then
  pass_case 'ledger: sorted atomic write; entry lookup 0/1/2/3; corrupt ledger -> rc 3 + upsert refuses (no wipe)'
else
  fail_case "ledger upsert/lookup behaviour (${ledger_out})"
fi

printf '\n=== static: org scan excludes archived; optional concurrency ===\n'
# shellcheck disable=SC2016  # assert literal flag / helper names in lib source
if grep -qF 'secret_audit_append_trufflehog_global_flags' "$lib" \
  && grep -qF -- '--exclude-archived' "$lib" \
  && grep -qF 'SECRET_AUDIT_CONCURRENCY' "$lib" \
  && grep -qF -- '--concurrency=' "$lib"; then
  pass_case 'org scan uses --exclude-archived; concurrency via SECRET_AUDIT_CONCURRENCY'
else
  fail_case 'missing --exclude-archived or concurrency wiring in secret-audit lib'
fi

printf '\n=== static: --all excludes archived from intake-ledger discovery ===\n'
# shellcheck disable=SC2016
if grep -qF 'rp_exclude_archived=1' "$entry" \
  && grep -qF 'rp_exclude_archived' "${rh_root}/scripts/lib/repo-practices" \
  && grep -qF '.archived == false' "${rh_root}/scripts/lib/repo-practices"; then
  pass_case '--all sets rp_exclude_archived for intake-ledger discovery'
else
  fail_case 'intake-ledger refresh missing archived exclusion'
fi

batch="${rh_root}/scripts/secret-audit-batch-run"
readonly batch

printf '\n=== functional: batch_safe_scan_stats parses JSON and key=value logs ===\n'
stats_tmp="$(mktemp)"
cat >"$stats_tmp" <<'EOF'
2026-08-25T14:33:06-04:00	info-0	trufflehog	Completed enumeration	{"num_repos": 12}
2026-08-25T14:33:13-04:00	info-0	trufflehog	finished scanning	{"verified_secrets": 0, "unverified_secrets": 1, "scan_duration": "19.2s"}
EOF
stats_out=""
stats_out="$(
  bash <<EOF
set -euo pipefail
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
batch_safe_scan_stats '$stats_tmp'
EOF
)"
rm -f "$stats_tmp"
if grep -qF 'num_repos=12' <<<"$stats_out" \
  && grep -qF 'verified_secrets=0' <<<"$stats_out" \
  && grep -qF 'unverified_secrets=1' <<<"$stats_out" \
  && grep -qF 'scan_duration=19.2s' <<<"$stats_out"; then
  pass_case 'batch_safe_scan_stats parses logrus JSON fields'
else
  fail_case "batch_safe_scan_stats JSON parse failed: ${stats_out}"
fi

stats_tmp="$(mktemp)"
cat >"$stats_tmp" <<'EOF'
Completed enumeration num_repos=7
finished scanning verified_secrets=2 unverified_secrets=3 scan_duration=8.5s
EOF
stats_out="$(
  bash <<EOF
set -euo pipefail
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
batch_safe_scan_stats '$stats_tmp'
EOF
)"
rm -f "$stats_tmp"
if grep -qF 'num_repos=7' <<<"$stats_out" \
  && grep -qF 'verified_secrets=2' <<<"$stats_out" \
  && grep -qF 'unverified_secrets=3' <<<"$stats_out" \
  && grep -qF 'scan_duration=8.5s' <<<"$stats_out"; then
  pass_case 'batch_safe_scan_stats parses key=value text fields'
else
  fail_case "batch_safe_scan_stats key=value parse failed: ${stats_out}"
fi

printf '\n=== functional: batch_format_scan_duration rounds to two decimals ===\n'
fmt_out=""
fmt_out="$(
  bash <<EOF
set -euo pipefail
$(sed -n '/^batch_format_scan_duration()/,/^}/p' "$batch")
batch_format_scan_duration '6.535816612s'
printf '\n'
batch_format_scan_duration '7.168075341s'
printf '\n'
batch_format_scan_duration '83.456s'
printf '\n'
batch_format_scan_duration '1m23.456s'
printf '\n'
batch_format_scan_duration 'unknown'
printf '\n'
batch_format_scan_duration ''
printf '\n'
EOF
)"
if [[ "$(sed -n '1p' <<<"$fmt_out")" == '6.54s' ]] \
  && [[ "$(sed -n '2p' <<<"$fmt_out")" == '7.17s' ]] \
  && [[ "$(sed -n '3p' <<<"$fmt_out")" == '1m 23.46s' ]] \
  && [[ "$(sed -n '4p' <<<"$fmt_out")" == '1m 23.46s' ]] \
  && [[ "$(sed -n '5p' <<<"$fmt_out")" == 'unknown' ]] \
  && [[ "$(sed -n '6p' <<<"$fmt_out")" == 'unknown' ]]; then
  pass_case 'batch_format_scan_duration rounds raw Go durations for email'
else
  fail_case "batch_format_scan_duration unexpected output: ${fmt_out}"
fi

# shellcheck disable=SC2016  # assert report_body calls formatter by name
if grep -qF 'batch_format_scan_duration "$duration"' "$batch"; then
  pass_case 'report_body formats Scan time via batch_format_scan_duration'
else
  fail_case 'report_body missing batch_format_scan_duration for Scan time line'
fi

printf '\n=== static: batch email clarifies findings vs pass/fail (#559) ===\n'
# shellcheck disable=SC2016  # grep for literal printf format strings in batch-run source
if [[ -f "$batch" ]] \
  && grep -qF 'Findings:  %s verified, %s unverified (TruffleHog secret matches)' "$batch" \
  && grep -qF '  Passed:  %s\n' "$batch" \
  && grep -qF '  Failed:  %s\n' "$batch" \
  && grep -qF 'Repos in scope:' "$batch" \
  && grep -qF 'batch_load_scoped_repos' "$batch" \
  && grep -qF 'rp_discover_org_repos' "$batch" \
  && grep -qF 'rp_include_private=1' "$batch" \
  && ! grep -qF 'rp_include_private="$include_private"' "$batch" \
  && ! grep -qE "printf 'Started:  %s" "$batch" \
  && ! grep -qF "printf 'Verified: %s   Unverified: %s" "$batch" \
  && ! grep -qF "printf 'Result class:" "$batch"; then
  pass_case 'batch email labels findings, pass/fail, repo list; no header Started/Verified'
else
  fail_case 'batch email clarity (#559) incomplete'
fi

printf '\n=== static: batch email omits findings; deposits local detail ===\n'
# shellcheck disable=SC2016
if [[ -f "$batch" ]] \
  && grep -qF 'Finding details are omitted from email' "$batch" \
  && grep -qF 'SECRET_AUDIT_DETAIL_DIR' "$batch" \
  && grep -qF 'deposit_scan_detail' "$batch" \
  && grep -qF 'detail transcript deposit failed' "$batch" \
  && grep -qF 'batch_run_org_scan' "$batch" \
  && grep -qF '2>&1' "$batch" \
  && grep -qF 'runner_sh' "$batch" \
  && grep -qF 'runner_exec_stdout' "$batch" \
  && grep -qF 'SECRET_AUDIT_REPORT_TO' "$batch" \
  && [[ -f "${rh_root}/etc/secret-audit.env.example" ]] \
  && grep -qF 'SECRET_AUDIT_REPORT_TO' "${rh_root}/etc/secret-audit.env.example"; then
  pass_case 'batch-run summary email + local detail deposit + env example'
else
  fail_case 'batch-run email privacy / detail deposit / env example incomplete'
fi

printf '\n=== static: batch usage + private log file ===\n'
# shellcheck disable=SC2016  # grep for literal chmod line in batch-run source
if [[ -f "$batch" ]] \
  && grep -qF 'batch_ensure_log_file_private' "$batch" \
  && grep -qF 'chmod 0600 "$log_file"' "$batch" \
  && grep -qF "sed -n '2,12p' \$(printf '%q' \"\${BASH_SOURCE[0]}\")" "$batch" \
  && ! grep -qF "bash -c 'sed -n \"2,12p\"" "$batch"; then
  pass_case 'batch-run usage uses single-string runner_sh_stdout; log file chmod 0600'
else
  fail_case 'batch-run usage or log file privacy incomplete'
fi

printf '\n=== functional: batch --help prints usage ===\n'
batch_help_out=""
batch_help_rc=0
batch_help_out="$(REPO_HELPERS_TEST_MODE=1 bash "$batch" --help 2>&1)" || batch_help_rc=$?
if [[ "$batch_help_rc" -eq 0 ]] \
  && grep -qF 'secret-audit-batch-run' <<<"$batch_help_out" \
  && grep -qF -- '--print' <<<"$batch_help_out"; then
  pass_case 'batch-run --help prints usage text'
else
  fail_case "batch-run --help failed (rc=${batch_help_rc})"
fi

printf '\n=== functional: replay trufflehog stats from runner stderr artifact ===\n'
replay_out=""
replay_rc=0
replay_out="$(
  REPO_HELPERS_TEST_MODE=1 bash -c '
    set -euo pipefail
    rh_root="'"${rh_root}"'"
    # shellcheck disable=SC1091
    source "${rh_root}/scripts/lib/runner-bootstrap"
    runner_session_begin
    runner_exec "secret-audit test fake trufflehog" -- true
    uuid="$(runner_last_id)"
    printf "%s\n" \
      "level=info msg=\"Completed enumeration\" num_repos=12" \
      "level=info msg=\"finished scanning\" verified_secrets=0 unverified_secrets=1 scan_duration=19.2s" \
      >"${RUNNER_SESSION_DIR}/${uuid}/stderr"
    # shellcheck disable=SC1091
    source "${rh_root}/scripts/lib/secret-audit"
    secret_audit_replay_trufflehog_stats_to_stderr
  ' 2>&1
)" || replay_rc=$?
if [[ "$replay_rc" -eq 0 ]] \
  && grep -qF 'num_repos=12' <<<"$replay_out" \
  && grep -qF 'verified_secrets=0' <<<"$replay_out" \
  && grep -qF 'scan_duration=19.2s' <<<"$replay_out"; then
  pass_case 'secret_audit_replay_trufflehog_stats_to_stderr emits safe counters'
else
  fail_case "replay trufflehog stats failed (rc=${replay_rc} out=${replay_out})"
fi

printf '\n=== functional: batch --print summary omits findings ===\n'
print_out=""
print_rc=0
print_summary=""
print_out="$(
  REPO_HELPERS_TEST_MODE=1 \
  SECRET_AUDIT_BATCH_SKIP_ENV_FILE=1 \
  SECRET_AUDIT_REPORT_TO='' \
  bash "$batch" --print 2>&1
)" || print_rc=$?
print_summary="$(awk '/^Run context:/{exit} {print}' <<<"$print_out")"
if [[ "$print_rc" -eq 0 ]] \
  && grep -qF 'Finding details are omitted from email' <<<"$print_out" \
  && grep -qE 'Result:[[:space:]]+clean' <<<"$print_out" \
  && grep -qF 'Findings:' <<<"$print_out" \
  && grep -qF 'Passed:' <<<"$print_out" \
  && grep -qF 'Failed:' <<<"$print_out" \
  && grep -qF 'Repos in scope: (omitted in --print sample)' <<<"$print_out" \
  && ! grep -qE '^Started:' <<<"$print_summary" \
  && ! grep -qE '^Finished:' <<<"$print_summary" \
  && ! grep -qF 'Verified: ' <<<"$print_out" \
  && ! grep -qF 'Full scan transcript (host only):' <<<"$print_out" \
  && ! grep -qF 'SAMPLE-org-' <<<"$print_out" \
  && ! grep -qiE 'AKIA|ghp_|-----BEGIN' <<<"$print_out"; then
  pass_case 'batch --print summary has no credential-like payloads'
else
  fail_case "batch --print privacy check failed (rc=${print_rc})"
fi

printf '\n=== functional: report_body pass/fail + findings labels (#559) ===\n'
# Helpers report_body depends on (#541 classification + Primary).
batch_report_fns="$(
  awk '
    /^batch_result_token\(\)/ { keep=1 }
    /^batch_jq\(\)/ { keep=1 }
    /^batch_actionable_primary\(\)/ { keep=1 }
    /^batch_emit_failure_error\(\)/ { keep=1 }
    /^report_body\(\)/ { keep=1 }
    keep { print }
    keep && /^}/ { keep=0 }
  ' "$batch"
)"
report_body_out=""
report_body_summary=""
report_body_out="$(
  bash <<EOF
set -euo pipefail
org='the-hcma'
print_only=0
clean_log=''
detail_file=''
log_file='/tmp/secret-audit-batch.log'
helpers_repo_dir='/tmp/helpers'
secret_audit='/tmp/secret-audit'
report_separator='----'
secret_audit_trufflehog_leak_exit=183
batch_scoped_repo_names=(alpha zebra beta)
batch_format_scan_duration() { printf '%s' '6.54s'; }
batch_safe_scan_stats() { :; }
repo_helpers_run_context_footer_full() {
  printf 'Run context:\nStarted:  S\nFinished: F\n'
}
${batch_report_fns}
report_body 0 '2026-08-29T05:01:02-04:00' '2026-08-29T05:01:14-04:00'
EOF
)"
report_body_summary="$(awk '/^Run context:/{exit} {print}' <<<"$report_body_out")"
if grep -qF 'Repos:     3 in scope' <<<"$report_body_out" \
  && grep -qF 'Passed:  3' <<<"$report_body_out" \
  && grep -qF 'Failed:  0' <<<"$report_body_out" \
  && grep -qF 'Findings:  unknown verified, unknown unverified' <<<"$report_body_out" \
  && grep -qF '  - the-hcma/alpha' <<<"$report_body_out" \
  && grep -qF '  - the-hcma/beta' <<<"$report_body_out" \
  && grep -qF '  - the-hcma/zebra' <<<"$report_body_out" \
  && grep -qE 'Result:[[:space:]]+clean' <<<"$report_body_out" \
  && ! grep -qE '^Primary:' <<<"$report_body_out" \
  && ! grep -qF 'Command failures' <<<"$report_body_out" \
  && ! grep -qE '^Started:' <<<"$report_body_summary" \
  && ! grep -qE '^Finished:' <<<"$report_body_summary" \
  && grep -qF 'Started:  S' <<<"$report_body_out"; then
  pass_case 'report_body lists repos and pass/fail; Started only in footer'
else
  fail_case "report_body clarity failed: ${report_body_out}"
fi

report_body_fail_out=""
report_body_fail_out="$(
  bash <<EOF
set -euo pipefail
org='the-hcma'
print_only=0
clean_log=''
detail_file=''
log_file='/tmp/secret-audit-batch.log'
helpers_repo_dir='/tmp/helpers'
secret_audit='/tmp/secret-audit'
report_separator='----'
secret_audit_trufflehog_leak_exit=183
batch_scoped_repo_names=(alpha beta)
batch_format_scan_duration() { printf '%s' '1.00s'; }
batch_safe_scan_stats() { :; }
repo_helpers_run_context_footer_full() { :; }
${batch_report_fns}
report_body 183 'S' 'F'
EOF
)"
if grep -qF 'Passed:  0' <<<"$report_body_fail_out" \
  && grep -qF 'Failed:  2' <<<"$report_body_fail_out" \
  && grep -qF 'SECRET_AUDIT_LEAK' <<<"$report_body_fail_out" \
  && grep -qF 'Action: rotate credentials' <<<"$report_body_fail_out"; then
  pass_case 'report_body leak exit marks all in-scope repos failed'
else
  fail_case "report_body leak clarity failed: ${report_body_fail_out}"
fi

# TruffleHog num_repos wins over a shorter discovery list (private-token scope).
stats_log="$(mktemp)"
cat >"$stats_log" <<'EOF'
Completed enumeration {"num_repos": 11}
finished scanning {"verified_secrets": 0, "unverified_secrets": 0, "scan_duration": "6.7s"}
EOF
report_body_th_count=""
report_body_th_count="$(
  bash <<EOF
set -euo pipefail
org='the-hcma'
print_only=0
clean_log='$stats_log'
detail_file=''
log_file='/tmp/secret-audit-batch.log'
helpers_repo_dir='/tmp/helpers'
secret_audit='/tmp/secret-audit'
report_separator='----'
secret_audit_trufflehog_leak_exit=183
batch_scoped_repo_names=(alpha beta)
batch_format_scan_duration() { printf '%s' '6.70s'; }
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
repo_helpers_run_context_footer_full() { :; }
${batch_report_fns}
report_body 0 'S' 'F'
EOF
)"
rm -f "$stats_log"
if grep -qF 'Repos:     11 in scope' <<<"$report_body_th_count" \
  && grep -qF 'Passed:  11' <<<"$report_body_th_count" \
  && grep -qF 'Findings:  0 verified, 0 unverified' <<<"$report_body_th_count"; then
  pass_case 'report_body prefers TruffleHog num_repos over shorter discovery list'
else
  fail_case "report_body num_repos preference failed: ${report_body_th_count}"
fi

printf '\n=== functional: report_body Primary + Command failures + INFRA (#541) ===\n'
# shellcheck disable=SC2016  # static asserts match literal helper names
if grep -qF 'batch_result_token()' "$batch" \
  && grep -qF 'batch_actionable_primary()' "$batch" \
  && grep -qF 'batch_emit_failure_error()' "$batch" \
  && grep -qF 'runner_report_append_command_failures' "$batch" \
  && grep -qF 'SECRET_AUDIT_INFRA_FAILED' "$batch" \
  && grep -qF "printf 'Primary:   %s" "$batch"; then
  pass_case 'batch-run wires Primary, Command failures, INFRA class helpers'
else
  fail_case 'batch-run missing #541 Primary / Command failures / INFRA wiring'
fi

infra_stats_log="$(mktemp)"
cat >"$infra_stats_log" <<'EOF'
Completed enumeration {"num_repos": 11}
finished scanning {"verified_secrets": 0, "unverified_secrets": 0, "scan_duration": "6.535816612s"}
EOF
report_body_infra=""
report_body_infra="$(
  bash <<EOF
set -euo pipefail
export RUNNER_SESSION_ROOT="\$(mktemp -d)/sessions"
unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP _runner_bootstrap_active || true
# shellcheck disable=SC1091
source '${rh_root}/scripts/lib/runner'
runner_session_begin
# Capture via runner (same as batch_run_org_scan) so Primary gets a stderr hint
# without hand-writing the artifact.
runner_sh 'secret-audit batch org scan' -- \
  "printf 'rm: cannot remove simulated session\n' >&2; false" \
  >/dev/null 2>&1 || true
# Post-scan deposit failure must not steal Primary (Vortex #563).
runner_exec 'secret-audit-batch cp detail transcript' -- false >/dev/null 2>&1 || true
org='the-hcma'
print_only=0
clean_log='$infra_stats_log'
detail_file=''
log_file='/tmp/secret-audit-batch.log'
helpers_repo_dir='/tmp/helpers'
secret_audit='/tmp/secret-audit'
report_separator='----'
secret_audit_trufflehog_leak_exit=183
batch_scoped_repo_names=(alpha beta)
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
$(sed -n '/^batch_format_scan_duration()/,/^}/p' "$batch")
repo_helpers_run_context_footer_full() { :; }
${batch_report_fns}
report_body 1 'S' 'F'
EOF
)"
rm -f "$infra_stats_log"
if grep -qE 'Result:[[:space:]]+SECRET_AUDIT_INFRA_FAILED' <<<"$report_body_infra" \
  && grep -qE 'Primary:[[:space:]]+secret-audit batch org scan: rm: cannot remove simulated session' \
    <<<"$report_body_infra" \
  && grep -qF 'Command failures (2):' <<<"$report_body_infra" \
  && grep -qF 'secret-audit batch org scan (exit 1): rm: cannot remove simulated session' \
    <<<"$report_body_infra" \
  && grep -qF 'secret-audit-batch cp detail transcript (exit 1)' <<<"$report_body_infra" \
  && ! grep -qE 'Primary:[[:space:]]+secret-audit-batch cp' <<<"$report_body_infra" \
  && grep -qF 'Passed:  11' <<<"$report_body_infra" \
  && grep -qF 'Failed:  0' <<<"$report_body_infra" \
  && grep -qF 'Scan time: 6.54s' <<<"$report_body_infra" \
  && grep -qF 'triage Primary / Command failures' <<<"$report_body_infra"; then
  pass_case 'report_body INFRA Primary prefers org-scan tee hint over later deposit failure'
else
  fail_case "report_body INFRA/#541/#563 failed: ${report_body_infra}"
fi

emit_err_out=""
emit_err_rc=0
emit_err_out="$(
  bash 2>&1 <<EOF
set -euo pipefail
secret_audit_trufflehog_leak_exit=183
batch_log_line() { :; }
${batch_report_fns}
batch_emit_failure_error SECRET_AUDIT_INFRA_FAILED 1 'secret-audit batch org scan: rm race'
EOF
)" || emit_err_rc=$?
if [[ "$emit_err_rc" -eq 0 ]] \
  && grep -qF 'ERROR: SECRET_AUDIT_INFRA_FAILED exit=1 primary=secret-audit batch org scan: rm race' \
    <<<"$emit_err_out"; then
  pass_case 'batch_emit_failure_error prints machine-parseable ERROR line'
else
  fail_case "batch_emit_failure_error failed (rc=${emit_err_rc} out=${emit_err_out})"
fi

token_out=""
token_out="$(
  bash <<EOF
set -euo pipefail
secret_audit_trufflehog_leak_exit=183
${batch_report_fns}
batch_result_token 0 0 0; printf '\n'
batch_result_token 183 1 0; printf '\n'
batch_result_token 1 0 0; printf '\n'
batch_result_token 1 unknown unknown; printf '\n'
EOF
)"
if [[ "$(sed -n '1p' <<<"$token_out")" == 'clean' ]] \
  && [[ "$(sed -n '2p' <<<"$token_out")" == 'SECRET_AUDIT_LEAK' ]] \
  && [[ "$(sed -n '3p' <<<"$token_out")" == 'SECRET_AUDIT_INFRA_FAILED' ]] \
  && [[ "$(sed -n '4p' <<<"$token_out")" == 'SECRET_AUDIT_SCAN_FAILED' ]]; then
  pass_case 'batch_result_token classifies clean/leak/infra/scan'
else
  fail_case "batch_result_token unexpected: ${token_out}"
fi

scan_failed_stats_log="$(mktemp)"
cat >"$scan_failed_stats_log" <<'EOF'
Completed enumeration {"num_repos": 11}
finished scanning {"verified_secrets": 0, "unverified_secrets": 0, "scan_duration": "1.0s"}
ERROR: SECRET_AUDIT_SCAN_FAILED exit=1
EOF
token_scan_failed=""
token_scan_failed="$(
  bash <<EOF
set -euo pipefail
secret_audit_trufflehog_leak_exit=183
${batch_report_fns}
batch_result_token 1 0 0 '$scan_failed_stats_log'; printf '\n'
batch_result_token 1 0 0; printf '\n'
EOF
)"
rm -f "$scan_failed_stats_log"
if [[ "$(sed -n '1p' <<<"$token_scan_failed")" == 'SECRET_AUDIT_SCAN_FAILED' ]] \
  && [[ "$(sed -n '2p' <<<"$token_scan_failed")" == 'SECRET_AUDIT_INFRA_FAILED' ]]; then
  pass_case 'batch_result_token prefers SCAN_FAILED marker over 0/0 INFRA'
else
  fail_case "batch_result_token log marker unexpected: ${token_scan_failed}"
fi

report_body_scan_failed=""
report_body_scan_failed="$(
  bash <<EOF
set -euo pipefail
export RUNNER_SESSION_ROOT="\$(mktemp -d)/sessions"
unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP _runner_bootstrap_active || true
# shellcheck disable=SC1091
source '${rh_root}/scripts/lib/runner'
runner_session_begin
runner_sh 'secret-audit batch org scan' -- \
  "printf '%s\n' '{\"level\":\"info\",\"msg\":\"Completed enumeration\",\"num_repos\":11}' 'ERROR: SECRET_AUDIT_SCAN_FAILED exit=1' >&2; false" \
  >/dev/null 2>&1 || true
org='the-hcma'
print_only=0
clean_log='$(mktemp)'
cat >"\$clean_log" <<'LOG'
Completed enumeration {"num_repos": 11}
finished scanning {"verified_secrets": 0, "unverified_secrets": 0, "scan_duration": "1.0s"}
ERROR: SECRET_AUDIT_SCAN_FAILED exit=1
LOG
detail_file=''
log_file='/tmp/secret-audit-batch.log'
helpers_repo_dir='/tmp/helpers'
secret_audit='/tmp/secret-audit'
report_separator='----'
secret_audit_trufflehog_leak_exit=183
batch_scoped_repo_names=(alpha)
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
$(sed -n '/^batch_format_scan_duration()/,/^}/p' "$batch")
repo_helpers_run_context_footer_full() { :; }
${batch_report_fns}
report_body 1 'S' 'F'
rm -f "\$clean_log"
EOF
)"
if grep -qE 'Result:[[:space:]]+SECRET_AUDIT_SCAN_FAILED' <<<"$report_body_scan_failed" \
  && grep -qE 'Primary:[[:space:]]+secret-audit batch org scan: ERROR: SECRET_AUDIT_SCAN_FAILED exit=1' \
    <<<"$report_body_scan_failed" \
  && grep -qF 'Passed:  0' <<<"$report_body_scan_failed" \
  && grep -qF 'Failed:  11' <<<"$report_body_scan_failed" \
  && ! grep -qF 'scan counters were clean' <<<"$report_body_scan_failed"; then
  pass_case 'report_body SCAN_FAILED with 0/0 counters prefers ERROR hint (not INFRA)'
else
  fail_case "report_body SCAN_FAILED/#563 failed: ${report_body_scan_failed}"
fi

printf '\n=== secret-audit --help ===\n'
help_out=""
help_rc=0
help_out="$(bash "$entry" --help 2>&1)" || help_rc=$?
if [[ "$help_rc" -eq 0 ]] \
  && grep -qF 'write-marker' <<<"$help_out" \
  && grep -qF 'ledger' <<<"$help_out" \
  && ! grep -qF 'write-marker-local' <<<"$help_out" \
  && grep -qF 'trufflehog' <<<"$help_out"; then
  pass_case '--help mentions write-marker (ledger), trufflehog; no --write-marker-local'
else
  fail_case "--help incomplete (rc=${help_rc})"
fi

printf '\n=== dry-run single repo ===\n'
dry_out=""
dry_rc=0
dry_out="$(bash "$entry" --repo the-hcma/example-repo --dry-run 2>&1)" || dry_rc=$?
if [[ "$dry_rc" -eq 0 ]] && grep -qiE 'DRY-RUN|dry-run' <<<"$dry_out"; then
  pass_case '--repo --dry-run prints planned scan'
else
  fail_case "--repo --dry-run failed (rc=${dry_rc} out=${dry_out})"
fi

printf '\n=== docs mention detectors and git vs filesystem ===\n'
doc="${rh_root}/docs/secret-audit-trufflehog.md"
if [[ -f "$doc" ]] \
  && grep -qF '800+' "$doc" \
  && grep -qF 'verified' "$doc" \
  && grep -qF 'filesystem' "$doc" \
  && grep -qF -- '--no-update' "$doc" \
  && grep -qF 'secret_audit_trufflehog_pinned_sha256' "$doc" \
  && grep -qE 'AGPL|AGPL' "$doc" \
  && grep -qF -- '--exclude-archived' "$doc" \
  && grep -qF 'SECRET_AUDIT_CONCURRENCY' "$doc" \
  && grep -qF 'ERROR: SECRET_AUDIT_INFRA_FAILED' "$doc" \
  && grep -qF 'SECRET_AUDIT_DETAIL_DIR' "$doc"; then
  pass_case 'docs describe detectors, verification, git vs filesystem, AGPL, SHA pins, archived skip, email privacy'
else
  fail_case 'docs/secret-audit-trufflehog.md incomplete'
fi

printf '\n=== static: batch-run isolates child runner session ===\n'
batch_run="${rh_root}/scripts/secret-audit-batch-run"
batch_org_scan_fn=""
# shellcheck disable=SC2016  # assert literals inside extracted batch_run_org_scan
if [[ -f "$batch_run" ]]; then
  batch_org_scan_fn="$(
    awk '
      /^batch_run_org_scan\(\)/ { keep=1 }
      keep { print }
      keep && /^}/ { exit }
    ' "$batch_run"
  )"
fi
# shellcheck disable=SC2016  # grep for literal "$scan_shell_cmd" in batch_run_org_scan source
if [[ -n "$batch_org_scan_fn" ]] \
  && grep -qF "scan_shell_cmd='env -u RUNNER_SESSION_DIR -u RUNNER_SESSION_KEEP'" <<<"$batch_org_scan_fn" \
  && grep -qF 'runner_sh "secret-audit batch org scan"' <<<"$batch_org_scan_fn" \
  && grep -qF '"$scan_shell_cmd"' <<<"$batch_org_scan_fn" \
  && grep -qF 'runner_last_id' <<<"$batch_org_scan_fn" \
  && grep -qF 'runner_read' <<<"$batch_org_scan_fn" \
  && grep -qF '>>"$run_log_path"' <<<"$batch_org_scan_fn" \
  && ! grep -qE '>>\$\(printf .*\) 2>&1' <<<"$batch_org_scan_fn"; then
  pass_case 'batch_run_org_scan isolates child session and appends runner capture to run_log'
else
  fail_case 'batch_run_org_scan must env -u child + append runner stdout/stderr to run_log'
fi

printf '\n=== static: nightly batch-run maintains the host-local intake ledger ===\n'
batch_scan_args=""
if [[ -f "$batch" ]]; then
  batch_scan_args="$(grep -F 'scan_args=(--all' "$batch" || true)"
fi
if [[ -n "$batch_scan_args" ]] \
  && grep -qF -- '--write-marker' <<<"$batch_scan_args" \
  && grep -qF 'repository-helpers#573' "$batch"; then
  pass_case 'batch-run passes --write-marker (nightly ledger maintenance; #573)'
else
  fail_case 'batch-run must pass --write-marker so the nightly sweep keeps the ledger fresh'
fi

printf '\n=== static: docs describe the host-local ledger (not a git file) ===\n'
sa_doc="${rh_root}/docs/secret-audit-trufflehog.md"
if [[ -f "$sa_doc" ]] \
  && grep -qF 'secret-audit-intake.json' "$sa_doc" \
  && grep -qiF 'not a git file' "$sa_doc" \
  && grep -qF 'SECRET_AUDIT_INTAKE_LEDGER' "$sa_doc" \
  && grep -qF 'Maintained by the nightly sweep' "$sa_doc" \
  && grep -qF 'SECRET_AUDIT_INTAKE_MISSING' "$sa_doc"; then
  pass_case 'docs describe the disposable host-local ledger + failure contract'
else
  fail_case 'docs must describe the host-local intake ledger (#573)'
fi

printf '\n=== summary ===\n'
printf 'Passed: %s  Failed: %s\n' "$pass" "$fail"
if (( fail > 0 )); then
  exit 1
fi
