#!/usr/bin/env bash
# Tests for scripts/secret-audit and scripts/lib/secret-audit.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

entry="${rh_root}/scripts/secret-audit"
lib="${rh_root}/scripts/lib/secret-audit"
readonly entry lib

pass=0
fail=0

pass_case() {
  printf '[PASS] %s\n' "$1"
  pass=$((pass + 1))
}

fail_case() {
  printf '[FAIL] %s\n' "$1"
  fail=$((fail + 1))
}

printf '\n=== static: entrypoints ===\n'
if [[ -f "$entry" && -f "$lib" ]]; then
  pass_case 'secret-audit script and library exist'
else
  fail_case 'missing secret-audit entrypoints'
fi

printf '\n=== static: trufflehog contract ===\n'
# shellcheck disable=SC2016  # assert literal pin and flag strings in source
if grep -qF "secret_audit_trufflehog_version='3.97.0'" "$lib" \
  && grep -qF 'secret_audit_trufflehog_leak_exit=183' "$lib" \
  && grep -qF 'ERROR: SECRET_AUDIT_LEAK' "$lib" \
  && grep -qF 'ERROR: SECRET_AUDIT_SCAN_FAILED' "$lib" \
  && grep -qF -- '--no-update' "$lib" \
  && grep -qF 'secret_audit_marker_relpath' "$lib" \
  && grep -qF '.github/secret-audit.json' "$lib"; then
  pass_case 'trufflehog pin, --no-update, GITHUB_TOKEN env (never --token argv), errors present'
else
  fail_case 'trufflehog contract incomplete in secret-audit lib'
fi

printf '\n=== static: in-repo release SHA-256 pins (not release checksums.txt) ===\n'
# shellcheck disable=SC2016  # assert literal digests and helper names in source
if grep -qF 'secret_audit_trufflehog_pinned_sha256' "$lib" \
  && grep -qF '037e4aeb197870555ff515432bb5f1f2c98dce5f1214631a689112b5e0e4c9fd' "$lib" \
  && grep -qF 'ad0a99bd48d6df80eabab24d11d0fd771e245fc55ed347f943cafb5e5f497c5c' "$lib" \
  && grep -qF '62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4' "$lib" \
  && grep -qF 'f48f57e3d4343377865b1b64653f96d381d61a7792d89d026e85524732039fde' "$lib" \
  && ! grep -qE 'trufflehog_\$\{version\}_checksums|releases/download/.*/.*_checksums' "$lib" \
  && grep -qF 'tooling_path_ensure_gnu_userland' "$entry" \
  && grep -qF 'sha256sum required' "$lib"; then
  pass_case 'release asset SHA-256 pinned in-repo; CLI ensures GNU sha256sum'
else
  fail_case 'missing in-repo SHA-256 pins or GNU sha256sum gate'
fi

printf '\n=== static: gh auth token not captured via runner_exec_stdout ===\n'
# shellcheck disable=SC2016  # assert helper wiring literals
if grep -qF 'secret_audit_resolve_github_token' "$lib" \
  && grep -qF 'gh auth token >"$1"' "$lib" \
  && ! grep -qE 'runner_exec_stdout.*"secret-audit gh auth token"' "$lib"; then
  pass_case 'gh auth token written to 0600 tempfile, not runner stdout artifact'
else
  fail_case 'gh auth token must not use runner_exec_stdout capture'
fi

printf '\n=== static: marker write gated on clean scan ===\n'
# shellcheck disable=SC2016  # assert control-flow literals in CLI source
if grep -qF 'secret_audit_run_git_scan' "$entry" \
  && grep -qF 'secret_audit_write_marker' "$entry" \
  && awk '
    /secret_audit_run_git_scan/ { scan=NR }
    /secret_audit_write_marker/ { write=NR }
    END { exit !(scan && write && write > scan) }
  ' "$entry" \
  && grep -qF 'if (( scan_rc != 0 )); then' "$entry"; then
  pass_case 'CLI writes marker only after successful scan'
else
  fail_case 'marker write is not gated on clean scan_rc'
fi

printf '\n=== static: --all never writes markers on failed org scan ===\n'
# shellcheck disable=SC2016
if grep -qF 'secret_audit_run_github_org_scan' "$entry" \
  && grep -qF 'Never refresh clean markers' "$entry"; then
  pass_case '--all documents no marker refresh on org-scan failure'
else
  fail_case '--all failure path missing no-marker guarantee'
fi

printf '\n=== static: --all local refresh fails closed on leak; clone ensure guarded ===\n'
# shellcheck disable=SC2016  # assert literal identifiers in CLI source
if grep -qF 'saw_leak=0' "$entry" \
  && grep -qF 'saw_leak=1' "$entry" \
  && grep -qF 'secret_audit_trufflehog_leak_exit' "$entry" \
  && grep -qF 'if ! secret_audit_ensure_full_clone' "$entry" \
  && grep -qF 'WARN: skipping marker for' "$entry"; then
  pass_case '--all guards full-clone ensure and fails closed on local leak'
else
  fail_case '--all missing clone-ensure guard or local-leak fail-closed path'
fi

printf '\n=== marker validation: valid json ===\n'
# shellcheck disable=SC1091
# shellcheck disable=SC1090,SC1091
source "${rh_root}/scripts/lib/runner-bootstrap"
# shellcheck disable=SC1090,SC1091
source "$lib"

valid_marker="$(jq -nc \
  --arg scanned_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{
    status: "clean",
    scanned_at: $scanned_at,
    scanner: "trufflehog",
    scanner_version: "3.97.0",
    git_tip: "abc1234567890abcdef1234567890abcdef1234",
    results_filter: "verified",
    tool: "repository-helpers/secret-audit"
  }')"
if secret_audit_validate_marker_json "$valid_marker"; then
  pass_case 'valid marker passes validation'
else
  fail_case 'valid marker should pass validation'
fi

printf '\n=== marker validation: wrong status ===\n'
bad_status="$(jq '.status = "dirty"' <<<"$valid_marker")"
if secret_audit_validate_marker_json "$bad_status" 2>/dev/null; then
  fail_case 'dirty status should fail validation'
else
  pass_case 'non-clean status rejected'
fi

printf '\n=== marker validation: missing field ===\n'
missing_field="$(jq 'del(.git_tip)' <<<"$valid_marker")"
if secret_audit_validate_marker_json "$missing_field" 2>/dev/null; then
  fail_case 'missing git_tip should fail validation'
else
  pass_case 'missing required field rejected'
fi

printf '\n=== marker validation: non-object JSON ===\n'
non_object_ok=1
for non_object in '[]' 'null' '123' '"x"'; do
  if secret_audit_validate_marker_json "$non_object" 2>/dev/null; then
    non_object_ok=0
    fail_case "non-object marker accepted: ${non_object}"
  fi
done
if [[ "$non_object_ok" -eq 1 ]]; then
  pass_case 'non-object JSON markers rejected without crashing'
fi

printf '\n=== marker validation: future scanned_at ===\n'
future_marker="$(jq --arg scanned_at '2099-01-01T00:00:00Z' \
  '.scanned_at = $scanned_at' <<<"$valid_marker")"
if secret_audit_validate_marker_json "$future_marker" 2>/dev/null; then
  fail_case 'future scanned_at should fail validation'
else
  pass_case 'future marker rejected'
fi

printf '\n=== marker validation: near-future scanned_at (<24h) ===\n'
near_epoch=$(( $(time_log_now_utc_epoch) + 12 * 3600 ))
near_future_at=''
if ! near_future_at="$(date -u -d "@${near_epoch}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"; then
  near_future_at="$(date -u -r "${near_epoch}" +%Y-%m-%dT%H:%M:%SZ)"
fi
near_future_marker="$(jq --arg scanned_at "$near_future_at" \
  '.scanned_at = $scanned_at' <<<"$valid_marker")"
if secret_audit_validate_marker_json "$near_future_marker" 2>/dev/null; then
  fail_case 'near-future scanned_at (<24h) should fail validation'
else
  pass_case 'near-future marker rejected (epoch compare, not truncated day math)'
fi

printf '\n=== marker validation: stale scanned_at ===\n'
stale_marker="$(jq --arg scanned_at '2020-01-01T00:00:00Z' \
  '.scanned_at = $scanned_at' <<<"$valid_marker")"
if secret_audit_validate_marker_json "$stale_marker" 2>/dev/null; then
  fail_case 'stale scanned_at should fail validation'
else
  pass_case 'stale marker rejected'
fi

printf '\n=== static: org scan excludes archived; optional concurrency ===\n'
# shellcheck disable=SC2016  # assert literal flag / helper names in lib source
if grep -qF 'secret_audit_append_trufflehog_global_flags' "$lib" \
  && grep -qF -- '--exclude-archived' "$lib" \
  && grep -qF 'SECRET_AUDIT_CONCURRENCY' "$lib" \
  && grep -qF -- '--concurrency=' "$lib"; then
  pass_case 'org scan uses --exclude-archived; concurrency via SECRET_AUDIT_CONCURRENCY'
else
  fail_case 'missing --exclude-archived or concurrency wiring in secret-audit lib'
fi

printf '\n=== static: --all excludes archived from marker refresh discovery ===\n'
# shellcheck disable=SC2016
if grep -qF 'rp_exclude_archived=1' "$entry" \
  && grep -qF 'rp_exclude_archived' "${rh_root}/scripts/lib/repo-practices" \
  && grep -qF '.archived == false' "${rh_root}/scripts/lib/repo-practices"; then
  pass_case '--all sets rp_exclude_archived for marker-refresh discovery'
else
  fail_case 'marker refresh missing archived exclusion'
fi

batch="${rh_root}/scripts/secret-audit-batch-run"
readonly batch

printf '\n=== functional: batch_safe_scan_stats parses JSON and key=value logs ===\n'
stats_tmp="$(mktemp)"
cat >"$stats_tmp" <<'EOF'
2026-08-25T14:33:06-04:00	info-0	trufflehog	Completed enumeration	{"num_repos": 12}
2026-08-25T14:33:13-04:00	info-0	trufflehog	finished scanning	{"verified_secrets": 0, "unverified_secrets": 1, "scan_duration": "19.2s"}
EOF
stats_out=""
stats_out="$(
  bash <<EOF
set -euo pipefail
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
batch_safe_scan_stats '$stats_tmp'
EOF
)"
rm -f "$stats_tmp"
if grep -qF 'num_repos=12' <<<"$stats_out" \
  && grep -qF 'verified_secrets=0' <<<"$stats_out" \
  && grep -qF 'unverified_secrets=1' <<<"$stats_out" \
  && grep -qF 'scan_duration=19.2s' <<<"$stats_out"; then
  pass_case 'batch_safe_scan_stats parses logrus JSON fields'
else
  fail_case "batch_safe_scan_stats JSON parse failed: ${stats_out}"
fi

stats_tmp="$(mktemp)"
cat >"$stats_tmp" <<'EOF'
Completed enumeration num_repos=7
finished scanning verified_secrets=2 unverified_secrets=3 scan_duration=8.5s
EOF
stats_out="$(
  bash <<EOF
set -euo pipefail
$(sed -n '/^batch_safe_scan_stats()/,/^}/p' "$batch")
batch_safe_scan_stats '$stats_tmp'
EOF
)"
rm -f "$stats_tmp"
if grep -qF 'num_repos=7' <<<"$stats_out" \
  && grep -qF 'verified_secrets=2' <<<"$stats_out" \
  && grep -qF 'unverified_secrets=3' <<<"$stats_out" \
  && grep -qF 'scan_duration=8.5s' <<<"$stats_out"; then
  pass_case 'batch_safe_scan_stats parses key=value text fields'
else
  fail_case "batch_safe_scan_stats key=value parse failed: ${stats_out}"
fi

printf '\n=== static: batch email omits findings; deposits local detail ===\n'
# shellcheck disable=SC2016
if [[ -f "$batch" ]] \
  && grep -qF 'Finding details are omitted from email' "$batch" \
  && grep -qF 'SECRET_AUDIT_DETAIL_DIR' "$batch" \
  && grep -qF 'deposit_scan_detail' "$batch" \
  && grep -qF 'detail transcript deposit failed' "$batch" \
  && grep -qF 'batch_run_org_scan' "$batch" \
  && grep -qF '2>&1' "$batch" \
  && grep -qF 'runner_sh' "$batch" \
  && grep -qF 'runner_exec_stdout' "$batch" \
  && grep -qF 'SECRET_AUDIT_REPORT_TO' "$batch" \
  && [[ -f "${rh_root}/etc/secret-audit.env.example" ]] \
  && grep -qF 'SECRET_AUDIT_REPORT_TO' "${rh_root}/etc/secret-audit.env.example"; then
  pass_case 'batch-run summary email + local detail deposit + env example'
else
  fail_case 'batch-run email privacy / detail deposit / env example incomplete'
fi

printf '\n=== static: batch usage + private log file ===\n'
# shellcheck disable=SC2016  # grep for literal chmod line in batch-run source
if [[ -f "$batch" ]] \
  && grep -qF 'batch_ensure_log_file_private' "$batch" \
  && grep -qF 'chmod 0600 "$log_file"' "$batch" \
  && grep -qF "sed -n '2,12p' \$(printf '%q' \"\${BASH_SOURCE[0]}\")" "$batch" \
  && ! grep -qF "bash -c 'sed -n \"2,12p\"" "$batch"; then
  pass_case 'batch-run usage uses single-string runner_sh_stdout; log file chmod 0600'
else
  fail_case 'batch-run usage or log file privacy incomplete'
fi

printf '\n=== functional: batch --help prints usage ===\n'
batch_help_out=""
batch_help_rc=0
batch_help_out="$(REPO_HELPERS_TEST_MODE=1 bash "$batch" --help 2>&1)" || batch_help_rc=$?
if [[ "$batch_help_rc" -eq 0 ]] \
  && grep -qF 'secret-audit-batch-run' <<<"$batch_help_out" \
  && grep -qF -- '--print' <<<"$batch_help_out"; then
  pass_case 'batch-run --help prints usage text'
else
  fail_case "batch-run --help failed (rc=${batch_help_rc})"
fi

printf '\n=== functional: replay trufflehog stats from runner stderr artifact ===\n'
replay_out=""
replay_rc=0
replay_out="$(
  REPO_HELPERS_TEST_MODE=1 bash -c '
    set -euo pipefail
    rh_root="'"${rh_root}"'"
    # shellcheck disable=SC1091
    source "${rh_root}/scripts/lib/runner-bootstrap"
    runner_session_begin
    runner_exec "secret-audit test fake trufflehog" -- true
    uuid="$(runner_last_id)"
    printf "%s\n" \
      "level=info msg=\"Completed enumeration\" num_repos=12" \
      "level=info msg=\"finished scanning\" verified_secrets=0 unverified_secrets=1 scan_duration=19.2s" \
      >"${RUNNER_SESSION_DIR}/${uuid}/stderr"
    # shellcheck disable=SC1091
    source "${rh_root}/scripts/lib/secret-audit"
    secret_audit_replay_trufflehog_stats_to_stderr
  ' 2>&1
)" || replay_rc=$?
if [[ "$replay_rc" -eq 0 ]] \
  && grep -qF 'num_repos=12' <<<"$replay_out" \
  && grep -qF 'verified_secrets=0' <<<"$replay_out" \
  && grep -qF 'scan_duration=19.2s' <<<"$replay_out"; then
  pass_case 'secret_audit_replay_trufflehog_stats_to_stderr emits safe counters'
else
  fail_case "replay trufflehog stats failed (rc=${replay_rc} out=${replay_out})"
fi

printf '\n=== functional: batch --print summary omits findings ===\n'
print_out=""
print_rc=0
print_out="$(
  REPO_HELPERS_TEST_MODE=1 \
  SECRET_AUDIT_BATCH_SKIP_ENV_FILE=1 \
  SECRET_AUDIT_REPORT_TO='' \
  bash "$batch" --print 2>&1
)" || print_rc=$?
if [[ "$print_rc" -eq 0 ]] \
  && grep -qF 'Finding details are omitted from email' <<<"$print_out" \
  && grep -qF 'Result class: clean' <<<"$print_out" \
  && ! grep -qF 'Full scan transcript (host only):' <<<"$print_out" \
  && ! grep -qF 'SAMPLE-org-' <<<"$print_out" \
  && ! grep -qiE 'AKIA|ghp_|-----BEGIN' <<<"$print_out"; then
  pass_case 'batch --print summary has no credential-like payloads'
else
  fail_case "batch --print privacy check failed (rc=${print_rc})"
fi

printf '\n=== secret-audit --help ===\n'
help_out=""
help_rc=0
help_out="$(bash "$entry" --help 2>&1)" || help_rc=$?
if [[ "$help_rc" -eq 0 ]] \
  && grep -qF 'write-marker' <<<"$help_out" \
  && grep -qF 'trufflehog' <<<"$help_out"; then
  pass_case '--help mentions write-marker and trufflehog'
else
  fail_case "--help incomplete (rc=${help_rc})"
fi

printf '\n=== dry-run single repo ===\n'
dry_out=""
dry_rc=0
dry_out="$(bash "$entry" --repo the-hcma/example-repo --dry-run 2>&1)" || dry_rc=$?
if [[ "$dry_rc" -eq 0 ]] && grep -qiE 'DRY-RUN|dry-run' <<<"$dry_out"; then
  pass_case '--repo --dry-run prints planned scan'
else
  fail_case "--repo --dry-run failed (rc=${dry_rc} out=${dry_out})"
fi

printf '\n=== docs mention detectors and git vs filesystem ===\n'
doc="${rh_root}/docs/secret-audit-trufflehog.md"
if [[ -f "$doc" ]] \
  && grep -qF '800+' "$doc" \
  && grep -qF 'verified' "$doc" \
  && grep -qF 'filesystem' "$doc" \
  && grep -qF -- '--no-update' "$doc" \
  && grep -qF 'secret_audit_trufflehog_pinned_sha256' "$doc" \
  && grep -qE 'AGPL|AGPL' "$doc" \
  && grep -qF -- '--exclude-archived' "$doc" \
  && grep -qF 'SECRET_AUDIT_CONCURRENCY' "$doc" \
  && grep -qF 'SECRET_AUDIT_DETAIL_DIR' "$doc"; then
  pass_case 'docs describe detectors, verification, git vs filesystem, AGPL, SHA pins, archived skip, email privacy'
else
  fail_case 'docs/secret-audit-trufflehog.md incomplete'
fi

printf '\n=== static: batch-run isolates child runner session ===\n'
batch_run="${rh_root}/scripts/secret-audit-batch-run"
batch_org_scan_fn=""
# shellcheck disable=SC2016  # assert literals inside extracted batch_run_org_scan
if [[ -f "$batch_run" ]]; then
  batch_org_scan_fn="$(
    awk '
      /^batch_run_org_scan\(\)/ { keep=1 }
      keep { print }
      keep && /^}/ { exit }
    ' "$batch_run"
  )"
fi
# shellcheck disable=SC2016  # grep for literal "$scan_shell_cmd" in batch_run_org_scan source
if [[ -n "$batch_org_scan_fn" ]] \
  && grep -qF "scan_shell_cmd='env -u RUNNER_SESSION_DIR -u RUNNER_SESSION_KEEP'" <<<"$batch_org_scan_fn" \
  && grep -qF 'runner_sh "secret-audit batch org scan"' <<<"$batch_org_scan_fn" \
  && grep -qF '"$scan_shell_cmd"' <<<"$batch_org_scan_fn"; then
  pass_case 'batch_run_org_scan clears RUNNER_SESSION_DIR/KEEP before secret-audit child'
else
  fail_case 'batch_run_org_scan must env -u RUNNER_SESSION_DIR/KEEP around secret-audit'
fi

printf '\n=== static: batch-run does not write markers into local clones ===\n'
batch_scan_args=""
batch_marker_code=""
if [[ -f "$batch" ]]; then
  batch_scan_args="$(grep -F 'scan_args=(--all' "$batch" || true)"
  # Ignore comment lines: the rationale comment names the flag on purpose.
  batch_marker_code="$(grep -F -- '--write-marker' "$batch" | grep -v '^[[:space:]]*#' || true)"
fi
if [[ -n "$batch_scan_args" ]] \
  && ! grep -qF -- '--write-marker' <<<"$batch_scan_args" \
  && [[ -z "$batch_marker_code" ]] \
  && grep -qF 'repository-helpers#534' "$batch"; then
  pass_case 'batch-run omits --write-marker so the primary clone stays clean (#534)'
else
  fail_case 'batch-run must not pass --write-marker (dirties primary clone; lint reads remote)'
fi

printf '\n=== static: docs state the timer does not write markers ===\n'
sa_doc="${rh_root}/docs/secret-audit-trufflehog.md"
if [[ -f "$sa_doc" ]] \
  && grep -qiF 'host timer does not write markers' "$sa_doc" \
  && grep -qF 'repository-helpers#534' "$sa_doc" \
  && grep -qF 'intake artifact written by an operator' "$sa_doc"; then
  pass_case 'docs describe marker as operator intake artifact, not a nightly heartbeat'
else
  fail_case 'docs must state the host timer does not write markers (#534)'
fi

printf '\n=== summary ===\n'
printf 'Passed: %s  Failed: %s\n' "$pass" "$fail"
if (( fail > 0 )); then
  exit 1
fi
