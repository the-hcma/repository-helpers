#!/usr/bin/env bash
# Smoke and static tests for scripts/dev/ship-and-review (M2 dev glue).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

ship_script="${script_dir}/../scripts/dev/ship-and-review"
rollout_script="${script_dir}/../scripts/dev/rollout-agent-review"
plan="${script_dir}/../agent-review.plan.md"

pass=0
fail=0

printf '=== ship-and-review --help ===\n'
if help_out="$(bash "$ship_script" --help 2>&1)" \
  && [[ "$help_out" == *'ship-and-review'* ]] \
  && [[ "$help_out" == *'--no-agent-review'* ]] \
  && [[ "$help_out" == *'--no-submit'* ]]; then
  printf '[PASS] ship-and-review: --help documents flags\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ship-and-review: --help missing expected flags\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: ship-and-review wiring ===\n'
if grep -qF 'pre-pr-checks' "$ship_script" \
  && grep -qF 'ensure-submit-clean-tree' "$ship_script" \
  && grep -qF 'lib/stacking-tool' "$ship_script" \
  && grep -qF 'stacking_tool_submit' "$ship_script" \
  && grep -qF 'post-pr-submission-checks' "$ship_script" \
  && grep -qF -- '--no-wait-ci' "$ship_script" \
  && grep -qF -- '--no-wait' "$ship_script" \
  && grep -qF 'wait-for-agent-review' "$ship_script" \
  && grep -qF 'loop --pr' "$ship_script" \
  && grep -qF 'dev_assert_stack_worktree' "$ship_script" \
  && grep -qF 'dev_assert_main_worktree_clean' "$ship_script" \
  && grep -qF 'no-agent-review' "$ship_script"; then
  printf '[PASS] ship-and-review: chains pre-pr, submit, CI, agent loop\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ship-and-review: missing step wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: ship-and-review runner adoption ===\n'
if grep -qF 'lib/runner-bootstrap' "$ship_script" \
  && grep -qF 'runner_exec_stdout "ship-and-review gh pr list for branch"' "$ship_script" \
  && grep -qF 'runner_exec_stdout "ship-and-review git branch show-current"' "$ship_script" \
  && grep -qF 'stacking_tool_submit' "$ship_script"; then
  printf '[PASS] ship-and-review: git/gh/stacking-tool via helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ship-and-review: missing runner adoption wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== rollout-agent-review --help ===\n'
if help_out="$(bash "$rollout_script" --help 2>&1)" \
  && [[ "$help_out" == *'rollout-agent-review'* ]] \
  && [[ "$help_out" == *'--apply-fix'* ]] \
  && [[ "$help_out" == *'--suggest'* ]]; then
  printf '[PASS] rollout-agent-review: --help documents modes\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rollout-agent-review: --help missing expected text\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: rollout-agent-review wiring ===\n'
if grep -qF 'github-repo-lint' "$rollout_script" \
  && grep -qF ' --all' "$rollout_script" \
  && grep -qF 'apply-fix' "$rollout_script" \
  && grep -qF 'suggest' "$rollout_script"; then
  printf '[PASS] rollout-agent-review: wraps github-repo-lint --all\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rollout-agent-review: missing github-repo-lint wrapper\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: agent-review.plan.md milestones ===\n'
if [[ -f "$plan" ]] \
  && grep -qF 'workstream complete' "$plan" \
  && grep -qF '| **M2**' "$plan" \
  && grep -qF '**Done**' "$plan" \
  && grep -qF 'ensure-submit-clean-tree' "$plan" \
  && grep -qF 'quota preamble' "$plan" \
  && grep -qF 'scripts/dev/rollout-agent-review' "$plan"; then
  printf '[PASS] agent-review.plan.md: workstream complete with closeout docs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-review.plan.md: missing workstream complete or closeout docs\n'
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %s passed, %s failed ---\n' "$pass" "$fail"
if (( fail > 0 )); then
  exit 1
fi
