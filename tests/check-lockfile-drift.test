#!/usr/bin/env bash
# Smoke tests for scripts/check-lockfile-drift.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/check-lockfile-drift"
readonly script

pass=0
fail=0

make_stub_bin() {
  local dir="$1"
  local name="$2"
  local body="$3"
  mkdir -p "$dir"
  printf '%s\n' "#!/usr/bin/env bash" "set -euo pipefail" "$body" >"${dir}/${name}"
  chmod +x "${dir}/${name}"
}

printf '\n=== --help ===\n'
help_out=""
help_rc=0
help_out="$(bash "$script" --help 2>&1)" || help_rc=$?
assert_exit_0 "--help" "$help_out" "$help_rc"
assert_contains "--help" "$help_out" "USAGE:"

printf '\n=== strict: uv drift fails ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "x"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv 'echo "drift"; exit 2'

strict_out=""
strict_rc=0
strict_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" --strict 2>&1)" || strict_rc=$?
rm -rf "$tmp_repo"

if [[ "$strict_rc" -ne 0 ]] && [[ "$strict_out" == *"uv.lock appears out of date"* ]]; then
  printf '[PASS] strict-uv: exits non-zero and reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] strict-uv: expected non-zero and drift message, got rc=%s\n%s\n' "$strict_rc" "$strict_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== warn: uv drift does not fail ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "x"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv 'echo "drift"; exit 2'

warn_out=""
warn_rc=0
warn_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" 2>&1)" || warn_rc=$?
rm -rf "$tmp_repo"

if [[ "$warn_rc" -eq 0 ]] && [[ "$warn_out" == *"uv.lock appears out of date"* ]]; then
  printf '[PASS] warn-uv: exits 0 and reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] warn-uv: expected rc=0 and drift message, got rc=%s\n%s\n' "$warn_rc" "$warn_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== strict: cleanup removes temp worktree ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "x"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv 'exit 0'

pre_wt_count="$(git -C "$tmp_repo" worktree list --porcelain | grep -c '^worktree ' || true)"
PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" >/dev/null 2>&1 || true
post_wt_count="$(git -C "$tmp_repo" worktree list --porcelain | grep -c '^worktree ' || true)"
rm -rf "$tmp_repo"

if [[ "$pre_wt_count" == "$post_wt_count" ]]; then
  printf '[PASS] cleanup: worktree count unchanged after run\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cleanup: expected worktree count unchanged (%s -> %s)\n' "$pre_wt_count" "$post_wt_count"
  fail=$(( fail + 1 ))
fi

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary

