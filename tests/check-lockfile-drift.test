#!/usr/bin/env bash
# Smoke tests for scripts/check-lockfile-drift.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/check-lockfile-drift"
readonly script
lib="${script_dir}/../scripts/lib/lockfile-drift"
readonly lib

pass=0
fail=0

make_stub_bin() {
  local dir="$1"
  local name="$2"
  local body="$3"
  mkdir -p "$dir"
  printf '%s\n' "#!/usr/bin/env bash" "set -euo pipefail" "$body" >"${dir}/${name}"
  chmod +x "${dir}/${name}"
}

printf '\n=== --help ===\n'
help_out=""
help_rc=0
help_out="$(bash "$script" --help 2>&1)" || help_rc=$?
assert_exit_0 "--help" "$help_out" "$help_rc"
assert_contains "--help" "$help_out" "USAGE:"

printf '\n=== strict: uv drift fails ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "x"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv 'echo "drift"; exit 2'

strict_out=""
strict_rc=0
strict_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" --strict 2>&1)" || strict_rc=$?
rm -rf "$tmp_repo"

if [[ "$strict_rc" -ne 0 ]] && [[ "$strict_out" == *"uv.lock appears out of date"* ]]; then
  printf '[PASS] strict-uv: exits non-zero and reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] strict-uv: expected non-zero and drift message, got rc=%s\n%s\n' "$strict_rc" "$strict_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== warn: uv drift does not fail ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "x"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv 'echo "drift"; exit 2'

warn_out=""
warn_rc=0
warn_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" 2>&1)" || warn_rc=$?
rm -rf "$tmp_repo"

if [[ "$warn_rc" -eq 0 ]] && [[ "$warn_out" == *"uv.lock appears out of date"* ]]; then
  printf '[PASS] warn-uv: exits 0 and reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] warn-uv: expected rc=0 and drift message, got rc=%s\n%s\n' "$warn_rc" "$warn_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== strict: cargo drift fails ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[package]\nname = "x"\nversion = "0.1.0"\nedition = "2021"\n' >"${tmp_repo}/Cargo.toml"
printf '# fake\n' >"${tmp_repo}/Cargo.lock"
git -C "$tmp_repo" add Cargo.toml Cargo.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" cargo 'echo "drift"; exit 1'

strict_out=""
strict_rc=0
strict_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" --strict 2>&1)" || strict_rc=$?
rm -rf "$tmp_repo"

if [[ "$strict_rc" -ne 0 ]] && [[ "$strict_out" == *"Cargo.lock appears out of date"* ]]; then
  printf '[PASS] strict-cargo: exits non-zero and reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] strict-cargo: expected non-zero and drift message, got rc=%s\n%s\n' "$strict_rc" "$strict_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== warn: cargo drift does not fail ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[package]\nname = "x"\nversion = "0.1.0"\nedition = "2021"\n' >"${tmp_repo}/Cargo.toml"
printf '# fake\n' >"${tmp_repo}/Cargo.lock"
git -C "$tmp_repo" add Cargo.toml Cargo.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" cargo 'echo "drift"; exit 1'

warn_out=""
warn_rc=0
warn_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" 2>&1)" || warn_rc=$?
rm -rf "$tmp_repo"

if [[ "$warn_rc" -eq 0 ]] && [[ "$warn_out" == *"Cargo.lock appears out of date"* ]]; then
  printf '[PASS] warn-cargo: exits 0 and reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] warn-cargo: expected rc=0 and drift message, got rc=%s\n%s\n' "$warn_rc" "$warn_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== strict: cleanup removes temp worktree ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "x"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv 'exit 0'

pre_wt_count="$(git -C "$tmp_repo" worktree list --porcelain | grep -c '^worktree ' || true)"
PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" >/dev/null 2>&1 || true
post_wt_count="$(git -C "$tmp_repo" worktree list --porcelain | grep -c '^worktree ' || true)"
rm -rf "$tmp_repo"

if [[ "$pre_wt_count" == "$post_wt_count" ]]; then
  printf '[PASS] cleanup: worktree count unchanged after run\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cleanup: expected worktree count unchanged (%s -> %s)\n' "$pre_wt_count" "$post_wt_count"
  fail=$(( fail + 1 ))
fi

printf '\n=== strict: uv lock --check drift fails ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "demo"\nversion = "0.2.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv "if [[ \"\${1:-}\" == \"lock\" && \"\${2:-}\" == \"--check\" ]]; then echo needs-update; exit 1; fi; exit 0"

strict_out=""
strict_rc=0
strict_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" --strict --no-worktree 2>&1)" || strict_rc=$?
rm -rf "$tmp_repo"

if [[ "$strict_rc" -ne 0 ]] && [[ "$strict_out" == *"uv.lock appears out of date"* ]]; then
  printf '[PASS] strict-uv-check: exits non-zero when uv lock --check reports drift\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] strict-uv-check: expected lock --check drift failure, got rc=%s\n%s\n' "$strict_rc" "$strict_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== warn: pnpm workspace manifest newer than lock ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
mkdir -p "${tmp_repo}/web"
printf 'packages:\n  - web\n' >"${tmp_repo}/pnpm-workspace.yaml"
printf 'lockfileVersion: 9.0\n' >"${tmp_repo}/pnpm-lock.yaml"
printf '{"name":"web","version":"1.0.1"}\n' >"${tmp_repo}/web/package.json"
touch -d '2000-01-01' "${tmp_repo}/pnpm-lock.yaml"
touch -d '2000-01-02' "${tmp_repo}/web/package.json"
git -C "$tmp_repo" add pnpm-workspace.yaml pnpm-lock.yaml web/package.json
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

warn_out=""
warn_rc=0
warn_out="$(bash "$script" --repo "$tmp_repo" --no-worktree 2>&1)" || warn_rc=$?
rm -rf "$tmp_repo"

if [[ "$warn_rc" -eq 0 ]] && [[ "$warn_out" == *"package.json newer than pnpm-lock.yaml: web/package.json"* ]]; then
  printf '[PASS] warn-pnpm-workspace: detects web/package.json drift without root package.json\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] warn-pnpm-workspace: expected web/package.json drift warning, got rc=%s\n%s\n' "$warn_rc" "$warn_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== warn: uv lock --check in-sync passes ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "demo"\nversion = "0.1.0"\n' >"${tmp_repo}/pyproject.toml"
printf '# fake\n' >"${tmp_repo}/uv.lock"
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv "if [[ \"\${1:-}\" == \"lock\" && \"\${2:-}\" == \"--check\" ]]; then exit 0; fi; exit 0"

sync_out=""
sync_rc=0
sync_out="$(PATH="${stub_bin}:${PATH}" bash "$script" --repo "$tmp_repo" --no-worktree 2>&1)" || sync_rc=$?
rm -rf "$tmp_repo"

if [[ "$sync_rc" -eq 0 ]] && [[ "$sync_out" != *"uv.lock appears out of date"* ]]; then
  printf '[PASS] warn-uv-check: exits 0 when uv lock --check reports in sync\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] warn-uv-check: expected in-sync pass, got rc=%s\n%s\n' "$sync_rc" "$sync_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== remediate: uv drift auto-fixed ===\n'
tmp_repo="$(mktemp -d)"
git -C "$tmp_repo" init -q
git -C "$tmp_repo" remote add origin "https://github.com/example/example.git"
printf '[project]\nname = "demo"\nversion = "0.2.0"\n' >"${tmp_repo}/pyproject.toml"
cat >"${tmp_repo}/uv.lock" <<'EOF'
[[package]]
name = "demo"
version = "0.1.0"
source = { editable = "." }
EOF
git -C "$tmp_repo" add pyproject.toml uv.lock
git -C "$tmp_repo" -c user.name="CI" -c user.email="ci@example.invalid" commit -m "init" -q

stub_bin="${tmp_repo}/stub-bin"
make_stub_bin "$stub_bin" uv "if [[ \"\${1:-}\" == \"lock\" && \"\${2:-}\" == \"--check\" ]]; then exit 1; fi
if [[ \"\${1:-}\" == \"lock\" ]]; then
  cat >\"${tmp_repo}/uv.lock\" <<'LOCK'
[[package]]
name = \"demo\"
version = \"0.2.0\"
source = { editable = \".\" }
LOCK
  exit 0
fi
exit 0"

remediate_out=""
remediate_rc=0
remediate_out="$(
  PATH="${stub_bin}:${PATH}" bash -c '
    # shellcheck source=/dev/null
    source "'"$lib"'"
    lockfile_drift_remediate_repo --repo-dir "'"$tmp_repo"'" --strict 0
  ' 2>&1
)" || remediate_rc=$?
rm -rf "$tmp_repo"

if [[ "$remediate_rc" -eq 0 ]] && [[ "$remediate_out" == *"Regenerating uv.lock"* ]] \
  && [[ "$remediate_out" == *"Lockfiles updated locally"* ]]; then
  printf '[PASS] remediate-uv: regenerates uv.lock and passes re-check\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] remediate-uv: expected auto-fix, got rc=%s\n%s\n' "$remediate_rc" "$remediate_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary

