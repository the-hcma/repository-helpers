#!/usr/bin/env bash
# Tests for scripts/lib/github-repo-slug.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir}/.."
readonly rh_root

lib="${rh_root}/scripts/lib/github-repo-slug"
readonly lib

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"

pass=0
fail=0

printf '\n=== static: library exists ===\n'
if [[ -f "$lib" ]]; then
  printf '[PASS] github-repo-slug library exists\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing scripts/lib/github-repo-slug\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: slug and visibility helpers ===\n'
if grep -qF 'gh_slug_from_origin_url' "$lib" \
  && grep -qF 'gh_slug_from_repo_dir' "$lib" \
  && grep -qF 'gh_repo_is_private' "$lib" \
  && grep -qF 'gh_repo_is_archived' "$lib" \
  && grep -qF '_gh_slug_git_remote_url' "$lib" \
  && grep -qF '.private' "$lib" \
  && grep -qF '.archived' "$lib"; then
  printf '[PASS] github-repo-slug defines slug and visibility helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] expected slug and visibility helpers in github-repo-slug\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: origin and visibility lookups use runner --probe ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'github-repo-slug git remote get-url origin" --probe' "$lib" \
  && grep -qF 'github-repo-slug gh repo visibility" --probe' "$lib" \
  && grep -qF 'github-repo-slug gh repo archived" --probe' "$lib" \
  && grep -qF 'github_api_exec_with_rate_limit_retry "github-repo-slug gh repo visibility"' "$lib" \
  && grep -qF 'github_api_exec_with_rate_limit_retry "github-repo-slug gh repo archived"' "$lib"; then
  printf '[PASS] github-repo-slug: origin/visibility/archived use --probe and waiter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] github-repo-slug: expected --probe and waiter on origin and gh api lookups\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gh_slug_from_origin_url ===\n'
# shellcheck disable=SC1090,SC1091
source "$lib"

slug_out=""
slug_out="$(gh_slug_from_origin_url 'git@github.com:the-hcma/example-repo.git')"
assert_contains 'gh_slug_from_origin_url parses ssh origin' "$slug_out" 'the-hcma/example-repo'

slug_out="$(gh_slug_from_origin_url 'https://github.com/the-hcma/other-repo')"
assert_contains 'gh_slug_from_origin_url parses https origin' "$slug_out" 'the-hcma/other-repo'

slug_exit=0
slug_out="$(gh_slug_from_origin_url 'https://gitlab.com/group/project' 2>/dev/null)" || slug_exit=$?
if [[ "$slug_exit" -ne 0 ]]; then
  printf '[PASS] gh_slug_from_origin_url rejects non-GitHub host\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_slug_from_origin_url should reject non-GitHub host (got %s)\n' "$slug_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gh_slug_from_repo_dir ===\n'
repo_tmp="$(mktemp -d)"
git -C "$repo_tmp" -c user.name=test -c user.email=test@example.com init -q
git -C "$repo_tmp" -c user.name=test -c user.email=test@example.com \
  remote add origin 'https://github.com/the-hcma/mock-repo.git'

slug_out="$(gh_slug_from_repo_dir "$repo_tmp")"
assert_contains 'gh_slug_from_repo_dir reads origin remote' "$slug_out" 'the-hcma/mock-repo'
rm -rf "$repo_tmp"

printf '\n=== functional: gh_repo_is_private with mocked gh ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'.private'* && "$args" == *'repos/the-hcma/public-repo'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'.private'* && "$args" == *'repos/the-hcma/private-repo'* ]]; then
  printf 'true\n'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

priv_exit=0
PATH="${mock_bin}:${PATH}" gh_repo_is_private 'the-hcma/public-repo' || priv_exit=$?
if [[ "$priv_exit" -eq 1 ]]; then
  printf '[PASS] gh_repo_is_private returns 1 for public repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_repo_is_private should return 1 for public repo (exit=%s)\n' "$priv_exit"
  fail=$(( fail + 1 ))
fi

priv_exit=0
PATH="${mock_bin}:${PATH}" gh_repo_is_private 'the-hcma/private-repo' || priv_exit=$?
if [[ "$priv_exit" -eq 0 ]]; then
  printf '[PASS] gh_repo_is_private returns 0 for private repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_repo_is_private should return 0 for private repo (exit=%s)\n' "$priv_exit"
  fail=$(( fail + 1 ))
fi

priv_exit=0
PATH="${mock_bin}:${PATH}" gh_repo_is_private 'the-hcma/missing-repo' || priv_exit=$?
if [[ "$priv_exit" -eq 2 ]]; then
  printf '[PASS] gh_repo_is_private returns 2 on gh error\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_repo_is_private should return 2 on gh error (exit=%s)\n' "$priv_exit"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== functional: gh_repo_is_archived with mocked gh ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'.archived'* && "$args" == *'repos/the-hcma/active-repo'* ]]; then
  printf 'false\n'
  exit 0
fi
if [[ "$args" == *'.archived'* && "$args" == *'repos/the-hcma/archived-repo'* ]]; then
  printf 'true\n'
  exit 0
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

arch_exit=0
PATH="${mock_bin}:${PATH}" gh_repo_is_archived 'the-hcma/active-repo' || arch_exit=$?
if [[ "$arch_exit" -eq 1 ]]; then
  printf '[PASS] gh_repo_is_archived returns 1 for active repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_repo_is_archived should return 1 for active repo (exit=%s)\n' "$arch_exit"
  fail=$(( fail + 1 ))
fi

arch_exit=0
PATH="${mock_bin}:${PATH}" gh_repo_is_archived 'the-hcma/archived-repo' || arch_exit=$?
if [[ "$arch_exit" -eq 0 ]]; then
  printf '[PASS] gh_repo_is_archived returns 0 for archived repo\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_repo_is_archived should return 0 for archived repo (exit=%s)\n' "$arch_exit"
  fail=$(( fail + 1 ))
fi

arch_exit=0
PATH="${mock_bin}:${PATH}" gh_repo_is_archived 'the-hcma/missing-repo' || arch_exit=$?
if [[ "$arch_exit" -eq 2 ]]; then
  printf '[PASS] gh_repo_is_archived returns 2 on gh error\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gh_repo_is_archived should return 2 on gh error (exit=%s)\n' "$arch_exit"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== summary ===\n'
printf '%s passed, %s failed\n' "$pass" "$fail"
[[ "$fail" -eq 0 ]]
