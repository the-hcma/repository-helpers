#!/usr/bin/env bash
# Tests for scripts/lib/ci-check-rollup.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/ci-check-rollup"
readonly lib

# shellcheck disable=SC1091  # runner-bootstrap begins session for ci_rollup_jq_file
source "${script_dir}/../scripts/lib/runner-bootstrap"

# shellcheck disable=SC1090,SC1091
source "$lib"

pass=0
fail=0

printf '\n=== functional: ci_rollup_failed_lines extracts failure context ===\n'
rollup='[
  {"name":"lint","conclusion":"SUCCESS","detailsUrl":"https://example.com/ok"},
  {"name":"test","conclusion":"FAILURE","detailsUrl":"https://example.com/run/1"}
]'
lines="$(ci_rollup_failed_lines "$rollup")"
if grep -qF $'test\tFAILURE\thttps://example.com/run/1' <<<"$lines"; then
  printf '[PASS] failed-lines: extracts failing check name, conclusion, and URL\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] failed-lines: expected test FAILURE line; got: %s\n' "$lines"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ci_rollup_has_pending_or_in_progress detects in-flight checks ===\n'
pending='[{"name":"ci","conclusion":"","detailsUrl":""}]'
if ci_rollup_has_pending_or_in_progress "$pending"; then
  printf '[PASS] pending: empty conclusion is treated as in progress\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pending: expected in-progress rollup to be detected\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ci_rollup_failure_details_json returns structured array ===\n'
details="$(ci_rollup_failure_details_json "$rollup")"
if jq -e '.[0].name == "test" and .[0].conclusion == "FAILURE"' >/dev/null <<<"$details"; then
  printf '[PASS] failure-json: structured failure details are emitted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] failure-json: unexpected payload: %s\n' "$details"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: required contexts block premature Graphite-only success ===\n'
graphite_only='[{"name":"Graphite / mergeability_check","conclusion":"SUCCESS","status":"COMPLETED"}]'
required=$'shellcheck\nci'
if [[ "$(ci_rollup_conclusion_for_gating "$graphite_only" "$required")" == 'pending' ]]; then
  printf '[PASS] gating: Graphite-only rollup stays pending until required ci.yml contexts appear\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gating: expected pending for Graphite-only rollup with required contexts\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gating succeeds when required contexts are green ===\n'
all_green='[
  {"name":"Graphite / mergeability_check","conclusion":"SUCCESS","status":"COMPLETED"},
  {"name":"shellcheck","conclusion":"SUCCESS","status":"COMPLETED"},
  {"name":"ci","conclusion":"SUCCESS","status":"COMPLETED"}
]'
if [[ "$(ci_rollup_conclusion_for_gating "$all_green" "$required")" == 'success' ]]; then
  printf '[PASS] gating: all required contexts green returns success\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gating: expected success when required contexts are green\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: gating fails fast on any failure ===\n'
with_failure='[
  {"name":"shellcheck","conclusion":"FAILURE","status":"COMPLETED"},
  {"name":"ci","conclusion":"SUCCESS","status":"COMPLETED"}
]'
if [[ "$(ci_rollup_conclusion_for_gating "$with_failure" "$required")" == 'failure' ]]; then
  printf '[PASS] gating: any failing check returns failure immediately\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] gating: expected failure when a rollup check failed\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: discover required contexts from ci.yml ===\n'
sample_ci='jobs:
  guard:
    steps: []
  shellcheck:
    steps: []
  secret-scan:
    name: Secret Scan
    steps: []
  ci:
    steps: []
'
discovered="$(ci_discover_required_contexts_from_ci_yml_text "$sample_ci")"
if printf '%s\n' "$discovered" | grep -qxF 'shellcheck' \
  && printf '%s\n' "$discovered" | grep -qxF 'ci' \
  && ! printf '%s\n' "$discovered" | grep -qxF 'guard' \
  && ! printf '%s\n' "$discovered" | grep -qxF 'Secret Scan'; then
  printf '[PASS] discover: reads job ids, skips optional guard/secret-scan jobs\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] discover: unexpected contexts:\n%s\n' "$discovered"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: latest-by-name ignores superseded CANCELLED ===\n'
superseded='[
  {"name":"shellcheck + tests","conclusion":"CANCELLED","startedAt":"2026-06-19T18:09:07Z","status":"COMPLETED"},
  {"name":"shellcheck + tests","conclusion":"SUCCESS","startedAt":"2026-06-19T18:09:42Z","status":"COMPLETED"}
]'
if latest="$(ci_rollup_latest_by_name_json "$superseded")" \
  && [[ "$(printf '%s' "$latest" | jq -r '.[0].conclusion')" == 'SUCCESS' ]] \
  && [[ "$(ci_rollup_conclusion_for_gating "$latest" "")" == 'success' ]]; then
  printf '[PASS] rollup: latest-by-name prefers newest SUCCESS over stale CANCELLED\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rollup: latest-by-name still treats superseded CANCELLED as failure\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: normalize maps StatusContext state to conclusion ===\n'
status_ctx='[{"__typename":"StatusContext","context":"CodeRabbit","state":"SUCCESS"}]'
if normalized="$(ci_rollup_normalize_json "$status_ctx")" \
  && [[ "$(printf '%s' "$normalized" | jq -r '.[0].conclusion')" == 'SUCCESS' ]] \
  && ! ci_rollup_has_pending_or_in_progress "$normalized"; then
  printf '[PASS] rollup: StatusContext SUCCESS is not pending\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rollup: StatusContext state not normalized for gating\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: pr gating waits on pending and supersedes CANCELLED ===\n'
superseded_pending='[
  {"name":"Backend Tests","conclusion":"CANCELLED","startedAt":"2026-06-25T07:09:12Z","status":"COMPLETED"},
  {"name":"Backend Tests","conclusion":"","startedAt":"2026-06-25T07:10:29Z","status":"IN_PROGRESS"}
]'
if ci_rollup_has_pending_or_in_progress "$(ci_rollup_normalize_json "$superseded_pending")" \
  && [[ "$(ci_rollup_conclusion_for_gating "$(ci_rollup_latest_by_name_json "$(ci_rollup_normalize_json "$superseded_pending")")" "")" != 'failure' ]]; then
  printf '[PASS] rollup: pending in-progress run blocks failure on stale CANCELLED\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] rollup: should treat superseded CANCELLED as pending while rerun is active\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ci_failure_details_json_from_rollup emits PR and check URLs ===\n'
rollup='[
  {"name":"lint","conclusion":"SUCCESS","detailsUrl":"https://example.com/ok"},
  {"name":"shellcheck + tests","conclusion":"FAILURE","detailsUrl":"https://example.com/run/482"}
]'
details="$(ci_failure_details_json_from_rollup 482 'the-hcma/mock-repo' 'dep-updater/bump' "$rollup")"
if jq -e '.pr == 482
  and .pr_url == "https://github.com/the-hcma/mock-repo/pull/482"
  and .check_name == "shellcheck + tests"
  and .check_conclusion == "FAILURE"
  and .check_url == "https://example.com/run/482"' >/dev/null <<<"$details"; then
  printf '[PASS] ci-failure-details: structured PR and check URLs are emitted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ci-failure-details: unexpected payload: %s\n' "$details"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ci_failure_summary_from_details_json preserves legacy text ===\n'
summary="$(ci_failure_summary_from_details_json "$details")"
if [[ "$summary" == 'check=shellcheck + tests conclusion=FAILURE url=https://example.com/run/482 pr_url=https://github.com/the-hcma/mock-repo/pull/482 branch=dep-updater/bump' ]]; then
  printf '[PASS] ci-failure-summary: details JSON maps to legacy summary text\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] ci-failure-summary: unexpected summary: %s\n' "$summary"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: ci_rollup_without_agent_product_checks drops CodeRabbit/Bugbot ===\n'
mixed='[
  {"name":"shellcheck + tests","conclusion":"SUCCESS","detailsUrl":"https://example.com/ok"},
  {"name":"CodeRabbit","conclusion":"","detailsUrl":""},
  {"name":"Cursor Bugbot","conclusion":"IN_PROGRESS","detailsUrl":""},
  {"name":"vortex-v1","conclusion":"PENDING","detailsUrl":""}
]'
filtered="$(ci_rollup_without_agent_product_checks "$mixed")"
if ! ci_rollup_has_pending_or_in_progress "$filtered" \
  && [[ "$(jq -r '[.[].name] | join(",")' <<<"$filtered")" == 'shellcheck + tests' ]]; then
  printf '[PASS] without-agent-checks: pending CodeRabbit/Bugbot/vortex excluded from CI gate\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] without-agent-checks: unexpected filter result: %s\n' "$filtered"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: pr gating ignores pending CodeRabbit when required CI is green ===\n'
# Hermetic stub: override ci_rollup_json_for_pr with a fixture that has green required CI
# plus a pending CodeRabbit StatusContext (#401 cloudflare-dns-updater failure mode).
gating_fixture='[
  {"name":"Guard","conclusion":"SUCCESS","status":"COMPLETED"},
  {"name":"Pytest (hermetic)","conclusion":"SUCCESS","status":"COMPLETED"},
  {"__typename":"StatusContext","context":"CodeRabbit","state":"PENDING"}
]'
gating_required=$'Guard\nPytest (hermetic)'
gating_result="$(
  ci_rollup_json_for_pr() { printf '%s\n' "$gating_fixture"; }
  ci_rollup_conclusion_for_pr_gating '91' 'the-hcma/mock-repo' "$gating_required"
)"
if [[ "$gating_result" == 'success' ]]; then
  printf '[PASS] pr-gating: pending CodeRabbit does not block success when required CI is green (#401)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pr-gating: expected success with pending CodeRabbit; got %s\n' "$gating_result"
  fail=$(( fail + 1 ))
fi

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
