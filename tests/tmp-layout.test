#!/usr/bin/env bash
# Tests for scripts/lib/tmp-layout and scripts/dev/with-tmp-layout (#832).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
lib="${script_dir}/../scripts/lib/tmp-layout"
wrapper="${script_dir}/../scripts/dev/with-tmp-layout"
readonly lib wrapper

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck does not use -x
source "${script_dir}/lib/test-assert"
test_init

fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT
export TMPDIR="${fixture}/tmp"
mkdir -p "$TMPDIR"
repo="${fixture}/proj"
git init --quiet "$repo"
git -C "$repo" remote add origin https://github.com/example/widget.git
git -C "$repo" -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false \
  commit --quiet --allow-empty -m init
git -C "$repo" checkout --quiet -b feat/foo

# shellcheck disable=SC1091  # runner-bootstrap begins the session the library runs git through
source "${script_dir}/../scripts/lib/runner-bootstrap"
# shellcheck source=scripts/lib/tmp-layout
source "$lib"

printf '\n=== functional: path layout ===\n'
assert_contains 'project is the origin repository name' "$(tmp_layout_project "$repo")" 'widget'
assert_contains 'branch keeps its slash' "$(tmp_layout_branch "$repo")" 'feat/foo'
assert_contains 'tool directory is TMPDIR/project/branch/tool' "$(tmp_layout_dir pytest "$repo")" "${TMPDIR}/widget/feat/foo/pytest"
sha="$(git -C "$repo" rev-parse --short HEAD)"
git -C "$repo" checkout --quiet --detach
assert_contains 'detached HEAD uses detached-head/<sha>' "$(tmp_layout_branch "$repo")" "detached-head/${sha}"
git -C "$repo" checkout --quiet feat/foo
rc=0
tmp_layout_dir '../x' "$repo" >/dev/null 2>&1 || rc=$?
assert_contains 'a tool name that escapes the layout is refused' "rc=${rc}" 'rc=1'
rc=0
TMP_LAYOUT_RETENTION_DAYS=abc tmp_layout_retention_days >/dev/null 2>&1 || rc=$?
assert_contains 'a non-numeric retention is an error' "rc=${rc}" 'rc=1'

printf '\n=== functional: finish ===\n'
dir="$(tmp_layout_prepare pytest "$repo")"
assert_contains 'prepare creates the tool directory without a marker' "$(test -d "$dir" && test ! -e "${dir}/.tmp-layout-marker" && echo yes)" 'yes'
run_a="$(tmp_layout_run_dir "$dir")"
run_b="$(tmp_layout_run_dir "$dir")"
assert_contains 'two runs on one branch get different directories' "$(test "$run_a" != "$run_b" && echo different)" 'different'
tmp_layout_finish "$run_a" 0
assert_contains 'a passing run removes only its own directory' "$(test -e "$run_a" && echo present || echo gone)$(test -d "$run_b" && echo present || echo gone)" 'gonepresent'
assert_contains 'a concurrent run keeps the tool directory' "$(test -d "$dir" && echo yes)" 'yes'
assert_contains 'a run directory is marked' "$(test -f "${run_b}/.tmp-layout-marker" && echo yes)" 'yes'
tmp_layout_finish "$run_b" 0
assert_contains 'the last passing run removes the tool directory' "$(test -e "$dir" && echo present || echo gone)" 'gone'
assert_contains 'the last passing run leaves the private project directory empty, not removed' "$(test -d "${TMPDIR}/widget" && find "${TMPDIR}/widget" -mindepth 1 | wc -l | tr -d ' ')" '0'
dir="$(tmp_layout_prepare pytest "$repo")"
run_a="$(tmp_layout_run_dir "$dir")"
err="$(tmp_layout_finish "$run_a" 1 2>&1)"
assert_contains 'a failing run keeps its run directory' "$(test -d "$run_a" && echo present || echo gone)" 'present'
assert_contains 'a failing run says where the directory is' "$err" "keeping ${run_a} for debugging"
rc=0
tmp_layout_finish "${TMPDIR}/nowhere/run.x" 0 || rc=$?
assert_contains 'finishing a directory that vanished does not fail' "rc=${rc}" 'rc=0'
saved_tmpdir="$TMPDIR"
TMPDIR="${saved_tmpdir}/"
dir="$(tmp_layout_prepare pytest "$repo")"
run_a="$(tmp_layout_run_dir "$dir")"
tmp_layout_finish "$run_a" 0
TMPDIR="$saved_tmpdir"
assert_contains 'a TMPDIR with a trailing slash is never removed by the cleanup' "$(test -d "$TMPDIR" && echo present)" 'present'
rm -rf "${TMPDIR:?}/widget"

printf '\n=== functional: stale sweep ===\n'
mkdir -p "${TMPDIR}/widget"
chmod 700 "${TMPDIR}/widget"
old="${TMPDIR}/widget/feat/old/pytest"
mkdir -p "$old"
: >"${old}/.tmp-layout-marker"
touch -d '4 days ago' "${old}/.tmp-layout-marker"
fresh="${TMPDIR}/widget/feat/fresh/pytest"
mkdir -p "$fresh"
: >"${fresh}/.tmp-layout-marker"
touch -d '2 days ago' "${fresh}/.tmp-layout-marker"
unmarked="${TMPDIR}/widget/feat/unmarked"
mkdir -p "$unmarked"
touch -d '9 days ago' "$unmarked"
tmp_layout_prepare pytest "$repo" >/dev/null 2>&1
assert_contains 'a marked directory older than 3 days is removed' "$(test -e "$old" && echo present || echo gone)" 'gone'
assert_contains 'its empty branch directory is removed too' "$(test -e "${TMPDIR}/widget/feat/old" && echo present || echo gone)" 'gone'
assert_contains 'a marked directory younger than 3 days is kept' "$(test -d "$fresh" && echo present || echo gone)" 'present'
assert_contains 'an old directory without the marker is never removed' "$(test -d "$unmarked" && echo present || echo gone)" 'present'
TMP_LAYOUT_RETENTION_DAYS=1 tmp_layout_sweep_stale "$repo" 2>/dev/null
assert_contains 'the retention is configurable' "$(test -e "$fresh" && echo present || echo gone)" 'gone'

printf '\n=== functional: leftovers of a failed run age from that run ===\n'
dir="$(tmp_layout_prepare pytest "$repo")"
failed_run="$(tmp_layout_run_dir "$dir")"
touch -d '4 days ago' "${failed_run}/.tmp-layout-marker"
busy_dir="$(tmp_layout_prepare pytest "$repo" 2>/dev/null)"
busy_run="$(tmp_layout_run_dir "$busy_dir")"
assert_contains 'a busy branch does not keep a failed run old leftovers alive' "$(test -e "$failed_run" && echo present || echo gone)" 'gone'
assert_contains 'the sweep leaves the concurrent run directory alone' "$(test -d "$busy_run" && echo present || echo gone)" 'present'
rm -rf "${TMPDIR:?}/widget"

printf '\n=== functional: with-tmp-layout ===\n'
rm -rf "${TMPDIR:?}/widget"
# shellcheck disable=SC2016  # the variables must expand in the child, not here
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" pytest -- bash -c 'printf "%s\n%s" "$TMP_LAYOUT_DIR" "$PYTEST_ADDOPTS"')"
run_reported="$(head -n 1 <<<"$out")"
addopts="$(tail -n 1 <<<"$out")"
assert_contains 'the run directory is inside the tool directory of the branch' "$run_reported" "${TMPDIR}/widget/feat/foo/pytest/run."
assert_contains 'pytest gets --basetemp pointing inside the reported run directory' "$addopts" "--basetemp=${run_reported}/basetemp"
assert_contains 'a passing command leaves the project directory empty' "$(test -d "${TMPDIR}/widget" && find "${TMPDIR}/widget" -mindepth 1 | wc -l | tr -d ' ')" '0'
rc=0
(cd "$repo" && "$wrapper" pytest -- bash -c 'exit 7') >/dev/null 2>&1 || rc=$?
assert_contains 'the command exit status is returned' "rc=${rc}" 'rc=7'
assert_contains 'a failing command leaves its directory behind' "$(test -d "${TMPDIR}/widget/feat/foo/pytest" && echo present || echo gone)" 'present'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" uv -- bash -c 'printf "%s" "$UV_CACHE_DIR"')"
assert_contains 'uv gets its cache directory in the layout' "$out" "${TMPDIR}/widget/feat/foo/uv/cache"
assert_contains 'a package-manager directory is kept after success' "$(test -d "${TMPDIR}/widget/feat/foo/uv" && echo present || echo gone)" 'present'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" pnpm -- bash -c 'printf "%s" "$npm_config_store_dir"')"
assert_contains 'pnpm gets its store directory in the layout' "$out" "${TMPDIR}/widget/feat/foo/pnpm/store"
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && UV_CACHE_DIR=/explicit/uv "$wrapper" uv -- bash -c 'printf "%s" "$UV_CACHE_DIR"')"
assert_contains 'an explicitly set UV_CACHE_DIR is kept exactly' "<${out}>" '</explicit/uv>'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && npm_config_store_dir=/explicit/store "$wrapper" pnpm -- bash -c 'printf "%s" "$npm_config_store_dir"')"
assert_contains 'an explicitly set pnpm store is kept exactly' "<${out}>" '</explicit/store>'

printf '\n=== static: run-tests uses the layout ===\n'
assert_contains 'run-tests prepares its temp base through tmp_layout_prepare' "count=$(grep -c tmp_layout_prepare "${script_dir}/../scripts/dev/run-tests");" 'count=1;'

printf '\n=== functional: --keep and concurrent test runs ===\n'
rm -rf "${TMPDIR:?}/widget"
# shellcheck disable=SC2016  # the variable must expand in the child, not here
first="$(cd "$repo" && "$wrapper" --keep pytest -- bash -c 'printf "%s" "$TMP_LAYOUT_DIR"')"
# shellcheck disable=SC2016  # the variable must expand in the child, not here
second="$(cd "$repo" && "$wrapper" --keep pytest -- bash -c 'printf "%s" "$TMP_LAYOUT_DIR"')"
assert_contains 'two --keep pytest runs on one branch get different run directories' "$(test "$first" != "$second" && echo different)" 'different'
assert_contains '--keep leaves the passing run directory behind' "$(test -d "$first" && echo present || echo gone)" 'present'

printf '\n=== functional: unsafe or unresolvable layouts ===\n'
rm -rf "${TMPDIR:?}/widget"
mkdir -p "${fixture}/elsewhere"
ln -s "${fixture}/elsewhere" "${TMPDIR}/widget"
rc=0
err="$(tmp_layout_prepare pytest "$repo" 2>&1)" || rc=$?
assert_contains 'a project directory that is a symlink is refused' "rc=${rc}" 'rc=1'
assert_contains 'the refusal names the directory' "$err" "${TMPDIR}/widget must be a directory you own"
rm -f "${TMPDIR}/widget"
dir="$(tmp_layout_prepare pytest "$repo")"
assert_contains 'a new project directory is private to its owner' "$(stat --format=%a "${TMPDIR}/widget")" '700'
ln -s "${fixture}/elsewhere/victim" "${dir}/.tmp-layout-marker"
rc=0
tmp_layout_mark "$dir" 2>/dev/null || rc=$?
assert_contains 'a marker that is a symlink is refused' "rc=${rc}" 'rc=1'
assert_contains 'the symlink target is never created' "$(test -e "${fixture}/elsewhere/victim" && echo present || echo gone)" 'gone'
rm -rf "${TMPDIR:?}/widget"
git -C "$repo" remote set-url origin https://github.com/example/widget/
assert_contains 'an origin URL with a trailing slash still names the project' "$(tmp_layout_project "$repo")" 'widget'
git -C "$repo" remote set-url origin https://github.com/example/widget.git
plain="${fixture}/plain"
mkdir -p "${plain}/tests"
printf '#!/usr/bin/env bash\nexit 1\n' >"${plain}/tests/bad.test"
(cd "$plain" && "${script_dir}/../scripts/dev/run-tests" --dir "$plain") >/dev/null 2>&1 || true
assert_contains 'a failing run-tests outside git leaves no job directory behind' "$(find "$TMPDIR" -maxdepth 1 -name 'run-tests-job.*' | wc -l | tr -d ' ')" '0'

printf '\n=== functional: private project directory, quoting and the disposable gate TMPDIR ===\n'
rm -rf "${TMPDIR:?}/widget"
mkdir -m 700 "${TMPDIR}/widget"
chmod 770 "${TMPDIR}/widget"
rc=0
tmp_layout_prepare pytest "$repo" >/dev/null 2>&1 || rc=$?
assert_contains 'a group-writable project directory that we own is accepted' "rc=${rc}" 'rc=0'
assert_contains 'it is repaired so group and others cannot write to it' "$(find "${TMPDIR}/widget" -maxdepth 0 -perm /022 | wc -l | tr -d ' ')" '0'
rm -rf "${TMPDIR:?}/widget"
git -C "$repo" checkout --quiet -b 'feat/é'
rc=0
# shellcheck disable=SC2016  # the variable must expand in the child, not here
addopts="$(cd "$repo" && LC_ALL=C "$wrapper" pytest -- bash -c 'printf "%s" "$PYTEST_ADDOPTS"')" || rc=$?
assert_contains 'the wrapper succeeds on a non-ASCII branch' "rc=${rc}" 'rc=0'
assert_contains 'the non-ASCII branch name reached the basetemp path' "$addopts" 'feat/é/pytest/run.'
assert_contains 'a non-ASCII branch is single-quoted for shlex, not written in the dollar-quote form' "$addopts" "'--basetemp="
assert_contains 'the quoted option never uses the bash dollar-quote form' "$(case "$addopts" in *'$'"'"*) echo dollar-quoted ;; *) echo plain ;; esac)" 'plain'
git -C "$repo" checkout --quiet feat/foo
git -C "$repo" branch --quiet -D 'feat/é'
rm -rf "${TMPDIR:?}/widget"
disposable="${fixture}/disposable"
mkdir -p "$disposable"
mkdir -p "${repo}/tests"
printf '#!/usr/bin/env bash\nexit 1\n' >"${repo}/tests/bad.test"
gate_tmpdir="$TMPDIR"
(cd "$repo" && TMP_LAYOUT_TMPDIR="$gate_tmpdir" TMPDIR="$disposable" "${script_dir}/../scripts/dev/run-tests" --dir "$repo") >/dev/null 2>&1 || true
assert_contains 'a failing gate run keeps its artifacts under TMP_LAYOUT_TMPDIR, not the disposable TMPDIR' "$(test -d "${TMPDIR}/widget/feat/foo/bash-tests" && echo kept)" 'kept'
assert_contains 'nothing is left under the disposable TMPDIR' "$(find "$disposable" -mindepth 1 | wc -l | tr -d ' ')" '0'
rm -rf "${TMPDIR:?}/widget" "${repo}/tests/bad.test"

printf '\n=== functional: a missing temp root reports the real error ===\n'
rc=0
err="$(TMP_LAYOUT_TMPDIR='' TMPDIR="${fixture}/no/such/root" tmp_layout_prepare pytest "$repo" 2>&1)" || rc=$?
assert_contains 'a missing temp root makes prepare fail' "rc=${rc}" 'rc=1'
assert_contains 'the mkdir error is shown, not hidden behind the ownership message' "$err" 'No such file or directory'

printf '\n=== functional: single quotes, test children and a moved temp root ===\n'
quoted_tmp="${fixture}/it's"
mkdir -p "$quoted_tmp"
# shellcheck disable=SC2016  # the variable must expand in the child, not here
addopts="$(cd "$repo" && TMPDIR="$quoted_tmp" "$wrapper" pytest -- bash -c 'printf "%s" "$PYTEST_ADDOPTS"')"
assert_contains 'a single quote in the path is escaped the way shlex reads it' "$addopts" "it'\"'\"'s"
# shellcheck disable=SC2016  # the variable must expand in the written test, not here
printf '#!/usr/bin/env bash\necho "leak=${TMP_LAYOUT_TMPDIR:-unset}"\n' >"${repo}/tests/leak.test"
leak_out="$(cd "$repo" && TMP_LAYOUT_TMPDIR="$TMPDIR" "${script_dir}/../scripts/dev/run-tests" --dir "$repo" --verbose 2>&1)"
assert_contains 'test children never inherit TMP_LAYOUT_TMPDIR' "$leak_out" 'leak=unset'
rm -f "${repo}/tests/leak.test"
rm -rf "${TMPDIR:?}/widget"
dir="$(tmp_layout_prepare pytest "$repo")"
run_a="$(tmp_layout_run_dir "$dir")"
other_root="${fixture}/other-root"
mkdir -p "$other_root"
rc=0
TMP_LAYOUT_TMPDIR="$other_root" tmp_layout_finish "$run_a" 0 || rc=$?
assert_contains 'finishing a run under a different temp root still succeeds' "rc=${rc}" 'rc=0'
assert_contains 'it removes the run directory and leaves the project directory in place' "$(test -e "$run_a" && echo present || echo gone)$(test -d "${TMPDIR}/widget" && echo present || echo gone)" 'gonepresent'
rm -rf "${TMPDIR:?}/widget"

printf '\n=== functional: run-tests in a git repository ===\n'
mkdir -p "${repo}/tests"
printf '#!/usr/bin/env bash\nexit 0\n' >"${repo}/tests/ok.test"
rm -rf "${TMPDIR:?}/widget"
(cd "$repo" && "${script_dir}/../scripts/dev/run-tests" --dir "$repo") >/dev/null 2>&1
assert_contains 'a passing run-tests leaves the project directory empty' "$(test -d "${TMPDIR}/widget" && find "${TMPDIR}/widget" -mindepth 1 | wc -l | tr -d ' ')" '0'
mkdir -p "${repo}/tests"
printf '#!/usr/bin/env bash\nexit 1\n' >"${repo}/tests/bad.test"
rc=0
(cd "$repo" && "${script_dir}/../scripts/dev/run-tests" --dir "$repo") >/dev/null 2>&1 || rc=$?
assert_contains 'a failing run-tests exits non-zero' "rc=${rc}" 'rc=1'
assert_contains 'a failing run-tests keeps its layout directory' "$(test -d "${TMPDIR}/widget/feat/foo/bash-tests" && echo present || echo gone)" 'present'

printf '\n=== functional: setup-tmp-layout composite action ===\n'
action_dir="${script_dir}/../actions/setup-tmp-layout"
action_run="$(awk '/^        set -euo pipefail/{f=1} f' "${action_dir}/action.yml" | sed 's/^        //')"
env_file="${TMPDIR}/action-env"
: >"$env_file"
rc=0
(cd "$repo" && ACTION_PATH="${action_dir}" GITHUB_ENV="$env_file" bash -c "$action_run") >/dev/null 2>&1 || rc=$?
assert_contains 'the action step succeeds inside a repository-helpers checkout' "rc=${rc}" 'rc=0'
helpers_root="$(cd "${script_dir}/.." && pwd)"
assert_contains 'the action env block starts with the variable name and a heredoc delimiter' "$(sed -n 1p "$env_file")" 'REPOSITORY_HELPERS_DIR<<EOF_'
assert_contains 'the action env block carries the checkout root on its second line' "$(sed -n 2p "$env_file")" "$helpers_root"
assert_contains 'the action env block ends with the delimiter it opened with' "$(sed -n 1p "$env_file" | sed 's/^REPOSITORY_HELPERS_DIR<<//')" "$(sed -n 3p "$env_file")"
action_path_needle="ACTION_PATH: \${{ github.action_path }}"
assert_count_equals 'the action step reads ACTION_PATH from github.action_path exactly once' "$(cat "${action_dir}/action.yml")" "$action_path_needle" '1'
odd="${TMPDIR}/odd checkout"$'\n'"with newline"
mkdir -p "${odd}/actions" "${odd}/scripts/dev"
ln -s "${action_dir}" "${odd}/actions/setup-tmp-layout"
printf '#!/usr/bin/env bash\n' >"${odd}/scripts/dev/with-tmp-layout"
chmod +x "${odd}/scripts/dev/with-tmp-layout"
: >"$env_file"
rc=0
(ACTION_PATH="${odd}/actions/setup-tmp-layout" GITHUB_ENV="$env_file" bash -c "$action_run") >/dev/null 2>&1 || rc=$?
assert_contains 'the action step accepts a checkout path with spaces and a newline' "rc=${rc}" 'rc=0'
assert_contains 'the odd path stays inside one well-formed env block' "$(wc -l <"$env_file" | tr -d ' ')" '4'
rc=0
(ACTION_PATH="${repo}/a/b" GITHUB_ENV="$env_file" bash -c "mkdir -p \"\$ACTION_PATH\"; $action_run") >/dev/null 2>&1 || rc=$?
assert_contains 'the action fails when the checkout lacks with-tmp-layout' "rc=${rc}" 'rc=1'

printf '\n=== functional: TMPDIR points inside the run (repository-helpers#840) ===\n'
root_before="$(tmp_layout_tmpdir)"
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" pytest -- bash -c 'd="$(mktemp -d)"; printf "%s\n%s\n%s\n%s" "$TMPDIR" "$d" "$TMP_LAYOUT_DIR" "$TMP_LAYOUT_TMPDIR"')"
run_dir="$(sed -n 3p <<<"$out")"
assert_contains 'a test tool sees TMPDIR inside its run directory' "$(sed -n 1p <<<"$out")" "${run_dir}/tmp"
assert_contains 'mktemp -d lands inside the run directory' "$(sed -n 2p <<<"$out")" "${run_dir}/tmp/"
assert_contains 'the layout root stays the original TMPDIR for nested calls' "$(sed -n 4p <<<"$out")" "$root_before"
assert_contains 'a passing run removes the scratch directory with the run' "$([[ -e "$run_dir" ]] && echo present || echo gone)" 'gone'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" uv -- bash -c 'printf "%s\n%s" "$TMPDIR" "$UV_CACHE_DIR"')"
uv_scratch="$(sed -n 1p <<<"$out")"
assert_contains 'a cache tool gets a scratch TMPDIR beside its cache' "$uv_scratch" "$(dirname "$(sed -n 2p <<<"$out")")/run."
assert_contains 'the cache tool scratch directory is removed after the run' "$([[ -e "$uv_scratch" ]] && echo present || echo gone)" 'gone'
assert_contains 'the cache itself is kept' "$([[ -d "$(dirname "$uv_scratch")" ]] && echo present || echo gone)" 'present'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" uv -- "$wrapper" pytest -- bash -c 'printf "%s" "$TMP_LAYOUT_DIR"')"
assert_contains 'a nested layout call stays under the original root, not under the outer scratch' "$out" "${root_before}/widget/feat/foo/pytest/"
rc=0
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" pytest -- bash -c 'printf "%s" "$TMPDIR"; exit 3')" || rc=$?
assert_contains 'a failing run keeps its scratch directory' "$([[ -d "$out" ]] && echo present || echo gone)" 'present'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" --keep pytest -- bash -c 'printf "%s" "$TMPDIR"')"
assert_contains '--keep leaves the scratch directory in place with the run' "$([[ -d "$out" ]] && echo present || echo gone)" 'present'
rc=0
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" uv -- bash -c 'printf "%s" "$TMPDIR"; exit 4')" || rc=$?
assert_contains 'a failing uv run still returns its exit status' "rc=${rc}" 'rc=4'
assert_contains 'a failing uv run still removes its scratch directory' "$([[ -e "$out" ]] && echo present || echo gone)" 'gone'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" --keep uv -- bash -c 'printf "%s" "$TMPDIR"')"
assert_contains 'with --keep a uv run still removes its scratch directory (only the cache is kept)' \
  "$([[ -e "$out" ]] && echo present || echo gone)" 'gone'

echo "=== static: agents rule and Cursor shim for the temp layout ==="
rule_file="${script_dir}/../.agents/rules/tmp-layout.md"
shim_file="${script_dir}/../.cursor/rules/tmp-layout.mdc"
# The setting must be an active front-matter line (not commented out, not in the body).
front_matter="$(awk 'NR == 1 && $0 == "---" {on = 1; next} on && $0 == "---" {exit} on {print}' "$rule_file")"
assert_contains 'the agents rule is always applied through an active front-matter entry' \
  "$(grep -cx 'alwaysApply: true' <<<"$front_matter")" '1'
assert_contains 'the agents rule names the wrapper script' "$(cat "$rule_file")" 'scripts/dev/with-tmp-layout'
assert_contains 'the agents rule names the CI action' "$(cat "$rule_file")" 'actions/setup-tmp-layout'
assert_contains 'the Cursor shim marks the rule it points to' "$(cat "$shim_file")" 'agents-rule-shim: tmp-layout'
shim_target="$(sed -n 's/^Canonical rule: \[[^]]*\](\([^)]*\)).*$/\1/p' "$shim_file")"
assert_contains 'the Cursor shim links a canonical rule target' "$shim_target" '.agents/rules/tmp-layout.md'
assert_contains 'the Cursor shim link target resolves to the agents rule file' \
  "$([[ -f "$(dirname "$shim_file")/${shim_target}" ]] && echo present || echo missing)" 'present'

test_summary
