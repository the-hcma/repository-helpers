#!/usr/bin/env bash
# Tests for scripts/lib/tmp-layout and scripts/dev/with-tmp-layout (#832).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
lib="${script_dir}/../scripts/lib/tmp-layout"
wrapper="${script_dir}/../scripts/dev/with-tmp-layout"
readonly lib wrapper

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck does not use -x
source "${script_dir}/lib/test-assert"
test_init

fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT
export TMPDIR="${fixture}/tmp"
mkdir -p "$TMPDIR"
repo="${fixture}/proj"
git init --quiet "$repo"
git -C "$repo" remote add origin https://github.com/example/widget.git
git -C "$repo" -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false \
  commit --quiet --allow-empty -m init
git -C "$repo" checkout --quiet -b feat/foo

# shellcheck disable=SC1091  # runner-bootstrap begins the session the library runs git through
source "${script_dir}/../scripts/lib/runner-bootstrap"
# shellcheck source=scripts/lib/tmp-layout
source "$lib"

printf '\n=== functional: path layout ===\n'
assert_contains 'project is the origin repository name' "$(tmp_layout_project "$repo")" 'widget'
assert_contains 'branch keeps its slash' "$(tmp_layout_branch "$repo")" 'feat/foo'
assert_contains 'tool directory is TMPDIR/project/branch/tool' "$(tmp_layout_dir pytest "$repo")" "${TMPDIR}/widget/feat/foo/pytest"
sha="$(git -C "$repo" rev-parse --short HEAD)"
git -C "$repo" checkout --quiet --detach
assert_contains 'detached HEAD uses detached-head/<sha>' "$(tmp_layout_branch "$repo")" "detached-head/${sha}"
git -C "$repo" checkout --quiet feat/foo
rc=0
tmp_layout_dir '../x' "$repo" >/dev/null 2>&1 || rc=$?
assert_contains 'a tool name that escapes the layout is refused' "rc=${rc}" 'rc=1'
rc=0
TMP_LAYOUT_RETENTION_DAYS=abc tmp_layout_retention_days >/dev/null 2>&1 || rc=$?
assert_contains 'a non-numeric retention is an error' "rc=${rc}" 'rc=1'

printf '\n=== functional: finish ===\n'
dir="$(tmp_layout_prepare pytest "$repo")"
assert_contains 'prepare creates the marked directory' "$(test -f "${dir}/.tmp-layout-marker" && echo yes)" 'yes'
run_a="$(tmp_layout_run_dir "$dir")"
run_b="$(tmp_layout_run_dir "$dir")"
assert_contains 'two runs on one branch get different directories' "$(test "$run_a" != "$run_b" && echo different)" 'different'
tmp_layout_finish "$run_a" 0
assert_contains 'a passing run removes only its own directory' "$(test -e "$run_a" && echo present || echo gone)$(test -d "$run_b" && echo present || echo gone)" 'gonepresent'
assert_contains 'a concurrent run keeps the tool directory and its marker' "$(test -f "${dir}/.tmp-layout-marker" && echo yes)" 'yes'
tmp_layout_finish "$run_b" 0
assert_contains 'the last passing run removes the tool directory' "$(test -e "$dir" && echo present || echo gone)" 'gone'
assert_contains 'the last passing run removes the empty project directory too' "$(test -e "${TMPDIR}/widget" && echo present || echo gone)" 'gone'
dir="$(tmp_layout_prepare pytest "$repo")"
run_a="$(tmp_layout_run_dir "$dir")"
err="$(tmp_layout_finish "$run_a" 1 2>&1)"
assert_contains 'a failing run keeps its run directory' "$(test -d "$run_a" && echo present || echo gone)" 'present'
assert_contains 'a failing run says where the directory is' "$err" "keeping ${run_a} for debugging"
rc=0
tmp_layout_finish "${TMPDIR}/nowhere/run.x" 0 || rc=$?
assert_contains 'finishing a directory that vanished does not fail' "rc=${rc}" 'rc=0'
saved_tmpdir="$TMPDIR"
TMPDIR="${saved_tmpdir}/"
dir="$(tmp_layout_prepare pytest "$repo")"
run_a="$(tmp_layout_run_dir "$dir")"
tmp_layout_finish "$run_a" 0
TMPDIR="$saved_tmpdir"
assert_contains 'a TMPDIR with a trailing slash is never removed by the cleanup' "$(test -d "$TMPDIR" && echo present)" 'present'
rm -rf "${TMPDIR:?}/widget"

printf '\n=== functional: stale sweep ===\n'
old="${TMPDIR}/widget/feat/old/pytest"
mkdir -p "$old"
: >"${old}/.tmp-layout-marker"
touch -d '4 days ago' "${old}/.tmp-layout-marker"
fresh="${TMPDIR}/widget/feat/fresh/pytest"
mkdir -p "$fresh"
: >"${fresh}/.tmp-layout-marker"
touch -d '2 days ago' "${fresh}/.tmp-layout-marker"
unmarked="${TMPDIR}/widget/feat/unmarked"
mkdir -p "$unmarked"
touch -d '9 days ago' "$unmarked"
tmp_layout_prepare pytest "$repo" >/dev/null 2>&1
assert_contains 'a marked directory older than 3 days is removed' "$(test -e "$old" && echo present || echo gone)" 'gone'
assert_contains 'its empty branch directory is removed too' "$(test -e "${TMPDIR}/widget/feat/old" && echo present || echo gone)" 'gone'
assert_contains 'a marked directory younger than 3 days is kept' "$(test -d "$fresh" && echo present || echo gone)" 'present'
assert_contains 'an old directory without the marker is never removed' "$(test -d "$unmarked" && echo present || echo gone)" 'present'
TMP_LAYOUT_RETENTION_DAYS=1 tmp_layout_sweep_stale "$repo" 2>/dev/null
assert_contains 'the retention is configurable' "$(test -e "$fresh" && echo present || echo gone)" 'gone'

printf '\n=== functional: with-tmp-layout ===\n'
rm -rf "${TMPDIR:?}/widget"
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" pytest -- bash -c 'printf "%s|%s" "$TMP_LAYOUT_DIR" "$PYTEST_ADDOPTS"')"
assert_contains 'pytest gets --basetemp inside its layout directory' "$out" "/widget/feat/foo/pytest/run."
assert_contains 'a passing command leaves nothing behind' "$(test -e "${TMPDIR}/widget" && echo present || echo gone)" 'gone'
rc=0
(cd "$repo" && "$wrapper" pytest -- bash -c 'exit 7') >/dev/null 2>&1 || rc=$?
assert_contains 'the command exit status is returned' "rc=${rc}" 'rc=7'
assert_contains 'a failing command leaves its directory behind' "$(test -d "${TMPDIR}/widget/feat/foo/pytest" && echo present || echo gone)" 'present'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" uv -- bash -c 'printf "%s" "$UV_CACHE_DIR"')"
assert_contains 'uv gets its cache directory in the layout' "$out" "${TMPDIR}/widget/feat/foo/uv/cache"
assert_contains 'a package-manager directory is kept after success' "$(test -d "${TMPDIR}/widget/feat/foo/uv" && echo present || echo gone)" 'present'
# shellcheck disable=SC2016  # the variables must expand in the child, not here
out="$(cd "$repo" && "$wrapper" pnpm -- bash -c 'printf "%s" "$npm_config_store_dir"')"
assert_contains 'pnpm gets its store directory in the layout' "$out" "${TMPDIR}/widget/feat/foo/pnpm/store"

printf '\n=== static: run-tests uses the layout ===\n'
assert_contains 'run-tests prepares its temp base through tmp_layout_prepare' "count=$(grep -c tmp_layout_prepare "${script_dir}/../scripts/dev/run-tests");" 'count=1;'

printf '\n=== functional: run-tests in a git repository ===\n'
mkdir -p "${repo}/tests"
printf '#!/usr/bin/env bash\nexit 0\n' >"${repo}/tests/ok.test"
rm -rf "${TMPDIR:?}/widget"
(cd "$repo" && "${script_dir}/../scripts/dev/run-tests" --dir "$repo") >/dev/null 2>&1
assert_contains 'a passing run-tests leaves no layout directory behind' "$(test -e "${TMPDIR}/widget" && echo present || echo gone)" 'gone'
printf '#!/usr/bin/env bash\nexit 1\n' >"${repo}/tests/bad.test"
rc=0
(cd "$repo" && "${script_dir}/../scripts/dev/run-tests" --dir "$repo") >/dev/null 2>&1 || rc=$?
assert_contains 'a failing run-tests exits non-zero' "rc=${rc}" 'rc=1'
assert_contains 'a failing run-tests keeps its layout directory' "$(test -d "${TMPDIR}/widget/feat/foo/bash-tests" && echo present || echo gone)" 'present'

test_summary
