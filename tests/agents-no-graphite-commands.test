#!/usr/bin/env bash
# The agent skills and workflow rules of this repository do not prescribe the retired Graphite (gt) CLI (#873).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="${script_dir%/tests}"
readonly rh_root

# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
test_init

# No line of these files names a gt command, not even one that warns against it: the sentence about the retired
# tool says "Graphite is retired" and cites `merge-stack --help`, it does not need to spell out a command.
gt_command_re='(^|[^[:alnum:]_-])gt[[:space:]]+(create|submit|modify|sync|restack|checkout|track|log|up|down|top|bottom)'

printf '\n=== static: skills and workflow rules have no gt command ===\n'
files=("${rh_root}"/.agents/skills/*/SKILL.md
  "${rh_root}/.agents/rules/pr-workflow.md" "${rh_root}/.agents/rules/pr-ship-and-review.md"
  "${rh_root}/.agents/rules/main-worktree-off-limits.md")
for file in "${files[@]}"; do
  rel="${file#"${rh_root}"/}"
  if [[ ! -r "$file" ]]; then
    # A missing or unreadable file must not pass as "no match".
    fail_case "${rel} is not readable, so it cannot be checked"
    continue
  fi
  grep_rc=0
  live="$(grep --extended-regexp --line-number -- "$gt_command_re" "$file")" || grep_rc=$?
  if (( grep_rc == 1 )); then
    pass_case "${rel} prescribes no gt command"
  elif (( grep_rc == 0 )); then
    printf '%s\n' "$live" >&2
    fail_case "${rel} names a gt command"
  else
    fail_case "${rel} could not be searched (grep exit ${grep_rc})"
  fi
done
if (( ${#files[@]} >= 5 )); then
  pass_case 'the skills glob matched, so it cannot pass by checking nothing'
else
  fail_case "only ${#files[@]} files are checked; the skills glob matched nothing"
fi

printf '\n=== static: the merge-it sentence of the ship-and-review skill is sourced ===\n'
skill="$(<"${rh_root}/.agents/skills/ship-and-review/SKILL.md")"
assert_not_contains 'the skill does not claim the org no longer uses Graphite merge queue without a source' \
  "$skill" 'the org no longer uses Graphite merge queue'
assert_contains 'the skill cites merge-stack --help for the refused graphite marker' "$skill" 'scripts/dev/merge-stack --help'
# shellcheck disable=SC2016  # the needle is literal Markdown with backticks, not a command substitution
assert_contains 'the skill says to stage named files, never git add -A' "$skill" 'never `git add -A`'

test_summary
