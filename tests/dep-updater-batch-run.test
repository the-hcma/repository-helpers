#!/usr/bin/env bash
# Tests for scripts/dep-updater-batch-run.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/dep-updater-batch-run"
readonly script

pass=0
fail=0

printf '\n=== static: git fetch before batch ===\n'
if grep -qF 'batch_run_git_fetch' "$script" \
  && grep -qF 'fetch --prune origin' "$script" \
  && grep -qF 'dep-updater --batch --all' "$script"; then
  printf '[PASS] batch-run: fetches origin then runs batch-all\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-run: missing git fetch or batch-all invocation\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: Dependency Updater unit ===\n'
unit="${script_dir}/../etc/systemd/dep-updater.service"
if [[ -f "$unit" ]] \
  && grep -qF 'Description=Dependency Updater' "$unit" \
  && grep -qF 'dep-updater-batch-run' "$unit"; then
  printf '[PASS] service-unit: Dependency Updater runs batch-run wrapper\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-unit: expected Description=Dependency Updater and batch-run\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: fetches git clones under scan root ===\n'
if grep -qF 'batch_run_git_fetch_all' "$script" \
  && grep -qF '.git' "$script" \
  && grep -qF 'scan_root' "$script"; then
  printf '[PASS] batch-run: batch_run_git_fetch_all walks scan_root children\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-run: missing scan_root fetch loop\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
