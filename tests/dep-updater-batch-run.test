#!/usr/bin/env bash
# Tests for scripts/dep-updater-batch-run.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

script="${script_dir}/../scripts/dep-updater-batch-run"
readonly script
unit="${script_dir}/../etc/systemd/dep-updater.service"
readonly unit

pass=0
fail=0

write_test_env_file() {
  local -r dir="$1"
  mkdir -p "${dir}/.config"
  cat >"${dir}/.config/dep-updater.env" <<'EOF'
DEP_UPDATER_SMTP_HOST=smtp.test
DEP_UPDATER_REPORT_TO=johndoe@example.com
DEP_UPDATER_REPORT_FROM=dep-updater-batch@example.com
EOF
}

stage_batch_run_bundle() {
  local -r tmp="$1"
  mkdir -p "$tmp/scripts/lib"
  cp "$script" "$tmp/scripts/dep-updater-batch-run"
  cp "${script_dir}/../scripts/lib/smtp-mail" "$tmp/scripts/lib/smtp-mail"
  cp "${script_dir}/../scripts/lib/sendmail" "$tmp/scripts/lib/sendmail"
  cp "${script_dir}/../scripts/lib/email-multipart" "$tmp/scripts/lib/email-multipart"
  cp "${script_dir}/../scripts/lib/tooling-path" "$tmp/scripts/lib/tooling-path"
  cp "${script_dir}/../scripts/lib/time-log" "$tmp/scripts/lib/time-log"
  cp "${script_dir}/../scripts/lib/run-context" "$tmp/scripts/lib/run-context"
  cp "${script_dir}/../scripts/lib/runner" "$tmp/scripts/lib/runner"
  cp "${script_dir}/../scripts/lib/runner-ensure" "$tmp/scripts/lib/runner-ensure"
  cp "${script_dir}/../scripts/lib/runner-bootstrap" "$tmp/scripts/lib/runner-bootstrap"
  cp "${script_dir}/../scripts/lib/timer-singleton-lock" "$tmp/scripts/lib/timer-singleton-lock"
}

# Staged batch-run resolves repo_dir as the copy root; give it a fetchable origin remote.
stage_batch_run_git_repo() {
  local -r tmp="$1"
  local bare_origin

  git -C "$tmp" init -q -b main
  git -C "$tmp" config user.email 'test@example.com'
  git -C "$tmp" config user.name 'test'
  touch "${tmp}/.gitkeep"
  git -C "$tmp" add .gitkeep
  git -C "$tmp" commit -qm 'init'
  bare_origin="${tmp}/origin.git"
  git init --bare -q "$bare_origin"
  git -C "$tmp" remote add origin "$bare_origin"
  git -C "$tmp" push -u origin main
}

printf '\n=== static: mandatory env file ===\n'
if grep -qF 'batch_load_required_env_file' "$script" \
  && grep -qF 'Missing required env file' "$script" \
  && grep -qF '.config/dep-updater.env' "$script" \
  && grep -qF 'EnvironmentFile=%h/.config/dep-updater.env' "$unit" \
  && ! grep -qF 'EnvironmentFile=-%h' "$unit"; then
  printf '[PASS] env-file: script and unit require ~/.config/dep-updater.env\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] env-file: expected mandatory EnvironmentFile and batch_load_required_env_file\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: localhost uses sendmail ===\n'
if grep -qF 'batch_apply_config_defaults' "$script" \
  && grep -qF 'repo_helpers_smtp_use_sendmail' "${script_dir}/../scripts/lib/smtp-mail" \
  && grep -qF 'repo_helpers_sendmail' "${script_dir}/../scripts/lib/smtp-mail"; then
  printf '[PASS] localhost: batch applies defaults and delivers via sendmail\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] localhost: missing sendmail path for local host\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: notifier-style email ===\n'
if grep -qF 'lib/email-multipart' "$script" \
  && grep -qF 'repo_helpers_email_write_multipart' "$script" \
  && grep -qF 'batch_report_join_slugs' "$script" \
  && grep -qF 'batch_report_update_lines' "$script" \
  && grep -qF 'DEP_UPDATER_UPDATES_REPORT' "$script" \
  && grep -qF 'repo_helpers_run_context_footer_full' "$script" \
  && grep -qF 'repo_helpers_run_context_footer_full' "${script_dir}/../scripts/lib/run-context" \
  && grep -qF 'batch_report_collect_final_run_summary_lines' "$script" \
  && grep -qF 'batch_report_append_repo_failure_details' "$script" \
  && grep -qF 'CI failure-link' "$script" \
  && grep -qF 'Check run:' "$script" \
  && grep -qF 'if (( fail_count > 0 )); then' "$script" \
  && ! grep -qF 'runner_report_append_command_failures' "$script" \
  && grep -qF 'report_separator' "$script"; then
  printf '[PASS] email: uses shared multipart layout and structured update JSON\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] email: missing notifier-style multipart email wiring or update JSON\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: git fetch before batch ===\n'
if grep -qF 'batch_run_git_fetch' "$script" \
  && grep -qF 'run_command "git fetch:' "$script" \
  && grep -qF 'lib/runner-bootstrap' "$script" \
  && grep -qF 'batch_run_dep_updater_with_deadline' "$script"; then
  printf '[PASS] batch-run: fetches origin then runs batch-all under deadline\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-run: missing git fetch or deadline-wrapped batch-all\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: batch-run runner adoption complete ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'runner_exec "git rev-parse work-tree check"' "$script" \
  && grep -qF 'runner_exec "jq batch report updates"' "$script" \
  && grep -qF 'runner_sh "dep-updater batch-all with deadline"' "$script"; then
  printf '[PASS] batch-run: git check, jq report, and batch deadline use runner\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch-run: expected runner for git check, jq report, and batch deadline\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: batch deadline and WAIT_TIMEOUT ===\n'
if grep -qF 'batch_timeout_to_sec' "$script" \
  && grep -qF 'ERROR: WAIT_TIMEOUT batch-run' "$script" \
  && grep -qF 'timeout --foreground' "$script" \
  && grep -qF 'TimeoutStartSec=' "$unit" \
  && grep -qF 'KillMode=control-group' "$unit"; then
  printf '[PASS] deadline: script timeout + systemd cgroup kill safety net\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] deadline: expected batch timeout, WAIT_TIMEOUT, and unit limits\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: batch output streams to log ===\n'
deadline_fn="$(awk '/^batch_run_dep_updater_with_deadline\(\)/,/^}/' "$script")"
if printf '%s' "$deadline_fn" | grep -qF "mkfifo \"\$stream_fifo\"" \
  && printf '%s' "$deadline_fn" | grep -qF "tee -a \"\$run_log\" \"\$log_file\" <\"\$stream_fifo\"" \
  && ! printf '%s' "$deadline_fn" | grep -qF "cat \"\$run_log\" >>\"\$log_file\""; then
  printf '[PASS] stream-log: batch output is teed live to run log and final log\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stream-log: expected FIFO + tee streaming without post-run cat append\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: temp files are cleaned on exit ===\n'
if grep -qF 'batch_run_cleanup_temp_files' "$script" \
  && grep -qF 'trap batch_run_cleanup_temp_files EXIT' "$script" \
  && grep -qF "rm -f \"\${run_log:-}\" \"\${clean_log:-}\" \"\${updates_report:-}\"" "$script" \
  && grep -qF "rm -rf \"\$_batch_run_stream_dir\"" "$script"; then
  printf '[PASS] temp-cleanup: EXIT trap removes run/update logs and FIFO directory\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] temp-cleanup: missing EXIT cleanup for batch temp files\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: Dependency Updater unit ===\n'
if [[ -f "$unit" ]] \
  && grep -qF 'Description=Dependency Updater' "$unit" \
  && grep -qF 'dep-updater-batch-run' "$unit" \
  && ! grep -qF 'WantedBy=default.target' "$unit"; then
  printf '[PASS] service-unit: Dependency Updater runs batch-run wrapper\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] service-unit: expected Description=Dependency Updater and batch-run\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'lib/timer-singleton-lock' "$script" \
  && grep -qF 'timer_singleton_acquire_lock' "$script" \
  && grep -qF 'dep-updater-batch.lock' "$script"; then
  printf '[PASS] singleton-lock: batch-run uses shared timer flock helper\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] singleton-lock: batch-run should source lib/timer-singleton-lock\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== missing env file exits non-zero ===\n'
missing_home=""
missing_home="$(mktemp -d)"
missing_out=""
missing_exit=0
missing_out="$(
  HOME="$missing_home" bash "$script" 2>&1
)" || missing_exit=$?
rm -rf "$missing_home"
if [[ "$missing_exit" -ne 0 ]] && grep -qF 'Missing required env file' <<<"$missing_out"; then
  printf '[PASS] missing-env: hard failure when env file absent\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] missing-env: expected die on missing env (exit=%s)\n' "$missing_exit"
  fail=$(( fail + 1 ))
fi

printf '\n=== --print builds notifier-style report ===\n'
print_tmp=""
print_tmp="$(mktemp -d)"
write_test_env_file "$print_tmp"
print_out=""
print_exit=0
print_out="$(
  HOME="$print_tmp" bash "$script" --print 2>/dev/null
)" || print_exit=$?
rm -rf "$print_tmp"
if [[ "$print_exit" -eq 0 ]] \
  && grep -qF 'OK (no updates):' <<<"$print_out" \
  && grep -qF 'demo-repo' <<<"$print_out" \
  && ! grep -qF 'Failed:' <<<"$print_out" \
  && grep -qF 'Run context:' <<<"$print_out" \
  && grep -qF 'Workdir:' <<<"$print_out" \
  && grep -qF 'Log file:' <<<"$print_out" \
  && grep -qF 'Started:' <<<"$print_out" \
  && grep -qF 'Finished:' <<<"$print_out" \
  && grep -qF 'Command:' <<<"$print_out" \
  && ! grep -qF 'Host:      ' <<<"$print_out" \
  && grep -qF 'multipart/alternative' <<<"$print_out"; then
  printf '[PASS] print: notifier-style multipart email on stdout\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] print: expected OK/Failed/multipart output (exit=%s)\n' "$print_exit"
  fail=$(( fail + 1 ))
fi

printf '\n=== mock batch sends SMTP report on failure ===\n'
tmp=""
tmp="$(mktemp -d)"
write_test_env_file "$tmp"
mkdir -p "$tmp/scripts/lib" "$tmp/scan" "$tmp/scratch/repository-helpers"
stage_batch_run_git_repo "$tmp"
stage_batch_run_bundle "$tmp"

cat >"$tmp/scripts/dep-updater" <<'EOF'
#!/usr/bin/env bash
printf '[batch-all] --- demo (/) ---\n'
if [[ -n "${DEP_UPDATER_UPDATES_REPORT:-}" ]]; then
  cat >"${DEP_UPDATER_UPDATES_REPORT}" <<'JSON'
[
  {
    "repo_name": "demo",
    "ecosystem": "npm",
    "package": "lodash",
    "from": "1.0.0",
    "to": "1.0.1",
    "cve": "no",
    "cves": "-",
    "pr": "123"
  }
]
JSON
fi
printf '[batch-all] FAILED (demo) exit 1\n'
printf '[batch-all] Root cause: CI failed: pr=#123 check=Backend Tests conclusion=CANCELLED url=https://example.com/job pr_url=https://github.com/the-hcma/demo/pull/123 branch=dep-updates/batch\n'
printf '[batch-all] CI failure-link (demo) pr: https://github.com/the-hcma/demo/pull/123\n'
printf '[batch-all] CI failure-link (demo) check: https://example.com/job\n'
printf '[batch-all] Finished with failures (exit 1).\n'
printf '[batch-all] Failure summary:\n'
printf '[batch-all]   demo: exit 1 — CI failed: pr=#123 check=Backend Tests conclusion=CANCELLED url=https://example.com/job pr_url=https://github.com/the-hcma/demo/pull/123 branch=dep-updates/batch\n'
printf '[batch-all] Failure details:\n'
printf '[batch-all]   demo: CI failed on PR #123 — Backend Tests (CANCELLED)\n'
printf '[batch-all]   demo: PR: https://github.com/the-hcma/demo/pull/123\n'
printf '[batch-all]   demo: Check run: https://example.com/job\n'
exit 1
EOF
chmod +x "$tmp/scripts/dep-updater" "$tmp/scripts/dep-updater-batch-run"

breadcrumb="${tmp}/smtp.out"
batch_exit=0
batch_stderr="${tmp}/batch.stderr"
(
  cd "$tmp"
  HOME="$tmp" \
  REPO_HELPERS_TEST_MODE=1 \
  REPO_HELPERS_SMTP_BREADCRUMB="$breadcrumb" \
  DEP_UPDATER_BATCH_SCAN_ROOT="${tmp}/scan" \
  DEP_UPDATER_BATCH_LOG="${tmp}/scratch/repository-helpers/dep-updater-batch.log" \
  bash "${tmp}/scripts/dep-updater-batch-run"
) 2>"$batch_stderr" || batch_exit=$?

if [[ "$batch_exit" -eq 1 ]] \
  && [[ -f "$breadcrumb" ]] \
  && grep -qF 'batch FAILED (exit 1)' "$breadcrumb" \
  && grep -qF 'Updated:' "$breadcrumb" \
  && grep -qF '  demo:' "$breadcrumb" \
  && grep -qF 'npm lodash 1.0.0' "$breadcrumb" \
  && grep -qF '#123' "$breadcrumb" \
  && grep -qF 'Failed:' "$breadcrumb" \
  && ! grep -qF 'Command failures' "$breadcrumb" \
  && grep -qF 'CI failed on PR #123' "$breadcrumb" \
  && grep -qF 'Run summary:' "$breadcrumb" \
  && grep -qF 'Failure summary:' "$breadcrumb" \
  && grep -qF 'demo: exit 1' "$breadcrumb" \
  && grep -qF 'https://github.com/the-hcma/demo/pull/123' "$breadcrumb" \
  && grep -qF 'https://example.com/job' "$breadcrumb" \
  && grep -qF 'multipart/alternative' "$breadcrumb" \
  && grep -qF 'johndoe@example.com' "$breadcrumb"; then
  printf '[PASS] mock-batch: exit 1 and notifier-style failure email\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mock-batch: expected failure email (exit=%s stderr=%s)\n' \
    "$batch_exit" "$(tr '\n' ' ' <"$batch_stderr" 2>/dev/null || true)"
  fail=$(( fail + 1 ))
fi

rm -rf "$tmp"

printf '\n=== mock batch email surfaces command failure stderr ===\n'
cmd_tmp=""
cmd_tmp="$(mktemp -d)"
write_test_env_file "$cmd_tmp"
mkdir -p "$cmd_tmp/scripts/lib" "$cmd_tmp/scan" "$cmd_tmp/scratch/repository-helpers"
stage_batch_run_git_repo "$cmd_tmp"
stage_batch_run_bundle "$cmd_tmp"

cat >"$cmd_tmp/scripts/dep-updater" <<'EOF'
#!/usr/bin/env bash
printf '[batch-all] --- demo-repo (/) ---\n'
printf '[batch-all] FAILED (demo-repo) exit 1\n'
printf '[batch-all] Root cause: gh auth: unknown command "setup-git" for "gh"\n'
printf '[batch-all] Command failure (demo-repo): gh auth (exit 1) — unknown command "setup-git" for "gh"\n'
printf '[batch-all] Finished with failures (exit 1).\n'
printf '[batch-all] Failure summary:\n'
printf '[batch-all]   demo-repo: exit 1 — gh auth: unknown command "setup-git" for "gh"\n'
printf '[batch-all] Failure details:\n'
printf '[batch-all]   demo-repo: gh auth (exit 1) — unknown command "setup-git" for "gh"\n'
exit 1
EOF
chmod +x "$cmd_tmp/scripts/dep-updater" "$cmd_tmp/scripts/dep-updater-batch-run"

cmd_breadcrumb="${cmd_tmp}/smtp-cmd.out"
cmd_exit=0
(
  cd "$cmd_tmp"
  HOME="$cmd_tmp" \
  REPO_HELPERS_TEST_MODE=1 \
  REPO_HELPERS_SMTP_BREADCRUMB="$cmd_breadcrumb" \
  DEP_UPDATER_BATCH_SCAN_ROOT="${cmd_tmp}/scan" \
  DEP_UPDATER_BATCH_LOG="${cmd_tmp}/scratch/repository-helpers/dep-updater-batch.log" \
  bash "${cmd_tmp}/scripts/dep-updater-batch-run"
) || cmd_exit=$?

if [[ "$cmd_exit" -eq 1 ]] \
  && [[ -f "$cmd_breadcrumb" ]] \
  && grep -qF 'setup-git' "$cmd_breadcrumb" \
  && grep -qF 'gh auth' "$cmd_breadcrumb" \
  && ! grep -qF 'dep-updater exited with code 1' "$cmd_breadcrumb"; then
  printf '[PASS] mock-batch: email surfaces command failure stderr instead of generic exit\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mock-batch: expected command failure stderr in email (exit=%s)\n' "$cmd_exit"
  fail=$(( fail + 1 ))
fi
rm -rf "$cmd_tmp"

printf '\n=== mock batch timeout sends WAIT_TIMEOUT email ===\n'
timeout_tmp=""
timeout_tmp="$(mktemp -d)"
write_test_env_file "$timeout_tmp"
mkdir -p "$timeout_tmp/scripts/lib" "$timeout_tmp/scan" "$timeout_tmp/scratch/repository-helpers"
stage_batch_run_git_repo "$timeout_tmp"
stage_batch_run_bundle "$timeout_tmp"

cat >"$timeout_tmp/scripts/dep-updater" <<'EOF'
#!/usr/bin/env bash
sleep 30
EOF
chmod +x "$timeout_tmp/scripts/dep-updater" "$timeout_tmp/scripts/dep-updater-batch-run"

timeout_breadcrumb="${timeout_tmp}/smtp-timeout.out"
timeout_exit=0
(
  cd "$timeout_tmp"
  HOME="$timeout_tmp" \
  REPO_HELPERS_TEST_MODE=1 \
  REPO_HELPERS_SMTP_BREADCRUMB="$timeout_breadcrumb" \
  DEP_UPDATER_BATCH_TIMEOUT=1s \
  DEP_UPDATER_BATCH_SCAN_ROOT="${timeout_tmp}/scan" \
  DEP_UPDATER_BATCH_LOG="${timeout_tmp}/scratch/repository-helpers/dep-updater-batch.log" \
  bash "${timeout_tmp}/scripts/dep-updater-batch-run"
) || timeout_exit=$?

if [[ "$timeout_exit" -eq 124 ]] \
  && [[ -f "$timeout_breadcrumb" ]] \
  && grep -qF 'batch TIMEOUT' "$timeout_breadcrumb" \
  && grep -qF 'exceeded its deadline' "$timeout_breadcrumb" \
  && ! grep -qF 'Command failures' "$timeout_breadcrumb"; then
  printf '[PASS] mock-timeout: exit 124 and timeout failure email\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] mock-timeout: expected TIMEOUT email (exit=%s)\n' "$timeout_exit"
  fail=$(( fail + 1 ))
fi

rm -rf "$timeout_tmp"

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
