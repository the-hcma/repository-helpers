#!/usr/bin/env bash
# Smoke and static tests for scripts/dev/pre-pr-checks and submit-stack.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

pre_pr_checks="${script_dir}/../scripts/dev/pre-pr-checks"
submit_stack="${script_dir}/../scripts/dev/submit-stack"
ensure_clean_tree="${script_dir}/../scripts/dev/ensure-submit-clean-tree"
readonly pre_pr_checks submit_stack ensure_clean_tree

pass=0
fail=0

printf '\n=== pre-pr-checks --help ===\n'
help_output=""
help_exit=0
help_output="$(bash "$pre_pr_checks" --help 2>&1)" || help_exit=$?
assert_exit_0 "--help" "$help_output" "$help_exit"
assert_contains "--help" "$help_output" "shellcheck -S info"
assert_contains "--help" "$help_output" "stack worktree"
assert_contains "--help" "$help_output" "Primary worktree"
assert_contains "--help" "$help_output" "secret-scan"
assert_contains "--help" "$help_output" "PRE_PR_CHECKS_SKIP"
assert_contains "--help mentions --fix" "$help_output" "--fix"
assert_contains "--help mentions format apply env" "$help_output" "PRE_PR_CHECKS_FORMAT=apply"
assert_contains "--help warns against tail" "$help_output" "tail/head"
assert_contains "--help mentions verified-commits" "$help_output" "verified-commits"

printf '\n=== submit-stack --help ===\n'
submit_help_output=""
submit_help_exit=0
submit_help_output="$(bash "$submit_stack" --help 2>&1)" || submit_help_exit=$?
assert_exit_0 "submit-stack --help" "$submit_help_output" "$submit_help_exit"
assert_contains "submit-stack --help" "$submit_help_output" "pre-pr-checks"
assert_contains "submit-stack --help" "$submit_help_output" "ensure-submit-clean-tree"
assert_contains "submit-stack --help" "$submit_help_output" "stacking-tool"

printf '\n=== unknown argument ===\n'
unknown_output=""
unknown_exit=0
unknown_output="$(bash "$pre_pr_checks" --not-real 2>&1)" || unknown_exit=$?
assert_exit_nonzero "unknown argument" "$unknown_output" "$unknown_exit"
assert_contains "unknown argument" "$unknown_output" "Unknown argument"

printf '\n=== static: pre-pr-checks conventions ===\n'
if head -1 "$pre_pr_checks" | grep -qF '#!/usr/bin/env bash'; then
  pass_case 'shebang: bash'
  pass=$(( pass + 1 ))
else
  fail_case 'shebang: bash'
  fail=$(( fail + 1 ))
fi
if grep -qF 'set -euo pipefail' "$pre_pr_checks"; then
  pass_case 'set -euo pipefail present'
  pass=$(( pass + 1 ))
else
  fail_case 'set -euo pipefail present'
  fail=$(( fail + 1 ))
fi

dev_worktree_guard="${script_dir}/../scripts/lib/dev-worktree-guard"
readonly dev_worktree_guard

printf '\n=== static: stack worktree and main-worktree clean guards ===\n'
if grep -qF 'dev-worktree-guard' "$pre_pr_checks" \
  && grep -qF 'dev_assert_stack_worktree' "$pre_pr_checks" \
  && grep -qF 'dev_assert_main_worktree_clean' "$pre_pr_checks" \
  && grep -qF 'dev_assert_stack_worktree' "$dev_worktree_guard" \
  && grep -qF 'dev_assert_main_worktree_clean' "$dev_worktree_guard"; then
  pass_case 'pre-pr-checks enforces stack worktree and clean primary worktree'
  pass=$(( pass + 1 ))
else
  fail_case 'pre-pr-checks enforces stack worktree and clean primary worktree'
  fail=$(( fail + 1 ))
fi
if grep -qF 'verify_main_worktree_clean' "$pre_pr_checks" \
  && ! grep -qF 'temporary stash (auto-restore)' "$pre_pr_checks"; then
  pass_case 'pre-pr-checks requires clean primary worktree (no stash-and-restore)'
  pass=$(( pass + 1 ))
else
  fail_case 'pre-pr-checks requires clean primary worktree (no stash-and-restore)'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: CI parity checks ===\n'
ecosystem_lib="${script_dir}/../scripts/lib/pre-pr-ecosystem"
# shellcheck disable=SC2016  # static assert matches literal source text, not expanded vars
if grep -qF "shellcheck -S info \"\${files[@]}\"" "$pre_pr_checks" \
  && ! grep -qF -- '-e SC2329' "$pre_pr_checks" \
  && grep -qF 'bash -n' "$pre_pr_checks" \
  && grep -qF 'runner_exec "pre-pr-checks actionlint"' "$pre_pr_checks" \
  && grep -qF 'actionlint "${files[@]}"' "$pre_pr_checks" \
  && grep -qF '.github/workflows/*.yml' "$ecosystem_lib" \
  && grep -qF 'repo-practices-workflows/*.yml' "$ecosystem_lib" \
  && grep -qF 'repo-practices-workflows/*.yml' "${script_dir}/../.github/workflows/ci.yml" \
  && ! grep -qF '.github/workflows/*.yaml' "$pre_pr_checks" \
  && ! grep -qF '.github/workflows/*.yaml' "$ecosystem_lib" \
  && grep -qF 'tests/*.test' "$pre_pr_checks" \
  && grep -qF 'prec_detect_profile' "$pre_pr_checks" \
  && grep -qF 'pre-pr-ecosystem' "$pre_pr_checks"; then
  pass_case 'runs detect-first bash/shellcheck/actionlint/tests (+ ecosystem jobs)'
else
  fail_case 'runs detect-first bash/shellcheck/actionlint/tests (+ ecosystem jobs)'
fi
if grep -qF 'start_parallel_job' "$pre_pr_checks" \
  && grep -qF 'wait_parallel_checks' "$pre_pr_checks" \
  && grep -qF "Running \${prec_pr_job_count} checks in parallel" "$pre_pr_checks" \
  && grep -qF 'job_all_tests' "$pre_pr_checks" \
  && grep -qF 'unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP' "$pre_pr_checks"; then
  pass_case 'runs static checks in parallel; tests sequential with isolated TMPDIR'
else
  fail_case 'runs static checks in parallel; tests sequential with isolated TMPDIR'
fi

printf '\n=== static: submit-stack invokes pre-pr-checks ===\n'
if grep -qF 'pre-pr-checks' "$submit_stack" \
  && grep -qF 'ensure-submit-clean-tree' "$submit_stack" \
  && grep -qF 'lib/stacking-tool' "$submit_stack" \
  && grep -qF 'stacking_tool_submit' "$submit_stack" \
  && grep -qF 'post-pr-submission-checks' "$submit_stack" \
  && grep -qF -- '--no-wait-ci' "$submit_stack" \
  && ! grep -qF 'post-pr-submission-checks" --no-wait' "$submit_stack"; then
  pass_case 'submit-stack gates on pre-pr-checks and clean tree, submits via stacking-tool, then waits for CI by default'
  pass=$(( pass + 1 ))
else
  fail_case 'submit-stack gates on pre-pr-checks and clean tree, submits via stacking-tool, then waits for CI by default'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: runner adoption (pre-pr-checks, submit-stack, ensure-submit-clean-tree) ===\n'
if grep -qF 'lib/runner-bootstrap' "$pre_pr_checks" \
  && grep -qF 'runner_exec "pre-pr-checks actionlint"' "$pre_pr_checks"; then
  pass_case 'pre-pr-checks: actionlint via runner_exec'
  pass=$(( pass + 1 ))
else
  fail_case 'pre-pr-checks: actionlint via runner_exec'
  fail=$(( fail + 1 ))
fi
if grep -qF 'lib/runner-bootstrap' "$submit_stack" \
  && grep -qF 'lib/stacking-tool' "$submit_stack" \
  && grep -qF 'stacking_tool_submit' "$submit_stack"; then
  pass_case 'submit-stack: submit via stacking_tool_submit'
  pass=$(( pass + 1 ))
else
  fail_case 'submit-stack: submit via stacking_tool_submit'
  fail=$(( fail + 1 ))
fi
if grep -qF 'lib/runner-bootstrap' "$ensure_clean_tree" \
  && grep -qF 'runner_exec_stdout "ensure-submit-clean-tree git rev-parse toplevel"' "$ensure_clean_tree" \
  && grep -qF 'runner_exec_stdout "ensure-submit-clean-tree git status porcelain"' "$ensure_clean_tree"; then
  pass_case 'ensure-submit-clean-tree: git via runner_exec_stdout'
  pass=$(( pass + 1 ))
else
  fail_case 'ensure-submit-clean-tree: git via runner_exec_stdout'
  fail=$(( fail + 1 ))
fi

printf '\n=== ensure-submit-clean-tree ===\n'
clean_help_output=""
clean_help_exit=0
clean_help_output="$(bash "$ensure_clean_tree" --help 2>&1)" || clean_help_exit=$?
assert_exit_0 "ensure-submit-clean-tree --help" "$clean_help_output" "$clean_help_exit"
assert_contains "ensure-submit-clean-tree --help" "$clean_help_output" "porcelain"

tmp_repo="$(mktemp -d)"
(
  cd "$tmp_repo"
  git init -q
  git config user.email 'test@example.com'
  git config user.name 'Test'
  printf 'x\n' >README.md
  git add README.md
  git commit -q -m 'init'
)
clean_ok_exit=0
clean_ok_out="$(bash "$ensure_clean_tree" --dir "$tmp_repo" 2>&1)" || clean_ok_exit=$?
if [[ "$clean_ok_exit" -eq 0 ]]; then
  pass_case 'ensure-submit-clean-tree passes on clean repo'
  pass=$(( pass + 1 ))
else
  fail_case "ensure-submit-clean-tree passes on clean repo (exit=${clean_ok_exit} out=${clean_ok_out})"
  fail=$(( fail + 1 ))
fi
printf 'dirty\n' >>"${tmp_repo}/README.md"
clean_dirty_exit=0
clean_dirty_out="$(bash "$ensure_clean_tree" --dir "$tmp_repo" 2>&1)" || clean_dirty_exit=$?
if [[ "$clean_dirty_exit" -ne 0 ]] \
  && grep -qF 'uncommitted changes' <<<"$clean_dirty_out"; then
  pass_case 'ensure-submit-clean-tree fails on dirty repo'
  pass=$(( pass + 1 ))
else
  fail_case "ensure-submit-clean-tree fails on dirty repo (exit=${clean_dirty_exit})"
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp_repo"

printf '\n=== summary ===\n'
printf 'passed: %d  failed: %d\n' "$pass" "$fail"
if (( fail > 0 )); then
  exit 1
fi
