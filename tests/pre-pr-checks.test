#!/usr/bin/env bash
# Smoke and static tests for scripts/dev/pre-pr-checks and submit-stack.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

pre_pr_checks="${script_dir}/../scripts/dev/pre-pr-checks"
submit_stack="${script_dir}/../scripts/dev/submit-stack"
readonly pre_pr_checks submit_stack

pass=0
fail=0

printf '\n=== pre-pr-checks --help ===\n'
help_output=""
help_exit=0
help_output="$(bash "$pre_pr_checks" --help 2>&1)" || help_exit=$?
assert_exit_0 "--help" "$help_output" "$help_exit"
assert_contains "--help" "$help_output" "shellcheck -S info"
assert_contains "--help" "$help_output" "Primary worktree"

printf '\n=== submit-stack --help ===\n'
submit_help_output=""
submit_help_exit=0
submit_help_output="$(bash "$submit_stack" --help 2>&1)" || submit_help_exit=$?
assert_exit_0 "submit-stack --help" "$submit_help_output" "$submit_help_exit"
assert_contains "submit-stack --help" "$submit_help_output" "pre-pr-checks"
assert_contains "submit-stack --help" "$submit_help_output" "gt submit"

printf '\n=== unknown argument ===\n'
unknown_output=""
unknown_exit=0
unknown_output="$(bash "$pre_pr_checks" --not-real 2>&1)" || unknown_exit=$?
assert_exit_nonzero "unknown argument" "$unknown_output" "$unknown_exit"
assert_contains "unknown argument" "$unknown_output" "Unknown argument"

printf '\n=== static: pre-pr-checks conventions ===\n'
if head -1 "$pre_pr_checks" | grep -qF '#!/usr/bin/env bash'; then
  pass_case 'shebang: bash'
  pass=$(( pass + 1 ))
else
  fail_case 'shebang: bash'
  fail=$(( fail + 1 ))
fi
if grep -qF 'set -euo pipefail' "$pre_pr_checks"; then
  pass_case 'set -euo pipefail present'
  pass=$(( pass + 1 ))
else
  fail_case 'set -euo pipefail present'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: main worktree stash/restore ===\n'
if grep -qF 'worktree list --porcelain' "$pre_pr_checks" \
  && grep -qF 'temporary stash (auto-restore)' "$pre_pr_checks" \
  && grep -qF 'restore_main_worktree' "$pre_pr_checks" \
  && grep -qF 'main_status_before' "$pre_pr_checks"; then
  pass_case 'main worktree stash and state verification'
  pass=$(( pass + 1 ))
else
  fail_case 'main worktree stash and state verification'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: CI parity checks ===\n'
if grep -qF "shellcheck -S info \"\${files[@]}\"" "$pre_pr_checks" \
  && ! grep -qF -- '-e SC2329' "$pre_pr_checks" \
  && grep -qF 'bash -n' "$pre_pr_checks" \
  && grep -qF "actionlint \"\${files[@]}\"" "$pre_pr_checks" \
  && grep -qF '.github/workflows/*.yml' "$pre_pr_checks" \
  && grep -qF 'repo-practices-workflows/*.yml' "$pre_pr_checks" \
  && grep -qF 'repo-practices-workflows/*.yml' "${script_dir}/../.github/workflows/ci.yml" \
  && ! grep -qF '.github/workflows/*.yaml' "$pre_pr_checks" \
  && grep -qF 'tests/*.test' "$pre_pr_checks"; then
  pass_case 'runs bash -n, shellcheck, actionlint, and tests/*.test'
  pass=$(( pass + 1 ))
else
  fail_case 'runs bash -n, shellcheck, actionlint, and tests/*.test'
  fail=$(( fail + 1 ))
fi
if grep -qF 'start_parallel_job' "$pre_pr_checks" \
  && grep -qF 'wait_parallel_checks' "$pre_pr_checks" \
  && grep -qF "Running \${prec_pr_job_count} checks in parallel" "$pre_pr_checks"; then
  pass_case 'runs independent checks in parallel'
  pass=$(( pass + 1 ))
else
  fail_case 'runs independent checks in parallel'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: submit-stack invokes pre-pr-checks ===\n'
if grep -qF 'pre-pr-checks' "$submit_stack" \
  && grep -qF 'gt submit --publish --no-interactive' "$submit_stack" \
  && grep -qF 'post-pr-submission-checks' "$submit_stack" \
  && grep -qF -- '--no-wait' "$submit_stack"; then
  pass_case 'submit-stack gates on pre-pr-checks, submits, then asserts PR metadata'
  pass=$(( pass + 1 ))
else
  fail_case 'submit-stack gates on pre-pr-checks, submits, then asserts PR metadata'
  fail=$(( fail + 1 ))
fi

printf '\n=== summary ===\n'
printf 'passed: %d  failed: %d\n' "$pass" "$fail"
if (( fail > 0 )); then
  exit 1
fi
