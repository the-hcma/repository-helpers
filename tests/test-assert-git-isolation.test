#!/usr/bin/env bash
# Tests that run git never read the caller's git config (#862): a host commit.gpgsign=true must not reach a test repo.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tests/lib/test-assert
source "${script_dir}/lib/test-assert"
test_init

work_dir="$(mktemp -d)"
trap 'rm -rf -- "$work_dir"' EXIT

printf '\n=== functional: a host signing config does not leak into a test repository ===\n'
host_config="${work_dir}/host-gitconfig"
printf '[commit]\n\tgpgsign = true\n' >"$host_config"
# A fresh shell that sources the helper, as every test does, with a signing host config in place.
signing="$(GIT_CONFIG_GLOBAL="$host_config" GIT_CONFIG_SYSTEM="$host_config" bash -c '
  set -e
  source "$1/lib/test-assert"
  git init -q "$2/repo"
  git -C "$2/repo" config user.name t
  git -C "$2/repo" config user.email t@example.invalid
  git -C "$2/repo" rev-parse --git-dir >/dev/null
  printf "gpgsign=%s" "$(git -C "$2/repo" config --get commit.gpgsign || true)"
' _ "$script_dir" "$work_dir")"
if [[ "$signing" == 'gpgsign=' ]]; then
  pass_case 'the host commit.gpgsign=true is not visible to the test repository'
else
  printf 'got: %s\n' "$signing" >&2
  fail_case 'the host commit.gpgsign=true is not visible to the test repository'
fi

printf '\n=== static: the isolation is exported from the shared helper ===\n'
helper="$(<"${script_dir}/lib/test-assert")"
assert_contains 'the global git config is replaced by /dev/null' "$helper" 'export GIT_CONFIG_GLOBAL=/dev/null'
assert_contains 'the system git config is replaced by /dev/null' "$helper" 'export GIT_CONFIG_SYSTEM=/dev/null'

printf '\n=== static: every test that makes a git repository is isolated ===\n'
unisolated=''
for t in "${script_dir}"/*.test; do
  grep --quiet --extended-regexp 'git (-C [^ ]+ )?(init|commit)|git .*commit ' "$t" || continue
  grep --quiet --extended-regexp 'lib/test-assert|lib/github-repo-lint-part-init|export GIT_CONFIG_GLOBAL=/dev/null' "$t" \
    || unisolated+=" ${t##*/}"
done
if [[ -z "$unisolated" ]]; then
  pass_case 'no test that runs git lacks the host git config isolation'
else
  fail_case "tests that run git without isolation:${unisolated}"
fi

test_summary
