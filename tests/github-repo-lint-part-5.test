    rp_fetch_github_text_file() { return 1; }
    run
    printf -- "--- strict, missing ---\n"
    rp_strict_onboarding=1; rp_new_repo=0
    run
    printf -- "--- new-repo, missing ---\n"
    rp_strict_onboarding=0; rp_new_repo=1
    run
    printf -- "--- strict, invalid rule ---\n"
    rp_strict_onboarding=1; rp_new_repo=0
    eval "rp_fetch_github_text_file() { printf %s \"\$invalid\"; }"
    run
  ' bash "$lib"
)"
if [[ "$(grep -c 'rc=0' <<<"$gcf_suggest")" == 2 ]] \
  && [[ "$(grep -c 'rc=1' <<<"$gcf_suggest")" == 2 ]] \
  && grep -qF 'SUGGEST:the-hcma/some-consumer: add .agents/rules/github-content-formatting.md + .cursor/rules/github-content-formatting.mdc' <<<"$gcf_suggest" \
  && grep -qF 'CHECK_FAIL:github-content-formatting agents rule (.agents/rules/github-content-formatting.md)' <<<"$gcf_suggest" \
  && grep -qF 'CHECK_FAIL:github-content-formatting rule must be alwaysApply' <<<"$gcf_suggest"; then
