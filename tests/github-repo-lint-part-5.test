#!/usr/bin/env bash
# Tests for scripts/github-repo-lint and scripts/lib/repo-practices — part 5 of 6.
# Split from the former aa-github-repo-lint.test so CI can run the parts in parallel (#692).
# To add a test, read the how-to at the top of tests/lib/github-repo-lint-part-init first.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck source=tests/lib/github-repo-lint-part-init
source "${script_dir}/lib/github-repo-lint-part-init"

pass=0
fail=0

printf '\n=== functional: missing git-commit-identity fails with suggestion ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<'MOCK_GH'
#!/usr/bin/env bash
set -euo pipefail
args="$*"
if [[ "$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "$args" == *'repos/the-hcma/example-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_CONSUMER_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.github/stacking-tool'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_MARKER_GRAPHITE_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/stacking-tool.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_RULE_CONSUMER_B64}\"}"
  exit 0
fi
if [[ "$args" == *'stacking-tool.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_STACKING_RULE_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/read-agents-and-rules.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_READ_AGENTS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'read-agents-and-rules.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_READ_AGENTS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/no-secret-exposure.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_NO_SECRET_EXPOSURE_B64}\"}"
  exit 0
fi
if [[ "$args" == *'no-secret-exposure.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_NO_SECRET_EXPOSURE_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/remote-timeouts-retries.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_REMOTE_TIMEOUTS_RETRIES_B64}\"}"
  exit 0
fi
if [[ "$args" == *'remote-timeouts-retries.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_REMOTE_TIMEOUTS_RETRIES_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'contents/.agents/rules/git-commit-identity.md'* ]]; then
  exit 1
fi
if [[ "$args" == *'git-commit-identity.mdc'* ]]; then
  exit 1
fi
if [[ "$args" == *'contents/.agents/rules/pre-pr-checks.md'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_B64}\"}"
  exit 0
fi
if [[ "$args" == *'pre-pr-checks.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"${GRL_PRE_PR_CHECKS_SHIM_B64}\"}"
  exit 0
fi
if [[ "$args" == *'/commits --jq'* ]]; then
  printf '%s\n' '[{"sha":"d1f4abc","commit":{"verification":{"verified":true,"reason":"valid"}},"author":{"login":"tester"}}]'
  exit 0
fi
if [[ "$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
  --repo the-hcma/example-repo --suggest 2>&1)"
exit_code=$?
set -e

if grep -qF 'add .agents/rules/git-commit-identity.md + .cursor/rules/git-commit-identity.mdc' <<<"$output" \
  && grep -qF 'scripts/lib/repo-practices-agents/rules/' <<<"$output"; then
  printf '[PASS] git-commit-identity: missing agents rule suggests dual-path templates\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] git-commit-identity: expected missing-rule failure (exit=%s)\n%s\n' \
    "$exit_code" "$output"
  fail=$(( fail + 1 ))
fi
rm -rf "$mock_dir"

printf '\n=== unit: dual-path org agents rule outcomes (repository-helpers#637) ===\n'
dual_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_apply_fix=0
    rp_repo_short_name() { printf "example-repo\n"; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { printf "CHECK_OK:%s\n" "$2" >&2; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    rp_log_warn() { :; }
    rp_github_url() { printf "u\n"; }
    rp_queue_candidate_file_fix() {
      printf "QUEUE:%s\n" "$2" >&2
    }
    agents_valid="$(cat "$2")"
    shim_valid="$(cat <<EOF
---
description: test
alwaysApply: true
---

<!-- agents-rule-shim: read-agents-and-rules -->
Canonical rule: [\`.agents/rules/read-agents-and-rules.md\`](../../.agents/rules/read-agents-and-rules.md)
EOF
)"
    legacy_mdc="$(cat <<EOF
---
description: legacy full body
alwaysApply: true
---

# Session start: read AGENTS.md and project rules

At the start of every new agent session, read AGENTS.md and .agents/rules.
EOF
)"
    bad_shim="$(cat <<EOF
---
description: test
alwaysApply: true
---

# Not a shim — missing agents-rule-shim marker
EOF
)"

    run_check() {
      local e=0
      rp_check_read_agents_and_rules "the-hcma/example-repo" 2>&1 || e=$?
      printf "rc=%s\n" "$e"
    }

    printf -- "--- valid agents + valid shim ---\n"
    rp_suggest=1; rp_strict_onboarding=0; rp_new_repo=0; rp_apply_fix=0
    rp_fetch_github_text_file() {
      local path="$2"
      if [[ "$path" == *".agents/rules/read-agents-and-rules.md" ]]; then
        printf "%s" "$agents_valid"
        return 0
      fi
      if [[ "$path" == *".cursor/rules/read-agents-and-rules.mdc" ]]; then
        printf "%s" "$shim_valid"
        return 0
      fi
      return 1
    }
    run_check

    printf -- "--- legacy mdc only (no agents), suggest ---\n"
    rp_suggest=1; rp_strict_onboarding=1; rp_new_repo=0
    rp_fetch_github_text_file() {
      local path="$2"
      if [[ "$path" == *".agents/rules/read-agents-and-rules.md" ]]; then
        return 1
      fi
      if [[ "$path" == *".cursor/rules/read-agents-and-rules.mdc" ]]; then
        printf "%s" "$legacy_mdc"
        return 0
      fi
      return 1
    }
    run_check

    printf -- "--- legacy mdc only, new-repo ---\n"
    rp_new_repo=1; rp_strict_onboarding=0
    run_check

    printf -- "--- missing both, new-repo ---\n"
    rp_new_repo=1; rp_strict_onboarding=0; rp_suggest=1
    rp_fetch_github_text_file() { return 1; }
    run_check

    printf -- "--- invalid shim (agents valid), strict ---\n"
    rp_new_repo=0; rp_strict_onboarding=1; rp_suggest=1
    rp_fetch_github_text_file() {
      local path="$2"
      if [[ "$path" == *".agents/rules/read-agents-and-rules.md" ]]; then
        printf "%s" "$agents_valid"
        return 0
      fi
      if [[ "$path" == *".cursor/rules/read-agents-and-rules.mdc" ]]; then
        printf "%s" "$bad_shim"
        return 0
      fi
      return 1
    }
    run_check

    printf -- "--- apply-fix queues both paths ---\n"
    rp_apply_fix=1; rp_strict_onboarding=0; rp_new_repo=0; rp_suggest=1
    rp_fetch_github_text_file() { return 1; }
    run_check
  ' bash "$lib" "${rh_root}/scripts/lib/repo-practices-agents/rules/read-agents-and-rules.md"
)" || dual_out="fail:${dual_out}"
if grep -qF 'CHECK_OK:read-agents-and-rules agents rule + Cursor shim' <<<"$dual_out" \
  && grep -qF 'SUGGEST:the-hcma/example-repo: migrate .cursor/rules/read-agents-and-rules.mdc full body to .agents/rules/read-agents-and-rules.md + thin Cursor shim' <<<"$dual_out" \
  && grep -qF 'CHECK_FAIL:read-agents-and-rules agents rule (.agents/rules/read-agents-and-rules.md) — migrate from legacy .mdc' <<<"$dual_out" \
  && grep -qF 'CHECK_FAIL:read-agents-and-rules agents rule (.agents/rules/read-agents-and-rules.md)' <<<"$dual_out" \
  && grep -qF 'CHECK_FAIL:read-agents-and-rules Cursor shim (.cursor/rules/read-agents-and-rules.mdc) must preserve frontmatter and point at .agents/rules/read-agents-and-rules.md' <<<"$dual_out" \
  && grep -qF 'QUEUE:.agents/rules/read-agents-and-rules.md' <<<"$dual_out" \
  && grep -qF 'QUEUE:.cursor/rules/read-agents-and-rules.mdc' <<<"$dual_out" \
  && [[ "$(grep -c '^rc=0$' <<<"$dual_out")" -ge 2 ]] \
  && [[ "$(grep -c '^rc=1$' <<<"$dual_out")" -ge 3 ]]; then
  printf '[PASS] dual-path: valid OK; legacy SUGGEST/strict-ok/new-repo-FAIL; missing new-repo FAIL; bad shim strict FAIL; apply-fix queues pair\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] dual-path org agents rule outcomes\n%s\n' "$dual_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: read-agents-and-rules rejects keyword-only / negated rules ===\n'
unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    invalid_rule="$(cat <<EOF
---
description: looks valid by keyword presence
alwaysApply: true
---

# Session start

AGENTS.md and .agents/rules exist. Do not read AGENTS.md or .agents/rules.
EOF
)"
    valid_rule="$(cat "$2")"
    # "reread"/"reload" are real read/load verbs; "download .agents/rules" is not.
    reread_rule="$(cat <<EOF
---
alwaysApply: true
---
At every new agent session, reread AGENTS.md and reload the .agents/rules guidance.
EOF
)"
    substr_rule="$(cat <<EOF
---
alwaysApply: true
---
At session start you may download AGENTS.md and .agents/rules from origin.
EOF
)"
    if rp_read_agents_and_rules_is_valid "$invalid_rule"; then
      printf "invalid_accepted\n"
      exit 1
    fi
    if ! rp_read_agents_and_rules_is_valid "$valid_rule"; then
      printf "valid_rejected\n"
      exit 1
    fi
    if ! rp_read_agents_and_rules_is_valid "$reread_rule"; then
      printf "reread_rule_rejected\n"
      exit 1
    fi
    if rp_read_agents_and_rules_is_valid "$substr_rule"; then
      printf "download_substr_accepted\n"
      exit 1
    fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/scripts/lib/repo-practices-agents/rules/read-agents-and-rules.md"
)" || unit_out="fail:${unit_out}"
if [[ "$unit_out" == 'ok' ]]; then
  printf '[PASS] read-agents-and-rules: validator requires positive read instructions\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] read-agents-and-rules: validator accepted negated/keyword-only rule or rejected template (%s)\n' \
    "$unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: pre-pr-checks rule — hard validity vs consumer helper-path probe (#579) ===\n'
unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    own="$(cat "$2")"       # repository-helpers own copy (bare scripts/dev paths)
    consumer="$(cat "$3")"  # scripts/lib/repo-practices-cursor/ template
    # hard validity: both are valid (have alwaysApply + format + truncation sections)
    if ! rp_pre_pr_checks_rule_is_valid "$own"; then printf "own_invalid\n"; exit 1; fi
    if ! rp_pre_pr_checks_rule_is_valid "$consumer"; then printf "consumer_invalid\n"; exit 1; fi
    stripped="$(grep -v "Apply formatters before check" <<<"$consumer")"
    if rp_pre_pr_checks_rule_is_valid "$stripped"; then printf "missing_format_section_accepted\n"; exit 1; fi
    # helper-path resolution: consumer template yes, bare-path own copy no
    if ! rp_pre_pr_checks_rule_resolves_helper_paths "$consumer"; then printf "consumer_no_helper_path\n"; exit 1; fi
    if rp_pre_pr_checks_rule_resolves_helper_paths "$own"; then printf "bare_path_flagged_as_resolving\n"; exit 1; fi
    # near-miss: a REPOSITORY_HELPERS_DIR mention in prose but a bare command must NOT count
    near_miss="$(printf "%s\n" "Set REPOSITORY_HELPERS_DIR if the clone is elsewhere." "Then run scripts/dev/pre-pr-checks from the worktree.")"
    if rp_pre_pr_checks_rule_resolves_helper_paths "$near_miss"; then printf "prose_mention_flagged_as_resolving\n"; exit 1; fi
    # the inline-default form the FAIL/SUGGEST message shows must be accepted (#579 promotion)
    inline_default="run \"\${REPOSITORY_HELPERS_DIR:-\$HOME/work/ai/repository-helpers}/scripts/dev/pre-pr-checks\""
    if ! rp_pre_pr_checks_rule_resolves_helper_paths "$inline_default"; then printf "inline_default_rejected\n"; exit 1; fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/.agents/rules/pre-pr-checks.md" "${rh_root}/scripts/lib/repo-practices-agents/rules/pre-pr-checks.md"
)" || unit_out="fail:${unit_out}"
if [[ "$unit_out" == 'ok' ]]; then
  printf '[PASS] pre-pr-checks: hard validity is path-agnostic; consumer helper-path is a separate probe\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pre-pr-checks: validity / helper-path probe (%s)\n' "$unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: agent-bootstrap validators (AGENTS.md startup + CLAUDE.md / copilot shims) ===\n'
unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    agents_rh="$(cat "$2")"
    startup_snippet="$(cat "$3")"
    claude_tmpl="$(cat "$4")"
    copilot_tmpl="$(cat "$5")"

    agents_no_rules="$(cat <<EOF
# AGENTS.md

## Session startup
Read this AGENTS.md at the start of every session.
EOF
)"
    agents_negated="$(cat <<EOF
# AGENTS.md

## Session startup
At the start of every session read AGENTS.md. Do not read .agents/rules.
EOF
)"
    # Negation with markdown emphasis on the verb — must still be rejected (#577).
    agents_negated_emphasis="$(cat <<EOF
## Session startup
Read AGENTS.md. Do not **read** .agents/rules — this file is the contract.
EOF
)"
    # "read"/"load" as a substring of another word must NOT satisfy the probe (#580).
    agents_read_substring="$(cat <<EOF
## Session startup
Run start-development. The watcher offloads blocking I/O via asyncio.to_thread —
see .agents/rules/device-family-async-polling.md for the pattern.
EOF
)"
    # ...but "reading" / "load" as real words still count.
    agents_reading_word="$(cat <<EOF
## Session startup
Reading every rule under .agents/rules/*.md at session start is mandatory.
EOF
)"
    agents_load_word="$(cat <<EOF
## Session startup
At session start, load every alwaysApply rule under .agents/rules/*.md.
EOF
)"
    # compound verbs "reread" / "reload" (and hyphenated forms) are real read/load
    # instructions — \b(re-?)? keeps them, still excludes "thread"/"download" (#580).
    agents_reread_word="$(cat <<EOF
## Session startup
Reread every rule under .agents/rules/*.md, then re-read AGENTS.md.
EOF
)"
    # "upload"/"download" after a negation must NOT read as "do not read/load
    # .cursor/rules" (#580 — the negation probe is \b-anchored too). Has a real
    # positive instruction, so the whole file must still pass.
    agents_neg_substring="$(cat <<EOF
## Session startup
Read every rule under .agents/rules/*.md first. Never upload .agents/rules to a
public fork, and do not download .agents/rules from anywhere but origin.
EOF
)"
    # Canonical POSITIVE phrasings that use a negated verb form — must pass.
    agents_neg_positive_1="$(cat <<EOF
## Session startup
Do not skip reading .agents/rules at session start.
EOF
)"
    agents_neg_positive_2="$(cat <<EOF
## Startup
Never start a session without reading .agents/rules.
EOF
)"
    # Line-wrapped instruction — must still pass.
    agents_wrapped="$(cat <<EOF
## Session startup
1. At session start, read AGENTS.md.
2. Then read every alwaysApply rule under
   .agents/rules/*.md.
EOF
)"
    # Trigger phrased as "before starting any work" (no literal "session") — must pass
    # (repository-helpers#577: no brittle session-start phrase probe).
    agents_before_work="$(cat <<EOF
Before starting any work, read every rule under .agents/rules/*.md.
EOF
)"

    if ! rp_agents_md_documents_cursor_rules "$agents_rh"; then
      printf "helpers_agents_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$startup_snippet"; then
      printf "snippet_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_neg_positive_1"; then
      printf "neg_positive_1_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_neg_positive_2"; then
      printf "neg_positive_2_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_wrapped"; then
      printf "wrapped_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_before_work"; then
      printf "before_work_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_reading_word"; then
      printf "reading_word_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_load_word"; then
      printf "load_word_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_neg_substring"; then
      printf "neg_substring_rejected\n"; exit 1
    fi
    if ! rp_agents_md_documents_cursor_rules "$agents_reread_word"; then
      printf "reread_word_rejected\n"; exit 1
    fi
    if rp_agents_md_documents_cursor_rules "$agents_no_rules"; then
      printf "no_rules_accepted\n"; exit 1
    fi
    if rp_agents_md_documents_cursor_rules "$agents_read_substring"; then
      printf "read_substring_accepted\n"; exit 1
    fi
    if rp_agents_md_documents_cursor_rules "$agents_negated"; then
      printf "negated_accepted\n"; exit 1
    fi
    if rp_agents_md_documents_cursor_rules "$agents_negated_emphasis"; then
      printf "negated_emphasis_accepted\n"; exit 1
    fi
    if ! rp_claude_md_shim_is_valid "$claude_tmpl"; then
      printf "claude_tmpl_rejected\n"; exit 1
    fi
    if ! rp_claude_md_shim_is_valid "@AGENTS.md"; then
      printf "bare_import_rejected\n"; exit 1
    fi
    if rp_claude_md_shim_is_valid "# Claude\nSee AGENTS.md for rules."; then
      printf "prose_only_accepted\n"; exit 1
    fi
    if ! rp_copilot_instructions_shim_is_valid "$copilot_tmpl"; then
      printf "copilot_tmpl_rejected\n"; exit 1
    fi
    if rp_copilot_instructions_shim_is_valid "# Copilot\nNo pointer here."; then
      printf "copilot_no_pointer_accepted\n"; exit 1
    fi
    # filename match is case-insensitive, like every sibling probe
    if ! rp_copilot_instructions_shim_is_valid "See agents.md at the repo root first."; then
      printf "copilot_lowercase_rejected\n"; exit 1
    fi
    printf "ok\n"
  ' bash "$lib" \
    "${rh_root}/AGENTS.md" \
    "${rh_root}/scripts/lib/repo-practices-agents/agents-md-startup-section.md" \
    "${rh_root}/scripts/lib/repo-practices-agents/CLAUDE.md" \
    "${rh_root}/scripts/lib/repo-practices-agents/copilot-instructions.md"
)" || unit_out="fail:${unit_out}"
if [[ "$unit_out" == 'ok' ]]; then
  printf '[PASS] agent-bootstrap: validators accept templates + helpers AGENTS.md, reject missing/negated .agents/rules pointer\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-bootstrap: validator (%s)\n' "$unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: agent-bootstrap templates + repository-helpers dogfood ===\n'
agents_tmpl_dir="${rh_root}/scripts/lib/repo-practices-agents"
if [[ -f "${agents_tmpl_dir}/CLAUDE.md" ]] \
  && [[ -f "${agents_tmpl_dir}/copilot-instructions.md" ]] \
  && [[ -f "${agents_tmpl_dir}/agents-md-startup-section.md" ]] \
  && grep -qF '@AGENTS.md' "${rh_root}/CLAUDE.md" \
  && grep -qF 'AGENTS.md' "${rh_root}/.github/copilot-instructions.md" \
  && grep -qE '@AGENTS\.md' "${agents_tmpl_dir}/CLAUDE.md"; then
  printf '[PASS] agent-bootstrap: templates present; repository-helpers ships CLAUDE.md + copilot-instructions.md\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-bootstrap: missing template or repository-helpers dogfood\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: #681 .github/instructions pointer template + repository-helpers dogfood ===\n'
if [[ -f "${agents_tmpl_dir}/agents-rules.instructions.md" ]] \
  && cmp -s "${agents_tmpl_dir}/agents-rules.instructions.md" \
    "${rh_root}/.github/instructions/agents-rules.instructions.md"; then
  printf '[PASS] #681: repository-helpers ships .github/instructions/agents-rules.instructions.md identical to the template\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #681: .github/instructions/agents-rules.instructions.md missing or drifted from the template\n'
  fail=$(( fail + 1 ))
fi
# A single pointer file, not one generated shim per rule.
instructions_count=0
for instructions_file in "${rh_root}"/.github/instructions/*.instructions.md; do
  [[ -e "$instructions_file" ]] || continue
  instructions_count=$(( instructions_count + 1 ))
done
if (( instructions_count == 1 )); then
  printf '[PASS] #681: .github/instructions holds exactly one pointer file\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #681: expected exactly one .github/instructions/*.instructions.md, found %s\n' \
    "$instructions_count"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: #681 agents-rules instructions validator ===\n'
air_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${air_dir}/runner-sessions"
air_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    template="$(cat "$3")"
    body="Read every rule under .agents/rules/*.md at session start."
    fails=""
    rp_agents_rules_instructions_is_valid "$template" || fails="$fails template"
    for apply_to in "**" "'"'"'**'"'"'" "\"**\""; do
      rp_agents_rules_instructions_is_valid "$(printf -- "---\napplyTo: %s\n---\n\n%s\n" "$apply_to" "$body")" \
        || fails="$fails apply-to:${apply_to}"
    done
    if rp_agents_rules_instructions_is_valid "$(printf -- "---\napplyTo: \"**/*.sh\"\n---\n\n%s\n" "$body")"; then
      fails="$fails narrow-glob-accepted"
    fi
    if rp_agents_rules_instructions_is_valid "$(printf -- "---\ndescription: x\n---\n\n%s\n" "$body")"; then
      fails="$fails no-apply-to-accepted"
    fi
    if rp_agents_rules_instructions_is_valid "$(printf -- "---\napplyTo: \"**\"\n---\n\nSee AGENTS.md.\n")"; then
      fails="$fails no-rules-pointer-accepted"
    fi
    if rp_agents_rules_instructions_is_valid "$(printf -- "---\napplyTo: \"**\"\ndescription: Load .agents/rules\n---\n\nHello.\n")"; then
      fails="$fails front-matter-only-pointer-accepted"
    fi
    if rp_agents_rules_instructions_is_valid "$(printf -- "---\napplyTo: \"**\"\n---\n\nDo not read .agents/rules.\n")"; then
      fails="$fails negated-pointer-accepted"
    fi
    if [[ -n "$fails" ]]; then printf "FAILS:%s\n" "$fails"; exit 1; fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib" "${agents_tmpl_dir}/agents-rules.instructions.md"
)" || air_out="fail:${air_out}"
rm -rf "$air_dir"
unset RUNNER_SESSION_ROOT
if [[ "$air_out" == 'ok' ]]; then
  printf "[PASS] #681: validator accepts the template and applyTo **, rejects a narrow glob, missing applyTo, missing/negated or front-matter-only .agents/rules pointer\n"
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #681: agents-rules instructions validator (%s)\n' "$air_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: #681 .github/instructions pointer uses the rollout ratchet ===\n'
air2_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${air2_dir}/runner-sessions"
air2_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    agents_md="$(cat "$3")"
    instructions=""
    rp_fetch_github_text_file() {
      case "$2" in
        AGENTS.md) printf "%s" "$agents_md" ;;
        CLAUDE.md) printf "@AGENTS.md\n" ;;
        .github/copilot-instructions.md) printf "Read AGENTS.md first.\n" ;;
        .github/instructions/agents-rules.instructions.md) printf "%s" "$instructions" ;;
      esac
    }
    rp_agent_bootstrap_path_is_agents_symlink() { return 1; }
    rp_log_gh_api_fail() { printf "API_FAIL\n" >&2; }
    rp_log_warn() { :; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { printf "CHECK_OK\n" >&2; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    rp_queue_candidate_file_fix() { printf "QUEUED:%s:%s\n" "$2" "$4" >&2; }
    rp_github_url() { printf "u\n"; }
    rp_compact=0; rp_apply_fix=0; rp_suggest=1
    fails=""
    run() {
      local rc=0 out
      out="$(rp_check_agent_bootstrap the-hcma/example-repo 2>&1)" || rc=$?
      printf "%s|%s" "$rc" "$out"
    }

    # missing: SUGGEST under routine and --strict-onboarding, FAIL --new-repo
    instructions=""
    rp_strict_onboarding=0; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" == 0 ]] && grep -qF "SUGGEST:the-hcma/example-repo: add .github/instructions/agents-rules.instructions.md" <<<"$r" \
      || fails="$fails missing-routine"
    rp_strict_onboarding=1; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" == 0 ]] || fails="$fails missing-strict-should-pass"
    rp_strict_onboarding=0; rp_new_repo=1; r="$(run)"
    [[ "${r%%|*}" != 0 ]] && grep -qF "CHECK_FAIL:.github/instructions/agents-rules.instructions.md" <<<"$r" \
      || fails="$fails missing-new-repo-should-fail"

    # invalid (narrow applyTo): FAIL --strict-onboarding, SUGGEST routine
    instructions="$(printf -- "---\napplyTo: \"**/*.sh\"\n---\n\nRead .agents/rules/*.md at session start.\n")"
    rp_strict_onboarding=1; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" != 0 ]] && grep -qF "CHECK_FAIL:.github/instructions/agents-rules.instructions.md" <<<"$r" \
      || fails="$fails invalid-strict-should-fail"
    rp_strict_onboarding=0; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" == 0 ]] && ! grep -qF CHECK_FAIL <<<"$r" || fails="$fails invalid-routine-should-pass"

    # --apply-fix queues the template
    instructions=""
    rp_apply_fix=1; rp_strict_onboarding=0; rp_new_repo=0; r="$(run)"
    grep -qF "QUEUED:.github/instructions/agents-rules.instructions.md:add-agents-rules-instructions" <<<"$r" \
      || fails="$fails apply-fix-not-queued"
    rp_apply_fix=0

    # valid template: CHECK_OK under --new-repo
    instructions="$(cat "$4")"
    rp_strict_onboarding=1; rp_new_repo=1; r="$(run)"
    [[ "${r%%|*}" == 0 ]] && grep -qF CHECK_OK <<<"$r" && ! grep -qF SUGGEST <<<"$r" \
      || fails="$fails valid-should-pass:${r}"

    if [[ -n "$fails" ]]; then printf "FAILS:%s\n" "$fails"; exit 1; fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib" \
    "${rh_root}/AGENTS.md" \
    "${agents_tmpl_dir}/agents-rules.instructions.md"
)" || air2_out="fail:${air2_out}"
rm -rf "$air2_dir"
unset RUNNER_SESSION_ROOT
if [[ "$air2_out" == 'ok' ]]; then
  printf '[PASS] #681: missing pointer SUGGESTs under routine/strict and FAILs --new-repo; invalid FAILs strict; --apply-fix queues the template\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #681: .github/instructions rollout ratchet (%s)\n' "$air2_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: entry-point shims must not point at the legacy .cursor/rules location ===\n'
stale_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${stale_dir}/runner-sessions"
stale_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    agents_md="$(cat "$3")"
    instructions="$(cat "$4")"
    stub_claude="@AGENTS.md"
    stub_copilot="Read AGENTS.md first."
    rp_fetch_github_text_file() {
      case "$2" in
        AGENTS.md) printf "%s" "$agents_md" ;;
        CLAUDE.md) printf "%s" "$stub_claude" ;;
        .github/copilot-instructions.md) printf "%s" "$stub_copilot" ;;
        .github/instructions/agents-rules.instructions.md) printf "%s" "$instructions" ;;
      esac
    }
    rp_agent_bootstrap_path_is_agents_symlink() { return 1; }
    rp_log_gh_api_fail() { printf "API_FAIL\n" >&2; }
    rp_log_warn() { :; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { printf "CHECK_OK\n" >&2; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    rp_queue_candidate_file_fix() { printf "QUEUED:%s:%s\n" "$2" "$4" >&2; }
    rp_agent_bootstrap_template() { printf "template\n"; }
    rp_github_url() { printf "u\n"; }
    rp_compact=0; rp_apply_fix=0; rp_suggest=1
    fails=""
    run() {
      local rc=0 out
      out="$(rp_check_agent_bootstrap the-hcma/example-repo 2>&1)" || rc=$?
      printf "%s|%s" "$rc" "$out"
    }

    # helper: stale only when .cursor/rules is named and .agents/rules is not
    rp_agent_shim_has_stale_cursor_rules_pointer "load every rule under \`.cursor/rules/\`" || fails="$fails helper-stale"
    ! rp_agent_shim_has_stale_cursor_rules_pointer "load every rule under \`.agents/rules/\`" || fails="$fails helper-current"
    ! rp_agent_shim_has_stale_cursor_rules_pointer "rules in .agents/rules (.cursor/rules are shims)" || fails="$fails helper-both-ok"

    # stale copilot shim: FAIL strict and --new-repo, SUGGEST only when routine
    stub_copilot="Read AGENTS.md; load every rule under .cursor/rules/."
    rp_strict_onboarding=1; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" != 0 ]] && grep -qF "CHECK_FAIL:.github/copilot-instructions.md must point at .agents/rules" <<<"$r" \
      || fails="$fails copilot-strict-should-fail"
    rp_strict_onboarding=0; rp_new_repo=1; r="$(run)"
    [[ "${r%%|*}" != 0 ]] || fails="$fails copilot-new-repo-should-fail"
    rp_strict_onboarding=0; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" == 0 ]] && ! grep -qF CHECK_FAIL <<<"$r" \
      && grep -qF "SUGGEST:the-hcma/example-repo: .github/copilot-instructions.md still points at .cursor/rules" <<<"$r" \
      || fails="$fails copilot-routine-should-suggest"

    # stale CLAUDE.md under strict FAILs; a case variant is detected too
    stub_copilot="Read AGENTS.md; load every rule under .agents/rules/."
    stub_claude="@AGENTS.md
Load rules under .Cursor/Rules/."
    rp_strict_onboarding=1; rp_new_repo=0; r="$(run)"
    [[ "${r%%|*}" != 0 ]] && grep -qF "CHECK_FAIL:CLAUDE.md must point at .agents/rules" <<<"$r" \
      || fails="$fails claude-strict-should-fail"

    # --apply-fix replaces CLAUDE.md only when it is the bare import (comments/blank lines ignored)
    stub_claude="@AGENTS.md

<!-- Claude loads this; rules under .cursor/rules/. -->"
    rp_apply_fix=1; rp_strict_onboarding=0; rp_new_repo=0; r="$(run)"
    grep -qF "QUEUED:CLAUDE.md:sync-claude-md-shim" <<<"$r" || fails="$fails bare-claude-fix-not-queued"
    stub_claude="@AGENTS.md
Claude-specific guidance: see .cursor/rules/ for details."
    r="$(run)"
    ! grep -qF "QUEUED:CLAUDE.md" <<<"$r" \
      && grep -qF "SUGGEST:the-hcma/example-repo: CLAUDE.md still points at .cursor/rules" <<<"$r" \
      || fails="$fails customized-claude-must-not-be-overwritten"
    stub_claude="@AGENTS.md"
    stub_copilot="Read AGENTS.md; load every rule under .cursor/rules/."
    r="$(run)"
    ! grep -qF "QUEUED:.github/copilot-instructions.md" <<<"$r" || fails="$fails copilot-should-not-be-overwritten"
    rp_apply_fix=0

    # --apply-fix never replaces a non-empty invalid shim (it may hold repo-specific guidance);
    # only a missing/empty file is auto-created from the template
    stub_claude="Repo-specific Claude guidance with no import."
    stub_copilot="Repo-specific Copilot hints that never mention the pointer."
    rp_apply_fix=1; rp_strict_onboarding=0; rp_new_repo=0; r="$(run)"
    ! grep -qF "QUEUED:CLAUDE.md" <<<"$r" || fails="$fails invalid-claude-overwritten"
    ! grep -qF "QUEUED:.github/copilot-instructions.md" <<<"$r" || fails="$fails invalid-copilot-overwritten"
    stub_claude=""
    stub_copilot=""
    r="$(run)"
    grep -qF "QUEUED:CLAUDE.md:add-claude-md-shim" <<<"$r" || fails="$fails missing-claude-not-created"
    grep -qF "QUEUED:.github/copilot-instructions.md:add-copilot-instructions-shim" <<<"$r" \
      || fails="$fails missing-copilot-not-created"
    rp_apply_fix=0

    # a shim already rejected as invalid (no AGENTS.md import) is reported once, not twice
    stub_claude="Load rules under .cursor/rules/."
    stub_copilot="Read AGENTS.md; load every rule under .agents/rules/."
    rp_strict_onboarding=1; rp_new_repo=0; r="$(run)"
    n="$(grep -cF "CHECK_FAIL:CLAUDE.md" <<<"$r" || true)"
    [[ "$n" == 1 ]] || fails="$fails claude-double-reported:$n"

    # current shims pass under the strictest mode
    stub_claude="@AGENTS.md"
    stub_copilot="Read AGENTS.md; load every rule under .agents/rules/."
    rp_strict_onboarding=1; rp_new_repo=1; r="$(run)"
    [[ "${r%%|*}" == 0 ]] && grep -qF CHECK_OK <<<"$r" && ! grep -qF SUGGEST <<<"$r" \
      || fails="$fails current-should-pass:${r}"

    if [[ -n "$fails" ]]; then printf "FAILS:%s\n" "$fails"; exit 1; fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib" \
    "${rh_root}/AGENTS.md" \
    "${agents_tmpl_dir}/agents-rules.instructions.md"
)" || stale_out="fail:${stale_out}"
rm -rf "$stale_dir"
unset RUNNER_SESSION_ROOT
if [[ "$stale_out" == 'ok' ]]; then
  printf '[PASS] stale shims: a CLAUDE.md or copilot-instructions.md pointing at .cursor/rules FAILs strict/new-repo, SUGGESTs routine, and --apply-fix only queues CLAUDE.md\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] stale shims: .cursor/rules reference check (%s)\n' "$stale_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== static: agent-bootstrap wired into the check dispatch ===\n'
# shellcheck disable=SC2016  # grep for the literal dispatch line in source
if grep -qE '^\s*if ! rp_check_agent_bootstrap "\$slug"; then' "$lib" \
  && grep -qF "path\" == 'CLAUDE.md'" "$lib" \
  && grep -qF "path\" == '.github/copilot-instructions.md'" "$lib" \
  && grep -qF 'target" == "${prefix}AGENTS.md"' "$lib" \
  && grep -cF 'rp_agent_bootstrap_path_is_agents_symlink "$slug"' "$lib" | awk '{ exit !($1 >= 2) }' \
  && ! grep -qF 'basename "$target") == '\''AGENTS.md'\''' "$lib"; then
  printf '[PASS] agent-bootstrap: check runs in the audit loop; API-eligible; symlink probe (depth-aware target) for CLAUDE.md AND copilot-instructions.md\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-bootstrap: not wired into dispatch, not API-eligible, or symlink probe missing/basename-only\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: agent-bootstrap Contents API error non-fatal outside strict/new-repo ===\n'
ab_api_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${ab_api_dir}/runner-sessions"
ab_api_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_fetch_github_text_file() { return 2; }
    rp_log_gh_api_fail() { printf "API_FAIL\n" >&2; }
    rp_log_warn() { printf "WARN\n" >&2; }
    rp_log_check_fail() { printf "CHECK_FAIL\n" >&2; }
    rp_log_check_ok() { :; }
    rp_log_suggest() { printf "SUGGEST\n" >&2; }
    rp_github_url() { printf "u\n"; }
    rp_compact=0; rp_apply_fix=0
    rp_suggest=0; rp_strict_onboarding=0; rp_new_repo=0
    set +e
    routine_out="$(rp_check_agent_bootstrap the-hcma/example-repo 2>&1)"; routine_rc=$?
    rp_new_repo=1
    intake_out="$(rp_check_agent_bootstrap the-hcma/example-repo 2>&1)"; intake_rc=$?
    set -e
    if [[ "$routine_rc" -ne 0 ]] || grep -qF CHECK_FAIL <<<"$routine_out" || grep -qF API_FAIL <<<"$routine_out"; then
      printf "routine rc=%s out=%s\n" "$routine_rc" "$routine_out"; exit 1
    fi
    if [[ "$intake_rc" -eq 0 ]] || ! grep -qF API_FAIL <<<"$intake_out"; then
      printf "intake rc=%s out=%s\n" "$intake_rc" "$intake_out"; exit 1
    fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || ab_api_out="fail:${ab_api_out}"
rm -rf "$ab_api_dir"
unset RUNNER_SESSION_ROOT
if [[ "$ab_api_out" == 'ok' ]]; then
  printf '[PASS] agent-bootstrap: fetch_ec=2 is non-fatal in routine audits, FAILs only under --new-repo/--strict\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-bootstrap: Contents API error handling (%s)\n' "$ab_api_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: agent-bootstrap symlink probe accepts depth-correct ../AGENTS.md ===\n'
ab_sym_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${ab_sym_dir}/runner-sessions"
ab_sym_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    # Stub the API layer: TARGET env is the symlink target the Contents API returns.
    rp_runner_gh_api_stream() { printf "resp\n"; }
    rp_runner_jq_file() {
      case "$*" in
        *".type"*) printf "symlink\n" ;;
        *".target"*) printf "%s\n" "${TARGET:-}" ;;
      esac
    }
    rc() { local e=0; "$@" || e=$?; printf "%s" "$e"; }
    fails=""
    # CLAUDE.md (root): AGENTS.md and ./AGENTS.md accepted; ../AGENTS.md rejected
    [[ "$(TARGET=AGENTS.md   rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 0 ]] || fails="$fails claude:AGENTS.md"
    [[ "$(TARGET=./AGENTS.md rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 0 ]] || fails="$fails claude:./AGENTS.md"
    [[ "$(TARGET=../AGENTS.md rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 1 ]] || fails="$fails claude-parent-not-1"
    [[ "$(TARGET=docs/AGENTS.md rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 1 ]] || fails="$fails claude-subdir-not-1"
    # .github/copilot-instructions.md (depth 1): ../AGENTS.md accepted; AGENTS.md rejected
    [[ "$(TARGET=../AGENTS.md rc rp_agent_bootstrap_path_is_agents_symlink x .github/copilot-instructions.md)" == 0 ]] || fails="$fails copilot:../AGENTS.md"
    [[ "$(TARGET=AGENTS.md rc rp_agent_bootstrap_path_is_agents_symlink x .github/copilot-instructions.md)" == 1 ]] || fails="$fails copilot-bare-not-1"
    # Regular file (type != symlink) -> rc 1 (not a symlink)
    rp_runner_jq_file() { case "$*" in *".type"*) printf "file\n" ;; esac; }
    [[ "$(rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 1 ]] || fails="$fails regular-file-not-1"
    # API error -> rc 2 (never "missing")
    rp_runner_gh_api_stream() { return 1; }
    rp_gh_api_classify_contents_failure() { return 2; }
    [[ "$(rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 2 ]] || fails="$fails api-error-not-2"
    # 404 -> rc 1
    rp_gh_api_classify_contents_failure() { return 1; }
    [[ "$(rc rp_agent_bootstrap_path_is_agents_symlink x CLAUDE.md)" == 1 ]] || fails="$fails notfound-not-1"
    if [[ -n "$fails" ]]; then printf "FAILS:%s\n" "$fails"; exit 1; fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || ab_sym_out="fail:${ab_sym_out}"
rm -rf "$ab_sym_dir"
unset RUNNER_SESSION_ROOT
if [[ "$ab_sym_out" == 'ok' ]]; then
  printf '[PASS] agent-bootstrap: symlink target is compared relative to the file (../AGENTS.md for .github/, AGENTS.md for root)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-bootstrap: depth-aware symlink target check (%s)\n' "$ab_sym_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: #575 — missing rollout files FAIL --strict-onboarding, SUGGEST-only in routine --all ===\n'
promote_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${promote_dir}/runner-sessions"
promote_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_fetch_github_text_file() { return 0; }              # every rollout file "missing"
    rp_agent_bootstrap_path_is_agents_symlink() { return 1; }  # shims are not symlinks
    rp_log_gh_api_fail() { printf "API_FAIL\n" >&2; }
    rp_log_warn() { :; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { :; }
    rp_log_suggest() { printf "SUGGEST\n" >&2; }
    rp_log_manual_step() { :; }
    rp_github_url() { printf "u\n"; }
    rp_compact=0; rp_apply_fix=0; rp_suggest=1

    rc() { local e=0; "$@" >/dev/null 2>&1 || e=$?; printf "%s" "$e"; }
    fails=""
    # Dual-path org rules (#637): missing agents is SUGGEST under routine and
    # --strict-onboarding; FAIL only under --new-repo.
    for fn in rp_check_no_secret_exposure rp_check_pre_pr_checks_rule rp_check_remote_timeouts_retries rp_check_github_api_throttle rp_check_github_content_formatting; do
      rp_strict_onboarding=0; rp_new_repo=0
      [[ "$(rc "$fn" the-hcma/example-repo)" == 0 ]] || fails="$fails ${fn}:routine-should-pass"
      rp_strict_onboarding=1; rp_new_repo=0
      [[ "$(rc "$fn" the-hcma/example-repo)" == 0 ]] || fails="$fails ${fn}:strict-should-pass"
      rp_strict_onboarding=0; rp_new_repo=1
      [[ "$(rc "$fn" the-hcma/example-repo)" != 0 ]] || fails="$fails ${fn}:new-repo-should-fail"
    done
    # agent-bootstrap still FAILs missing AGENTS.md under --strict-onboarding.
    rp_strict_onboarding=0; rp_new_repo=0
    [[ "$(rc rp_check_agent_bootstrap the-hcma/example-repo)" == 0 ]] || fails="$fails rp_check_agent_bootstrap:routine-should-pass"
    rp_strict_onboarding=1; rp_new_repo=0
    [[ "$(rc rp_check_agent_bootstrap the-hcma/example-repo)" != 0 ]] || fails="$fails rp_check_agent_bootstrap:strict-should-fail"
    if [[ -n "$fails" ]]; then printf "FAILS:%s\n" "$fails"; exit 1; fi
    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || promote_out="fail:${promote_out}"
rm -rf "$promote_dir"
unset RUNNER_SESSION_ROOT
if [[ "$promote_out" == 'ok' ]]; then
  printf '[PASS] #575: dual-path missing rules SUGGEST under routine/strict, FAIL --new-repo; agent-bootstrap still FAILs missing under --strict-onboarding\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #575: strict-onboarding promotion of missing rollout files (%s)\n' "$promote_out"
  fail=$(( fail + 1 ))
fi

