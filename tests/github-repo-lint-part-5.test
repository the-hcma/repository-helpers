printf '\n=== unit: github-api-throttle rule validator ===\n'
gat_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    template="$(rp_github_api_throttle_rule_template)"
    dogfood="$(cat "$2")"
    # The consumer template is a thin pointer, NOT a copy of the fuller dogfood
    # rule — they must differ.
    if [[ "$template" == "$dogfood" ]]; then
      printf "template_is_a_copy_of_dogfood\n"; exit 1
    fi
    if ! rp_github_api_throttle_rule_is_valid "$template" "the-hcma/some-consumer"; then
      printf "consumer_template_rejected\n"; exit 1
    fi
    if ! rp_github_api_throttle_rule_is_valid "$dogfood" "the-hcma/repository-helpers"; then
      printf "dogfood_rejected\n"; exit 1
    fi
    usage="\"\${REPOSITORY_HELPERS_DIR:-x}/scripts/gh-api\" <gh args>"
    crumb="github-api-throttle-canonical: http://x"
    body() { printf -- "---\nalwaysApply: true\n---\n%s\n%s\n" "$1" "$crumb"; }
    if rp_github_api_throttle_rule_is_valid "$(printf -- "---\nalwaysApply: false\n---\nRun gh through scripts/gh-api. REPOSITORY_HELPERS_DIR\n%s\n" "$crumb")" "the-hcma/x"; then
      printf "not_alwaysApply_accepted\n"; exit 1
    fi
    # Bare path mention with no imperative -> rejected (structural directive).
    if rp_github_api_throttle_rule_is_valid "$(body "The scripts/gh-api helper exists; set REPOSITORY_HELPERS_DIR.")" "the-hcma/x"; then
      printf "bare_mention_accepted\n"; exit 1
    fi
    # Permissive prose across lines must be caught (checks run on flattened text).
    permissive="$(printf -- "---\ndescription: Run agent gh calls through repository-helpers/scripts/gh-api\nalwaysApply: true\n---\nAgents may call gh directly whenever they prefer. For rate-limit backoff, prefer\n%s.\n%s\n" "$usage" "$crumb")"
    if rp_github_api_throttle_rule_is_valid "$permissive" "the-hcma/x"; then
      printf "permissive_prose_accepted\n"; exit 1
    fi
    if rp_github_api_throttle_rule_is_valid "$(body "You may run gh through scripts/gh-api via REPOSITORY_HELPERS_DIR ${usage}, or call gh directly.")" "the-hcma/x"; then
      printf "you_may_decoy_accepted\n"; exit 1
    fi
    if rp_github_api_throttle_rule_is_valid "$(body "Optionally route through ${usage} if you like. REPOSITORY_HELPERS_DIR")" "the-hcma/x"; then
      printf "optional_route_decoy_accepted\n"; exit 1
    fi
    # A rule that only forbids the wrapper -> rejected.
    if rp_github_api_throttle_rule_is_valid "$(body "Do not use scripts/gh-api. Run gh ${usage} directly. REPOSITORY_HELPERS_DIR")" "the-hcma/x"; then
      printf "forbid_wrapper_decoy_accepted\n"; exit 1
    fi
    # "Never call gh directly; route every call through …" -> valid (forbids
    # bare gh AND mandates the wrapper).
    if ! rp_github_api_throttle_rule_is_valid "$(body "Never call gh directly; route every call through ${usage}. REPOSITORY_HELPERS_DIR")" "the-hcma/x"; then
      printf "strict_phrasing_rejected\n"; exit 1
    fi
    if rp_github_api_throttle_rule_is_valid "$(printf -- "---\nalwaysApply: true\n---\nAgents must run gh through %s.\n" "$usage")" "the-hcma/consumer-x"; then
      printf "consumer_missing_breadcrumb_accepted\n"; exit 1
    fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/.agents/rules/github-api-throttle.md"
)" || gat_out="fail:${gat_out}"
if [[ "$gat_out" == 'ok' ]]; then
  printf '[PASS] github-api-throttle: validator accepts template + dogfood + strict phrasing; rejects copy / not-alwaysApply / bare mention / multi-line permissive prose / you-may / optional-route / forbid-wrapper / consumer missing breadcrumb\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] github-api-throttle: validator wrong (%s)\n' "$gat_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: github-api-throttle rule — routine SUGGESTs, strict/new-repo FAILs (repository-helpers#608 rollout complete) ===\n'
gat_suggest="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_apply_fix=0
    rp_repo_short_name() { printf "some-consumer\n"; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { :; }
    rp_log_suggest() { printf "SUGGEST:%s\n" "$1" >&2; }
    rp_log_warn() { :; }
    rp_github_url() { printf "u\n"; }
    invalid="$(printf -- "---\nalwaysApply: true\n---\nno wrapper mention here\n")"

    run() { local e=0; rp_check_github_api_throttle "the-hcma/some-consumer" 2>&1 || e=$?; printf "rc=%s\n" "$e"; }

    printf -- "--- routine (no strict), missing ---\n"
    rp_suggest=1; rp_strict_onboarding=0; rp_new_repo=0
    rp_fetch_github_text_file() { return 1; }
    run
    printf -- "--- strict, missing ---\n"
    rp_strict_onboarding=1; rp_new_repo=0
    run
    printf -- "--- new-repo, missing ---\n"
    rp_strict_onboarding=0; rp_new_repo=1
    run
    printf -- "--- strict, invalid rule ---\n"
    rp_strict_onboarding=1; rp_new_repo=0
    eval "rp_fetch_github_text_file() { printf %s \"\$invalid\"; }"
    run
  ' bash "$lib"
)"
if [[ "$(grep -c 'rc=0' <<<"$gat_suggest")" == 2 ]] \
  && [[ "$(grep -c 'rc=1' <<<"$gat_suggest")" == 2 ]] \
  && grep -qF 'SUGGEST:the-hcma/some-consumer: add .agents/rules/github-api-throttle.md + .cursor/rules/github-api-throttle.mdc' <<<"$gat_suggest" \
  && grep -qF 'CHECK_FAIL:github-api-throttle agents rule (.agents/rules/github-api-throttle.md)' <<<"$gat_suggest" \
  && grep -qF 'CHECK_FAIL:github-api-throttle rule must be alwaysApply' <<<"$gat_suggest"; then
  printf '[PASS] github-api-throttle: routine/strict missing SUGGEST-only (rc 0); --new-repo missing + strict invalid FAIL (rc 1)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] github-api-throttle: rollout-complete ratchet wrong\n%s\n' "$gat_suggest"
  fail=$(( fail + 1 ))
fi

