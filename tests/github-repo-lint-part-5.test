  in_fn && /entry_rc == 1/ { saw_absent=1 }
  in_fn && /entry_rc == 2/ { saw_missing=1 }
  in_fn && /entry_rc == 3/ { saw_corrupt=1 }
  in_fn && /SECRET_AUDIT_INTAKE_MISSING/ { saw_missing_err=1 }
  in_fn && /SECRET_AUDIT_INTAKE_STALE/ { saw_stale_err=1 }
  in_fn && /SECRET_AUDIT_INTAKE_UNREADABLE/ { saw_corrupt_err=1 }
  in_fn && /rp_fetch_github_text_file/ { saw_fetch=1 }
  in_fn && /^}/ { exit }
  END { exit(saw_read && saw_absent && saw_missing && saw_corrupt && saw_missing_err && saw_stale_err && saw_corrupt_err && !saw_fetch ? 0 : 1) }
' "$lib" \
  && grep -qF 'rp_check_secret_audit_intake "$slug"' "$lib" \
  && ! grep -qF 'rp_check_secret_audit_marker' "$lib"; then
