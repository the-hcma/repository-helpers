printf '\n=== unit: agents gitignore dual un-ignore + parent !.agents/ ===\n'
if bash -c '
  set -euo pipefail
  # shellcheck disable=SC1091
  source "'"${lib}"'"
  dual="$(printf "%s\n" ".agents/*" "!.agents/rules/" "!.agents/rules/**" "!.agents/skills/" "!.agents/skills/**")"
  skills_only="$(printf "%s\n" ".agents/*" "!.agents/skills/" "!.agents/skills/**")"
  parent="$(printf "%s\n" ".agents/*" "!.agents/" "!.agents/**")"
  blocked="$(printf "%s\n" ".agents/*")"
  # Parent-dir ignore (.agents/) without !.agents/ first — Git still ignores children
  # even when !.agents/rules/** is present (heuristic previously false-negatived this).
  parent_dir_false_neg="$(printf "%s\n" ".agents/" "!.agents/rules/" "!.agents/rules/**")"
  rp_gitignore_text_blocks_agents_skills "$dual" && exit 1
  rp_gitignore_text_blocks_agents_rules "$dual" && exit 1
  rp_gitignore_text_blocks_agents_skills "$skills_only" && exit 1
  rp_gitignore_text_blocks_agents_rules "$skills_only" || exit 1
  rp_gitignore_text_blocks_agents_skills "$parent" && exit 1
  rp_gitignore_text_blocks_agents_rules "$parent" && exit 1
  rp_gitignore_text_blocks_agents_skills "$blocked" || exit 1
  rp_gitignore_text_blocks_agents_rules "$blocked" || exit 1
  rp_gitignore_text_ignores_path "$parent_dir_false_neg" \
    ".agents/rules/pr-ship-and-review.md" || exit 1
  rp_gitignore_text_ignores_path "$dual" \
    ".agents/rules/pr-ship-and-review.md" && exit 1
  true
'; then
  printf '[PASS] agents gitignore: dual skills/rules un-ignore and !.agents/ parent clear blocks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agents gitignore: dual un-ignore or parent !.agents/ handling broken\n'
  fail=$(( fail + 1 ))
fi

