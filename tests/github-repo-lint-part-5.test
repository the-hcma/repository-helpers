printf '\n=== unit: github-content-formatting rule validator ===\n'
gcf_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    body() { printf -- "---\nalwaysApply: true\n---\n%s\n" "$1"; }
    usage="post with --body-file and lint with scripts/lint-github-markdown; separate paragraphs with a blank line"

    template="$(rp_github_content_formatting_rule_template)"
    if ! rp_github_content_formatting_rule_is_valid "$template" "the-hcma/some-consumer"; then
      printf "template_invalid\n"; exit 1
    fi
    dogfood="$(cat "$2")"
    if ! rp_github_content_formatting_rule_is_valid "$dogfood" "the-hcma/repository-helpers"; then
      printf "dogfood_invalid\n"; exit 1
    fi
    if rp_github_content_formatting_rule_is_valid "$dogfood" "the-hcma/consumer-full-copy"; then
      printf "full_copy_accepted\n"; exit 1
    fi

    crumb="github-content-formatting-canonical: https://github.com/the-hcma/repository-helpers/blob/main/.agents/rules/github-content-formatting.md"
    if rp_github_content_formatting_rule_is_valid "$(printf -- "---\nalwaysApply: false\n---\n%s\n%s\n" "$usage" "$crumb")" "the-hcma/x"; then
      printf "not_alwaysapply_accepted\n"; exit 1
    fi
    if rp_github_content_formatting_rule_is_valid "$(body "Write good issues.")" "the-hcma/x"; then
      printf "bare_mention_accepted\n"; exit 1
    fi
    if rp_github_content_formatting_rule_is_valid "$(printf -- "---\nalwaysApply: true\n---\nUse --body-file and a blank line. %s\n" "$crumb")" "the-hcma/x"; then
      printf "missing_linter_accepted\n"; exit 1
    fi
    if rp_github_content_formatting_rule_is_valid "$(body "${usage}")" "the-hcma/consumer-x"; then
      printf "consumer_missing_breadcrumb_accepted\n"; exit 1
    fi
    if ! rp_github_content_formatting_rule_is_valid "$(printf -- "---\nalwaysApply: true\n---\n%s\n%s\n" "$usage" "$crumb")" "the-hcma/consumer-x"; then
      printf "consumer_with_breadcrumb_rejected\n"; exit 1
    fi
    unsubstituted_crumb="github-content-formatting-canonical: @@GH_CONTENT_FORMATTING_RULE_URL@@"
    if rp_github_content_formatting_rule_is_valid "$(printf -- "---\nalwaysApply: true\n---\n%s\n%s\n" "$usage" "$unsubstituted_crumb")" "the-hcma/consumer-x"; then
      printf "unsubstituted_placeholder_accepted\n"; exit 1
    fi
    alt_branch_crumb="github-content-formatting-canonical: https://github.com/the-hcma/repository-helpers/blob/some-topic-branch/.agents/rules/github-content-formatting.md"
    if ! rp_github_content_formatting_rule_is_valid "$(printf -- "---\nalwaysApply: true\n---\n%s\n%s\n" "$usage" "$alt_branch_crumb")" "the-hcma/consumer-x"; then
      printf "alternate_branch_rejected\n"; exit 1
    fi
    unrelated_marker="github-content-formatting-canonical: https://example.com/not-canonical"
    stray_bare_url="https://github.com/the-hcma/repository-helpers/blob/main/.agents/rules/github-content-formatting.md"
    if rp_github_content_formatting_rule_is_valid "$(printf -- "---\nalwaysApply: true\n---\n%s\n%s\nSee also %s\n" "$usage" "$unrelated_marker" "$stray_bare_url")" "the-hcma/consumer-x"; then
      printf "unrelated_marker_with_stray_canonical_url_accepted\n"; exit 1
    fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/.agents/rules/github-content-formatting.md"
)" || gcf_out="fail:${gcf_out}"
if [[ "$gcf_out" == 'ok' ]]; then
  printf '[PASS] github-content-formatting: validator accepts template + dogfood + consumer breadcrumb (any branch); rejects full-copy / not-alwaysApply / bare mention / missing linter / consumer missing breadcrumb / unsubstituted placeholder / unrelated marker with a stray canonical URL elsewhere\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] github-content-formatting: validator wrong (%s)\n' "$gcf_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: github-content-formatting rule — routine SUGGESTs, strict/new-repo FAILs ===\n'
gcf_suggest="$(
