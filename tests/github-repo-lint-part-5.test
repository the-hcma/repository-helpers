fi

printf '\n=== unit: github-content-formatting apply-fix queues rendered pair ===\n'
gcf_apply="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    rp_apply_fix=1
    rp_suggest=0
    rp_strict_onboarding=0
    rp_new_repo=0
    rp_repo_short_name() { printf "some-consumer\n"; }
    rp_log_check_fail() { :; }
    rp_log_check_ok() { :; }
    rp_log_suggest() { :; }
    rp_log_warn() { :; }
    rp_fetch_github_text_file() { return 1; }
    rp_queue_org_agents_rule_pair() {
      printf "QUEUE_PATH=%s\nQUEUE_CONTENT_BEGIN\n%s\nQUEUE_CONTENT_END\n" "$2" "$4"
      printf "QUEUE_PATH=%s\nQUEUE_CONTENT_BEGIN\n%s\nQUEUE_CONTENT_END\n" "$3" "$5"
    }
    rc=0
    rp_check_github_content_formatting "the-hcma/some-consumer" || rc=$?
    printf "rc=%s\n" "$rc"
  ' bash "$lib"
)"
if grep -qF 'rc=0' <<<"$gcf_apply" \
  && grep -qF 'QUEUE_PATH=.agents/rules/github-content-formatting.md' <<<"$gcf_apply" \
  && grep -qF 'QUEUE_PATH=.cursor/rules/github-content-formatting.mdc' <<<"$gcf_apply" \
  && grep -qF 'https://github.com/the-hcma/repository-helpers/blob/main/.agents/rules/github-content-formatting.md' <<<"$gcf_apply" \
  && ! grep -qF '@@GH_CONTENT_FORMATTING_RULE_URL@@' <<<"$gcf_apply" \
  && grep -qF 'agents-rule-shim: github-content-formatting' <<<"$gcf_apply"; then
  printf '[PASS] github-content-formatting: apply-fix queues rendered agents rule and Cursor shim\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] github-content-formatting: apply-fix output mismatch\n%s\n' "$gcf_apply"
  fail=$(( fail + 1 ))
fi

