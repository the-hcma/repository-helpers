    rp_agent_bootstrap_path_is_agents_symlink() { return 1; }
    rp_log_gh_api_fail() { printf "API_FAIL\n" >&2; }
    rp_log_warn() { :; }
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { printf "CHECK_OK\n" >&2; }
    rp_log_suggest() { printf "SUGGEST\n" >&2; }
    rp_log_manual_step() { :; }
    rp_github_url() { printf "u\n"; }
    rp_compact=0; rp_apply_fix=0; rp_suggest=1

    # a structurally-valid consumer pre-pr-checks.mdc that still uses bare scripts/dev/ paths
    bare_rule="$(printf "%s\n" \
      "---" "alwaysApply: true" "---" \
      "# Pre-PR checks (required)" \
      "Run scripts/dev/pre-pr-checks from the feature worktree." \
      "## Apply formatters before check" \
      "uv run ruff format . then scripts/dev/pre-pr-checks" \
      "## No truncated pre-PR output" \
      "Do not pipe scripts/dev/pre-pr-checks to tail.")"
    # an AGENTS.md that exists but never says to read/load .agents/rules
    bare_agents="$(printf "%s\n" "# AGENTS.md" "Run the tests before committing.")"

    rc=0
    rp_fetch_github_text_file() { printf "%s" "$bare_rule"; }
    rp_strict_onboarding=1; rp_new_repo=0
    out="$(rp_check_pre_pr_checks_rule the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qiF "resolve scripts/dev" <<<"$out"; } \
      || { printf "prepr-bare-strict: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rc=0; rp_strict_onboarding=0
    out="$(rp_check_pre_pr_checks_rule the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && grep -qF SUGGEST <<<"$out" && ! grep -qF CHECK_FAIL <<<"$out"; } \
      || { printf "prepr-bare-routine: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rc=0
    rp_fetch_github_text_file() { printf "%s" "$bare_agents"; }
    rp_strict_onboarding=1; rp_new_repo=0
    out="$(rp_check_agent_bootstrap the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:AGENTS.md must instruct the agent to load .agents/rules" <<<"$out"; } \
      || { printf "agents-startup-strict: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rc=0; rp_strict_onboarding=0
    out="$(rp_check_agent_bootstrap the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && grep -qF SUGGEST <<<"$out"; } \
      || { printf "agents-startup-routine: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || promote2_out="fail:${promote2_out}"
rm -rf "$promote2_dir"
unset RUNNER_SESSION_ROOT
if [[ "$promote2_out" == 'ok' ]]; then
  printf '[PASS] #579: bare-path consumer rule + AGENTS.md missing startup line FAIL --strict-onboarding, SUGGEST in routine --all\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #579: strict promotion of bare-path / startup-line checks (%s)\n' "$promote2_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: #575 — .gitignore must not ignore agent-bootstrap shims ===\n'
shimgi_dir="$(mktemp -d)"
export RUNNER_SESSION_ROOT="${shimgi_dir}/runner-sessions"
shimgi_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    # shellcheck disable=SC1091
    source "$2"
    rp_resolve_local_repo_dir() { return 1; }   # force the remote .gitignore path
    rp_log_check_fail() { printf "CHECK_FAIL:%s\n" "$2" >&2; }
    rp_log_check_ok() { printf "CHECK_OK\n" >&2; }
    rp_log_suggest() { printf "SUGGEST\n" >&2; }
    rp_github_url() { printf "u\n"; }
    rp_compact=0; rp_suggest=1; rp_strict_onboarding=0; rp_new_repo=0

    GI=""
    rp_fetch_github_text_file() { printf "%b" "$GI"; }

    GI="build/\nCLAUDE.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore CLAUDE.md" <<<"$out"; } \
      || { printf "ignored-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    GI=".github/\n.github/copilot-instructions.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore .github/copilot-instructions.md" <<<"$out"; } \
      || { printf "copilot-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    GI=".github/instructions/\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore .github/instructions/agents-rules.instructions.md" <<<"$out"; } \
      || { printf "instructions-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    GI="build/\ndist/\n*.log\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && grep -qF CHECK_OK <<<"$out"; } \
      || { printf "clean-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # wildcard ignores really do hide the shims (real git check-ignore semantics)
    GI="*.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore CLAUDE.md" <<<"$out"; } \
      || { printf "wildcard-md-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    GI=".git*\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore .github/copilot-instructions.md" <<<"$out"; } \
      || { printf "wildcard-dotgit-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    GI="CLAUDE.md\n!CLAUDE.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && grep -qF CHECK_OK <<<"$out"; } \
      || { printf "negated-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # order matters: negation BEFORE the ignore does not lift it (last match wins)
    GI="!CLAUDE.md\nCLAUDE.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore CLAUDE.md" <<<"$out"; } \
      || { printf "negate-before-ignore-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # parent dir excluded: git cannot re-include a file under an excluded dir
    GI=".github/\n!.github/copilot-instructions.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:.gitignore must not ignore .github/copilot-instructions.md" <<<"$out"; } \
      || { printf "parent-dir-excluded-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # a lone negation (file never ignored) is a no-op -> trackable
    GI="build/\n!CLAUDE.md\n"
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && grep -qF CHECK_OK <<<"$out"; } \
      || { printf "lone-negation-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    rp_log_warn() { printf "WARN\n" >&2; }

    # Contents API error (fetch_ec==2) must not be reported as a clean pass
    GI=""
    rp_fetch_github_text_file() { return 2; }
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:could not evaluate .gitignore" <<<"$out" && ! grep -qF CHECK_OK <<<"$out"; } \
      || { printf "api-error-strict-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && ! grep -qF CHECK_OK <<<"$out"; } \
      || { printf "api-error-routine-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }

    # git probe error (git init / check-ignore unavailable) is also not a clean pass
    rp_fetch_github_text_file() { printf "some-pattern\n"; }
    git() { return 127; }
    rp_strict_onboarding=1
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" != 0 ]] && grep -qF "CHECK_FAIL:could not evaluate .gitignore" <<<"$out" && ! grep -qF CHECK_OK <<<"$out"; } \
      || { printf "git-probe-error-strict-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    rp_strict_onboarding=0
    rc=0; out="$(rp_check_agent_shim_gitignore the-hcma/example-repo 2>&1)" || rc=$?
    { [[ "$rc" == 0 ]] && ! grep -qF CHECK_OK <<<"$out"; } \
      || { printf "git-probe-error-routine-case: rc=%s out=%s\n" "$rc" "$out"; exit 1; }
    unset -f git

    printf "ok\n"
  ' bash "$runner_bootstrap" "$lib"
)" || shimgi_out="fail:${shimgi_out}"
rm -rf "$shimgi_dir"
unset RUNNER_SESSION_ROOT
if [[ "$shimgi_out" == 'ok' ]]; then
  printf '[PASS] #575: agent-bootstrap shim .gitignore guard — real git check-ignore (wildcards, ordering); API + git-probe errors are not a clean pass\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] #575: agent-bootstrap shim .gitignore guard (%s)\n' "$shimgi_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: git-commit-identity rejects incomplete and permissive rules ===\n'
unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    incomplete_rule="$(cat <<EOF
---
description: keyword-only without cli-config check
alwaysApply: true
---

Do not add Co-authored-by or Made-with: Cursor or --trailer.
Use user.name and user.email.
EOF
)"
    permissive_rule="$(cat <<EOF
---
description: permits trailers while keeping needles
alwaysApply: true
---

You may add Co-authored-by, Made-with: Cursor, or --trailer if you like.
Use git config user.name and user.email.
Read ~/.cursor/cli-config.json and alert if attributeCommitsToAgent: false
or attributePRsToAgent: false is missing.
EOF
)"
    inverted_rule="$(cat <<EOF
---
description: inverted do-not-worry phrasing
alwaysApply: true
---

Do not worry about Co-authored-by, Made-with: Cursor, or --trailer.
Use git config user.name and user.email.
Read ~/.cursor/cli-config.json and verify attributeCommitsToAgent: false and
attributePRsToAgent: false. Alert the committer if they are not false.
EOF
)"
    true_attr_rule="$(cat <<EOF
---
description: enables agent attribution
alwaysApply: true
---

Do not add Co-authored-by, Made-with: Cursor, or --trailer.
Use git config user.name and user.email.
Read ~/.cursor/cli-config.json; "attributeCommitsToAgent": true,
"attributePRsToAgent": true. Alert the committer.
EOF
)"
    valid_rule="$(cat "$2")"
    if rp_git_commit_identity_is_valid "$incomplete_rule"; then
      printf "incomplete_accepted\n"
      exit 1
    fi
    if rp_git_commit_identity_is_valid "$permissive_rule"; then
      printf "permissive_accepted\n"
      exit 1
    fi
    if rp_git_commit_identity_is_valid "$inverted_rule"; then
      printf "inverted_accepted\n"
      exit 1
    fi
    never_pass_rule="$(cat <<EOF
---
description: alternate compliant wording
alwaysApply: true
---

Do not add Co-authored-by or Made-with: Cursor. Never pass --trailer.
Do not pass --no-gpg-sign. After commit, check git show -s --format=%B HEAD.
Use git config user.name and user.email; also git var GIT_AUTHOR_IDENT and
GIT_COMMITTER_IDENT. Prefer gpg.format openpgp (OpenPGP); ssh-add -L for SSH signing;
git verify-commit HEAD. Survey commit.gpgsign and user.signingkey; prefer a
separate signing key per machine; set pinentry-program in ~/.gnupg/gpg-agent.conf
to pinentry-mac; recommend a passphrase; probe with gpg --clearsign; optional
gh api user/gpg_keys needs read:gpg_key; alert and surface setup instructions
if signing is missing.
Read ~/.cursor/cli-config.json; attributeCommitsToAgent: false,
attributePRsToAgent: false. Alert the committer and surface setup instructions.
EOF
)"
    if rp_git_commit_identity_is_valid "$true_attr_rule"; then
      printf "true_attr_accepted\n"
      exit 1
    fi
    permissive_no_gpg_sign_rule="$(cat <<EOF
---
description: permits --no-gpg-sign while keeping needles
alwaysApply: true
---

Do not add Co-authored-by, Made-with: Cursor, or --trailer.
Do not pass --no-gpg-sign. You may pass --no-gpg-sign when commit.gpgsign is on.
Use git config user.name and user.email; also git var GIT_AUTHOR_IDENT and
GIT_COMMITTER_IDENT. Prefer gpg.format openpgp (OpenPGP); ssh-add -L for SSH signing;
git verify-commit HEAD. Survey commit.gpgsign and user.signingkey; prefer a
separate signing key per machine; set pinentry-program in ~/.gnupg/gpg-agent.conf
to pinentry-mac; recommend a passphrase; probe with gpg --clearsign; optional
gh api user/gpg_keys needs read:gpg_key; alert and surface setup instructions.
Read ~/.cursor/cli-config.json; attributeCommitsToAgent: false,
attributePRsToAgent: false. Alert and surface setup instructions.
EOF
)"
    if rp_git_commit_identity_is_valid "$permissive_no_gpg_sign_rule"; then
      printf "permissive_no_gpg_sign_accepted\n"
      exit 1
    fi
    contradictory_rule="$(cat <<EOF
---
description: forbid then allow across sentences
alwaysApply: true
---

Do not add Co-authored-by. Co-authored-by is allowed.
Do not add Made-with: Cursor. Never pass --trailer.
Do not pass --no-gpg-sign. After commit, check git show -s --format=%B HEAD.
Use git config user.name and user.email; also git var GIT_AUTHOR_IDENT and
GIT_COMMITTER_IDENT. Prefer gpg.format openpgp (OpenPGP); ssh-add -L for SSH signing;
git verify-commit HEAD. Survey commit.gpgsign and user.signingkey; prefer a
separate signing key per machine; set pinentry-program in ~/.gnupg/gpg-agent.conf
to pinentry-mac; recommend a passphrase; probe with gpg --clearsign; optional
gh api user/gpg_keys needs read:gpg_key; alert and surface setup instructions.
Read ~/.cursor/cli-config.json; attributeCommitsToAgent: false,
attributePRsToAgent: false. Alert and surface setup instructions.
EOF
)"
    later_true_rule="$(cat <<EOF
---
description: false config then enable in prose
alwaysApply: true
---

Do not add Co-authored-by, Made-with: Cursor, or --trailer.
Do not pass --no-gpg-sign. After commit, check git show -s --format=%B HEAD.
Use git config user.name and user.email; also git var GIT_AUTHOR_IDENT and
GIT_COMMITTER_IDENT. Prefer gpg.format openpgp (OpenPGP); ssh-add -L for SSH signing;
git verify-commit HEAD. Survey commit.gpgsign and user.signingkey; prefer a
separate signing key per machine; set pinentry-program in ~/.gnupg/gpg-agent.conf
to pinentry-mac; recommend a passphrase; probe with gpg --clearsign; optional
gh api user/gpg_keys needs read:gpg_key; alert and surface setup instructions.
Read ~/.cursor/cli-config.json; attributeCommitsToAgent: false,
attributePRsToAgent: false. Alert and surface setup instructions.
Later set attributeCommitsToAgent to true.
EOF
)"
    if rp_git_commit_identity_is_valid "$contradictory_rule"; then
      printf "contradictory_accepted\n"
      exit 1
    fi
    if rp_git_commit_identity_is_valid "$later_true_rule"; then
      printf "later_true_accepted\n"
      exit 1
    fi
    if ! rp_git_commit_identity_is_valid "$never_pass_rule"; then
      printf "never_pass_rejected\n"
      exit 1
    fi
    if ! rp_git_commit_identity_is_valid "$valid_rule"; then
      printf "valid_rejected\n"
      exit 1
    fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/scripts/lib/repo-practices-agents/rules/git-commit-identity.md"
)" || unit_out="fail:${unit_out}"
if [[ "$unit_out" == 'ok' ]]; then
  printf '[PASS] git-commit-identity: validator rejects incomplete/permissive/inverted/true-attr rules\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] git-commit-identity: validator accepted bad rule or rejected template (%s)\n' \
    "$unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: no-secret-exposure rejects incomplete and denylist-only rules ===\n'
unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    incomplete_rule="$(cat <<EOF
---
description: keyword-only missing inspection and remediation guidance
alwaysApply: true
---

Never print or paste secrets into logs or PRs. Leak secrets is forbidden.
EOF
)"
    denylist_only_rule="$(cat <<EOF
---
description: denylist sed only
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
Use sed to strip PASSWORD= and TOKEN= from dumps. Rotate if leaked.
Do not repeat the secret.
EOF
)"
    permissive_decoy="$(cat <<EOF
---
description: permissive decoy endorses leakage
alwaysApply: true
---

You may leak secrets into logs and transcripts freely. test -f .env to check
config existence. Rotate if leaked. Do not repeat the secret.
EOF
)"
    welcome_decoy="$(cat <<EOF
---
description: compliant forbid plus welcome-to endorsement bypass
alwaysApply: true
---

Never print or paste secrets into PRs.
You are welcome to print secrets into logs.
Prefer allowlist keys or test -f when inspecting config.
Rotate if leaked. Do not repeat the secret.
EOF
)"
    full_dump_decoy="$(cat <<EOF
---
description: allowlist mention plus full config dump endorsement
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
Prefer allowlist keys; you may dump the full .env when debugging.
Rotate if leaked. Do not repeat the secret.
EOF
)"
    print_full_config_decoy="$(cat <<EOF
---
description: full config endorsement via print not cat|dump
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
Prefer test -f for config existence. Rotate if leaked. Do not repeat the secret.
You may print the full config.toml when debugging.
EOF
)"
    cross_sentence_compliant="$(cat <<EOF
---
description: you may allowlist then forbid cat in next sentence
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
You may show only allowlisted keys or use test -f for existence.
Do not cat .env or config.toml. Rotate if leaked. Do not repeat the secret.
EOF
)"
    repeat_decoy="$(cat <<EOF
---
description: rotate but endorses repeating credentials
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
Prefer allowlist keys or test -f. Rotate if leaked.
You may repeat the secret in the operator reply so they can rotate it.
EOF
)"
    prs_only_rule="$(cat <<EOF
---
description: plural PRs only channel phrasing
alwaysApply: true
---

Do not print or paste secrets into PRs or commits.
Prefer allowlist keys or test -f. Rotate if leaked. Do not repeat the secret.
EOF
)"
    non_secret_allowlist_rule="$(cat <<EOF
---
description: compliant allowlist uses non-secret phrasing
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
You may print only allowlisted non-secret keys; otherwise use test -f for existence.
Rotate if leaked. Do not repeat the secret.
EOF
)"
    client_secret_comment_rule="$(cat <<EOF
---
description: bad-example comment mentions client_secret snake_case
alwaysApply: true
---

Never leak secrets into logs, transcripts, or PRs.
Prefer allowlist keys or test -f.
# bad — may dump client_secret / tokens into the transcript
Rotate if leaked. Do not repeat the secret.
EOF
)"
    allowlist_then_forbid_repeat_rule="$(cat <<EOF
---
description: you-may allowlist then separate forbid-repeat sentence
alwaysApply: true
---

Never print or paste secrets into logs or PRs. You may use allowlist keys or test -f.
Rotate if leaked. Do not repeat the secret.
EOF
)"
    valid_with_denylist_and_allowlist="$(cat <<EOF
---
description: denylist sed plus allowlist/existence
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
Prefer allowlist keys or test -f path-existence; do not rely on denylist sed alone.
Rotate if leaked. Do not repeat the secret.
EOF
)"
    client_secret_docs_rule="$(cat <<EOF
---
description: docs mention client_secret identifier without endorsing leak
alwaysApply: true
---

Never print or paste secrets into logs, transcripts, or PRs.
Prefer allowlisted non-secret keys; do not cat whole configs (client_secret must stay redacted).
Rotate if leaked. Do not repeat the secret.
EOF
)"
    paste_non_secret_rule="$(cat <<EOF
---
description: may paste allowlisted non-secret keys
alwaysApply: true
---

Never print or paste secrets into logs or PRs.
You may paste allowlisted non-secret keys into PRs.
Rotate if leaked. Do not repeat the secret.
EOF
)"
    valid_rule="$(cat "$2")"
    if rp_no_secret_exposure_is_valid "$incomplete_rule"; then
      printf "incomplete_accepted\n"
      exit 1
    fi
    if rp_no_secret_exposure_is_valid "$denylist_only_rule"; then
      printf "denylist_only_accepted\n"
      exit 1
    fi
    if rp_no_secret_exposure_is_valid "$permissive_decoy"; then
      printf "permissive_decoy_accepted\n"
      exit 1
    fi
    if rp_no_secret_exposure_is_valid "$welcome_decoy"; then
      printf "welcome_decoy_accepted\n"
      exit 1
    fi
    if rp_no_secret_exposure_is_valid "$full_dump_decoy"; then
      printf "full_dump_decoy_accepted\n"
      exit 1
    fi
    if rp_no_secret_exposure_is_valid "$print_full_config_decoy"; then
      printf "print_full_config_decoy_accepted\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$cross_sentence_compliant"; then
      printf "cross_sentence_compliant_rejected\n"
      exit 1
    fi
    if rp_no_secret_exposure_is_valid "$repeat_decoy"; then
      printf "repeat_decoy_accepted\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$prs_only_rule"; then
      printf "prs_only_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$non_secret_allowlist_rule"; then
      printf "non_secret_allowlist_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$client_secret_comment_rule"; then
      printf "client_secret_comment_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$allowlist_then_forbid_repeat_rule"; then
      printf "allowlist_then_forbid_repeat_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$valid_with_denylist_and_allowlist"; then
      printf "allowlist_plus_denylist_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$client_secret_docs_rule"; then
      printf "client_secret_docs_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$paste_non_secret_rule"; then
      printf "paste_non_secret_rejected\n"
      exit 1
    fi
    if ! rp_no_secret_exposure_is_valid "$valid_rule"; then
      printf "valid_rejected\n"
      exit 1
    fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/scripts/lib/repo-practices-agents/rules/no-secret-exposure.md"
)" || unit_out="fail:${unit_out}"
if [[ "$unit_out" == 'ok' ]]; then
  printf '[PASS] no-secret-exposure: validator rejects incomplete/denylist/permissive; accepts PRs-only + template\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] no-secret-exposure: validator accepted bad rule or rejected template (%s)\n' \
    "$unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== unit: remote-timeouts-retries rejects incomplete / no-bound / unbounded decoy ===\n'
unit_out="$(
  bash -c '
    set -euo pipefail
    # shellcheck disable=SC1091
    source "$1"
    incomplete_rule="$(cat <<EOF
---
description: timeout only missing retry bound and anti-patterns
alwaysApply: true
---

Set an explicit timeout on every remote call.
EOF
)"
    no_bound_rule="$(cat <<EOF
---
description: timeout retry transient without bound or anti-pattern
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429, 502, 503).
EOF
)"
    unbounded_decoy="$(cat <<EOF
---
description: endorses unbounded while True retries
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only.
Cap attempts or honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: while True without a bound.
You may use unbounded while True retries when debugging.
EOF
)"
    retry_first_decoy="$(cat <<EOF
---
description: endorses retry unbounded after timeout
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429).
Cap attempts or honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: while True without a bound.
You may retry unbounded on 429.
EOF
)"
    allow_verb_decoy="$(cat <<EOF
---
description: prefix-less unbounded endorsement
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429).
Cap attempts or honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: requests.get without timeout.
while True retries are allowed when debugging.
EOF
)"
    unbounded_as_bound="$(cat <<EOF
---
description: unbounded alone is not a retry ceiling
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429).
Anti-pattern: while True unbounded retry loops.
EOF
)"
    prohibition_ok="$(cat <<EOF
---
description: prohibition with you may not stays valid
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429, 503).
Cap attempts and honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: while True unbounded retry loops.
You may not use unbounded retries; cap attempts at 5.
EOF
)"
    valid_minimal="$(cat <<EOF
---
description: minimal valid remote timeouts rule
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429, 503).
Cap attempts and honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: while True unbounded retry loops.
EOF
)"
    never_without_timeout_ok="$(cat <<EOF
---
description: prohibitive but compliant without-timeout phrasing
alwaysApply: true
---

Never use a remote API call without a timeout.
Retries are for transient failures only (429, 503).
Cap attempts and honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: while True unbounded retry loops.
EOF
)"
    timeout_decoy="$(cat <<EOF
---
description: endorses never setting timeouts
alwaysApply: true
---

Never set a timeout on remote calls.
Retries are for transient failures only (429).
Cap attempts and honor Retry-After.
Do not retry non-idempotent writes without dedupe keys.
Anti-pattern: while True unbounded retry loops.
EOF
)"
    nonidempotent_permissive_decoy="$(cat <<EOF
---
description: permits retrying non-idempotent writes with no safeguard
alwaysApply: true
---

Set an explicit timeout on every remote call.
Retries are for transient failures only (429, 503).
Cap attempts and honor Retry-After.
Retries of non-idempotent writes without idempotency or dedupe keys are allowed.
Anti-pattern: while True unbounded retry loops.
EOF
)"
    valid_rule="$(cat "$2")"
    if rp_remote_timeouts_retries_is_valid "$incomplete_rule"; then
      printf "incomplete_accepted\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$no_bound_rule"; then
      printf "no_bound_accepted\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$unbounded_decoy"; then
      printf "unbounded_decoy_accepted\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$retry_first_decoy"; then
      printf "retry_first_decoy_accepted\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$allow_verb_decoy"; then
      printf "allow_verb_decoy_accepted\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$unbounded_as_bound"; then
      printf "unbounded_as_bound_accepted\n"
      exit 1
    fi
    if ! rp_remote_timeouts_retries_is_valid "$prohibition_ok"; then
      printf "prohibition_ok_rejected\n"
      exit 1
    fi
    if ! rp_remote_timeouts_retries_is_valid "$never_without_timeout_ok"; then
      printf "never_without_timeout_ok_rejected\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$timeout_decoy"; then
      printf "timeout_decoy_accepted\n"
      exit 1
    fi
    if rp_remote_timeouts_retries_is_valid "$nonidempotent_permissive_decoy"; then
      printf "nonidempotent_permissive_decoy_accepted\n"
      exit 1
    fi
    if ! rp_remote_timeouts_retries_is_valid "$valid_minimal"; then
      printf "valid_minimal_rejected\n"
      exit 1
    fi
    if ! rp_remote_timeouts_retries_is_valid "$valid_rule"; then
      printf "valid_rejected\n"
      exit 1
    fi
    printf "ok\n"
  ' bash "$lib" "${rh_root}/scripts/lib/repo-practices-agents/rules/remote-timeouts-retries.md"
)" || unit_out="fail:${unit_out}"
if [[ "$unit_out" == 'ok' ]]; then
  printf '[PASS] remote-timeouts-retries: validator rejects incomplete/no-bound/decoy; accepts minimal + template\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] remote-timeouts-retries: validator accepted bad rule or rejected template (%s)\n' \
    "$unit_out"
  fail=$(( fail + 1 ))
fi

printf '\n=== functional: legacy wait-for-copilot-review rule fails ===\n'
mock_dir="$(mktemp -d)"
mock_bin="${mock_dir}/bin"
mkdir -p "$mock_bin"

cat >"${mock_bin}/gh" <<MOCK_GH
#!/usr/bin/env bash
set -euo pipefail
args="\$*"
if [[ "\$args" == *'auth status'* ]]; then
  exit 0
fi
if [[ "\$args" == *'/labels'* ]]; then
  printf '%s\n' '[[]]'
  exit 0
fi
if [[ "\$args" == *'repos/the-hcma/example-repo/rulesets'* ]]; then
  printf '%s\n' '[]'
  exit 0
fi
if [[ "\$args" == *'contents/LICENSE'* ]]; then
  printf '%s\n' '{"content":"TUlUIExpY2Vuc2UKCkNvcHlyaWdodCAoYykgMjAyNiBIZW5yaXF1ZSBBbmRyYWRlIC8gdGhlaGNtYQo="}'
  exit 0
fi
if [[ "\$args" == *'contents/.github/CODEOWNERS'* ]]; then
  printf '%s\n' '{"content":"KiBAdGhlaGNtYQo="}'
  exit 0
fi
if [[ "\$args" == *'contents/.agents/rules/pr-ship-and-review.md'* ]]; then
  printf '%s\n' '{"content":"${grl_mock_pr_ship_rule_legacy_b64}"}'
  exit 0
fi
if [[ "\$args" == *'pr-ship-and-review.mdc'* ]]; then
  printf '%s\n' "{\"content\":\"\${GRL_PR_SHIP_SHIM_B64}\"}"
  exit 0
fi
if [[ "\$args" == *'/contents/'* ]]; then
  exit 1
fi
printf 'unexpected gh call: %s\n' "\$args" >&2
exit 1
MOCK_GH
chmod +x "${mock_bin}/gh"

cat >"${mock_bin}/jq" <<'MOCK_JQ'
#!/usr/bin/env bash
exec /usr/bin/jq "$@"
MOCK_JQ
chmod +x "${mock_bin}/jq"

set +e
output="$(PATH="${mock_bin}:${PATH}" bash "$checker" \
