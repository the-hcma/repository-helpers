#!/usr/bin/env bash
# Tests for scripts/lib/timer-singleton-lock.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/timer-singleton-lock"
readonly lib

printf '\n=== static: timer-singleton-lock lib ===\n'
lib_text="$(<"$lib")"
assert_contains 'defines timer_singleton_acquire_lock' "$lib_text" 'timer_singleton_acquire_lock()'
assert_contains 'auto-assigns lock fd' "$lib_text" 'exec {lock_fd}>'
# shellcheck disable=SC2016  # grep needle is literal source text, not an expanded variable
assert_contains 'uses flock --nonblock on assigned fd' "$lib_text" 'flock --nonblock "${lock_fd}"'
assert_contains 'logs skip and exits 0' "$lib_text" 'already in progress'

printf '\n=== functional: overlapping acquire exits 0 ===\n'
tmp=""
tmp="$(mktemp -d)"
lock_file="${tmp}/service.lock"
log_file="${tmp}/service.log"
# shellcheck disable=SC1090  # lib path is built from script_dir at runtime
source "$lib"

set +e
(
  timer_singleton_acquire_lock "$lock_file" "$log_file" 'test-service'
  sleep 2
) &
holder_pid=$!
sleep 0.2
overlap_exit=0
(
  timer_singleton_acquire_lock "$lock_file" "$log_file" 'test-service'
) || overlap_exit=$?
wait "$holder_pid" 2>/dev/null || true
set -e

if [[ "$overlap_exit" -eq 0 ]] && grep -qF 'Skipped: another test-service run is already in progress' "$log_file"; then
  pass_case 'overlap: second acquire exits 0 and logs skip'
else
  fail_case 'overlap: expected exit 0 with skip log line'
fi

rm -rf "$tmp"

test_summary
