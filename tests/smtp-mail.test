#!/usr/bin/env bash
# Tests for scripts/lib/smtp-mail.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

lib="${script_dir}/../scripts/lib/smtp-mail"
readonly lib

pass=0
fail=0

printf '\n=== static: repo_helpers_smtp_configured ===\n'
# shellcheck disable=SC1090,SC1091
source "$lib"
if declare -F repo_helpers_smtp_configured >/dev/null \
  && declare -F repo_helpers_smtp_send >/dev/null; then
  printf '[PASS] smtp-mail: exports configured + send helpers\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] smtp-mail: missing helper functions\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== configured: requires host only ===\n'
unset DEP_UPDATER_SMTP_HOST DEP_UPDATER_REPORT_TO DEP_UPDATER_REPORT_FROM
if ! repo_helpers_smtp_configured; then
  printf '[PASS] configured: false when host unset\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] configured: expected false when host unset\n'
  fail=$(( fail + 1 ))
fi

export DEP_UPDATER_SMTP_HOST=smtp.test
unset DEP_UPDATER_REPORT_TO DEP_UPDATER_REPORT_FROM
if repo_helpers_smtp_configured; then
  printf '[PASS] configured: true when only host is set\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] configured: expected true when host is set\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: localhost uses sendmail ===\n'
unset DEP_UPDATER_USE_SENDMAIL
export DEP_UPDATER_SMTP_HOST=localhost
if repo_helpers_smtp_use_sendmail \
  && grep -qF 'repo_helpers_sendmail' "$lib"; then
  printf '[PASS] localhost: repo_helpers_smtp_use_sendmail selects sendmail\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] localhost: expected sendmail delivery path\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== test mode: writes message to breadcrumb ===\n'
tmp=""
tmp="$(mktemp -d)"
breadcrumb="${tmp}/smtp.out"
export REPO_HELPERS_TEST_MODE=1
export REPO_HELPERS_SMTP_BREADCRUMB="$breadcrumb"
if printf 'Subject: hi\n\nbody\n' | repo_helpers_smtp_send 'from@test' 'to@test'; then
  if [[ -f "$breadcrumb" ]] && grep -qF 'Subject: hi' "$breadcrumb"; then
    printf '[PASS] test-mode: breadcrumb contains stdin message\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] test-mode: breadcrumb missing or empty\n'
    fail=$(( fail + 1 ))
  fi
else
  printf '[FAIL] test-mode: repo_helpers_smtp_send failed\n'
  fail=$(( fail + 1 ))
fi
rm -rf "$tmp"

printf '\n=== static: curl SMTP submission ===\n'
if grep -qF 'curl' "$lib" && grep -qF 'mail-from' "$lib"; then
  printf '[PASS] smtp-mail: uses curl --mail-from/--mail-rcpt\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] smtp-mail: expected curl SMTP invocation\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== results ===\n'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
test_summary
