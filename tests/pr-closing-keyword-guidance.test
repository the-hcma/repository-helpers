#!/usr/bin/env bash
# Static checks: the PR rules say when a PR should close its issue (repository-helpers#767).
# shellcheck disable=SC2016  # the needles are literal Markdown with backticks, not expansions
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

root="${script_dir}/.."
readonly root

printf '\n=== static: closing-issue guidance ===\n'
for rule in \
  ".agents/rules/pr-workflow.md" \
  ".agents/rules/pr-ship-and-review.md" \
  "scripts/lib/repo-practices-agents/rules/pr-ship-and-review.md"; do
  body="$(cat "${root}/${rule}")"
  assert_contains "${rule} has the closing-issue section" "$body" "### Closing the issue"
  assert_contains "${rule} says a completing PR uses Closes" "$body" 'puts `Closes #N.` in its description'
  assert_contains "${rule} says a partial PR uses Part of" "$body" 'says `Part of #N.` and does not close it'
  assert_contains "${rule} lets the repository AGENTS.md override" "$body" "(that wins)"
  assert_contains "${rule} names the blanket no-closing-keywords failure" "$body" '"no closing keywords" convention'
  assert_contains "${rule} qualifies an issue in another repository" "$body" 'qualify it: `Closes OWNER/REPOSITORY#N.`'
  assert_contains "${rule} qualifies Part of for another repository" "$body" 'write `Part of OWNER/REPOSITORY#N.`'
  assert_contains "${rule} requires the closing PR to target the default branch" "$body" 'must target the default branch when it merges'
  assert_contains "${rule} requires the user to agree the issue is done before merge" "$body" 'merged only after the user agrees the issue is done'
done

test_summary
