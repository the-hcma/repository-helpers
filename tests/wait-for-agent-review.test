#!/usr/bin/env bash
# Smoke and static tests for scripts/wait-for-agent-review and trigger-agent-review.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # shared test helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/test-assert"
test_init

wait_script="${script_dir}/../scripts/wait-for-agent-review"
trigger_script="${script_dir}/../scripts/trigger-agent-review"
lib="${script_dir}/../scripts/lib/agent-review"
profile="${script_dir}/../scripts/lib/agent-review-profiles/copilot"
bugbot_profile="${script_dir}/../scripts/lib/agent-review-profiles/bugbot"
quota_lib="${script_dir}/../scripts/lib/agent-review-quota"
rule="${script_dir}/../.cursor/rules/pr-ship-and-review.mdc"
agents_md="${script_dir}/../AGENTS.md"

readonly wait_script trigger_script lib profile bugbot_profile quota_lib rule agents_md

printf '\n=== --help ===\n'
help_out=""
help_exit=0
help_out="$(bash "$wait_script" --help 2>&1)" || help_exit=$?
assert_exit_0 "wait-for-agent-review --help" "$help_out" "$help_exit"
assert_contains "wait help lists complete" "$help_out" "complete"
assert_contains "wait help lists list-feedback" "$help_out" "list-feedback"

trigger_out=""
trigger_exit=0
trigger_out="$(bash "$trigger_script" --help 2>&1)" || trigger_exit=$?
assert_exit_0 "trigger-agent-review --help" "$trigger_out" "$trigger_exit"
assert_contains "trigger help lists request" "$trigger_out" "request"

printf '\n=== static: agent profile copilot ===\n'
if grep -qF 'agent_review_profile_review_is_empty' "$profile" \
  && grep -qF 'agent_review_profile_request' "$profile" \
  && grep -qF '@copilot' "$profile" \
  && grep -qF 'runner_exec "copilot profile request comment"' "$profile" \
  && grep -qF 'gh pr comment' "$profile"; then
  printf '[PASS] copilot profile: @copilot PR comment request via runner\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: missing @copilot comment request wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: wait-for-agent-review commands ===\n'
if grep -qF 'cmd_complete' "$wait_script" \
  && grep -qF 'gh pr review' "$wait_script" \
  && grep -qF 'agent_review_email_complete' "$wait_script" \
  && grep -qF 'complete_ready' "$lib"; then
  printf '[PASS] wait script: complete approves and emails on complete_ready\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] wait script: missing complete/approve/email wiring\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'agent_review_empty' "$lib" \
  && grep -qF 'agent_review_profile_review_is_empty' "$profile"; then
  printf '[PASS] status: exposes agent_review_empty from profile\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] status: missing agent_review_empty wiring\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'AGENT_REVIEW_REPORT_TO' "$wait_script" \
  && grep -qF 'AGENT_REVIEW_REPORT_TO' "${script_dir}/../etc/agent-review.env.example"; then
  printf '[PASS] config: uses AGENT_REVIEW_REPORT_TO\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] config: missing AGENT_REVIEW_REPORT_TO\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: docs and cursor rule ===\n'
if [[ -f "$rule" ]] \
  && grep -qF 'wait-for-agent-review complete' "$rule" \
  && grep -qF 'generated no new comments' "$rule" \
  && grep -qF 'Reply before resolve' "$rule" \
  && grep -qF 'reply-thread' "$rule"; then
  printf '[PASS] cursor rule: documents complete on empty agent review\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] cursor rule: missing pr-ship-and-review complete guidance\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'pr-ship-and-review.mdc' "$agents_md" \
  && grep -qF 'wait-for-agent-review complete' "$agents_md" \
  && grep -qF 'reply-thread' "$agents_md"; then
  printf '[PASS] AGENTS.md: references agent review rule and complete\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] AGENTS.md: missing agent review section\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: reply-thread and resolve guard ===\n'
if grep -qF 'cmd_reply_thread' "$wait_script" \
  && grep -qF 'agent_review_reply_thread_id' "$lib" \
  && grep -qF 'addPullRequestReviewThreadReply' "$lib" \
  && grep -qF 'agent_review_assert_thread_has_human_reply' "$lib" \
  && grep -qF 'agent_review_authenticated_login' "$lib" \
  && grep -qF 'author.login ==' "$lib" \
  && grep -qF 'reply-thread requires --thread-id' "$wait_script"; then
  printf '[PASS] wait script: reply-thread GraphQL and resolve guard wired\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] wait script: missing reply-thread or resolve guard wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: wait timeouts ===\n'
if grep -qF 'ERROR: WAIT_TIMEOUT wait-for-agent-review' "$wait_script" \
  && grep -A1 'ERROR: WAIT_TIMEOUT restack' "$wait_script" | grep -qF 'return 4' \
  && grep -qF 'select(.isResolved == false)' "$lib"; then
  printf '[PASS] wait script: machine-parseable timeouts and unresolved thread filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] wait script: missing WAIT_TIMEOUT lines or unresolved thread filter\n'
  fail=$(( fail + 1 ))
fi

if ! grep -qF 'set -euo pipefail' "$lib" \
  && ! grep -qF 'set -euo pipefail' "${script_dir}/../scripts/lib/agent-review-email" \
  && ! grep -qF 'set -euo pipefail' "$profile"; then
  printf '[PASS] sourced libs: do not mutate caller shell options\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] sourced libs: still set -euo pipefail (mutates caller)\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: loop caps and give-up ===\n'
if grep -qF 'cmd_loop' "$wait_script" \
  && grep -qF 'cmd_give_up' "$wait_script" \
  && grep -qF 'agent_review_post_give_up_comment' "${script_dir}/../scripts/lib/agent-review-email" \
  && grep -qF 'WAIT_TIMEOUT agent-review-give-up' "$wait_script" \
  && grep -qF 'AGENT_REVIEW_CYCLE_TIMEOUT' "$wait_script" \
  && grep -qF 'AGENT_REVIEW_PR_TIMEOUT' "$wait_script" \
  && grep -qF 'AGENT_REVIEW_QUOTA_EXHAUSTED' "$wait_script" \
  && grep -qF 'agent_review_default_pr_timeout_s=43200' "$lib"; then
  printf '[PASS] loop: cycle/PR caps, give-up email+comment\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] loop: missing cycle/PR caps or give-up wiring\n'
  fail=$(( fail + 1 ))
fi

if awk '/^main\(\)/{m=NR} /agent_review_load_env/ && (!m || NR<=m){bad=1} END{exit bad}' "$wait_script"; then
  printf '[PASS] wait script: loads env inside main after help handling\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] wait script: loads env at file scope before help\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: bugbot review fixes ===\n'
# shellcheck disable=SC2016  # grep for literal ${head}/${pr} strings in wait script under test
if grep -qF 'agent_review_head_check_state_json "${repo}" "${head}"' "$wait_script" \
  && ! grep -qF 'agent_review_head_check_state_json "${repo}" "${pr}"' "$wait_script"; then
  printf '[PASS] wait: head-check state uses head OID not PR number\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] wait: head-check state must pass headRefOid to agent_review_head_check_state_json\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'cmd_handle_quota_exhaustion' "$wait_script" \
  && grep -qF '5)' "$wait_script" \
  && grep -qF 'idle_started=0' "$wait_script"; then
  printf '[PASS] loop: check exit 5 resets idle timer; quota via handle_quota_exhaustion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] loop: check exit 5 must reset idle timer and route quota exhaustion\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: bugbot round-2 fixes ===\n'
if grep -qF 'agent_review_quota_quote_env_value' "$quota_lib" \
  && grep -qF 'reason_quoted=' "$quota_lib"; then
  printf '[PASS] quota cache: reason values shell-quoted for source\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota cache: missing shell-quoted reason writes\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'agent_review_quota_timestamp_on_local_day' "$quota_lib" \
  && ! grep -qF 'startswith' "$quota_lib"; then
  printf '[PASS] quota probe: UTC timestamps filtered by local calendar day\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota probe: still uses UTC date prefix instead of local day\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'agent_review_head_check_complete_on_head' "$lib" \
  && awk '/agent_review_fresh_agent_on_head\(\)/,/^}/ {
       if ($0 ~ /agent_review_head_check_complete_on_head/) { found=1 }
     } END { exit(found ? 0 : 1) }' "$lib"; then
  printf '[PASS] head-check freshness uses commit head OID not PR rollup\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] head-check freshness must use headRefOid check-runs\n'
  fail=$(( fail + 1 ))
fi

tmp_quota="$(mktemp)"
# shellcheck disable=SC2016  # bash -c asserts literal ${reason} after sourcing quoted cache file
if bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_quota}'
  agent_review_copilot_quota_write_cache 1 probe 'Copilot review quota exhausted on test.'
  source '${tmp_quota}'
  [[ \"\${reason}\" == 'Copilot review quota exhausted on test.' ]]
"; then
  printf '[PASS] quota cache: multi-word reason survives source\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota cache: multi-word reason breaks on source\n'
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_quota}"

printf '\n=== static: copilot quota detection ===\n'
if grep -qF 'agent_review_profile_text_is_quota_exhausted' "$profile" \
  && grep -qF 'agent_review_profile_review_is_quota_exhausted' "$profile" \
  && grep -qF 'agent_quota_exhausted' "$lib"; then
  printf '[PASS] copilot profile and status expose quota exhaustion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: missing quota exhaustion detection\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${profile}'; agent_review_profile_text_is_quota_exhausted 'You have no quota (quota_exceeded)'"; then
  printf '[PASS] copilot profile: detects quota_exceeded text\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: rejected quota_exceeded text\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${profile}'; agent_review_profile_text_is_quota_exhausted 'Copilot was unable to review this pull request because the user who requested the review has reached their quota limit.'"; then
  printf '[PASS] copilot profile: detects reached quota limit review body\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: rejected reached quota limit review body\n'
  fail=$(( fail + 1 ))
fi

copilot_credits_msg='Copilot stopped work on behalf of thehcma due to an error. Your session could not start because you have run out of your included AI credits for the month. Manage your AI credit budget at https://github.com/settings/copilot/features.'
copilot_credits_msg_q="$(printf '%q' "${copilot_credits_msg}")"
if bash -c "source '${profile}'; agent_review_profile_text_is_quota_exhausted ${copilot_credits_msg_q}"; then
  printf '[PASS] copilot profile: detects included AI credits exhaustion text\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: rejected included AI credits exhaustion text\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${profile}'; agent_review_profile_issue_comment_is_quota_exhausted 'github-actions' ${copilot_credits_msg_q}"; then
  printf '[PASS] copilot profile: billing comment without copilot login\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: rejected billing comment without copilot login\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: copilot profile empty review function ===\n'
if bash -c "source '${profile}'; agent_review_profile_review_is_empty 'Copilot reviewed 2 files and generated no new comments.'"; then
  printf '[PASS] copilot profile: detects empty review body\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: empty review regex rejected valid body\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${profile}'; agent_review_profile_review_is_empty 'generated 3 comments.'"; then
  printf '[FAIL] copilot profile: accepted non-empty review body\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] copilot profile: rejects non-empty review body\n'
  pass=$(( pass + 1 ))
fi

printf '\n=== static: bugbot profile ===\n'
if grep -qF 'agent_review_profile_review_is_empty' "$bugbot_profile" \
  && grep -qF 'agent_review_profile_request' "$bugbot_profile" \
  && grep -qF 'bugbot run' "$bugbot_profile" \
  && grep -qF 'found[[:space:]]+no[[:space:]]+bugs' "$bugbot_profile"; then
  printf '[PASS] bugbot profile: request comment and empty review detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] bugbot profile: missing request or empty review wiring\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${bugbot_profile}'; agent_review_profile_review_is_empty '### ✅ BugBot reviewed your changes and found no bugs!'"; then
  printf '[PASS] bugbot profile: detects found no bugs review body\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] bugbot profile: rejected found no bugs review body\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${bugbot_profile}'; agent_review_profile_review_is_empty 'found 2 potential issues'"; then
  printf '[FAIL] bugbot profile: accepted non-empty review body\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] bugbot profile: rejects non-empty review body\n'
  pass=$(( pass + 1 ))
fi

printf '\n=== static: copilot quota fallback ===\n'
if grep -qF 'cmd_try_quota_fallback' "$wait_script" \
  && grep -qF 'cmd_handle_quota_exhaustion' "$wait_script" \
  && grep -qF 'AGENT_REVIEW_QUOTA_FALLBACK_CHAIN' "$wait_script" \
  && grep -qF 'agent_review_use_agent' "$lib" \
  && grep -qF 'agent_review_post_fallback_comment' "${script_dir}/../scripts/lib/agent-review-email"; then
  printf '[PASS] loop: quota exhaustion walks fallback chain\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] loop: missing quota fallback chain wiring\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'cmd_handle_quota_exhaustion' "$wait_script" \
  && grep -qF 'continuing review monitoring' "$wait_script" \
  && grep -qF 'agent_review_bugbot_quota_clear_observed_cache' "$lib" \
  && grep -qF 'cmd_loop_maybe_request_agents_on_head' "$wait_script" \
  && grep -qF 'coderabbit' "${script_dir}/../scripts/lib/agent-review-profiles/coderabbit"; then
  printf '[PASS] loop: proactive agent selection; coderabbit profile installed\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] loop: missing proactive agent selection or coderabbit profile\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'agent_review_profile_auto_review=true' "${script_dir}/../scripts/lib/agent-review-profiles/coderabbit" \
  && grep -qF 'agent_review_profile_auto_review' "$wait_script" \
  && grep -qF 'reviews run automatically — skipping manual request' "$wait_script" \
  && ! grep -qF 'gh pr comment' "${script_dir}/../scripts/lib/agent-review-profiles/coderabbit"; then
  printf '[PASS] coderabbit profile: auto-review only (no manual @coderabbitai request)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] coderabbit profile: still posts manual review trigger\n'
  fail=$(( fail + 1 ))
fi

coderabbit_profile="${script_dir}/../scripts/lib/agent-review-profiles/coderabbit"
if bash -c "source '${coderabbit_profile}'; agent_review_profile_review_has_actionable_feedback \$'Actionable comments posted: 1'"; then
  printf '[PASS] coderabbit profile: detects actionable summary feedback\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] coderabbit profile: rejected actionable summary feedback\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${coderabbit_profile}'; agent_review_profile_review_is_empty 'Actionable comments posted: 0'"; then
  printf '[PASS] coderabbit profile: accepts zero actionable comments as empty\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] coderabbit profile: rejected zero actionable comments\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${coderabbit_profile}'; agent_review_profile_review_is_empty \$'<summary>Nitpick comments (1)</summary>'"; then
  printf '[FAIL] coderabbit profile: accepted nitpick summary as empty\n'
  fail=$(( fail + 1 ))
else
  printf '[PASS] coderabbit profile: nitpick summary is not empty\n'
  pass=$(( pass + 1 ))
fi

if bash -c \
  "source '${lib}'; printf '%s' \"\$(agent_review_quota_fallback_chain_raw)\"" \
  | grep -qxF 'coderabbit,copilot,bugbot'; then
  printf '[PASS] agent-review: default quota fallback chain is coderabbit,copilot,bugbot\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-review: unexpected default quota fallback chain\n'
  fail=$(( fail + 1 ))
fi

if next="$(bash -c \
  "source '${lib}'; source '${quota_lib}'; agent_review_quota_escalation_next_agent copilot")" \
  && [[ "${next}" == 'bugbot' ]]; then
  printf '[PASS] agent-review: quota escalation advances copilot to bugbot\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-review: quota escalation next after copilot (got %s)\n' "${next:-<empty>}"
  fail=$(( fail + 1 ))
fi

if AGENT_REVIEW_QUOTA_FALLBACK_CHAIN='coderabbit, copilot, bugbot' bash -c \
  "source '${lib}'; agent_review_quota_fallback_agent_at 1"; then
  printf '[PASS] agent-review: quota fallback chain trims whitespace\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] agent-review: quota fallback chain parsing failed\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: copilot daily quota cache ===\n'
if grep -qF 'scratch/repository-helpers/copilot-review-quota.env' "$quota_lib" \
  && grep -qF 'agent_review_copilot_quota_probe_recent_reviews' "$quota_lib" \
  && grep -qF 'agent_review_copilot_quota_skip_request' "$quota_lib" \
  && grep -qF 'agent_review_agent_quota_mark_exhausted' "$wait_script"; then
  printf '[PASS] copilot quota: daily scratch cache and programmatic probe\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot quota: missing daily cache or probe wiring\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== quota: confirmed only after review, not passive probe ===\n'
if grep -qF 'agent_review_quota_escalation_chain_raw' "$quota_lib" \
  && grep -qF 'AGENT_REVIEW_QUOTA_FALLBACK_CHAIN' "$quota_lib" \
  && grep -qF 'agent_review_agent_quota_confirmed_for_agent' "$quota_lib" \
  && grep -qF 'unconfirmed (not probed today)' "$lib" \
  && grep -qF 'unconfirmed (will request to probe)' "$quota_lib" \
  && ! grep -qF 'mark_available' "$quota_lib"; then
  printf '[PASS] quota: confirmed helpers and unconfirmed status labels\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota: missing confirmed helpers or still marks passive availability\n'
  fail=$(( fail + 1 ))
fi

tmp_copilot_probe="$(mktemp)"
if bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_copilot_probe}'
  agent_review_copilot_quota_write_cache 1 observed 'Copilot exhausted from review.'
  agent_review_copilot_quota_mark_confirmed 'Successful review clears stale exhaustion.'
  ! agent_review_agent_quota_exhausted_for_agent copilot \
    && agent_review_agent_quota_confirmed_for_agent copilot
"; then
  printf '[PASS] quota cache: confirmed write clears stale observed exhaustion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota cache: confirmed write did not clear stale observed exhaustion\n'
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_copilot_probe}"

tmp_copilot_probe_block="$(mktemp)"
if bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_copilot_probe_block}'
  agent_review_copilot_quota_write_cache 1 observed 'Copilot exhausted from review.'
  agent_review_copilot_quota_write_cache 0 probe 'stale passive probe' 0
  agent_review_agent_quota_exhausted_for_agent copilot \
    && ! agent_review_agent_quota_confirmed_for_agent copilot
"; then
  printf '[PASS] quota cache: non-confirmed write does not downgrade observed exhaustion\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota cache: non-confirmed write downgraded observed exhaustion\n'
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_copilot_probe_block}"

tmp_copilot_status="$(mktemp)"
if status="$(bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_copilot_status}'
  agent_review_copilot_quota_write_cache 0 test_isolation 'quota status test harness' 0
  agent_review_agent_quota_status_label copilot
")" && [[ "${status}" == 'unconfirmed (will request to probe)' ]]; then
  printf '[PASS] quota status: copilot is unconfirmed before a review today\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota status: expected unconfirmed copilot (got %s)\n' "${status:-<empty>}"
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_copilot_status}"

tmp_escalation_probe="$(mktemp)"
tmp_escalation_probe2="$(mktemp)"
tmp_escalation_probe3="$(mktemp)"
if picked="$(bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_escalation_probe}'
  AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE='${tmp_escalation_probe2}'
  AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${tmp_escalation_probe3}'
  agent_review_coderabbit_quota_write_cache 0 test_isolation 'test harness' 0
  agent_review_copilot_quota_write_cache 1 observed 'Copilot exhausted.'
  agent_review_quota_probe_agent_for_today
")" && [[ "${picked}" == 'coderabbit' ]]; then
  printf '[PASS] quota probe: escalation picks coderabbit when copilot exhausted\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota probe: expected coderabbit when copilot exhausted (got %s)\n' \
    "${picked:-<empty>}"
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_escalation_probe}" "${tmp_escalation_probe2}" "${tmp_escalation_probe3}"

printf '\n=== static: bugbot daily quota cache ===\n'
if grep -qF 'scratch/repository-helpers/bugbot-review-quota.env' "$quota_lib" \
  && grep -qF 'agent_review_bugbot_quota_probe_recent_signals' "$quota_lib" \
  && grep -qF 'probe_recent_comments' "$quota_lib" \
  && grep -qF 'agent_review_bugbot_quota_skip_request' "$quota_lib" \
  && grep -qF 'agent_review_agent_quota_skip_request' "$quota_lib"; then
  printf '[PASS] bugbot quota: daily scratch cache and programmatic probe\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] bugbot quota: missing daily cache or probe wiring\n'
  fail=$(( fail + 1 ))
fi

if bash -c "source '${lib}'; source '${quota_lib}'; agent_review_copilot_quota_text_is_exhausted 'reached their quota limit'"; then
  printf '[PASS] copilot quota probe: detects quota text via copilot profile\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot quota probe: rejected quota text\n'
  fail=$(( fail + 1 ))
fi

printf '\n=== static: bugbot GitHub check wait ===\n'
if grep -qF 'agent_review_profile_uses_head_check=true' "$bugbot_profile" \
  && grep -qF 'agent_review_profile_head_check_is_clean' "$bugbot_profile" \
  && grep -qF 'agent_review_profile_head_check_has_findings' "$bugbot_profile" \
  && grep -qF 'agent_review_profile_head_check_is_quota_exhausted' "$bugbot_profile" \
  && grep -qF 'agent_review_head_check_state_json' "$lib" \
  && grep -qF 'head_check_quota' "$lib"; then
  printf '[PASS] bugbot profile: interprets Cursor Bugbot GitHub check output\n'
  pass=$(( pass + 1 ))
else
