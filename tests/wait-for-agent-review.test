printf '\n=== static: Copilot timeline quota failure ===\n'
# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'copilot_work_finished_failure' "$lib" \
  && grep -qF 'agent_review_pr_timeline_json' "$lib" \
  && grep -qF 'agent_review_copilot_timeline_quota_failure_today' "$lib" \
  && grep -qF 'agent_review_copilot_timeline_probed_today' "$lib" \
  && grep -qF 'agent_review_copilot_quota_mark_timeline_probed' "$quota_lib" \
  && awk '
    /agent_review_quota_observe_agent_on_pr\(\)/ { in_fn=1 }
    in_fn && /agent_review_copilot_timeline_quota_failure_today/ { found=1 }
    in_fn && /agent_review_copilot_timeline_probed_today/ { gated=1 }
    in_fn && /^}/ { if (found && gated) exit 0; exit 1 }
    END { exit((found && gated) ? 0 : 1) }
  ' "$lib" \
  && grep -qF 'copilot_work_finished_failure' "$agents_md"; then
  printf '[PASS] copilot timeline: quota failure detection wired into observe + AGENTS.md\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot timeline: missing timeline quota helpers or observe wiring\n'
  fail=$(( fail + 1 ))
fi

timeline_today_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
timeline_yesterday_ts="$(date -u -d 'yesterday' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
  || date -u -v-1d +%Y-%m-%dT%H:%M:%SZ)"
timeline_ok_json="$(printf \
  '[{"id":424242,"event":"copilot_work_finished_failure","created_at":"%s","performed_via_github_app":{"slug":"copilot-swe-agent"}}]' \
  "${timeline_today_ts}")"
timeline_wrong_app_json="$(printf \
  '[{"id":1,"event":"copilot_work_finished_failure","created_at":"%s","performed_via_github_app":{"slug":"other-bot"}}]' \
  "${timeline_today_ts}")"
timeline_yesterday_json="$(printf \
  '[{"id":2,"event":"copilot_work_finished_failure","created_at":"%s","performed_via_github_app":{"slug":"copilot-swe-agent"}}]' \
  "${timeline_yesterday_ts}")"
# shellcheck disable=SC2016  # bash -c asserts timeline helper against fixture JSON
if evidence="$(bash -c "
  source '${lib}'
  agent_review_copilot_timeline_quota_failure_today \
    'the-hcma/mock-repo' 367 '${timeline_ok_json}'
")" \
  && [[ "${evidence}" == 'https://github.com/the-hcma/mock-repo/pull/367#event-424242' ]]; then
  printf '[PASS] copilot timeline: today failure with copilot app returns evidence URL\n'
  pass=$(( pass + 1 ))
else
