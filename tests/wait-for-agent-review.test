if grep -qF "agent_review_profile_request_visible='true'" "$profile" \
  && grep -qF 'agent_review_profile_request_already_sent' "$profile" \
  && grep -qF 'agent_review_profile_agent_requested_from_snapshot' "$profile" \
  && grep -qF 'agent_review_profile_request_already_sent' "$wait_script" \
  && grep -qF 'agent_review_profile_agent_requested_from_snapshot' "$lib"; then
  printf '[PASS] copilot: requests via @copilot PR comment with per-head idempotency\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot: missing @copilot comment request or idempotency wiring\n'
  fail=$(( fail + 1 ))
fi

if bash -c "
  source '${lib}'
  agent_review_use_agent copilot
  comments='[{\"body\":\"unrelated walkthrough\"}]'
  marker='wait-for-agent-review:copilot:deadbeef'
  ! agent_review_copilot_comments_contain_marker \"\${comments}\" \"\${marker}\" false
  comments='[{\"body\":\"@copilot please review\\n\\n<!-- wait-for-agent-review:copilot:deadbeef -->\"}]'
  agent_review_copilot_comments_contain_marker \"\${comments}\" \"\${marker}\" false
"; then
  printf '[PASS] copilot: comment marker jq rejects unrelated bodies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot: comment marker jq false positive or missed real marker\n'
  fail=$(( fail + 1 ))
fi

# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF '_bugbot_jq_r' "$bugbot_profile" \
  && grep -qF 'runner_exec "bugbot profile request comment"' "$bugbot_profile"; then
  printf '[PASS] bugbot profile: jq/gh via runner helpers with isolated-test fallback\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] bugbot profile: missing runner adoption wiring\n'
  fail=$(( fail + 1 ))
fi

test_summary
