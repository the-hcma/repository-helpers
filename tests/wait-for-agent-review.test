fi
rm -f "${tmp_cross_pr_same_num}" "${tmp_cross_pr_same_num_copilot}" "${tmp_cross_pr_same_num_cr}"

# Same repo+PR evidence must not get the cross-PR label.
tmp_same_pr_quota="$(mktemp)"
tmp_same_pr_quota_copilot="$(mktemp)"
tmp_same_pr_quota_cr="$(mktemp)"
