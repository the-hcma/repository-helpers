  fail=$(( fail + 1 ))
fi
rm -f "${tmp_rate_limit_wait}"

# Hermetic: read_cache must isolate evidence_url so mark_exhausted's local -r does not abort.
tmp_readonly_collide="$(mktemp)"
if bash -c "
  set -euo pipefail
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${tmp_readonly_collide}'
  agent_review_coderabbit_quota_write_cache 1 observed 'rate limited' '' '' \
