tmp_cross_pr_quota="$(mktemp)"
tmp_cross_pr_quota_copilot="$(mktemp)"
tmp_cross_pr_quota_cr="$(mktemp)"
if summary="$(bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE='${tmp_cross_pr_quota}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_cross_pr_quota_copilot}'
  AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${tmp_cross_pr_quota_cr}'
  agent_review_bugbot_quota_write_cache 0 observed \
    'bugbot review on mock-repo' '' '' \
    'https://github.com/the-hcma/mock-repo/pull/1#issuecomment-1'
  # Mark confirmed without exhaustion for 'available (reviewed today)' path.
  agent_review_bugbot_quota_write_cache 0 confirmed \
    'bugbot review on mock-repo' '' '' \
    'https://github.com/the-hcma/mock-repo/pull/1#issuecomment-1'
  agent_review_quota_summary_for_email 'the-hcma/repository-helpers' '352'
")" \
  && grep -qF 'confirmed via probe on other PR' <<<"${summary}" \
  && grep -qF 'mock-repo/pull/1' <<<"${summary}"; then
  printf '[PASS] quota email summary: labels cross-PR Bugbot evidence\n'
  pass=$(( pass + 1 ))
else
