# Same PR number on a different repo must still be labeled cross-PR (CodeRabbit on #357).
tmp_cross_pr_same_num="$(mktemp)"
tmp_cross_pr_same_num_copilot="$(mktemp)"
tmp_cross_pr_same_num_cr="$(mktemp)"
