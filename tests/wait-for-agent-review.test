  && grep -qF 'agent_review_last_request_epoch' "$lib" \
  && grep -qF 'min_epoch' "$lib"; then
  printf '[PASS] agent-review: preserves CLI agent and filters stale head checks\n'
  pass=$(( pass + 1 ))
else
