  && grep -qF 'unaddressed_human_threads' "$lib" \
  && grep -qF 'agent_review_all_quotas_exhausted' "$quota_lib" \
  && grep -qF 'agent_review_agent_quota_exhausted_for_agent' "$wait_script" \
  && grep -qF 'cmd_list_human_threads' "$wait_script" \
  && grep -qF 'cmd_resolve_human_addressed' "$wait_script" \
  && grep -qF 'cmd_complete_idle' "$wait_script" \
  && grep -qF 'agent_review_daily_quota_probe_satisfied' "$wait_script" \
  && grep -qF 'agent_review_default_cycle_timeout_s=900' "$lib"; then
  printf '[PASS] human threads and idle-success wired into wait loop\n'
  pass=$(( pass + 1 ))
else
