  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot timeline: yesterday event should return 1\n'
  fail=$(( fail + 1 ))
fi

# Confirmed + probe_requested must not suppress timeline exhaustion (repository-helpers#368).
tmp_copilot_timeline_obs="$(mktemp)"
tmp_copilot_timeline_json="$(mktemp)"
printf '%s\n' "${timeline_ok_json}" >"${tmp_copilot_timeline_json}"
if bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE='${tmp_copilot_timeline_obs}'
  agent_review_copilot_quota_write_cache 0 confirmed \
    'stale confirmed before new ask' 1 1
  agent_review_copilot_quota_mark_probe_requested 'new @copilot ask'
  agent_review_use_agent copilot
