  ! agent_review_copilot_timeline_quota_failure_today \
    'the-hcma/mock-repo' 367 '${timeline_wrong_app_json}'
"; then
  printf '[PASS] copilot timeline: non-copilot app slug is ignored\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot timeline: non-copilot app should return 1\n'
  fail=$(( fail + 1 ))
fi
if bash -c "
  source '${lib}'
  ! agent_review_copilot_timeline_quota_failure_today \
    'the-hcma/mock-repo' 367 '${timeline_yesterday_json}'
"; then
