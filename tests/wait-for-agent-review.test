  fail=$(( fail + 1 ))
fi

# Long review bodies that discuss quota heuristics must not count as exhaustion (#359).
if bash -c "
  source '${copilot_profile}'
  long_review='Reviewed the PR. All tests pass. Here are my findings:\n\n'
  long_review+=\"**Quota heuristic tightening** — The existing \\\"reached quota\\\", \"
  long_review+='\"quota exceeded\", etc. patterns still cover the non-premium variants. '
  while (( \${#long_review} <= 500 )); do
    long_review+='Additional substantive review commentary about the change. '
  done
  long_review+='Nothing blocking — the changes are correct.'
  ! agent_review_profile_text_is_quota_exhausted \"\${long_review}\"
"; then
  printf '[PASS] copilot profile: rejects quota discussion in long review text\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: treated quota code discussion as billing exhaustion\n'
  fail=$(( fail + 1 ))
fi

# Success detector must accept Copilot replies that quote the probe and mention quota (#359).
if bash -c "
  source '${lib}'
  agent_review_use_agent copilot
  head='91f486087a758ab846299e13f8df1da7034d06b4'
  marker=\"\$(agent_review_copilot_request_marker \"\${head}\")\"
  probe_body=\"\$(agent_review_copilot_request_comment_body \"\${head}\")\"
  reply_body=\$'\\\\n> @copilot please review this pull request.\\\\n> \\\\n> <!-- '\${marker}' -->\\\\n\\\\n'
  reply_body+=\"Reviewed the PR. The existing \\\"reached quota\\\", \\\"quota exceeded\\\" patterns \"
  reply_body+='are discussed in this change. '
  while (( \${#reply_body} <= 500 )); do
    reply_body+='More review findings about cross-PR evidence and ack-only length. '
  done
  reply_body+='Nothing blocking.'
  # Flat comment array: gh --paginate + jq -s yields .[]|.[] over comments.
  comments_json=\$(jq -nc \\
    --arg probe \"\${probe_body}\" \\
    --arg reply \"\${reply_body}\" \\
    '[
      {
        \"user\": {\"login\": \"operator\"},
        \"created_at\": \"2026-07-10T18:58:55Z\",
        \"body\": \$probe,
        \"html_url\": \"https://example.test/probe\"
      },
      {
        \"user\": {\"login\": \"Copilot\"},
        \"created_at\": \"2026-07-10T19:02:20Z\",
        \"body\": \$reply,
        \"html_url\": \"https://example.test/reply\"
      }
    ]')
  body=\"\$(agent_review_copilot_success_issue_comment_for_head \"\${comments_json}\" \"\${head}\")\"
  [[ -n \"\${body}\" ]] && [[ \"\${body}\" == *'Nothing blocking'* ]]
"; then
  printf '[PASS] copilot profile: success comment after probe despite quoted marker + quota words\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] copilot profile: missed success issue comment that quotes probe and discusses quota\n'
  fail=$(( fail + 1 ))
fi

tmp_rate_limit_wait="$(mktemp)"
if bash -c "
  source '${lib}'
  source '${quota_lib}'
  AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${tmp_rate_limit_wait}'
  agent_review_coderabbit_quota_write_cache 1 observed \
