  fail=$(( fail + 1 ))
fi

human_fixture='{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[{"id":"PRRT_human","isResolved":false,"comments":{"nodes":[{"databaseId":1,"url":"https://example.com/h/1","author":{"__typename":"User","login":"alice"},"body":"Please fix","path":"a.sh","line":1,"createdAt":"2026-06-19T16:00:00Z"}]}}]}}}}}'
if bots="$(bash -c "source '${lib}'; agent_review_bot_login_regex")" \
  && human_count="$(printf '%s' "${human_fixture}" | jq --arg bots "${bots}" '
      def is_bot_login($login):
        ($bots | split("|")) as $patterns
        | any($patterns[]; . as $p | ($login // "") | test($p;"i"));
      [.data.repository.pullRequest.reviewThreads.nodes[]
        | select(.isResolved == false)
        | .comments.nodes[0] as $first
        | select($first.author.__typename == "User")
        | select(is_bot_login($first.author.login) | not)
        | select(any(.comments.nodes[1:][]; .author.__typename == "User") | not)] | length')" \
  && [[ "${human_count}" == '1' ]]; then
  printf '[PASS] human thread filter: counts unresolved human reviewer threads\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] human thread filter: did not detect alice review thread\n'
  fail=$(( fail + 1 ))
fi

if grep -qF 'agent_review_abort_if_pending_threads' "$lib" \
