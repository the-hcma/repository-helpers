fi
rm -f "${tmp_env}"

request_epoch="$(date -d '2026-06-19T16:11:46Z' +%s)"
head_check_fixture='{"check_runs":[{"started_at":"2026-06-19T16:11:37Z","name":"Cursor Bugbot","status":"completed","conclusion":"neutral","output":{"summary":"usage limit reached","text":""}},{"started_at":"2026-06-19T16:12:57Z","name":"Cursor Bugbot","status":"in_progress","conclusion":null,"output":{"summary":"Reviewing","text":""}}]}'
head_check_status="$(
  # shellcheck disable=SC2016  # jq program uses jq vars ($re, $min_epoch), not shell expansion
  printf '%s' "${head_check_fixture}" \
    | jq -r -s --arg re 'Bugbot' --argjson min_epoch "${request_epoch}" '
        def started_epoch:
          if (.started_at // "") == "" then 0
          else ((.started_at | fromdateiso8601?) // 0)
          end;
        [.[] | .check_runs[]?]
        | map(select((.name // "") | test($re;"i")))
        | map(select(
            if $min_epoch == 0 then true
            elif started_epoch == 0 then true
            else started_epoch >= $min_epoch
            end
          ))
        | sort_by(.started_at // "")
        | last // null
        | .status // empty'
)"
if [[ "${head_check_status}" == 'in_progress' ]]; then
  printf '[PASS] head-check filter: ignores pre-request completed quota checks\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] head-check filter: still selects stale pre-request check\n'
  fail=$(( fail + 1 ))
fi

