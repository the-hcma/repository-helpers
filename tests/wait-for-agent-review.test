  agent_review_coderabbit_quota_mark_exhausted 'still limited' \
    'https://example.test/evidence2' '2099-07-01T12:00:00Z'
  agent_review_coderabbit_quota_read_cache
  [[ -n \"\${agent_review_coderabbit_quota_cache_evidence_url}\" ]]
"; then
  printf '[PASS] quota: mark_exhausted read_cache isolates evidence_url from caller locals\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] quota: mark_exhausted collided with local -r evidence_url when sourcing cache\n'
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_readonly_collide}"

# Hermetic: mid-cooldown pending feedback wakes the rate-limit wait (issue #369).
tmp_rate_limit_poll="$(mktemp)"
tmp_sleep_log="$(mktemp)"
if bash -c "
  set -euo pipefail
  # Source wait-for-agent-review without running main (BASH_SOURCE != \$0).
  # Do not pre-source agent-review: _ar_lib_dir is readonly.
  source '${wait_script}'
  AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${tmp_rate_limit_poll}'
  agent_review_coderabbit_quota_write_cache 1 observed \
    'rate limited' '' '' '' '2099-06-01T12:00:00Z'
  agent_review_named_pr_check_succeeded() { return 1; }
  agent_review_agent_signed_off_on_head() { return 1; }
  agent_review_loop_wait_add() { return 0; }
  agent_review_loop_wait_remove() { return 0; }
  agent_review_loop_set_stop() { return 0; }
  agent_review_use_agent() { return 0; }
  agent_review_abort_if_pending_threads() { return 3; }
  agent_review_repo_parts() { printf 'o r\n'; }
  agent_review_graphql_pr_snapshot() { printf '{}\n'; }
  run_command() {
    printf '%s\n' \"\$*\" >>'${tmp_sleep_log}'
    return 0
  }
  set +e
  cmd_loop_handle_coderabbit_rate_limit 'o/r' '1' 'abc1234deadbeef'
  rc=\$?
  set -e
  (( rc == 3 ))
  # Must not have slept: pending feedback surfaces immediately.
  ! grep -q . '${tmp_sleep_log}'
"; then
  printf '[PASS] hermetic: pending feedback during CodeRabbit rate-limit wait returns 3 without sleep\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: mid-cooldown pending feedback did not wake rate-limit wait\n'
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_rate_limit_poll}" "${tmp_sleep_log}"

# Hermetic: clean PR sleeps a poll chunk then resumes when retry_after clears.
tmp_rate_limit_poll2="$(mktemp)"
tmp_sleep_log2="$(mktemp)"
if bash -c "
  set -euo pipefail
  source '${wait_script}'
  AGENT_REVIEW_CODERABBIT_QUOTA_STATE_FILE='${tmp_rate_limit_poll2}'
  agent_review_default_coderabbit_rate_limit_poll_s=7
  agent_review_coderabbit_quota_write_cache 1 observed \
    'rate limited' '' '' '' '2099-06-01T12:00:00Z'
  agent_review_named_pr_check_succeeded() { return 1; }
  agent_review_agent_signed_off_on_head() { return 1; }
  agent_review_loop_wait_add() { return 0; }
  agent_review_loop_wait_remove() { return 0; }
  agent_review_loop_set_stop() { return 0; }
  agent_review_use_agent() { return 0; }
  agent_review_abort_if_pending_threads() { return 0; }
  agent_review_agent_quota_seconds_until_retry_for_agent() { printf '120\n'; }
  agent_review_repo_parts() { printf 'o r\n'; }
  agent_review_graphql_pr_snapshot() { printf '{}\n'; }
  polls=0
  agent_review_agent_quota_rate_limited_for_agent() {
    polls=\$((polls + 1))
    # Enter branch + first while check = limited; after one sleep, clear.
    if (( polls <= 2 )); then
      return 0
    fi
    return 1
  }
  run_command() {
    local label=\"\$1\"
    shift
    printf '%s %s\n' \"\${label}\" \"\$*\" >>'${tmp_sleep_log2}'
    return 0
  }
  set +e
  cmd_loop_handle_coderabbit_rate_limit 'o/r' '1' 'abc1234deadbeef'
  rc=\$?
  set -e
  (( rc == 0 ))
  grep -qF 'coderabbit rate-limit poll sleep sleep 7' '${tmp_sleep_log2}'
"; then
  printf '[PASS] hermetic: clean rate-limit wait sleeps poll chunk then returns 0\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] hermetic: clean rate-limit poll chunk path broken\n'
  fail=$(( fail + 1 ))
fi
rm -f "${tmp_rate_limit_poll2}" "${tmp_sleep_log2}"

# shellcheck disable=SC2016  # static assert matches literal source text
if grep -qF 'agent_review_agent_quota_rate_limited_for_agent "${agent}"' "$wait_script"; then
  printf '[PASS] loop: temporary rate limit does not clear agent wait as response seen\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] loop: rate-limited agent still treated as response seen\n'
  fail=$(( fail + 1 ))
fi

