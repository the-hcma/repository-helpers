#!/usr/bin/env bash
# Populate minimumReleaseAgeExclude from the current pnpm-lock.yaml so existing
# pins are grandfathered when enabling minimumReleaseAge. Also adds registry
# "latest" for direct package.json dependencies so pnpm 11.1.3+ lockfile
# verification does not flag semver-allowed versions that are not yet locked.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/grandfather-pnpm-release-age [OPTIONS] [repo_root]

Writes or updates pnpm-workspace.yaml with:
  minimumReleaseAge (default 14400 = 10 days)
  minimumReleaseAgeStrict: false
  minimumReleaseAgeExclude: lockfile packages/snapshots + registry latest for direct deps

Options:
  --minutes <n>   minimumReleaseAge in minutes (default: 14400)
  -h, --help      Show this help
EOF
}

minutes=14400
repo_root="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --minutes)
      minutes="${2:?--minutes requires a value}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      repo_root="$1"
      shift
      break
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  repo_root="$1"
fi

repo_root="$(cd "$repo_root" && pwd)"
lockfile="${repo_root}/pnpm-lock.yaml"
workspace="${repo_root}/pnpm-workspace.yaml"
pkg_json="${repo_root}/package.json"

if [[ ! -f "$lockfile" ]]; then
  printf 'ERROR: no pnpm-lock.yaml under %s\n' "$repo_root" >&2
  exit 1
fi

declare -a excludes=()

while IFS= read -r line; do
  excludes+=("$line")
done < <(
  awk '
    /^packages:$/ { inpkg=1; insnap=0; next }
    /^snapshots:$/ { insnap=1; inpkg=0; next }
    (inpkg || insnap) && /^  / {
      line=$0
      sub(/^  /, "", line)
      sub(/:$/, "", line)
      gsub(/^'\''|'\''$/, "", line)
      sub(/\([^)]*\)$/, "", line)
      if (line ~ /@[0-9]+(\.[0-9A-Za-z-]+)*$/) print line
    }
  ' "$lockfile"
)

if [[ ${#excludes[@]} -eq 0 ]]; then
  printf 'ERROR: found no package@version entries in %s\n' "$lockfile" >&2
  exit 1
fi

if [[ -f "$pkg_json" ]] && command -v jq >/dev/null 2>&1; then
  pkg=""
  latest=""
  while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    latest=""
    latest="$(cd "$repo_root" && pnpm view "$pkg" version 2>/dev/null || true)"
    if [[ -n "$latest" ]]; then
      excludes+=("${pkg}@${latest}")
    fi
  done < <(jq -r '
    [.dependencies, .devDependencies, .optionalDependencies, .peerDependencies]
    | map(select(. != null)) | add // {}
    | keys[]
  ' "$pkg_json" 2>/dev/null || true)
fi

mapfile -t excludes < <(printf '%s\n' "${excludes[@]}" | LC_ALL=C sort -u)

tmp="$(mktemp)"
{
  printf '%s\n' '# Supply-chain: 10-day minimum release age for new resolutions.'
  printf '%s\n' '# Existing lockfile pins are grandfathered via minimumReleaseAgeExclude below.'
  printf '%s\n' "# Regenerate after major lockfile refreshes: scripts/grandfather-pnpm-release-age"
  printf '\n'
  printf 'minimumReleaseAge: %s\n' "$minutes"
  printf '%s\n' 'minimumReleaseAgeStrict: false'
  if [[ -f "$workspace" ]] && grep -q '^allowBuilds:' "$workspace"; then
    awk '/^allowBuilds:/{found=1} found{print} found && /^[^[:space:]]/ && !/^allowBuilds:/{exit}' \
      "$workspace"
    printf '\n'
  fi
  printf '%s\n' 'minimumReleaseAgeExclude:'
  for item in "${excludes[@]}"; do
    printf '  - "%s"\n' "$item"
  done
} >"$tmp"

mv "$tmp" "$workspace"
printf 'Wrote %s (%d grandfathered entries, minimumReleaseAge=%s).\n' \
  "$workspace" "${#excludes[@]}" "$minutes"
