#!/usr/bin/env bash
# Populate pnpm-workspace.yaml for a 10-day minimumReleaseAge policy while
# grandfathering the current lockfile via pnpm-release-age-grandfather.tsv.
#
# Default (--wildcard): minimumReleaseAgeExclude: ["*"] for pnpm 11.1.3+ CI.
# --tracked: per pkg@version excludes with publish epochs (age out via prune).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/pnpm-release-age
source "${script_dir}/lib/pnpm-release-age"

usage() {
  cat <<'EOF'
Usage: scripts/grandfather-pnpm-release-age [OPTIONS] [repo_root]

Writes pnpm-workspace.yaml and pnpm-release-age-grandfather.tsv.

Options:
  --wildcard      Grandfather with minimumReleaseAgeExclude: ["*"] (default)
  --tracked       Grandfather each lockfile pkg@version (enables aging out)
  --minutes <n>   minimumReleaseAge in minutes (default: 14400)
  -h, --help      Show this help
EOF
}

minutes="$pnpm_release_age_default_minutes"
mode="wildcard"
repo_root="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --wildcard)
      mode="wildcard"
      shift
      ;;
    --tracked)
      mode="tracked"
      shift
      ;;
    --minutes)
      minutes="${2:?--minutes requires a value}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      repo_root="$1"
      shift
      break
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  repo_root="$1"
fi

repo_root="$(cd "$repo_root" && pwd)"
lockfile="${repo_root}/pnpm-lock.yaml"
tsv="$(pnpm_release_age_grandfather_path "$repo_root")"

if [[ ! -f "$lockfile" ]]; then
  printf 'ERROR: no pnpm-lock.yaml under %s\n' "$repo_root" >&2
  exit 1
fi

entry_lines=()
exclude_specs=()

if [[ "$mode" == 'tracked' ]]; then
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    entry_lines+=("$line")
    exclude_specs+=("${line%%$'\t'*}")
  done < <(pnpm_release_age_build_tracked_entries_from_lockfile "$lockfile")
  if [[ ${#exclude_specs[@]} -eq 0 ]]; then
    printf 'ERROR: no pkg@version entries found in %s\n' "$lockfile" >&2
    exit 1
  fi
fi

pnpm_release_age_write_grandfather_file "$tsv" "$minutes" "$mode" "${entry_lines[@]}"
pnpm_release_age_sync_workspace "$repo_root" "$minutes" "$mode" "${exclude_specs[@]}"

if [[ "$mode" == 'wildcard' ]]; then
  printf 'Wrote %s and pnpm-workspace.yaml (wildcard "*", minimumReleaseAge=%s).\n' \
    "$tsv" "$minutes"
  printf 'To age out entries later: scripts/prune-pnpm-release-age-grandfather --expand-wildcard\n'
else
  printf 'Wrote %s (%s tracked entries) and pnpm-workspace.yaml (minimumReleaseAge=%s).\n' \
    "$tsv" "${#exclude_specs[@]}" "$minutes"
  printf 'Age out matured excludes: scripts/prune-pnpm-release-age-grandfather\n'
fi
