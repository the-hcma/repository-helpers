#!/usr/bin/env bash
# One-time cutover: enable minimumReleaseAge with minimumReleaseAgeExclude: ["*"]
# so the existing pnpm-lock.yaml keeps passing CI under pnpm 11.1.3+.
# Forward bumps are gated by Dependabot cooldown and dep-updater, not this script.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/pnpm-release-age
source "${script_dir}/lib/pnpm-release-age"

usage() {
  cat <<'EOF'
Usage: scripts/grandfather-pnpm-release-age [OPTIONS] [repo_root]

Writes pnpm-workspace.yaml with minimumReleaseAge (default 14400) and
minimumReleaseAgeExclude: ["*"] to grandfather the current lockfile.

Options:
  --minutes <n>   minimumReleaseAge in minutes (default: 14400)
  -h, --help      Show this help
EOF
}

minutes="$pnpm_release_age_default_minutes"
repo_root="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --minutes)
      minutes="${2:?--minutes requires a value}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      repo_root="$1"
      shift
      break
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  repo_root="$1"
fi

repo_root="$(cd "$repo_root" && pwd)"
lockfile="${repo_root}/pnpm-lock.yaml"

if [[ ! -f "$lockfile" ]]; then
  printf 'ERROR: no pnpm-lock.yaml under %s\n' "$repo_root" >&2
  exit 1
fi

pnpm_release_age_write_workspace_wildcard "$repo_root" "$minutes"
printf 'Wrote %s/pnpm-workspace.yaml (wildcard "*", minimumReleaseAge=%s).\n' \
  "$repo_root" "$minutes"
