# shellcheck shell=bash
# Helpers for one-time pnpm minimumReleaseAge cutover (wildcard grandfather).
# Requires bash 5+.

pnpm_release_age_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly pnpm_release_age_lib_dir

# shellcheck source=scripts/lib/release-age-defaults
source "${pnpm_release_age_lib_dir}/release-age-defaults"

# shellcheck disable=SC2034  # read by scripts/grandfather-pnpm-release-age after source
pnpm_release_age_default_minutes="$release_age_default_minutes"

# pnpm_release_age_lockfile_entry_count <lockfile_path>
# Prints the number of pkg@version keys under packages/snapshots.
pnpm_release_age_lockfile_entry_count() {
  local -r lockfile="$1"
  awk '
    /^packages:$/ { inpkg=1; insnap=0; next }
    /^snapshots:$/ { insnap=1; inpkg=0; next }
    (inpkg || insnap) && /^  / {
      line=$0
      sub(/^  /, "", line)
      sub(/:$/, "", line)
      gsub(/^'\''|'\''$/, "", line)
      sub(/\([^)]*\)$/, "", line)
      if (line ~ /@[0-9]+(\.[0-9A-Za-z-]+)*$/) count++
    }
    END { print count + 0 }
  ' "$lockfile"
}

# pnpm_release_age_workspace_allow_builds_block <workspace_path>
# Prints allowBuilds: stanza (if any) including trailing newline.
pnpm_release_age_workspace_allow_builds_block() {
  local -r workspace="$1"
  if [[ -f "$workspace" ]] && grep -q '^allowBuilds:' "$workspace"; then
    awk '
      /^allowBuilds:/ { found=1 }
      found {
        if (/^[^[:space:]]/ && !/^allowBuilds:/) { exit }
        print
      }
    ' "$workspace"
    printf '\n'
  fi
}

# pnpm_release_age_write_workspace_wildcard <repo_root> <minutes>
# Writes pnpm-workspace.yaml with minimumReleaseAge and exclude ["*"].
pnpm_release_age_write_workspace_wildcard() {
  local -r repo_root="$1"
  local -r minutes="$2"
  local workspace lockfile lockfile_entries allow_block tmp

  workspace="${repo_root}/pnpm-workspace.yaml"
  lockfile="${repo_root}/pnpm-lock.yaml"
  lockfile_entries=0
  if [[ -f "$lockfile" ]]; then
    lockfile_entries="$(pnpm_release_age_lockfile_entry_count "$lockfile")"
  fi

  allow_block="$(pnpm_release_age_workspace_allow_builds_block "$workspace")"
  tmp="$(mktemp)"
  {
    printf '%s\n' "# Supply-chain: ${release_age_default_days_adjective} minimum release age for new resolutions."
    printf '%s\n' '# Cutover: "*" grandfathers the existing lockfile at policy enable (one-time).'
    printf '%s\n' "# Lockfile had ${lockfile_entries} pinned package@version entries when generated."
    printf '%s\n' "# Forward: Dependabot cooldown + dep-updater enforce ${release_age_default_days_phrase} on new non-CVE bumps."
    printf '%s\n' '# Re-run scripts/grandfather-pnpm-release-age if this file was lost.'
    printf '\n'
    printf '%s\n' 'packages:'
    printf '%s\n' "  - '.'"
    printf '\n'
    printf 'minimumReleaseAge: %s\n' "$minutes"
    printf '%s\n' 'minimumReleaseAgeStrict: false'
    if [[ -n "$allow_block" ]]; then
      printf '%s' "$allow_block"
    fi
    printf '%s\n' 'minimumReleaseAgeExclude:'
    printf '%s\n' '  - "*"'
  } >"$tmp"
  mv "$tmp" "$workspace"
}
