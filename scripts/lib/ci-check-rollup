#!/usr/bin/env bash
# ci-check-rollup — statusCheckRollup helpers for CI gating and failure reporting.
#
# Sourced by dep-updater and post-pr-submission-checks. Functions expect gh and jq
# on PATH.
# shellcheck disable=SC2016  # jq filter programs are single-quoted literals

_ci_rollup_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _ci_rollup_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_ci_rollup_lib_dir}/runner-ensure"

ci_rollup_runner_last_stdout() {
  local uuid

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || return 0
  runner_read "$uuid" stdout 2>/dev/null || true
}

# ci_rollup_jq_file <label> [--probe] <input-json> [jq-args…]
ci_rollup_jq_file() {
  local -r label="$1"
  local probe=0
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  local -r input="$1"
  shift
  local tmp exit_code

  tmp="$(mktemp)"
  printf '%s' "$input" >"$tmp"
  exit_code=0
  if (( probe )); then
    runner_exec "$label" --probe --stream-stdout -- jq "$@" "$tmp" || exit_code=$?
  else
    runner_exec "$label" --stream-stdout -- jq "$@" "$tmp" || exit_code=$?
  fi
  rm -f "$tmp"
  return "$exit_code"
}

# ci_rollup_jq_lines <label> [jq-args…]
# Reads newline-separated stdin into a temp file for jq -R -s style filters.
ci_rollup_jq_lines() {
  local -r label="$1"
  shift
  local tmp exit_code

  tmp="$(mktemp)"
  cat >"$tmp"
  exit_code=0
  runner_exec "$label" --stream-stdout -- jq "$@" "$tmp" || exit_code=$?
  rm -f "$tmp"
  return "$exit_code"
}

# Job display names (or job ids) from ci.yml that must be green before merge.
# Skips guard/changed-files/secret-scan/workflow-lint (optional gates, not merge blockers).
ci_discover_required_contexts_from_ci_yml_text() {
  local text="$1"

  awk '
    function emit() {
      if (job == "" || job == "guard" || job == "changed-files" || job == "secret-scan" \
          || job == "workflow-lint") {
        return
      }
      if (disp != "") {
        print disp
      } else {
        print job
      }
    }
    BEGIN { in_jobs = 0; job = ""; disp = "" }
    /^jobs:/ { in_jobs = 1; next }
    !in_jobs { next }
    /^  [a-zA-Z0-9_-]+:/ {
      emit()
      job = $1
      sub(/^  /, "", job)
      sub(/:$/, "", job)
      disp = ""
      next
    }
    job != "" && /^    name:/ {
      sub(/^    name: /, "")
      disp = $0
      next
    }
    END { emit() }
  ' <<<"$text"
}

ci_rollup_conclusion_for_gating() {
  local rollup_json="$1"
  local required_contexts="${2:-}"
  local required_json

  if [[ -z "$rollup_json" ]]; then
    rollup_json='[]'
  fi

  required_json="$(printf '%s\n' "$required_contexts" \
    | ci_rollup_jq_lines "ci-rollup required contexts" -R -s 'split("\n") | map(select(length > 0))')"

  ci_rollup_jq_file "ci-rollup gating conclusion" "$rollup_json" -r --argjson required "$required_json" '
    def fail_conclusions:
      ["FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "STARTUP_FAILURE", "ACTION_REQUIRED"];
    def ok_conclusions:
      ["SUCCESS", "SKIPPED", "NEUTRAL"];
    def is_failure($c):
      ($c // "") as $v | fail_conclusions | index($v) != null;
    def is_ok($c):
      ($c // "") as $v | ok_conclusions | index($v) != null;
    def is_external($n):
      ($n // "") as $v
      | ($v | startswith("Graphite /"))
        or $v == "label"
        or ($v | startswith("label-"))
        or $v == "cleanup-merged-branch"
        or $v == "close-merged-prs"
        or ($v | test("(?i)dependabot"));
    def is_incomplete($e):
      ((.conclusion // "") == "")
        or ((.status // "") != "" and (.status // "") != "COMPLETED");
    def rollup_entry($r; $ctx):
      ($r | map(select((.name // .context // "") == $ctx)) | .[0] // null);

    (. // []) as $r
    | if ($r | length) == 0 then "missing"
      elif any($r[]; is_failure(.conclusion)) then "failure"
      elif ($required | length) > 0 then
        if any($required[]; rollup_entry($r; .) == null) then "pending"
        elif any($required[]; rollup_entry($r; .) as $e | is_ok($e.conclusion) | not) then "pending"
        elif any($r[]; (is_external(.name // .context // "") | not) and is_incomplete(.)) then "pending"
        else "success"
        end
      elif any($r[]; (is_external(.name // .context // "") | not) and is_incomplete(.)) then "pending"
      elif ([$r[] | select(is_external(.name // .context // "") | not)] | length) == 0 then "pending"
      elif all($r[] | select(is_external(.name // .context // "") | not); is_ok(.conclusion)) then "success"
      else "pending"
      end'
}

ci_rollup_json_for_pr() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local exit_code out

  exit_code=0
  if [[ -n "$repo" ]]; then
    runner_exec "gh pr statusCheckRollup" -- gh pr view "$pr" --repo "$repo" \
      --json statusCheckRollup --jq '.statusCheckRollup // []' || exit_code=$?
  else
    runner_exec "gh pr statusCheckRollup" -- gh pr view "$pr" \
      --json statusCheckRollup --jq '.statusCheckRollup // []' || exit_code=$?
  fi
  if (( exit_code != 0 )); then
    printf '[]\n'
    return 0
  fi
  out="$(ci_rollup_runner_last_stdout)"
  if [[ -z "$out" ]]; then
    printf '[]\n'
  else
    printf '%s\n' "$out"
  fi
}

# Normalize StatusContext rows (state/context) and CheckRun rows to a common shape.
ci_rollup_normalize_json() {
  local -r json="$1"

  ci_rollup_jq_file "ci-rollup normalize" "$json" -c '
    [.[]?
      | if (.name // "") == "" and (.context // "") != "" then
          .name = .context
        else .
        end
      | if (.conclusion // "") == "" and (.state // "") != "" then
          .conclusion = .state
        else .
        end
    ]' 2>/dev/null || printf '[]\n'
}

# Keep the newest rollup row per check name (supersedes stale CANCELLED/SKIPPED rows).
ci_rollup_latest_by_name_json() {
  local -r json="$1"
  local normalized

  normalized="$(ci_rollup_normalize_json "${json}")"
  ci_rollup_jq_file "ci-rollup latest by name" "$normalized" -c '
    [.[]?
      | select((.name // .context // "") != "")]
    | group_by(.name // .context // "unknown")
    | map(sort_by(.startedAt // .completedAt // "") | .[-1])
  ' 2>/dev/null || printf '[]\n'
}

ci_rollup_has_pending_or_in_progress() {
  local -r json="$1"
  local normalized

  normalized="$(ci_rollup_normalize_json "${json}")"
  ci_rollup_jq_file "ci-rollup pending check" --probe "$normalized" -e '
    [ .[]?
      | (.conclusion // "")
    ]
    | any(. == "" or . == "IN_PROGRESS" or . == "QUEUED" or . == "PENDING")
  ' >/dev/null
}

# Drop agent-product checks — they are not required CI.
# CodeRabbit / Bugbot start "in progress" on push; agent-review owns cooldown / nudge.
# Vortex / Mergestorm are advisory review bots and must not block dep-updater CI waits.
ci_rollup_without_agent_product_checks() {
  local -r json="$1"

  ci_rollup_jq_file "ci-rollup without agent product checks" "$json" -c '
    [ .[]?
      | select(
          ((.name // .context // "")
            | test("^(CodeRabbit|Cursor Bugbot|vortex(-v[0-9]+)?|mergestorm.*)$"; "i"))
          | not
        )
    ]
  '
}

ci_rollup_failed_lines() {
  local -r json="$1"

  ci_rollup_jq_file "ci-rollup failed lines" "$json" -r '
    [ .[]?
      | {
          name: (.name // .context // "unknown"),
          conclusion: (.conclusion // ""),
          detailsUrl: (.detailsUrl // "")
        }
      | select(.conclusion != "SUCCESS")
      | select(.conclusion != "SKIPPED")
      | select(.conclusion != "NEUTRAL")
      | select(.conclusion != "")
    ]
    | .[]
    | "\(.name)\t\(.conclusion)\t\(.detailsUrl)"
  '
}

ci_rollup_failure_details_json() {
  local -r json="$1"

  ci_rollup_jq_file "ci-rollup failure details" "$json" -c '
    [ .[]?
      | {
          name: (.name // .context // "unknown"),
          conclusion: (.conclusion // ""),
          url: (.detailsUrl // "")
        }
      | select(.conclusion != "SUCCESS")
      | select(.conclusion != "SKIPPED")
      | select(.conclusion != "NEUTRAL")
      | select(.conclusion != "")
    ]
  ' 2>/dev/null || printf '[]\n'
}

# ci_rollup_jq_n <label> [jq -n args…]
ci_rollup_jq_n() {
  local -r label="$1"
  shift
  local exit_code

  exit_code=0
  runner_exec "$label" --stream-stdout -- jq -n "$@" || exit_code=$?
  return "$exit_code"
}

# ci_failure_details_json_from_rollup <pr> <repo> <branch> <rollup-json>
# Structured CI failure for emails and batch child reports (pr_url, check_url).
ci_failure_details_json_from_rollup() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local -r branch="${3:-}"
  local -r rollup="$4"
  local first_line name conclusion check_url pr_url summary rest

  if [[ -n "$repo" ]]; then
    pr_url="https://github.com/${repo}/pull/${pr}"
  else
    pr_url=""
  fi

  name=""
  conclusion=""
  check_url=""
  first_line="$(ci_rollup_failed_lines "$rollup" | head -n 1 || true)"
  if [[ -n "$first_line" ]]; then
    name="${first_line%%$'\t'*}"
    rest="${first_line#*$'\t'}"
    conclusion="${rest%%$'\t'*}"
    check_url="${rest#*$'\t'}"
    if [[ "$check_url" == "$conclusion" ]]; then
      check_url=""
    fi
    summary="check ${name} ${conclusion}"
  elif [[ -n "$branch" ]]; then
    summary="branch ${branch}"
  else
    summary="CI checks failed"
  fi

  ci_rollup_jq_n "ci-failure details json" \
    --argjson pr "$pr" \
    --arg repo "$repo" \
    --arg pr_url "$pr_url" \
    --arg branch "$branch" \
    --arg check_name "$name" \
    --arg check_conclusion "$conclusion" \
    --arg check_url "$check_url" \
    --arg summary "$summary" \
    '{
      pr: $pr,
      repo: $repo,
      pr_url: $pr_url,
      branch: $branch,
      check_name: $check_name,
      check_conclusion: $check_conclusion,
      check_url: $check_url,
      summary: $summary
    }'
}

ci_rollup_conclusion_for_pr_gating() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local -r required_contexts="${3:-}"
  local rollup normalized latest

  rollup="$(ci_rollup_json_for_pr "$pr" "$repo")"
  normalized="$(ci_rollup_normalize_json "$rollup")"
  # Match post-pr-submission-checks / agent-review: agent-product checks are not
  # merge gates. Leaving them in the rollup made dep-updater WAIT_TIMEOUT on
  # CodeRabbit "pending" after required CI was already green (#401).
  normalized="$(ci_rollup_without_agent_product_checks "$normalized")"
  if ci_rollup_has_pending_or_in_progress "$normalized"; then
    printf '%s\n' 'pending'
    return 0
  fi
  latest="$(ci_rollup_latest_by_name_json "$normalized")"
  ci_rollup_conclusion_for_gating "$latest" "$required_contexts"
}

ci_failure_details_json_for_pr() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local -r branch="${3:-}"
  local rollup normalized latest

  rollup="$(ci_rollup_json_for_pr "$pr" "$repo")"
  normalized="$(ci_rollup_normalize_json "$rollup")"
  latest="$(ci_rollup_latest_by_name_json "$normalized")"
  ci_failure_details_json_from_rollup "$pr" "$repo" "$branch" "$latest"
}

ci_failure_summary_from_details_json() {
  local -r details="$1"

  ci_rollup_jq_file "ci-failure summary text" "$details" -r '
    if (.check_name // "") != "" then
      "check=" + .check_name + " conclusion=" + (.check_conclusion // "") +
      (if (.check_url // "") != "" then " url=" + .check_url else "" end) +
      (if (.pr_url // "") != "" then " pr_url=" + .pr_url else "" end) +
      (if (.branch // "") != "" then " branch=" + .branch else "" end)
    elif (.branch // "") != "" then
      "branch=" + .branch +
      (if (.pr_url // "") != "" then " pr_url=" + .pr_url else "" end)
    else
      (if (.pr_url // "") != "" then "pr_url=" + .pr_url else "CI checks failed" end)
    end
  ' 2>/dev/null || printf 'CI checks failed\n'
}

ci_failure_summary_for_pr() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local -r branch="${3:-}"
  local details

  details="$(ci_failure_details_json_for_pr "$pr" "$repo" "$branch")"
  ci_failure_summary_from_details_json "$details"
}

# ci_rollup_discover_repo_slug — owner/name for the current gh repository context.
ci_rollup_discover_repo_slug() {
  local slug exit_code

  exit_code=0
  slug="$(runner_exec_stdout "ci-rollup discover repo slug" -- gh repo view --json nameWithOwner \
    --jq '.nameWithOwner // empty')" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "$slug" ]]; then
    return 1
  fi
  printf '%s\n' "$slug"
}

# ci_failed_workflow_run_id_for_pr <pr> [repo]
# Newest failed Actions run for the PR head SHA (empty when none).
ci_failed_workflow_run_id_for_pr() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local head_sha branch runs_json run_id exit_code

  exit_code=0
  if [[ -n "$repo" ]]; then
    head_sha="$(runner_exec_stdout "ci-rollup pr head sha" -- gh pr view "$pr" --repo "$repo" \
      --json headRefOid --jq '.headRefOid // empty')" || exit_code=$?
    branch="$(runner_exec_stdout "ci-rollup pr head branch" -- gh pr view "$pr" --repo "$repo" \
      --json headRefName --jq '.headRefName // empty')" || exit_code=$?
    runs_json="$(runner_exec_stdout "ci-rollup list failed runs" -- gh run list --repo "$repo" \
      --branch "$branch" --limit 15 --json databaseId,headSha,conclusion)" || exit_code=$?
  else
    head_sha="$(runner_exec_stdout "ci-rollup pr head sha" -- gh pr view "$pr" \
      --json headRefOid --jq '.headRefOid // empty')" || exit_code=$?
    branch="$(runner_exec_stdout "ci-rollup pr head branch" -- gh pr view "$pr" \
      --json headRefName --jq '.headRefName // empty')" || exit_code=$?
    runs_json="$(runner_exec_stdout "ci-rollup list failed runs" -- gh run list \
      --branch "$branch" --limit 15 --json databaseId,headSha,conclusion)" || exit_code=$?
  fi
  if (( exit_code != 0 )) || [[ -z "$head_sha" || -z "$branch" || -z "$runs_json" ]]; then
    return 1
  fi
  run_id="$(ci_rollup_jq_file "ci-rollup pick failed run" "$runs_json" -r --arg head "$head_sha" '
    [ .[]?
      | select(.headSha == $head and (.conclusion // "") == "failure")
    ]
    | .[0].databaseId // empty
  ' 2>/dev/null || printf '')"
  if [[ -z "$run_id" ]]; then
    return 1
  fi
  printf '%s\n' "$run_id"
}

# ci_agent_filter_failed_log_lines — stdin: gh run view --log-failed; stdout: agent-actionable lines.
ci_agent_filter_failed_log_lines() {
  grep -E \
    '^\[FAIL\] [^:]+: |^--- results: .*[^0] failed|^ERROR:|unbound variable|##\[error\]Process completed|Process completed with exit code [1-9]' \
    || true
}

# ci_agent_report_failed_logs_for_pr <pr> [repo]
# Prints failed-check summary plus filtered job log excerpts for coding agents.
ci_agent_report_failed_logs_for_pr() {
  local -r pr="$1"
  local repo="${2:-}"
  local run_id run_url log_text filtered max_lines line_count exit_code

  if [[ -z "$repo" ]]; then
    repo="$(ci_rollup_discover_repo_slug || true)"
  fi

  max_lines="${POST_PR_CHECKS_LOG_LINES:-80}"
  run_id=""
  exit_code=0
  run_id="$(ci_failed_workflow_run_id_for_pr "$pr" "$repo")" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "$run_id" ]]; then
    printf '==> CI failure details for coding agent: no failed Actions run found for PR #%s head (see check URLs above)\n' \
      "$pr" >&2
    return 0
  fi

  run_url=""
  if [[ -n "$repo" ]]; then
    run_url="$(runner_exec_stdout "ci-rollup failed run url" -- gh run view "$run_id" --repo "$repo" \
      --json url --jq '.url // empty')" || run_url=""
  else
    run_url="$(runner_exec_stdout "ci-rollup failed run url" -- gh run view "$run_id" \
      --json url --jq '.url // empty')" || run_url=""
  fi

  printf '==> CI failure details for coding agent (PR #%s, run %s%s%s):\n' \
    "$pr" "$run_id" \
    "$( [[ -n "$run_url" ]] && printf ', %s' "$run_url" || printf '' )" \
    "$( [[ -n "$repo" ]] && printf ', repo=%s' "$repo" || printf '' )" >&2

  log_text=""
  exit_code=0
  if [[ -n "$repo" ]]; then
    log_text="$(runner_exec_stdout "ci-rollup failed run logs" -- gh run view "$run_id" --repo "$repo" \
      --log-failed 2>/dev/null)" || exit_code=$?
  else
    log_text="$(runner_exec_stdout "ci-rollup failed run logs" -- gh run view "$run_id" \
      --log-failed 2>/dev/null)" || exit_code=$?
  fi
  if (( exit_code != 0 )) || [[ -z "$log_text" ]]; then
    printf '    (failed to fetch --log-failed; inspect the run URL manually)\n' >&2
    return 0
  fi

  filtered="$(printf '%s\n' "$log_text" | ci_agent_filter_failed_log_lines | tail -n "$max_lines")"
  if [[ -z "$filtered" ]]; then
    printf '    (no filtered failure lines; run: gh run view %s --log-failed)\n' "$run_id" >&2
    return 0
  fi

  line_count=0
  while IFS= read -r line; do
    printf '    %s\n' "$line" >&2
    line_count=$(( line_count + 1 ))
  done <<<"$filtered"
  if (( line_count >= max_lines )); then
    printf '    … (truncated to %s lines; set POST_PR_CHECKS_LOG_LINES to raise)\n' "$max_lines" >&2
  fi
}
