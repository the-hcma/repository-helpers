#!/usr/bin/env bash
# ci-check-rollup — statusCheckRollup helpers for CI gating and failure reporting.
#
# Sourced by dep-updater and post-pr-submission-checks. Functions expect gh and jq
# on PATH.

# Job display names (or job ids) from ci.yml that must be green before merge.
# Skips guard/changed-files/secret-scan/workflow-lint (optional gates, not merge blockers).
ci_discover_required_contexts_from_ci_yml_text() {
  local text="$1"

  awk '
    function emit() {
      if (job == "" || job == "guard" || job == "changed-files" || job == "secret-scan" \
          || job == "workflow-lint") {
        return
      }
      if (disp != "") {
        print disp
      } else {
        print job
      }
    }
    BEGIN { in_jobs = 0; job = ""; disp = "" }
    /^jobs:/ { in_jobs = 1; next }
    !in_jobs { next }
    /^  [a-zA-Z0-9_-]+:/ {
      emit()
      job = $1
      sub(/^  /, "", job)
      sub(/:$/, "", job)
      disp = ""
      next
    }
    job != "" && /^    name:/ {
      sub(/^    name: /, "")
      disp = $0
      next
    }
    END { emit() }
  ' <<<"$text"
}

ci_rollup_conclusion_for_gating() {
  local rollup_json="$1"
  local required_contexts="${2:-}"
  local required_json

  if [[ -z "$rollup_json" ]]; then
    rollup_json='[]'
  fi

  required_json="$(printf '%s\n' "$required_contexts" | jq -R -s 'split("\n") | map(select(length > 0))')"

  jq -r --argjson required "$required_json" '
    def fail_conclusions:
      ["FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "STARTUP_FAILURE", "ACTION_REQUIRED"];
    def ok_conclusions:
      ["SUCCESS", "SKIPPED", "NEUTRAL"];
    def is_failure($c):
      ($c // "") as $v | fail_conclusions | index($v) != null;
    def is_ok($c):
      ($c // "") as $v | ok_conclusions | index($v) != null;
    def is_external($n):
      ($n // "") as $v
      | ($v | startswith("Graphite /"))
        or $v == "label"
        or ($v | startswith("label-"))
        or $v == "cleanup-merged-branch"
        or $v == "close-merged-prs"
        or ($v | test("(?i)dependabot"));
    def is_incomplete($e):
      ((.conclusion // "") == "")
        or ((.status // "") != "" and (.status // "") != "COMPLETED");
    def rollup_entry($r; $ctx):
      ($r | map(select((.name // .context // "") == $ctx)) | .[0] // null);

    (. // []) as $r
    | if ($r | length) == 0 then "missing"
      elif any($r[]; is_failure(.conclusion)) then "failure"
      elif ($required | length) > 0 then
        if any($required[]; rollup_entry($r; .) == null) then "pending"
        elif any($required[]; rollup_entry($r; .) as $e | is_ok($e.conclusion) | not) then "pending"
        elif any($r[]; (is_external(.name // .context // "") | not) and is_incomplete(.)) then "pending"
        else "success"
        end
      elif any($r[]; (is_external(.name // .context // "") | not) and is_incomplete(.)) then "pending"
      elif ([$r[] | select(is_external(.name // .context // "") | not)] | length) == 0 then "pending"
      elif all($r[] | select(is_external(.name // .context // "") | not); is_ok(.conclusion)) then "success"
      else "pending"
      end
  ' <<<"$rollup_json"
}

ci_rollup_json_for_pr() {
  local -r pr="$1"
  local -r repo="${2:-}"

  if [[ -n "$repo" ]]; then
    gh pr view "$pr" --repo "$repo" --json statusCheckRollup --jq '.statusCheckRollup // []' 2>/dev/null \
      || printf '[]\n'
  else
    gh pr view "$pr" --json statusCheckRollup --jq '.statusCheckRollup // []' 2>/dev/null \
      || printf '[]\n'
  fi
}

ci_rollup_has_pending_or_in_progress() {
  local -r json="$1"

  jq -e '
    [ .[]?
      | (.conclusion // "")
    ]
    | any(. == "" or . == "IN_PROGRESS" or . == "QUEUED" or . == "PENDING")
  ' >/dev/null <<<"$json"
}

ci_rollup_failed_lines() {
  local -r json="$1"

  jq -r '
    [ .[]?
      | {
          name: (.name // .context // "unknown"),
          conclusion: (.conclusion // ""),
          detailsUrl: (.detailsUrl // "")
        }
      | select(.conclusion != "SUCCESS")
      | select(.conclusion != "SKIPPED")
      | select(.conclusion != "NEUTRAL")
      | select(.conclusion != "")
    ]
    | .[]
    | "\(.name)\t\(.conclusion)\t\(.detailsUrl)"
  ' <<<"$json"
}

ci_rollup_failure_details_json() {
  local -r json="$1"

  jq -c '
    [ .[]?
      | {
          name: (.name // .context // "unknown"),
          conclusion: (.conclusion // ""),
          url: (.detailsUrl // "")
        }
      | select(.conclusion != "SUCCESS")
      | select(.conclusion != "SKIPPED")
      | select(.conclusion != "NEUTRAL")
      | select(.conclusion != "")
    ]
  ' <<<"$json" 2>/dev/null || printf '[]\n'
}

ci_failure_summary_for_pr() {
  local -r pr="$1"
  local -r repo="${2:-}"
  local -r branch="${3:-}"
  local rollup first_line name conclusion url rest summary

  rollup="$(ci_rollup_json_for_pr "$pr" "$repo")"
  first_line="$(ci_rollup_failed_lines "$rollup" | head -n 1 || true)"
  if [[ -z "$first_line" ]]; then
    if [[ -n "$branch" ]]; then
      printf 'branch=%s' "$branch"
    else
      printf 'CI checks failed'
    fi
    return 0
  fi

  name="${first_line%%$'\t'*}"
  rest="${first_line#*$'\t'}"
  conclusion="${rest%%$'\t'*}"
  url="${rest#*$'\t'}"

  summary="check=${name} conclusion=${conclusion}"
  if [[ -n "$url" && "$url" != "$conclusion" ]]; then
    summary="${summary} url=${url}"
  fi
  if [[ -n "$branch" ]]; then
    summary="${summary} branch=${branch}"
  fi
  printf '%s' "$summary"
}
