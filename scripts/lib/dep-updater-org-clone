#!/usr/bin/env bash
# scripts/lib/dep-updater-org-clone — shallow GitHub org repo materialization.
set -euo pipefail

_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _lib_dir
# shellcheck disable=SC1091
source "${_lib_dir}/runner-ensure"

# dep_updater_org_clone_shallow <owner/name> <dest_dir>
# Materializes a single-branch depth-1 working clone (minimal fetch size).
# Caller must ensure dest_dir parent exists; any prior dest_dir is removed first.
dep_updater_org_clone_shallow() {
  local -r slug="$1"
  local -r dest="$2"
  local name owner

  owner="${slug%%/*}"
  name="${slug##*/}"
  if [[ -z "$owner" || -z "$name" || "$slug" != */* ]]; then
    printf 'ERROR: invalid GitHub slug: %s\n' "$slug" >&2
    return 1
  fi

  # Keep gh on the same line as runner_exec (runner-adoption ratchet).
  runner_exec "dep-updater org shallow clone ${name}" -- gh repo clone "${slug}" "$dest" -- --depth 1 --single-branch
}
