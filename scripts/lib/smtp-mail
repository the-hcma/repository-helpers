#!/usr/bin/env bash
# smtp-mail — send RFC-822 messages via SMTP (curl) for repository-helpers scripts.
#
# Configuration (environment):
#   DEP_UPDATER_SMTP_HOST       SMTP server hostname (required; localhost uses sendmail)
#   DEP_UPDATER_SMTP_PORT       Port (default: 587, or 25 for localhost)
#   DEP_UPDATER_SMTP_USER       AUTH username (optional)
#   DEP_UPDATER_SMTP_PASSWORD   AUTH password (optional)
#   DEP_UPDATER_SMTP_TLS        starttls | ssl | plain  (default: starttls, plain for localhost)
#   DEP_UPDATER_REPORT_TO       Recipient (default: johndoe@example.com when unset)
#   DEP_UPDATER_REPORT_FROM     Sender (default: dep-updater-batch@example.com when unset)
#   DEP_UPDATER_USE_SENDMAIL    1 to deliver via sendmail(1) instead of curl SMTP
#
# Test mode (no network):
#   REPO_HELPERS_TEST_MODE=1
#   REPO_HELPERS_SMTP_BREADCRUMB=/path/to/file   # written with full message body
set -euo pipefail

if declare -F repo_helpers_smtp_configured >/dev/null 2>&1; then
  return 0
fi

_smtp_mail_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _smtp_mail_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_smtp_mail_lib_dir}/runner-ensure"

# _smtp_mail_runner_exec <label> -- <cmd> [args…]
_smtp_mail_runner_exec() {
  local -r label="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local exit_code

  exit_code=0
  runner_exec "$label" -- "$@" || exit_code=$?
  return "$exit_code"
}

# repo_helpers_smtp_configured
# True when host, recipient, and sender are set.
repo_helpers_smtp_configured() {
  [[ -n "${DEP_UPDATER_SMTP_HOST:-}" ]]
}

# repo_helpers_smtp_use_sendmail
# True when mail should be handed off to the local MTA (sendmail).
repo_helpers_smtp_use_sendmail() {
  if [[ "${DEP_UPDATER_USE_SENDMAIL:-0}" == '1' ]]; then
    return 0
  fi
  case "${DEP_UPDATER_SMTP_HOST:-}" in
    localhost|127.0.0.1) return 0 ;;
    *) return 1 ;;
  esac
}

# repo_helpers_smtp_send <from_addr> <to_addr>
# Reads a complete RFC-822 message from stdin and submits it via SMTP.
repo_helpers_smtp_send() {
  local -r from_addr="$1"
  local -r to_addr="$2"
  local host port tls_mode url curl_args
  local msg_file curl_exit

  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' ]]; then
    if [[ -n "${REPO_HELPERS_SMTP_BREADCRUMB:-}" ]]; then
      cat >"${REPO_HELPERS_SMTP_BREADCRUMB}"
    else
      cat >/dev/null
    fi
    return 0
  fi

  if repo_helpers_smtp_use_sendmail; then
  # shellcheck disable=SC1091
    source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/sendmail"
    repo_helpers_sendmail "$from_addr"
    return $?
  fi

  host="${DEP_UPDATER_SMTP_HOST:?DEP_UPDATER_SMTP_HOST is required}"
  port="${DEP_UPDATER_SMTP_PORT:-587}"
  tls_mode="${DEP_UPDATER_SMTP_TLS:-starttls}"

  curl_args=(--silent --show-error --fail)
  case "$tls_mode" in
    ssl|smtps)
      url="smtps://${host}:${port}"
      ;;
    plain|none)
      url="smtp://${host}:${port}"
      ;;
    starttls|tls)
      url="smtp://${host}:${port}"
      curl_args+=(--ssl-reqd)
      ;;
    *)
      printf 'ERROR: invalid DEP_UPDATER_SMTP_TLS=%s (use starttls, ssl, or plain)\n' \
        "$tls_mode" >&2
      return 2
      ;;
  esac

  if [[ -n "${DEP_UPDATER_SMTP_USER:-}" ]]; then
    curl_args+=(--user "${DEP_UPDATER_SMTP_USER}:${DEP_UPDATER_SMTP_PASSWORD:-}")
  fi

  msg_file="$(mktemp)"
  cat >"$msg_file"

  curl_exit=0
  _smtp_mail_runner_exec "smtp-mail curl send" -- curl "${curl_args[@]}" \
    --url "$url" \
    --mail-from "$from_addr" \
    --mail-rcpt "$to_addr" \
    --upload-file "$msg_file" \
    || curl_exit=$?
  rm -f "$msg_file"
  return "$curl_exit"
}
