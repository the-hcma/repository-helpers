# shellcheck shell=bash
# github-repo-slug — resolve GitHub OWNER/NAME slugs and query visibility.
#
# Sourced by scripts/lib/repo-practices, scripts/dep-updater, and tests.
# Uses runner helpers (runner-ensure auto-begins a session when the parent script
# has not sourced runner-bootstrap).

if declare -F gh_slug_from_origin_url >/dev/null 2>&1; then
  return 0
fi

_gh_slug_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _gh_slug_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_gh_slug_lib_dir}/runner-ensure"

# gh_slug_runner_exec_stdout <label> -- <cmd> [args…]
gh_slug_runner_exec_stdout() {
  local -r label="$1"
  shift
  runner_exec_stdout "$label" "$@"
}

gh_slug_from_origin_url() {
  local remote_url="$1"
  local slug

  if [[ -z "$remote_url" ]]; then
    return 1
  fi

  case "$remote_url" in
    git@github.com:*)
      slug="${remote_url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      slug="${remote_url#ssh://git@github.com/}"
      ;;
    https://github.com/*)
      slug="${remote_url#https://github.com/}"
      ;;
    http://github.com/*)
      slug="${remote_url#http://github.com/}"
      ;;
    *)
      return 1
      ;;
  esac

  slug="${slug%.git}"
  if [[ "$slug" == */* ]]; then
    printf '%s\n' "$slug"
    return 0
  fi
  return 1
}

# _gh_slug_git_remote_url <repo_dir>
_gh_slug_git_remote_url() {
  local -r repo_dir="$1"
  local remote_url

  set +e
  remote_url="$(gh_slug_runner_exec_stdout "github-repo-slug git remote get-url origin" \
    -- git -C "$repo_dir" remote get-url origin 2>/dev/null)"
  set -e
  printf '%s' "$remote_url"
}

gh_slug_from_repo_dir() {
  local repo_dir="$1"
  local remote_url

  remote_url="$(_gh_slug_git_remote_url "$repo_dir")"
  gh_slug_from_origin_url "$remote_url"
}

# Exit 0 when the repository is private, 1 when public, 2 on gh/API error.
gh_repo_is_private() {
  local slug="$1"
  local private_flag

  set +e
  private_flag="$(gh_slug_runner_exec_stdout "github-repo-slug gh repo visibility" \
    -- gh api "repos/${slug}" --jq '.private' 2>/dev/null)"
  set -e
  case "$private_flag" in
    true) return 0 ;;
    false) return 1 ;;
    *) return 2 ;;
  esac
}
