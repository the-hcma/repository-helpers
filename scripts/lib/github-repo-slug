# shellcheck shell=bash
# github-repo-slug — resolve GitHub OWNER/NAME slugs and query visibility.
#
# Sourced by scripts/lib/repo-practices, scripts/dep-updater, and tests.

gh_slug_from_origin_url() {
  local remote_url="$1"
  local slug

  if [[ -z "$remote_url" ]]; then
    return 1
  fi

  case "$remote_url" in
    git@github.com:*)
      slug="${remote_url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      slug="${remote_url#ssh://git@github.com/}"
      ;;
    https://github.com/*)
      slug="${remote_url#https://github.com/}"
      ;;
    http://github.com/*)
      slug="${remote_url#http://github.com/}"
      ;;
    *)
      return 1
      ;;
  esac

  slug="${slug%.git}"
  if [[ "$slug" == */* ]]; then
    printf '%s\n' "$slug"
    return 0
  fi
  return 1
}

gh_slug_from_repo_dir() {
  local repo_dir="$1"
  local remote_url

  remote_url="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
  gh_slug_from_origin_url "$remote_url"
}

# Exit 0 when the repository is private, 1 when public, 2 on gh/API error.
gh_repo_is_private() {
  local slug="$1"
  local private_flag

  private_flag="$(gh api "repos/${slug}" --jq '.private' 2>/dev/null || true)"
  case "$private_flag" in
    true) return 0 ;;
    false) return 1 ;;
    *) return 2 ;;
  esac
}
