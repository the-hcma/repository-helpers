# shellcheck shell=bash
#
# Shared defaults for dependency release-age / Dependabot cooldown policy.
# dep-updater adopts versions after release_age_dep_updater_days; Dependabot
# waits one day longer so repository-helpers updates land first.
#
# Do not inline day/minute magic numbers or "N days" strings elsewhere — source
# this file and use release_age_* variables or release_age_format_days_phrase.

release_age_dep_updater_days=9
release_age_dependabot_days=10

# release_age_format_days_phrase [days]
# Prints "N days" or "1 day".
release_age_format_days_phrase() {
  local days="${1:-$release_age_dep_updater_days}"
  if (( days == 1 )); then
    printf '1 day'
  else
    printf '%s days' "$days"
  fi
}

release_age_dep_updater_days_phrase="$(release_age_format_days_phrase "$release_age_dep_updater_days")"
release_age_dep_updater_days_adjective="${release_age_dep_updater_days}-day"
release_age_dep_updater_minutes=$(( release_age_dep_updater_days * 24 * 60 ))

release_age_dependabot_days_phrase="$(release_age_format_days_phrase "$release_age_dependabot_days")"
release_age_dependabot_days_adjective="${release_age_dependabot_days}-day"
release_age_dependabot_minutes=$(( release_age_dependabot_days * 24 * 60 ))

if (( release_age_dependabot_days != release_age_dep_updater_days + 1 )); then
  printf 'release-age-defaults: dependabot days (%s) must equal dep-updater days (%s) + 1\n' \
    "$release_age_dependabot_days" "$release_age_dep_updater_days" >&2
  exit 1
fi

# shellcheck disable=SC2034  # sourced by multiple scripts/tests
readonly release_age_dep_updater_days
# shellcheck disable=SC2034
readonly release_age_dep_updater_days_phrase
# shellcheck disable=SC2034
readonly release_age_dep_updater_days_adjective
# shellcheck disable=SC2034
readonly release_age_dep_updater_minutes
# shellcheck disable=SC2034
readonly release_age_dependabot_days
# shellcheck disable=SC2034
readonly release_age_dependabot_days_phrase
# shellcheck disable=SC2034
readonly release_age_dependabot_days_adjective
# shellcheck disable=SC2034
readonly release_age_dependabot_minutes
