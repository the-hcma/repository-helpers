# shellcheck shell=bash
#
# Shared defaults for dependency release-age / Dependabot cooldown policy.
# Intended to be sourced by scripts in this repository.
#
# Do not inline day/minute magic numbers or "N days" strings elsewhere — source this
# file and use release_age_default_* variables or release_age_format_days_phrase.

release_age_default_days=10

# release_age_format_days_phrase [days]
# Prints "N days" or "1 day".
release_age_format_days_phrase() {
  local days="${1:-$release_age_default_days}"
  if (( days == 1 )); then
    printf '1 day'
  else
    printf '%s days' "$days"
  fi
}

release_age_default_days_phrase="$(release_age_format_days_phrase "$release_age_default_days")"
release_age_default_days_adjective="${release_age_default_days}-day"
release_age_default_minutes=$(( release_age_default_days * 24 * 60 ))

# shellcheck disable=SC2034  # sourced by multiple scripts/tests
readonly release_age_default_days
# shellcheck disable=SC2034
readonly release_age_default_days_phrase
# shellcheck disable=SC2034
readonly release_age_default_days_adjective
# shellcheck disable=SC2034
readonly release_age_default_minutes
