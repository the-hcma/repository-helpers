# shellcheck shell=bash
# cron-interactive-path - prepend NVM-managed Node.js bin/ to PATH for cron-like environments.
#
# NVM installs Node (and often pnpm via corepack) under ~/.nvm/versions/node/<ver>/bin,
# which login shells add automatically but cron does not.
#
# Defines: prepend_nvm_default_node_bin_for_cron
# Mutates PATH in the sourcing shell. Requires HOME.

prepend_nvm_default_node_bin_for_cron() {
  local nvm_root ver lts_file lts_name latest_ver bin_prefix

  [[ -n "${HOME:-}" ]] || return 0

  nvm_root="${HOME}/.nvm/versions/node"
  [[ -d "$nvm_root" ]] || return 0

  ver=""
  if [[ -f "${HOME}/.nvm/alias/default" ]]; then
    ver="$(tr -d '[:space:]' <"${HOME}/.nvm/alias/default" 2>/dev/null || true)"
  fi

  if [[ "$ver" == lts/* ]]; then
    lts_name="${ver#lts/}"
    lts_file="${HOME}/.nvm/alias/lts/${lts_name}"
    if [[ -f "$lts_file" ]]; then
      ver="$(tr -d '[:space:]' <"$lts_file" 2>/dev/null || true)"
    fi
  fi

  if [[ "$ver" == 'system' ]]; then
    ver=""
  fi

  bin_prefix=""
  if [[ -n "$ver" && -d "${nvm_root}/${ver}/bin" ]]; then
    bin_prefix="${nvm_root}/${ver}/bin"
  else
    latest_ver=""
    latest_ver="$(for d in "$nvm_root"/v*; do
      [[ -d "$d" ]] || continue
      printf '%s\n' "${d##*/}"
    done | sort -V 2>/dev/null | tail -1 || true)"
    if [[ -n "$latest_ver" && -d "${nvm_root}/${latest_ver}/bin" ]]; then
      bin_prefix="${nvm_root}/${latest_ver}/bin"
    fi
  fi

  if [[ -n "$bin_prefix" ]]; then
    PATH="${bin_prefix}:${PATH:-}"
  fi
}
