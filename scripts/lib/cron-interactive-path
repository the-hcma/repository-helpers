# shellcheck shell=bash
# cron-interactive-path — backward-compatible alias for tooling-path NVM helper.
#
# Prefer sourcing scripts/lib/tooling-path directly in new code.
#
# Defines: prepend_nvm_default_node_bin_for_cron (alias)

_tooling_path_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${_tooling_path_lib_dir}/tooling-path"

prepend_nvm_default_node_bin_for_cron() {
  tooling_path_prepend_nvm_default_node
}
