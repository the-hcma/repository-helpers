  local today created_at

  [[ -n "${comments_json}" && "${comments_json}" != '[]' && "${comments_json}" != 'null' ]] || return 1
  today="$(agent_review_copilot_quota_local_day)"
  while IFS= read -r created_at; do
    [[ -n "${created_at}" ]] || continue
    if agent_review_quota_timestamp_on_local_day "${created_at}" "${today}"; then
      return 0
    fi
  done < <(ar_runner_jq_file "agent-review copilot ask scan" "${comments_json}" -rs '
    [ .[]
      | .[]
      | select((.body // "") | test("@copilot[[:space:]]+please[[:space:]]+review"; "i"))
      | .created_at
    ]
    | .[]')
  return 1
}

# Fetch PR timeline events (REST paginate). Copilot credit exhaustion may appear only as
# timeline event copilot_work_finished_failure (no issue comment / review body).
# On API failure returns [].
agent_review_pr_timeline_json() {
  local -r repo="$1"
  local -r pr="$2"
  local owner name exit_code api_json

  read -r owner name < <(agent_review_repo_parts "${repo}")
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  exit_code=0
  api_json="$(ar_runner_gh_api_stream "agent-review pr timeline" \
    -H 'Accept: application/vnd.github.mockingbird-preview+json' \
    "repos/${owner}/${name}/issues/${pr}/timeline" --paginate)" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "${api_json}" ]]; then
    printf '[]\n'
    return 0
  fi
  printf '%s' "${api_json}"
}

# True when PR timeline has a copilot_work_finished_failure today from a Copilot GitHub App.
# Prints evidence URL (event fragment when id is present). Non-quota failures of this event
# type also mark exhausted for the local day — acceptable for agent-review skip caches.
agent_review_copilot_timeline_quota_failure_today() {
  local -r repo="$1"
  local -r pr="$2"
  local -r timeline_json="${3:-}"
  local today event_id created_at last_id last_at

  [[ -n "${repo}" && -n "${pr}" && -n "${timeline_json}" ]] || return 1
  today="$(agent_review_copilot_quota_local_day)"
  last_id=''
  last_at=''
  while IFS=$'\t' read -r event_id created_at; do
    [[ -n "${created_at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${created_at}" "${today}"; then
      continue
    fi
    last_id="${event_id}"
    last_at="${created_at}"
  done < <(ar_runner_jq_file "agent-review copilot timeline quota failure" "${timeline_json}" -rs '
    [
      .[]
      | .[]
      | select(.event == "copilot_work_finished_failure")
      | select((.performed_via_github_app.slug // "") | test("copilot"; "i"))
    ]
    | sort_by(.created_at // "")
    | .[]
    | [(.id | tostring), (.created_at // "")]
    | @tsv')
  [[ -n "${last_at}" ]] || return 1
  if [[ -n "${last_id}" && "${last_id}" != 'null' ]]; then
    printf 'https://github.com/%s/pull/%s#event-%s\n' "${repo}" "${pr}" "${last_id}"
  else
    printf 'https://github.com/%s/pull/%s\n' "${repo}" "${pr}"
  fi
  return 0
}

# Observe quota for one agent on the current PR head. Head reviews/checks run first so a
# successful review on this PR clears stale exhaustion cached from other PRs. Returns 0 when
# the daily cache was updated.
agent_review_quota_observe_agent_on_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="$4"
  local -r comments_json="$5"
  local agent_id review_body run_json reason evidence_url retry_after submitted_at signal
  local timeline_json copilot_ask_outstanding comment_body_probe _created_at

  agent_id="${agent_review_profile_id:-}"
  [[ -n "${agent_id}" ]] || return 1
  copilot_ask_outstanding=0
  comment_body_probe=''
  _created_at=''

  if [[ "${agent_id}" == 'copilot' ]] \
    && declare -F agent_review_copilot_success_issue_comment_for_head >/dev/null 2>&1; then
    review_body="$(agent_review_copilot_success_issue_comment_for_head "${comments_json}" "${head}")"
    if [[ -n "${review_body}" ]]; then
      reason="Copilot issue comment on ${repo}#${pr} head ${head:0:7} confirms quota available."
      evidence_url="$(agent_review_copilot_success_issue_comment_url_for_head "${comments_json}" "${head}" || true)"
      agent_review_quota_mark_confirmed_for_agent copilot "${reason}" "${evidence_url}"
      return 0
    fi
  fi

  if [[ -n "${snapshot}" ]] \
    && agent_review_head_has_actionable_agent_review_on_head "${snapshot}" "${head}"; then
    reason="${agent_id} actionable review on ${repo}#${pr} head ${head:0:7} confirms quota available."
    evidence_url="$(agent_review_actionable_review_url_on_head "${snapshot}" "${head}" || true)"
    agent_review_quota_mark_confirmed_for_agent "${agent_id}" "${reason}" "${evidence_url}"
    return 0
  fi

  if [[ -n "${snapshot}" ]] && agent_review_fresh_agent_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    review_body="$(agent_review_latest_nonempty_agent_review_body_on_head "${snapshot}" "${head}")"
    if [[ -z "${review_body}" ]] \
      && declare -F agent_review_profile_latest_review_body_on_head >/dev/null 2>&1; then
      review_body="$(agent_review_profile_latest_review_body_on_head \
        "${snapshot}" "${head}" "${repo}" "${pr}")"
    fi
    if [[ -n "${review_body}" ]] \
      && agent_review_profile_review_is_quota_exhausted "${review_body}"; then
      reason="${agent_id} review on ${repo}#${pr} head ${head:0:7} reports quota exhaustion."
      evidence_url="$(agent_review_quota_exhaustion_review_url_on_head "${snapshot}" "${head}" || true)"
      retry_after=''
      submitted_at="$(agent_review_latest_agent_review_submitted_at_on_head "${snapshot}" "${head}" || true)"
      if [[ -n "${submitted_at}" ]] \
        && declare -F agent_review_profile_text_quota_retry_after_iso >/dev/null; then
        retry_after="$(agent_review_profile_text_quota_retry_after_iso "${review_body}" "${submitted_at}" || true)"
      fi
      if [[ -z "${retry_after}" ]] \
        && [[ -n "${comments_json}" ]] \
        && declare -F agent_review_profile_text_quota_retry_after_iso >/dev/null; then
        signal="$(agent_review_quota_exhaustion_issue_comment_signal_today "${comments_json}" || true)"
        if [[ -n "${signal}" ]]; then
          if [[ -z "${evidence_url}" ]]; then
            evidence_url="${signal%%$'\t'*}"
          fi
          retry_after="${signal#*$'\t'}"
          if [[ "${retry_after}" == "${signal}" ]]; then
            retry_after=''
          fi
        fi
      fi
      agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}" "${evidence_url}" "${retry_after}"
      return 0
    fi
    reason="${agent_id} review on ${repo}#${pr} head ${head:0:7} confirms quota available."
    evidence_url="$(agent_review_latest_agent_review_url_on_head "${snapshot}" "${head}" || true)"
    agent_review_quota_mark_confirmed_for_agent "${agent_id}" "${reason}" "${evidence_url}"
    return 0
  fi

  if [[ -n "${snapshot}" && "${agent_review_profile_uses_head_check:-false}" == 'true' ]]; then
    run_json="$(agent_review_head_check_run_json_for_head "${repo}" "${head}")"
    if [[ -n "${run_json}" && "${run_json}" != 'null' ]] \
      && agent_review_profile_head_check_is_quota_exhausted "${run_json}"; then
      reason="${agent_id} check on ${repo}#${pr} head ${head:0:7} reports quota or usage limit."
      evidence_url="$(agent_review_head_check_evidence_url "${run_json}" || true)"
      agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}" "${evidence_url}"
      return 0
    fi
    if [[ -n "${run_json}" && "${run_json}" != 'null' ]] \
      && declare -F agent_review_profile_head_check_is_complete >/dev/null 2>&1 \
      && agent_review_profile_head_check_is_complete "${run_json}" \
      && ! agent_review_profile_head_check_is_quota_exhausted "${run_json}"; then
      reason="${agent_id} check on ${repo}#${pr} head ${head:0:7} confirms usage available."
      evidence_url="$(agent_review_head_check_evidence_url "${run_json}" || true)"
      agent_review_quota_mark_confirmed_for_agent "${agent_id}" "${reason}" "${evidence_url}"
      return 0
    fi
  fi

  if agent_review_pr_has_quota_issue_comment_today "${repo}" "${pr}" "${comments_json}"; then
    reason="${agent_id} billing comment on ${repo}#${pr} reports quota or usage limit."
    signal="$(agent_review_quota_exhaustion_issue_comment_signal_today "${comments_json}" || true)"
    evidence_url="${signal%%$'\t'*}"
    retry_after="${signal#*$'\t'}"
    if [[ "${retry_after}" == "${signal}" ]]; then
      retry_after=''
    fi
    if [[ "${agent_id}" == 'bugbot' ]]; then
      # Same -rs / .[]|.[] scan as has_quota_issue_comment_today (paginated REST pages).
      while IFS=$'\t' read -r _created_at comment_body_probe; do
        [[ -n "${comment_body_probe}" ]] || continue
        if agent_review_bugbot_quota_text_is_repo_disabled "${comment_body_probe}"; then
          reason="Bugbot comment on ${repo}#${pr} reports disabled for this repository."
          agent_review_bugbot_quota_mark_repo_disabled "${repo}" "${reason}" "${evidence_url}"
          return 0
        fi
        if [[ "${comment_body_probe,,}" == *"disabled"* ]] \
          || [[ "${comment_body_probe,,}" == *"not enabled"* ]]; then
          reason="Bugbot comment on ${repo}#${pr} reports disabled for your account."
          break
        fi
      done < <(ar_runner_jq_file "agent-review bugbot disabled body" "${comments_json}" -rs \
        --arg re "${agent_review_profile_request_login_regex}" '
          [ .[] | .[] | select((.user.login // "") | test($re;"i")) ]
          | .[]
          | [.created_at, (.body // "")]
          | @tsv' 2>/dev/null || true)
    fi
    agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}" "${evidence_url}" "${retry_after}"
    return 0
  fi

  # Copilot may exhaust credits with only a timeline event (no comment/review body).
  # Non-quota copilot_work_finished_failure events also mark exhausted for today.
  # Do not skip on "confirmed" — a later @copilot ask the same day can still fail
  # with copilot_work_finished_failure (repository-helpers#368).
  # While probe_requested is set, or an @copilot ask / agent_requested is visible on
  # this PR, keep re-scanning: failure can land after an earlier empty timeline probe
  # (repository-helpers#415). Negative timeline_probed is scoped to OWNER/NAME#N;
  # stale probe_requested expires after AGENT_REVIEW_PROBE_REQUESTED_TTL (#408).
  if [[ "${agent_id}" == 'copilot' ]]; then
    if agent_review_agent_quota_exhausted_for_agent copilot; then
      return 1
    fi
    agent_review_copilot_quota_refresh_for_today || true
    agent_review_copilot_quota_expire_stale_probe_requested || true
    if [[ "${agent_review_copilot_quota_probe_requested_today:-0}" == '1' ]] \
      || agent_review_copilot_pr_has_review_ask_today "${comments_json}" \
      || { [[ -n "${snapshot}" ]] \
        && agent_review_agent_requested_from_snapshot "${snapshot}"; }; then
      copilot_ask_outstanding=1
    fi
    if agent_review_copilot_timeline_probed_for_pr_today "${repo}#${pr}" \
      && [[ "${copilot_ask_outstanding}" != '1' ]]; then
      return 1
    fi
    timeline_json="$(agent_review_pr_timeline_json "${repo}" "${pr}")"
    evidence_url=''
    if evidence_url="$(agent_review_copilot_timeline_quota_failure_today \
      "${repo}" "${pr}" "${timeline_json}")"; then
      reason="Copilot timeline event copilot_work_finished_failure on ${repo}#${pr} (credits or work failure; treated as quota exhausted for today)."
      agent_review_quota_mark_exhausted_for_agent copilot "${reason}" "${evidence_url}"
      return 0
    fi
    # Negative probe only when no ask is outstanding (otherwise recheck next loop).
    if [[ "${copilot_ask_outstanding}" != '1' ]]; then
      agent_review_copilot_quota_mark_timeline_probed \
        "Copilot timeline on ${repo}#${pr} had no same-day copilot_work_finished_failure." \
        "${repo}#${pr}"
    fi
  fi

  return 1
}

# Scan Copilot, Bugbot, and CodeRabbit quota signals on the current PR head and persist
# exhaustion for the local calendar day (source=observed). Returns 0 when any agent was
# newly marked exhausted.
agent_review_observe_all_agent_quota_on_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="${4:-}"
  local saved_agent agent profiles_dir profile_path comments_json
  local observed=0

  [[ -n "${repo}" && -n "${pr}" && -n "${head}" ]] || return 1
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    profile_path="${profiles_dir}/${agent}"
    if [[ ! -f "${profile_path}" ]]; then
      continue
    fi
    agent_review_use_agent "${agent}"
    if agent_review_quota_observe_agent_on_pr \
      "${repo}" "${pr}" "${head}" "${snapshot}" "${comments_json}"; then
      observed=1
    fi
  done < <(agent_review_cycle_quota_agent_ids)
  agent_review_use_agent "${saved_agent}"
  if (( observed > 0 )); then
    return 0
  fi
  return 1
}
