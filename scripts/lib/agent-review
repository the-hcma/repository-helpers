# Exit 3 with triage JSON when review threads still need a reply or resolve; else 0.
agent_review_abort_if_pending_threads() {
  local -r repo="$1"
  local -r pr="$2"
  local owner name snapshot pending_count triage_json

  read -r owner name < <(agent_review_repo_parts "${repo}")
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  pending_count="$(agent_review_pending_thread_count_from_snapshot "${snapshot}")"
  if (( pending_count == 0 )); then
    return 0
  fi
  triage_json="$(agent_review_triage_threads_json_from_snapshot "${snapshot}")"
  printf 'wait-for-agent-review: %s review thread(s) still need a reply or resolve before give-up\n' \
    "${pending_count}" >&2
  printf '%s\n' "${triage_json}"
  return 3
}

