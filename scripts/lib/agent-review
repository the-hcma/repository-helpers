# Drop agent-product checks from the rollup used for required-CI gating.
# CodeRabbit / Bugbot are tracked separately (waiting agents / workflow pending).
agent_review_ci_rollup_for_gating() {
  local -r rollup="$1"

  agent_review_load_ci_rollup_lib
  ci_rollup_without_agent_product_checks "${rollup}"
}

# Exit 0 when required CI is green, 1 when failed, 2 when pending/in progress.
agent_review_ci_check_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest conclusion

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  rollup="$(agent_review_ci_rollup_for_gating "${rollup}")"
  if ci_rollup_has_pending_or_in_progress "$rollup"; then
    return 2
  fi
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  conclusion="$(ci_rollup_conclusion_for_gating "${latest}" "")"
  case "${conclusion}" in
    success) return 0 ;;
    failure) return 1 ;;
    *) return 2 ;;
  esac
}

agent_review_ci_status_json_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest conclusion failures ready pending

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  rollup="$(agent_review_ci_rollup_for_gating "${rollup}")"
  pending=false
  if ci_rollup_has_pending_or_in_progress "$rollup"; then
    pending=true
  fi
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  conclusion="$(ci_rollup_conclusion_for_gating "${latest}" "")"
  if [[ "${pending}" == 'true' && "${conclusion}" != 'failure' ]]; then
    conclusion='pending'
  fi
  failures="$(ci_rollup_failure_details_json "${latest}")"
  ready=false
  if [[ "${conclusion}" == 'success' ]]; then
    ready=true
  fi
  ar_runner_jq_n "agent-review ci status json" \
    --arg conclusion "${conclusion}" \
    --argjson failures "${failures}" \
    --argjson ci_ready "${ready}" \
    '{ci_conclusion: $conclusion, ci_failures: $failures, ci_ready: $ci_ready}'
}

agent_review_print_ci_failures() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest line

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  printf 'wait-for-agent-review: CI failed on PR #%s — coding agent must retrieve logs, fix, push, and resume loop\n' \
    "${pr}" >&2
  printf 'wait-for-agent-review: escalate to a human only if a fix cannot be identified\n' >&2
  printf 'wait-for-agent-review: tip: scripts/dev/post-pr-submission-checks --pr %s\n' "${pr}" >&2
  while IFS= read -r line || [[ -n "${line}" ]]; do
    printf '  %s\n' "${line}" >&2
  done < <(ci_rollup_failed_lines "${latest}" | head -n 20)
}

# True when copilot, bugbot, or coderabbit delivered a recognized pass (no actionable
# feedback) on head — a real agent sign-off, not a rate-limit stub or bare commit status.
agent_review_delivered_recognized_pass_on_head() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local saved_agent agent review_body check_state_json clean

  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  for agent in copilot bugbot coderabbit; do
    agent_review_use_agent "${agent}"
    if [[ "${agent_review_profile_uses_head_check:-false}" == 'true' ]]; then
      if agent_review_head_check_complete_on_head "${repo}" "${head}"; then
        check_state_json="$(agent_review_head_check_state_json "${repo}" "${head}")"
        clean="$(ar_runner_jq_file "agent-review signed-off head check clean" \
          "${check_state_json}" -r '.clean')"
        if [[ "${clean}" == 'true' ]]; then
          agent_review_use_agent "${saved_agent}"
          return 0
        fi
      fi
      continue
    fi
    if ! declare -F agent_review_profile_fresh_on_head >/dev/null 2>&1; then
      continue
    fi
    if ! agent_review_profile_fresh_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
      continue
    fi
    review_body=""
    if declare -F agent_review_profile_latest_review_body_on_head >/dev/null 2>&1; then
      review_body="$(agent_review_profile_latest_review_body_on_head \
        "${snapshot}" "${head}" "${repo}" "${pr}")"
    fi
    if [[ -n "${review_body}" ]] \
      && agent_review_profile_review_is_empty "${review_body}"; then
      agent_review_use_agent "${saved_agent}"
      return 0
    fi
  done
  agent_review_use_agent "${saved_agent}"
  return 1
}

# Alias: at least one agent signed off on this head (same as recognized pass).
agent_review_agent_signed_off_on_head() {
  agent_review_delivered_recognized_pass_on_head "$@"
}

# True when the active agent's daily quota is exhausted and waiting would be futile.
agent_review_skip_wait_for_quota_exhausted_agent() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local check_state_json complete agent_id

  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  if ! agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    return 1
  fi
  if [[ "${agent_review_profile_uses_head_check}" == 'true' ]]; then
    check_state_json="$(agent_review_head_check_state_json "${repo}" "${head}")"
    complete="$(ar_runner_jq_file "agent-review skip wait head check complete" "${check_state_json}" -r '.complete')"
    if [[ "${complete}" == 'true' ]]; then
      return 1
    fi
    return 0
  fi
  if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
    return 1
  fi
  return 0
}

# Ordered unique agent ids: preferred profile, then AGENT_REVIEW_QUOTA_FALLBACK_CHAIN entries.
agent_review_requestable_agent_candidates() {
  local -r preferred="${1:-${AGENT_REVIEW_AGENT:-copilot}}"
  local agents=() agent i

  agents+=("${preferred}")
  i=0
  while agent="$(agent_review_quota_fallback_agent_at "${i}" 2>/dev/null)"; do
    agents+=("${agent}")
    i=$(( i + 1 ))
  done

  declare -A seen=()
  for agent in "${agents[@]}"; do
    if [[ -z "${seen[${agent}]:-}" ]]; then
      seen["${agent}"]=1
      printf '%s\n' "${agent}"
    fi
  done
}

# Activate the first profile in quota escalation order that is not cached exhausted
# today (coderabbit → copilot → bugbot). Returns 1 when all are exhausted.
agent_review_activate_first_requestable_agent() {
  local profiles_dir profile_path agent current

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  current="${AGENT_REVIEW_AGENT:-copilot}"
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    profile_path="${profiles_dir}/${agent}"
    if [[ ! -f "${profile_path}" ]]; then
      continue
    fi
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      printf 'wait-for-agent-review: skipping %s — daily quota exhausted (will not request)\n' \
        "${agent}" >&2
      continue
    fi
    if [[ "${agent}" != "${current}" ]]; then
      agent_review_use_agent "${agent}"
      printf 'wait-for-agent-review: using %s (quota escalation)\n' "${agent}" >&2
    fi
    printf '%s\n' "${agent}"
    return 0
  done < <(agent_review_quota_escalation_agent_ids)
  return 1
}

# Align AGENT_REVIEW_AGENT with the single probe agent for today (escalation order).
agent_review_sync_active_probe_agent() {
  local agent current

  current="${AGENT_REVIEW_AGENT:-copilot}"
  if ! agent="$(agent_review_quota_probe_agent_for_today 2>/dev/null)"; then
    return 1
