# Human-readable quota summary for operator emails (copilot/bugbot/coderabbit).
# Optional args: <repo> <pr> — when set, cross-PR evidence URLs are labeled clearly.
agent_review_quota_summary_for_email() {
  local repo="${1:-}"
  local pr="${2:-}"
  local agent status reason evidence_url retry_after parts=()
  local evidence_label current_slug

  current_slug=''
  if [[ -n "${repo}" && -n "${pr}" ]]; then
    current_slug="${repo}#${pr}"
  fi

  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    reason=''
    evidence_url=''
    retry_after=''
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      retry_after="$(agent_review_agent_quota_cache_retry_after_for_agent "${agent}")"
      if [[ -n "${retry_after}" ]]; then
        status="rate-limited until ${retry_after}"
      else
        status='exhausted (not waiting)'
      fi
      reason="$(agent_review_agent_quota_cache_reason_for_agent "${agent}")"
      evidence_url="$(agent_review_agent_quota_cache_evidence_url_for_agent "${agent}")"
    elif agent_review_agent_quota_confirmed_for_agent "${agent}"; then
      status='available (reviewed today)'
      reason="$(agent_review_agent_quota_cache_reason_for_agent "${agent}")"
      evidence_url="$(agent_review_agent_quota_cache_evidence_url_for_agent "${agent}")"
    elif agent_review_agent_quota_probe_requested_for_agent "${agent}"; then
      status='probe requested (awaiting review)'
    elif agent_review_agent_quota_probe_expired_for_agent "${agent}"; then
      status='probe expired (no review within TTL)'
      reason="$(agent_review_agent_quota_cache_reason_for_agent "${agent}")"
    else
      status='unconfirmed (not probed today)'
    fi
    if [[ -n "${reason}" ]]; then
      parts+=("${agent}: ${status} — ${reason}")
    else
      parts+=("${agent}: ${status}")
    fi
    if [[ -n "${evidence_url}" ]]; then
      evidence_label='source'
      if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
        evidence_label='evidence'
      fi
      # evidence is "current PR" only when URL contains /${repo}/pull/${pr} or /${repo}/pulls/${pr}
      if [[ -n "${current_slug}" ]] \
        && [[ "${evidence_url}" != *"/${repo}/pull/${pr}"* ]] \
        && [[ "${evidence_url}" != *"/${repo}/pulls/${pr}"* ]]; then
        parts+=("  ${evidence_label} (confirmed via probe on other PR): ${evidence_url}")
      else
        parts+=("  ${evidence_label}: ${evidence_url}")
      fi
    fi
  done < <(agent_review_cycle_quota_agent_ids)
  (IFS=$'\n'; printf '%s' "${parts[*]}")
}

# Prints html_url and optional retry-after (tab-separated) for the latest quota-exhaustion
# issue comment from the active profile today.
# Prefer comment updated_at (fall back to created_at) for the local-day filter and retry_after
# anchor so edited rate-limit comments recompute from the latest timestamp (issue #366).
agent_review_quota_exhaustion_issue_comment_signal_today() {
  local -r comments_json="$1"
  local today anchor_at body login url match_url match_retry retry_after

  if [[ -z "${agent_review_profile_request_login_regex:-}" ]] \
    || [[ -z "${comments_json}" ]]; then
    return 1
  fi
  today="$(agent_review_copilot_quota_local_day)"
  match_url=''
  match_retry=''
  if declare -F agent_review_profile_issue_comment_is_quota_exhausted >/dev/null; then
    while IFS=$'\t' read -r anchor_at body login url; do
      [[ -n "${anchor_at}" ]] || continue
      if ! agent_review_quota_timestamp_on_local_day "${anchor_at}" "${today}"; then
        continue
      fi
      if agent_review_profile_issue_comment_is_quota_exhausted "${login}" "${body}"; then
        match_url="${url}"
        retry_after=''
        if declare -F agent_review_profile_text_quota_retry_after_iso >/dev/null; then
          retry_after="$(agent_review_profile_text_quota_retry_after_iso "${body}" "${anchor_at}" || true)"
        fi
        match_retry="${retry_after}"
      fi
    done < <(ar_runner_jq_file "agent-review quota exhaustion comment signal scan" "${comments_json}" -rs '
        [ .[] | .[]
          | [(.updated_at // .created_at), (.body // ""), (.user.login // ""), (.html_url // "")] ]
        | .[]
        | @tsv')
  else
    while IFS=$'\t' read -r anchor_at body url; do
      [[ -n "${anchor_at}" ]] || continue
      if ! agent_review_quota_timestamp_on_local_day "${anchor_at}" "${today}"; then
        continue
      fi
      if agent_review_profile_text_is_quota_exhausted "${body}"; then
        match_url="${url}"
        retry_after=''
        if declare -F agent_review_profile_text_quota_retry_after_iso >/dev/null; then
          retry_after="$(agent_review_profile_text_quota_retry_after_iso "${body}" "${anchor_at}" || true)"
        fi
        match_retry="${retry_after}"
      fi
    done < <(ar_runner_jq_file "agent-review quota exhaustion comment signal scan" "${comments_json}" -rs \
      --arg re "${agent_review_profile_request_login_regex}" '
      [ .[] | .[] | select((.user.login // "") | test($re;"i")) ]
      | .[]
      | [(.updated_at // .created_at), (.body // ""), (.html_url // "")]
      | @tsv')
  fi
  if [[ -n "${match_url}" ]]; then
    printf '%s\t%s' "${match_url}" "${match_retry}"
    return 0
  fi
  return 1
}

