  local request_visible wait_reason

  agent_review_assert_reviews_complete "${snapshot}"
  head="$(ar_runner_jq_file "agent-review status head sha" "${snapshot}" -r '.data.repository.pullRequest.headRefOid')"
  head_check_state="$(agent_review_head_check_state_json "${repo}" "${head}")"
  head_check_clean="$(ar_runner_jq_file "agent-review status head check clean" "${head_check_state}" -r '.clean')"
  head_check_findings="$(ar_runner_jq_file "agent-review status head check findings" "${head_check_state}" -r '.findings')"
  head_check_error="$(ar_runner_jq_file "agent-review status head check error" "${head_check_state}" -r '.error')"
  head_check_quota="$(ar_runner_jq_file "agent-review status head check quota" "${head_check_state}" -r '.quota')"
  head_check_conclusion="$(ar_runner_jq_file "agent-review status head check conclusion" "${head_check_state}" -r '.conclusion')"
  if agent_review_agent_requested_from_snapshot "${snapshot}"; then
    requested=true
  else
    requested=false
  fi
  if agent_review_profile_request_is_visible; then
    request_visible="${requested}"
  else
    request_visible=false
  fi
  if agent_review_fresh_agent_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    fresh=true
    if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
      review_body="$(agent_review_latest_agent_review_body_on_head "${snapshot}" "${head}")"
      if [[ -z "${review_body}" ]] \
        && declare -F agent_review_profile_latest_review_body_on_head >/dev/null 2>&1; then
        review_body="$(agent_review_profile_latest_review_body_on_head \
          "${snapshot}" "${head}" "${repo}" "${pr}")"
      fi
    elif declare -F agent_review_profile_latest_review_body_on_head >/dev/null 2>&1; then
      review_body="$(agent_review_profile_latest_review_body_on_head \
        "${snapshot}" "${head}" "${repo}" "${pr}")"
    else
      review_body=""
    fi
  else
    fresh=false
    review_body=""
  fi
  # shellcheck disable=SC2154  # agent_review_bot_login_regex is set by agent_review_open_bot_thread_count caller context
  open="$(agent_review_open_bot_thread_count "${snapshot}")"
  threads_json="$(agent_review_threads_json_from_snapshot "${snapshot}")"
  unaddressed="$(ar_runner_jq_file "agent-review status unaddressed count" "${threads_json}" 'length')"
  human_open_json="$(agent_review_human_open_threads_json_from_snapshot "${snapshot}")"
  open_human="$(ar_runner_jq_file "agent-review status open human count" "${human_open_json}" 'length')"
  human_threads_json="$(agent_review_human_threads_json_from_snapshot "${snapshot}")"
  unaddressed_human="$(ar_runner_jq_file "agent-review status unaddressed human count" "${human_threads_json}" 'length')"
  needs_resolve_agent_json="$(agent_review_agent_threads_needs_resolve_json_from_snapshot "${snapshot}")"
  needs_resolve_agent="$(ar_runner_jq_file "agent-review status agent needs resolve count" "${needs_resolve_agent_json}" 'length')"
  needs_resolve_human_json="$(agent_review_human_threads_needs_resolve_json_from_snapshot "${snapshot}")"
  needs_resolve_human="$(ar_runner_jq_file "agent-review status human needs resolve count" "${needs_resolve_human_json}" 'length')"
  open_all="$(agent_review_open_thread_count_from_snapshot "${snapshot}")"
  pending_all="$(agent_review_pending_thread_count_from_snapshot "${snapshot}")"
  ci_json="$(agent_review_ci_status_json_for_pr "${repo}" "${pr}")"
  ci_conclusion="$(ar_runner_jq_file "agent-review status ci conclusion" "${ci_json}" -r '.ci_conclusion')"
  ci_ready="$(ar_runner_jq_file "agent-review status ci ready" "${ci_json}" -r '.ci_ready')"
  ci_failures="$(ar_runner_jq_file "agent-review status ci failures" "${ci_json}" -c '.ci_failures')"
  if agent_review_all_quotas_exhausted; then
    all_quotas_exhausted=true
  else
    all_quotas_exhausted=false
  fi
  if agent_review_profile_review_is_empty "${review_body}"; then
    agent_review_empty=true
  elif [[ "${head_check_clean}" == 'true' ]] && (( unaddressed == 0 )); then
    agent_review_empty=true
  else
    agent_review_empty=false
  fi
  if [[ "${fresh}" == 'true' ]] \
    && agent_review_profile_review_is_quota_exhausted "${review_body}"; then
    agent_quota_exhausted=true
  elif [[ "${head_check_quota}" == 'true' ]]; then
    agent_quota_exhausted=true
  else
    agent_quota_exhausted=false
  fi
  merge_json="$(agent_review_pr_merge_json "${repo}" "${pr}")"
  pr_state="$(ar_runner_jq_file "agent-review status pr state" "${merge_json}" -r '.state')"
  if [[ "${pr_state}" == 'MERGED' ]]; then
    pr_merged=true
  else
    pr_merged=false
  fi
  merge_state="$(ar_runner_jq_file "agent-review status merge state" "${merge_json}" -r '.mergeStateStatus')"
  mergeable="$(ar_runner_jq_file "agent-review status mergeable" "${merge_json}" -r '.mergeable')"
  if agent_review_merge_state_ready "${merge_state}"; then
    merge_ready=true
  else
    merge_ready=false
  fi
  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  if [[ "${pr_merged}" == 'true' ]] || [[ "${fresh}" == 'true' ]]; then
    wait_reason=""
  elif ! agent_review_profile_request_is_visible; then
    wait_reason="polling_for_review_on_head (agent requests may not appear as pending reviewers on GitHub)"
  else
    wait_reason="no_fresh_agent_review_on_head"
  fi
  if [[ "${pr_merged}" == 'true' ]] \
    || { [[ "${fresh}" == 'true' ]] \
      && [[ "${ci_ready}" == 'true' ]] \
      && [[ "${pending_all}" -eq 0 ]] \
      && [[ "${open_all}" -eq 0 ]] \
      && [[ "${merge_ready}" == 'true' ]] \
      && [[ "${agent_review_empty}" == 'true' ]]; }; then
    complete_ready=true
  else
    complete_ready=false
  fi
  head_check_complete_json="$(ar_runner_jq_file "agent-review status head check complete" "${head_check_state}" -c '.complete')"
  ar_runner_jq_n "agent-review status json" \
    --arg pr "${pr}" \
    --arg repo "${repo}" \
    --arg head "${head}" \
    --arg merge_state_status "${merge_state}" \
    --arg pr_state "${pr_state}" \
    --arg mergeable "${mergeable}" \
    --arg agent_id "${agent_id}" \
    --arg wait_reason "${wait_reason}" \
    --argjson merge_ready "${merge_ready}" \
    --argjson pr_merged "${pr_merged}" \
    --argjson requested "${requested}" \
    --argjson agent_request_visible "${request_visible}" \
    --argjson fresh_review_on_head "${fresh}" \
    --argjson agent_review_empty "${agent_review_empty}" \
    --argjson agent_quota_exhausted "${agent_quota_exhausted}" \
    --argjson open_agent_threads "${open}" \
    --argjson unaddressed_agent_threads "${unaddressed}" \
    --argjson open_human_threads "${open_human}" \
    --argjson unaddressed_human_threads "${unaddressed_human}" \
    --argjson agent_threads_needs_resolve "${needs_resolve_agent}" \
    --argjson human_threads_needs_resolve "${needs_resolve_human}" \
    --argjson open_threads "${open_all}" \
    --argjson pending_threads "${pending_all}" \
    --arg ci_conclusion "${ci_conclusion}" \
    --argjson ci_ready "${ci_ready}" \
    --argjson ci_failures "${ci_failures}" \
    --argjson all_quotas_exhausted "${all_quotas_exhausted}" \
    --argjson complete_ready "${complete_ready}" \
    --argjson head_check_clean "${head_check_clean}" \
    --argjson head_check_findings "${head_check_findings}" \
    --argjson head_check_error "${head_check_error}" \
    --argjson head_check_quota "${head_check_quota}" \
    --arg head_check_conclusion "${head_check_conclusion}" \
    --argjson head_check "${head_check_complete_json}" \
    '{
      pr: ($pr | tonumber),
      repo: $repo,
      agent: $agent_id,
      head_sha: $head,
      pr_state: $pr_state,
      pr_merged: $pr_merged,
      merge_state_status: $merge_state_status,
      mergeable: $mergeable,
      merge_ready: $merge_ready,
      agent_requested: $requested,
      agent_request_visible: $agent_request_visible,
      fresh_review_on_head: $fresh_review_on_head,
      agent_review_empty: $agent_review_empty,
      agent_quota_exhausted: $agent_quota_exhausted,
      open_agent_threads: $open_agent_threads,
      unaddressed_agent_threads: $unaddressed_agent_threads,
      open_human_threads: $open_human_threads,
      unaddressed_human_threads: $unaddressed_human_threads,
      agent_threads_needs_resolve: $agent_threads_needs_resolve,
      human_threads_needs_resolve: $human_threads_needs_resolve,
      open_threads: $open_threads,
      pending_threads: $pending_threads,
      ci_conclusion: $ci_conclusion,
      ci_ready: $ci_ready,
      ci_failures: $ci_failures,
      all_quotas_exhausted: $all_quotas_exhausted,
      complete_ready: $complete_ready,
      head_check_complete: $head_check,
      head_check_conclusion: $head_check_conclusion,
      head_check_clean: $head_check_clean,
      head_check_findings: $head_check_findings,
      head_check_error: $head_check_error,
      head_check_quota: $head_check_quota,
      wait_reason: (if $wait_reason == "" then null else $wait_reason end),
      pending: (($pr_merged | not) and ($fresh_review_on_head | not))
    }'
}

agent_review_resolve_thread_id() {
  local -r thread_id="$1"
  local force="${2:-0}"

  if [[ "${force}" != '1' ]]; then
    agent_review_assert_thread_has_human_reply "${thread_id}"
  fi

  # shellcheck disable=SC2016  # GraphQL mutation uses single-quoted $variables
  ar_runner_gh_api_stream "agent-review resolve thread" graphql -f query='
mutation($id:ID!) {
  resolveReviewThread(input:{threadId:$id}) {
    thread { isResolved }
  }
}' -f id="${thread_id}" >/dev/null
}

agent_review_reply_thread_id() {
  local -r thread_id="$1"
  local -r body="$2"
  local reply_json reply_url

  if [[ -z "${body}" ]]; then
    agent_review_die 'reply-thread requires non-empty --body'
  fi

  # shellcheck disable=SC2016  # GraphQL mutation uses single-quoted $variables
  reply_json="$(ar_runner_gh_api_stream "agent-review reply thread" graphql -f query='
mutation($threadId:ID!, $body:String!) {
  addPullRequestReviewThreadReply(input:{pullRequestReviewThreadId:$threadId, body:$body}) {
    comment { id url }
  }
}' -f threadId="${thread_id}" -f body="${body}")"
  reply_url="$(ar_runner_jq_file "agent-review reply thread url" "${reply_json}" \
    -r '.data.addPullRequestReviewThreadReply.comment.url // empty')"
  if [[ -n "${reply_url}" ]]; then
    printf 'Replied on thread %s (%s)\n' "${thread_id}" "${reply_url}" >&2
  else
    printf 'Replied on thread %s\n' "${thread_id}" >&2
  fi
}

agent_review_authenticated_login() {
  local login

  login="$(ar_runner_gh_api_stream "agent-review authenticated login" user --jq '.login')"
  if [[ -z "${login}" ]]; then
    agent_review_die 'could not determine authenticated GitHub login (run gh auth login)'
  fi
  printf '%s' "${login}"
}

agent_review_thread_has_human_reply() {
  local -r thread_id="$1"
  local thread_json has_reply viewer_login

  viewer_login="$(agent_review_authenticated_login)"
  # shellcheck disable=SC2016  # GraphQL query uses single-quoted $variables
  thread_json="$(ar_runner_gh_api_stream "agent-review thread human reply check" graphql -f query='
query($id:ID!) {
  node(id:$id) {
    ... on PullRequestReviewThread {
      comments(first:100) {
        nodes { author { __typename login } }
      }
    }
  }
}' -f id="${thread_id}")"
  has_reply="$(ar_runner_jq_file "agent-review thread has human reply" "${thread_json}" \
    --arg login "${viewer_login}" \
    -r '[.data.node.comments.nodes[1:][] | select(.author.__typename == "User" and .author.login == $login)] | length > 0')"
  [[ "${has_reply}" == 'true' ]]
}

agent_review_assert_thread_has_human_reply() {
  local -r thread_id="$1"

  if ! agent_review_thread_has_human_reply "${thread_id}"; then
    agent_review_die "thread ${thread_id} has no on-thread human reply — run reply-thread before resolve-thread"
  fi
}

# shellcheck disable=SC1091  # quota helpers sourced at runtime from scripts/lib
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agent-review-quota"

agent_review_ci_rollup_lib_loaded=false

agent_review_load_ci_rollup_lib() {
  if [[ "${agent_review_ci_rollup_lib_loaded}" == 'true' ]]; then
    return 0
  fi
  local lib_dir
  lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck disable=SC1091  # shared rollup helper sourced at runtime from scripts/lib
  source "${lib_dir}/ci-check-rollup"
  agent_review_ci_rollup_lib_loaded=true
}

# Exit 0 when required CI is green, 1 when failed, 2 when pending/in progress.
agent_review_ci_check_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest conclusion

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  if ci_rollup_has_pending_or_in_progress "$rollup"; then
    return 2
  fi
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  conclusion="$(ci_rollup_conclusion_for_gating "${latest}" "")"
  case "${conclusion}" in
    success) return 0 ;;
    failure) return 1 ;;
    *) return 2 ;;
  esac
}

agent_review_ci_status_json_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest conclusion failures ready pending

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  pending=false
  if ci_rollup_has_pending_or_in_progress "$rollup"; then
    pending=true
  fi
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  conclusion="$(ci_rollup_conclusion_for_gating "${latest}" "")"
  if [[ "${pending}" == 'true' && "${conclusion}" != 'failure' ]]; then
    conclusion='pending'
  fi
  failures="$(ci_rollup_failure_details_json "${latest}")"
  ready=false
  if [[ "${conclusion}" == 'success' ]]; then
    ready=true
  fi
  ar_runner_jq_n "agent-review ci status json" \
    --arg conclusion "${conclusion}" \
    --argjson failures "${failures}" \
    --argjson ci_ready "${ready}" \
    '{ci_conclusion: $conclusion, ci_failures: $failures, ci_ready: $ci_ready}'
}

agent_review_print_ci_failures() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest line

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  printf 'wait-for-agent-review: CI failed on PR #%s — fix required checks before agent review\n' "${pr}" >&2
  while IFS= read -r line || [[ -n "${line}" ]]; do
    printf '  %s\n' "${line}" >&2
  done < <(ci_rollup_failed_lines "${latest}" | head -n 20)
}

# True when the active agent's daily quota is exhausted and waiting would be futile.
agent_review_skip_wait_for_quota_exhausted_agent() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local check_state_json complete agent_id

  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  if ! agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    return 1
  fi
  if [[ "${agent_review_profile_uses_head_check}" == 'true' ]]; then
    check_state_json="$(agent_review_head_check_state_json "${repo}" "${head}")"
    complete="$(ar_runner_jq_file "agent-review skip wait head check complete" "${check_state_json}" -r '.complete')"
    if [[ "${complete}" == 'true' ]]; then
      return 1
    fi
    return 0
  fi
  if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
    return 1
  fi
  return 0
}

# Ordered unique agent ids: preferred profile, then AGENT_REVIEW_QUOTA_FALLBACK_CHAIN entries.
agent_review_requestable_agent_candidates() {
  local -r preferred="${1:-${AGENT_REVIEW_AGENT:-copilot}}"
  local agents=() agent i

  agents+=("${preferred}")
  i=0
  while agent="$(agent_review_quota_fallback_agent_at "${i}" 2>/dev/null)"; do
    agents+=("${agent}")
    i=$(( i + 1 ))
  done

  declare -A seen=()
  for agent in "${agents[@]}"; do
    if [[ -z "${seen[${agent}]:-}" ]]; then
      seen["${agent}"]=1
      printf '%s\n' "${agent}"
    fi
  done
}

# Activate the first profile in quota escalation order that is not cached exhausted
# today (coderabbit → copilot → bugbot). Returns 1 when all are exhausted.
agent_review_activate_first_requestable_agent() {
  local profiles_dir profile_path agent current

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  current="${AGENT_REVIEW_AGENT:-copilot}"
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    profile_path="${profiles_dir}/${agent}"
    if [[ ! -f "${profile_path}" ]]; then
      continue
    fi
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      printf 'wait-for-agent-review: skipping %s — daily quota exhausted (will not request)\n' \
        "${agent}" >&2
      continue
    fi
    if [[ "${agent}" != "${current}" ]]; then
      agent_review_use_agent "${agent}"
      printf 'wait-for-agent-review: using %s (quota escalation)\n' "${agent}" >&2
    fi
    printf '%s\n' "${agent}"
    return 0
  done < <(agent_review_quota_escalation_agent_ids)
  return 1
}

# Align AGENT_REVIEW_AGENT with the single probe agent for today (escalation order).
agent_review_sync_active_probe_agent() {
  local agent current

  current="${AGENT_REVIEW_AGENT:-copilot}"
  if ! agent="$(agent_review_quota_probe_agent_for_today 2>/dev/null)"; then
    return 1
  fi
  if [[ "${agent}" != "${current}" ]]; then
    agent_review_use_agent "${agent}"
    printf 'wait-for-agent-review: active agent %s (quota escalation)\n' "${agent}" >&2
  fi
  return 0
}

# Exit 0 when a named PR check (e.g. CodeRabbit) is pending or in progress.
agent_review_named_pr_check_is_pending() {
  local -r repo="$1"
  local -r pr="$2"
  local -r check_name="$3"
  local rollup latest conclusion

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  if [[ "$(ar_runner_jq_file "agent-review named check exists" "${latest}" --arg name "${check_name}" -r \
    '[.[]? | select((.name // .context // "") == $name)] | length')" == '0' ]]; then
    return 1
  fi
  conclusion="$(ar_runner_jq_file "agent-review named check conclusion" "${latest}" --arg name "${check_name}" -r \
    '[.[]? | select((.name // .context // "") == $name)] | .[0].conclusion // ""')"
  case "${conclusion}" in
    '' | IN_PROGRESS | QUEUED | PENDING)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# True when we should not wait on this agent (daily quota established exhausted).
agent_review_agent_wait_is_skipped() {
  agent_review_agent_quota_exhausted_for_agent "${1:-${AGENT_REVIEW_AGENT:-copilot}}"
}

# JSON array of agent ids whose daily quota is not exhausted.
agent_review_agents_with_quota_json() {
  local agents_json='[]' agent

  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if ! agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      agents_json="$(ar_runner_jq_n "agent-review agents with quota" \
        --argjson arr "${agents_json}" --arg a "${agent}" '$arr + [$a]')"
    fi
  done < <(agent_review_cycle_quota_agent_ids)
  printf '%s' "${agents_json}"
}

# Human-readable quota summary for operator emails (copilot/bugbot/coderabbit).
agent_review_quota_summary_for_email() {
  local agent status parts=()

  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      status='exhausted (not waiting)'
    elif agent_review_agent_quota_confirmed_for_agent "${agent}"; then
      status='available'
    elif agent_review_agent_quota_probe_requested_for_agent "${agent}"; then
      status='probe requested (awaiting review)'
    else
      status='unconfirmed (not probed today)'
    fi
    parts+=("${agent}: ${status}")
  done < <(agent_review_cycle_quota_agent_ids)
  (IFS=$'\n'; printf '%s' "${parts[*]}")
}

# True when a PR issue comment from the active agent profile today reports quota exhaustion.
agent_review_pr_has_quota_issue_comment_today() {
  local -r repo="$1"
  local -r pr="$2"
  local -r comments_json="$3"
  local today created_at body

  if [[ -z "${agent_review_profile_request_login_regex:-}" ]] \
    || [[ -z "${comments_json}" ]]; then
    return 1
  fi
  today="$(agent_review_copilot_quota_local_day)"
  if declare -F agent_review_profile_issue_comment_is_quota_exhausted >/dev/null; then
    while IFS=$'\t' read -r created_at body login; do
      [[ -n "${created_at}" ]] || continue
      if ! agent_review_quota_timestamp_on_local_day "${created_at}" "${today}"; then
        continue
      fi
      if agent_review_profile_issue_comment_is_quota_exhausted "${login}" "${body}"; then
        return 0
      fi
    done < <(ar_runner_jq_file "agent-review quota issue comment scan" "${comments_json}" -rs '
        [ .[] | .[] | [.created_at, (.body // ""), (.user.login // "")] ]
        | .[]
        | @tsv')
    return 1
  fi
  while IFS=$'\t' read -r created_at body; do
    [[ -n "${created_at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${created_at}" "${today}"; then
      continue
    fi
    if agent_review_profile_text_is_quota_exhausted "${body}"; then
      return 0
    fi
  done < <(ar_runner_jq_file "agent-review quota issue comment scan" "${comments_json}" -rs \
    --arg re "${agent_review_profile_request_login_regex}" '
      [ .[] | .[] | select((.user.login // "") | test($re;"i")) ]
      | .[]
      | [.created_at, .body]
      | @tsv')
  return 1
}

# Fetch PR issue comments once for quota observation (REST paginate).
agent_review_pr_issue_comments_json() {
  local -r repo="$1"
  local -r pr="$2"
  local owner name exit_code api_json

  read -r owner name < <(agent_review_repo_parts "${repo}")
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  exit_code=0
  api_json="$(ar_runner_gh_api_stream "agent-review pr issue comments" \
    "repos/${owner}/${name}/issues/${pr}/comments" --paginate)" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "${api_json}" ]]; then
    printf '[]\n'
    return 0
  fi
  printf '%s' "${api_json}"
}

# Observe quota for one agent on the current PR head. Head reviews/checks run first so a
# successful review on this PR clears stale exhaustion cached from other PRs. Returns 0 when
# the daily cache was updated.
agent_review_quota_observe_agent_on_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="$4"
  local -r comments_json="$5"
  local agent_id review_body run_json reason

  agent_id="${agent_review_profile_id:-}"
  [[ -n "${agent_id}" ]] || return 1

  if [[ -n "${snapshot}" ]] && agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
    review_body="$(agent_review_latest_agent_review_body_on_head "${snapshot}" "${head}")"
    if [[ -n "${review_body}" ]] \
      && agent_review_profile_review_is_quota_exhausted "${review_body}"; then
      reason="${agent_id} review on ${repo}#${pr} head ${head:0:7} reports quota exhaustion."
      agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}"
      return 0
    fi
    reason="${agent_id} review on ${repo}#${pr} head ${head:0:7} confirms quota available."
    agent_review_quota_mark_confirmed_for_agent "${agent_id}" "${reason}"
    return 0
  fi

  if [[ -n "${snapshot}" && "${agent_review_profile_uses_head_check:-false}" == 'true' ]]; then
    run_json="$(agent_review_head_check_run_json_for_head "${repo}" "${head}")"
    if [[ -n "${run_json}" && "${run_json}" != 'null' ]] \
      && agent_review_profile_head_check_is_quota_exhausted "${run_json}"; then
      reason="${agent_id} check on ${repo}#${pr} head ${head:0:7} reports quota or usage limit."
      agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}"
      return 0
    fi
    if [[ -n "${run_json}" && "${run_json}" != 'null' ]] \
      && declare -F agent_review_profile_head_check_is_complete >/dev/null 2>&1 \
      && agent_review_profile_head_check_is_complete "${run_json}" \
      && ! agent_review_profile_head_check_is_quota_exhausted "${run_json}"; then
      reason="${agent_id} check on ${repo}#${pr} head ${head:0:7} confirms usage available."
      agent_review_quota_mark_confirmed_for_agent "${agent_id}" "${reason}"
      return 0
    fi
  fi

  if [[ "${agent_id}" == 'copilot' ]] \
    && agent_review_copilot_probe_comment_sent_for_head "${comments_json}" "${head}" \
    && declare -F agent_review_agent_quota_probe_requested_for_agent >/dev/null 2>&1 \
    && agent_review_agent_quota_probe_requested_for_agent copilot \
    && ! agent_review_agent_quota_exhausted_for_agent copilot \
    && [[ -n "${snapshot}" ]] \
    && ! agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
    reason="Copilot probe on ${repo}#${pr} head ${head:0:7}: no review after request (likely quota)."
    agent_review_quota_mark_exhausted_for_agent copilot "${reason}"
    return 0
  fi

  if agent_review_pr_has_quota_issue_comment_today "${repo}" "${pr}" "${comments_json}"; then
    reason="${agent_id} billing comment on ${repo}#${pr} reports quota or usage limit."
    agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}"
    return 0
  fi

  return 1
}

# Scan Copilot, Bugbot, and CodeRabbit quota signals on the current PR head and persist
# exhaustion for the local calendar day (source=observed). Returns 0 when any agent was
# newly marked exhausted.
agent_review_observe_all_agent_quota_on_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="${4:-}"
  local saved_agent agent profiles_dir profile_path comments_json
  local observed=0

  [[ -n "${repo}" && -n "${pr}" && -n "${head}" ]] || return 1
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    profile_path="${profiles_dir}/${agent}"
    if [[ ! -f "${profile_path}" ]]; then
      continue
    fi
    agent_review_use_agent "${agent}"
    if agent_review_quota_observe_agent_on_pr \
      "${repo}" "${pr}" "${head}" "${snapshot}" "${comments_json}"; then
      observed=1
    fi
  done < <(agent_review_cycle_quota_agent_ids)
  agent_review_use_agent "${saved_agent}"
  if (( observed > 0 )); then
    return 0
  fi
  return 1
}
