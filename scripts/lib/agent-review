        | select(is_fix_reply_body($last.body) | not)
        | select(
            (.isResolved == false)
            or (($last.body // "") | test("\\?"))
          )
        | {
            thread_id: .id,
            is_resolved: .isResolved,
            author: ($last.author.login // ""),
            comment_id: $last.databaseId,
            comment_url: $last.url,
            path: ($last.path // ""),
