# Classify mergeStateStatus for the agent-review loop.
# Prints one of: ready | behind | transient | blocked
agent_review_merge_state_class() {
  local -r state="$1"

  case "${state}" in
    CLEAN|BLOCKED)
      printf 'ready\n'
      ;;
    BEHIND)
      printf 'behind\n'
      ;;
    UNSTABLE|UNKNOWN|HAS_HOOKS)
      printf 'transient\n'
      ;;
    DIRTY|CONFLICTING|DRAFT)
      printf 'blocked\n'
      ;;
    *)
      printf 'blocked\n'
      ;;
  esac
}

# Best-effort actionable text from the runner session (first failure / last stderr).
agent_review_runner_last_failure_text() {
  local uuid line

  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" && -s "${RUNNER_FIRST_FAILURE_FILE}" ]]; then
    line="$(head --lines=1 "${RUNNER_FIRST_FAILURE_FILE}" 2>/dev/null || true)"
    if [[ -n "${line}" ]]; then
      printf '%s\n' "${line}"
      return 0
    fi
  fi
  uuid="$(runner_last_id 2>/dev/null || true)"
  if [[ -n "${uuid}" ]]; then
    line="$(runner_read "${uuid}" stderr 2>/dev/null | grep -m1 '.' || true)"
    if [[ -n "${line}" ]]; then
      printf '%s\n' "${line}"
      return 0
    fi
  fi
  return 0
}

agent_review_assert_checkout_matches_repo() {
