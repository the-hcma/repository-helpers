agent_review_head_check_state_json() {
  local -r repo="$1"
  local -r head="$2"
  local run_json complete clean findings error quota conclusion status

  if [[ "${agent_review_profile_uses_head_check}" != 'true' ]]; then
    ar_runner_jq_n "agent-review head check state empty" \
      '{complete:false, clean:false, findings:false, error:false, quota:false, conclusion:"", status:""}'
    return 0
  fi
  run_json="$(agent_review_head_check_run_json_for_head "${repo}" "${head}")"
  if [[ -z "${run_json}" || "${run_json}" == 'null' ]]; then
    ar_runner_jq_n "agent-review head check state missing" \
      '{complete:false, clean:false, findings:false, error:false, quota:false, conclusion:"", status:""}'
    return 0
  fi
  complete=false
  clean=false
  findings=false
  error=false
  quota=false
  if agent_review_profile_head_check_is_complete "${run_json}"; then
    complete=true
  fi
  if agent_review_profile_head_check_is_quota_exhausted "${run_json}"; then
    quota=true
    error=true
  elif agent_review_profile_head_check_is_error "${run_json}"; then
    error=true
  fi
  if agent_review_profile_head_check_is_clean "${run_json}"; then
    clean=true
  fi
  if agent_review_profile_head_check_has_findings "${run_json}"; then
    findings=true
  fi
  conclusion="$(ar_runner_jq_file "agent-review head check run conclusion" "${run_json}" -r '.conclusion // ""')"
  status="$(ar_runner_jq_file "agent-review head check run status" "${run_json}" -r '.status // ""')"
  ar_runner_jq_n "agent-review head check state" \
    --argjson complete "${complete}" \
    --argjson clean "${clean}" \
    --argjson findings "${findings}" \
    --argjson error "${error}" \
    --argjson quota "${quota}" \
    --arg conclusion "${conclusion}" \
    --arg status "${status}" \
    '{
      complete: $complete,
      clean: $clean,
      findings: $findings,
      error: $error,
      quota: $quota,
      conclusion: $conclusion,
      status: $status
    }'
}

