# Threads whose last comment is a human follow-up (including on resolved threads).
# Excludes short "Done|Fixed|Addressed in <sha>" replies so addressed threads stay quiet.
agent_review_follow_up_threads_json_from_snapshot() {
  local -r snapshot="$1"
  local bots

  bots="$(agent_review_bot_login_regex)"
  ar_runner_jq_file "agent-review follow-up threads json" "${snapshot}" --arg bots "${bots}" '
      def is_bot_login($login):
        ($bots | split("|")) as $patterns
        | any($patterns[]; . as $p | ($login // "") | test($p;"i"));
      def is_human_user($author):
        ($author.__typename == "User") and (is_bot_login($author.login) | not);
      def is_fix_reply_body($body):
        ($body // "") | test("^(Done|Fixed|Addressed) in [0-9a-f]{7,}"; "i");
      [.data.repository.pullRequest.reviewThreads.nodes[]
        | .comments.nodes[-1] as $last
        | select(is_human_user($last.author))
        | select(is_fix_reply_body($last.body) | not)
        | select(
            (.isResolved == false)
            or (($last.body // "") | test("\\?"))
          )
        | {
            thread_id: .id,
            is_resolved: .isResolved,
            author: ($last.author.login // ""),
            comment_id: $last.databaseId,
            comment_url: $last.url,
            path: ($last.path // ""),
            line: ($last.line // null),
            body: $last.body,
            reply_count: ([.comments.nodes[1:][]] | length),
            follow_up: true
          }]'
}

