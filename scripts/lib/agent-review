agent_review_load_ci_rollup_lib() {
  if [[ "${agent_review_ci_rollup_lib_loaded}" == 'true' ]]; then
    return 0
  fi
  local lib_dir
  lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck disable=SC1091  # shared rollup helper sourced at runtime from scripts/lib
  source "${lib_dir}/ci-check-rollup"
  agent_review_ci_rollup_lib_loaded=true
}

# Exit 0 when required CI is green, 1 when failed, 2 when pending/in progress.
agent_review_ci_check_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest conclusion

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  if ci_rollup_has_pending_or_in_progress "$rollup"; then
    return 2
  fi
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  conclusion="$(ci_rollup_conclusion_for_gating "${latest}" "")"
  case "${conclusion}" in
    success) return 0 ;;
    failure) return 1 ;;
    *) return 2 ;;
  esac
}

agent_review_ci_status_json_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest conclusion failures ready pending

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  rollup="$(ci_rollup_normalize_json "${rollup}")"
  pending=false
  if ci_rollup_has_pending_or_in_progress "$rollup"; then
    pending=true
  fi
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  conclusion="$(ci_rollup_conclusion_for_gating "${latest}" "")"
  if [[ "${pending}" == 'true' && "${conclusion}" != 'failure' ]]; then
    conclusion='pending'
  fi
  failures="$(ci_rollup_failure_details_json "${latest}")"
  ready=false
  if [[ "${conclusion}" == 'success' ]]; then
    ready=true
  fi
  jq -n \
    --arg conclusion "${conclusion}" \
    --argjson failures "${failures}" \
    --argjson ci_ready "${ready}" \
    '{ci_conclusion: $conclusion, ci_failures: $failures, ci_ready: $ci_ready}'
}

agent_review_print_ci_failures() {
  local -r repo="$1"
  local -r pr="$2"
  local rollup latest line

  agent_review_load_ci_rollup_lib
  rollup="$(ci_rollup_json_for_pr "${pr}" "${repo}")"
  latest="$(ci_rollup_latest_by_name_json "${rollup}")"
  printf 'wait-for-agent-review: CI failed on PR #%s — fix required checks before agent review\n' "${pr}" >&2
  while IFS= read -r line || [[ -n "${line}" ]]; do
    printf '  %s\n' "${line}" >&2
  done < <(ci_rollup_failed_lines "${latest}" | head -n 20)
}

# True when the active agent's daily quota is exhausted and waiting would be futile.
agent_review_skip_wait_for_quota_exhausted_agent() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local check_state_json complete agent_id

  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  if ! agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    return 1
  fi
  if [[ "${agent_review_profile_uses_head_check}" == 'true' ]]; then
    check_state_json="$(agent_review_head_check_state_json "${repo}" "${head}")"
    complete="$(printf '%s' "${check_state_json}" | jq -r '.complete')"
    if [[ "${complete}" == 'true' ]]; then
      return 1
    fi
    return 0
  fi
  if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
    return 1
  fi
  return 0
}

# Ordered unique agent ids: preferred profile, then AGENT_REVIEW_QUOTA_FALLBACK_CHAIN entries.
agent_review_requestable_agent_candidates() {
  local -r preferred="${1:-${AGENT_REVIEW_AGENT:-copilot}}"
  local agents=() agent i

  agents+=("${preferred}")
  i=0
  while agent="$(agent_review_quota_fallback_agent_at "${i}" 2>/dev/null)"; do
    agents+=("${agent}")
    i=$(( i + 1 ))
  done

  declare -A seen=()
  for agent in "${agents[@]}"; do
    if [[ -z "${seen[${agent}]:-}" ]]; then
      seen["${agent}"]=1
      printf '%s\n' "${agent}"
    fi
  done
}

# Activate the first profile whose daily quota is not cached exhausted. Returns 1 when none exist.
agent_review_activate_first_requestable_agent() {
  local profiles_dir profile_path agent current

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  current="${AGENT_REVIEW_AGENT:-copilot}"
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    profile_path="${profiles_dir}/${agent}"
    if [[ ! -f "${profile_path}" ]]; then
      continue
    fi
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      printf 'wait-for-agent-review: skipping %s — daily quota exhausted (will not request)\n' \
        "${agent}" >&2
      continue
    fi
    if [[ "${agent}" != "${current}" ]]; then
      agent_review_use_agent "${agent}"
      printf 'wait-for-agent-review: using %s (skipped quota-exhausted agents)\n' "${agent}" >&2
    fi
    printf '%s\n' "${agent}"
    return 0
  done < <(agent_review_requestable_agent_candidates "${current}")
  return 1
}
