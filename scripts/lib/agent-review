      def is_human_user($author):
        ($author.__typename == "User") and (is_bot_login($author.login) | not);
      def is_fix_reply_body($body):
        ($body // "") | test("^(Done|Fixed|Addressed) in [0-9a-f]{7,}"; "i");
      [.data.repository.pullRequest.reviewThreads.nodes[]
        | .comments.nodes[-1] as $last
