#!/usr/bin/env bash
# Shared command-execution helpers for scripts/*.
#
# Session model: call runner_session_begin once per script invocation (or let
# runner_exec auto-begin). Every external command runs via runner_exec /
# run_command / run_command_or_die and is recorded under:
#
#   ${RUNNER_SESSION_DIR}/<uuid>/
#     cmdline    — quoted command line
#     stdout     — captured standard output
#     stderr     — captured standard error
#     exit_status — numeric exit code
#     label      — human-readable label (optional)
#
# Default session root: ~/scratch/repository-helpers/runner-sessions
# Override: RUNNER_SESSION_ROOT, RUNNER_SESSION_MAX_AGE_DAYS (default 3).
#
# Inspect failures with runner_session_failed_ids, runner_read, and
# runner_format_failure.
#
#   run_command <label> [--timeout SECONDS] <cmd> [args…]
#     Runs <cmd> [args…]. Stdout is passed through (tee) so callers can redirect.
#     On failure: prints a structured diagnostic to stderr and returns the exit code.
#
#   run_command_or_die <label> [--timeout SECONDS] <cmd> [args…]
#     Delegates to run_command; exits with the same code on failure.
#
#   runner_exec / runner_sh accept --timeout SECONDS (GNU timeout(1) / gtimeout).
#   On expiry: exit 124 and one ERROR: WAIT_TIMEOUT line on stderr.
#
#   Ctrl-C (SIGINT): prints the active label + cmdline, then interrupts the child
#   and exits 130.
#
#   record_first_failure <message>
#     Saves the latest failure reason to $RUNNER_FIRST_FAILURE_FILE (if set).
set -euo pipefail

if declare -F runner_exec >/dev/null 2>&1; then
  return 0
fi

readonly _runner_artifact_stdout='stdout'
readonly _runner_artifact_stderr='stderr'
readonly _runner_artifact_exit_status='exit_status'
readonly _runner_artifact_cmdline='cmdline'
readonly _runner_artifact_label='label'
readonly _runner_artifact_probe='probe'

# Seconds after SIGTERM before SIGKILL when --timeout fires (GNU timeout --kill-after).
readonly _runner_timeout_kill_after_sec="${RUNNER_TIMEOUT_KILL_AFTER_SEC:-5}"

# Active command (for Ctrl-C diagnostics). Cleared when the command finishes.
_runner_active_label=''
_runner_active_cmdline=''
_runner_active_pid=0
_runner_active_uuid=''
_runner_interrupted=0
# Stack of prior `trap -p INT` lines (full lines, restored via eval after each run).
_runner_int_trap_stack=()

# runner_session_default_root
# Prints the directory that holds per-invocation session directories.
runner_session_default_root() {
  printf '%s\n' "${RUNNER_SESSION_ROOT:-${HOME}/scratch/repository-helpers/runner-sessions}"
}

# runner_session_prune_stale
# Removes session directories older than RUNNER_SESSION_MAX_AGE_DAYS (default 3).
# Best-effort; never fails the caller.
runner_session_prune_stale() {
  local root max_days active_dir

  root="$(runner_session_default_root)"
  max_days="${RUNNER_SESSION_MAX_AGE_DAYS:-3}"
  active_dir="${RUNNER_SESSION_DIR:-}"

  if [[ ! "$max_days" =~ ^[0-9]+$ ]] || (( max_days < 1 )); then
    return 0
  fi
  if [[ ! -d "$root" ]]; then
    return 0
  fi

  find "$root" -mindepth 1 -maxdepth 1 -type d -name 'session.*' -mtime "+${max_days}" 2>/dev/null \
    | while IFS= read -r old_dir; do
      [[ -n "$old_dir" ]] || continue
      if [[ -n "$active_dir" && "$old_dir" == "$active_dir" ]]; then
        continue
      fi
      rm -rf -- "$old_dir" 2>/dev/null || true
    done
}

# runner_session_begin
# Creates RUNNER_SESSION_DIR and exports it. Idempotent when already set.
runner_session_begin() {
  local base

  if [[ -n "${RUNNER_SESSION_DIR:-}" && -d "${RUNNER_SESSION_DIR}" ]]; then
    return 0
  fi
  runner_session_prune_stale
  base="$(runner_session_default_root)"
  mkdir -p "$base"
  RUNNER_SESSION_DIR="$(mktemp -d "${base}/session.XXXXXX")"
  export RUNNER_SESSION_DIR
}

# runner_session_ensure — begin if needed.
runner_session_ensure() {
  runner_session_begin
}

# runner_session_end
# Removes RUNNER_SESSION_DIR unless RUNNER_SESSION_KEEP=1.
runner_session_end() {
  if [[ -z "${RUNNER_SESSION_DIR:-}" ]]; then
    return 0
  fi
  if [[ "${RUNNER_SESSION_KEEP:-0}" == '1' ]]; then
    return 0
  fi
  rm -rf "${RUNNER_SESSION_DIR}"
  unset RUNNER_SESSION_DIR
}

# runner_quote_cmdline <argv…>
# Prints a single line safe for logging (bash printf %q).
runner_quote_cmdline() {
  local arg
  local first=1
  for arg in "$@"; do
    if (( first )); then
      printf '%q' "$arg"
      first=0
    else
      printf ' %q' "$arg"
    fi
  done
  printf '\n'
}

# runner_new_uuid
runner_new_uuid() {
  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    cat /proc/sys/kernel/random/uuid
    return 0
  fi
  printf '%s-%s-%s\n' "$(date +%s%N)" "$$" "$RANDOM"
}

# runner_timeout_bin
# Prints path to GNU timeout(1) or gtimeout(1). Returns 1 when neither is on PATH.
runner_timeout_bin() {
  if command -v timeout >/dev/null 2>&1; then
    command -v timeout
    return 0
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    command -v gtimeout
    return 0
  fi
  return 1
}

# runner_validate_timeout_sec <helper> <label> <timeout_sec>
# Rejects non-integer --timeout values before any arithmetic coercion.
runner_validate_timeout_sec() {
  local -r helper="$1"
  local -r label="$2"
  local -r timeout_sec="$3"

  if [[ ! "$timeout_sec" =~ ^[0-9]+$ ]]; then
    printf '%s: --timeout must be a non-negative integer (label=%s)\n' \
      "$helper" "$label" >&2
    return 2
  fi
  return 0
}

_runner_on_int() {
  local label cmdline pid

  label="${_runner_active_label:-}"
  cmdline="${_runner_active_cmdline:-}"
  pid="${_runner_active_pid:-0}"

  # Prefer in-memory state; fall back to session files (subshell / inheritance).
  if [[ -z "$label" && -n "${RUNNER_SESSION_DIR:-}" && -f "${RUNNER_SESSION_DIR}/.active_label" ]]; then
    label="$(tr -d '\n' <"${RUNNER_SESSION_DIR}/.active_label" 2>/dev/null || true)"
    cmdline="$(tr -d '\n' <"${RUNNER_SESSION_DIR}/.active_cmdline" 2>/dev/null || true)"
    pid="$(tr -d '\n' <"${RUNNER_SESSION_DIR}/.active_pid" 2>/dev/null || true)"
  fi

  runner_print_int_banner "$label" "$cmdline"
  _runner_interrupted=1

  if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
    kill -INT "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  fi

  # Do not exit here: let wait(1) return so runner_exec can record exit_status,
  # .order, and runner_report_command_failure (same path as a normal failure).
  # Prior INT traps are not chained — callers should use EXIT for cleanup
  # (runner-bootstrap already chains EXIT).
}

# runner_print_int_banner <label> <cmdline>
runner_print_int_banner() {
  local -r label="${1:-}"
  local -r cmdline="${2:-}"

  if [[ -z "$label" && -z "$cmdline" ]]; then
    return 0
  fi
  printf '\n[INT] Interrupted: %s\n' "${label:-command}" >&2
  printf '  command: %s\n' "${cmdline:-?}" >&2
}

# runner_exit_code_is_signal_int <exit_code>
# True for 130 (SIGINT) or 143 (SIGTERM) — common interrupt statuses from wait(1).
runner_exit_code_is_signal_int() {
  local -r exit_code="$1"
  [[ "$exit_code" == "130" || "$exit_code" == "143" ]]
}

_runner_install_int_trap() {
  # Push the current INT trap (full `trap -p` line) so we can restore it after
  # the command. Avoid parsing/eval of handler bodies — restore via eval of the
  # exact trap -p output (works for SIGINT and INT forms).
  _runner_int_trap_stack+=("$(trap -p INT 2>/dev/null || true)")
  trap '_runner_on_int' INT
}

_runner_restore_int_trap() {
  local prev=""
  local stack_len=${#_runner_int_trap_stack[@]}

  if (( stack_len > 0 )); then
    prev="${_runner_int_trap_stack[stack_len - 1]}"
    unset "_runner_int_trap_stack[stack_len - 1]"
    # Re-pack so indices stay contiguous on bash 5.
    _runner_int_trap_stack=("${_runner_int_trap_stack[@]+"${_runner_int_trap_stack[@]}"}")
  fi
  if [[ -n "$prev" ]]; then
    eval "$prev"
  else
    trap - INT
  fi
}

# runner_set_active_command <label> <cmdline_quoted> <pid> [uuid]
runner_set_active_command() {
  _runner_active_label="$1"
  _runner_active_cmdline="$2"
  _runner_active_pid="$3"
  _runner_active_uuid="${4:-}"
  _runner_interrupted=0
  if [[ -n "${RUNNER_SESSION_DIR:-}" ]]; then
    printf '%s\n' "$1" >"${RUNNER_SESSION_DIR}/.active_label"
    printf '%s\n' "$2" >"${RUNNER_SESSION_DIR}/.active_cmdline"
    printf '%s\n' "$3" >"${RUNNER_SESSION_DIR}/.active_pid"
  fi
}

# runner_clear_active_command
runner_clear_active_command() {
  _runner_active_label=''
  _runner_active_cmdline=''
  _runner_active_pid=0
  _runner_active_uuid=''
  if [[ -n "${RUNNER_SESSION_DIR:-}" ]]; then
    rm -f "${RUNNER_SESSION_DIR}/.active_label" \
      "${RUNNER_SESSION_DIR}/.active_cmdline" \
      "${RUNNER_SESSION_DIR}/.active_pid"
  fi
}

# runner_exec <label> [--probe] [--stream-stdout] [--timeout SECONDS] -- <cmd> [args…]
# Captures stdout/stderr/exit in a UUID directory. Returns the command exit code.
# With --probe, non-zero exits are omitted from failure reports (expected checks).
# With --stream-stdout, copies stdout to file descriptor 1 after completion.
# With --timeout SECONDS, wraps the command in GNU timeout(1) (--kill-after).
# On timeout expiry: exit 124 and prints ERROR: WAIT_TIMEOUT <label> timeout=<Ns>.
runner_exec() {
  local label stream_stdout=0 probe=0 timeout_sec=0
  local -a runner_cmd=()
  local uuid run_dir exit_code cmdline_quoted timeout_bin int_pid
  label="${1:?}"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)
        probe=1
        shift
        ;;
      --stream-stdout)
        stream_stdout=1
        shift
        ;;
      --timeout)
        [[ $# -ge 2 ]] || {
          printf 'runner_exec: --timeout requires SECONDS (label=%s)\n' "$label" >&2
          return 2
        }
        timeout_sec="$2"
        shift 2
        ;;
      --timeout=*)
        timeout_sec="${1#--timeout=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'runner_exec: expected -- before command (label=%s)\n' "$label" >&2
        return 2
        ;;
    esac
  done

  runner_validate_timeout_sec "runner_exec" "$label" "$timeout_sec" || return $?

  runner_session_ensure
  _runner_install_int_trap

  uuid="$(runner_new_uuid)"
  run_dir="${RUNNER_SESSION_DIR}/${uuid}"
  mkdir -p "$run_dir"

  printf '%s\n' "$label" >"${run_dir}/${_runner_artifact_label}"
  if (( probe )); then
    printf '1\n' >"${run_dir}/${_runner_artifact_probe}"
  fi

  runner_cmd=("$@")
  if (( timeout_sec > 0 )); then
    timeout_bin="$(runner_timeout_bin)" || {
      printf 'runner_exec: --timeout requires timeout(1) or gtimeout(1) on PATH (label=%s)\n' \
        "$label" >&2
      return 2
    }
    runner_cmd=(
      "$timeout_bin"
      --foreground
      --kill-after="${_runner_timeout_kill_after_sec}"
      "${timeout_sec}"
      "$@"
    )
  fi

  cmdline_quoted="$(runner_quote_cmdline "${runner_cmd[@]}")"
  printf '%s' "$cmdline_quoted" >"${run_dir}/${_runner_artifact_cmdline}"

  # Background + wait so the INT trap can print the cmdline, then kill the child
  # (bash defers INT traps while a foreground external command is running).
  exit_code=0
  _runner_interrupted=0
  "${runner_cmd[@]}" \
    >"${run_dir}/${_runner_artifact_stdout}" \
    2>"${run_dir}/${_runner_artifact_stderr}" &
  runner_set_active_command "$label" "$cmdline_quoted" "$!" "$uuid"
  wait "$_runner_active_pid" || exit_code=$?
  # When wait is interrupted by SIGINT, bash may return 130 here; the INT trap
  # sets _runner_interrupted and kills the child. Fall through to the normal
  # artifact + failure-report + stream-stdout path.
  if (( _runner_interrupted )) || runner_exit_code_is_signal_int "$exit_code"; then
    int_pid="${_runner_active_pid:-0}"
    if [[ "$int_pid" =~ ^[1-9][0-9]*$ ]]; then
      kill -INT "$int_pid" 2>/dev/null || true
      kill -TERM "$int_pid" 2>/dev/null || true
      wait "$int_pid" 2>/dev/null || true
    fi
    if (( ! _runner_interrupted )); then
      runner_print_int_banner "$_runner_active_label" "$_runner_active_cmdline"
    fi
    # Preserve SIGTERM (143) when that is what wait reported; default Ctrl-C to 130.
    if ! runner_exit_code_is_signal_int "$exit_code"; then
      exit_code=130
    fi
  fi
  runner_clear_active_command

  if (( timeout_sec > 0 && exit_code == 124 )); then
    {
      printf 'ERROR: WAIT_TIMEOUT %s timeout=%ss\n' "$label" "$timeout_sec"
    } >>"${run_dir}/${_runner_artifact_stderr}"
    printf 'ERROR: WAIT_TIMEOUT %s timeout=%ss\n' "$label" "$timeout_sec" >&2
  fi

  printf '%s\n' "$exit_code" >"${run_dir}/${_runner_artifact_exit_status}"
  printf '%s\n' "$uuid" >>"${RUNNER_SESSION_DIR}/.order"

  if (( stream_stdout )); then
    cat "${run_dir}/${_runner_artifact_stdout}"
  fi

  if (( exit_code != 0 )) && ! (( probe )); then
    runner_report_command_failure "$label" "$exit_code" "$uuid"
  fi

  _runner_restore_int_trap
  return "$exit_code"
}

# runner_sh <label> [--probe] [--stream-stdout] [--timeout SECONDS] [--] <script>
# Runs bash -c with capture (pipelines and compound commands).
runner_sh() {
  local label probe=0 stream_stdout=0 timeout_sec=0 script
  local -a exec_opts=()
  label="${1:?}"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)
        probe=1
        shift
        ;;
      --stream-stdout)
        stream_stdout=1
        shift
        ;;
      --timeout)
        [[ $# -ge 2 ]] || {
          printf 'runner_sh: --timeout requires SECONDS (label=%s)\n' "$label" >&2
          return 2
        }
        timeout_sec="$2"
        shift 2
        ;;
      --timeout=*)
        timeout_sec="${1#--timeout=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done
  script="${1:?}"
  runner_validate_timeout_sec "runner_sh" "$label" "$timeout_sec" || return $?
  if (( probe )); then
    exec_opts+=(--probe)
  fi
  if (( stream_stdout )); then
    exec_opts+=(--stream-stdout)
  fi
  if (( timeout_sec > 0 )); then
    exec_opts+=(--timeout "$timeout_sec")
  fi
  runner_exec "$label" "${exec_opts[@]}" -- bash -c "$script"
}

# runner_read <uuid> <artifact>
# Prints artifact contents (exit_status has no trailing newline in file).
runner_read() {
  local -r uuid="$1"
  local -r artifact="$2"
  local path

  [[ -n "${RUNNER_SESSION_DIR:-}" ]] || {
    printf 'runner_read: no active session\n' >&2
    return 2
  }
  path="${RUNNER_SESSION_DIR}/${uuid}/${artifact}"
  [[ -f "$path" ]] || {
    printf 'runner_read: missing %s\n' "$path" >&2
    return 2
  }
  cat "$path"
}

# runner_last_id
# Most recently created run id in this session.
runner_last_id() {
  [[ -n "${RUNNER_SESSION_DIR:-}" && -f "${RUNNER_SESSION_DIR}/.order" ]] || return 0
  tail -n 1 "${RUNNER_SESSION_DIR}/.order"
}

# runner_exec_stdout <label> [--probe] [--timeout SECONDS] -- <cmd> [args…]
# Runs command; prints captured stdout on success or failure. Returns exit code.
runner_exec_stdout() {
  local label probe=0 timeout_sec=0
  local -a exec_opts=()
  label="$1"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)
        probe=1
        shift
        ;;
      --timeout)
        [[ $# -ge 2 ]] || {
          printf 'runner_exec_stdout: --timeout requires SECONDS (label=%s)\n' "$label" >&2
          return 2
        }
        timeout_sec="$2"
        shift 2
        ;;
      --timeout=*)
        timeout_sec="${1#--timeout=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'runner_exec_stdout: expected -- before command (label=%s)\n' "$label" >&2
        return 2
        ;;
    esac
  done
  local uuid exit_code
  runner_validate_timeout_sec "runner_exec_stdout" "$label" "$timeout_sec" || return $?
  if (( probe )); then
    exec_opts+=(--probe)
  fi
  if (( timeout_sec > 0 )); then
    exec_opts+=(--timeout "$timeout_sec")
  fi
  exit_code=0
  runner_exec "$label" "${exec_opts[@]}" -- "$@" || exit_code=$?
  uuid="$(runner_last_id)"
  if [[ -n "$uuid" ]]; then
    runner_read "$uuid" "$_runner_artifact_stdout" || true
  fi
  return "$exit_code"
}

# runner_sh_stdout <label> [--timeout SECONDS] [--] <script>
runner_sh_stdout() {
  local label timeout_sec=0 script exit_code uuid
  local -a sh_opts=()
  label="${1:?}"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout)
        [[ $# -ge 2 ]] || {
          printf 'runner_sh_stdout: --timeout requires SECONDS (label=%s)\n' "$label" >&2
          return 2
        }
        timeout_sec="$2"
        shift 2
        ;;
      --timeout=*)
        timeout_sec="${1#--timeout=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done
  script="${1:?}"
  runner_validate_timeout_sec "runner_sh_stdout" "$label" "$timeout_sec" || return $?
  if (( timeout_sec > 0 )); then
    sh_opts+=(--timeout "$timeout_sec")
  fi
  exit_code=0
  runner_sh "$label" "${sh_opts[@]}" -- "$script" || exit_code=$?
  uuid="$(runner_last_id)"
  if [[ -n "$uuid" ]]; then
    runner_read "$uuid" "$_runner_artifact_stdout" || true
  fi
  return "$exit_code"
}

# runner_read_exit <uuid>
runner_read_exit() {
  local raw
  raw="$(runner_read "$1" "$_runner_artifact_exit_status")"
  printf '%s' "$raw" | tr -d '[:space:]'
}

# runner_session_ids
# Lists run ids in creation order.
runner_session_ids() {
  [[ -n "${RUNNER_SESSION_DIR:-}" && -f "${RUNNER_SESSION_DIR}/.order" ]] || return 0
  cat "${RUNNER_SESSION_DIR}/.order"
}

# runner_session_failed_ids
# Lists UUIDs whose exit_status is not 0 (probe runs are omitted).
runner_session_failed_ids() {
  local uuid exit_code
  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    if [[ -f "${RUNNER_SESSION_DIR}/${uuid}/${_runner_artifact_probe}" ]]; then
      continue
    fi
    exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '0')"
    if [[ -n "$exit_code" && "$exit_code" -ne 0 ]]; then
      printf '%s\n' "$uuid"
    fi
  done < <(runner_session_ids)
}

# runner_format_failure <uuid>
# Prints a multi-line diagnostic block to stdout.
runner_format_failure() {
  local -r uuid="$1"
  local label cmdline exit_code stdout stderr

  label="$(runner_read "$uuid" "$_runner_artifact_label" 2>/dev/null || true)"
  cmdline="$(runner_read "$uuid" "$_runner_artifact_cmdline" 2>/dev/null || true)"
  exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '?')"
  stdout="$(runner_read "$uuid" "$_runner_artifact_stdout" 2>/dev/null || true)"
  stderr="$(runner_read "$uuid" "$_runner_artifact_stderr" 2>/dev/null || true)"

  if [[ -n "$label" ]]; then
    printf '[FAIL] %s\n' "$label"
  else
    printf '[FAIL] command %s\n' "$uuid"
  fi
  printf '  command:   %s\n' "${cmdline:-?}"
  printf '  exit code: %s\n' "$exit_code"
  if [[ -n "$stderr" ]]; then
    printf '  --- stderr ---\n'
    printf '%s\n' "$stderr" | sed 's/^/  /'
    printf '  --- end stderr ---\n'
  fi
  if [[ -n "$stdout" ]]; then
    printf '  --- stdout ---\n'
    printf '%s\n' "$stdout" | sed 's/^/  /'
    printf '  --- end stdout ---\n'
  fi
}

# runner_format_failures
# All failed commands in creation order (session-wide).
runner_format_failures() {
  local uuid

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    runner_format_failure "$uuid"
    printf '\n'
  done < <(runner_session_failed_ids)
}

# runner_failure_stderr_hint <uuid>
# First non-empty stderr line, trimmed for email summaries.
runner_failure_stderr_hint() {
  local -r uuid="$1"
  local hint

  hint="$(runner_read "$uuid" "$_runner_artifact_stderr" 2>/dev/null \
    | grep -m1 '.' || true)"
  hint="${hint#"${hint%%[![:space:]]*}"}"
  hint="${hint%"${hint##*[![:space:]]}"}"
  if [[ ${#hint} -gt 160 ]]; then
    hint="${hint:0:157}..."
  fi
  printf '%s' "$hint"
}

# runner_failures_to_json
# JSON array of {label, exit_code, stderr_hint} for all failed commands.
runner_failures_to_json() {
  local uuid label exit_code hint
  local -a rows=()
  local row

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    label="$(runner_read "$uuid" "$_runner_artifact_label" 2>/dev/null || true)"
    exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '0')"
    hint="$(runner_failure_stderr_hint "$uuid")"
    if ! command -v jq >/dev/null 2>&1; then
      continue
    fi
    row="$(jq -nc \
      --arg label "$label" \
      --argjson exit_code "$exit_code" \
      --arg stderr_hint "$hint" \
      '{label: $label, exit_code: $exit_code, stderr_hint: $stderr_hint}')"
    rows+=("$row")
  done < <(runner_session_failed_ids)

  if [[ ${#rows[@]} -eq 0 ]]; then
    printf '[]'
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf '[]'
    return 0
  fi
  printf '%s\n' "${rows[@]}" | jq -s '.'
}

# runner_report_append_command_failures <body_lines_array_name> [--log-file PATH]
# Appends a concise email section listing every failed runner command in order.
runner_report_append_command_failures() {
  local -n _rr_body_lines="$1"
  shift
  local log_file=""
  local uuid label exit_code hint count=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --log-file)
        log_file="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    count=$(( count + 1 ))
  done < <(runner_session_failed_ids)

  if (( count == 0 )); then
    return 0
  fi

  _rr_body_lines+=("Command failures (${count}):")
  _rr_body_lines+=("")
  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    label="$(runner_read "$uuid" "$_runner_artifact_label" 2>/dev/null || true)"
    exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '?')"
    hint="$(runner_failure_stderr_hint "$uuid")"
    if [[ -z "$label" ]]; then
      label="command ${uuid}"
    fi
    if [[ -n "$hint" ]]; then
      _rr_body_lines+=("  - ${label} (exit ${exit_code}): ${hint}")
    else
      _rr_body_lines+=("  - ${label} (exit ${exit_code})")
    fi
  done < <(runner_session_failed_ids)
  _rr_body_lines+=("")
  if [[ -n "$log_file" ]]; then
    _rr_body_lines+=("See log file for full command output:")
    _rr_body_lines+=("  ${log_file}")
    _rr_body_lines+=("")
  fi
}

# runner_tail_lines <text> [max_lines]
# Keeps the last N lines of captured output for email/report snippets.
runner_tail_lines() {
  local -r text="${1:-}"
  local -r max_lines="${2:-40}"
  if [[ -z "$text" ]]; then
    return 0
  fi
  printf '%s\n' "$text" | tail -n "$max_lines"
}

# runner_last_failure_capture_stderr [max_lines]
runner_last_failure_capture_stderr() {
  local uuid text
  uuid="$(runner_session_failed_ids | tail -n 1)"
  [[ -n "$uuid" ]] || return 0
  text="$(runner_read "$uuid" "$_runner_artifact_stderr" 2>/dev/null || true)"
  runner_tail_lines "$text" "${1:-40}"
}

# runner_last_failure_capture_stdout [max_lines]
runner_last_failure_capture_stdout() {
  local uuid text
  uuid="$(runner_session_failed_ids | tail -n 1)"
  [[ -n "$uuid" ]] || return 0
  text="$(runner_read "$uuid" "$_runner_artifact_stdout" 2>/dev/null || true)"
  runner_tail_lines "$text" "${1:-40}"
}

# record_first_failure <message>
# Overwrites on each call so the final value matches the exit-triggering failure.
record_first_failure() {
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" ]]; then
    printf '%s\n' "$*" >"${RUNNER_FIRST_FAILURE_FILE}"
  fi
}

# runner_report_command_failure <label> <exit_code> [uuid]
# Records first-failure text and prints a structured [FAIL] block to stderr.
runner_report_command_failure() {
  local -r label="$1"
  local -r exit_code="$2"
  local failed_uuid="${3:-}"
  local stderr_first_line

  if [[ -z "$failed_uuid" ]]; then
    failed_uuid="$(runner_last_id)"
  fi
  if [[ -n "$failed_uuid" ]]; then
    stderr_first_line="$(runner_read "$failed_uuid" "$_runner_artifact_stderr" 2>/dev/null \
      | grep -m1 '.' || true)"
    if [[ -n "$stderr_first_line" ]]; then
      record_first_failure "${label}: ${stderr_first_line}"
    else
      record_first_failure "${label} (exit ${exit_code})"
    fi
    runner_format_failure "$failed_uuid" >&2
  else
    record_first_failure "${label} (exit ${exit_code})"
    printf '[FAIL] %s\n' "$label" >&2
    printf '  exit code: %d\n' "$exit_code" >&2
  fi
}

# runner_primary_is_generic_exit <primary> <tool_name> <exit_code>
# True when primary is only a generic "<tool> exited with code N" placeholder.
runner_primary_is_generic_exit() {
  local -r primary="$1"
  local -r tool_name="$2"
  local -r exit_code="$3"

  [[ -n "$tool_name" && "$primary" == "${tool_name} exited with code ${exit_code}" ]]
}

# runner_actionable_primary_from_report <report_file> <exit_code> [tool_name]
# Prefer structured runner failures over generic exit-code placeholders.
runner_actionable_primary_from_report() {
  local -r report_file="$1"
  local -r exit_code="$2"
  local -r tool_name="${3:-}"
  local primary derived line

  if [[ ! -s "$report_file" ]] || ! command -v jq >/dev/null 2>&1; then
    return 0
  fi

  primary="$(jq -r '.primary // empty' "$report_file" 2>/dev/null || true)"
  if [[ -n "$primary" ]] \
    && ! runner_primary_is_generic_exit "$primary" "$tool_name" "$exit_code"; then
    printf '%s' "$primary"
    return 0
  fi

  derived="$(jq -r '.command_failures[-1]? | select(. != null)
    | if (.stderr_hint // "") != "" then "\(.label): \(.stderr_hint)"
      else "\(.label) (exit \(.exit_code))" end' "$report_file" 2>/dev/null || true)"
  if [[ -n "$derived" && "$derived" != "null" ]]; then
    printf '%s' "$derived"
    return 0
  fi

  line="$(jq -r '.capture_stderr // empty' "$report_file" 2>/dev/null \
    | awk '/[^[:space:]]/ { print; exit }' || true)"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  if [[ -n "$line" ]]; then
    printf '%s' "$line"
    return 0
  fi

  if [[ -n "$primary" ]]; then
    printf '%s' "$primary"
  fi
}

run_command() {
  local -r label="$1"
  shift

  local timeout_sec=0
  local -a exec_opts=(--stream-stdout)
  local exit_code

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout)
        [[ $# -ge 2 ]] || {
          printf 'run_command: --timeout requires SECONDS (label=%s)\n' "$label" >&2
          return 2
        }
        timeout_sec="$2"
        shift 2
        ;;
      --timeout=*)
        timeout_sec="${1#--timeout=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  runner_validate_timeout_sec "run_command" "$label" "$timeout_sec" || return $?

  if (( timeout_sec > 0 )); then
    exec_opts+=(--timeout "$timeout_sec")
  fi

  exit_code=0
  runner_exec "$label" "${exec_opts[@]}" -- "$@" || exit_code=$?

  return "$exit_code"
}

run_command_or_die() {
  local exit_code
  exit_code=0
  run_command "$@" || exit_code=$?
  if [[ "$exit_code" -ne 0 ]]; then
    exit "$exit_code"
  fi
}
