#!/usr/bin/env bash
# Shared command-execution helpers for scripts/*.
#
# Provides two functions:
#
#   run_command <label> <cmd> [args…]
#     Runs <cmd> [args…], capturing its stderr internally.
#     Stdout is passed through so callers can redirect it freely (e.g. > file).
#     On success: returns 0.
#     On failure: prints a structured diagnostic block to stderr (which cron
#       captures) and returns the original exit code.  Never calls exit.
#
#   run_command_or_die <label> <cmd> [args…]
#     Delegates to run_command.  On failure, exits with the same exit code.
#     The structured diagnostic is already printed by run_command — no duplication.
#
#   record_first_failure <message>
#     Saves the first failure reason to $RUNNER_FIRST_FAILURE_FILE (if set).
#     Only the first call takes effect — subsequent calls are no-ops.
#     Callers that don't go through run_command (e.g. custom install functions)
#     should call this explicitly when they detect a non-retriable failure so the
#     EXIT trap can emit a meaningful reason instead of "script exited unexpectedly".
#
# Usage example:
#   source "${script_dir}/lib/runner"
#
#   # Capture stdout to file; get actionable stderr on failure:
#   run_command "dep-updater: my-repo" \
#     dep-updater --report-json --dir /path/to/repo >"$out_file" || rc=$?
#
#   # Fatal variant — abort immediately on failure:
#   run_command_or_die "pnpm install" pnpm install --frozen-lockfile
set -euo pipefail

# record_first_failure <message>
# Writes the first failure reason to $RUNNER_FIRST_FAILURE_FILE.
# If the file already has content (a previous failure was recorded), this is a no-op.
record_first_failure() {
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" && ! -s "${RUNNER_FIRST_FAILURE_FILE}" ]]; then
    printf '%s\n' "$*" > "${RUNNER_FIRST_FAILURE_FILE}"
  fi
}

run_command() {
  local -r label="$1"
  shift

  local stderr_file
  local exit_code
  stderr_file="$(mktemp)"
  # shellcheck disable=SC2064  # intentional: expand $stderr_file now to embed the path in the trap
  trap "rm -f '${stderr_file}'" RETURN
  exit_code=0

  "$@" 2>"$stderr_file" || exit_code=$?

  if [[ "$exit_code" -ne 0 ]]; then
    local stderr_content
    stderr_content="$(cat "$stderr_file")"
    # Record first failure so the EXIT trap can emit a real reason, not a generic wrapper.
    local stderr_first_line=""
    stderr_first_line="$(printf '%s' "$stderr_content" | grep -m1 '.' || true)"
    if [[ -n "$stderr_first_line" ]]; then
      record_first_failure "${label}: ${stderr_first_line}"
    else
      record_first_failure "${label} (exit ${exit_code})"
    fi
    printf '[FAIL] %s\n' "$label" >&2
    printf '  command:   %s\n' "$*" >&2
    printf '  exit code: %d\n' "$exit_code" >&2
    if [[ -n "$stderr_content" ]]; then
      printf '  --- stderr ---\n' >&2
      printf '%s\n' "$stderr_content" | sed 's/^/  /' >&2
      printf '  --- end stderr ---\n' >&2
    fi
  fi

  return "$exit_code"
}

run_command_or_die() {
  local exit_code
  exit_code=0
  run_command "$@" || exit_code=$?
  if [[ "$exit_code" -ne 0 ]]; then
    exit "$exit_code"
  fi
}
