#!/usr/bin/env bash
# Shared command-execution helpers for scripts/*.
#
# Session model: call runner_session_begin once per script invocation (or let
# runner_exec auto-begin). Every external command runs via runner_exec /
# run_command / run_command_or_die and is recorded under:
#
#   ${RUNNER_SESSION_DIR}/<uuid>/
#     cmdline    — quoted command line
#     stdout     — captured standard output
#     stderr     — captured standard error
#     exit_status — numeric exit code
#     label      — human-readable label (optional)
#
# Inspect failures with runner_session_failed_ids, runner_read, and
# runner_format_failure.
#
#   run_command <label> <cmd> [args…]
#     Runs <cmd> [args…]. Stdout is passed through (tee) so callers can redirect.
#     On failure: prints a structured diagnostic to stderr and returns the exit code.
#
#   run_command_or_die <label> <cmd> [args…]
#     Delegates to run_command; exits with the same code on failure.
#
#   record_first_failure <message>
#     Saves the latest failure reason to $RUNNER_FIRST_FAILURE_FILE (if set).
set -euo pipefail

if declare -F runner_exec >/dev/null 2>&1; then
  return 0
fi

readonly _runner_artifact_stdout='stdout'
readonly _runner_artifact_stderr='stderr'
readonly _runner_artifact_exit_status='exit_status'
readonly _runner_artifact_cmdline='cmdline'
readonly _runner_artifact_label='label'
readonly _runner_artifact_probe='probe'

# runner_session_begin
# Creates RUNNER_SESSION_DIR and exports it. Idempotent when already set.
runner_session_begin() {
  if [[ -n "${RUNNER_SESSION_DIR:-}" && -d "${RUNNER_SESSION_DIR}" ]]; then
    return 0
  fi
  RUNNER_SESSION_DIR="$(mktemp -d "${TMPDIR:-/tmp}/runner-session.XXXXXX")"
  export RUNNER_SESSION_DIR
}

# runner_session_ensure — begin if needed.
runner_session_ensure() {
  runner_session_begin
}

# runner_session_end
# Removes RUNNER_SESSION_DIR unless RUNNER_SESSION_KEEP=1.
runner_session_end() {
  if [[ -z "${RUNNER_SESSION_DIR:-}" ]]; then
    return 0
  fi
  if [[ "${RUNNER_SESSION_KEEP:-0}" == '1' ]]; then
    return 0
  fi
  rm -rf "${RUNNER_SESSION_DIR}"
  unset RUNNER_SESSION_DIR
}

# runner_quote_cmdline <argv…>
# Prints a single line safe for logging (bash printf %q).
runner_quote_cmdline() {
  local arg
  local first=1
  for arg in "$@"; do
    if (( first )); then
      printf '%q' "$arg"
      first=0
    else
      printf ' %q' "$arg"
    fi
  done
  printf '\n'
}

# runner_new_uuid
runner_new_uuid() {
  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    cat /proc/sys/kernel/random/uuid
    return 0
  fi
  printf '%s-%s-%s\n' "$(date +%s%N)" "$$" "$RANDOM"
}

# runner_exec <label> [--probe] [--stream-stdout] -- <cmd> [args…]
# Captures stdout/stderr/exit in a UUID directory. Returns the command exit code.
# With --probe, non-zero exits are omitted from failure reports (expected checks).
# With --stream-stdout, copies stdout to file descriptor 1 after completion.
runner_exec() {
  local label stream_stdout=0 probe=0
  label="${1:?}"
  shift

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  if [[ "${1:-}" == '--stream-stdout' ]]; then
    stream_stdout=1
    shift
  fi
  [[ "${1:-}" == '--' ]] || {
    printf 'runner_exec: expected -- before command (label=%s)\n' "$label" >&2
    return 2
  }
  shift

  runner_session_ensure

  local uuid run_dir exit_code cmdline_quoted
  uuid="$(runner_new_uuid)"
  run_dir="${RUNNER_SESSION_DIR}/${uuid}"
  mkdir -p "$run_dir"

  printf '%s\n' "$label" >"${run_dir}/${_runner_artifact_label}"
  if (( probe )); then
    printf '1\n' >"${run_dir}/${_runner_artifact_probe}"
  fi
  cmdline_quoted="$(runner_quote_cmdline "$@")"
  printf '%s' "$cmdline_quoted" >"${run_dir}/${_runner_artifact_cmdline}"

  exit_code=0
  "$@" >"${run_dir}/${_runner_artifact_stdout}" 2>"${run_dir}/${_runner_artifact_stderr}" || exit_code=$?
  printf '%s\n' "$exit_code" >"${run_dir}/${_runner_artifact_exit_status}"
  printf '%s\n' "$uuid" >>"${RUNNER_SESSION_DIR}/.order"

  if (( stream_stdout )); then
    cat "${run_dir}/${_runner_artifact_stdout}"
  fi

  return "$exit_code"
}

# runner_sh <label> [--probe] [--stream-stdout] [--] <script>
# Runs bash -c with capture (pipelines and compound commands).
runner_sh() {
  local label probe=0 stream_stdout=0 script
  label="${1:?}"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  if [[ "${1:-}" == '--stream-stdout' ]]; then
    stream_stdout=1
    shift
  fi
  if [[ "${1:-}" == '--' ]]; then
    shift
  fi
  script="${1:?}"
  if (( probe )); then
    if (( stream_stdout )); then
      runner_exec "$label" --probe --stream-stdout -- bash -c "$script"
    else
      runner_exec "$label" --probe -- bash -c "$script"
    fi
  elif (( stream_stdout )); then
    runner_exec "$label" --stream-stdout -- bash -c "$script"
  else
    runner_exec "$label" -- bash -c "$script"
  fi
}

# runner_read <uuid> <artifact>
# Prints artifact contents (exit_status has no trailing newline in file).
runner_read() {
  local -r uuid="$1"
  local -r artifact="$2"
  local path

  [[ -n "${RUNNER_SESSION_DIR:-}" ]] || {
    printf 'runner_read: no active session\n' >&2
    return 2
  }
  path="${RUNNER_SESSION_DIR}/${uuid}/${artifact}"
  [[ -f "$path" ]] || {
    printf 'runner_read: missing %s\n' "$path" >&2
    return 2
  }
  cat "$path"
}

# runner_last_id
# Most recently created run id in this session.
runner_last_id() {
  [[ -n "${RUNNER_SESSION_DIR:-}" && -f "${RUNNER_SESSION_DIR}/.order" ]] || return 0
  tail -n 1 "${RUNNER_SESSION_DIR}/.order"
}

# runner_exec_stdout <label> [--probe] -- <cmd> [args…]
# Runs command; prints captured stdout on success or failure. Returns exit code.
runner_exec_stdout() {
  local label probe=0
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  [[ "${1:-}" == '--' ]] || {
    printf 'runner_exec_stdout: expected -- before command (label=%s)\n' "$label" >&2
    return 2
  }
  shift
  local uuid exit_code
  exit_code=0
  if (( probe )); then
    runner_exec "$label" --probe -- "$@" || exit_code=$?
  else
    runner_exec "$label" -- "$@" || exit_code=$?
  fi
  uuid="$(runner_last_id)"
  if [[ -n "$uuid" ]]; then
    runner_read "$uuid" "$_runner_artifact_stdout" || true
  fi
  return "$exit_code"
}

# runner_sh_stdout <label> [--] <script>
runner_sh_stdout() {
  local label script exit_code uuid
  label="${1:?}"
  shift
  if [[ "${1:-}" == '--' ]]; then
    shift
  fi
  script="${1:?}"
  exit_code=0
  runner_sh "$label" -- "$script" || exit_code=$?
  uuid="$(runner_last_id)"
  if [[ -n "$uuid" ]]; then
    runner_read "$uuid" "$_runner_artifact_stdout" || true
  fi
  return "$exit_code"
}

# runner_read_exit <uuid>
runner_read_exit() {
  local raw
  raw="$(runner_read "$1" "$_runner_artifact_exit_status")"
  printf '%s' "$raw" | tr -d '[:space:]'
}

# runner_session_ids
# Lists run ids in creation order.
runner_session_ids() {
  [[ -n "${RUNNER_SESSION_DIR:-}" && -f "${RUNNER_SESSION_DIR}/.order" ]] || return 0
  cat "${RUNNER_SESSION_DIR}/.order"
}

# runner_session_failed_ids
# Lists UUIDs whose exit_status is not 0 (probe runs are omitted).
runner_session_failed_ids() {
  local uuid exit_code
  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    if [[ -f "${RUNNER_SESSION_DIR}/${uuid}/${_runner_artifact_probe}" ]]; then
      continue
    fi
    exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '0')"
    if [[ -n "$exit_code" && "$exit_code" -ne 0 ]]; then
      printf '%s\n' "$uuid"
    fi
  done < <(runner_session_ids)
}

# runner_format_failure <uuid>
# Prints a multi-line diagnostic block to stdout.
runner_format_failure() {
  local -r uuid="$1"
  local label cmdline exit_code stdout stderr

  label="$(runner_read "$uuid" "$_runner_artifact_label" 2>/dev/null || true)"
  cmdline="$(runner_read "$uuid" "$_runner_artifact_cmdline" 2>/dev/null || true)"
  exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '?')"
  stdout="$(runner_read "$uuid" "$_runner_artifact_stdout" 2>/dev/null || true)"
  stderr="$(runner_read "$uuid" "$_runner_artifact_stderr" 2>/dev/null || true)"

  if [[ -n "$label" ]]; then
    printf '[FAIL] %s\n' "$label"
  else
    printf '[FAIL] command %s\n' "$uuid"
  fi
  printf '  command:   %s\n' "${cmdline:-?}"
  printf '  exit code: %s\n' "$exit_code"
  if [[ -n "$stderr" ]]; then
    printf '  --- stderr ---\n'
    printf '%s\n' "$stderr" | sed 's/^/  /'
    printf '  --- end stderr ---\n'
  fi
  if [[ -n "$stdout" ]]; then
    printf '  --- stdout ---\n'
    printf '%s\n' "$stdout" | sed 's/^/  /'
    printf '  --- end stdout ---\n'
  fi
}

# runner_format_failures
# All failed commands in creation order (session-wide).
runner_format_failures() {
  local uuid

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    runner_format_failure "$uuid"
    printf '\n'
  done < <(runner_session_failed_ids)
}

# runner_failure_stderr_hint <uuid>
# First non-empty stderr line, trimmed for email summaries.
runner_failure_stderr_hint() {
  local -r uuid="$1"
  local hint

  hint="$(runner_read "$uuid" "$_runner_artifact_stderr" 2>/dev/null \
    | grep -m1 '.' || true)"
  hint="${hint#"${hint%%[![:space:]]*}"}"
  hint="${hint%"${hint##*[![:space:]]}"}"
  if [[ ${#hint} -gt 160 ]]; then
    hint="${hint:0:157}..."
  fi
  printf '%s' "$hint"
}

# runner_failures_to_json
# JSON array of {label, exit_code, stderr_hint} for all failed commands.
runner_failures_to_json() {
  local uuid label exit_code hint
  local -a rows=()
  local row

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    label="$(runner_read "$uuid" "$_runner_artifact_label" 2>/dev/null || true)"
    exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '0')"
    hint="$(runner_failure_stderr_hint "$uuid")"
    if ! command -v jq >/dev/null 2>&1; then
      continue
    fi
    row="$(jq -nc \
      --arg label "$label" \
      --argjson exit_code "$exit_code" \
      --arg stderr_hint "$hint" \
      '{label: $label, exit_code: $exit_code, stderr_hint: $stderr_hint}')"
    rows+=("$row")
  done < <(runner_session_failed_ids)

  if [[ ${#rows[@]} -eq 0 ]]; then
    printf '[]'
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf '[]'
    return 0
  fi
  printf '%s\n' "${rows[@]}" | jq -s '.'
}

# runner_report_append_command_failures <body_lines_array_name> [--log-file PATH]
# Appends a concise email section listing every failed runner command in order.
runner_report_append_command_failures() {
  local -n _rr_body_lines="$1"
  shift
  local log_file=""
  local uuid label exit_code hint count=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --log-file)
        log_file="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    count=$(( count + 1 ))
  done < <(runner_session_failed_ids)

  if (( count == 0 )); then
    return 0
  fi

  _rr_body_lines+=("Command failures (${count}):")
  _rr_body_lines+=("")
  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    label="$(runner_read "$uuid" "$_runner_artifact_label" 2>/dev/null || true)"
    exit_code="$(runner_read_exit "$uuid" 2>/dev/null || printf '?')"
    hint="$(runner_failure_stderr_hint "$uuid")"
    if [[ -z "$label" ]]; then
      label="command ${uuid}"
    fi
    if [[ -n "$hint" ]]; then
      _rr_body_lines+=("  - ${label} (exit ${exit_code}): ${hint}")
    else
      _rr_body_lines+=("  - ${label} (exit ${exit_code})")
    fi
  done < <(runner_session_failed_ids)
  _rr_body_lines+=("")
  if [[ -n "$log_file" ]]; then
    _rr_body_lines+=("See log file for full command output:")
    _rr_body_lines+=("  ${log_file}")
    _rr_body_lines+=("")
  fi
}

# runner_tail_lines <text> [max_lines]
# Keeps the last N lines of captured output for email/report snippets.
runner_tail_lines() {
  local -r text="${1:-}"
  local -r max_lines="${2:-40}"
  if [[ -z "$text" ]]; then
    return 0
  fi
  printf '%s\n' "$text" | tail -n "$max_lines"
}

# runner_last_failure_capture_stderr [max_lines]
runner_last_failure_capture_stderr() {
  local uuid text
  uuid="$(runner_session_failed_ids | tail -n 1)"
  [[ -n "$uuid" ]] || return 0
  text="$(runner_read "$uuid" "$_runner_artifact_stderr" 2>/dev/null || true)"
  runner_tail_lines "$text" "${1:-40}"
}

# runner_last_failure_capture_stdout [max_lines]
runner_last_failure_capture_stdout() {
  local uuid text
  uuid="$(runner_session_failed_ids | tail -n 1)"
  [[ -n "$uuid" ]] || return 0
  text="$(runner_read "$uuid" "$_runner_artifact_stdout" 2>/dev/null || true)"
  runner_tail_lines "$text" "${1:-40}"
}

# record_first_failure <message>
# Overwrites on each call so the final value matches the exit-triggering failure.
record_first_failure() {
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" ]]; then
    printf '%s\n' "$*" >"${RUNNER_FIRST_FAILURE_FILE}"
  fi
}

run_command() {
  local -r label="$1"
  shift

  local exit_code
  exit_code=0
  runner_exec "$label" --stream-stdout -- "$@" || exit_code=$?

  if [[ "$exit_code" -ne 0 ]]; then
    local failed_uuid stderr_first_line
    failed_uuid="$(runner_last_id)"
    if [[ -n "$failed_uuid" ]]; then
      stderr_first_line="$(runner_read "$failed_uuid" "$_runner_artifact_stderr" 2>/dev/null \
        | grep -m1 '.' || true)"
      if [[ -n "$stderr_first_line" ]]; then
        record_first_failure "${label}: ${stderr_first_line}"
      else
        record_first_failure "${label} (exit ${exit_code})"
      fi
      runner_format_failure "$failed_uuid" >&2
    else
      record_first_failure "${label} (exit ${exit_code})"
      printf '[FAIL] %s\n' "$label" >&2
      printf '  exit code: %d\n' "$exit_code" >&2
    fi
  fi

  return "$exit_code"
}

run_command_or_die() {
  local exit_code
  exit_code=0
  run_command "$@" || exit_code=$?
  if [[ "$exit_code" -ne 0 ]]; then
    exit "$exit_code"
  fi
}
