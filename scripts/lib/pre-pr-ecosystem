# Print which repo-practices audit the job will run and the path that chose it.
prec_announce_repo_practices_scope() {
  local trigger

  if trigger="$(prec_org_wide_lint_trigger "$1")"; then
    printf '==> repo-practices-lint: running org-wide: %s changed\n' "$trigger"
  else
    printf '==> repo-practices-lint: per-repo only, no org-wide template changed\n'
  fi
}

# prec_org_lint_cache_file <org>
# Where the last passing org-wide audit is recorded (one line: "<fingerprint> <epoch>").
prec_org_lint_cache_file() {
  local -r org="$1"
  printf '%s/org-lint-pass.%s\n' "${PRE_PR_CHECKS_CACHE_DIR:-${HOME}/scratch/repository-helpers}" "$org"
}

# prec_org_lint_fingerprint <root> <org> <lint_script>
# Prints a hash of everything the org-wide audit reads that a branch can change or that moves with the org:
# this checkout's audit script and org-wide templates at HEAD, plus every org repository's default-branch SHA
# (one paginated GraphQL listing, so the cost is a few calls however many worktrees ask). Returns non-zero
# when any part cannot be read, so the caller runs the audit instead of trusting a partial key.
prec_org_lint_fingerprint() {
  local -r root="$1"
  local -r org="$2"
  local -r lint_script="$3"
  local gh_api_script tree_listing remote_listing audit_root audit_roots=("$root") audit_paths untracked_files
  # shellcheck disable=SC2016  # GraphQL variables ($org, $endCursor), not shell expansions
  local -r query='query($org: String!, $endCursor: String) { organization(login: $org) {
    repositories(first: 100, after: $endCursor) { nodes { nameWithOwner defaultBranchRef { target { oid } } }
    pageInfo { hasNextPage endCursor } } } }'

  gh_api_script="${lint_script%/*}/gh-api"
  [[ -x "$gh_api_script" ]] || return 1
  audit_paths=(scripts/github-repo-lint scripts/lib/repo-practices scripts/lib/repo-practices-agents
    scripts/lib/repo-practices-cursor scripts/lib/repo-practices-workflows .agents/rules
    scripts/lib/release-age-defaults scripts/lib/agent-review-reviewers scripts/lib/ci-shellcheck
    scripts/lib/ci-secret-scan)
  # A consumer repo runs the audit from a separate helpers clone: key on that clone's files too.
  audit_root="$(cd -P -- "${lint_script%/*}/.." 2>/dev/null && pwd -P)" || return 1
  if [[ "$audit_root" != "$(cd -P -- "$root" && pwd -P)" ]]; then
    audit_roots+=("$audit_root")
  fi
  tree_listing=''
  for audit_root in "${audit_roots[@]}"; do
    # HEAD tree, plus uncommitted edits and untracked files, because the audit reads the working tree
    tree_listing+="$(runner_exec_stdout "prec org-lint fingerprint templates" -- git -C "$audit_root" ls-tree -r HEAD \
      -- "${audit_paths[@]}")" || return 1
    tree_listing+="$(runner_exec_stdout "prec org-lint fingerprint edits" -- git -C "$audit_root" diff HEAD \
      -- "${audit_paths[@]}")" || return 1
    # Untracked files, ignored ones included, are keyed by content: the audit reads them from the working tree.
    mapfile -d '' -t untracked_files < <(git -C "$audit_root" ls-files -z --others -- "${audit_paths[@]}") \
      || return 1
    if (( ${#untracked_files[@]} > 0 )); then
      tree_listing+="$(runner_exec_stdout "prec org-lint fingerprint untracked" -- git -C "$audit_root" hash-object \
        -- "${untracked_files[@]}")" || return 1
      tree_listing+="${untracked_files[*]}"
    fi
  done
  remote_listing="$(runner_exec_stdout "prec org-lint fingerprint remote SHAs" -- "$gh_api_script" api graphql \
    --paginate -f query="$query" -f org="$org" \
    --jq '.data.organization.repositories.nodes[] | "\(.nameWithOwner) \(.defaultBranchRef.target.oid // "-")"')" \
    || return 1
  [[ -n "$remote_listing" ]] || return 1
  printf '%s\n%s\n%s\n' "$org" "$tree_listing" "$(LC_ALL=C sort <<<"$remote_listing")" | sha256sum | cut -d' ' -f1
}

# prec_org_lint_cache_ttl — seconds a passing audit stays valid; 0 turns the cache off. Prints nothing and
# returns non-zero for an invalid value.
prec_org_lint_cache_ttl() {
  local -r ttl="${PRE_PR_CHECKS_ORG_LINT_CACHE_TTL:-21600}"
  [[ "$ttl" =~ ^[0-9]{1,9}$ ]] || return 1
  printf '%s\n' "$((10#$ttl))"
}

# prec_org_lint_cache_hit <fingerprint> <org> — true when the last passing audit has this fingerprint and is
# younger than the TTL.
prec_org_lint_cache_hit() {
  local -r fingerprint="$1"
  local -r org="$2"
  local file ttl cached_fp cached_at
  file="$(prec_org_lint_cache_file "$org")"
  ttl="$(prec_org_lint_cache_ttl)" || return 1
  (( ttl > 0 )) || return 1
  [[ -f "$file" ]] || return 1
  read -r cached_fp cached_at <"$file" || return 1
  [[ "$cached_fp" == "$fingerprint" && "$cached_at" =~ ^[0-9]+$ ]] || return 1
  (( cached_at <= EPOCHSECONDS && EPOCHSECONDS - cached_at < ttl ))
}

# prec_org_lint_cache_store <fingerprint> <org> — record a passing audit (atomic, best effort).
prec_org_lint_cache_store() {
  local -r fingerprint="$1"
  local -r org="$2"
  local file dir
  file="$(prec_org_lint_cache_file "$org")"
  dir="${file%/*}"
  mkdir -p -- "$dir" 2>/dev/null || return 0
  printf '%s %s\n' "$fingerprint" "$EPOCHSECONDS" >"${file}.$$.tmp" 2>/dev/null || return 0
  mv -- "${file}.$$.tmp" "$file" 2>/dev/null || rm -f -- "${file}.$$.tmp"
  return 0
}

prec_run_repo_practices_lint() {
  local -r root="$1"
  local slug org lint_script trigger lint_exit_code=0 cache_ttl fingerprint=''
  local -r org_timeout="${PRE_PR_CHECKS_ORG_LINT_TIMEOUT:-3600}"

  slug="$(gh_slug_from_repo_dir "$root")" || {
    printf '==> warn: repo-practices-lint skipped (origin is not a GitHub OWNER/NAME remote)\n' >&2
    return 0
  }
  lint_script="$(prec_resolve_github_repo_lint_script "$root")" || {
    printf '==> warn: repo-practices-lint skipped (scripts/github-repo-lint not found)\n' >&2
    return 0
  }

  if [[ ! "$org_timeout" =~ ^[1-9][0-9]{0,5}$ ]]; then
    printf 'ERROR: PRE_PR_CHECKS_ORG_LINT_TIMEOUT must be a positive integer without leading zeros (got: %s)\n' \
      "$org_timeout" >&2
    return 2
  fi

  org="${slug%%/*}"
  if trigger="$(prec_org_wide_lint_trigger "$root")"; then
    if ! cache_ttl="$(prec_org_lint_cache_ttl)"; then
      printf 'ERROR: PRE_PR_CHECKS_ORG_LINT_CACHE_TTL must be a non-negative integer (got: %s)\n' \
        "${PRE_PR_CHECKS_ORG_LINT_CACHE_TTL:-}" >&2
      return 2
    fi
    if (( cache_ttl > 0 )) && fingerprint="$(prec_org_lint_fingerprint "$root" "$org" "$lint_script")"; then
      if prec_org_lint_cache_hit "$fingerprint" "$org"; then
        printf '==> skipped org-wide audit: %s changed, but the templates and every %s default-branch SHA\n' \
          "$trigger" "$org"
        printf '    match a passing run in the last %ss (PRE_PR_CHECKS_ORG_LINT_CACHE_TTL=0 forces the audit)\n' \
          "$cache_ttl"
        return 0
      fi
    fi
    printf '==> running org-wide: %s changed (timeout %ss)\n' "$trigger" "$org_timeout"
    run_command "pre-pr org repo-practices lint (${org})" --timeout "$org_timeout" \
      -- env NO_COLOR=1 "$lint_script" \
      --org "$org" --all --strict-onboarding --compact || lint_exit_code=$?
    if [[ -n "$fingerprint" ]]; then
      if (( lint_exit_code == 0 )); then
        prec_org_lint_cache_store "$fingerprint" "$org"
      else
        # a failing audit at this key must not leave an older pass that would skip the next run
        rm -f -- "$(prec_org_lint_cache_file "$org")"
      fi
    fi
    return "$lint_exit_code"
  fi

  printf '==> running per-repo lint only: no org-wide template changed\n'
  run_command "pre-pr repo-practices lint (${slug})" env NO_COLOR=1 "$lint_script" \
    --repo "$slug" --suggest --strict-onboarding || lint_exit_code=$?
  return "$lint_exit_code"
}

prec_run_secret_scan() {
  local -r root="$1"
  # Isolate runner session: parallel pre-pr jobs share RUNNER_SESSION_DIR and
  # runner_exec_stdout uses runner_last_id (race → wrong merge-base args).
  (
    set -euo pipefail
    unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP
    prec_run_secret_scan_in_session "$root"
  )
}

prec_run_secret_scan_in_session() {
  local -r root="$1"
  local scan_script scan_rc=0

  prec_secret_scan_set_range_env "$root"

  # Point the child (dev/secret-scan or .github/ci/secret-scan) at the cache dir
  # so ci_secret_scan_ensure installs there. Only prepend it to PATH when nothing
  # named gitleaks resolves yet — an off-version one already on PATH is handled by
  # the child's own post-install PATH prepend, and reordering here would shadow a
  # deliberately stubbed gitleaks in tests.
  export CI_SECRET_SCAN_BIN_DIR="${HOME}/.cache/repository-helpers/bin"
  if ! command -v gitleaks >/dev/null 2>&1; then
    export PATH="${CI_SECRET_SCAN_BIN_DIR}:${PATH}"
  fi

  if scan_script="$(prec_resolve_secret_scan_dev_script "$root")"; then
    run_command "pre-pr secret-scan" bash "$scan_script" "$root" || scan_rc=$?
    return "$scan_rc"
  fi
  if prec_has_secret_scan_ci_script "$root"; then
    (
      set -euo pipefail
      cd "$root"
      run_command "pre-pr secret-scan" bash .github/ci/secret-scan
    ) || scan_rc=$?
    return "$scan_rc"
  fi

  printf 'ERROR: secret-scan planned but no scripts/dev/secret-scan or .github/ci/secret-scan found\n' >&2
  return 1
}

# Export GITLEAKS_BASE/HEAD for branch-vs-main range when possible (CI-like).
prec_secret_scan_set_range_env() {
  local -r root="$1"
  local head base ref

  head=''
  head="$(runner_exec_stdout "prec secret-scan git rev-parse HEAD" \
    -- git -C "$root" rev-parse HEAD)" || head=''
  base=''
  ref=''
  if runner_exec "prec secret-scan rev-parse origin/main" --probe \
    -- git -C "$root" rev-parse --verify --quiet origin/main; then
    ref='origin/main'
  elif runner_exec "prec secret-scan rev-parse main" --probe \
    -- git -C "$root" rev-parse --verify --quiet main; then
    ref='main'
  fi
  if [[ -n "$ref" && -n "$head" ]]; then
    base="$(runner_exec_stdout "prec secret-scan merge-base ${ref}" \
      -- git -C "$root" merge-base "$ref" "$head")" || base=''
  fi
  if [[ -n "$base" && -n "$head" && "$base" != "$head" ]]; then
    export GITLEAKS_BASE="$base"
    export GITLEAKS_HEAD="$head"
  else
    unset GITLEAKS_BASE GITLEAKS_HEAD 2>/dev/null || true
  fi
}

prec_should_plan_repo_practices_lint() {
  local -r root="$1"
  local -a touched=()

  prec_collect_repo_practices_sensitive_from_diff "$root" touched
  if [[ "${#touched[@]}" -eq 0 ]]; then
    return 1
  fi
  if ! prec_resolve_github_repo_lint_script "$root" >/dev/null; then
    printf '==> note: repo-practices-sensitive paths changed but github-repo-lint not found; skipping repo-practices-lint job\n' >&2
    return 1
  fi
  return 0
}

# prec_collect_changed_markdown_files <repo_root> <out_array_name>
# Appends existing *.md paths (relative to repo_root) changed on the branch vs
# main or in the working tree; deleted files and paths with a symlink in any
# component are skipped so --fix never writes outside the repository.
prec_collect_changed_markdown_files() {
  local -r root="$1"
  local -n _prec_md_out=$2
  local -A md_seen=()
  local line relpath partial component
  local -i via_link=0

  while IFS= read -r line; do
    relpath="${line#./}"
    if [[ "$relpath" != *.md || ! -f "${root}/${relpath}" || -n "${md_seen[$relpath]:-}" ]]; then
      continue
    fi
    via_link=0
    partial="$root"
    while IFS= read -r -d '/' component; do
      partial+="/${component}"
      if [[ -L "$partial" ]]; then
        via_link=1
        break
      fi
    done <<<"${relpath}/"
    if (( via_link )); then
      continue
    fi
    md_seen[$relpath]=1
    _prec_md_out+=("$relpath")
  done < <(prec_git_diff_name_only_for_repo_practices "$root")
}

# Plan markdown-wrap when the branch changes at least one Markdown file.
prec_should_plan_markdown_wrap() {
  local -r root="$1"
  local -a files=()

  prec_collect_changed_markdown_files "$root" files
  [[ "${#files[@]}" -gt 0 ]]
}

# Flag hard line breaks inside paragraphs, list items and blockquotes of the
# changed Markdown files (repository-helpers#671).
prec_run_markdown_wrap() {
  local -r root="$1"
  local -a files=()
  local relpath rc=0

  prec_collect_changed_markdown_files "$root" files
  for relpath in "${files[@]+"${files[@]}"}"; do
    ghm_lint_repo_file "${root}/${relpath}" || rc=1
  done
  if (( rc != 0 )); then
    printf '==> fix: scripts/lint-github-markdown --repo-files --fix <file.md>… (or scripts/dev/pre-pr-checks --fix), then commit\n' >&2
  fi
  return "$rc"
}

# Join hard-wrapped lines in the changed Markdown files in place (--fix).
prec_unwrap_changed_markdown() {
  local -r root="$1"
  local -a files=()
  local relpath rc=0

  prec_collect_changed_markdown_files "$root" files
  for relpath in "${files[@]+"${files[@]}"}"; do
    ghm_unwrap_file "${root}/${relpath}" || rc=1
  done
  if (( rc != 0 )); then
    printf 'ERROR: format apply: could not unwrap every changed Markdown file (see above)\n' >&2
    return "$rc"
  fi
  printf '==> format apply: unwrapped hard line breaks in %s changed Markdown file(s)\n' \
    "${#files[@]}" >&2
}

# Plan secret-scan only when a runnable entry point exists in the check-root
# (.github/ci/secret-scan or scripts/dev/secret-scan). Do not plan on
# scripts/lib/ci-secret-scan alone — that path cannot execute without a wrapper.
prec_should_plan_secret_scan() {
  local -r root="$1"

  if prec_has_secret_scan_ci_script "$root"; then
    return 0
  fi
  if [[ -f "${root}/scripts/dev/secret-scan" ]]; then
    return 0
  fi
  return 1
}

# prec_format_detected — print comma-separated detected ecosystems (or "none").
prec_format_detected() {
  if [[ "${#prec_detected[@]}" -eq 0 ]]; then
    printf 'none'
    return 0
  fi
  local IFS=','
  printf '%s' "${prec_detected[*]}"
}

# prec_format_planned_jobs — print comma-separated planned jobs (or "none").
prec_format_planned_jobs() {
  if [[ "${#prec_planned_jobs[@]}" -eq 0 ]]; then
    printf 'none'
    return 0
  fi
  local IFS=','
  printf '%s' "${prec_planned_jobs[*]}"
}

# prec_job_is_planned <job_name>
prec_job_is_planned() {
  local -r name="$1"
  local j
  for j in "${prec_planned_jobs[@]+"${prec_planned_jobs[@]}"}"; do
    [[ "$j" == "$name" ]] && return 0
  done
  return 1
}

# prec_require_tools_for_planned — die if a tool needed by a planned job is missing.
prec_require_tools_for_planned() {
  local need_actionlint=0 need_rg=0 need_uv=0 need_pnpm=0 need_cargo=0 need_gh=0

  # No shellcheck gate: job_shellcheck bootstraps the pinned binary itself via
  # scripts/lib/ci-shellcheck (mirrors gitleaks / the secret-scan job, #594).
  prec_job_is_planned 'actionlint' && need_actionlint=1
  prec_job_is_planned 'tests' && need_rg=1
  prec_job_is_planned 'python-static' && need_uv=1
  prec_job_is_planned 'pytest-hermetic' && need_uv=1
  prec_job_is_planned 'ts-web' && need_pnpm=1
  prec_job_is_planned 'ts-root' && need_pnpm=1
  prec_job_is_planned 'cargo-fmt' && need_cargo=1
  prec_job_is_planned 'cargo-clippy' && need_cargo=1
  prec_job_is_planned 'repo-practices-lint' && need_gh=1

  command -v bash >/dev/null 2>&1 || prec_die "bash not found on PATH"

  if [[ "$need_actionlint" -eq 1 ]]; then
    command -v actionlint >/dev/null 2>&1 \
      || prec_die "actionlint not found on PATH (required for planned actionlint job)"
  fi
  if [[ "$need_rg" -eq 1 ]]; then
    command -v rg >/dev/null 2>&1 \
      || prec_die "rg (ripgrep) not found on PATH (required by tests; see CI workflow)"
  fi
  if [[ "$need_uv" -eq 1 ]]; then
    command -v uv >/dev/null 2>&1 \
      || prec_die "uv not found on PATH. Install: https://docs.astral.sh/uv/"
  fi
  if [[ "$need_pnpm" -eq 1 ]]; then
    command -v pnpm >/dev/null 2>&1 \
      || prec_die "pnpm not found on PATH (required for TypeScript jobs). Install: npm install -g pnpm"
  fi
  if [[ "$need_cargo" -eq 1 ]]; then
    command -v cargo >/dev/null 2>&1 \
      || prec_die "cargo not found on PATH. Install: https://www.rust-lang.org/tools/install"
  fi
  if [[ "$need_gh" -eq 1 ]]; then
    command -v gh >/dev/null 2>&1 \
      || prec_die "gh not found on PATH (required for planned repo-practices-lint job)"
  fi
}

# Set by prec_apply_formatters when at least one formatter ran.
# Consumed by scripts/dev/pre-pr-checks warn_if_format_left_dirty.
# shellcheck disable=SC2034  # read by pre-pr-checks after sourcing this lib
prec_formatters_applied=0

# prec_apply_formatters <repo_root>
# Opt-in format *apply* before check-only jobs (PRE_PR_CHECKS_FORMAT=apply / --fix).
# Mutates the worktree; caller should warn on a before→after dirty delta when applied.
prec_apply_formatters() {
  local -r root="$1"
  local applied=0

  prec_formatters_applied=0
  if prec_job_is_planned 'python-static'; then
    (
      set -euo pipefail
      cd "$root"
      # Prefer applying via ruff even when CI uses .github/ci/python-static (check-only).
      run_command "pre-pr ruff format (apply)" uv run ruff format .
    )
    applied=1
  fi
  if prec_job_is_planned 'cargo-fmt'; then
    (
      set -euo pipefail
      cd "$root"
      run_command "pre-pr cargo fmt (apply)" cargo fmt --all
    )
    applied=1
  fi
  if prec_job_is_planned 'markdown-wrap'; then
    if ! prec_unwrap_changed_markdown "$root"; then
      return 1
    fi
    applied=1
  fi
  if [[ "$applied" -eq 0 ]]; then
    printf '==> format apply: no python-static/cargo-fmt/markdown-wrap jobs planned; nothing to apply\n' >&2
  else
    # shellcheck disable=SC2034  # read by pre-pr-checks warn_if_format_left_dirty
    prec_formatters_applied=1
  fi
}

# --- Job runners (cwd: caller should pass repo_root; runners cd themselves) ---

prec_run_python_static() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    if [[ -f .github/ci/python-static ]]; then
      run_command "pre-pr python-static wrapper" bash .github/ci/python-static
      exit 0
    fi
    if [[ -f .github/ci/setup-python ]]; then
      run_command "pre-pr setup-python" bash .github/ci/setup-python
    fi
    run_command "pre-pr ruff check" uv run ruff check .
    run_command "pre-pr ruff format --check" uv run ruff format --check .
    run_command "pre-pr pyright" uv run pyright
  )
}

# Run the consumer CI hermetic pytest wrapper (mocked / offline; not -m live).
prec_run_pytest_hermetic() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    if [[ ! -f .github/ci/pytest-hermetic ]]; then
      printf 'ERROR: pytest-hermetic planned but .github/ci/pytest-hermetic missing\n' >&2
      exit 1
    fi
    run_command "pre-pr pytest-hermetic wrapper" bash .github/ci/pytest-hermetic
  )
}

prec_run_ts_web() {
  local -r root="$1"
  local -r web="${root}/web"
  local pkg="${web}/package.json"
  (
    set -euo pipefail
    cd "$web"
    run_command "pre-pr pnpm install (web)" pnpm install --frozen-lockfile
    if prec_pkg_has_script "$pkg" typecheck; then
      run_command "pre-pr pnpm typecheck (web)" pnpm run typecheck
    fi
    if prec_pkg_has_script "$pkg" build; then
      run_command "pre-pr pnpm build (web)" pnpm run build
    fi
  )
}

prec_run_ts_root() {
  local -r root="$1"
  local pkg="${root}/package.json"
  (
    set -euo pipefail
    cd "$root"
    run_command "pre-pr pnpm install (root)" pnpm install --frozen-lockfile
    if prec_pkg_has_script "$pkg" check; then
      run_command "pre-pr pnpm check (root)" pnpm run check
      exit 0
    fi
    if prec_pkg_has_script "$pkg" typecheck; then
      run_command "pre-pr pnpm typecheck (root)" pnpm run typecheck
    fi
    if prec_pkg_has_script "$pkg" lint; then
      run_command "pre-pr pnpm lint (root)" pnpm run lint
    fi
  )
}

prec_run_cargo_fmt() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    run_command "pre-pr cargo fmt" cargo fmt --all -- --check
  )
}

prec_run_cargo_clippy() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    run_command "pre-pr cargo clippy" cargo clippy --all-targets -- -D warnings
  )
}

prec_run_verified_commits() {
  local -r root="$1"
  # Isolate runner session: parallel pre-pr jobs share RUNNER_SESSION_DIR and
  # runner_exec_stdout uses runner_last_id (race → wrong rev-list / merge-base).
  (
    set -euo pipefail
    unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP
    # shellcheck disable=SC1091
    source "${_prec_lib_dir}/runner-ensure"
    pre_pr_verified_commits_run "$root"
  )
}

prec_collect_actionlint_files() {
  local -r repo_root="$1"
  local -n _al_out=$2
  local f
  _al_out=()
  shopt -s nullglob
  for f in \
    "${repo_root}"/.github/workflows/*.yml \
    "${repo_root}"/scripts/lib/repo-practices-workflows/*.yml; do
    [[ -f "$f" ]] || continue
    _al_out+=("$f")
  done
  shopt -u nullglob
}
