# shellcheck shell=bash
# scripts/lib/pre-pr-ecosystem — detect project type and run ecosystem pre-PR jobs.
#
# Detect filesystem markers first; require/invoke tools only for planned jobs.
# See repository-helpers#423.

if declare -F prec_detect_profile >/dev/null 2>&1; then
  return 0
fi

_prec_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _prec_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_prec_lib_dir}/runner-ensure"
# shellcheck disable=SC1091
source "${_prec_lib_dir}/github-repo-slug"
# shellcheck disable=SC1091
source "${_prec_lib_dir}/pre-pr-verified-commits"

# Populated by prec_detect_profile / prec_load_skip_env (lowercase; not exported).
prec_detected=()
prec_planned_jobs=()
prec_skip_jobs=()

prec_die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# prec_load_skip_env — parse PRE_PR_CHECKS_SKIP=job1,job2 into prec_skip_jobs.
prec_load_skip_env() {
  local raw="${PRE_PR_CHECKS_SKIP:-}"
  prec_skip_jobs=()
  raw="${raw//[[:space:]]/}"
  [[ -n "$raw" ]] || return 0
  IFS=',' read -r -a prec_skip_jobs <<<"$raw"
}

# prec_job_is_skipped <job_name>
prec_job_is_skipped() {
  local -r name="$1"
  local s
  for s in "${prec_skip_jobs[@]+"${prec_skip_jobs[@]}"}"; do
    [[ "$s" == "$name" ]] && return 0
  done
  return 1
}

# prec_pkg_has_script <package.json> <script_name>
prec_pkg_has_script() {
  local -r pkg="$1"
  local -r script="$2"
  [[ -f "$pkg" ]] || return 1
  grep -Eq "\"${script}\"[[:space:]]*:" "$pkg"
}

# prec_pkg_is_pnpm <package.json-dir-or-file>
# True when package.json has packageManager pnpm@… or sibling pnpm-lock.yaml exists.
prec_pkg_is_pnpm() {
  local root_or_pkg="$1"
  local pkg dir
  if [[ -f "$root_or_pkg" ]]; then
    pkg="$root_or_pkg"
    dir="$(dirname "$pkg")"
  else
    dir="$root_or_pkg"
    pkg="${dir}/package.json"
  fi
  [[ -f "$pkg" ]] || return 1
  if [[ -f "${dir}/pnpm-lock.yaml" ]]; then
    return 0
  fi
  grep -Eq '"packageManager"[[:space:]]*:[[:space:]]*"pnpm@' "$pkg"
}

prec_has_python() {
  local -r root="$1"
  [[ -f "${root}/pyproject.toml" ]]
}

# True when the repo ships the CI hermetic pytest wrapper (consumer pattern).
prec_has_pytest_hermetic() {
  local -r root="$1"
  [[ -f "${root}/.github/ci/pytest-hermetic" ]]
}

prec_has_web_ts() {
  local -r root="$1"
  [[ -f "${root}/web/package.json" ]]
}

prec_has_root_ts() {
  local -r root="$1"
  [[ -f "${root}/package.json" ]] || return 1
  [[ -f "${root}/web/package.json" ]] && return 1
  prec_pkg_is_pnpm "$root"
}

prec_has_rust() {
  local -r root="$1"
  [[ -f "${root}/Cargo.toml" ]]
}

prec_has_workflows() {
  local -r root="$1"
  local f
  shopt -s nullglob
  local -a files=(
    "${root}"/.github/workflows/*.yml
    "${root}"/scripts/lib/repo-practices-workflows/*.yml
  )
  shopt -u nullglob
  for f in "${files[@]+"${files[@]}"}"; do
    [[ -f "$f" ]] && return 0
  done
  return 1
}

# actionlint when helpers-style (CI runs it) or consumer workflows already invoke actionlint.
prec_should_run_actionlint() {
  local -r root="$1"
  local f
  prec_is_helpers_style "$root" && return 0
  shopt -s nullglob
  local -a wfs=( "${root}"/.github/workflows/*.yml )
  shopt -u nullglob
  for f in "${wfs[@]+"${wfs[@]}"}"; do
    [[ -f "$f" ]] || continue
    if grep -qF 'actionlint' "$f"; then
      return 0
    fi
  done
  return 1
}

prec_has_bash_tests() {
  local -r root="$1"
  local f
  shopt -s nullglob
  local -a tests=( "${root}"/tests/*.test )
  shopt -u nullglob
  for f in "${tests[@]+"${tests[@]}"}"; do
    [[ -f "$f" ]] && return 0
  done
  return 1
}

# Canonical CI secret-scan script adopted in the check-root.
prec_has_secret_scan_ci_script() {
  local -r root="$1"
  [[ -f "${root}/.github/ci/secret-scan" ]]
}

# Helpers-style repos (this project): scripts/dev/pre-pr-checks + CI-shaped shell globs.
prec_is_helpers_style() {
  local -r root="$1"
  [[ -f "${root}/scripts/dev/pre-pr-checks" ]]
}

# Prefer consumer wrapper when present (domesti-bot .github/ci/shellcheck).
prec_has_shellcheck_wrapper() {
  local -r root="$1"
  [[ -f "${root}/.github/ci/shellcheck" ]]
}

# Plan bash-n/shellcheck only for helpers-style or repos with an explicit shellcheck wrapper.
# Avoid -S info on consumer release scripts that their CI does not shellcheck.
prec_should_run_shell_jobs() {
  local -r root="$1"
  prec_is_helpers_style "$root" || prec_has_shellcheck_wrapper "$root"
}

# prec_shell_file_eligible <abs-or-rel-path>
# Skip non-shell extensions and non-shell shebangs (python/perl/…). Allow no shebang
# (sourced libs with `# shellcheck shell=bash`, matching CI globs) and bash/sh shebangs.
prec_shell_file_eligible() {
  local -r path="$1"
  local base first_line
  [[ -f "$path" ]] || return 1
  base="$(basename "$path")"
  case "$base" in
    *.py|*.md|*.mdc|*.snippet|*.txt|*.yml|*.yaml|*.json|*.toml|*.rs|*.ts|*.tsx|*.js|*.jsx|*.css|*.html|*.svg)
      return 1
      ;;
  esac
  first_line=''
  IFS= read -r first_line <"$path" || true
  if [[ "$first_line" == '#!'* ]]; then
    case "$first_line" in
      *bash*|*'/sh'*|*'/env sh'*|*dash*|*ash*) ;;
      *)
        return 1
        ;;
    esac
  fi
  return 0
}

# prec_collect_shell_files <repo_root> <nameref_array>
# Prefer CI-shaped globs (scripts/*, scripts/dev/*, scripts/lib/*, tests/*, tests/lib/*)
# plus shebang-filtered .github/ci/ (consumer pattern). Skip python shebangs / non-shell.
prec_collect_shell_files() {
  local -r repo_root="$1"
  local -n _prec_out=$2
  local f line rel abs git_ls_rc
  local -a listed=()
  local -a ci_paths=()

  _prec_out=()
  shopt -s nullglob
  for f in \
    "${repo_root}"/scripts/* \
    "${repo_root}"/scripts/dev/* \
    "${repo_root}"/scripts/lib/* \
    "${repo_root}"/scripts/lib/*/* \
    "${repo_root}"/tests/* \
    "${repo_root}"/tests/lib/*; do
    [[ -f "$f" ]] || continue
    if prec_shell_file_eligible "$f"; then
      _prec_out+=("$f")
    fi
  done
  shopt -u nullglob

  if [[ -d "${repo_root}/.github/ci" ]]; then
    ci_paths=('.github/ci')
    # Single-line runner_exec so adoption ratchet sees the wrapper (not a bare git line).
    git_ls_rc=0
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      listed+=("$line")
    done < <(runner_exec_stdout "prec git ls-files .github/ci" -- git -C "$repo_root" ls-files -c -o --exclude-standard -- "${ci_paths[@]}") || git_ls_rc=$?
    if [[ "$git_ls_rc" -ne 0 ]]; then
      printf '==> warn: git ls-files .github/ci failed (exit %s); skipping those paths\n' \
        "$git_ls_rc" >&2
    fi
    for rel in "${listed[@]+"${listed[@]}"}"; do
      abs="${repo_root}/${rel}"
      if prec_shell_file_eligible "$abs"; then
        _prec_out+=("$abs")
      fi
    done
  fi
}

prec_has_shell_targets() {
  local -r root="$1"
  local -a files=()
  prec_collect_shell_files "$root" files
  [[ "${#files[@]}" -gt 0 ]]
}

# prec_plan_add_job <job_name> — append to prec_planned_jobs unless skipped.
prec_plan_add_job() {
  local -r name="$1"
  if prec_job_is_skipped "$name"; then
    printf '==> skip job (PRE_PR_CHECKS_SKIP): %s\n' "$name" >&2
    return 0
  fi
  prec_planned_jobs+=("$name")
}

# prec_detect_profile <repo_root>
# Sets prec_detected and prec_planned_jobs. Filesystem + cheap git ls-files only.
prec_detect_profile() {
  local -r root="$1"
  local -a files=()

  prec_load_skip_env
  prec_detected=()
  prec_planned_jobs=()

  if prec_has_python "$root"; then
    prec_detected+=('python')
    prec_plan_add_job 'python-static'
    # Same hermetic subset CI runs — not live Graph / network tests (issue #555).
    if prec_has_pytest_hermetic "$root"; then
      prec_plan_add_job 'pytest-hermetic'
    fi
  fi
  if prec_has_web_ts "$root"; then
    prec_detected+=('ts-web')
    prec_plan_add_job 'ts-web'
    if [[ -f "${root}/package.json" ]] && prec_pkg_is_pnpm "$root"; then
      printf '==> note: web/ and root pnpm both present; planning ts-web only (root skipped)\n' >&2
    fi
  elif prec_has_root_ts "$root"; then
    prec_detected+=('ts-root')
    prec_plan_add_job 'ts-root'
  fi
  if prec_has_rust "$root"; then
    prec_detected+=('rust')
    prec_plan_add_job 'cargo-fmt'
    prec_plan_add_job 'cargo-clippy'
  fi

  prec_collect_shell_files "$root" files
  if prec_should_run_shell_jobs "$root" && [[ "${#files[@]}" -gt 0 || -f "${root}/.github/ci/shellcheck" ]]; then
    prec_detected+=('shell')
    if prec_is_helpers_style "$root" || [[ "${#files[@]}" -gt 0 ]]; then
      prec_plan_add_job 'bash-n'
    fi
    prec_plan_add_job 'shellcheck'
  fi
  if prec_should_run_actionlint "$root"; then
    prec_detected+=('workflows')
    prec_plan_add_job 'actionlint'
  fi
  if prec_has_bash_tests "$root"; then
    prec_detected+=('bash-tests')
    prec_plan_add_job 'tests'
  fi
  if prec_should_plan_repo_practices_lint "$root"; then
    prec_detected+=('repo-practices')
    prec_plan_add_job 'repo-practices-lint'
  fi
  if prec_should_plan_secret_scan "$root"; then
    prec_detected+=('secret-scan')
    prec_plan_add_job 'secret-scan'
  fi
  if pre_pr_verified_commits_should_plan "$root"; then
    prec_detected+=('verified-commits')
    prec_plan_add_job 'verified-commits'
  fi
}

# True when a changed path should trigger org repo-practices audit before submit.
prec_relpath_is_repo_practices_sensitive() {
  local -r relpath="$1"

  [[ "$relpath" == .github/* ]] && return 0
  [[ "$relpath" == .cursor/rules/* ]] && return 0
  case "$relpath" in
    pnpm-workspace.yaml) return 0 ;;
    release-please-config.json) return 0 ;;
    .release-please-manifest.json) return 0 ;;
    scripts/lib/repo-practices) return 0 ;;
    scripts/lib/repo-practices-cursor/*) return 0 ;;
    scripts/lib/repo-practices-workflows/*) return 0 ;;
    web/pnpm-workspace.yaml) return 0 ;;
    *) return 1 ;;
  esac
}

# True when the branch diff adds or changes org-wide cursor-rule enforcement.
prec_branch_touches_org_cursor_rule_enforcement() {
  local -r root="$1"
  local -a touched=()

  prec_collect_repo_practices_sensitive_from_diff "$root" touched
  if [[ "${#touched[@]}" -eq 0 ]]; then
    return 1
  fi
  local relpath
  for relpath in "${touched[@]}"; do
    case "$relpath" in
      .cursor/rules/*|scripts/lib/repo-practices-cursor/*|scripts/lib/repo-practices)
        return 0
        ;;
    esac
  done
  return 1
}

# Append unique repo-practices-sensitive paths from a git diff name-only stream.
prec_collect_repo_practices_sensitive_from_diff() {
  local -r root="$1"
  local -n _prec_sensitive_out=$2
  local -a seen=()
  local relpath line dup=0 s

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    relpath="${line#./}"
    if ! prec_relpath_is_repo_practices_sensitive "$relpath"; then
      continue
    fi
    dup=0
    for s in "${seen[@]+"${seen[@]}"}"; do
      if [[ "$s" == "$relpath" ]]; then
        dup=1
        break
      fi
    done
    if (( dup == 0 )); then
      seen+=("$relpath")
      _prec_sensitive_out+=("$relpath")
    fi
  done < <(prec_git_diff_name_only_for_repo_practices "$root")
}

# Name-only diff vs main plus staged/unstaged edits on HEAD.
prec_git_diff_name_only_for_repo_practices() {
  local -r root="$1"
  local ref diff_exit_code=0

  ref=''
  if runner_exec "prec git rev-parse origin/main" --probe \
    -- git -C "$root" rev-parse --verify --quiet origin/main; then
    ref='origin/main'
  elif runner_exec "prec git rev-parse main" --probe \
    -- git -C "$root" rev-parse --verify --quiet main; then
    ref='main'
  fi

  if [[ -n "$ref" ]]; then
    runner_exec_stdout "prec git diff name-only vs ${ref}" \
      -- git -C "$root" diff --name-only "${ref}...HEAD" \
      || diff_exit_code=$?
    if (( diff_exit_code != 0 )); then
      printf '==> warn: git diff vs %s failed (exit %s); using working-tree diff only\n' \
        "$ref" "$diff_exit_code" >&2
    fi
  fi

  runner_exec_stdout "prec git diff name-only working tree" \
    -- git -C "$root" diff --name-only HEAD \
    || true
  runner_exec_stdout "prec git diff name-only cached" \
    -- git -C "$root" diff --name-only --cached HEAD \
    || true
}

prec_resolve_github_repo_lint_script() {
  local -r root="$1"
  local helpers_dir candidate

  if [[ -f "${root}/scripts/github-repo-lint" ]]; then
    printf '%s\n' "${root}/scripts/github-repo-lint"
    return 0
  fi
  helpers_dir="${REPOSITORY_HELPERS_DIR:-}"
  if [[ -n "$helpers_dir" && -f "${helpers_dir}/scripts/github-repo-lint" ]]; then
    printf '%s\n' "${helpers_dir}/scripts/github-repo-lint"
    return 0
  fi
  candidate="${root}/../repository-helpers/scripts/github-repo-lint"
  if [[ -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  candidate="${HOME}/work/ai/repository-helpers/scripts/github-repo-lint"
  if [[ -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}

# Resolve scripts/dev/secret-scan from the check-root or a helpers checkout.
prec_resolve_secret_scan_dev_script() {
  local -r root="$1"
  local helpers_dir candidate

  if [[ -f "${root}/scripts/dev/secret-scan" ]]; then
    printf '%s\n' "${root}/scripts/dev/secret-scan"
    return 0
  fi
  helpers_dir="${REPOSITORY_HELPERS_DIR:-}"
  if [[ -n "$helpers_dir" && -f "${helpers_dir}/scripts/dev/secret-scan" ]]; then
    printf '%s\n' "${helpers_dir}/scripts/dev/secret-scan"
    return 0
  fi
  candidate="${root}/../repository-helpers/scripts/dev/secret-scan"
  if [[ -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  candidate="${HOME}/work/ai/repository-helpers/scripts/dev/secret-scan"
  if [[ -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}

prec_run_repo_practices_lint() {
  local -r root="$1"
  local slug org lint_script lint_exit_code=0

  slug="$(gh_slug_from_repo_dir "$root")" || {
    printf '==> warn: repo-practices-lint skipped (origin is not a GitHub OWNER/NAME remote)\n' >&2
    return 0
  }
  lint_script="$(prec_resolve_github_repo_lint_script "$root")" || {
    printf '==> warn: repo-practices-lint skipped (scripts/github-repo-lint not found)\n' >&2
    return 0
  }

  org="${slug%%/*}"
  if prec_branch_touches_org_cursor_rule_enforcement "$root"; then
    run_command "pre-pr org repo-practices lint (${org})" env NO_COLOR=1 "$lint_script" \
      --org "$org" --all --strict-onboarding --compact || lint_exit_code=$?
    return "$lint_exit_code"
  fi

  run_command "pre-pr repo-practices lint (${slug})" env NO_COLOR=1 "$lint_script" \
    --repo "$slug" --suggest --strict-onboarding || lint_exit_code=$?
  return "$lint_exit_code"
}

prec_run_secret_scan() {
  local -r root="$1"
  # Isolate runner session: parallel pre-pr jobs share RUNNER_SESSION_DIR and
  # runner_exec_stdout uses runner_last_id (race → wrong merge-base args).
  (
    set -euo pipefail
    unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP
    prec_run_secret_scan_in_session "$root"
  )
}

prec_run_secret_scan_in_session() {
  local -r root="$1"
  local scan_script scan_rc=0

  prec_secret_scan_set_range_env "$root"

  # Point the child (dev/secret-scan or .github/ci/secret-scan) at the cache dir
  # so ci_secret_scan_ensure installs there. Only prepend it to PATH when nothing
  # named gitleaks resolves yet — an off-version one already on PATH is handled by
  # the child's own post-install PATH prepend, and reordering here would shadow a
  # deliberately stubbed gitleaks in tests.
  export CI_SECRET_SCAN_BIN_DIR="${HOME}/.cache/repository-helpers/bin"
  if ! command -v gitleaks >/dev/null 2>&1; then
    export PATH="${CI_SECRET_SCAN_BIN_DIR}:${PATH}"
  fi

  if scan_script="$(prec_resolve_secret_scan_dev_script "$root")"; then
    run_command "pre-pr secret-scan" bash "$scan_script" "$root" || scan_rc=$?
    return "$scan_rc"
  fi
  if prec_has_secret_scan_ci_script "$root"; then
    (
      set -euo pipefail
      cd "$root"
      run_command "pre-pr secret-scan" bash .github/ci/secret-scan
    ) || scan_rc=$?
    return "$scan_rc"
  fi

  printf 'ERROR: secret-scan planned but no scripts/dev/secret-scan or .github/ci/secret-scan found\n' >&2
  return 1
}

# Export GITLEAKS_BASE/HEAD for branch-vs-main range when possible (CI-like).
prec_secret_scan_set_range_env() {
  local -r root="$1"
  local head base ref

  head=''
  head="$(runner_exec_stdout "prec secret-scan git rev-parse HEAD" \
    -- git -C "$root" rev-parse HEAD)" || head=''
  base=''
  ref=''
  if runner_exec "prec secret-scan rev-parse origin/main" --probe \
    -- git -C "$root" rev-parse --verify --quiet origin/main; then
    ref='origin/main'
  elif runner_exec "prec secret-scan rev-parse main" --probe \
    -- git -C "$root" rev-parse --verify --quiet main; then
    ref='main'
  fi
  if [[ -n "$ref" && -n "$head" ]]; then
    base="$(runner_exec_stdout "prec secret-scan merge-base ${ref}" \
      -- git -C "$root" merge-base "$ref" "$head")" || base=''
  fi
  if [[ -n "$base" && -n "$head" && "$base" != "$head" ]]; then
    export GITLEAKS_BASE="$base"
    export GITLEAKS_HEAD="$head"
  else
    unset GITLEAKS_BASE GITLEAKS_HEAD 2>/dev/null || true
  fi
}

prec_should_plan_repo_practices_lint() {
  local -r root="$1"
  local -a touched=()

  prec_collect_repo_practices_sensitive_from_diff "$root" touched
  if [[ "${#touched[@]}" -eq 0 ]]; then
    return 1
  fi
  if ! prec_resolve_github_repo_lint_script "$root" >/dev/null; then
    printf '==> note: repo-practices-sensitive paths changed but github-repo-lint not found; skipping repo-practices-lint job\n' >&2
    return 1
  fi
  return 0
}

# Plan secret-scan only when a runnable entry point exists in the check-root
# (.github/ci/secret-scan or scripts/dev/secret-scan). Do not plan on
# scripts/lib/ci-secret-scan alone — that path cannot execute without a wrapper.
prec_should_plan_secret_scan() {
  local -r root="$1"

  if prec_has_secret_scan_ci_script "$root"; then
    return 0
  fi
  if [[ -f "${root}/scripts/dev/secret-scan" ]]; then
    return 0
  fi
  return 1
}

# prec_format_detected — print comma-separated detected ecosystems (or "none").
prec_format_detected() {
  if [[ "${#prec_detected[@]}" -eq 0 ]]; then
    printf 'none'
    return 0
  fi
  local IFS=','
  printf '%s' "${prec_detected[*]}"
}

# prec_format_planned_jobs — print comma-separated planned jobs (or "none").
prec_format_planned_jobs() {
  if [[ "${#prec_planned_jobs[@]}" -eq 0 ]]; then
    printf 'none'
    return 0
  fi
  local IFS=','
  printf '%s' "${prec_planned_jobs[*]}"
}

# prec_job_is_planned <job_name>
prec_job_is_planned() {
  local -r name="$1"
  local j
  for j in "${prec_planned_jobs[@]+"${prec_planned_jobs[@]}"}"; do
    [[ "$j" == "$name" ]] && return 0
  done
  return 1
}

# prec_require_tools_for_planned — die if a tool needed by a planned job is missing.
prec_require_tools_for_planned() {
  local need_actionlint=0 need_rg=0 need_uv=0 need_pnpm=0 need_cargo=0 need_gh=0

  # No shellcheck gate: job_shellcheck bootstraps the pinned binary itself via
  # scripts/lib/ci-shellcheck (mirrors gitleaks / the secret-scan job, #594).
  prec_job_is_planned 'actionlint' && need_actionlint=1
  prec_job_is_planned 'tests' && need_rg=1
  prec_job_is_planned 'python-static' && need_uv=1
  prec_job_is_planned 'pytest-hermetic' && need_uv=1
  prec_job_is_planned 'ts-web' && need_pnpm=1
  prec_job_is_planned 'ts-root' && need_pnpm=1
  prec_job_is_planned 'cargo-fmt' && need_cargo=1
  prec_job_is_planned 'cargo-clippy' && need_cargo=1
  prec_job_is_planned 'repo-practices-lint' && need_gh=1

  command -v bash >/dev/null 2>&1 || prec_die "bash not found on PATH"

  if [[ "$need_actionlint" -eq 1 ]]; then
    command -v actionlint >/dev/null 2>&1 \
      || prec_die "actionlint not found on PATH (required for planned actionlint job)"
  fi
  if [[ "$need_rg" -eq 1 ]]; then
    command -v rg >/dev/null 2>&1 \
      || prec_die "rg (ripgrep) not found on PATH (required by tests; see CI workflow)"
  fi
  if [[ "$need_uv" -eq 1 ]]; then
    command -v uv >/dev/null 2>&1 \
      || prec_die "uv not found on PATH. Install: https://docs.astral.sh/uv/"
  fi
  if [[ "$need_pnpm" -eq 1 ]]; then
    command -v pnpm >/dev/null 2>&1 \
      || prec_die "pnpm not found on PATH (required for TypeScript jobs). Install: npm install -g pnpm"
  fi
  if [[ "$need_cargo" -eq 1 ]]; then
    command -v cargo >/dev/null 2>&1 \
      || prec_die "cargo not found on PATH. Install: https://www.rust-lang.org/tools/install"
  fi
  if [[ "$need_gh" -eq 1 ]]; then
    command -v gh >/dev/null 2>&1 \
      || prec_die "gh not found on PATH (required for planned repo-practices-lint job)"
  fi
}

# Set by prec_apply_formatters when at least one formatter ran.
# Consumed by scripts/dev/pre-pr-checks warn_if_format_left_dirty.
# shellcheck disable=SC2034  # read by pre-pr-checks after sourcing this lib
prec_formatters_applied=0

# prec_apply_formatters <repo_root>
# Opt-in format *apply* before check-only jobs (PRE_PR_CHECKS_FORMAT=apply / --fix).
# Mutates the worktree; caller should warn on a before→after dirty delta when applied.
prec_apply_formatters() {
  local -r root="$1"
  local applied=0

  prec_formatters_applied=0
  if prec_job_is_planned 'python-static'; then
    (
      set -euo pipefail
      cd "$root"
      # Prefer applying via ruff even when CI uses .github/ci/python-static (check-only).
      run_command "pre-pr ruff format (apply)" uv run ruff format .
    )
    applied=1
  fi
  if prec_job_is_planned 'cargo-fmt'; then
    (
      set -euo pipefail
      cd "$root"
      run_command "pre-pr cargo fmt (apply)" cargo fmt --all
    )
    applied=1
  fi
  if [[ "$applied" -eq 0 ]]; then
    printf '==> format apply: no python-static/cargo-fmt jobs planned; nothing to apply\n' >&2
  else
    # shellcheck disable=SC2034  # read by pre-pr-checks warn_if_format_left_dirty
    prec_formatters_applied=1
  fi
}

# --- Job runners (cwd: caller should pass repo_root; runners cd themselves) ---

prec_run_python_static() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    if [[ -f .github/ci/python-static ]]; then
      run_command "pre-pr python-static wrapper" bash .github/ci/python-static
      exit 0
    fi
    if [[ -f .github/ci/setup-python ]]; then
      run_command "pre-pr setup-python" bash .github/ci/setup-python
    fi
    run_command "pre-pr ruff check" uv run ruff check .
    run_command "pre-pr ruff format --check" uv run ruff format --check .
    run_command "pre-pr pyright" uv run pyright
  )
}

# Run the consumer CI hermetic pytest wrapper (mocked / offline; not -m live).
prec_run_pytest_hermetic() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    if [[ ! -f .github/ci/pytest-hermetic ]]; then
      printf 'ERROR: pytest-hermetic planned but .github/ci/pytest-hermetic missing\n' >&2
      exit 1
    fi
    run_command "pre-pr pytest-hermetic wrapper" bash .github/ci/pytest-hermetic
  )
}

prec_run_ts_web() {
  local -r root="$1"
  local -r web="${root}/web"
  local pkg="${web}/package.json"
  (
    set -euo pipefail
    cd "$web"
    run_command "pre-pr pnpm install (web)" pnpm install --frozen-lockfile
    if prec_pkg_has_script "$pkg" typecheck; then
      run_command "pre-pr pnpm typecheck (web)" pnpm run typecheck
    fi
    if prec_pkg_has_script "$pkg" build; then
      run_command "pre-pr pnpm build (web)" pnpm run build
    fi
  )
}

prec_run_ts_root() {
  local -r root="$1"
  local pkg="${root}/package.json"
  (
    set -euo pipefail
    cd "$root"
    run_command "pre-pr pnpm install (root)" pnpm install --frozen-lockfile
    if prec_pkg_has_script "$pkg" check; then
      run_command "pre-pr pnpm check (root)" pnpm run check
      exit 0
    fi
    if prec_pkg_has_script "$pkg" typecheck; then
      run_command "pre-pr pnpm typecheck (root)" pnpm run typecheck
    fi
    if prec_pkg_has_script "$pkg" lint; then
      run_command "pre-pr pnpm lint (root)" pnpm run lint
    fi
  )
}

prec_run_cargo_fmt() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    run_command "pre-pr cargo fmt" cargo fmt --all -- --check
  )
}

prec_run_cargo_clippy() {
  local -r root="$1"
  (
    set -euo pipefail
    cd "$root"
    run_command "pre-pr cargo clippy" cargo clippy --all-targets -- -D warnings
  )
}

prec_run_verified_commits() {
  local -r root="$1"
  # Isolate runner session: parallel pre-pr jobs share RUNNER_SESSION_DIR and
  # runner_exec_stdout uses runner_last_id (race → wrong rev-list / merge-base).
  (
    set -euo pipefail
    unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP
    # shellcheck disable=SC1091
    source "${_prec_lib_dir}/runner-ensure"
    pre_pr_verified_commits_run "$root"
  )
}

prec_collect_actionlint_files() {
  local -r repo_root="$1"
  local -n _al_out=$2
  local f
  _al_out=()
  shopt -s nullglob
  for f in \
    "${repo_root}"/.github/workflows/*.yml \
    "${repo_root}"/scripts/lib/repo-practices-workflows/*.yml; do
    [[ -f "$f" ]] || continue
    _al_out+=("$f")
  done
  shopt -u nullglob
}
