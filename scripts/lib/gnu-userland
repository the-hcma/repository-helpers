# shellcheck shell=bash
# gnu-userland — require GNU sed/grep/date/timeout on macOS after PATH bootstrap.
#
# Linux distros already ship GNU userland. On Darwin, Homebrew gnubin must be
# on PATH (see tooling_path_prepend_gnu_userland) or scripts silently pick up
# BSD /usr/bin tools and fail in confusing ways.
#
# Defines:
#   tooling_prereq_command_is_gnu
#   tooling_prereq_collect_gnu_userland
#   tooling_prereq_check_gnu_userland

if declare -F tooling_prereq_check_gnu_userland >/dev/null 2>&1; then
  return 0
fi

_gu_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _gu_lib_dir
# shellcheck disable=SC1091
source "${_gu_lib_dir}/tooling-prereqs"

# tooling_prereq_command_is_gnu <binary>
# True when `binary --version` reports GNU (coreutils / grep / sed).
tooling_prereq_command_is_gnu() {
  local -r bin="$1"

  [[ -n "$bin" && -x "$bin" ]] || return 1
  "$bin" --version 2>/dev/null | grep -q GNU
}

# tooling_prereq_collect_gnu_userland
# On macOS, note sed/grep/date/timeout/flock problems into the shared prereq
# report (does not print or reset). Returns 1 when any problem was noted.
# No-op on non-Darwin (assumes distro GNU userland).
tooling_prereq_collect_gnu_userland() {
  local tool path missing=0
  local recipe_id

  if [[ "$(uname -s)" != 'Darwin' ]]; then
    return 0
  fi

  for tool in sed grep date timeout flock; do
    # type -P ignores aliases/functions (e.g. grep --color=always).
    path="$(type -P "$tool" 2>/dev/null || true)"
    recipe_id="$tool"
    case "$tool" in
      sed) recipe_id='gnu-sed' ;;
      grep) recipe_id='gnu-grep' ;;
      date) recipe_id='date' ;;
      timeout) recipe_id='timeout' ;;
    esac
    if [[ -z "$path" ]]; then
      if [[ "$tool" == 'timeout' ]]; then
        # Homebrew coreutils also ships gtimeout outside gnubin.
        if [[ -n "$(type -P gtimeout 2>/dev/null || true)" ]]; then
          continue
        fi
        tooling_prereq_report_note timeout \
          "neither timeout(1) nor gtimeout(1) on PATH (need GNU coreutils on macOS)"
      else
        tooling_prereq_report_note "$recipe_id" \
          "'${tool}' not found in PATH (need GNU/util-linux on macOS)"
      fi
      missing=1
      continue
    fi
    # flock has no --version GNU banner; presence on PATH after util-linux prepend is enough.
    if [[ "$tool" == 'flock' ]]; then
      continue
    fi
    if ! tooling_prereq_command_is_gnu "$path"; then
      tooling_prereq_report_note "$recipe_id" \
        "'${tool}' must be GNU on macOS (got: ${path}; BSD /usr/bin is not supported)"
      missing=1
      continue
    fi
  done

  if (( missing )); then
    return 1
  fi
  return 0
}

# tooling_prereq_check_gnu_userland
# On macOS, verify sed/grep/date/timeout/flock after PATH setup. Silent on
# success; on failure prints a consolidated install plan and returns 1.
# No-op on non-Darwin (assumes distro GNU userland).
tooling_prereq_check_gnu_userland() {
  tooling_prereq_report_reset
  if tooling_prereq_collect_gnu_userland; then
    return 0
  fi
  tooling_prereq_report_finish || return 1
  return 1
}
