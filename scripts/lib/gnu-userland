# shellcheck shell=bash
# gnu-userland — require GNU sed/grep/date/timeout on macOS after PATH bootstrap.
#
# Linux distros already ship GNU userland. On Darwin, Homebrew gnubin must be
# on PATH (see tooling_path_prepend_gnu_userland) or scripts silently pick up
# BSD /usr/bin tools and fail in confusing ways.
#
# Defines:
#   tooling_prereq_command_is_gnu
#   tooling_prereq_check_gnu_userland

if declare -F tooling_prereq_check_gnu_userland >/dev/null 2>&1; then
  return 0
fi

_gu_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _gu_lib_dir
# shellcheck disable=SC1091
source "${_gu_lib_dir}/tooling-prereqs"

# tooling_prereq_command_is_gnu <binary>
# True when `binary --version` reports GNU (coreutils / grep / sed).
tooling_prereq_command_is_gnu() {
  local -r bin="$1"

  [[ -n "$bin" && -x "$bin" ]] || return 1
  "$bin" --version 2>/dev/null | grep -q GNU
}

# tooling_prereq_check_gnu_userland
# On macOS, verify sed/grep/date/timeout/flock after PATH setup. Silent on
# success; on failure prints brew install hints and returns 1.
# No-op on non-Darwin (assumes distro GNU userland).
tooling_prereq_check_gnu_userland() {
  local tool path missing=0
  local line
  local -a problems=()

  if [[ "$(uname -s)" != 'Darwin' ]]; then
    return 0
  fi

  for tool in sed grep date timeout flock; do
    # type -P ignores aliases/functions (e.g. grep --color=always).
    path="$(type -P "$tool" 2>/dev/null || true)"
    if [[ -z "$path" ]]; then
      problems+=("  ERROR: '${tool}' not found in PATH (need GNU/util-linux on macOS).")
      missing=1
      continue
    fi
    # flock has no --version GNU banner; presence on PATH after util-linux prepend is enough.
    if [[ "$tool" == 'flock' ]]; then
      continue
    fi
    if ! tooling_prereq_command_is_gnu "$path"; then
      problems+=(
        "  ERROR: '${tool}' must be GNU on macOS (got: ${path}; BSD /usr/bin is not supported)."
      )
      missing=1
      continue
    fi
  done

  if (( missing )); then
    tooling_prereq_emit '[gnu userland]'
    for line in "${problems[@]}"; do
      tooling_prereq_emit "$line"
    done
    tooling_prereq_emit '  Install: brew install coreutils gnu-sed grep util-linux'
    tooling_prereq_emit \
      '  Scripts prepend Homebrew prefixes via tooling_path_prepend_gnu_userland.'
    return 1
  fi
  return 0
}
