#!/usr/bin/env bash
# dev-worktree-guard — stack worktree discipline for dev submit/review scripts.
#
# Feature work must run from a Graphite stack worktree (.worktrees/<stack>-wt), not
# the primary clone. The primary worktree must stay clean (empty git status --porcelain).

_dwg_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _dwg_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_dwg_lib_dir}/runner-ensure"

dwg_runner_last_stdout() {
  local uuid

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || return 0
  runner_read "$uuid" stdout 2>/dev/null || true
}

dwg_git_show_toplevel() {
  local -r start_dir="$1"
  local exit_code

  exit_code=0
  runner_exec "git rev-parse show-toplevel" -- git -C "$start_dir" rev-parse --show-toplevel \
    || exit_code=$?
  if (( exit_code != 0 )); then
    return 1
  fi
  dwg_runner_last_stdout
}

# dev_resolve_target_repo_dir <label> [start_dir]
# Resolves the target repo from start_dir (default $PWD) via dwg_git_show_toplevel —
# not from the calling script's own BASH_SOURCE location — so a script invoked via an
# absolute path from a different repo's worktree still operates on the caller's repo,
# not the script's own checkout (repository-helpers#590). Prints the resolved path on
# stdout with no newline-stripping — command substitution already strips the single
# trailing newline git emits, and stripping embedded newlines would corrupt a
# (rare but valid) path that contains one. On failure, prints an ERROR line
# prefixed with <label> to stderr and returns 1.
dev_resolve_target_repo_dir() {
  local -r label="${1:-dev-worktree-guard}"
  local -r start_dir="${2:-$PWD}"
  local resolved

  resolved="$(dwg_git_show_toplevel "$start_dir")" || {
    printf 'ERROR: %s: not inside a git repository (cwd: %s)\n' "$label" "$start_dir" >&2
    return 1
  }
  printf '%s' "$resolved"
}

dev_worktree_primary_path() {
  local start_dir="${1:-$PWD}"
  local dwg_repo_root exit_code wt_list primary

  dwg_repo_root="$(dwg_git_show_toplevel "$start_dir" || true)"
  [[ -n "$dwg_repo_root" ]] || return 1
  dwg_repo_root="${dwg_repo_root//$'\n'/}"
  exit_code=0
  runner_exec "git worktree list primary" -- git -C "$dwg_repo_root" worktree list --porcelain \
    || exit_code=$?
  if (( exit_code != 0 )); then
    return 1
  fi
  wt_list="$(dwg_runner_last_stdout)"
  primary="$(printf '%s' "$wt_list" | awk '/^worktree / { sub(/^worktree /, ""); print; exit }')"
  [[ -n "$primary" ]] || return 1
  printf '%s' "$primary"
}

dev_worktree_is_primary() {
  # dwg_* locals: callers (ship-and-review) often have script-level readonly repo_dir.
  local dwg_repo_dir="${1:-}"
  local primary toplevel

  if [[ -z "$dwg_repo_dir" ]]; then
    toplevel="$(dwg_git_show_toplevel "$PWD" || true)"
    dwg_repo_dir="${toplevel//$'\n'/}"
  fi
  [[ -n "$dwg_repo_dir" ]] || return 1
  primary="$(dev_worktree_primary_path "$dwg_repo_dir")"
  [[ -n "$primary" ]] || return 1
  [[ "$dwg_repo_dir" == "$primary" ]]
}

# Exit non-zero when cwd repo root is the primary (main) worktree.
dev_assert_stack_worktree() {
  # dwg_* locals: callers (ship-and-review) often have script-level readonly repo_dir.
  local dwg_repo_dir="${1:-}"
  local toplevel

  if [[ -z "$dwg_repo_dir" ]]; then
    toplevel="$(dwg_git_show_toplevel "$PWD" || true)"
    dwg_repo_dir="${toplevel//$'\n'/}"
  fi

  if dev_worktree_is_primary "$dwg_repo_dir"; then
    printf 'ERROR: Forbidden on primary worktree (%s).\n' "$dwg_repo_dir" >&2
    printf 'Run scripts/dev/start-development --worktree <stack> --no-interactive and cd .worktrees/<stack>-wt\n' >&2
    return 1
  fi
  return 0
}

# Exit non-zero when the primary worktree has any porcelain output.
dev_assert_main_worktree_clean() {
  local start_dir="${1:-$PWD}"
  local primary status exit_code

  primary="$(dev_worktree_primary_path "$start_dir")"
  [[ -n "$primary" ]] || return 1
  exit_code=0
  runner_exec "git status porcelain primary" -- git -C "$primary" status --porcelain \
    || exit_code=$?
  if (( exit_code != 0 )); then
    printf 'ERROR: Could not read primary worktree status (%s).\n' "$primary" >&2
    return 1
  fi
  status="$(dwg_runner_last_stdout)"
  # `?? .github/` when the marker is the only (untracked) file in that dir.
  if [[ "$status" == '?? .github/secret-audit.json' ]] \
    || { [[ "$status" == '?? .github/' ]] && [[ -f "${primary}/.github/secret-audit.json" ]]; }; then
    printf 'ERROR: Primary worktree has a stray .github/secret-audit.json (%s).\n' "$primary" >&2
    printf 'That is a legacy secret-audit marker. Intake state now lives in a host-local\n' >&2
    printf 'ledger, not in git (repository-helpers#573) — just delete the leftover:\n' >&2
    printf '  rm %q\n' "${primary}/.github/secret-audit.json" >&2
    return 1
  fi
  if [[ -n "$status" ]]; then
    printf 'ERROR: Primary worktree has local changes (%s):\n' "$primary" >&2
    printf '%s\n' "$status" >&2
    printf 'Commit, stash, or discard changes on main before continuing.\n' >&2
    return 1
  fi
  return 0
}
