#!/usr/bin/env bash
# dev-worktree-guard — stack worktree discipline for dev submit/review scripts.
#
# Feature work must run from a Graphite stack worktree (.worktrees/<stack>-wt), not
# the primary clone. The primary worktree must stay clean (empty git status --porcelain).

dev_worktree_primary_path() {
  local start_dir="${1:-$PWD}"
  local repo_root

  repo_root="$(git -C "$start_dir" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || return 1
  git -C "$repo_root" worktree list --porcelain | awk 'NR==1{print $2}'
}

dev_worktree_is_primary() {
  local repo_dir="${1:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
  local primary

  [[ -n "$repo_dir" ]] || return 1
  primary="$(dev_worktree_primary_path "$repo_dir")"
  [[ -n "$primary" ]] || return 1
  [[ "$repo_dir" == "$primary" ]]
}

# Exit non-zero when cwd repo root is the primary (main) worktree.
dev_assert_stack_worktree() {
  local repo_dir="${1:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"

  if dev_worktree_is_primary "$repo_dir"; then
    printf 'ERROR: Forbidden on primary worktree (%s).\n' "$repo_dir" >&2
    printf 'Run scripts/dev/start-development --worktree <stack> --no-interactive and cd .worktrees/<stack>-wt\n' >&2
    return 1
  fi
  return 0
}

# Exit non-zero when the primary worktree has any porcelain output.
dev_assert_main_worktree_clean() {
  local start_dir="${1:-$PWD}"
  local primary status

  primary="$(dev_worktree_primary_path "$start_dir")"
  [[ -n "$primary" ]] || return 1
  status="$(git -C "$primary" status --porcelain 2>/dev/null || true)"
  if [[ -n "$status" ]]; then
    printf 'ERROR: Primary worktree has local changes (%s):\n' "$primary" >&2
    printf '%s\n' "$status" >&2
    printf 'Commit, stash, or discard changes on main before continuing.\n' >&2
    return 1
  fi
  return 0
}
