#!/usr/bin/env bash
# email-multipart — write multipart/alternative RFC-822 messages (plain + HTML pre).
#
# Matches the layout used by dep-updater-notifier: monospace body in text/plain and
# HTML <pre> for mail clients that prefer HTML.
set -euo pipefail

# repo_helpers_email_write_multipart <to> <from> <reply_to> <subject> <body> [boundary_prefix]
# Writes a complete MIME message to stdout.
repo_helpers_email_write_multipart() {
  local -r to_addr="$1"
  local -r from_addr="$2"
  local -r reply_to="$3"
  local -r subject="$4"
  local -r body="$5"
  local boundary_prefix="${6:-dep-updater}"
  local boundary html_body

  boundary="${boundary_prefix}-$(date +%s%N | md5sum | head -c16)"
  html_body="$(printf '%s' "$body" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"

  printf 'To: %s\n' "$to_addr"
  printf 'From: %s\n' "$from_addr"
  printf 'Reply-To: %s\n' "$reply_to"
  printf 'Subject: %s\n' "$subject"
  printf 'MIME-Version: 1.0\n'
  printf 'Content-Type: multipart/alternative; boundary="%s"\n' "$boundary"
  printf '\n'
  printf -- '--%s\n' "$boundary"
  printf 'Content-Type: text/plain; charset="utf-8"\n'
  printf 'Content-Transfer-Encoding: 8bit\n'
  printf '\n'
  printf '%s\n' "$body"
  printf '\n'
  printf -- '--%s\n' "$boundary"
  printf 'Content-Type: text/html; charset="utf-8"\n'
  printf 'Content-Transfer-Encoding: 8bit\n'
  printf '\n'
  printf '<!DOCTYPE html><html><body>\n'
  printf '<pre style="font-family:monospace,monospace;font-size:13px;line-height:1.4">\n'
  printf '%s\n' "$html_body"
  printf '</pre>\n'
  printf '</body></html>\n'
  printf '\n'
  printf -- '--%s--\n' "$boundary"
}
