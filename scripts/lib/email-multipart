#!/usr/bin/env bash
# email-multipart — write multipart/alternative RFC-822 messages (plain + HTML pre).
#
# Matches the layout used by dep-updater-notifier: monospace body in text/plain and
# HTML <pre> for mail clients that prefer HTML.
set -euo pipefail

# repo_helpers_email_html_from_plain <plain-text>
# Escape HTML specials and wrap https:// URLs in <a href>. Trailing sentence
# punctuation is left outside the href; query-string & becomes &amp; in both
# the attribute and visible text (correct HTML).
repo_helpers_email_html_from_plain() {
  # Prefer em_* names: callers often have script-level readonly subject/body/plain.
  local -r em_plain="$1"

  # awk: one pass so we linkify before / as part of escaping (avoids breaking
  # <a> tags, and keeps & in query strings as &amp; inside href).
  printf '%s' "$em_plain" | awk '
    function html_esc(s) {
      gsub(/&/, "\\&amp;", s)
      gsub(/</, "\\&lt;", s)
      gsub(/>/, "\\&gt;", s)
      gsub(/"/, "\\&quot;", s)
      return s
    }
    {
      line = $0
      out = ""
      while (match(line, /https:\/\/[^[:space:]"<>]+/)) {
        pre = substr(line, 1, RSTART - 1)
        url = substr(line, RSTART, RLENGTH)
        line = substr(line, RSTART + RLENGTH)
        while ((n = length(url)) > 0) {
          last = substr(url, n, 1)
          # Trailing sentence / bracket punctuation stays outside the href.
          if (index(".,;:!?)]}", last) == 0) {
            break
          }
          line = last line
          url = substr(url, 1, n - 1)
        }
        if (url == "") {
          continue
        }
        esc = html_esc(url)
        out = out html_esc(pre) "<a href=\"" esc "\">" esc "</a>"
      }
      print out html_esc(line)
    }
  '
}

# repo_helpers_email_write_multipart <to> <from> <reply_to> <subject> <body> [boundary_prefix]
# Writes a complete MIME message to stdout.
#
# Locals use em_* names so script-level readonly subject/body (e.g. notifier)
# cannot collide — bash rejects local subject when subject is already readonly.
repo_helpers_email_write_multipart() {
  local -r em_to="$1"
  local -r em_from="$2"
  local -r em_reply_to="$3"
  local -r em_subject="$4"
  local -r em_body="$5"
  local em_boundary_prefix="${6:-dep-updater}"
  local em_boundary em_html_body

  em_boundary="${em_boundary_prefix}-$(date +%s%N | md5sum | head -c16)"
  em_html_body="$(repo_helpers_email_html_from_plain "$em_body")"

  printf 'To: %s\n' "$em_to"
  printf 'From: %s\n' "$em_from"
  printf 'Reply-To: %s\n' "$em_reply_to"
  printf 'Subject: %s\n' "$em_subject"
  printf 'MIME-Version: 1.0\n'
  printf 'Content-Type: multipart/alternative; boundary="%s"\n' "$em_boundary"
  printf '\n'
  printf -- '--%s\n' "$em_boundary"
  printf 'Content-Type: text/plain; charset="utf-8"\n'
  printf 'Content-Transfer-Encoding: 8bit\n'
  printf '\n'
  printf '%s\n' "$em_body"
  printf '\n'
  printf -- '--%s\n' "$em_boundary"
  printf 'Content-Type: text/html; charset="utf-8"\n'
  printf 'Content-Transfer-Encoding: 8bit\n'
  printf '\n'
  printf '<!DOCTYPE html><html><body>\n'
  printf '<pre style="font-family:monospace,monospace;font-size:13px;line-height:1.4">\n'
  printf '%s\n' "$em_html_body"
  printf '</pre>\n'
  printf '</body></html>\n'
  printf '\n'
  printf -- '--%s--\n' "$em_boundary"
}
