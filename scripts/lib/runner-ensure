#!/usr/bin/env bash
# scripts/lib/runner-ensure — load runner helpers without owning session lifecycle.
#
# Use in scripts/lib/* that may call run_command/runner_exec. The top-level script
# must call runner_session_begin or source runner-bootstrap before external commands.
#
# Usage:
#   source "${lib_dir}/runner-ensure"
set -euo pipefail

if declare -F runner_exec >/dev/null 2>&1; then
  return 0
fi

_runner_ensure_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _runner_ensure_dir
# shellcheck disable=SC1091
source "${_runner_ensure_dir}/runner"
