# on_deploy_deps_load_library <repo_dir>
# Sources on-deploy-deps into the current shell.
on_deploy_deps_load_library() {
  local repo_dir="$1"
  local lib_path

  lib_path="$(on_deploy_deps_find_lib_path "$repo_dir")" || {
    echo "on-deploy: repository-helpers scripts/lib/on-deploy-deps not found" >&2
    echo "  Clone https://github.com/the-hcma/repository-helpers as a sibling of this repo," >&2
    echo "  set REPOSITORY_HELPERS_DIR, or install at ~/work/ai/repository-helpers." >&2
    return 1
  }
  # shellcheck source=/dev/null
  source "$lib_path"
}
