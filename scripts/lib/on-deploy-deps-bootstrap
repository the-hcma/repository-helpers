# shellcheck shell=bash
# on-deploy-deps-bootstrap — load scripts/lib/on-deploy-deps without a prior source.
#
# Service on-deploy hooks must source this file, then call on_deploy_deps_load_library:
#
#   # shellcheck source=/dev/null
#   source "${_rh}/scripts/lib/on-deploy-deps-bootstrap"
#   on_deploy_deps_load_library "$repo_dir"
#
# Environment:
#   REPOSITORY_HELPERS_DIR  Optional path to a repository-helpers checkout root.

# on_deploy_deps_find_lib_path <repo_dir>
# Prints the path to scripts/lib/on-deploy-deps. Returns 1 when not found.
on_deploy_deps_find_lib_path() {
  local repo_dir="$1"
  local candidate rh_root

  if [[ -n "${REPOSITORY_HELPERS_DIR:-}" ]]; then
    candidate="${REPOSITORY_HELPERS_DIR}/scripts/lib/on-deploy-deps"
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  rh_root=""
  if cd "${repo_dir}/../repository-helpers" 2>/dev/null; then
    rh_root="$(pwd)"
  fi
  if [[ -n "$rh_root" ]]; then
    candidate="${rh_root}/scripts/lib/on-deploy-deps"
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  if [[ -n "${HOME:-}" ]]; then
    candidate="${HOME}/work/ai/repository-helpers/scripts/lib/on-deploy-deps"
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  return 1
}

