# shellcheck shell=bash
# tooling-prereqs — tool presence checks, version lines, and install hints.
#
# Logging: uses log_prereq when the sourcing script defines it; otherwise stderr.
#
# Defines:
#   tooling_prereq_emit
#   tooling_prereq_tool_path
#   tooling_prereq_missing_message
#   tooling_prereq_check_tools
#   tooling_prereq_check_ecosystem_tools
#   tooling_prereq_describe_tool_line
#   tooling_prereq_pip_audit_usable

tooling_prereq_emit() {
  if declare -F log_prereq &>/dev/null; then
    log_prereq "$@"
  else
    printf '%s\n' "$*" >&2
  fi
}

tooling_prereq_tool_path() {
  command -v "$1" 2>/dev/null || true
}

tooling_prereq_missing_message() {
  local -r tool="$1"

  case "$tool" in
    gt)     printf '%s' "  ERROR: 'gt' (Graphite CLI) not found. Install: https://graphite.dev/docs/install" ;;
    gh)     printf '%s' "  ERROR: 'gh' (GitHub CLI) not found.    Install: https://cli.github.com" ;;
    jq)     printf '%s' "  ERROR: 'jq' not found.                 Install: https://jqlang.github.io/jq/download/" ;;
    rg)     printf '%s' "  ERROR: 'rg' (ripgrep) not found.       Install: https://github.com/BurntSushi/ripgrep#installation" ;;
    git)    printf '%s' "  ERROR: 'git' is required but not found in PATH." ;;
    pnpm)   printf '%s' "ERROR: 'pnpm' is required for npm projects."$'\n'"       Install: npm install -g pnpm" ;;
    yarn)   printf '%s' "ERROR: 'yarn' is required for npm projects."$'\n'"       Install: npm install -g yarn" ;;
    npm)
      printf '%s\n%s' \
        "ERROR: 'npm' is required for npm projects." \
        "       'npm' should be installed with Node.js: https://nodejs.org"
      ;;
    pip)    printf '%s' "ERROR: 'pip' (or 'pip3') is required for Python projects." ;;
    uv)     printf '%s' "ERROR: 'uv' not found.     Install: https://docs.astral.sh/uv/" ;;
    poetry) printf '%s' "ERROR: 'poetry' not found. Install: https://python-poetry.org/docs/" ;;
    pipenv) printf '%s' "ERROR: 'pipenv' not found. Run: pip install pipenv" ;;
    cargo)
      printf '%s\n%s' \
        "ERROR: 'cargo' is required for Rust projects." \
        "       Install: https://www.rust-lang.org/tools/install"
      ;;
    cargo-outdated)
      printf '%s\n%s' \
        "ERROR: 'cargo outdated' is required for Rust projects." \
        "       Install: cargo install cargo-outdated"
      ;;
    *)
      if [[ "$tool" == *' '* ]]; then
        printf '%s' "  ERROR: '${tool}' is required but not found in PATH."
      else
        printf '%s' "ERROR: '${tool}' is required but not found."
      fi
      ;;
  esac
}

# tooling_prereq_check_tools [--no-versions] <header> <tool>...
# Prints status for each tool. Returns the number of missing tools.
tooling_prereq_check_tools() {
  local with_versions=1
  local header tool path version missing

  if [[ "${1:-}" == "--no-versions" ]]; then
    with_versions=0
    shift
  fi

  header="${1:?}"
  shift
  missing=0
  tooling_prereq_emit "$header"

  for tool in "$@"; do
    path="$(tooling_prereq_tool_path "$tool")"
    if [[ -z "$path" ]]; then
      if (( with_versions )); then
        tooling_prereq_emit "$(tooling_prereq_missing_message "$tool")"
      else
        tooling_prereq_emit "  ERROR: '${tool}' is required but not found in PATH."
      fi
      missing=$(( missing + 1 ))
    elif (( with_versions )); then
      version="$("$tool" --version 2>/dev/null | head -1 || echo '?')"
      tooling_prereq_emit "  ${tool}: ${path} (${version})"
    fi
  done

  return "$missing"
}

# tooling_prereq_check_ecosystem_tools <has_npm:0|1> <npm_tool> <py_tool>
# Returns the number of missing ecosystem tools.
tooling_prereq_check_ecosystem_tools() {
  # Names must not collide with dep-updater script-level readonlys (has_npm, py_tool).
  local -r want_npm="${1:-0}"
  local npm_name="${2:-}"
  local py_name="${3:-}"
  local missing=0
  local tool_to_check

  if [[ "$want_npm" == '1' ]]; then
    tool_to_check="$npm_name"
    [[ -z "$tool_to_check" ]] && tool_to_check="pnpm"
    if ! command -v "$tool_to_check" &>/dev/null; then
      tooling_prereq_emit "$(tooling_prereq_missing_message "$tool_to_check")"
      missing=$(( missing + 1 ))
    fi
  fi

  if [[ -n "$py_name" ]]; then
    if [[ "$py_name" == 'pip' ]]; then
      if ! command -v pip &>/dev/null && ! command -v pip3 &>/dev/null; then
        tooling_prereq_emit "$(tooling_prereq_missing_message pip)"
        missing=$(( missing + 1 ))
      fi
    elif ! command -v "$py_name" &>/dev/null; then
      tooling_prereq_emit "$(tooling_prereq_missing_message "$py_name")"
      missing=$(( missing + 1 ))
    fi
  fi

  return "$missing"
}

# tooling_prereq_pip_audit_usable <py_tool>
# Returns 0 when pip-audit can be invoked for the given Python toolchain.
tooling_prereq_pip_audit_usable() {
  local -r audit_py_tool="${1:-}"

  if [[ "$audit_py_tool" == 'uv' ]]; then
    command -v pip-audit &>/dev/null \
      || uv run --no-project --with pip-audit pip-audit --version &>/dev/null 2>&1
    return $?
  fi
  command -v pip-audit &>/dev/null
}

# tooling_prereq_describe_tool_line <tool> [py_tool]
# Prints one indented "tool: path (version)" line to stdout (no trailing newline required).
tooling_prereq_describe_tool_line() {
  local -r tool="$1"
  local -r describe_py_tool="${2:-}"
  local path version

  if [[ "$tool" == 'pip-audit' && "$describe_py_tool" == 'uv' ]]; then
    path="(via uv run)"
    version="$(uv run --no-project --with pip-audit pip-audit --version 2>/dev/null | head -1 || echo '?')"
  elif [[ "$tool" == 'cargo-outdated' ]]; then
    path="$(tooling_prereq_tool_path cargo)"
    [[ -z "$path" ]] && path='(not found)'
    version="$(cargo outdated -V 2>/dev/null | head -1 || echo '?')"
  else
    path="$(tooling_prereq_tool_path "$tool")"
    [[ -z "$path" ]] && path='(not found)'
    if [[ "$path" == '(not found)' ]]; then
      version='?'
    else
      version="$("$tool" --version 2>/dev/null | head -1 || echo '?')"
    fi
  fi
  printf '  %s: %s (%s)' "$tool" "$path" "$version"
}
