# shellcheck shell=bash
# tooling-prereqs — tool presence checks, version lines, and install hints.
#
# Logging: uses log_prereq when the sourcing script defines it; otherwise stderr.
#
# Multi-miss reporting: call tooling_prereq_report_reset, note each miss with
# tooling_prereq_report_note / tooling_prereq_report_note_any, then
# tooling_prereq_report_finish (prints every miss + one consolidated install plan).
#
# Defines:
#   tooling_prereq_emit
#   tooling_prereq_tool_path
#   tooling_prereq_missing_message
#   tooling_prereq_check_tools
#   tooling_prereq_check_ecosystem_tools
#   tooling_prereq_describe_tool_line
#   tooling_prereq_pip_audit_usable
#   tooling_prereq_can_manage_packages
#   tooling_prereq_report_reset
#   tooling_prereq_report_note
#   tooling_prereq_report_note_any
#   tooling_prereq_report_count
#   tooling_prereq_report_finish

if declare -F tooling_prereq_check_tools >/dev/null 2>&1; then
  return 0
fi

set -euo pipefail

_tp_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _tp_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_tp_lib_dir}/runner-ensure"

# tp_runner_exec_stdout <label> -- <cmd> [args…]
tp_runner_exec_stdout() {
  local -r label="$1"
  shift
  runner_exec_stdout "$label" "$@"
}

# Report accumulator (reset between check sessions).
_tp_report_lines=()
_tp_report_ids=()
_tp_report_brew=()
_tp_report_apt=()
_tp_report_manual=()

tooling_prereq_emit() {
  if declare -F log_prereq &>/dev/null; then
    log_prereq "$@"
  else
    printf '%s\n' "$*" >&2
  fi
}

tooling_prereq_tool_path() {
  command -v "$1" 2>/dev/null || true
}

# tooling_prereq_can_manage_packages
# True when the current user can install OS packages without escalating to a
# human admin. Override with TOOLING_PREREQ_CAN_INSTALL=0|1 for tests.
tooling_prereq_can_manage_packages() {
  local prefix uid os_name

  case "${TOOLING_PREREQ_CAN_INSTALL:-}" in
    0|false|no) return 1 ;;
    1|true|yes) return 0 ;;
  esac

  uid="$(tp_runner_exec_stdout "tooling-prereqs id -u" -- id -u)"
  if [[ "$uid" -eq 0 ]]; then
    return 0
  fi

  os_name="${TOOLING_PREREQ_UNAME:-}"
  if [[ -z "$os_name" ]]; then
    os_name="$(tp_runner_exec_stdout "tooling-prereqs uname -s" -- uname -s)"
  fi

  case "$os_name" in
    Darwin)
      command -v brew >/dev/null 2>&1 || return 1
      prefix="$(tp_runner_exec_stdout "tooling-prereqs brew --prefix" -- brew --prefix 2>/dev/null || true)"
      [[ -n "$prefix" ]] || return 1
      [[ -w "$prefix" || -w "${prefix}/Cellar" || -w "${prefix}/opt" ]]
      return $?
      ;;
    Linux)
      if command -v sudo >/dev/null 2>&1 \
        && runner_exec "tooling-prereqs sudo -n true" -- sudo -n true >/dev/null 2>&1; then
        return 0
      fi
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

tooling_prereq_report_reset() {
  _tp_report_lines=()
  _tp_report_ids=()
  _tp_report_brew=()
  _tp_report_apt=()
  _tp_report_manual=()
}

tooling_prereq_report_count() {
  printf '%s' "${#_tp_report_lines[@]}"
}

# tooling_prereq_report_add_unique <array_name> <value>
tooling_prereq_report_add_unique() {
  local -r arr_name="$1"
  local -r value="$2"
  local -n arr_ref="$arr_name"
  local existing

  [[ -n "$value" ]] || return 0
  for existing in "${arr_ref[@]+"${arr_ref[@]}"}"; do
    if [[ "$existing" == "$value" ]]; then
      return 0
    fi
  done
  arr_ref+=("$value")
}

# tooling_prereq_report_register_recipe <id>
# Maps a logical miss id to brew/apt packages and/or manual install lines.
tooling_prereq_report_register_recipe() {
  local -r id="$1"

  case "$id" in
    timeout|gtimeout|gnu-timeout|date|gnu-date)
      tooling_prereq_report_add_unique _tp_report_brew coreutils
      tooling_prereq_report_add_unique _tp_report_apt coreutils
      ;;
    sed|gnu-sed)
      tooling_prereq_report_add_unique _tp_report_brew gnu-sed
      ;;
    grep|gnu-grep)
      tooling_prereq_report_add_unique _tp_report_brew grep
      ;;
    flock)
      tooling_prereq_report_add_unique _tp_report_brew util-linux
      tooling_prereq_report_add_unique _tp_report_apt util-linux
      ;;
    gh)
      tooling_prereq_report_add_unique _tp_report_brew gh
      tooling_prereq_report_add_unique _tp_report_apt gh
      tooling_prereq_report_add_unique _tp_report_manual \
        'gh: https://cli.github.com/ (user installers available)'
      ;;
    jq)
      tooling_prereq_report_add_unique _tp_report_brew jq
      tooling_prereq_report_add_unique _tp_report_apt jq
      tooling_prereq_report_add_unique _tp_report_manual \
        'jq: https://jqlang.github.io/jq/download/'
      ;;
    rg|ripgrep)
      tooling_prereq_report_add_unique _tp_report_brew ripgrep
      tooling_prereq_report_add_unique _tp_report_apt ripgrep
      tooling_prereq_report_add_unique _tp_report_manual \
        'rg: https://github.com/BurntSushi/ripgrep#installation'
      ;;
    git)
      tooling_prereq_report_add_unique _tp_report_brew git
      tooling_prereq_report_add_unique _tp_report_apt git
      ;;
    gt)
      tooling_prereq_report_add_unique _tp_report_manual \
        'gt (Graphite CLI): https://graphite.dev/docs/install'
      ;;
    uv)
      tooling_prereq_report_add_unique _tp_report_manual \
        'uv: https://docs.astral.sh/uv/ (user install; no admin required)'
      ;;
    poetry)
      tooling_prereq_report_add_unique _tp_report_manual \
        'poetry: https://python-poetry.org/docs/'
      ;;
    pipenv)
      tooling_prereq_report_add_unique _tp_report_manual \
        'pipenv: pip install pipenv (or pip3 install --user pipenv)'
      ;;
    pnpm)
      tooling_prereq_report_add_unique _tp_report_manual \
        'pnpm: npm install -g pnpm (or corepack enable)'
      ;;
    yarn)
      tooling_prereq_report_add_unique _tp_report_manual \
        'yarn: npm install -g yarn'
      ;;
    npm|node)
      tooling_prereq_report_add_unique _tp_report_manual \
        'npm/node: https://nodejs.org'
      ;;
    pip|pip3)
      tooling_prereq_report_add_unique _tp_report_apt python3-pip
      tooling_prereq_report_add_unique _tp_report_manual \
        'pip: install Python 3 + pip (https://pip.pypa.io/)'
      ;;
    cargo)
      tooling_prereq_report_add_unique _tp_report_manual \
        'cargo: https://www.rust-lang.org/tools/install (rustup; user install)'
      ;;
    cargo-outdated)
      tooling_prereq_report_add_unique _tp_report_manual \
        'cargo-outdated: cargo install cargo-outdated'
      ;;
    *)
      ;;
  esac
}

# tooling_prereq_report_note <id> <message>
# Records one missing prerequisite. <message> is shown as-is (no ERROR: prefix).
tooling_prereq_report_note() {
  local -r id="$1"
  local -r msg="$2"
  local existing

  for existing in "${_tp_report_ids[@]+"${_tp_report_ids[@]}"}"; do
    if [[ "$existing" == "$id" ]]; then
      return 0
    fi
  done
  _tp_report_ids+=("$id")
  _tp_report_lines+=("$msg")
  tooling_prereq_report_register_recipe "$id"
}

# tooling_prereq_report_note_any <id> <message> -- <cmd>...
# Notes a miss when none of the commands are on PATH.
tooling_prereq_report_note_any() {
  local -r id="$1"
  local -r msg="$2"
  shift 2
  local cmd

  if [[ "${1:-}" == '--' ]]; then
    shift
  fi
  for cmd in "$@"; do
    if [[ -n "$(tooling_prereq_tool_path "$cmd")" ]]; then
      return 0
    fi
  done
  tooling_prereq_report_note "$id" "$msg"
}

# tooling_prereq_report_finish
# Prints all recorded misses and one consolidated install plan. Returns the
# number of misses (0 = success). Clears the report afterward.
tooling_prereq_report_finish() {
  local count line brew_cmd apt_cmd
  local can_install=0
  local os_name

  count="${#_tp_report_lines[@]}"
  if (( count == 0 )); then
    tooling_prereq_report_reset
    return 0
  fi

  tooling_prereq_emit "ERROR: missing prerequisites (${count}):"
  for line in "${_tp_report_lines[@]}"; do
    tooling_prereq_emit "  - ${line}"
  done

  if tooling_prereq_can_manage_packages; then
    can_install=1
  fi
  os_name="${TOOLING_PREREQ_UNAME:-}"
  if [[ -z "$os_name" ]]; then
    os_name="$(tp_runner_exec_stdout "tooling-prereqs uname -s" -- uname -s)"
  fi

  tooling_prereq_emit ''
  if (( can_install )); then
    tooling_prereq_emit 'Install (you appear able to run the package manager):'
  else
    tooling_prereq_emit \
      'Install (you do not appear able to run the package manager — ask an administrator to run):'
  fi

  if ((${#_tp_report_brew[@]})); then
    brew_cmd="brew install ${_tp_report_brew[*]}"
    if [[ "$os_name" == 'Darwin' ]]; then
      tooling_prereq_emit "  ${brew_cmd}"
      tooling_prereq_emit \
        '  Then ensure Homebrew gnubin dirs are on PATH (scripts call tooling_path_prepend_gnu_userland).'
    else
      tooling_prereq_emit "  # macOS: ${brew_cmd}"
    fi
  fi

  if ((${#_tp_report_apt[@]})); then
    apt_cmd="sudo apt-get install -y ${_tp_report_apt[*]}"
    if [[ "$os_name" == 'Linux' ]]; then
      tooling_prereq_emit "  ${apt_cmd}"
    else
      tooling_prereq_emit "  # Debian/Ubuntu: ${apt_cmd}"
    fi
  fi

  if ((${#_tp_report_manual[@]})); then
    tooling_prereq_emit 'Additional / user-scoped installs:'
    for line in "${_tp_report_manual[@]}"; do
      tooling_prereq_emit "  - ${line}"
    done
  fi

  tooling_prereq_report_reset
  return "$count"
}

tooling_prereq_missing_message() {
  local -r tool="$1"

  case "$tool" in
    timeout|gtimeout)
      printf '%s' "neither timeout(1) nor gtimeout(1) on PATH (need GNU coreutils)"
      ;;
    gt)     printf '%s' "'gt' (Graphite CLI) not found" ;;
    gh)     printf '%s' "'gh' (GitHub CLI) not found" ;;
    jq)     printf '%s' "'jq' not found" ;;
    rg)     printf '%s' "'rg' (ripgrep) not found" ;;
    git)    printf '%s' "'git' is required but not found in PATH" ;;
    pnpm)   printf '%s' "'pnpm' is required for npm projects" ;;
    yarn)   printf '%s' "'yarn' is required for npm projects" ;;
    npm)    printf '%s' "'npm' is required for npm projects" ;;
    pip)    printf '%s' "'pip' (or 'pip3') is required for Python projects" ;;
    uv)     printf '%s' "'uv' not found" ;;
    poetry) printf '%s' "'poetry' not found" ;;
    pipenv) printf '%s' "'pipenv' not found" ;;
    cargo)  printf '%s' "'cargo' is required for Rust projects" ;;
    cargo-outdated)
      printf '%s' "'cargo outdated' is required for Rust projects"
      ;;
    *)
      printf '%s' "'${tool}' is required but not found"
      ;;
  esac
}

# tooling_prereq_check_tools [--no-versions] <header> <tool>...
# Prints status for each tool, then a consolidated install plan when any are
# missing. Returns the number of missing tools.
tooling_prereq_check_tools() {
  local with_versions=1
  local header tool path version missing i
  local -a miss_ids=()
  local -a miss_msgs=()

  if [[ "${1:-}" == "--no-versions" ]]; then
    with_versions=0
    shift
  fi

  header="${1:?}"
  shift
  missing=0
  tooling_prereq_emit "$header"

  for tool in "$@"; do
    path="$(tooling_prereq_tool_path "$tool")"
    if [[ -z "$path" ]]; then
      miss_ids+=("$tool")
      miss_msgs+=("$(tooling_prereq_missing_message "$tool")")
      missing=$(( missing + 1 ))
    elif (( with_versions )); then
      version="$("$tool" --version 2>/dev/null | head -1 || echo '?')"
      tooling_prereq_emit "  ${tool}: ${path} (${version})"
    fi
  done

  if (( missing > 0 )); then
    tooling_prereq_report_reset
    for i in "${!miss_ids[@]}"; do
      tooling_prereq_report_note "${miss_ids[$i]}" "${miss_msgs[$i]}"
    done
    tooling_prereq_report_finish || true
  fi

  return "$missing"
}

# tooling_prereq_check_ecosystem_tools <has_npm:0|1> <npm_tool> <py_tool>
# Returns the number of missing ecosystem tools.
tooling_prereq_check_ecosystem_tools() {
  # Names must not collide with dep-updater script-level readonlys (has_npm, py_tool).
  local -r want_npm="${1:-0}"
  local npm_name="${2:-}"
  local py_name="${3:-}"
  local missing=0
  local tool_to_check i
  local -a miss_ids=()
  local -a miss_msgs=()

  if [[ "$want_npm" == '1' ]]; then
    tool_to_check="$npm_name"
    [[ -z "$tool_to_check" ]] && tool_to_check="pnpm"
    if ! command -v "$tool_to_check" &>/dev/null; then
      miss_ids+=("$tool_to_check")
      miss_msgs+=("$(tooling_prereq_missing_message "$tool_to_check")")
      missing=$(( missing + 1 ))
    fi
  fi

  if [[ -n "$py_name" ]]; then
    if [[ "$py_name" == 'pip' ]]; then
      if ! command -v pip &>/dev/null && ! command -v pip3 &>/dev/null; then
        miss_ids+=(pip)
        miss_msgs+=("$(tooling_prereq_missing_message pip)")
        missing=$(( missing + 1 ))
      fi
    elif ! command -v "$py_name" &>/dev/null; then
      miss_ids+=("$py_name")
      miss_msgs+=("$(tooling_prereq_missing_message "$py_name")")
      missing=$(( missing + 1 ))
    fi
  fi

  if (( missing > 0 )); then
    tooling_prereq_report_reset
    for i in "${!miss_ids[@]}"; do
      tooling_prereq_report_note "${miss_ids[$i]}" "${miss_msgs[$i]}"
    done
    tooling_prereq_report_finish || true
  fi

  return "$missing"
}

# tooling_prereq_pip_audit_usable <py_tool>
# Returns 0 when pip-audit can be invoked for the given Python toolchain.
tooling_prereq_pip_audit_usable() {
  local -r audit_py_tool="${1:-}"

  if [[ "$audit_py_tool" == 'uv' ]]; then
    command -v pip-audit &>/dev/null \
      || tp_runner_exec_stdout "tooling-prereqs pip-audit via uv" \
        -- uv run --no-project --no-progress --with pip-audit pip-audit --version &>/dev/null 2>&1
    return $?
  fi
  command -v pip-audit &>/dev/null
}

# tooling_prereq_describe_tool_line <tool> [py_tool]
# Prints one indented "tool: path (version)" line to stdout (no trailing newline required).
tooling_prereq_describe_tool_line() {
  local -r tool="$1"
  local -r describe_py_tool="${2:-}"
  local path version

  if [[ "$tool" == 'pip-audit' && "$describe_py_tool" == 'uv' ]]; then
    path="(via uv run)"
    version="$(tp_runner_exec_stdout "tooling-prereqs pip-audit version via uv" \
      -- uv run --no-project --no-progress --with pip-audit pip-audit --version 2>/dev/null | head -1 || echo '?')"
  elif [[ "$tool" == 'cargo-outdated' ]]; then
    path="$(tooling_prereq_tool_path cargo)"
    [[ -z "$path" ]] && path='(not found)'
    version="$(tp_runner_exec_stdout "tooling-prereqs cargo outdated version" \
      -- cargo outdated -V 2>/dev/null | head -1 || echo '?')"
  else
    path="$(tooling_prereq_tool_path "$tool")"
    [[ -z "$path" ]] && path='(not found)'
    if [[ "$path" == '(not found)' ]]; then
      version='?'
    else
      version="$("$tool" --version 2>/dev/null | head -1 || echo '?')"
    fi
  fi
  printf '  %s: %s (%s)' "$tool" "$path" "$version"
}
