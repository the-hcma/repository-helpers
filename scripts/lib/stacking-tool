# shellcheck shell=bash
#
# Shared stacking-tool preference (GitHub Stacked PRs; Graphite is retired).
# Marker file: .github/stacking-tool — single line, gh-stack. A legacy
# 'graphite' marker still parses (so the repo-practices audit can flag it) but
# nothing here will run gt: see stacking_tool_require_cli.
#
# Scripts that create/submit/restack stacks must read the marker via this lib
# rather than hardcoding gt. See issue #387.

if declare -F stacking_tool_read >/dev/null 2>&1; then
  return 0
fi

_stacking_tool_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _stacking_tool_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_stacking_tool_lib_dir}/runner-ensure"
# shellcheck disable=SC1091
source "${_stacking_tool_lib_dir}/pr-conventional-title"
# shellcheck disable=SC1091
source "${_stacking_tool_lib_dir}/github-repo-slug"

# Relative path of the preference file inside a repository clone.
# shellcheck disable=SC2034  # sourced by scripts/tests/lint
stacking_tool_marker_relpath='.github/stacking-tool'
# shellcheck disable=SC2034
readonly stacking_tool_marker_relpath

# Retired backend: recognised only so a leftover marker gets a clear message.
stacking_tool_value_graphite='graphite'
# shellcheck disable=SC2034
readonly stacking_tool_value_graphite

stacking_tool_value_gh_stack='gh-stack'
# shellcheck disable=SC2034
readonly stacking_tool_value_gh_stack

# Default written by github-repo-lint --apply-fix and used by start-development
# when the marker is missing: Graphite is retired org-wide (its merge queue
# builds unsigned commits, repository-helpers#772).
stacking_tool_org_default="${stacking_tool_value_gh_stack}"
# shellcheck disable=SC2034
readonly stacking_tool_org_default

stacking_tool_die() {
  printf 'ERROR: stacking-tool: %s\n' "$*" >&2
  exit 1
}

# stacking_tool_retired_message
# One-line explanation for a leftover 'graphite' marker.
stacking_tool_retired_message() {
  printf "%s is '%s' but Graphite is retired org-wide (its merge queue builds unsigned commits, repository-helpers#772); set it to '%s'" \
    "$stacking_tool_marker_relpath" "$stacking_tool_value_graphite" "$stacking_tool_value_gh_stack"
}

# stacking_tool_is_valid <value>
# Returns 0 when value is gh-stack, or the retired graphite value (which parses
# so the audit can report it; the runtime paths below refuse it).
stacking_tool_is_valid() {
  local -r value="${1:-}"
  [[ "$value" == "$stacking_tool_value_graphite" || "$value" == "$stacking_tool_value_gh_stack" ]]
}

# stacking_tool_normalize <raw>
# Trims whitespace/newlines; prints the normalized token (may be empty/invalid).
stacking_tool_normalize() {
  local raw="${1:-}"
  # Strip CR, leading/trailing whitespace, and keep only the first line.
  raw="${raw%%$'\n'*}"
  raw="${raw%%$'\r'*}"
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  printf '%s' "$raw"
}

# stacking_tool_marker_path <repo_dir>
stacking_tool_marker_path() {
  local -r st_dir="$1"
  printf '%s/%s' "$st_dir" "$stacking_tool_marker_relpath"
}

# stacking_tool_resolve_repo_dir [st_dir]
# Prints an absolute git toplevel. Uses repo_dir when set; otherwise cwd.
stacking_tool_resolve_repo_dir() {
  local st_dir="${1:-}"
  local resolved

  if [[ -n "$st_dir" ]]; then
    if [[ ! -d "$st_dir" ]]; then
      stacking_tool_die "repo dir is not a directory: ${st_dir}"
    fi
    # Keep runner_exec_stdout and git on one line for the runner-adoption ratchet.
    resolved="$(runner_exec_stdout "stacking-tool git rev-parse toplevel" -- git -C "$st_dir" rev-parse --show-toplevel)" \
      || stacking_tool_die "not a git repository: ${st_dir}"
  else
    resolved="$(runner_exec_stdout "stacking-tool git rev-parse toplevel (cwd)" -- git rev-parse --show-toplevel)" \
      || stacking_tool_die 'not inside a git repository'
  fi
  printf '%s' "$resolved"
}

# stacking_tool_read_optional <repo_dir>
# Prints gh-stack when the marker exists and is valid. Returns 1 when
# missing, empty, or invalid (does not die) — for lint/apply-fix defaults.
stacking_tool_read_optional() {
  local st_dir marker_path raw value

  st_dir="$(stacking_tool_resolve_repo_dir "${1:-}")" || return 1
  marker_path="$(stacking_tool_marker_path "$st_dir")"

  if [[ ! -f "$marker_path" ]]; then
    return 1
  fi

  raw="$(runner_exec_stdout "stacking-tool read marker optional" -- cat "$marker_path")" \
    || return 1
  value="$(stacking_tool_normalize "$raw")"
  if [[ -z "$value" ]] || ! stacking_tool_is_valid "$value"; then
    return 1
  fi
  printf '%s' "$value"
}

# stacking_tool_read_or_default <repo_dir> <default> [log_prefix] [missing_label]
# Prints gh-stack. Missing marker → <default> (logs to stderr).
# Empty or invalid marker → dies (do not guess).
# Optional log_prefix defaults to "stacking-tool".
# Optional missing_label defaults to "missing-marker default" (org wrapper
# passes "org default" so apply-fix / start-development keep their wording).
stacking_tool_read_or_default() {
  local st_dir marker_path raw value
  local -r fallback="${2:-}"
  local -r log_prefix="${3:-stacking-tool}"
  local -r missing_label="${4:-missing-marker default}"

  if ! stacking_tool_is_valid "$fallback"; then
    stacking_tool_die \
      "stacking_tool_read_or_default: invalid default '${fallback}' (expected '${stacking_tool_value_gh_stack}')"
  fi

  st_dir="$(stacking_tool_resolve_repo_dir "${1:-}")"
  marker_path="$(stacking_tool_marker_path "$st_dir")"

  if [[ ! -f "$marker_path" ]]; then
    printf '%s: missing %s; using %s '\''%s'\''\n' \
      "$log_prefix" "$stacking_tool_marker_relpath" "$missing_label" "$fallback" >&2
    printf '%s' "$fallback"
    return 0
  fi

  raw="$(runner_exec_stdout "stacking-tool read marker or-default" -- cat "$marker_path")" \
    || stacking_tool_die "failed to read ${marker_path}"
  value="$(stacking_tool_normalize "$raw")"

  if [[ -z "$value" ]]; then
    stacking_tool_die \
      "${stacking_tool_marker_relpath} is empty (expected '${stacking_tool_value_gh_stack}')"
  fi
  if ! stacking_tool_is_valid "$value"; then
    stacking_tool_die \
      "invalid ${stacking_tool_marker_relpath} value '${value}' (expected '${stacking_tool_value_gh_stack}')"
  fi
  printf '%s' "$value"
}

# stacking_tool_read_or_org_default <repo_dir> [log_prefix]
# Prints gh-stack. Missing marker → org default (logs to stderr).
# Empty or invalid marker → dies (do not guess).
# Optional log_prefix defaults to "stacking-tool".
stacking_tool_read_or_org_default() {
  stacking_tool_read_or_default "${1:-}" "$stacking_tool_org_default" \
    "${2:-stacking-tool}" "org default"
}

# stacking_tool_read <repo_dir>
# Prints gh-stack. Dies when the marker is missing or invalid.
stacking_tool_read() {
  local st_dir marker_path raw value

  st_dir="$(stacking_tool_resolve_repo_dir "${1:-}")"
  marker_path="$(stacking_tool_marker_path "$st_dir")"

  if [[ ! -f "$marker_path" ]]; then
    stacking_tool_die \
      "missing ${stacking_tool_marker_relpath} in ${st_dir} (expected '${stacking_tool_value_gh_stack}')"
  fi

  raw="$(runner_exec_stdout "stacking-tool read marker" -- cat "$marker_path")" \
    || stacking_tool_die "failed to read ${marker_path}"
  value="$(stacking_tool_normalize "$raw")"

  if [[ -z "$value" ]]; then
    stacking_tool_die \
      "${stacking_tool_marker_relpath} is empty (expected '${stacking_tool_value_gh_stack}')"
  fi
  if ! stacking_tool_is_valid "$value"; then
    stacking_tool_die \
      "invalid ${stacking_tool_marker_relpath} value '${value}' (expected '${stacking_tool_value_gh_stack}')"
  fi
  printf '%s' "$value"
}

# stacking_tool_require_cli <tool>
# Ensures the CLI for the selected stacking backend is available.
stacking_tool_require_cli() {
  local -r tool="$1"

  case "$tool" in
    "$stacking_tool_value_graphite")
      stacking_tool_die "$(stacking_tool_retired_message)"
      ;;
    "$stacking_tool_value_gh_stack")
      command -v gh >/dev/null 2>&1 \
        || stacking_tool_die "gh (GitHub CLI) not found on PATH (marker is ${stacking_tool_value_gh_stack})"
      # Keep runner_exec and gh on one line for the runner-adoption ratchet.
      if ! runner_exec "stacking-tool probe gh stack" -- gh stack --help >/dev/null 2>&1; then
        stacking_tool_die \
          "gh stack extension not available (install: gh extension install github/gh-stack)"
      fi
      ;;
    *)
      stacking_tool_die "unknown stacking tool '${tool}'"
      ;;
  esac
}

# stacking_tool_ensure_registered <tool> <repo_dir>
# gh-stack only: make sure the current branch of <repo_dir> belongs to a gh stack, adopting it as a
# one-branch stack (`gh stack init <branch>`) when it does not. A worktree created by hand or by
# start-development is not a stack until then, and `gh stack submit` fails with "current branch is not
# part of a stack" only after a full pre-PR checks run (repository-helpers#744). Idempotent: a branch that
# is already in a stack is left alone. Dies on a detached HEAD, on the trunk branch, or when
# `gh stack init` fails.
stacking_tool_ensure_registered() {
  local -r tool="${1:-}"
  local st_dir quoted_repo branch view_rc init_rc=0

  [[ "$tool" == "$stacking_tool_value_gh_stack" ]] || return 0
  st_dir="$(stacking_tool_resolve_repo_dir "${2:-}")"
  quoted_repo="$(printf '%q' "$st_dir")"
  # --probe: exit 2 ("not part of a stack") is the expected miss here, not an error. Any other failure
  # (timeout, auth, network) says nothing about the stack, so it must not lead to a second registration:
  # a branch in more than one stack makes later gh stack commands exit 6.
  view_rc=0
  runner_sh "stacking-tool probe gh stack view" --probe --timeout 30 -- \
    "cd ${quoted_repo} && exec gh stack view --json >/dev/null 2>&1" || view_rc=$?
  case "$view_rc" in
    0) return 0 ;;
    2) ;;
    *) stacking_tool_die "could not read the gh stack state in ${st_dir} (gh stack view exited ${view_rc}); not registering" ;;
  esac
  branch="$(runner_exec_stdout "stacking-tool git current branch" -- git -C "$st_dir" branch --show-current)" \
    || stacking_tool_die "cannot read the current branch of ${st_dir}"
  if [[ -z "$branch" ]]; then
    stacking_tool_die "cannot register a stack from a detached HEAD in ${st_dir}; check out a feature branch"
  fi
  case "$branch" in
    main | master)
      stacking_tool_die "refusing to register the trunk branch '${branch}' as a stack; run from a feature branch"
      ;;
    *) ;;
  esac
  printf 'stacking-tool: branch %s is not part of a gh stack; registering it (gh stack init)\n' "$branch" >&2
  # rerere.enabled is set for this one call (never written to the config) so gh stack init cannot stop on its
  # rerere prompt in a non-interactive session (see the gh-stack Skill); stdin is closed for the same reason.
  runner_sh "stacking-tool gh stack init" --timeout 60 -- \
    "cd ${quoted_repo} && exec env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=rerere.enabled GIT_CONFIG_VALUE_0=true gh stack init $(printf '%q' "$branch") </dev/null" \
    || init_rc=$?
  # Exit 5 is gh's "invalid arguments" code, which it also uses for "already part of a stack" (another process
  # registered the branch between the probe and the init). Only accept it when the branch is now in a stack.
  if (( init_rc == 5 )) && runner_sh "stacking-tool re-probe gh stack view" --probe --timeout 30 -- \
    "cd ${quoted_repo} && exec gh stack view --json >/dev/null 2>&1"; then
    return 0
  fi
  if (( init_rc != 0 )); then
    stacking_tool_die "gh stack init ${branch} failed in ${st_dir} (exit ${init_rc})"
  fi
}

# stacking_tool_ensure_stack_conventional_titles <repo_dir>
# After a gh-stack `gh stack submit --auto` (submit or restack fallback),
# ensure every OPEN PR currently in the gh-stack has a Conventional Commits
# title when the repo's squash config makes the PR title the release-please
# signal (scripts/lib/pr-conventional-title). A multi-layer stack opens
# several PRs at once — only the current branch's PR was checked before this,
# leaving sibling layers unverified (repository-helpers#651). Returns
# non-zero (does not exit) on any real failure — stack-view/parse failure, or
# a title pr_cc_ensure_pr_title cannot auto-derive — so callers decide
# whether to die or propagate. Returns 0 and skips quietly only when origin
# cannot be resolved to OWNER/NAME (not a repo this check applies to).
stacking_tool_ensure_stack_conventional_titles() {
  local -r st_dir="$1"
  local origin_url slug view_json prs_str rc
  local -a prs=()

  origin_url="$(runner_exec_stdout "stacking-tool git remote origin (stack titles)" \
    --probe -- git -C "$st_dir" remote get-url origin)" || {
    printf 'stacking-tool: NOTE: could not resolve origin — skipping stack title check\n' >&2
    return 0
  }
  slug=""
  slug="$(gh_slug_from_origin_url "$origin_url")" || slug=""
  if [[ -z "$slug" ]]; then
    printf 'stacking-tool: NOTE: could not parse OWNER/NAME from origin — skipping stack title check\n' >&2
    return 0
  fi

  view_json=""
  # Keep gh on the same line as the waiter (runner + rate-limit ratchets).
  view_json="$(cd "$st_dir" && github_api_exec_with_rate_limit_retry "stacking-tool gh stack view ${slug}" -- gh stack view --json)" || {
    printf 'stacking-tool: ERROR: gh stack view --json failed for %s — cannot verify stack PR titles\n' "$slug" >&2
    return 1
  }

  prs_str=""
  # Exclude merged branches — an already-merged PR has no title left to fix.
  prs_str="$(pr_cc_jq_r "stacking-tool jq stack pr numbers" "$view_json" \
    '.branches[] | select(.isMerged != true) | .pr.number // empty')" || {
    printf 'stacking-tool: ERROR: could not parse gh stack view output for %s — cannot verify stack PR titles\n' "$slug" >&2
    return 1
  }
  if [[ -n "$prs_str" ]]; then
    while IFS= read -r pr; do
      [[ -n "$pr" ]] && prs+=("$pr")
    done <<<"$prs_str"
  fi

  rc=0
  pr_cc_ensure_stack_titles "$slug" "${prs[@]+"${prs[@]}"}" || rc=$?
  return "$rc"
}

# stacking_tool_normalize_body_file <path>
# Prints the path to hand to gh and the markdown lint: an option-like name such as "--notes.md" gets a
# "./" prefix so no parser takes it for a flag. Exit 1 unless the path is a non-empty regular file.
stacking_tool_normalize_body_file() {
  local path="$1"

  if [[ -z "$path" || ! -f "$path" || ! -s "$path" ]]; then
    return 1
  fi
  if [[ "$path" == --* ]]; then
    path="./${path}"
  fi
  printf '%s' "$path"
}

# stacking_tool_check_explicit_title <repo_dir> <title>
# Exit 1, with one ERROR line, when the repository uses the PR title as the squash release signal and
# <title> is not a Conventional Commits header: the later title check would silently replace it with a
# commit subject (#810). Exit 0 otherwise, and whenever origin or the repository settings cannot be read
# (the later check reports those).
stacking_tool_check_explicit_title() {
  local -r st_dir="$1"
  local -r title="${2:-}"
  local origin_url slug signal_rc=0

  if [[ -z "$title" ]]; then
    return 0
  fi
  origin_url="$(runner_exec_stdout "stacking-tool git remote origin (explicit title)" \
    --probe -- git -C "$st_dir" remote get-url origin)" || return 0
  slug="$(gh_slug_from_origin_url "$origin_url")" || return 0
  if [[ -z "$slug" ]]; then
    return 0
  fi
  pr_cc_repo_squash_title_is_release_signal "$slug" || signal_rc=$?
  if (( signal_rc == 0 )) && ! pr_cc_title_is_compliant "$title"; then
    printf 'ERROR: title "%s" is not a Conventional Commits header and %s uses the PR title '\
'as its release signal, so it would be replaced; use a header such as "feat(scope): summary"\n' \
      "$title" "$slug" >&2
    return 1
  fi
  return 0
}

# stacking_tool_title_normalize <text>
# Lowercases, turns hyphens, underscores and slashes into spaces and squeezes whitespace, so a branch
# name and the title `gh stack submit --auto` derives from it compare equal (#810).
stacking_tool_title_normalize() {
  local text="${1,,}"
  local -a words=()

  text="${text//[-_\/]/ }"
  read -r -a words <<<"$text" || true
  printf '%s' "${words[*]}"
}

# stacking_tool_title_looks_like_branch <title> <branch>
# Exit 0 when a PR title is the placeholder `gh stack submit --auto` derives from the branch name:
# the branch name with hyphens, underscores and slashes turned into spaces, with or without the
# "-wt" suffix start-development adds to every worktree branch. A title that merely ends in "wt"
# is a real title and is left alone (#810). Exit 1 when the branch is unknown.
stacking_tool_title_looks_like_branch() {
  local -r branch="${2:-}"
  local norm branch_norm

  if [[ -z "$branch" ]]; then
    return 1
  fi
  norm="$(stacking_tool_title_normalize "$1")"
  branch_norm="$(stacking_tool_title_normalize "$branch")"
  if [[ -n "$norm" && ( "$norm" == "$branch_norm" || "$norm" == "${branch_norm% wt}" ) ]]; then
    return 0
  fi
  return 1
}

# stacking_tool_default_pr_title <repo_dir> <branch>
# The title for a PR whose title is only a placeholder: the commit subject when the branch has
# exactly one commit above its parent (the previous layer of the stack, else main), else the branch
# name without its "-wt" suffix (#810).
stacking_tool_default_pr_title() {
  local -r st_dir="$1"
  local -r branch="$2"
  local base count norm view_json parent

  base='origin/main'
  if ! runner_exec_stdout "stacking-tool git origin/main (default title)" \
    --probe -- git -C "$st_dir" rev-parse --verify --quiet "$base" >/dev/null; then
    base='main'
  fi
  # In a multi-layer stack the layer's own commits start at the base `gh stack view` reports for it.
  view_json="$(cd "$st_dir" && github_api_exec_with_rate_limit_retry \
    "stacking-tool gh stack view (default title)" -- gh stack view --json)" || view_json=''
  if [[ -n "$view_json" ]]; then
    parent="$(pr_cc_jq_r "stacking-tool jq stack parent" "$view_json" \
      '.branches[] | select(.isCurrent == true) | .base // empty')" || parent=''
    if [[ "$parent" =~ ^[0-9a-f]{7,40}$ ]]; then
      base="$parent"
    fi
  fi
  count="$(runner_exec_stdout "stacking-tool git commit count (default title)" \
    --probe -- git -C "$st_dir" rev-list --count "${base}..HEAD")" || count=''
  if [[ "$count" == '1' ]]; then
    runner_exec_stdout "stacking-tool git commit subject (default title)" \
      --probe -- git -C "$st_dir" log -1 --format=%s
    return 0
  fi
  norm="$(stacking_tool_title_normalize "$branch")"
  printf '%s' "${norm% wt}"
}

# stacking_tool_apply_pr_text <repo_dir> <branch> <title> <body_file> <replace_placeholder 0|1>
# After `gh stack submit`, puts the final text on <branch>'s PR: an explicit title and body file when
# given; and, when <replace_placeholder> is 1, a title that is still a branch-name placeholder is
# replaced by stacking_tool_default_pr_title. A readable title is never touched (#810). The PR is
# looked up by branch name in the origin repository, never in whatever GH_REPO points at. When an
# explicit title or body was requested, any failure to apply it is an error (non-zero); the automatic
# replacement is best effort and only warns, so it can never fail a submit.
stacking_tool_apply_pr_text() {
  local -r st_dir="$1"
  local -r branch="$2"
  local title="${3:-}"
  local -r body_file="${4:-}"
  local -r replace="${5:-0}"
  local origin_url slug pr_json number current explicit=0 level strict=0 lookup_level

  if [[ -n "$title" || -n "$body_file" ]]; then
    explicit=1
  fi
  level='NOTE'
  if [[ "$explicit" -eq 1 ]]; then
    level='ERROR'
  fi
  # `gh stack submit` exits 0 even when it could not create the PR, so a submit-stack run (explicit
  # text or the placeholder replacement) treats a missing PR as the error it is (#810).
  if [[ "$explicit" -eq 1 || "$replace" == '1' ]]; then
    strict=1
  fi
  lookup_level='NOTE'
  if [[ "$strict" -eq 1 ]]; then
    lookup_level='ERROR'
  fi

  origin_url="$(runner_exec_stdout "stacking-tool git remote origin (pr text)" \
    --probe -- git -C "$st_dir" remote get-url origin)" || {
    printf 'stacking-tool: %s: could not resolve origin — leaving the PR title and body alone\n' \
      "$level" >&2
    return "$explicit"
  }
  slug="$(gh_slug_from_origin_url "$origin_url")" || slug=''
  if [[ -z "$slug" ]]; then
    printf 'stacking-tool: %s: could not parse OWNER/NAME from origin — leaving the PR title and body alone\n' \
      "$level" >&2
    return "$explicit"
  fi

  pr_json="$(github_api_exec_with_rate_limit_retry \
    "stacking-tool gh pr view ${slug} ${branch} (pr text)" \
    -- gh pr view "$branch" --repo "$slug" --json number,title)" || {
    printf 'stacking-tool: %s: could not read the PR for %s in %s (did gh stack submit fail to create it?)\n' \
      "$lookup_level" "$branch" "$slug" >&2
    return "$strict"
  }
  number="$(pr_cc_jq_r "stacking-tool jq pr number" "$pr_json" '.number // empty')" || number=''
  current="$(pr_cc_jq_r "stacking-tool jq pr title" "$pr_json" '.title // empty')" || current=''
  if [[ -z "$number" ]]; then
    printf 'stacking-tool: %s: no PR number for %s in %s\n' "$lookup_level" "$branch" "$slug" >&2
    return "$strict"
  fi

  if [[ -z "$title" && "$replace" == '1' ]] \
    && stacking_tool_title_looks_like_branch "$current" "$branch"; then
    title="$(stacking_tool_default_pr_title "$st_dir" "$branch")"
    printf 'stacking-tool: NOTE: PR #%s title "%s" looks like a branch name; using "%s"\n' \
      "$number" "$current" "$title" >&2
  fi
  if [[ -n "$title" && "$title" != "$current" ]]; then
    if ! pr_cc_pr_set_title "$slug" "$number" "$title"; then
      printf 'stacking-tool: could not set the title of PR #%s\n' "$number" >&2
      return "$explicit"
    fi
  fi
  if [[ -n "$body_file" ]]; then
    github_api_exec_with_rate_limit_retry "stacking-tool pr edit body ${slug}#${number}" \
      -- gh pr edit "$number" --repo "$slug" --body-file "$body_file" >/dev/null || return 1
  fi
}

# stacking_tool_submit_as <tool> <repo_dir> [--title TITLE] [--body-file FILE] [--replace-placeholder-title]
# Submits using an explicit backend (gh-stack; graphite dies as retired). --title and --body-file
# are applied to the PR right after it opens, before the Conventional Commits title check, and
# --replace-placeholder-title also replaces a title that is only the branch name (submit-stack passes
# it; other callers do not, so they never touch the PR). Any other extra arg is ignored with a
# warning. Used when the marker is not yet on disk (e.g. repo-practices --apply-fix creating the
# marker).
stacking_tool_submit_as() {
  local tool st_dir quoted_repo
  local pr_title='' pr_body_file='' pr_branch='' replace_title=0
  local -a extras=()

  tool="${1:-}"
  st_dir="$(stacking_tool_resolve_repo_dir "${2:-}")"
  if [[ $# -ge 2 ]]; then
    shift 2
  else
    shift $#
  fi
  extras=("$@")
  if ! stacking_tool_is_valid "$tool"; then
    stacking_tool_die "stacking_tool_submit_as: invalid tool '${tool}'"
  fi
  stacking_tool_require_cli "$tool"
  quoted_repo="$(printf '%q' "$st_dir")"

  case "$tool" in
    "$stacking_tool_value_graphite")
      stacking_tool_die "$(stacking_tool_retired_message)"
      ;;
    "$stacking_tool_value_gh_stack")
      while [[ ${#extras[@]} -gt 0 ]]; do
        case "${extras[0]}" in
          --title)
            if [[ ${#extras[@]} -lt 2 || -z "${extras[1]}" || "${extras[1]}" == --* ]]; then
              stacking_tool_die '--title needs a value'
            fi
            pr_title="${extras[1]}"
            extras=("${extras[@]:2}")
            ;;
          --body-file)
            if [[ ${#extras[@]} -lt 2 || -z "${extras[1]}" ]]; then
              stacking_tool_die '--body-file needs a value'
            fi
            pr_body_file="$(stacking_tool_normalize_body_file "${extras[1]}")" \
              || stacking_tool_die "body file not found, empty or not a regular file: ${extras[1]}"
            extras=("${extras[@]:2}")
            ;;
          --replace-placeholder-title)
            replace_title=1
            extras=("${extras[@]:1}")
            ;;
          *)
            printf 'stacking-tool: warning: ignoring extra submit arg for gh-stack: %s\n' \
              "${extras[0]}" >&2
            extras=("${extras[@]:1}")
            ;;
        esac
      done
      if [[ -n "$pr_title" || -n "$pr_body_file" || "$replace_title" -eq 1 ]]; then
        pr_branch="$(runner_exec_stdout "stacking-tool git branch (pr text)" \
          --probe -- git -C "$st_dir" branch --show-current)" || pr_branch=''
        if [[ -z "$pr_branch" ]]; then
          stacking_tool_die 'could not read the current branch (detached HEAD?); cannot set the PR title or body'
        fi
      fi
      if [[ -n "$pr_title" ]] && stacking_tool_title_looks_like_branch "$pr_title" "$pr_branch"; then
        stacking_tool_die "title \"${pr_title}\" looks like a branch name; give a readable title"
      fi
      stacking_tool_check_explicit_title "$st_dir" "$pr_title" \
        || stacking_tool_die 'the explicit title would be replaced by the Conventional Commits check'
      runner_sh "stacking-tool gh stack submit" "cd ${quoted_repo} && gh stack submit --auto --open --remote origin"
      if [[ -n "$pr_branch" ]]; then
        stacking_tool_apply_pr_text "$st_dir" "$pr_branch" "$pr_title" "$pr_body_file" "$replace_title" \
          || stacking_tool_die 'could not set the PR title or body (see the error above)'
      fi
      stacking_tool_ensure_stack_conventional_titles "$st_dir" \
        || stacking_tool_die 'one or more stack PR titles are not Conventional Commits headers (see ERROR: PR_CC_TITLE_* above) — fix with scripts/ensure-pr-conventional-title --pr <n>'
      ;;
  esac
}

# stacking_tool_submit <repo_dir> [--title TITLE] [--body-file FILE] [--replace-placeholder-title]
# Submits the current stack using the marker-selected backend.
# gh-stack: gh stack submit --auto --open --remote origin, then the PR title and body (#810).
stacking_tool_submit() {
  local st_dir tool

  st_dir="$(stacking_tool_resolve_repo_dir "${1:-}")"
  if [[ $# -ge 1 ]]; then
    shift
  fi
  tool="$(stacking_tool_read "$st_dir")"
  stacking_tool_submit_as "$tool" "$st_dir" "$@"
}

# stacking_tool_restack_as <tool> <repo_dir>
# Restack using an already-resolved backend (gh-stack). Used when the
# marker is absent and the caller already selected a default (e.g. dep-updater).
# Returns non-zero on operational failure (does not exit).
stacking_tool_restack_as() {
  local tool st_dir quoted_repo

  tool="${1:-}"
  st_dir="$(stacking_tool_resolve_repo_dir "${2:-}")"
  if ! stacking_tool_is_valid "$tool"; then
    stacking_tool_die "stacking_tool_restack_as: invalid tool '${tool}'"
  fi
  stacking_tool_require_cli "$tool"
  quoted_repo="$(printf '%q' "$st_dir")"

  case "$tool" in
    "$stacking_tool_value_graphite")
      stacking_tool_die "$(stacking_tool_retired_message)"
      ;;
    "$stacking_tool_value_gh_stack")
      if ! runner_sh "stacking-tool gh stack sync" --timeout 20 -- "cd ${quoted_repo} && exec gh stack sync --remote origin"; then
        runner_sh "stacking-tool gh stack rebase" --timeout 20 -- "cd ${quoted_repo} && exec gh stack rebase --remote origin" || return 1
        runner_sh "stacking-tool gh stack submit after rebase" --timeout 120 -- "cd ${quoted_repo} && exec gh stack submit --auto --open --remote origin" || return 1
        stacking_tool_ensure_stack_conventional_titles "$st_dir" || return 1
      fi
      ;;
  esac
}

# stacking_tool_restack <repo_dir>
# Rebases the current stack onto an updated base and re-pushes.
# gh-stack: gh stack sync --remote origin (fetch/rebase/push); falls back to
#           gh stack rebase + gh stack submit --auto --open on sync failure.
# Returns non-zero on operational failure (does not exit) so callers such as
# wait-for-agent-review cmd_restack can classify conflict vs transient errors.
stacking_tool_restack() {
  local st_dir tool

  st_dir="$(stacking_tool_resolve_repo_dir "${1:-}")"
  tool="$(stacking_tool_read "$st_dir")"
  stacking_tool_restack_as "$tool" "$st_dir"
}

# stacking_tool_session_sync_as <tool> <repo_dir>
# Session sync for an already-resolved backend (gh-stack).
# gh-stack: git fetch --prune origin.
stacking_tool_session_sync_as() {
  local -r tool="$1"
  local st_dir quoted_repo

  st_dir="$(stacking_tool_resolve_repo_dir "${2:-}")"
  if ! stacking_tool_is_valid "$tool"; then
    stacking_tool_die "stacking_tool_session_sync_as: invalid tool '${tool}'"
  fi
  quoted_repo="$(printf '%q' "$st_dir")"

  case "$tool" in
    "$stacking_tool_value_graphite")
      stacking_tool_die "$(stacking_tool_retired_message)"
      ;;
    "$stacking_tool_value_gh_stack")
      # Fetch-only: git is all it needs, so a host without the gh stack extension still syncs.
      runner_sh "stacking-tool session git fetch" --timeout 20 -- \
        "cd ${quoted_repo} && exec git fetch --prune origin"
      ;;
  esac
}

# stacking_tool_session_sync <repo_dir>
# Session bootstrap sync (start-development). gh-stack: git fetch --prune origin.
# Missing marker → org default (logged); invalid marker → dies.
stacking_tool_session_sync() {
  local st_dir tool

  st_dir="$(stacking_tool_resolve_repo_dir "${1:-}")"
  tool="$(stacking_tool_read_or_org_default "$st_dir")"
  stacking_tool_session_sync_as "$tool" "$st_dir"
}
