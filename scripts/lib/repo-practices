rp_ci_workflow_restricts_pr_branches() {
  local text="$1"
  # Graphite stacks open upstack PRs against a non-main base branch, so
  # restricting pull_request.branches to main prevents CI from running.
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1; found = 0 }
    /^on:[[:space:]]*$/ { in_on = 1; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_pr = 0; pr_indent = -1 }
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      next
    }
    in_pr {
      # If indentation backs out to pull_request: level or less, the block ended.
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) { in_pr = 0; next }
      if ($0 ~ /^[[:space:]]*branches:[[:space:]]*/) { found = 1 }
    }
    END { exit(found ? 0 : 1) }
  ' <<<"$text"
}

rp_fix_ci_workflow_for_stacked_prs() {
  local text="$1"
  # - Keep push triggers on main only.
  # - Remove any pull_request.branches restriction so stacked PRs run CI.
  # - Preserve the rest of the workflow verbatim.
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1 }
    /^on:[[:space:]]*$/ { in_on = 1; print; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_pr = 0; pr_indent = -1; print; next }

    # Normalize push branches to main-only when on a single-line list.
    in_on && /^[[:space:]]*push:[[:space:]]*$/ { print; next }
    in_on && /^[[:space:]]*branches:[[:space:]]*\\[main, master\\][[:space:]]*$/ { sub(/\\[main, master\\]/, "[main]"); print; next }

    # Enter pull_request block; we keep the key but drop branches restriction.
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      print
      next
    }

    in_pr {
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) { in_pr = 0; pr_indent = -1; print; next }
      # Drop pull_request.branches lines (both single-line list and multi-line style)
      if ($0 ~ /^[[:space:]]*branches:[[:space:]]*/) { next }
      if ($0 ~ /^[[:space:]]*-[[:space:]]*(main|master)[[:space:]]*$/) { next }
      print
      next
    }

    { print }
  ' <<<"$text"
}

# rp_fix_ci_workflow_add_merge_group <text>
# Insert merge_group under on: when missing. When push.branches exists, also ignore
# gh-readonly-queue/** via branches-ignore (or append if branches-ignore already set).
rp_fix_ci_workflow_add_merge_group() {
  local text="$1"
  if grep -qE '^[[:space:]]*merge_group:' <<<"$text"; then
    printf '%s' "$text"
    return 0
  fi
  awk '
    BEGIN { in_on = 0; in_push = 0; push_indent = -1; inserted = 0; saw_branches_ignore = 0 }
    /^on:[[:space:]]*$/ {
      in_on = 1
      print
      next
    }
    in_on && /^[^[:space:]]/ {
      if (!inserted) {
        print "  merge_group:"
        inserted = 1
      }
      in_on = 0
      in_push = 0
      push_indent = -1
      print
      next
    }
    in_on && /^[[:space:]]*push:[[:space:]]*$/ {
      in_push = 1
      push_indent = match($0, /[^ ]/) - 1
      print
      next
    }
    in_push {
      cur = match($0, /[^ ]/) - 1
      if (cur <= push_indent && $0 !~ /^[[:space:]]*$/) {
        in_push = 0
        push_indent = -1
      } else if ($0 ~ /^[[:space:]]*branches-ignore:[[:space:]]*$/) {
        saw_branches_ignore = 1
        print
        print "      - '\''gh-readonly-queue/**'\''"
        next
      } else if ($0 ~ /^[[:space:]]*branches:[[:space:]]*/) {
        # Prefer branches-ignore for queue temp branches when push uses branches.
        if (!saw_branches_ignore) {
          print
          indent = substr($0, 1, match($0, /[^ ]/) - 1)
          print indent "branches-ignore:"
          print indent "  - '\''gh-readonly-queue/**'\''"
          next
        }
      }
    }
    { print }
    END {
      if (in_on && !inserted) {
        print "  merge_group:"
      }
    }
  ' <<<"$text"
}

# Emit CI check context names for branch protection (job display name, else job id).
# Skips guard/changed-files/secret-scan/workflow-lint (optional CI gates, not merge blockers).
rp_discover_ci_status_contexts() {
  local slug="$1"
  local text
  text="$(rp_fetch_ci_workflow_text "$slug" 2>/dev/null || true)"
  if [[ -z "$text" ]]; then
    return 0
  fi
  awk '
    function emit() {
      if (job == "" || job == "guard" || job == "changed-files" || job == "secret-scan" \
          || job == "workflow-lint") {
        return
      }
      if (disp != "") {
        print disp
      } else {
        print job
      }
    }
    BEGIN { in_jobs = 0; job = ""; disp = "" }
    /^jobs:/ { in_jobs = 1; next }
    !in_jobs { next }
    /^  [a-zA-Z0-9_-]+:/ {
      emit()
      job = $1
      sub(/^  /, "", job)
      sub(/:$/, "", job)
      disp = ""
      next
    }
    job != "" && /^    name:/ {
      sub(/^    name: /, "")
      disp = $0
      next
    }
    END { emit() }
  ' <<<"$text"
}

# rp_fetch_classic_main_protection_json <slug>
# Prints protection JSON on stdout. Returns 0 on success, 1 when protection is absent,
