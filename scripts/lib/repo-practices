rp_ci_workflow_guard_has_coderabbit_edited_skip() {
  local text="$1"
  grep -qF 'coderabbitai[bot]' <<<"$text" \
    && grep -qF 'CodeRabbit description edit' <<<"$text"
}

rp_ci_workflow_has_pull_request_edited_type() {
  local text="$1"
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1; has_edited = 0 }
    /^on:[[:space:]]*$/ { in_on = 1; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_pr = 0; pr_indent = -1 }
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      next
    }
    in_pr {
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) { in_pr = 0; next }
      if ($0 ~ /^[[:space:]]*types:[[:space:]]*/ && $0 ~ /edited/) {
        has_edited = 1
      }
    }
    END { exit(has_edited ? 0 : 1) }
  ' <<<"$text"
}

rp_ci_workflow_has_feature_branch_push_trigger() {
  local text="$1"
  awk '
    BEGIN {
      in_on = 0
      in_push = 0
      push_indent = -1
      in_branches_ignore = 0
      branches_ignore_indent = -1
      has_main_ignore = 0
      has_graphite_ignore = 0
    }
    /^on:[[:space:]]*$/ { in_on = 1; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_push = 0; in_branches_ignore = 0 }
    in_on && /^[[:space:]]*push:[[:space:]]*$/ {
      in_push = 1
      push_indent = match($0, /[^ ]/) - 1
      next
    }
    in_push {
      cur = match($0, /[^ ]/) - 1
      if (cur <= push_indent) {
        in_push = 0
        in_branches_ignore = 0
        next
      }
      if ($0 ~ /^[[:space:]]*branches:[[:space:]]*\[[[:space:]]*main/) {
        exit 1
      }
      if ($0 ~ /^[[:space:]]*branches-ignore:[[:space:]]*$/) {
        in_branches_ignore = 1
        branches_ignore_indent = cur
        next
      }
      if (in_branches_ignore) {
        if (cur <= branches_ignore_indent) {
          in_branches_ignore = 0
          next
        }
        if ($0 ~ /main/) { has_main_ignore = 1 }
        if ($0 ~ /graphite-base/) { has_graphite_ignore = 1 }
      }
    }
    END { exit((has_main_ignore && has_graphite_ignore) ? 0 : 1) }
  ' <<<"$text"
}

rp_ci_workflow_guard_has_push_dedup() {
  local text="$1"
  local -r rp_ci_guard_pr_list_prefix='if count="'
  local rp_ci_guard_pr_list_suffix
  rp_ci_guard_pr_list_suffix="$(printf '%s%s pr list' '$(' 'gh')"
  # shellcheck disable=SC2016  # markers match literal ci.yml run block text
  grep -qF 'github.event_name }}" == "push"' <<<"$text" \
    && grep -qF -- "--head \"\$BRANCH\"" <<<"$text" \
    && grep -qF 'open PR exists; pull_request handles this push' <<<"$text" \
    && grep -qF 'PR_COUNT=0' <<<"$text" \
    && grep -qF "${rp_ci_guard_pr_list_prefix}${rp_ci_guard_pr_list_suffix}" <<<"$text" \
    && grep -qF 'PR_COUNT="$count"' <<<"$text" \
    && grep -qF "GH_TOKEN: \${{ github.token }}" <<<"$text"
}

rp_ci_workflow_guard_has_dedup_permissions() {
  local text="$1"
  local guard_block
  guard_block="$(
    awk '
      /^  guard:/ { in_guard = 1; block = $0 "\n"; next }
      in_guard {
        if (/^  [a-zA-Z0-9_.-]+:/ && $0 !~ /^  guard:/) {
          print block
          exit
        }
        block = block $0 "\n"
      }
      END { if (in_guard) { print block } }
    ' <<<"$text"
  )"
  [[ -n "$guard_block" ]] || return 1
  grep -qE '^[[:space:]]*permissions:' <<<"$guard_block" \
    && grep -qF 'pull-requests: read' <<<"$guard_block"
}

rp_ci_workflow_needs_graphite_restack_trigger_fix() {
  local text="$1"
  if rp_ci_workflow_has_pull_request_edited_type "$text" \
    && rp_ci_workflow_has_feature_branch_push_trigger "$text" \
    && rp_ci_workflow_guard_has_push_dedup "$text" \
    && rp_ci_workflow_guard_has_dedup_permissions "$text" \
    && ! rp_ci_workflow_guard_skip_run_is_broken "$text"; then
    return 1
  fi
  return 0
}

rp_fix_ci_workflow_pull_request_edited_type() {
  local text="$1"
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1; has_types = 0 }
    /^on:[[:space:]]*$/ { in_on = 1; print; next }
    in_on && /^[^[:space:]]/ {
      in_on = 0
      in_pr = 0
      pr_indent = -1
      has_types = 0
      print
      next
    }
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      has_types = 0
      print
      next
    }
    in_pr {
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) {
        if (!has_types) {
          printf "%*stypes: [opened, reopened, synchronize, ready_for_review, edited]\n", pr_indent + 2, ""
        }
        in_pr = 0
        print
        next
      }
      if ($0 ~ /^[[:space:]]*types:[[:space:]]*\[/) {
        has_types = 1
        if ($0 !~ /edited/) {
          sub(/\][[:space:]]*$/, ", edited]")
        }
        print
        next
      }
      print
      next
    }
    { print }
    END {
      if (in_pr && !has_types) {
        printf "%*stypes: [opened, reopened, synchronize, ready_for_review, edited]\n", pr_indent + 2, ""
      }
    }
  ' <<<"$text"
}

rp_fix_ci_workflow_feature_branch_push_trigger() {
  local text="$1"
  local block_path
  block_path="$(mktemp)"
  rp_candidate_ci_push_trigger_yaml >"$block_path"
  if rp_ci_workflow_has_feature_branch_push_trigger "$text"; then
    rm -f "$block_path"
    printf '%s' "$text"
    return 0
  fi
  awk -v block_path="$block_path" '
    BEGIN {
      in_on = 0
      in_push = 0
      push_indent = -1
      skipping_push = 0
      inserted = 0
      while ((getline block_line < block_path) > 0) {
        block = block block_line "\n"
      }
      close(block_path)
    }
    /^on:[[:space:]]*$/ { in_on = 1; print; next }
    in_on && /^[^[:space:]]/ {
      if (!inserted) {
        printf "\n%s", block
        inserted = 1
      }
      in_on = 0
      in_push = 0
      skipping_push = 0
      print
      next
    }
    in_on && /^[[:space:]]*push:[[:space:]]*$/ {
      in_push = 1
      push_indent = match($0, /[^ ]/) - 1
      skipping_push = 1
      next
    }
    in_push {
      cur = match($0, /[^ ]/) - 1
      if (cur <= push_indent) {
        in_push = 0
        if (skipping_push) {
          skipping_push = 0
          if (!inserted) {
            printf "%s", block
            inserted = 1
          }
        }
        print
        next
      }
      next
    }
    in_on && /^[[:space:]]*schedule:[[:space:]]*$/ {
      if (!inserted) {
        printf "\n%s", block
        inserted = 1
      }
      print
      next
    }
    { print }
    END {
      if (in_on && !inserted) {
        printf "\n%s", block
      }
    }
  ' <<<"$text"
  rm -f "$block_path"
}

rp_ci_guard_skip_run_template_name() {
  local text="$1"
  # shellcheck disable=SC2016  # markers match literal GitHub Actions ${{ }} in ci.yml
  local -r pr_state_marker='PR_STATE: ${{ steps.pr-state.outputs.state }}'
  # shellcheck disable=SC2016  # markers match literal GitHub Actions ${{ }} in ci.yml
  local -r pr_number_marker='pr_number="${{ github.event.pull_request.number }}"'
  # shellcheck disable=SC2016  # markers match literal GitHub Actions ${{ }} in ci.yml
  local -r head_ref_pr_number_marker='PR_NUMBER: ${{ github.event.pull_request.number }}'
  if grep -qF "$pr_state_marker" <<<"$text"; then
    printf '%s' 'ci-guard-skip-run-pr-state.snippet'
  elif grep -qF "$pr_number_marker" <<<"$text"; then
    printf '%s' 'ci-guard-skip-run-inline-merged.snippet'
  elif grep -qF "$head_ref_pr_number_marker" <<<"$text" \
    && grep -qF 'HEAD_REF:' <<<"$text"; then
    printf '%s' 'ci-guard-skip-run-head-ref-pr-number.snippet'
  else
    printf '%s' 'ci-guard-skip-run-gtmq-only.snippet'
  fi
}

rp_candidate_ci_guard_skip_run_yaml() {
  local text="$1"
  local template_name
  # shellcheck disable=SC2016  # YAML run line embeds $GITHUB_OUTPUT literally
  local -r skip_false_line='          echo "skip=false" >> "$GITHUB_OUTPUT"'
  template_name="$(rp_ci_guard_skip_run_template_name "$text")"
  rp_candidate_workflow_template "$template_name"
  rp_candidate_ci_guard_coderabbit_edited_yaml
  rp_candidate_ci_guard_push_dedup_yaml
  printf '%s\n' "$skip_false_line"
}

rp_ci_workflow_guard_skip_step_text() {
  local text="$1"
  awk '
    /^  guard:/ { in_guard = 1 }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ && $0 !~ /^  guard:/ { exit }
    in_guard && /^      - id: (check|set-skip)$/ {
      in_skip = 1
      print
      next
    }
    in_guard && in_skip && /^      - id: / { exit }
    in_guard && in_skip { print }
  ' <<<"$text"
}

rp_ci_workflow_guard_skip_run_is_broken() {
  local text="$1"
  local skip_step_text
  skip_step_text="$(rp_ci_workflow_guard_skip_step_text "$text")"
  if [[ -z "$skip_step_text" ]]; then
    return 1
  fi
  if awk '
    BEGIN { prev_exit = 0; gh_token = 0 }
    /GH_TOKEN:/ {
      gh_token++
      if (gh_token > 1) { broken = 1 }
    }
    /exit 0/ {
      if (prev_exit) { broken = 1 }
      prev_exit = 1
      next
    }
    { prev_exit = 0 }
    END { exit(broken ? 0 : 1) }
  ' <<<"$skip_step_text"; then
    return 0
  fi
  if grep -qF "GITHUB_REPOSITORY_OWNER}:\${BRANCH}" <<<"$skip_step_text"; then
    return 0
  fi
  if grep -qF 'pull_request workflow covers' <<<"$skip_step_text"; then
    return 0
  fi
  return 1
}

rp_fix_ci_workflow_guard_permissions() {
  local text="$1"
  local block_path
  if rp_ci_workflow_guard_has_dedup_permissions "$text"; then
    printf '%s' "$text"
    return 0
  fi
  block_path="$(mktemp)"
  rp_candidate_ci_guard_permissions_yaml >"$block_path"
  awk -v block_path="$block_path" '
    BEGIN {
      while ((getline block_line < block_path) > 0) {
        block = block block_line "\n"
      }
      close(block_path)
    }
    /^  guard:/ {
      in_guard = 1
      guard_indent = match($0, /[^ ]/) - 1
      print
      next
    }
    in_guard && /^    permissions:/ {
      skipping_permissions = 1
      perm_indent = match($0, /[^ ]/) - 1
      next
    }
    skipping_permissions {
      cur = match($0, /[^ ]/) - 1
      if (cur <= perm_indent) {
        skipping_permissions = 0
      } else {
        next
      }
    }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ {
      in_guard = 0
      print block
      print
      next
    }
    in_guard && /^    (runs-on:|name:)/ && !inserted_permissions {
      printf "%s", block
      inserted_permissions = 1
      print
      next
    }
    { print }
    END {
      if (in_guard && !inserted_permissions) {
        printf "%s", block
      }
    }
  ' <<<"$text"
  rm -f "$block_path"
}

rp_fix_ci_workflow_guard_push_dedup() {
  local text="$1"
  local run_path
  if rp_ci_workflow_guard_has_push_dedup "$text" \
    && ! rp_ci_workflow_guard_skip_run_is_broken "$text"; then
    printf '%s' "$text"
    return 0
  fi
  run_path="$(mktemp)"
  rp_candidate_ci_guard_skip_run_yaml "$text" >"$run_path"
  awk -v run_path="$run_path" '
    BEGIN {
      in_guard = 0
      in_skip_step = 0
      in_env = 0
      env_indent = -1
      env_has_token = 0
      run_indent = -1
      replacing_run = 0
    }
    /^  guard:/ { in_guard = 1; print; next }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ && $0 !~ /^  guard:/ {
      in_guard = 0
      in_skip_step = 0
      in_env = 0
      replacing_run = 0
      print
      next
    }
    in_guard && /^      - id: (check|set-skip)$/ {
      in_skip_step = 1
      in_env = 0
      replacing_run = 0
      env_has_token = 0
      print
      next
    }
    in_skip_step && /^        env:/ {
      in_env = 1
      env_indent = match($0, /[^ ]/) - 1
      print
      next
    }
    in_env {
      cur = match($0, /[^ ]/) - 1
      if (cur <= env_indent) {
        in_env = 0
        if (!env_has_token) {
          print "          GH_TOKEN: ${{ github.token }}"
          env_has_token = 1
        }
      } else {
        if ($0 ~ /GH_TOKEN:/) {
          if (env_has_token) {
            next
          }
          env_has_token = 1
        }
        if ($0 ~ /HEAD_REF: \$\{\{ github\.head_ref \}\}/) {
          sub(/github\.head_ref \}\}/, "github.head_ref || github.ref_name }}")
        }
        print
        next
      }
    }
    in_skip_step && /^        run: \|/ {
      print
      run_indent = match($0, /[^ ]/) - 1
      while ((getline run_line < run_path) > 0) {
        print run_line
      }
      close(run_path)
      replacing_run = 1
      next
    }
    replacing_run {
      cur = match($0, /[^ ]/) - 1
      if (cur <= run_indent && $0 ~ /^        [a-zA-Z]/) {
        replacing_run = 0
        in_skip_step = 0
        print
        next
      }
      if (cur <= run_indent && $0 ~ /^  [a-zA-Z]/) {
        replacing_run = 0
        in_skip_step = 0
        print
        next
      }
      next
    }
    { print }
  ' <<<"$text"
  rm -f "$run_path"
}

rp_fix_ci_workflow_guard_coderabbit_edited() {
  local text="$1"
  local block_path
  if rp_ci_workflow_guard_has_coderabbit_edited_skip "$text"; then
    printf '%s' "$text"
    return 0
  fi
  block_path="$(mktemp)"
  rp_candidate_ci_guard_coderabbit_edited_yaml >"$block_path"
  awk -v block_path="$block_path" '
    BEGIN {
      while ((getline block_line < block_path) > 0) {
        block = block block_line "\n"
      }
      close(block_path)
      in_guard = 0
      in_skip_step = 0
      inserted = 0
    }
    in_guard && in_skip_step && /^          # Skip push CI when an open PR already covers this branch\./ {
      if (!inserted) {
        printf "%s", block
        inserted = 1
      }
      print
      next
    }
    /^  guard:/ { in_guard = 1; print; next }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ && $0 !~ /^  guard:/ {
      in_guard = 0
      in_skip_step = 0
      print
      next
    }
    in_guard && /^      - id: (check|set-skip)$/ {
      in_skip_step = 1
      print
      next
    }
    in_guard && in_skip_step && /^      - id: / { in_skip_step = 0 }
    { print }
  ' <<<"$text"
  rm -f "$block_path"
}

rp_fix_ci_workflow_graphite_restack_triggers() {
  local text="$1"
  text="$(rp_fix_ci_workflow_pull_request_edited_type "$text")"
  text="$(rp_fix_ci_workflow_feature_branch_push_trigger "$text")"
  text="$(rp_fix_ci_workflow_guard_permissions "$text")"
  text="$(rp_fix_ci_workflow_guard_push_dedup "$text")"
