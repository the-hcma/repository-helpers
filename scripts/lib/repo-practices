rp_usage() {
  local -r prog="${1:-check-repo-practices}"
  cat >&2 <<USAGE
Usage:
  scripts/${prog} [--org ORG] [--repo OWNER/NAME ...]
  scripts/${prog} --new-repo --repo OWNER/NAME
  scripts/${prog} --strict-onboarding --repo OWNER/NAME ...
  scripts/${prog} --all [--org ORG] [--include-private]
  scripts/${prog} --suggest [--repo OWNER/NAME ...] [--include-private]
  scripts/${prog} --apply-fix [--repo ...]      # settings fixes + candidate workflow PRs

Audits GitHub conventions for org repositories:

  protect-main ruleset (when merge-it or release-please.yml exists):
    - squash-only allowed_merge_methods on main
    - Graphite App bypass (Integration actor_id 158384)

  Classic branch protection on main (same repos; org standard):
    - CODEOWNERS reviews, dismiss stale, Graphite + Dependabot bypass, owner bypass
    - push restricted to Graphite App; required CI contexts from ci.yml; strict checks

  Branch hygiene (strict repos):
    - cleanup-branch-on-merge.yml (delete head branch when PR merges)
    - cleanup-merged-branches.yml (daily sweep + workflow_dispatch)

  Graphite merge queue (when merge-it label exists):
    - enqueue labels, merged-pr-closer, ci gtmq skip, dependabot auto-merge

  Repository metadata:
    - top-level license file
    - copyright notice
    - CODEOWNERS with a repository-wide owner rule
    - .cursor/rules/pr-ship-and-review.mdc (canonical agent review loop)
    - .gitignore must not ignore .cursor/rules/ (org cursor rules must be trackable)

  Release Please (when release-please.yml exists):
    - squash-only repo settings; squash_merge_commit_message=BLANK

--new-repo: audit a single repo with SUGGEST hints and a setup checklist (requires --repo).
--strict-onboarding: require full org onboarding, including merge-it, for audited repos.
--all: audit every repository in the org (not only merge-it / release-please).
--include-private: include private GitHub repositories in org discovery and enforcer scans
(default: skip private repos in bulk discovery; explicit --repo and current-clone audits are
always included). Override via GITHUB_REPO_LINT_INCLUDE_PRIVATE=1.
With no --repo: audit the current git repository when run inside a clone (origin on GitHub);
otherwise discover org repos with release-please.yml or merge-it.
--suggest: print SUGGEST lines with remediation hints (non-zero exit still on FAIL).
--compact: print one passed-repos line plus grouped failures and fixes (implies --suggest).

Requires: gh (authenticated), jq.
USAGE
}

rp_die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

rp_color_enabled() {
  [[ -t 2 ]] && [[ -z "${NO_COLOR:-}" ]]
}

rp_color() {
  local code="$1"
  shift
  if rp_color_enabled; then
    printf '\033[%sm%s\033[0m' "$code" "$*"
  else
    printf '%s' "$*"
  fi
}

rp_compact_append_entry() {
  local slug="$1"
  local line="$2"
  local existing

  [[ -n "$slug" && -n "$line" ]] || return 0
  existing="${rp_compact_entries[$slug]:-}"
  if [[ -n "$existing" ]] && grep -qxF -- "$line" <<<"$existing"; then
    return 0
  fi
  if [[ -n "$existing" ]]; then
    rp_compact_entries[$slug]+=$'\n'"$line"
  else
    rp_compact_entries[$slug]="$line"
  fi
}

rp_compact_strip_slug() {
  local slug="$1"
  local message="$2"
  local prefix

  prefix="${slug}: "
  if [[ "$message" == "${prefix}"* ]]; then
    printf '%s' "${message:${#prefix}}"
  else
    printf '%s' "$message"
  fi
}

rp_compact_record_failure() {
  local slug="$1"
  local message="$2"
  local stripped

  stripped="$(rp_compact_strip_slug "$slug" "$message")"
  rp_compact_append_entry "$slug" "- ${stripped}"
}

rp_compact_record_fix() {
  local slug="$1"
  local message="$2"
  local stripped

  stripped="$(rp_compact_strip_slug "$slug" "$message")"
  rp_compact_append_entry "$slug" "  Fix: ${stripped}"
}

rp_compact_print_joined_repos() {
  local label="$1"
  shift
  local first=1
  local slug

  printf '%s' "$label" >&2
  if [[ "$#" -eq 0 ]]; then
    printf ' none\n' >&2
    return 0
  fi
  for slug in "$@"; do
    if [[ "$first" -eq 1 ]]; then
      printf ' ' >&2
      first=0
    else
      printf ', ' >&2
    fi
    printf '%s' "$slug" >&2
  done
  printf '\n' >&2
}

rp_compact_print_report() {
  local slug
  local block
  local line

  rp_compact_print_joined_repos 'Passed:' "${rp_compact_passed_repos[@]}"
  if [[ "${#rp_compact_failed_repos[@]}" -eq 0 ]]; then
    return 0
  fi

  printf 'Failed:\n' >&2
  for slug in "${rp_compact_failed_repos[@]}"; do
    printf '%s:\n' "$slug" >&2
    block="${rp_compact_entries[$slug]:-}"
    if [[ -z "$block" ]]; then
      printf '  - failed practices check\n' >&2
      continue
    fi
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      printf '  %s\n' "$line" >&2
    done <<<"$block"
  done
}

rp_should_record_failure() {
  [[ -n "$rp_current_slug" ]] \
    && { [[ "$rp_compact" -eq 1 ]] || [[ "$rp_track_failures" -eq 1 ]]; }
}

rp_failure_summary_for_slug() {
  local slug="$1"
  local block line summary

  block="${rp_compact_entries[$slug]:-}"
  summary=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$line" == Fix:* ]] && continue
    line="${line#- }"
    if [[ -n "$summary" ]]; then
      summary="${summary}; ${line}"
    else
      summary="$line"
    fi
  done <<<"$block"
  if [[ -z "$summary" ]]; then
    summary='failed practices check'
  fi
  printf '%s' "$summary"
}

rp_print_failure_summary() {
  local slug summary

  if [[ "${#rp_compact_failed_repos[@]}" -eq 0 ]]; then
    return 0
  fi

  printf '\n==> Summary\n' >&2
  for slug in "${rp_compact_failed_repos[@]}"; do
    summary="$(rp_failure_summary_for_slug "$slug")"
    printf '%s: %s\n' "$slug" "$summary" >&2
  done
}

rp_log_ok() {
  if [[ "$rp_compact" -eq 1 ]]; then
    return 0
  fi
  printf 'OK: %s\n' "$*" >&2
}

rp_log_warn() {
  rp_warn_count=$(( rp_warn_count + 1 ))
  printf 'WARN: %s\n' "$*" >&2
}

rp_log_fail() {
  if rp_should_record_failure; then
    rp_compact_record_failure "$rp_current_slug" "$*"
    if [[ "$rp_compact" -eq 1 ]]; then
      return 0
    fi
  fi
  printf 'FAIL: %s\n' "$*" >&2
}

# Indented detail under a failure (compact email/report and verbose stderr).
rp_log_fail_detail() {
  local line="$1"

  if rp_should_record_failure && [[ "$rp_compact" -eq 1 && -n "$rp_current_slug" ]]; then
    rp_compact_append_entry "$rp_current_slug" "    ${line}"
    return 0
  fi
  printf '     %s\n' "$line" >&2
}

rp_check_line_prefix() {
  local slug="$1"
  if [[ "$rp_single_repo" -eq 1 ]]; then
    return 0
  fi
  printf '%s: ' "$slug"
}

rp_github_url() {
  local slug="$1"
  local path="${2:-}"
  printf 'https://github.com/%s%s' "$slug" "$path"
}

rp_log_check_ok() {
  local slug="$1"
  local message="$2"
  local url="${3:-}"
  if [[ "$rp_compact" -eq 1 ]]; then
    return 0
  fi
  printf 'OK: ' >&2
  rp_check_line_prefix "$slug" >&2
  printf '%s\n' "$message" >&2
  if [[ -n "$url" ]]; then
    printf '     %s\n' "$url" >&2
  fi
}

rp_log_check_fail() {
  local slug="$1"
  local message="$2"
  local url="${3:-}"
  if rp_should_record_failure; then
    rp_compact_record_failure "$rp_current_slug" "${slug}: ${message}"
    if [[ "$rp_compact" -eq 1 ]]; then
      return 0
    fi
  fi
  printf 'FAIL: ' >&2
  rp_check_line_prefix "$slug" >&2
  printf '%s\n' "$message" >&2
  if [[ -n "$url" ]]; then
    printf '     %s\n' "$url" >&2
  fi
}

# Manual steps the script cannot verify (yellow + 👉 when stderr is a TTY).
# Omitted from --compact failure reports: these are unverifiable reminders and were
# previously recorded as "Fix:" lines even when GitHub wiring already passed.
rp_log_manual_step() {
  local message="$1"
  local url="${2:-}"
  if [[ "$rp_compact" -eq 1 ]]; then
    return 0
  fi
  printf '     ' >&2
  if rp_color_enabled; then
    rp_color 33 "👉 ${message}" >&2
  else
    printf '👉 %s' "$message" >&2
  fi
  printf '\n' >&2
  if [[ -n "$url" ]]; then
    printf '        %s\n' "$url" >&2
  fi
}

rp_print_final_status() {
  local status="$1"
  local detail="${2:-}"
  local line
  case "$status" in
    passed)
      if [[ -n "$detail" ]]; then
        line="$detail"
      else
        line='passed'
      fi
      rp_color 32 "$line" >&2
      printf '\n' >&2
      ;;
    passed_with_warnings)
      if [[ -n "$detail" ]]; then
        line="$detail (warnings reported above)"
      else
        line='passed with warnings'
      fi
      rp_color 33 "$line" >&2
      printf '\n' >&2
      ;;
    failed)
      if [[ -n "$detail" ]]; then
        line="$detail"
      else
        line='failed'
      fi
      rp_color 31 "$line" >&2
      printf '\n' >&2
      ;;
    *)
      rp_die "internal error: unknown final status: ${status}"
      ;;
  esac
}

rp_log_suggest() {
  if [[ "$rp_compact" -eq 1 && -n "$rp_current_slug" ]]; then
    rp_compact_record_fix "$rp_current_slug" "$*"
    return 0
  fi
  printf 'SUGGEST: %s\n' "$*" >&2
}

rp_require_tools() {
  command -v gh >/dev/null 2>&1 || rp_die "'gh' not found (https://cli.github.com)"
  command -v jq >/dev/null 2>&1 || rp_die "'jq' not found"
  local auth_exit_code=0
  runner_exec "repo-practices gh auth status" -- gh auth status || auth_exit_code=$?
  if (( auth_exit_code != 0 )); then
    rp_die "'gh' is not authenticated (run: gh auth login)"
  fi
}

rp_repo_short_name() {
  printf '%s' "${1#*/}"
}

# When run inside a git clone, resolve OWNER/NAME from origin (GitHub only).
rp_resolve_git_context_slug() {
  local repo_root
  local git_exit_code=0
  repo_root=""
  set +e
  repo_root="$(rp_runner_exec_stdout "repo-practices git rev-parse show-toplevel" \
    -- git rev-parse --show-toplevel)"
  git_exit_code=$?
  set -e
  repo_root="${repo_root//$'\n'/}"
  if (( git_exit_code != 0 )); then
    repo_root=""
  fi
  if [[ -z "$repo_root" ]]; then
    return 1
  fi
  gh_slug_from_repo_dir "$repo_root"
}

rp_is_strict_repo() {
  [[ "$(rp_repo_short_name "$1")" != "$rp_THIS_REPO_NAME" ]] || [[ "$rp_new_repo" -eq 1 ]]
}

# rp_gh_api_detail_is_not_found <detail>
# True when a gh api stderr summary indicates HTTP 404 / Not Found.
rp_gh_api_detail_is_not_found() {
  local -r detail="$1"
  [[ "$detail" == *'404'* || "$detail" == *'Not Found'* ]]
}

# rp_gh_api_detail_is_transient <detail>
# True for retryable GitHub API failures (gateway errors / rate limit).
rp_gh_api_detail_is_transient() {
  local -r detail="$1"
  [[ "$detail" == *'502'* || "$detail" == *'503'* || "$detail" == *'504'* \
    || "$detail" == *'429'* || "$detail" == *[Rr]'ate limit'* ]]
}

rp_gh_api_max_attempts() {
  printf '%s' "${RP_GH_API_MAX_ATTEMPTS:-3}"
}

rp_gh_api_retry_sleep() {
  local secs="${RP_GH_API_RETRY_SLEEP_SECS:-1}"
  if [[ "$secs" == '0' ]]; then
    return 0
  fi
  sleep "$secs"
}

# Classify a failed gh contents probe/fetch.
# 1 = not found, 2 = API error (after optional retries for transients).
rp_gh_api_classify_contents_failure() {
  local detail attempt max_attempts
  detail="$(rp_runner_last_stderr_summary || true)"
  # Empty stderr (test mocks) or explicit 404 → missing.
  if [[ -z "$detail" ]] || rp_gh_api_detail_is_not_found "$detail"; then
    return 1
  fi
  attempt="${1:-1}"
  max_attempts="$(rp_gh_api_max_attempts)"
  if rp_gh_api_detail_is_transient "$detail"; then
    if (( attempt < max_attempts )); then
      return 3
    fi
    return 2
  fi
  # Other explicit HTTP errors from gh (401/403/500/…) → API failure.
  if [[ "$detail" == *'HTTP '* || "$detail" == *'HTTP/'* ]]; then
    return 2
  fi
  # Unrecognized stderr (e.g. test mock "unexpected gh call") → missing.
  return 1
}

# rp_gh_path_check <slug> <path>
# 0 = path exists, 1 = not found (404), 2 = GitHub API error after retries.
# Never treat HTTP 502/503/504/429 as "missing" — that caused false lint failures.
rp_gh_path_check() {
  local -r slug="$1"
  local -r path="$2"
  local attempt max_attempts exit_code class_ec

  max_attempts="$(rp_gh_api_max_attempts)"
  attempt=1
  while (( attempt <= max_attempts )); do
    exit_code=0
    runner_exec "repo-practices gh path exists ${path}" --probe \
      -- gh api "repos/${slug}/contents/${path}" || exit_code=$?
    if (( exit_code == 0 )); then
      return 0
    fi
    class_ec=0
    rp_gh_api_classify_contents_failure "$attempt" || class_ec=$?
    if (( class_ec == 3 )); then
      rp_gh_api_retry_sleep
      attempt=$(( attempt + 1 ))
      continue
    fi
    return "$class_ec"
  done
  return 2
}

# True only when the path exists. Prefer rp_gh_path_check when missing vs API
# error must be distinguished (see call sites that fail on "missing").
rp_gh_path_exists() {
  local check_exit=0
  rp_gh_path_check "$@" || check_exit=$?
  (( check_exit == 0 ))
}

# rp_fetch_github_text_file <slug> <path>
# Prints file text on success (exit 0). Exit 1 = not found / empty content.
# Exit 2 = GitHub API error after retries (do not treat as missing/malformed file).
rp_fetch_github_text_file() {
  local slug="$1"
  local path="$2"
  local response encoded decoded
  local fetch_exit_code=0
  local attempt max_attempts class_ec

  max_attempts="$(rp_gh_api_max_attempts)"
  attempt=1
  while (( attempt <= max_attempts )); do
    fetch_exit_code=0
    set +e
    response="$(rp_runner_exec_stdout "repo-practices gh fetch ${path}" --probe \
      -- gh api "repos/${slug}/contents/${path}")"
    fetch_exit_code=$?
    set -e
    if (( fetch_exit_code == 0 )) && [[ -n "$response" ]]; then
      encoded="$(rp_runner_jq_file "repo-practices content field" "$response" \
        -r '.content // empty')"
      if [[ -z "$encoded" || "$encoded" == 'null' ]]; then
        return 1
      fi
      decoded="$(printf '%s' "$encoded" | base64 -d 2>/dev/null)" || return 1
      printf '%s' "$decoded"
      return 0
    fi
    class_ec=0
    rp_gh_api_classify_contents_failure "$attempt" || class_ec=$?
    if (( class_ec == 3 )); then
      rp_gh_api_retry_sleep
      attempt=$(( attempt + 1 ))
      continue
    fi
    return "$class_ec"
  done
  return 2
}

rp_text_has_copyright_notice() {
  local -r text="$1"
  grep -Eiq 'copyright[[:space:]]*(\([cC]\))?[[:space:]]*[0-9]{4}' <<<"$text"
}

rp_fetch_repo_license_file() {
  local slug="$1"
  local license_path text
  local -a license_paths=(
    LICENSE
    LICENSE.md
    LICENSE.txt
    COPYING
    COPYING.md
    COPYING.txt
  )

  for license_path in "${license_paths[@]}"; do
    text="$(rp_fetch_github_text_file "$slug" "$license_path" || true)"
    [[ -n "$text" ]] || continue
    printf '%s\n%s' "$license_path" "$text"
    return 0
  done
  return 1
}

rp_find_repo_copyright_notice_path() {
  local slug="$1"
  local license_path="$2"
  local license_text="$3"
  local notice_path text
  local -a notice_paths=(
    "$license_path"
    NOTICE
    NOTICE.md
    COPYRIGHT
    COPYRIGHT.md
    README.md
    README
  )

  if [[ -n "$license_text" ]] && rp_text_has_copyright_notice "$license_text"; then
    printf '%s\n' "$license_path"
    return 0
  fi

  for notice_path in "${notice_paths[@]}"; do
    [[ -n "$notice_path" ]] || continue
    [[ "$notice_path" != "$license_path" ]] || continue
    text="$(rp_fetch_github_text_file "$slug" "$notice_path" || true)"
    [[ -n "$text" ]] || continue
    if rp_text_has_copyright_notice "$text"; then
      printf '%s\n' "$notice_path"
      return 0
    fi
  done
  return 1
}

rp_fetch_repo_codeowners_file() {
  local slug="$1"
  local codeowners_path text
  local -a codeowners_paths=(
    .github/CODEOWNERS
    CODEOWNERS
    docs/CODEOWNERS
  )

  for codeowners_path in "${codeowners_paths[@]}"; do
    text="$(rp_fetch_github_text_file "$slug" "$codeowners_path" || true)"
    [[ -n "$text" ]] || continue
    printf '%s\n%s' "$codeowners_path" "$text"
    return 0
  done
  return 1
}

rp_codeowners_has_global_owner_rule() {
  local -r text="$1"
  grep -Eq '^[[:space:]]*\*[[:space:]]+@[-A-Za-z0-9_]+' <<<"$text"
}

readonly rp_pr_ship_and_review_rule_path='.cursor/rules/pr-ship-and-review.mdc'
readonly rp_pr_ship_and_review_skill_path='.cursor/skills/ship-and-review/SKILL.md'

