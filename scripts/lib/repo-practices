rp_ci_workflow_has_pull_request_edited_type() {
  local text="$1"
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1; has_edited = 0 }
    /^on:[[:space:]]*$/ { in_on = 1; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_pr = 0; pr_indent = -1 }
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      next
    }
    in_pr {
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) { in_pr = 0; next }
      if ($0 ~ /^[[:space:]]*types:[[:space:]]*/ && $0 ~ /edited/) {
