# shellcheck shell=bash
# repo-practices — shared checks for org repository GitHub conventions.
#
# Sourced by scripts/github-repo-lint and scripts/check-merge-settings.
# Do not execute directly.
# shellcheck disable=SC2016  # jq filter and ci.yml marker strings use single quotes

rp_DEFAULT_ORG='the-hcma'
rp_GRAPHITE_APP_ACTOR_ID=158384
rp_GRAPHITE_APP_SLUG='graphite-app'
rp_DEPENDABOT_APP_SLUG='dependabot'
rp_ORG_OWNER_BYPASS_USER='thehcma'
rp_THIS_REPO_NAME='repository-helpers'
# GitHub merge-queue rule must squash (matches org Release Please / Graphite policy).
rp_GITHUB_MQ_MERGE_METHOD='SQUASH'

rp_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly rp_lib_dir

# shellcheck source=scripts/lib/release-age-defaults
source "${rp_lib_dir}/release-age-defaults"

# shellcheck source=scripts/lib/ci-secret-scan-policy
source "${rp_lib_dir}/ci-secret-scan-policy"

# shellcheck source=scripts/lib/github-repo-slug
source "${rp_lib_dir}/github-repo-slug"

# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${rp_lib_dir}/runner-ensure"

rp_runner_last_stdout() {
  local uuid

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || return 0
  runner_read "$uuid" stdout 2>/dev/null || true
}

# rp_runner_last_stderr_summary
# First stderr line from the most recent runner command (typically a gh api error).
rp_runner_last_stderr_summary() {
  local uuid stderr_text line

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || return 1
  stderr_text="$(runner_read "$uuid" stderr 2>/dev/null || true)"
  line="$(printf '%s\n' "$stderr_text" | grep -m1 '.' || true)"
  line="${line//$'\r'/}"
  line="${line#gh: }"
  printf '%s' "$line"
}

# rp_log_gh_api_fail <slug> <context>
rp_log_gh_api_fail() {
  local -r slug="$1"
  local -r context="$2"
  local detail

  detail="$(rp_runner_last_stderr_summary)"
  if [[ -z "$detail" ]]; then
    detail='gh api request failed'
  fi
  rp_log_fail "${slug}: ${context} (GitHub API: ${detail})"
}

# rp_runner_exec_stdout <label> -- <cmd> [args…]
rp_runner_exec_stdout() {
  local -r label="$1"
  shift
  runner_exec_stdout "$label" "$@"
}

# rp_runner_gh_api_stream <label> [--probe] [gh-api-args…]
rp_runner_gh_api_stream() {
  local -r label="$1"
  local probe=0
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  local exit_code

  exit_code=0
  if (( probe )); then
    runner_exec "$label" --probe --stream-stdout -- gh api "$@" || exit_code=$?
  else
    runner_exec "$label" --stream-stdout -- gh api "$@" || exit_code=$?
  fi
  return "$exit_code"
}

# rp_runner_git_stream <label> [git-args…]
rp_runner_git_stream() {
  local -r label="$1"
  shift
  local exit_code

  exit_code=0
  runner_exec "$label" --stream-stdout -- git "$@" || exit_code=$?
  return "$exit_code"
}

# rp_runner_jq_file <label> <input-json> [jq-args…]
# jq invocations with -e are treated as boolean probes (omitted from email failures).
rp_runner_jq_file() {
  local -r label="$1"
  local -r input="$2"
  shift 2
  local tmp exit_code probe=0 arg

  for arg in "$@"; do
    if [[ "$arg" == '-e' ]]; then
      probe=1
      break
    fi
  done

  tmp="$(mktemp)"
  printf '%s' "$input" >"$tmp"
  exit_code=0
  if (( probe )); then
    runner_exec "$label" --probe -- jq "$@" "$tmp" || exit_code=$?
  else
    runner_exec "$label" --stream-stdout -- jq "$@" "$tmp" || exit_code=$?
  fi
  rm -f "$tmp"
  return "$exit_code"
}

# rp_runner_jq_n <label> [jq -n args…]
rp_runner_jq_n() {
  local -r label="$1"
  shift
  local exit_code

  exit_code=0
  runner_exec "$label" --stream-stdout -- jq -n "$@" || exit_code=$?
  return "$exit_code"
}


