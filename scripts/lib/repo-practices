rp_check_github_merge_queue() {
  local slug="$1"
  local repo_fail=0
  local ci_text ci_fixed
  local fetch_ec=0
  local path_ec=0
  local dependabot_workflow dependabot_auto_text
  local strict=0

  if rp_is_strict_repo "$slug"; then
    strict=1
  fi

  path_ec=0
  rp_gh_path_check "$slug" '.github/workflows/ci.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/workflows/ci.yml'
    repo_fail=1
  elif (( path_ec == 1 )); then
    rp_log_fail "${slug}: missing .github/workflows/ci.yml (required for GitHub merge queue checks)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: add .github/workflows/ci.yml with merge_group: under on:"
    fi
    repo_fail=1
  else
    fetch_ec=0
    ci_text="$(rp_fetch_github_text_file "$slug" '.github/workflows/ci.yml')" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" 'could not read .github/workflows/ci.yml'
      repo_fail=1
    elif [[ -z "$ci_text" ]] || ! grep -qE '^[[:space:]]*merge_group:' <<<"$ci_text"; then
      rp_log_fail "${slug}: ci.yml must trigger on merge_group for GitHub merge queue"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add merge_group: under on: in .github/workflows/ci.yml"
      fi
      if [[ "$rp_apply_fix" -eq 1 ]] && [[ -n "${ci_text:-}" ]]; then
        ci_fixed="$(rp_fix_ci_workflow_add_merge_group "$ci_text")"
        rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
          "$ci_fixed" \
          'add-ci-merge-group' \
          'fix(ci): trigger CI on merge_group for GitHub MQ'
        rp_compact_record_fix "$slug" "${slug}: candidate PR: add merge_group trigger to ci.yml"
      fi
      repo_fail=1
    fi
  fi

  # Dependabot auto-merge for GitHub MQ (strict repos with dependabot.yml).
  path_ec=0
  rp_gh_path_check "$slug" '.github/dependabot.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/dependabot.yml'
    repo_fail=1
  elif (( path_ec == 0 )); then
    dependabot_workflow="$(rp_dependabot_auto_merge_workflow_path "$slug" || true)"
    if [[ -z "$dependabot_workflow" ]]; then
      if [[ "$strict" -eq 1 ]]; then
        rp_log_fail "${slug}: dependabot.yml present but no dependabot auto-merge workflow"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" '.github/workflows/dependabot-auto-merge.yml' \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: add dependabot auto-merge workflow'
        fi
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest \
            "${slug}: add dependabot-auto-merge.yml (gh pr merge --auto --squash for GitHub MQ)"
        fi
        repo_fail=1
      fi
    else
      fetch_ec=0
      dependabot_auto_text="$(rp_fetch_github_text_file "$slug" "$dependabot_workflow")" \
        || fetch_ec=$?
      if (( fetch_ec == 2 )); then
        rp_log_gh_api_fail "$slug" "could not read ${dependabot_workflow}"
        repo_fail=1
      elif [[ -z "$dependabot_auto_text" ]] \
        || ! grep -qF 'gh pr merge' <<<"$dependabot_auto_text" \
        || ! grep -qF -- '--auto' <<<"$dependabot_auto_text"; then
        rp_log_fail \
          "${slug}: ${dependabot_workflow} must enable auto-merge via gh pr merge --auto"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" "$dependabot_workflow" \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: update dependabot auto-merge for GitHub MQ'
        fi
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest \
            "${slug}: sync dependabot-auto-merge.yml to use gh pr merge --auto --squash"
        fi
        repo_fail=1
      fi
    fi
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'GitHub merge queue wiring' \
      "$(rp_github_url "$slug" '/settings/rules')"
    rp_log_manual_step \
      'You: merge via Enable auto-merge / Merge when ready (GitHub merge queue)' \
      "$(rp_github_url "$slug" '/queue/main')"
  else
    rp_log_check_fail "$slug" 'GitHub merge queue setup (see AGENTS.md)' \
      "$(rp_github_url "$slug" '/settings/rules')"
  fi

  return "$repo_fail"
}

rp_check_graphite_merge_queue() {
  local slug="$1"
  local mq_exit=0

  # Org default is GitHub native merge queue. Graphite MQ / merge-it is no longer
  # the happy path; leftover Graphite wiring is not required.
  rp_repo_uses_github_merge_queue "$slug" || mq_exit=$?
  if (( mq_exit == 0 )); then
    rp_check_github_merge_queue "$slug"
    return $?
  fi
  if (( mq_exit == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset for merge queue check'
    rp_log_check_fail "$slug" 'GitHub merge queue setup (GitHub API error; retry)' \
      "$(rp_github_url "$slug" '/settings/rules')"
    return 1
  fi

  # No merge_queue yet: require GitHub MQ wiring for strict onboarding / strict repos.
  if [[ "$rp_strict_onboarding" -eq 1 ]] \
    || { [[ "$rp_merge_only" -eq 0 ]] && rp_is_strict_repo "$slug"; }; then
    rp_check_github_merge_queue "$slug"
    return $?
  fi

  return 0
}

