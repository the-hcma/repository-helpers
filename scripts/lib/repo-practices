    if ! rp_check_license_metadata "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_git_commit_identity "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_no_secret_exposure "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pr_ship_and_review_rule "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pre_pr_checks_rule "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_stacking_tool "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_secret_audit_marker "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_stacking_docs_consistency "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_read_agents_and_rules "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_repo_practices_after_config_change "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_uv_python_cve_check_workflow "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_uv_release_please_lock_sync "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_python_static_ci_job "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_cursor_rules_gitignore "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_dependabot_release_age_policy "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pnpm_release_age_policy "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pnpm_corepack_ci "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
  fi
  rp_apply_candidate_fix_stack "$slug"

  return "$total_fail"
}

rp_main() {
  local prog="$1"
  shift
  local slug
  local total_fail=0
  local repo_count

  rp_parse_args "$prog" "$@"
  rp_require_tools

  repo_count="${#rp_repo_slugs[@]}"
  if [[ "$repo_count" -eq 1 ]]; then
    rp_single_repo=1
  elif [[ "$repo_count" -gt 1 ]]; then
    rp_track_failures=1
  fi

  if [[ "$rp_new_repo" -eq 1 ]]; then
    rp_print_new_repo_checklist "${rp_repo_slugs[0]}"
  fi

  if [[ "$rp_merge_only" -eq 0 ]]; then
    rp_check_ci_secret_scan_gitleaks_pin
  fi

  for slug in "${rp_repo_slugs[@]}"; do
    if [[ "$slug" != */* ]]; then
      rp_die "Invalid --repo (expected OWNER/NAME): ${slug}"
    fi
    if [[ "$repo_count" -gt 1 && "$rp_compact" -eq 0 ]]; then
      printf '\n%s\n' "$slug" >&2
    fi
    rp_current_slug="$slug"
    if ! rp_check_one_repo "$slug"; then
      total_fail=$(( total_fail + 1 ))
      if [[ "$rp_compact" -eq 1 || "$rp_track_failures" -eq 1 ]]; then
        rp_compact_failed_repos+=("$slug")
      fi
    elif [[ "$rp_compact" -eq 1 ]]; then
      rp_compact_passed_repos+=("$slug")
    fi
    rp_current_slug=""
  done

  if [[ "$rp_compact" -eq 1 ]]; then
    rp_compact_print_report
  fi

  if [[ "$total_fail" -gt 0 ]]; then
    if [[ "$rp_track_failures" -eq 1 && "$rp_compact" -eq 0 ]]; then
      rp_print_failure_summary
    fi
    if [[ "$rp_single_repo" -eq 1 ]]; then
      rp_print_final_status failed
    else
      rp_print_final_status failed \
        "${total_fail} of ${repo_count} repositories failed practices check"
    fi
    exit 1
  fi

  if [[ "$rp_single_repo" -eq 1 ]]; then
    if [[ "$rp_warn_count" -gt 0 ]]; then
      rp_print_final_status passed_with_warnings
    else
      rp_print_final_status passed
    fi
    return 0
  fi

  if [[ "$rp_warn_count" -gt 0 ]]; then
    rp_print_final_status passed_with_warnings \
      "all ${repo_count} repositories passed"
  else
    rp_print_final_status passed "all ${repo_count} repositories passed"
  fi
}
