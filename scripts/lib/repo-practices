rp_pr_ship_and_review_rule_template() {
  local path rule_url skill_url

  path="${rp_lib_dir}/repo-practices-cursor/pr-ship-and-review.mdc"
  rule_url="$(rp_pr_ship_and_review_canonical_rule_url)"
  skill_url="$(rp_pr_ship_and_review_canonical_skill_url)"

  if [[ ! -f "$path" ]]; then
    rp_die "internal error: missing cursor rule template: ${path}"
  fi
  sed -e "s|@@PR_SHIP_CANONICAL_RULE_URL@@|${rule_url}|g" \
    -e "s|@@PR_SHIP_CANONICAL_SKILL_URL@@|${skill_url}|g" "$path"
}

rp_pr_ship_and_review_rule_content_for_apply_fix() {
  local slug="$1"
  local repo_dir local_path

  if [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]]; then
    repo_dir="$(rp_resolve_local_repo_dir "$slug" || true)"
    if [[ -n "$repo_dir" ]]; then
      local_path="${repo_dir}/${rp_pr_ship_and_review_rule_path}"
      if [[ -f "$local_path" ]]; then
        cat "$local_path"
        return 0
      fi
    fi
  fi
  rp_pr_ship_and_review_rule_template
}

# True when the cursor rule references the canonical wait-for-agent-review flow
# and states reply-before-resolve (not only a defer link to repository-helpers).
rp_pr_ship_and_review_rule_is_valid() {
  local -r text="$1"
  local -r slug="$2"

  if ! grep -qF 'wait-for-agent-review' <<<"$text"; then
    return 1
  fi
  if grep -qF 'wait-for-copilot-review' <<<"$text"; then
    return 1
  fi
  if ! grep -qiE 'reply on-thread|reply-thread|reply before resolve' <<<"$text"; then
    return 1
  fi
  if ! grep -qE 'resolve-thread|resolve-addressed' <<<"$text"; then
    return 1
  fi
  if [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]]; then
    grep -qF 'scripts/wait-for-agent-review' <<<"$text" \
      && grep -qF '.cursor/skills/ship-and-review/SKILL.md' <<<"$text"
    return $?
  fi
  if ! grep -qE 'REPOSITORY_HELPERS_DIR|repository-helpers.*/scripts/wait-for-agent-review' <<<"$text"; then
    return 1
  fi
  grep -qE \
    'pr-ship-canonical-skill:|github\.com/[^/]+/'"${rp_THIS_REPO_NAME}"'/blob/[^/]+/\.cursor/skills/ship-and-review/SKILL\.md' \
    <<<"$text"
}

rp_check_pr_ship_and_review_rule() {
  local slug="$1"
  local repo_fail=0
  local rule_text

  rule_text="$(rp_fetch_github_text_file "$slug" "$rp_pr_ship_and_review_rule_path" || true)"
  if [[ -z "$rule_text" ]]; then
    repo_fail=1
    rp_log_check_fail "$slug" \
      'pr-ship-and-review cursor rule (.cursor/rules/pr-ship-and-review.mdc)' \
      "$(rp_github_url "$slug" '/new/main/.cursor/rules/pr-ship-and-review.mdc')"
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      rp_queue_candidate_file_fix "$slug" "$rp_pr_ship_and_review_rule_path" \
        "$(rp_pr_ship_and_review_rule_content_for_apply_fix "$slug")" \
        'add-pr-ship-and-review' \
        'chore: add agent review cursor rule'
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add .cursor/rules/pr-ship-and-review.mdc (template: scripts/lib/repo-practices-cursor/)"
    fi
  elif ! rp_pr_ship_and_review_rule_is_valid "$rule_text" "$slug"; then
    repo_fail=1
    if grep -qF 'wait-for-copilot-review' <<<"$rule_text"; then
      rp_log_check_fail "$slug" \
        'pr-ship-and-review rule must reference wait-for-agent-review (not legacy wait-for-copilot-review)' \
        "$(rp_github_url "$slug" "/blob/main/${rp_pr_ship_and_review_rule_path}")"
    elif ! grep -qF 'wait-for-agent-review' <<<"$rule_text"; then
      rp_log_check_fail "$slug" \
        'pr-ship-and-review rule must reference scripts/wait-for-agent-review' \
        "$(rp_github_url "$slug" "/blob/main/${rp_pr_ship_and_review_rule_path}")"
    elif [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]] \
      && ! grep -qF '.cursor/skills/ship-and-review/SKILL.md' <<<"$rule_text"; then
      rp_log_check_fail "$slug" \
        'pr-ship-and-review rule must reference .cursor/skills/ship-and-review/SKILL.md' \
        "$(rp_pr_ship_and_review_canonical_skill_url)"
    elif [[ "$(rp_repo_short_name "$slug")" != "$rp_THIS_REPO_NAME" ]] \
      && ! grep -qE \
        'pr-ship-canonical-skill:|github\.com/[^/]+/'"${rp_THIS_REPO_NAME}"'/blob/[^/]+/\.cursor/skills/ship-and-review/SKILL\.md' \
        <<<"$rule_text"; then
      rp_log_check_fail "$slug" \
        'pr-ship-and-review rule must link to the canonical playbook (pr-ship-canonical-skill breadcrumb)' \
        "$(rp_pr_ship_and_review_canonical_skill_url)"
    else
      rp_log_check_fail "$slug" \
        'pr-ship-and-review rule must document reply on-thread before resolve-thread' \
        "$(rp_github_url "$slug" "/blob/main/${rp_pr_ship_and_review_rule_path}")"
    fi
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      rp_queue_candidate_file_fix "$slug" "$rp_pr_ship_and_review_rule_path" \
        "$(rp_pr_ship_and_review_rule_content_for_apply_fix "$slug")" \
        'sync-pr-ship-and-review' \
        'chore: sync agent review cursor rule'
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: sync .cursor/rules/pr-ship-and-review.mdc to the canonical agent review flow (include pr-ship-canonical-skill breadcrumb and reply on-thread before resolve)"
    fi
  else
    rp_log_check_ok "$slug" 'pr-ship-and-review cursor rule' \
      "$(rp_github_url "$slug" "/blob/main/${rp_pr_ship_and_review_rule_path}")"
  fi

  return "$repo_fail"
}

