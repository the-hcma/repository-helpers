rp_fetch_workflow_file_names() {
  local slug="$1"
  local response

  local fetch_exit_code=0
  set +e
  response="$(rp_runner_gh_api_stream "repo-practices gh list workflows" \
    "repos/${slug}/contents/.github/workflows")"
  fetch_exit_code=$?
  set -e
  if (( fetch_exit_code != 0 )) || [[ -z "$response" ]]; then
    return 0
  fi
  # Missing .github/workflows returns a JSON error object on stdout (404/403).
  local type_exit_code=0
  rp_runner_jq_file "repo-practices workflows response type" "$response" \
    -e 'type == "array"' >/dev/null || type_exit_code=$?
  if (( type_exit_code != 0 )); then
    return 0
  fi
  rp_runner_jq_file "repo-practices workflow file names" "$response" \
    -r '.[]? | select(.type == "file") | .name // empty' 
}

# Every updates entry with package-ecosystem must include cooldown.default-days
# matching release_age_dependabot_days (all ecosystems, not npm-only).
rp_dependabot_has_release_age_cooldown() {
  local text="$1"
  local required_days="$release_age_dependabot_days"
  awk -v required_days="$required_days" '
    function finish_item() {
      if (has_ecosystem) {
        saw_entry = 1
        if (!item_cooldown_ok) {
          all_ok = 0
        }
      }
      has_ecosystem = 0
      item_cooldown_ok = 0
      in_cooldown = 0
      cd_indent = -1
    }
    BEGIN {
      in_updates = 0
      in_item = 0
      item_indent = -1
      has_ecosystem = 0
      in_cooldown = 0
      cd_indent = -1
      item_cooldown_ok = 0
      saw_entry = 0
      all_ok = 1
    }
    /^updates:[[:space:]]*$/ { in_updates = 1; next }
    !in_updates { next }
    /^[[:space:]]*-[[:space:]]/ {
      if (in_item) {
        finish_item()
      }
      in_item = 1
      item_indent = match($0, /[^ ]/) - 1
      if ($0 ~ /package-ecosystem:[[:space:]]*/) {
        has_ecosystem = 1
      }
      next
    }
    in_item {
      cur = match($0, /[^ ]/) - 1
      if (cur <= item_indent) {
        finish_item()
        in_item = 0
        next
      }
      if ($0 ~ /^[[:space:]]*package-ecosystem:[[:space:]]*/) {
        has_ecosystem = 1
      }
      if ($0 ~ /^[[:space:]]*cooldown:[[:space:]]*$/) {
        in_cooldown = 1
        cd_indent = match($0, /[^ ]/) - 1
        next
      }
      if (in_cooldown) {
        cur2 = match($0, /[^ ]/) - 1
        if (cur2 <= cd_indent) {
          in_cooldown = 0
          next
        }
        if ($0 ~ /^[[:space:]]*default-days:[[:space:]]*[0-9]+[[:space:]]*$/) {
          line = $0
          sub(/^[[:space:]]*default-days:[[:space:]]*/, "", line)
          sub(/[[:space:]]*$/, "", line)
          if ((line + 0) == required_days) {
            item_cooldown_ok = 1
          }
        }
      }
    }
    END {
      if (in_item) {
        finish_item()
      }
      exit((saw_entry && all_ok) ? 0 : 1)
    }
  ' <<<"$text"
}

# Candidate paths for pnpm minimumReleaseAge policy (root and common nested layouts).
rp_pnpm_workspace_candidate_paths() {
  printf '%s\n' 'pnpm-workspace.yaml' 'web/pnpm-workspace.yaml'
}

# minimumReleaseAge in pnpm-workspace.yaml must match release_age_dep_updater_minutes.
rp_pnpm_workspace_has_minimum_release_age() {
  local text="$1"
  local required_minutes="$release_age_dep_updater_minutes"
  awk -v required_minutes="$required_minutes" '
    /^[[:space:]]*minimumReleaseAge:[[:space:]]*[0-9]+[[:space:]]*$/ {
      line = $0
      sub(/^[[:space:]]*minimumReleaseAge:[[:space:]]*/, "", line)
      sub(/[[:space:]]*$/, "", line)
      if ((line + 0) == required_minutes) {
        found_ok = 1
      }
    }
    END { exit(found_ok ? 0 : 1) }
  ' <<<"$text"
}

rp_validate_dependabot_release_age_policy() {
  local slug="$1"
  local fail=0

  if ! rp_repo_has_dependabot "$slug"; then
    if [[ "$rp_suggest" -eq 1 ]] && rp_is_strict_repo "$slug"; then
      rp_log_suggest "${slug}: consider .github/dependabot.yml for automated dependency PRs"
    fi
    return 0
  fi

  local dependabot_text
  dependabot_text="$(rp_fetch_github_text_file "$slug" '.github/dependabot.yml' || true)"
  if [[ -z "$dependabot_text" ]]; then
    rp_log_fail "${slug}: dependabot.yml exists but could not be read"
    return 1
  fi
  if ! rp_dependabot_has_release_age_cooldown "$dependabot_text"; then
    rp_log_fail \
      "${slug}: dependabot.yml must set cooldown default-days: ${release_age_dependabot_days} on every updates entry (one day after dep-updater ${release_age_dep_updater_days}-day gate)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add 'cooldown: { default-days: ${release_age_dependabot_days} }' to each updates entry in .github/dependabot.yml (see scripts/lib/release-age-defaults)"
    fi
    fail=1
  fi

  return "$fail"
}

rp_validate_pnpm_release_age_policy() {
  local slug="$1"
  local fail=0
  local workspace_path workspace_text saw_workspace=0
  local path_ec=0
  local fetch_ec=0

  while IFS= read -r workspace_path; do
    [[ -n "$workspace_path" ]] || continue
    path_ec=0
    rp_gh_path_check "$slug" "$workspace_path" || path_ec=$?
    if (( path_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${workspace_path}"
      fail=1
      continue
    fi
    if (( path_ec != 0 )); then
      continue
    fi
    saw_workspace=1
    fetch_ec=0
    workspace_text="$(rp_fetch_github_text_file "$slug" "$workspace_path")" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${workspace_path}"
      fail=1
      continue
    fi
    if [[ -z "$workspace_text" ]]; then
      rp_log_fail "${slug}: ${workspace_path} exists but could not be read"
      fail=1
      continue
    fi
    if ! rp_pnpm_workspace_has_minimum_release_age "$workspace_text"; then
      rp_log_fail \
        "${slug}: ${workspace_path} must set minimumReleaseAge: ${release_age_dep_updater_minutes} (${release_age_dep_updater_days_phrase}; dep-updater gate before Dependabot cooldown)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: run scripts/grandfather-pnpm-release-age in the repo (or set minimumReleaseAge: ${release_age_dep_updater_minutes} with minimumReleaseAgeExclude: [\"*\"])"
      fi
      fail=1
    fi
  done < <(rp_pnpm_workspace_candidate_paths)

  if [[ "$saw_workspace" -eq 0 ]]; then
    return 0
  fi

  return "$fail"
}

rp_check_dependabot_release_age_policy() {
  local slug="$1"
  local repo_fail=0

  if ! rp_validate_dependabot_release_age_policy "$slug"; then
    repo_fail=1
  elif rp_repo_has_dependabot "$slug"; then
    rp_log_check_ok "$slug" \
      "dependabot cooldown (${release_age_dependabot_days} days on every updates entry)" \
      "$(rp_github_url "$slug" '/blob/main/.github/dependabot.yml')"
  fi

  return "$repo_fail"
}

rp_check_pnpm_release_age_policy() {
  local slug="$1"
  local repo_fail=0
  local workspace_path

  if ! rp_validate_pnpm_release_age_policy "$slug"; then
    repo_fail=1
  else
    while IFS= read -r workspace_path; do
      [[ -n "$workspace_path" ]] || continue
      if rp_gh_path_exists "$slug" "$workspace_path"; then
        rp_log_check_ok "$slug" \
          "pnpm minimumReleaseAge (${release_age_dep_updater_days_phrase})" \
          "$(rp_github_url "$slug" "/blob/main/${workspace_path}")"
      fi
    done < <(rp_pnpm_workspace_candidate_paths)
  fi

  return "$repo_fail"
}

# Candidate pnpm lockfiles (root and common nested layouts).
rp_pnpm_lock_candidate_paths() {
  printf '%s\n' 'pnpm-lock.yaml' 'web/pnpm-lock.yaml'
}

# Map lockfile path → package.json path.
rp_package_json_path_for_pnpm_lock() {
  local -r lock_path="$1"
  case "$lock_path" in
    pnpm-lock.yaml) printf '%s\n' 'package.json' ;;
    web/pnpm-lock.yaml) printf '%s\n' 'web/package.json' ;;
    *) return 1 ;;
  esac
}

# True when package.json text has exact "packageManager": "pnpm@X.Y.Z".
rp_package_json_has_exact_pnpm_package_manager() {
  local -r text="$1"
  grep -Eq '"packageManager"[[:space:]]*:[[:space:]]*"pnpm@[0-9]+\.[0-9]+\.[0-9]+"' <<<"$text"
}

# True when workflow text mentions pnpm/action-setup.
rp_workflow_uses_pnpm_action_setup() {
  local -r text="$1"
  grep -Eq 'pnpm/action-setup@' <<<"$text"
}

# True when workflow sets setup-node cache: pnpm (helper owns store cache instead).
# Accept quoted or unquoted YAML (`cache: pnpm` / `cache: 'pnpm'`).
rp_workflow_has_setup_node_pnpm_cache() {
  local -r text="$1"
  grep -Eq "cache:[[:space:]]*(pnpm|'pnpm'|\"pnpm\")([[:space:]]|$|#)" <<<"$text"
}

# Cache: pin SHA -> 1 (on main) / 0 (definitively not on main). Transient API
# failures are not cached so later callers retry.
if ! declare -p rp_helpers_sha_on_main_cache >/dev/null 2>&1; then
  declare -gA rp_helpers_sha_on_main_cache=()
fi

# Print each pin (ref after @) from active uses: lines for setup-pnpm-corepack.
# Ignores full-line YAML comments; does not accept @main/tags/PR tips as "found".
rp_workflow_setup_pnpm_corepack_pins() {
  local -r text="$1"
  local line trimmed uses_ref pin

  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
    # Match optional list dash, then uses: <action>@<ref>
    if [[ "$trimmed" =~ ^-?[[:space:]]*uses:[[:space:]]*([^[:space:]#]+) ]]; then
      uses_ref="${BASH_REMATCH[1]}"
      # YAML may quote the action ref; strip matching surrounding quotes.
      if [[ "$uses_ref" == \"*\" ]]; then
        uses_ref="${uses_ref:1:${#uses_ref}-2}"
      elif [[ "$uses_ref" == \'*\' ]]; then
        uses_ref="${uses_ref:1:${#uses_ref}-2}"
      fi
      if [[ "$uses_ref" == *'/repository-helpers/actions/setup-pnpm-corepack@'* ]] \
        || [[ "$uses_ref" == 'repository-helpers/actions/setup-pnpm-corepack@'* ]]; then
        pin="${uses_ref##*@}"
        printf '%s\n' "$pin"
      fi
    fi
  done <<<"$text"
}

# True when workflow has an active uses: pin of the helper to a full 40-char SHA.
# Comments, @main, tags, and short SHAs do not count.
rp_workflow_uses_setup_pnpm_corepack() {
  local -r text="$1"
  local pin
  local found=0

  # Drain the process substitution fully. Returning early on the first match
  # closes the pipe while the producer may still printf, which surfaces as
  # "printf: write error: Broken pipe" under set -e and pollutes enforcer emails.
  while IFS= read -r pin || [[ -n "$pin" ]]; do
    [[ -z "$pin" ]] && continue
    if [[ "$pin" =~ ^[0-9a-fA-F]{40}$ ]]; then
      found=1
    fi
  done < <(rp_workflow_setup_pnpm_corepack_pins "$text")
  [[ "$found" -eq 1 ]]
}

# rp_helpers_commit_reachable_from_main <40-char-sha>
# Exit 0 when the commit is an ancestor of (or equal to) repository-helpers main.
# Exit 1 when not on main. Exit 2 on GitHub API failure.
rp_helpers_commit_reachable_from_main() {
  local -r sha="$1"
  local -r helpers_slug="${rp_DEFAULT_ORG}/${rp_THIS_REPO_NAME}"
  local status
  local api_ec=0

  if [[ ! "$sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
    return 1
  fi

  if [[ -n "${rp_helpers_sha_on_main_cache[$sha]+x}" ]]; then
    case "${rp_helpers_sha_on_main_cache[$sha]}" in
      1) return 0 ;;
      0) return 1 ;;
      # Stale transient markers (if any) fall through so the compare is retried.
    esac
  fi

  # compare/main...sha: behind|identical => sha is on main history; ahead|diverged => not.
  status=''
  api_ec=0
  status="$(rp_runner_gh_api_stream "repo-practices helpers sha on main" \
    "repos/${helpers_slug}/compare/main...${sha}" --jq '.status // empty')" || api_ec=$?
  if (( api_ec != 0 )) || [[ -z "$status" ]]; then
    return 2
  fi
  if [[ "$status" == 'behind' || "$status" == 'identical' ]]; then
    rp_helpers_sha_on_main_cache[$sha]='1'
    return 0
  fi
  rp_helpers_sha_on_main_cache[$sha]='0'
  return 1
}

# True when a workflow appears to install or set up pnpm (needs the helper).
rp_workflow_needs_pnpm_corepack_helper() {
  local -r text="$1"
  if rp_workflow_uses_pnpm_action_setup "$text"; then
    return 0
  fi
  if rp_workflow_has_setup_node_pnpm_cache "$text"; then
    return 0
  fi
  # Avoid a `|pnpm` substring in one ERE — runner-adoption treats that as a bare
  # `pnpm` invocation after `|`.
  if grep -Eq 'corepack[[:space:]]+enable[[:space:]]+pnpm' <<<"$text"; then
    return 0
  fi
  if grep -Eq 'pnpm[[:space:]]+install' <<<"$text"; then
    return 0
  fi
  return 1
}

# rp_repo_has_pnpm_lock <slug>
# Exit 0 when any candidate lockfile exists; 1 when none; 2 on API error.
rp_repo_has_pnpm_lock() {
  local -r slug="$1"
  local lock_path
  local path_ec
  local saw=0

  while IFS= read -r lock_path; do
    [[ -n "$lock_path" ]] || continue
    path_ec=0
    rp_gh_path_check "$slug" "$lock_path" || path_ec=$?
    if (( path_ec == 2 )); then
      return 2
    fi
    if (( path_ec == 0 )); then
      saw=1
    fi
  done < <(rp_pnpm_lock_candidate_paths)

  if [[ "$saw" -eq 1 ]]; then
    return 0
  fi
  return 1
}

rp_validate_pnpm_package_manager_pins() {
  local -r slug="$1"
  local fail=0
  local lock_path pkg_path pkg_text
  local path_ec=0
  local fetch_ec=0
  local saw_lock=0

  while IFS= read -r lock_path; do
    [[ -n "$lock_path" ]] || continue
    path_ec=0
    rp_gh_path_check "$slug" "$lock_path" || path_ec=$?
    if (( path_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${lock_path}"
      fail=1
      continue
    fi
    if (( path_ec != 0 )); then
      continue
    fi
    saw_lock=1
    pkg_path="$(rp_package_json_path_for_pnpm_lock "$lock_path")" || continue
    fetch_ec=0
    pkg_text="$(rp_fetch_github_text_file "$slug" "$pkg_path")" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${pkg_path}"
      fail=1
      continue
    fi
    if [[ -z "$pkg_text" ]]; then
      rp_log_fail "${slug}: ${lock_path} present but ${pkg_path} missing or unreadable"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: add exact \"packageManager\": \"pnpm@X.Y.Z\" to ${pkg_path}"
      fi
      fail=1
      continue
    fi
    if ! rp_package_json_has_exact_pnpm_package_manager "$pkg_text"; then
      rp_log_fail \
        "${slug}: ${pkg_path} must set exact \"packageManager\": \"pnpm@X.Y.Z\" (Corepack / CI SSOT)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: set packageManager to an exact pnpm@X.Y.Z and use actions/setup-pnpm-corepack in CI (see repository-helpers#362)"
      fi
      fail=1
    fi
  done < <(rp_pnpm_lock_candidate_paths)

  if [[ "$saw_lock" -eq 0 ]]; then
    return 0
  fi
  return "$fail"
}

rp_validate_pnpm_ci_corepack() {
  local -r slug="$1"
  # When "1", caller already confirmed a pnpm lockfile exists — skip re-probing.
  local -r assume_has_lock="${2:-0}"
  local fail=0
  local workflow_name workflow_path workflow_text
  local fetch_ec=0
  local has_lock_ec=0
  local pin saw_any_pin=0
  local reach_ec=0

  if [[ "$assume_has_lock" != "1" ]]; then
    has_lock_ec=0
    rp_repo_has_pnpm_lock "$slug" || has_lock_ec=$?
    if (( has_lock_ec == 2 )); then
      rp_log_gh_api_fail "$slug" 'could not probe pnpm-lock.yaml paths'
      return 1
    fi
    if (( has_lock_ec != 0 )); then
      return 0
    fi
  fi

  while IFS= read -r workflow_name; do
    [[ -n "$workflow_name" ]] || continue
    workflow_path=".github/workflows/${workflow_name}"
    fetch_ec=0
    workflow_text="$(rp_fetch_github_text_file "$slug" "$workflow_path")" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${workflow_path}"
      fail=1
      continue
    fi
    if [[ -z "$workflow_text" ]]; then
      continue
    fi

    if rp_workflow_uses_pnpm_action_setup "$workflow_text"; then
      rp_log_fail \
        "${slug}: ${workflow_path} must not use pnpm/action-setup (use the-hcma/repository-helpers/actions/setup-pnpm-corepack)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: replace pnpm/action-setup with setup-node + setup-pnpm-corepack (no version: latest; see repository-helpers#362)"
      fi
      fail=1
    fi

    if rp_workflow_has_setup_node_pnpm_cache "$workflow_text"; then
      rp_log_fail \
        "${slug}: ${workflow_path} must not set setup-node cache: 'pnpm' (setup-pnpm-corepack owns the store cache)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: drop cache: 'pnpm' from setup-node and use actions/setup-pnpm-corepack"
      fi
      fail=1
    fi

    if rp_workflow_needs_pnpm_corepack_helper "$workflow_text" \
      && ! rp_workflow_uses_setup_pnpm_corepack "$workflow_text"; then
      # action-setup / cache: pnpm already failed above; still require helper for
      # inline corepack enable pnpm / pnpm install without the shared action.
      if ! rp_workflow_uses_pnpm_action_setup "$workflow_text" \
        && ! rp_workflow_has_setup_node_pnpm_cache "$workflow_text"; then
        # Distinguish missing helper vs present but not pinned to a full SHA.
        saw_any_pin=0
        while IFS= read -r pin || [[ -n "$pin" ]]; do
          [[ -z "$pin" ]] && continue
          saw_any_pin=1
          rp_log_fail \
            "${slug}: ${workflow_path} setup-pnpm-corepack must pin a full 40-char SHA on main (got @${pin})"
          if [[ "$rp_suggest" -eq 1 ]]; then
            rp_log_suggest \
              "${slug}: use the-hcma/repository-helpers/actions/setup-pnpm-corepack@<full-sha-on-main> (not @main/tags/PR tips)"
          fi
          fail=1
        done < <(rp_workflow_setup_pnpm_corepack_pins "$workflow_text")
        if [[ "$saw_any_pin" -eq 0 ]]; then
          rp_log_fail \
            "${slug}: ${workflow_path} sets up or installs pnpm without repository-helpers/actions/setup-pnpm-corepack"
          if [[ "$rp_suggest" -eq 1 ]]; then
            rp_log_suggest \
              "${slug}: after setup-node, pin the-hcma/repository-helpers/actions/setup-pnpm-corepack@<full-sha-on-main> (working-directory: . or web; see actions/setup-pnpm-corepack/README.md)"
          fi
          fail=1
        fi
      fi
    elif rp_workflow_uses_setup_pnpm_corepack "$workflow_text"; then
      # Enforce SHA-on-main for every active full-SHA pin (mutable refs already failed above).
      while IFS= read -r pin || [[ -n "$pin" ]]; do
        [[ -z "$pin" ]] && continue
        [[ "$pin" =~ ^[0-9a-fA-F]{40}$ ]] || continue
        reach_ec=0
        rp_helpers_commit_reachable_from_main "$pin" || reach_ec=$?
        if (( reach_ec == 2 )); then
          rp_log_gh_api_fail "$slug" \
            "could not verify setup-pnpm-corepack@${pin} is on ${rp_DEFAULT_ORG}/${rp_THIS_REPO_NAME} main"
          fail=1
        elif (( reach_ec != 0 )); then
          rp_log_fail \
            "${slug}: ${workflow_path} setup-pnpm-corepack@${pin} is not reachable on ${rp_DEFAULT_ORG}/${rp_THIS_REPO_NAME} main"
          if [[ "$rp_suggest" -eq 1 ]]; then
            rp_log_suggest \
              "${slug}: retarget the pin to a merge commit SHA that is on ${rp_DEFAULT_ORG}/${rp_THIS_REPO_NAME} main"
          fi
          fail=1
        fi
      done < <(rp_workflow_setup_pnpm_corepack_pins "$workflow_text")
    fi
  done < <(rp_fetch_workflow_file_names "$slug")

  return "$fail"
}

rp_check_pnpm_corepack_ci() {
  local slug="$1"
  local repo_fail=0
  local has_lock_ec=0

  # Probe lockfiles once; pin validation walks candidates for package.json checks,
  # and CI validation skips a second existence probe when assume_has_lock=1.
  has_lock_ec=0
  rp_repo_has_pnpm_lock "$slug" || has_lock_ec=$?
  if (( has_lock_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not probe pnpm-lock.yaml paths'
    return 1
  fi
  if (( has_lock_ec != 0 )); then
    return 0
  fi

  if ! rp_validate_pnpm_package_manager_pins "$slug"; then
    repo_fail=1
  fi
  if ! rp_validate_pnpm_ci_corepack "$slug" 1; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" \
      'pnpm packageManager pin + Corepack CI helper' \
      "$(rp_github_url "$slug" '/blob/main/package.json')"
  fi

  return "$repo_fail"
}

