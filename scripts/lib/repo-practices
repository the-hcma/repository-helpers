      "$(rp_github_url "$slug" '/new/main?filename=LICENSE')"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add a top-level LICENSE file (MIT is the org default unless the repo needs otherwise)"
    fi
  fi

  copyright_path="$(
    rp_find_repo_copyright_notice_path "$slug" "$license_path" "$license_text" || true
  )"
  if [[ -n "$copyright_path" ]]; then
    rp_log_check_ok "$slug" "copyright notice (${copyright_path})" \
      "$(rp_github_url "$slug" "/blob/main/${copyright_path}")"
  else
    repo_fail=1
    rp_log_check_fail "$slug" 'copyright notice (add Copyright (c) YEAR OWNER)' \
      "$(rp_github_url "$slug" '/tree/main')"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: add a copyright notice to LICENSE, NOTICE, COPYRIGHT, or README.md"
    fi
  fi

  codeowners_blob="$(rp_fetch_repo_codeowners_file "$slug" || true)"
  if [[ -n "$codeowners_blob" ]]; then
    codeowners_path="${codeowners_blob%%$'\n'*}"
    codeowners_text="${codeowners_blob#*$'\n'}"
    if rp_codeowners_has_global_owner_rule "$codeowners_text"; then
      rp_log_check_ok "$slug" "CODEOWNERS (${codeowners_path})" \
        "$(rp_github_url "$slug" "/blob/main/${codeowners_path}")"
    else
      repo_fail=1
      rp_log_check_fail "$slug" 'CODEOWNERS must include a repository-wide "* @owner" rule' \
        "$(rp_github_url "$slug" "/blob/main/${codeowners_path}")"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_apply_codeowners_pr "$slug"
      elif [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add '* @OWNER' to CODEOWNERS so CODEOWNER review covers all files"
      fi
    fi
  else
    repo_fail=1
    rp_log_check_fail "$slug" 'CODEOWNERS (add .github/CODEOWNERS)' \
      "$(rp_github_url "$slug" '/new/main?filename=.github/CODEOWNERS')"
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      rp_apply_codeowners_pr "$slug"
    elif [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: run scripts/github-repo-lint --repo ${slug} --apply-fix to open a CODEOWNERS PR"
    fi
  fi

  return "$repo_fail"
}

# Warn when scripts/lib/ci-secret-scan pins a gitleaks release behind the newest
# eligible version (same ${release_age_dep_updater_days}-day gate as dep-updater).
rp_check_ci_secret_scan_gitleaks_pin() {
  local script_path pinned eligible

  script_path="${rp_lib_dir}/ci-secret-scan"
  if [[ ! -f "$script_path" ]]; then
    return 0
  fi

  pinned="$(ci_secret_scan_policy_read_pinned_version "$script_path" || true)"
  if [[ -z "$pinned" ]]; then
    rp_log_warn 'ci-secret-scan: could not read ci_secret_scan_version pin'
    return 0
  fi

  eligible="$(ci_secret_scan_policy_pick_eligible_gitleaks_version 2>/dev/null || true)"
  if [[ -z "$eligible" ]]; then
    return 0
  fi

  if ! ci_secret_scan_policy_version_is_older_than "$pinned" "$eligible"; then
    rp_log_check_ok "${rp_DEFAULT_ORG}/${rp_THIS_REPO_NAME}" \
      "ci-secret-scan gitleaks pin (${pinned})" \
      'https://github.com/gitleaks/gitleaks/releases'
    return 0
  fi

  rp_log_warn \
    "ci-secret-scan: gitleaks pin ${pinned} is behind eligible ${eligible} (${release_age_dep_updater_days_phrase} release-age gate)"
  rp_log_suggest \
    "bump ci_secret_scan_version to ${eligible} in scripts/lib/ci-secret-scan, merge ${rp_THIS_REPO_NAME}, then sync consumer repos with scripts/github-repo-lint --repo OWNER/NAME --apply-fix"
  rp_log_manual_step \
    "edit scripts/lib/ci-secret-scan: ci_secret_scan_version='${eligible}'"
  rp_log_manual_step \
    "run scripts/dev/pre-pr-checks and merge the ${rp_THIS_REPO_NAME} PR"
  rp_log_manual_step \
    'sync each consumer repo: scripts/github-repo-lint --repo OWNER/NAME --apply-fix (every repo with secret-scan)'
  return 0
}

rp_check_one_repo() {
  local slug="$1"
  local total_fail=0

  if ! rp_check_release_please "$slug"; then
    total_fail=$(( total_fail + 1 ))
  fi
  if ! rp_check_protect_main_ruleset "$slug"; then
    total_fail=$(( total_fail + 1 ))
  fi
  if [[ "$rp_merge_only" -eq 0 ]]; then
    if ! rp_check_classic_main_protection "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
  fi
  if ! rp_check_graphite_merge_queue "$slug"; then
    total_fail=$(( total_fail + 1 ))
  fi
  if [[ "$rp_merge_only" -eq 0 ]]; then
    if ! rp_check_workflow_file_extensions "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_branch_hygiene "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_license_metadata "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pr_ship_and_review_rule "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_uv_python_cve_check_workflow "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_python_static_ci_job "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_cursor_rules_gitignore "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_dependabot_release_age_policy "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pnpm_release_age_policy "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
    if ! rp_check_pnpm_corepack_ci "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
  fi
  rp_apply_candidate_fix_stack "$slug"

  return "$total_fail"
}

rp_main() {
  local prog="$1"
  shift
  local slug
  local total_fail=0
  local repo_count

  rp_parse_args "$prog" "$@"
  rp_require_tools

  repo_count="${#rp_repo_slugs[@]}"
  if [[ "$repo_count" -eq 1 ]]; then
    rp_single_repo=1
  elif [[ "$repo_count" -gt 1 ]]; then
    rp_track_failures=1
  fi

  if [[ "$rp_new_repo" -eq 1 ]]; then
    rp_print_new_repo_checklist "${rp_repo_slugs[0]}"
  fi

  if [[ "$rp_merge_only" -eq 0 ]]; then
    rp_check_ci_secret_scan_gitleaks_pin
  fi

  for slug in "${rp_repo_slugs[@]}"; do
    if [[ "$slug" != */* ]]; then
      rp_die "Invalid --repo (expected OWNER/NAME): ${slug}"
    fi
    if [[ "$repo_count" -gt 1 && "$rp_compact" -eq 0 ]]; then
      printf '\n%s\n' "$slug" >&2
    fi
    rp_current_slug="$slug"
    if ! rp_check_one_repo "$slug"; then
      total_fail=$(( total_fail + 1 ))
      if [[ "$rp_compact" -eq 1 || "$rp_track_failures" -eq 1 ]]; then
        rp_compact_failed_repos+=("$slug")
      fi
    elif [[ "$rp_compact" -eq 1 ]]; then
      rp_compact_passed_repos+=("$slug")
    fi
    rp_current_slug=""
  done

  if [[ "$rp_compact" -eq 1 ]]; then
    rp_compact_print_report
  fi

  if [[ "$total_fail" -gt 0 ]]; then
    if [[ "$rp_track_failures" -eq 1 && "$rp_compact" -eq 0 ]]; then
      rp_print_failure_summary
    fi
    if [[ "$rp_single_repo" -eq 1 ]]; then
      rp_print_final_status failed
    else
      rp_print_final_status failed \
        "${total_fail} of ${repo_count} repositories failed practices check"
    fi
    exit 1
  fi

  if [[ "$rp_single_repo" -eq 1 ]]; then
    if [[ "$rp_warn_count" -gt 0 ]]; then
      rp_print_final_status passed_with_warnings
    else
      rp_print_final_status passed
    fi
    return 0
  fi

  if [[ "$rp_warn_count" -gt 0 ]]; then
    rp_print_final_status passed_with_warnings \
      "all ${repo_count} repositories passed"
  else
    rp_print_final_status passed "all ${repo_count} repositories passed"
  fi
}
