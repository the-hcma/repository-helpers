rp_ci_secret_scan_script_is_canonical() {
  local text="$1"
  local canonical norm_text norm_canonical
  canonical="$(rp_candidate_secret_scan_script)"
  if [[ "$text" == "$canonical" ]]; then
    return 0
  fi
  norm_text="$(rp_ci_secret_scan_normalize_for_compare "$text")"
  norm_canonical="$(rp_ci_secret_scan_normalize_for_compare "$canonical")"
  [[ "$norm_text" == "$norm_canonical" ]]
}

rp_ci_secret_scan_unified_diff() {
  local label_left="$1"
  local text_left="$2"
  local label_right="$3"
  local text_right="$4"
  local max_lines="${5:-48}"
  local tmp_left tmp_right diff_out diff_lines diff_exit

  tmp_left="$(mktemp)"
  tmp_right="$(mktemp)"
  diff_out="$(mktemp)"
  printf '%s' "$text_left" >"$tmp_left"
  printf '%s' "$text_right" >"$tmp_right"
  diff_exit=0
  runner_exec "repo-practices secret-scan diff" \
    -- diff -u --label "$label_left" --label "$label_right" "$tmp_left" "$tmp_right" \
    >"$diff_out" 2>/dev/null || diff_exit=$?
  if [[ -s "$diff_out" ]]; then
    diff_lines="$(wc -l <"$diff_out")"
    while IFS= read -r line || [[ -n "${line}" ]]; do
      rp_log_fail_detail "$line"
    done < <(head -n "$max_lines" "$diff_out")
    if (( diff_lines > max_lines )); then
      rp_log_fail_detail "... (diff truncated at ${max_lines} lines)"
    fi
  elif (( diff_exit != 0 )) && [[ "$text_left" != "$text_right" ]]; then
    rp_log_fail_detail "(installed and canonical content differ)"
  fi
  rm -f "$tmp_left" "$tmp_right" "$diff_out"
}

# Log specific secret-scan drift reasons with unified diffs. Returns 1 when drift exists.
rp_ci_secret_scan_install_report_drift() {
  local slug="$1"
  local secret_scan_script="$2"
  local ci_text="$3"
  local canonical_script canonical_job job drift=0

  canonical_script="$(rp_candidate_secret_scan_script)"
  canonical_job="$(rp_candidate_ci_secret_scan_job_yaml)"
  job="$(rp_ci_workflow_extract_secret_scan_job "$ci_text")"

  if [[ -z "$secret_scan_script" ]]; then
    rp_log_fail "${slug}: secret-scan: missing .github/ci/secret-scan (copy from scripts/lib/ci-secret-scan)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: sync .github/ci/secret-scan and ci.yml secret-scan job (scripts/github-repo-lint --apply-fix)"
    fi
    drift=1
  elif ! rp_ci_secret_scan_script_is_canonical "$secret_scan_script"; then
    rp_log_fail "${slug}: secret-scan: .github/ci/secret-scan drift from scripts/lib/ci-secret-scan"
    rp_ci_secret_scan_unified_diff \
      '.github/ci/secret-scan (installed)' "$secret_scan_script" \
      'scripts/lib/ci-secret-scan (canonical)' "$canonical_script"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: sync .github/ci/secret-scan (scripts/github-repo-lint --apply-fix)"
    fi
    drift=1
  fi

  if ! rp_ci_workflow_secret_scan_job_is_canonical "$ci_text"; then
    rp_log_fail \
      "${slug}: secret-scan: ci.yml secret-scan job drift from scripts/lib/repo-practices-workflows/ci-secret-scan-job.snippet"
    rp_ci_secret_scan_unified_diff \
      'ci.yml secret-scan job (installed)' "$job" \
      'ci-secret-scan-job.snippet (canonical)' "$canonical_job"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: sync ci.yml secret-scan job (scripts/github-repo-lint --apply-fix)"
    fi
    drift=1
  fi

  if rp_ci_workflow_has_brittle_gitleaks_install "$ci_text"; then
    rp_log_fail "${slug}: secret-scan: ci.yml uses brittle inline gitleaks install (use bash .github/ci/secret-scan)"
    drift=1
  fi

  if (( drift == 0 )); then
    return 0
  fi
  return 1
}

rp_fix_ci_workflow_secret_scan_job() {
  local text="$1"
  local block_path
  block_path="$(mktemp)"
  rp_candidate_ci_secret_scan_job_yaml >"$block_path"
  awk -v block_path="$block_path" '
    BEGIN {
      replacing = 0
      while ((getline block_line < block_path) > 0) {
        block = block block_line "\n"
      }
      close(block_path)
    }
    /^  [a-zA-Z0-9_.-]+:/ {
      if (replacing) {
        replacing = 0
      }
      if ($0 ~ /^  secret-scan:/) {
        printf "%s", block
        replacing = 1
        next
      }
    }
    replacing { next }
    { print }
  ' <<<"$text"
  rm -f "$block_path"
}

rp_ci_workflow_has_secret_scan_coverage() {
  local text="$1"
  rp_ci_workflow_has_secret_scan_job "$text" || grep -qF 'gitleaks' <<<"$text"
}

rp_add_ci_secret_scan_job_to_workflow() {
  local text="$1"

  if rp_ci_workflow_has_secret_scan_job "$text"; then
    printf '%s' "$text"
    return 0
  fi
  if [[ "$text" != *$'\n' ]]; then
    text="${text}"$'\n'
  fi
  printf '%s%s\n' "$text" "$(rp_candidate_ci_secret_scan_job_yaml)"
}

rp_queue_ci_secret_scan_candidate_fixes() {
  local slug="$1"
  local ci_text="$2"
  local mode="$3"

  rp_queue_candidate_file_fix "$slug" '.github/ci/secret-scan' \
    "$(rp_candidate_secret_scan_script)" \
    'sync-secret-scan-script' \
    'fix(ci): sync canonical secret-scan script'

  if [[ "$mode" == 'add' ]]; then
    rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
      "$(rp_fix_ci_workflow_hardening "$(rp_add_ci_secret_scan_job_to_workflow "$ci_text")")" \
      'add-secret-scan-job' \
      'feat(ci): add secret-scan job'
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: add secret-scan script and ci.yml job"
    return 0
  fi

  if rp_ci_workflow_has_secret_scan_job "$ci_text"; then
    rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
      "$(rp_fix_ci_workflow_hardening "$ci_text")" \
      'sync-secret-scan-job' \
      'fix(ci): harden secret-scan job and CI concurrency'
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: sync secret-scan script and ci.yml job"
  else
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: sync secret-scan script"
  fi
}

rp_queue_candidate_file_fix() {
  local slug="$1"
  local path="$2"
  local content="$3"
  local branch_suffix="$4"
  local message="$5"
  local key

  if [[ "$path" == /* || "$path" == *'..'* ]]; then
    rp_die "internal error: unsafe candidate fix path: ${path}"
  fi

  key="${slug}|${path}"
  if [[ -n "${rp_candidate_fix_seen[$key]:-}" ]]; then
    return 0
  fi
  rp_candidate_fix_seen[$key]=1
  rp_candidate_fix_keys+=("$key")
  rp_candidate_fix_paths[$key]="$path"
  rp_candidate_fix_contents[$key]="$content"
  rp_candidate_fix_branch_suffixes[$key]="$branch_suffix"
  rp_candidate_fix_messages[$key]="$message"
}

rp_git_remote_slug_for_dir() {
  local repo_dir="$1"
  local remote_url slug

  local remote_exit_code=0
  set +e
  remote_url="$(rp_runner_exec_stdout "repo-practices git remote get-url origin" \
    -- git -C "$repo_dir" remote get-url origin)"
  remote_exit_code=$?
  set -e
  remote_url="${remote_url//$'\n'/}"
  if (( remote_exit_code != 0 )); then
    remote_url=""
  fi
  if [[ -z "$remote_url" ]]; then
    return 1
  fi
  slug="$(printf '%s' "$remote_url" \
    | sed -E 's#^git@github.com:##; s#^ssh://git@github.com/##; s#^https://github.com/##; s#\.git$##')"
  if [[ "$slug" == */* ]]; then
    printf '%s\n' "$slug"
    return 0
  fi
  return 1
}

rp_resolve_local_repo_dir() {
  local slug="$1"
  local repo_root repo_slug
  local git_exit_code=0

  repo_root=""
  set +e
  repo_root="$(rp_runner_exec_stdout "repo-practices git rev-parse show-toplevel local" \
    -- git rev-parse --show-toplevel)"
  git_exit_code=$?
  set -e
  repo_root="${repo_root//$'\n'/}"
  if (( git_exit_code != 0 )); then
    repo_root=""
  fi
  if [[ -z "$repo_root" ]]; then
    return 1
  fi
  repo_slug="$(rp_git_remote_slug_for_dir "$repo_root" || true)"
  if [[ "$repo_slug" == "$slug" ]]; then
    printf '%s\n' "$repo_root"
    return 0
  fi
  return 1
}

readonly rp_cursor_rules_gitignore_probe_path='.cursor/rules/pr-ship-and-review.mdc'

# True when gitignore text would ignore .cursor/rules/ without !.cursor/rules/ and !.cursor/rules/**.
rp_gitignore_text_blocks_cursor_rules() {
  local text="$1"

  [[ -n "$text" ]] || return 1
  if grep -qE '^/?\.cursor/rules(/|\*|$)|^/?\.cursor/rules/\*\*' <<<"$text"; then
    return 0
  fi
  if ! grep -qE '^/?\.cursor(/$|/\*$|$)' <<<"$text"; then
    return 1
  fi
  if grep -qF '!.cursor/rules/' <<<"$text" && grep -qF '!.cursor/rules/**' <<<"$text"; then
    return 1
  fi
  return 0
}

rp_check_cursor_rules_gitignore() {
  local slug="$1"
  local repo_fail=0
  local repo_dir gitignore_text

  if repo_dir="$(rp_resolve_local_repo_dir "$slug" 2>/dev/null)"; then
    local ignore_exit_code=0
    runner_exec "repo-practices git check-ignore cursor rules" --probe \
      -- git -C "$repo_dir" check-ignore --no-index -q "$rp_cursor_rules_gitignore_probe_path" \
      || ignore_exit_code=$?
    if (( ignore_exit_code == 0 )); then
      repo_fail=1
      rp_log_check_fail "$slug" \
        '.gitignore must not ignore .cursor/rules/ (org cursor rules must be trackable)' \
        "$(rp_github_url "$slug" '/blob/main/.gitignore')"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: un-ignore .cursor/rules/ in .gitignore (e.g. .cursor/* with !.cursor/rules/ and !.cursor/rules/**)"
      fi
    else
      rp_log_check_ok "$slug" '.cursor/rules/ is trackable in .gitignore' \
        "$(rp_github_url "$slug" '/blob/main/.gitignore')"
    fi
    return "$repo_fail"
  fi

  gitignore_text="$(rp_fetch_github_text_file "$slug" ".gitignore" || true)"
  if [[ -z "$gitignore_text" ]]; then
    rp_log_check_ok "$slug" '.cursor/rules/ is trackable (.gitignore absent or no block)' \
      "$(rp_github_url "$slug" '/blob/main/.gitignore')"
    return 0
  fi
  if rp_gitignore_text_blocks_cursor_rules "$gitignore_text"; then
    repo_fail=1
    rp_log_check_fail "$slug" \
      '.gitignore must not ignore .cursor/rules/ (org cursor rules must be trackable)' \
      "$(rp_github_url "$slug" '/blob/main/.gitignore')"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: un-ignore .cursor/rules/ in .gitignore (e.g. .cursor/* with !.cursor/rules/ and !.cursor/rules/**)"
    fi
  else
    rp_log_check_ok "$slug" '.cursor/rules/ is trackable in .gitignore' \
      "$(rp_github_url "$slug" '/blob/main/.gitignore')"
  fi

  return "$repo_fail"
}

rp_candidate_branch_has_path() {
  local -r worktree_path="$1"
  local -r branch="$2"
  local -r path="$3"
  local exit_code=0

  runner_exec "repo-practices git show candidate path" \
    -- git -C "$worktree_path" show "${branch}:${path}" || exit_code=$?
  (( exit_code == 0 ))
}

rp_candidate_worktree_path() {
  local repo_dir="$1"
  local primary_dir wt_list wt_exit_code=0

  wt_list=""
  set +e
  rp_runner_git_stream "repo-practices git worktree list porcelain" \
    -C "$repo_dir" worktree list --porcelain >/dev/null
  wt_exit_code=$?
  set -e
  wt_list="$(rp_runner_last_stdout)"
  if (( wt_exit_code != 0 )) || [[ -z "$wt_list" ]]; then
    return 1
  fi
  primary_dir="$(printf '%s' "$wt_list" | awk 'NR == 1 { print $2; exit }')"
  if [[ -z "$primary_dir" ]]; then
    return 1
  fi
  printf '%s\n' "${primary_dir}/.worktrees/repo-practices-candidate-fixes-wt"
}

rp_prepare_candidate_worktree() {
  local repo_dir="$1"
  local default_branch="$2"
  local worktree_path worktrees_dir status

  worktree_path="$(rp_candidate_worktree_path "$repo_dir")"
  worktrees_dir="$(dirname "$worktree_path")"
  mkdir -p "$worktrees_dir"

  if [[ -d "$worktree_path" ]]; then
    status=""
    set +e
    status="$(rp_runner_exec_stdout "repo-practices git status porcelain candidate" \
      -- git -C "$worktree_path" status --porcelain)"
    set -e
    status="${status//$'\n'/}"
    if [[ -n "$status" ]]; then
      rp_die "candidate fix worktree has local changes: ${worktree_path}"
    fi
    printf '%s\n' "$worktree_path"
    return 0
  fi

  local wt_list

  runner_exec "repo-practices git worktree prune" \
    -- git -C "$repo_dir" worktree prune || true
  wt_list=""
  set +e
  rp_runner_git_stream "repo-practices git worktree list check" \
    -C "$repo_dir" worktree list --porcelain >/dev/null
  set -e
  wt_list="$(rp_runner_last_stdout)"
  if grep -qF "worktree ${worktree_path}" <<<"$wt_list"; then
    runner_exec "repo-practices git worktree remove" \
      -- git -C "$repo_dir" worktree remove --force "$worktree_path" || true
  fi
  rm -rf "$worktree_path"

  runner_exec "repo-practices git fetch origin" \
    -- git -C "$repo_dir" fetch --prune origin
  runner_exec "repo-practices git worktree add" \
    -- git -C "$repo_dir" worktree add --detach "$worktree_path" "origin/${default_branch}"
  printf '%s\n' "$worktree_path"
}

rp_apply_candidate_fix_stack() {
  local slug="$1"
  local repo_dir default_branch worktree_path key key_slug path content branch_suffix message
  local branch parent_branch parent_ref created_any has_candidate path_dir status

  if [[ "$rp_apply_fix" -ne 1 ]]; then
    return 0
  fi

  has_candidate=0
  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    if [[ "$key_slug" == "$slug" ]]; then
      has_candidate=1
      break
    fi
  done
  if [[ "$has_candidate" -eq 0 ]]; then
    return 0
  fi

  created_any=0
  if ! repo_dir="$(rp_resolve_local_repo_dir "$slug")"; then
    rp_log_warn "${slug}: candidate workflow PRs require running --apply-fix from the local clone"
    return 0
  fi

  default_branch="$(rp_runner_gh_api_stream "repo-practices default branch" "repos/${slug}" --jq '.default_branch // "main"')"
  worktree_path="$(rp_prepare_candidate_worktree "$repo_dir" "$default_branch")"
  parent_branch="$default_branch"
  parent_ref="origin/${default_branch}"

  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    [[ "$key_slug" == "$slug" ]] || continue
    path="${rp_candidate_fix_paths[$key]}"
    content="${rp_candidate_fix_contents[$key]}"
    branch_suffix="${rp_candidate_fix_branch_suffixes[$key]}"
    message="${rp_candidate_fix_messages[$key]}"
    branch="repo-practices/${branch_suffix}"

    local show_ref_exit_code=0
    runner_exec "repo-practices git show-ref branch" \
      -- git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${branch}" \
      || show_ref_exit_code=$?
    if (( show_ref_exit_code == 0 )); then
      if rp_candidate_branch_has_path "$worktree_path" "$branch" "$path"; then
        rp_log_warn "${slug}: candidate branch already exists, skipping ${branch}"
        parent_branch="$branch"
        parent_ref="$branch"
        continue
      fi
      rp_log_warn "${slug}: stale candidate branch ${branch} missing ${path}; recreating"
      runner_exec "repo-practices git branch delete stale" \
        -- git -C "$worktree_path" branch -D "$branch"
    fi

    runner_exec "repo-practices git checkout candidate branch" \
      -- git -C "$worktree_path" checkout -B "$branch" "$parent_ref"
    path_dir="$(dirname "${worktree_path}/${path}")"
    mkdir -p "$path_dir"
    printf '%s\n' "$content" >"${worktree_path}/${path}"
    runner_exec "repo-practices git add candidate path" \
      -- git -C "$worktree_path" add "$path"
    local diff_exit_code=0
    runner_exec "repo-practices git diff cached quiet" \
      -- git -C "$worktree_path" diff --cached --quiet || diff_exit_code=$?
    if (( diff_exit_code == 0 )); then
      rp_log_warn "${slug}: candidate fix has no file changes for ${path}"
      continue
    fi
    runner_exec "repo-practices git commit candidate fix" \
      -- git -C "$worktree_path" commit -m "$message"
    local gt_cli='gt'
    runner_sh "repo-practices gt track" \
      "cd \"${worktree_path}\" && ${gt_cli} track --parent \"${parent_branch}\""
    rp_log_warn "${slug}: created candidate branch ${branch} for ${path}"
    parent_branch="$branch"
    parent_ref="$branch"
    created_any=1
  done

  if [[ "$created_any" -eq 0 ]]; then
    return 0
  fi

  local gt_cli='gt'
  runner_sh "repo-practices gt submit" \
    "cd \"${worktree_path}\" && ${gt_cli} submit --publish --no-interactive"
  status=""
  set +e
  status="$(rp_runner_exec_stdout "repo-practices git status after submit" \
    -- git -C "$worktree_path" status --porcelain)"
  set -e
  status="${status//$'\n'/}"
  if [[ -n "$status" ]]; then
    rp_die "candidate fix worktree is dirty after submit: ${worktree_path}"
  fi
  rp_log_warn "${slug}: submitted candidate workflow fix stack from ${worktree_path}"
}

rp_apply_codeowners_pr() {
  local slug="$1"
  local login default_branch base_sha branch_name existing_sha content encoded_content pr_url
  local -a put_args=()

  login="$(rp_authenticated_github_login)"
  default_branch="$(rp_runner_gh_api_stream "repo-practices codeowners default branch" "repos/${slug}" --jq '.default_branch // "main"')"
  base_sha="$(rp_runner_gh_api_stream "repo-practices codeowners base sha" "repos/${slug}/git/ref/heads/${default_branch}" --jq '.object.sha')"
  branch_name='repo-practices/add-codeowners'

  local pr_list_exit_code=0
  set +e
  pr_url="$(rp_runner_exec_stdout "repo-practices gh pr list codeowners" \
    -- gh pr list --repo "$slug" --head "$branch_name" --state open --json url \
      --jq '.[0].url // empty')"
  pr_list_exit_code=$?
  set -e
  pr_url="${pr_url//$'\n'/}"
  if (( pr_list_exit_code != 0 )); then
    pr_url=""
  fi
  if [[ -n "$pr_url" ]]; then
    rp_log_warn "${slug}: CODEOWNERS remediation PR already exists: ${pr_url}"
    return 0
  fi

  local ref_exit_code=0
  runner_exec "repo-practices gh ref heads codeowners branch" \
    -- gh api "repos/${slug}/git/ref/heads/${branch_name}" || ref_exit_code=$?
  if (( ref_exit_code != 0 )); then
    runner_exec "repo-practices gh create codeowners ref" \
      -- gh api -X POST "repos/${slug}/git/refs" \
        -f "ref=refs/heads/${branch_name}" \
        -f "sha=${base_sha}"
  fi

  content="# Repository ownership"$'\n'"* @${login}"$'\n'
  encoded_content="$(printf '%s' "$content" | base64 | tr -d '\n')"
  local existing_exit_code=0
  set +e
  existing_sha="$(rp_runner_exec_stdout "repo-practices gh codeowners sha" \
    -- gh api "repos/${slug}/contents/.github/CODEOWNERS?ref=${branch_name}" \
      --jq '.sha')"
  existing_exit_code=$?
  set -e
  existing_sha="${existing_sha//$'\n'/}"
  if (( existing_exit_code != 0 )); then
    existing_sha=""
  fi

  put_args=(
    -X PUT
    "repos/${slug}/contents/.github/CODEOWNERS"
    -f "message=chore: add CODEOWNERS"
    -f "content=${encoded_content}"
    -f "branch=${branch_name}"
  )
  if [[ -n "$existing_sha" ]]; then
    put_args+=(-f "sha=${existing_sha}")
  fi
  runner_exec "repo-practices gh put codeowners" -- gh api "${put_args[@]}"

  pr_url="$(rp_runner_exec_stdout "repo-practices gh pr create codeowners" \
    -- gh pr create \
      --repo "$slug" \
      --head "$branch_name" \
      --base "$default_branch" \
      --title "chore: add CODEOWNERS" \
      --body "$(cat <<EOF
## Summary
- Add CODEOWNERS with ${login} as the owner of all files.

## Test plan
- Repository-practices remediation only.
EOF
)")"
  pr_url="${pr_url//$'\n'/}"
  rp_log_warn "${slug}: created CODEOWNERS remediation PR: ${pr_url}"
}

rp_repo_has_release_please() {
  local slug="$1"
  rp_gh_path_exists "$slug" '.github/workflows/release-please.yml'
}

# rp_repo_merge_it_label_check <slug>
# Returns 0 when merge-it exists, 1 when labels were read but merge-it is absent,
# 2 when GitHub API could not list labels (do not treat as missing merge-it).
rp_repo_merge_it_label_check() {
  local slug="$1"
  local labels_json fetch_exit jq_exit

  fetch_exit=0
  labels_json="$(rp_fetch_repo_labels_json "$slug")" || fetch_exit=$?
  if (( fetch_exit == 2 )); then
    return 2
  fi
  if (( fetch_exit != 0 )) || [[ -z "$labels_json" ]]; then
    return 2
  fi
  jq_exit=0
  rp_runner_jq_file "repo-practices merge-it label" "$labels_json" \
    -e 'index("merge-it") != null' >/dev/null || jq_exit=$?
  if (( jq_exit == 0 )); then
    return 0
  fi
  return 1
}

rp_repo_has_merge_it_label() {
  local slug="$1"
  local check_exit=0

  rp_repo_merge_it_label_check "$slug" || check_exit=$?
  (( check_exit == 0 ))
}

rp_repo_should_audit_default() {
  local slug="$1"
  if rp_repo_has_release_please "$slug"; then
    return 0
  fi
  if rp_repo_has_merge_it_label "$slug"; then
    return 0
  fi
  return 1
}

rp_discover_org_repos() {
  local owner="$1"
  local jq_expr='.[].name'
  if [[ "$rp_include_private" -eq 0 ]]; then
    jq_expr='.[] | select(.private == false) | .name'
  fi
  rp_runner_gh_api_stream "repo-practices org repos" "orgs/${owner}/repos" --paginate --jq "$jq_expr"
}

rp_discover_audit_repos() {
  local owner="$1"
  local name slug
  if [[ "$rp_audit_all" -eq 1 ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf '%s\n' "${owner}/${name}"
    done < <(rp_discover_org_repos "$owner")
    return 0
  fi
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    slug="${owner}/${name}"
    if rp_repo_should_audit_default "$slug"; then
      printf '%s\n' "$slug"
    fi
  done < <(rp_discover_org_repos "$owner")
}

rp_fetch_repo_settings() {
  local slug="$1"
  rp_runner_gh_api_stream "repo-practices repo settings" "repos/${slug}" \
    --jq '{
      allow_merge_commit,
      allow_rebase_merge,
      allow_squash_merge,
      squash_merge_commit_message,
      squash_merge_commit_title
    }'
}

# rp_fetch_protect_main_ruleset <slug>
# Prints ruleset JSON on stdout. Returns 0 on success, 1 when protect-main is absent,
# 2 when GitHub API failed (do not treat as missing ruleset).
rp_fetch_protect_main_ruleset() {
  local slug="$1"
  local owner name ruleset_id
  owner="${slug%%/*}"
  name="${slug#*/}"
  local ruleset_id_raw ruleset_exit_code=0
  local ruleset_json ruleset_json_exit=0
  set +e
  ruleset_id_raw="$(rp_runner_gh_api_stream "repo-practices protect-main ruleset id" --probe \
    "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id')"
  ruleset_exit_code=$?
  set -e
  if (( ruleset_exit_code != 0 )); then
    return 2
  fi
  ruleset_id="${ruleset_id_raw//$'\n'/}"
  ruleset_id="$(printf '%s' "$ruleset_id" | head -n1)"
  if [[ -z "$ruleset_id" ]]; then
    return 1
  fi
  set +e
  ruleset_json="$(rp_runner_gh_api_stream "repo-practices protect-main ruleset json" --probe \
    "repos/${owner}/${name}/rulesets/${ruleset_id}")"
  ruleset_json_exit=$?
  set -e
  if (( ruleset_json_exit != 0 )); then
    return 2
  fi
  printf '%s' "$ruleset_json"
  return 0
}

rp_fetch_protect_main_merge_methods() {
  local ruleset_json="$1"
  rp_runner_jq_file "repo-practices protect-main merge methods" "$ruleset_json" \
    '[.rules[] | select(.type == "pull_request") | .parameters.allowed_merge_methods // []] | add // []' 
}

# rp_fetch_repo_labels_json <slug>
# Prints a JSON array of label names. Returns 0 on success, 2 on GitHub API failure.
rp_fetch_repo_labels_json() {
  local slug="$1"
  local exit_code=0

  set +e
  rp_runner_exec_stdout "repo-practices repo labels" \
    -- gh api "repos/${slug}/labels" --paginate --jq '[.[].name]'
  exit_code=$?
  set -e
  if (( exit_code != 0 )); then
    return 2
  fi
  return 0
}

rp_repo_requires_protect_main_ruleset() {
  local slug="$1"
  if [[ "$rp_merge_only" -eq 0 ]] && rp_is_strict_repo "$slug"; then
    return 0
  fi
  if rp_repo_has_release_please "$slug"; then
    return 0
  fi
  if rp_repo_has_merge_it_label "$slug"; then
    return 0
  fi
  return 1
}

