rp_ci_workflow_has_feature_branch_push_trigger() {
  local text="$1"
  awk '
    BEGIN {
      in_on = 0
      in_push = 0
      push_indent = -1
      in_branches_ignore = 0
      branches_ignore_indent = -1
      has_main_ignore = 0
      has_graphite_ignore = 0
    }
    /^on:[[:space:]]*$/ { in_on = 1; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_push = 0; in_branches_ignore = 0 }
    in_on && /^[[:space:]]*push:[[:space:]]*$/ {
      in_push = 1
      push_indent = match($0, /[^ ]/) - 1
      next
    }
    in_push {
      cur = match($0, /[^ ]/) - 1
      if (cur <= push_indent) {
        in_push = 0
        in_branches_ignore = 0
        next
      }
      if ($0 ~ /^[[:space:]]*branches:[[:space:]]*\[[[:space:]]*main/) {
        exit 1
      }
      if ($0 ~ /^[[:space:]]*branches-ignore:[[:space:]]*$/) {
        in_branches_ignore = 1
        branches_ignore_indent = cur
        next
      }
      if (in_branches_ignore) {
        if (cur <= branches_ignore_indent) {
          in_branches_ignore = 0
          next
        }
        if ($0 ~ /main/) { has_main_ignore = 1 }
        if ($0 ~ /graphite-base/) { has_graphite_ignore = 1 }
      }
    }
    END { exit((has_main_ignore && has_graphite_ignore) ? 0 : 1) }
  ' <<<"$text"
}

