      protection_json="$(rp_fetch_classic_main_protection_json "$slug")"
      fetch_exit=$?
      set -e
      if (( fetch_exit == 2 )); then
        rp_log_gh_api_fail "$slug" 'could not read classic main branch protection after --apply-fix'
        return 1
      fi
    else
      return 1
    fi
  elif [[ "$rp_apply_fix" -eq 1 ]]; then
    if ! rp_validate_classic_main_protection_json "$slug" "$protection_json"; then
      rp_apply_classic_main_protection "$slug"
      set +e
      protection_json="$(rp_fetch_classic_main_protection_json "$slug")"
      fetch_exit=$?
