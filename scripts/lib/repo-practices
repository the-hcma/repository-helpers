rp_check_protect_main_ruleset() {
  local slug="$1"
  local repo_fail=0
  local ruleset_json methods_json
  local fetch_exit=0
  local require_exit=0

  rp_repo_requires_protect_main_ruleset "$slug" || require_exit=$?
  if (( require_exit == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not determine whether protect-main is required'
    rp_log_check_fail "$slug" 'protect-main ruleset (GitHub API error; retry)' \
      "$(rp_github_url "$slug" '/settings/rules')"
    return 1
  fi
  if (( require_exit != 0 )); then
    return 0
  fi

  set +e
  ruleset_json="$(rp_fetch_protect_main_ruleset "$slug")"
  fetch_exit=$?
  set -e
  if (( fetch_exit == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset'
    rp_log_check_fail "$slug" 'protect-main ruleset (GitHub API error; retry)' \
      "$(rp_github_url "$slug" '/settings/rules')"
    return 1
  fi
  if [[ -n "$ruleset_json" ]]; then
    methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
  else
    methods_json='[]'
  fi

  if [[ "$rp_apply_fix" -eq 1 ]]; then
    if [[ -z "$ruleset_json" ]]; then
      rp_apply_protect_main_create "$slug"
      set +e
      ruleset_json="$(rp_fetch_protect_main_ruleset "$slug")"
      fetch_exit=$?
      set -e
      if (( fetch_exit == 2 )); then
        rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset after --apply-fix'
        return 1
      fi
      if [[ -n "$ruleset_json" ]]; then
        methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
      fi
    elif ! rp_validate_ruleset_methods_json "$slug" "$methods_json"; then
      rp_apply_protect_main_squash_methods "$slug"
      set +e
      ruleset_json="$(rp_fetch_protect_main_ruleset "$slug")"
      fetch_exit=$?
      set -e
      if (( fetch_exit == 2 )); then
        rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset after patch'
        return 1
      fi
      if [[ -n "$ruleset_json" ]]; then
        methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
      fi
    fi
    if [[ -n "$ruleset_json" ]] && ! rp_github_mq_ruleset_org_compliant "$ruleset_json"; then
      rp_apply_protect_main_github_mq_shape "$slug"
      set +e
      ruleset_json="$(rp_fetch_protect_main_ruleset "$slug")"
      fetch_exit=$?
      set -e
      if (( fetch_exit == 2 )); then
        rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset after GitHub MQ patch'
        return 1
      fi
      if [[ -n "$ruleset_json" ]]; then
        methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
      fi
    fi
  fi

  if ! rp_validate_ruleset_methods_json "$slug" "$methods_json"; then
    repo_fail=1
  fi
  if ! rp_validate_github_merge_queue_ruleset "$slug" "$ruleset_json"; then
    repo_fail=1
  fi
  if ! rp_validate_graphite_bypass_json "$slug" "$ruleset_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'protect-main ruleset (squash-only + GitHub merge queue)' \
      "$(rp_github_url "$slug" '/settings/rules')"
  else
    rp_log_check_fail "$slug" 'protect-main ruleset (see AGENTS.md; fix with --apply-fix)' \
      "$(rp_github_url "$slug" '/settings/rules')"
  fi

  return "$repo_fail"
}

