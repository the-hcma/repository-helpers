          "$(rp_candidate_cleanup_merged_branches_workflow)" \
          'add-cleanup-merged-branches' \
          'chore: add merged branch cleanup workflow'
      fi
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add cleanup-merged-branches.yml (daily sweep of merged/stale branches)"
      fi
      fail=1
    fi
  else
    fetch_ec=0
    sweep_text="$(rp_fetch_github_text_file "$slug" \
      '.github/workflows/cleanup-merged-branches.yml')" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" 'could not read .github/workflows/cleanup-merged-branches.yml'
      fail=1
    elif [[ -z "$sweep_text" ]] || ! grep -qF 'schedule:' <<<"$sweep_text"; then
      rp_log_fail "${slug}: cleanup-merged-branches.yml should include a schedule trigger"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/cleanup-merged-branches.yml' \
          "$(rp_candidate_cleanup_merged_branches_workflow)" \
          'add-cleanup-merged-branches' \
          'chore: update merged branch cleanup workflow'
      fi
      fail=1
    elif rp_repo_has_merge_it_label "$slug" \
      && ! rp_cleanup_merged_branches_workflow_is_canonical "$sweep_text"; then
      rp_log_fail "${slug}: cleanup-merged-branches.yml must match canonical template"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/cleanup-merged-branches.yml' \
          "$(rp_candidate_cleanup_merged_branches_workflow)" \
          'sync-cleanup-merged-branches' \
          'chore: sync cleanup-merged-branches workflow'
      fi
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: sync cleanup-merged-branches.yml (scripts/github-repo-lint --apply-fix)"
      fi
      fail=1
    fi
  fi

  return "$fail"
}

rp_validate_workflow_file_extensions() {
  local slug="$1"
  local fail=0
  local workflow yml_workflow

  while IFS= read -r workflow; do
    [[ -n "$workflow" ]] || continue
    if [[ "$workflow" != *.yaml ]]; then
      continue
    fi
    yml_workflow="${workflow%.yaml}.yml"
    rp_log_fail "${slug}: workflow ${workflow} must use the standard .yml extension"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: rename .github/workflows/${workflow} to .github/workflows/${yml_workflow}"
    fi
    fail=1
  done < <(rp_fetch_workflow_file_names "$slug")

  return "$fail"
}

