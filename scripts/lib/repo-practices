# True when AGENTS.md already documents commit-identity / no-co-author policy
# (soft suggest only — absence does not fail the audit).
rp_agents_md_mentions_git_commit_identity() {
  local -r text="$1"

  grep -qiE \
    'git commit identity|Co-authored-by|Made-with:[[:space:]]*Cursor|attributeCommitsToAgent|cli-config\.json' \
    <<<"$text"
}

# True when the cursor rule forbids agent/machine co-authors, requires git
# user.name/user.email, commit.gpgsign / user.signingkey survey (including
# pinentry-mac / passphrase / per-machine key / clearsign probe guidance), and
# instructs agents to verify ~/.cursor/cli-config.json with attribution disabled.
# Keyword presence alone is not enough: require positive prohibitions / false
# attribution flags, signing setup survey + setup instructions, and reject
# permissive wording.
rp_git_commit_identity_is_valid() {
  local -r text="$1"
  local cli_config_needle gpg_agent_conf_needle tilde
  # Shared forbid-action verbs (keep ASCII-sorted).
  local -r forbid_verbs='add|append|attach|commit|emit|include|inject|insert|pass|provide|put|set|specify|supply|use|write'

  # Literal "~/.…" needles (not home expansion); avoid SC2088 on quoted tilde.
  tilde='~'
  cli_config_needle="${tilde}/.cursor/cli-config.json"
  gpg_agent_conf_needle="${tilde}/.gnupg/gpg-agent.conf"

  if ! grep -qE '^alwaysApply:[[:space:]]*true([[:space:]]|$)' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'Co-authored-by' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'Made-with: Cursor' <<<"$text"; then
    return 1
  fi
  if ! grep -qF -- '--trailer' <<<"$text"; then
    return 1
  fi
  # Require forbidding *action* context (not mere "do not" near the needle).
  # Allow markdown bold around "not". Reject inverted "do not worry/mind/…" phrasing.
  if grep -qiE \
    '(do[[:space:]]*(\*\*)?not(\*\*)?|don'\''t)[[:space:]]+(worry|mind|hesitate|bother)[[:space:]].{0,100}(Co-authored-by|Made-with:[[:space:]]*Cursor|--trailer|--no-gpg-sign)' \
    <<<"$text"; then
    return 1
  fi
  if ! grep -qiE \
    "(do[[:space:]]*(\\*\\*)?not(\\*\\*)?|don't|never|must[[:space:]]+not|forbid)[[:space:][:punct:]]*(${forbid_verbs})[^.[:cntrl:]]{0,100}Co-authored-by" \
    <<<"$text"; then
    return 1
  fi
  if ! grep -qiE \
    "(do[[:space:]]*(\\*\\*)?not(\\*\\*)?|don't|never|must[[:space:]]+not|forbid)[[:space:][:punct:]]*(${forbid_verbs})[^.[:cntrl:]]{0,100}Made-with:[[:space:]]*Cursor" \
    <<<"$text"; then
    return 1
  fi
  if ! grep -qiE \
    "(do[[:space:]]*(\\*\\*)?not(\\*\\*)?|don't|never|must[[:space:]]+not|forbid)[[:space:][:punct:]]*(${forbid_verbs})[^.[:cntrl:]]{0,100}--trailer" \
    <<<"$text"; then
    return 1
  fi
  if ! grep -qiE \
    "(do[[:space:]]*(\\*\\*)?not(\\*\\*)?|don't|never|must[[:space:]]+not|forbid)[[:space:][:punct:]]*(${forbid_verbs})[^.[:cntrl:]]{0,100}--no-gpg-sign" \
    <<<"$text"; then
    return 1
  fi
  # Reject permissive / inverted guidance.
  if grep -qiE \
    '(you may|you can|allowed to|permitted to|feel free to|(is|are)[[:space:]]+allowed|(is|are)[[:space:]]+permitted)[[:space:][:punct:]].{0,80}Co-authored-by|Co-authored-by.{0,40}(is|are)[[:space:]]+(allowed|permitted)' \
    <<<"$text"; then
    return 1
  fi
  if grep -qiE \
    '(you may|you can|allowed to|permitted to|feel free to|(is|are)[[:space:]]+allowed|(is|are)[[:space:]]+permitted)[[:space:][:punct:]].{0,80}(Made-with:[[:space:]]*Cursor|--trailer|--no-gpg-sign)|(Made-with:[[:space:]]*Cursor|--trailer|--no-gpg-sign).{0,40}(is|are)[[:space:]]+(allowed|permitted)' \
    <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'user.name' <<<"$text" || ! grep -qF 'user.email' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'commit.gpgsign' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'user.signingkey' <<<"$text"; then
    return 1
  fi
  # GPG first-time setup (repository-helpers#505): pinentry, passphrase, per-machine
  # keys, and a clearsign probe so agent sessions do not hit "No pinentry" blindly.
  if ! grep -qF 'pinentry-mac' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'pinentry-program' <<<"$text"; then
    return 1
  fi
  if ! grep -qF "$gpg_agent_conf_needle" <<<"$text"; then
    return 1
  fi
  if ! grep -qF -- '--clearsign' <<<"$text"; then
    return 1
  fi
  if ! grep -qiE 'passphrase' <<<"$text"; then
    return 1
  fi
  if ! grep -qiE \
    'separate[[:space:]]+signing[[:space:]]+key[[:space:]]+per[[:space:]]+machine|per-machine' \
    <<<"$text"; then
    return 1
  fi
  # Review-driven hardening (my-tracks#1286 / rusty-jack#206): effective identity,
  # post-commit message check, verify-commit, openpgp format, ssh-agent, read:gpg_key.
  if ! grep -qF 'GIT_AUTHOR_IDENT' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'GIT_COMMITTER_IDENT' <<<"$text"; then
    return 1
  fi
  if ! grep -qF -- '--no-gpg-sign' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'verify-commit' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'openpgp' <<<"$text"; then
    return 1
  fi
  # Capital OpenPGP marks the format-specific Verified guidance split (SSH vs GPG).
  if ! rp_text_probe_grep_f 'repo-practices git identity OpenPGP' 'OpenPGP' "$text"; then
    return 1
  fi
  if ! grep -qF 'ssh-add' <<<"$text"; then
    return 1
  fi
  if ! grep -qF 'read:gpg_key' <<<"$text"; then
    return 1
  fi
  if ! grep -qF "$cli_config_needle" <<<"$text"; then
    return 1
  fi
  if ! grep -qiE 'attributeCommitsToAgent"?[[:space:]]*:[[:space:]]*false' <<<"$text"; then
    return 1
  fi
  if ! grep -qiE 'attributePRsToAgent"?[[:space:]]*:[[:space:]]*false' <<<"$text"; then
    return 1
  fi
  # Reject enabled attribution in config or natural-language forms.
  if grep -qiE 'attributeCommitsToAgent"?[[:space:]]*:[[:space:]]*true' <<<"$text" \
    || grep -qiE 'attributePRsToAgent"?[[:space:]]*:[[:space:]]*true' <<<"$text"; then
    return 1
  fi
  if grep -qiE \
    '(set|enable|turn[[:space:]]+on).{0,60}attribute(Commits|PRs)ToAgent.{0,40}(true|enabled)|attribute(Commits|PRs)ToAgent.{0,40}(to[[:space:]]+)?(true|enabled)' \
    <<<"$text"; then
    return 1
  fi
  if ! grep -qiE 'alert|warn|stop|ask|tell|remind' <<<"$text"; then
    return 1
  fi
  # Both Cursor attribution and commit-signing gaps must surface setup instructions.
  if ! grep -qiE 'instruction|setup instruction|how to (set|fix|configure)' <<<"$text"; then
    return 1
  fi
  return 0
}

rp_check_git_commit_identity() {
  local slug="$1"
  local repo_fail=0
  local rule_text agents_text repo_dir local_path
  local fetch_ec=0
  local agents_ec=0

  # Prefer the local dogfood copy when auditing this repo from a clone/worktree
  # (new-rule PRs are not on origin/main yet; GitHub Contents would false-fail).
  if [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]]; then
    repo_dir="$(rp_resolve_local_repo_dir "$slug" || true)"
    if [[ -n "$repo_dir" ]]; then
      local_path="${repo_dir}/${rp_git_commit_identity_path}"
      if [[ -f "$local_path" ]]; then
        rule_text="$(rp_runner_exec_stdout "repo-practices cat local git-commit-identity check" -- \
          cat "$local_path")"
      fi
    fi
  fi
  if [[ -z "${rule_text:-}" ]]; then
    rule_text="$(rp_fetch_github_text_file "$slug" "$rp_git_commit_identity_path")" \
      || fetch_ec=$?
  fi
  if (( fetch_ec == 2 )); then
    rp_log_gh_api_fail "$slug" "could not read ${rp_git_commit_identity_path}"
    return 1
  fi
  if [[ -z "$rule_text" ]]; then
    repo_fail=1
    rp_log_check_fail "$slug" \
      'git-commit-identity cursor rule (.cursor/rules/git-commit-identity.mdc)' \
      "$(rp_github_url "$slug" '/new/main/.cursor/rules/git-commit-identity.mdc')"
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      rp_queue_candidate_file_fix "$slug" "$rp_git_commit_identity_path" \
        "$(rp_git_commit_identity_content_for_apply_fix "$slug")" \
        'add-git-commit-identity' \
        'chore: add git-commit-identity cursor rule'
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add .cursor/rules/git-commit-identity.mdc (template: scripts/lib/repo-practices-cursor/)"
    fi
  elif ! rp_git_commit_identity_is_valid "$rule_text"; then
    repo_fail=1
    rp_log_check_fail "$slug" \
      'git-commit-identity rule must forbid Co-authored-by / Made-with: Cursor / --trailer / --no-gpg-sign, require git user.name/user.email + GIT_AUTHOR_IDENT/GIT_COMMITTER_IDENT + commit.gpgsign/user.signingkey survey (pinentry-mac, passphrase, per-machine keys, clearsign, openpgp, verify-commit, read:gpg_key) with setup instructions, and require checking ~/.cursor/cli-config.json attribution (alwaysApply: true)' \
      "$(rp_github_url "$slug" "/blob/main/${rp_git_commit_identity_path}")"
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      rp_queue_candidate_file_fix "$slug" "$rp_git_commit_identity_path" \
        "$(rp_git_commit_identity_content_for_apply_fix "$slug")" \
        'sync-git-commit-identity' \
        'chore: sync git-commit-identity cursor rule'
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: sync .cursor/rules/git-commit-identity.mdc to forbid agent/machine co-authors and require signing (pinentry/passphrase/per-machine) + cli-config attribution checks"
    fi
  else
    rp_log_check_ok "$slug" 'git-commit-identity cursor rule' \
      "$(rp_github_url "$slug" "/blob/main/${rp_git_commit_identity_path}")"
  fi

  # Soft suggest only: document policy in AGENTS.md when present (never fail).
  if [[ "$rp_suggest" -eq 1 ]]; then
    agents_text=""
    if [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]]; then
      repo_dir="$(rp_resolve_local_repo_dir "$slug" || true)"
      if [[ -n "$repo_dir" && -f "${repo_dir}/${rp_agents_md_path}" ]]; then
        agents_text="$(rp_runner_exec_stdout "repo-practices cat local AGENTS.md" -- \
          cat "${repo_dir}/${rp_agents_md_path}")"
      fi
    fi
    if [[ -z "$agents_text" ]]; then
      agents_text="$(rp_fetch_github_text_file "$slug" "$rp_agents_md_path")" || agents_ec=$?
    fi
    if (( agents_ec != 2 )) && [[ -n "$agents_text" ]] \
      && ! rp_agents_md_mentions_git_commit_identity "$agents_text"; then
      rp_log_suggest \
        "${slug}: optionally document commit-identity policy in AGENTS.md (no Co-authored-by / signing + cli-config attribution)"
    fi
  fi

