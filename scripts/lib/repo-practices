# shellcheck shell=bash
# repo-practices — shared checks for org repository GitHub conventions.
#
# Sourced by scripts/github-repo-lint and scripts/check-merge-settings.
# Do not execute directly.

rp_DEFAULT_ORG='the-hcma'
rp_GRAPHITE_APP_ACTOR_ID=158384
rp_GRAPHITE_APP_SLUG='graphite-app'
rp_DEPENDABOT_APP_SLUG='dependabot'
rp_ORG_OWNER_BYPASS_USER='thehcma'
rp_THIS_REPO_NAME='repository-helpers'

rp_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly rp_lib_dir

# shellcheck source=scripts/lib/release-age-defaults
source "${rp_lib_dir}/release-age-defaults"

# shellcheck source=scripts/lib/ci-secret-scan-policy
source "${rp_lib_dir}/ci-secret-scan-policy"

rp_org="$rp_DEFAULT_ORG"
rp_apply_fix=0
rp_suggest=0
rp_new_repo=0
rp_audit_all=0
rp_merge_only=0
rp_strict_onboarding=0
rp_compact=0
rp_single_repo=0
rp_warn_count=0
rp_current_slug=""
declare -a rp_repo_slugs=()
declare -a rp_compact_passed_repos=()
declare -a rp_compact_failed_repos=()
declare -A rp_compact_entries=()
declare -a rp_candidate_fix_keys=()
declare -A rp_candidate_fix_seen=()
declare -A rp_candidate_fix_paths=()
declare -A rp_candidate_fix_contents=()
declare -A rp_candidate_fix_branch_suffixes=()
declare -A rp_candidate_fix_messages=()

rp_usage() {
  local -r prog="${1:-check-repo-practices}"
  cat >&2 <<USAGE
Usage:
  scripts/${prog} [--org ORG] [--repo OWNER/NAME ...]
  scripts/${prog} --new-repo --repo OWNER/NAME
  scripts/${prog} --strict-onboarding --repo OWNER/NAME ...
  scripts/${prog} --all [--org ORG]
  scripts/${prog} --suggest [--repo OWNER/NAME ...]
  scripts/${prog} --apply-fix [--repo ...]      # settings fixes + candidate workflow PRs

Audits GitHub conventions for org repositories:

  protect-main ruleset (when merge-it or release-please.yml exists):
    - squash-only allowed_merge_methods on main
    - Graphite App bypass (Integration actor_id 158384)

  Classic branch protection on main (same repos; org standard):
    - CODEOWNERS reviews, dismiss stale, Graphite + Dependabot bypass, owner bypass
    - push restricted to Graphite App; required CI contexts from ci.yml; strict checks

  Branch hygiene (strict repos):
    - cleanup-branch-on-merge.yml (delete head branch when PR merges)
    - cleanup-merged-branches.yml (daily sweep + workflow_dispatch)

  Graphite merge queue (when merge-it label exists):
    - enqueue labels, merged-pr-closer, ci gtmq skip, dependabot auto-merge

  Repository metadata:
    - top-level license file
    - copyright notice
    - CODEOWNERS with a repository-wide owner rule

  Release Please (when release-please.yml exists):
    - squash-only repo settings; squash_merge_commit_message=BLANK

--new-repo: audit a single repo with SUGGEST hints and a setup checklist (requires --repo).
--strict-onboarding: require full org onboarding, including merge-it, for audited repos.
--all: audit every repository in the org (not only merge-it / release-please).
With no --repo: audit the current git repository when run inside a clone (origin on GitHub);
otherwise discover org repos with release-please.yml or merge-it.
--suggest: print SUGGEST lines with remediation hints (non-zero exit still on FAIL).
--compact: print one passed-repos line plus grouped failures and fixes (implies --suggest).

Requires: gh (authenticated), jq.
USAGE
}

rp_die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

rp_color_enabled() {
  [[ -t 2 ]] && [[ -z "${NO_COLOR:-}" ]]
}

rp_color() {
  local code="$1"
  shift
  if rp_color_enabled; then
    printf '\033[%sm%s\033[0m' "$code" "$*"
  else
    printf '%s' "$*"
  fi
}

rp_compact_append_entry() {
  local slug="$1"
  local line="$2"
  local existing

  [[ -n "$slug" && -n "$line" ]] || return 0
  existing="${rp_compact_entries[$slug]:-}"
  if [[ -n "$existing" ]] && grep -qxF -- "$line" <<<"$existing"; then
    return 0
  fi
  if [[ -n "$existing" ]]; then
    rp_compact_entries[$slug]+=$'\n'"$line"
  else
    rp_compact_entries[$slug]="$line"
  fi
}

rp_compact_strip_slug() {
  local slug="$1"
  local message="$2"
  local prefix

  prefix="${slug}: "
  if [[ "$message" == "${prefix}"* ]]; then
    printf '%s' "${message:${#prefix}}"
  else
    printf '%s' "$message"
  fi
}

rp_compact_record_failure() {
  local slug="$1"
  local message="$2"
  local stripped

  stripped="$(rp_compact_strip_slug "$slug" "$message")"
  rp_compact_append_entry "$slug" "- ${stripped}"
}

rp_compact_record_fix() {
  local slug="$1"
  local message="$2"
  local stripped

  stripped="$(rp_compact_strip_slug "$slug" "$message")"
  rp_compact_append_entry "$slug" "  Fix: ${stripped}"
}

rp_compact_print_joined_repos() {
  local label="$1"
  shift
  local first=1
  local slug

  printf '%s' "$label" >&2
  if [[ "$#" -eq 0 ]]; then
    printf ' none\n' >&2
    return 0
  fi
  for slug in "$@"; do
    if [[ "$first" -eq 1 ]]; then
      printf ' ' >&2
      first=0
    else
      printf ', ' >&2
    fi
    printf '%s' "$slug" >&2
  done
  printf '\n' >&2
}

rp_compact_print_report() {
  local slug
  local block
  local line

  rp_compact_print_joined_repos 'Passed:' "${rp_compact_passed_repos[@]}"
  if [[ "${#rp_compact_failed_repos[@]}" -eq 0 ]]; then
    return 0
  fi

  printf 'Failed:\n' >&2
  for slug in "${rp_compact_failed_repos[@]}"; do
    printf '%s:\n' "$slug" >&2
    block="${rp_compact_entries[$slug]:-}"
    if [[ -z "$block" ]]; then
      printf '  - failed practices check\n' >&2
      continue
    fi
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      printf '  %s\n' "$line" >&2
    done <<<"$block"
  done
}

rp_log_ok() {
  if [[ "$rp_compact" -eq 1 ]]; then
    return 0
  fi
  printf 'OK: %s\n' "$*" >&2
}

rp_log_warn() {
  rp_warn_count=$(( rp_warn_count + 1 ))
  printf 'WARN: %s\n' "$*" >&2
}

rp_log_fail() {
  if [[ "$rp_compact" -eq 1 && -n "$rp_current_slug" ]]; then
    rp_compact_record_failure "$rp_current_slug" "$*"
    return 0
  fi
  printf 'FAIL: %s\n' "$*" >&2
}

rp_check_line_prefix() {
  local slug="$1"
  if [[ "$rp_single_repo" -eq 1 ]]; then
    return 0
  fi
  printf '%s: ' "$slug"
}

rp_github_url() {
  local slug="$1"
  local path="${2:-}"
  printf 'https://github.com/%s%s' "$slug" "$path"
}

rp_log_check_ok() {
  local slug="$1"
  local message="$2"
  local url="${3:-}"
  if [[ "$rp_compact" -eq 1 ]]; then
    return 0
  fi
  printf 'OK: ' >&2
  rp_check_line_prefix "$slug" >&2
  printf '%s\n' "$message" >&2
  if [[ -n "$url" ]]; then
    printf '     %s\n' "$url" >&2
  fi
}

rp_log_check_fail() {
  local slug="$1"
  local message="$2"
  local url="${3:-}"
  if [[ "$rp_compact" -eq 1 ]]; then
    return 0
  fi
  printf 'FAIL: ' >&2
  rp_check_line_prefix "$slug" >&2
  printf '%s\n' "$message" >&2
  if [[ -n "$url" ]]; then
    printf '     %s\n' "$url" >&2
  fi
}

# Manual steps the script cannot verify (yellow + 👉 when stderr is a TTY).
rp_log_manual_step() {
  local message="$1"
  local url="${2:-}"
  if [[ "$rp_compact" -eq 1 && -n "$rp_current_slug" ]]; then
    rp_compact_record_fix "$rp_current_slug" "$message"
    return 0
  fi
  printf '     ' >&2
  if rp_color_enabled; then
    rp_color 33 "👉 ${message}" >&2
  else
    printf '👉 %s' "$message" >&2
  fi
  printf '\n' >&2
  if [[ -n "$url" ]]; then
    printf '        %s\n' "$url" >&2
  fi
}

rp_print_final_status() {
  local status="$1"
  local detail="${2:-}"
  local line
  case "$status" in
    passed)
      if [[ -n "$detail" ]]; then
        line="$detail"
      else
        line='passed'
      fi
      rp_color 32 "$line" >&2
      printf '\n' >&2
      ;;
    passed_with_warnings)
      if [[ -n "$detail" ]]; then
        line="$detail (warnings reported above)"
      else
        line='passed with warnings'
      fi
      rp_color 33 "$line" >&2
      printf '\n' >&2
      ;;
    failed)
      if [[ -n "$detail" ]]; then
        line="$detail"
      else
        line='failed'
      fi
      rp_color 31 "$line" >&2
      printf '\n' >&2
      ;;
    *)
      rp_die "internal error: unknown final status: ${status}"
      ;;
  esac
}

rp_log_suggest() {
  if [[ "$rp_compact" -eq 1 && -n "$rp_current_slug" ]]; then
    rp_compact_record_fix "$rp_current_slug" "$*"
    return 0
  fi
  printf 'SUGGEST: %s\n' "$*" >&2
}

rp_require_tools() {
  command -v gh >/dev/null 2>&1 || rp_die "'gh' not found (https://cli.github.com)"
  command -v jq >/dev/null 2>&1 || rp_die "'jq' not found"
  gh auth status >/dev/null 2>&1 || rp_die "'gh' is not authenticated (run: gh auth login)"
}

rp_repo_short_name() {
  printf '%s' "${1#*/}"
}

# When run inside a git clone, resolve OWNER/NAME from origin (GitHub only).
rp_resolve_git_context_slug() {
  local repo_root remote_url slug
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$repo_root" ]]; then
    return 1
  fi
  remote_url="$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote_url" ]]; then
    return 1
  fi
  slug="$(printf '%s' "$remote_url" \
    | sed -E 's#^git@github.com:##; s#^ssh://git@github.com/##; s#^https://github.com/##; s#\.git$##')"
  if [[ "$slug" == */* ]]; then
    printf '%s\n' "$slug"
    return 0
  fi
  return 1
}

rp_is_strict_repo() {
  [[ "$(rp_repo_short_name "$1")" != "$rp_THIS_REPO_NAME" ]] || [[ "$rp_new_repo" -eq 1 ]]
}

rp_gh_path_exists() {
  local slug="$1"
  local path="$2"
  gh api "repos/${slug}/contents/${path}" >/dev/null 2>&1
}

rp_fetch_github_text_file() {
  local slug="$1"
  local path="$2"
  local response encoded
  response="$(gh api "repos/${slug}/contents/${path}" 2>/dev/null || true)"
  if [[ -z "$response" ]]; then
    return 1
  fi
  encoded="$(jq -r '.content // empty' <<<"$response")"
  if [[ -z "$encoded" || "$encoded" == 'null' ]]; then
    return 1
  fi
  printf '%s' "$encoded" | base64 -d 2>/dev/null || return 1
}

rp_text_has_copyright_notice() {
  local -r text="$1"
  grep -Eiq 'copyright[[:space:]]*(\([cC]\))?[[:space:]]*[0-9]{4}' <<<"$text"
}

rp_fetch_repo_license_file() {
  local slug="$1"
  local license_path text
  local -a license_paths=(
    LICENSE
    LICENSE.md
    LICENSE.txt
    COPYING
    COPYING.md
    COPYING.txt
  )

  for license_path in "${license_paths[@]}"; do
    text="$(rp_fetch_github_text_file "$slug" "$license_path" || true)"
    [[ -n "$text" ]] || continue
    printf '%s\n%s' "$license_path" "$text"
    return 0
  done
  return 1
}

rp_find_repo_copyright_notice_path() {
  local slug="$1"
  local license_path="$2"
  local license_text="$3"
  local notice_path text
  local -a notice_paths=(
    "$license_path"
    NOTICE
    NOTICE.md
    COPYRIGHT
    COPYRIGHT.md
    README.md
    README
  )

  if [[ -n "$license_text" ]] && rp_text_has_copyright_notice "$license_text"; then
    printf '%s\n' "$license_path"
    return 0
  fi

  for notice_path in "${notice_paths[@]}"; do
    [[ -n "$notice_path" ]] || continue
    [[ "$notice_path" != "$license_path" ]] || continue
    text="$(rp_fetch_github_text_file "$slug" "$notice_path" || true)"
    [[ -n "$text" ]] || continue
    if rp_text_has_copyright_notice "$text"; then
      printf '%s\n' "$notice_path"
      return 0
    fi
  done
  return 1
}

rp_fetch_repo_codeowners_file() {
  local slug="$1"
  local codeowners_path text
  local -a codeowners_paths=(
    .github/CODEOWNERS
    CODEOWNERS
    docs/CODEOWNERS
  )

  for codeowners_path in "${codeowners_paths[@]}"; do
    text="$(rp_fetch_github_text_file "$slug" "$codeowners_path" || true)"
    [[ -n "$text" ]] || continue
    printf '%s\n%s' "$codeowners_path" "$text"
    return 0
  done
  return 1
}

rp_codeowners_has_global_owner_rule() {
  local -r text="$1"
  grep -Eq '^[[:space:]]*\*[[:space:]]+@[-A-Za-z0-9_]+' <<<"$text"
}

rp_authenticated_github_login() {
  gh api user --jq '.login'
}

rp_candidate_workflow_template() {
  local -r filename="$1"
  local -r path="${rp_lib_dir}/repo-practices-workflows/${filename}"

  if [[ ! -f "$path" ]]; then
    rp_die "internal error: missing candidate workflow template: ${path}"
  fi
  cat "$path"
}

rp_candidate_merged_pr_closer_workflow() {
  rp_candidate_workflow_template 'merged-pr-closer.yml'
}

rp_candidate_cleanup_branch_on_merge_workflow() {
  rp_candidate_workflow_template 'cleanup-branch-on-merge.yml'
}

rp_candidate_cleanup_merged_branches_workflow() {
  rp_candidate_workflow_template 'cleanup-merged-branches.yml'
}

rp_candidate_dependabot_auto_merge_workflow() {
  rp_candidate_workflow_template 'dependabot-auto-merge.yml'
}

rp_candidate_secret_scan_script() {
  local -r path="${rp_lib_dir}/ci-secret-scan"

  if [[ ! -f "$path" ]]; then
    rp_die "internal error: missing ci-secret-scan script: ${path}"
  fi
  cat "$path"
}

rp_candidate_ci_secret_scan_job_yaml() {
  cat <<'YAML'
  secret-scan:
    name: Secret Scan
    needs: guard
    if: needs.guard.outputs.skip != 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6.0.2
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
      - name: Secret Scan
        env:
          GITLEAKS_BASE: ${{ github.event.pull_request.base.sha || '' }}
          GITLEAKS_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
        run: bash .github/ci/secret-scan
YAML
}

rp_ci_workflow_has_secret_scan_job() {
  local text="$1"
  grep -qE '^  secret-scan:' <<<"$text"
}

rp_ci_workflow_uses_canonical_secret_scan_invocation() {
  local text="$1"
  grep -qF 'bash .github/ci/secret-scan' <<<"$text" \
    && grep -qF 'GITLEAKS_BASE:' <<<"$text" \
    && grep -qF 'GITLEAKS_HEAD:' <<<"$text"
}

rp_ci_workflow_has_brittle_gitleaks_install() {
  local text="$1"
  if grep -qF 'bash .github/ci/secret-scan' <<<"$text"; then
    return 1
  fi
  grep -qE 'gitleaks_[0-9.]+_linux_' <<<"$text" \
    || grep -qF 'FALLBACK_VERSION=' <<<"$text" \
    || grep -qF 'releases/latest' <<<"$text"
}

rp_ci_secret_scan_script_is_canonical() {
  local text="$1"
  local canonical
  canonical="$(rp_candidate_secret_scan_script)"
  [[ "$text" == "$canonical" ]]
}

rp_fix_ci_workflow_secret_scan_job() {
  local text="$1"
  local block_path
  block_path="$(mktemp)"
  rp_candidate_ci_secret_scan_job_yaml >"$block_path"
  awk -v block_path="$block_path" '
    BEGIN {
      replacing = 0
      while ((getline block_line < block_path) > 0) {
        block = block block_line "\n"
      }
      close(block_path)
    }
    /^  [a-zA-Z0-9_.-]+:/ {
      if (replacing) {
        replacing = 0
      }
      if ($0 ~ /^  secret-scan:/) {
        printf "%s", block
        replacing = 1
        next
      }
    }
    replacing { next }
    { print }
  ' <<<"$text"
  rm -f "$block_path"
}

rp_ci_workflow_has_secret_scan_coverage() {
  local text="$1"
  rp_ci_workflow_has_secret_scan_job "$text" || grep -qF 'gitleaks' <<<"$text"
}

rp_add_ci_secret_scan_job_to_workflow() {
  local text="$1"

  if rp_ci_workflow_has_secret_scan_job "$text"; then
    printf '%s' "$text"
    return 0
  fi
  if [[ "$text" != *$'\n' ]]; then
    text="${text}"$'\n'
  fi
  printf '%s%s\n' "$text" "$(rp_candidate_ci_secret_scan_job_yaml)"
}

rp_queue_ci_secret_scan_candidate_fixes() {
  local slug="$1"
  local ci_text="$2"
  local mode="$3"

  rp_queue_candidate_file_fix "$slug" '.github/ci/secret-scan' \
    "$(rp_candidate_secret_scan_script)" \
    'sync-secret-scan-script' \
    'fix(ci): sync canonical secret-scan script'

  if [[ "$mode" == 'add' ]]; then
    rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
      "$(rp_add_ci_secret_scan_job_to_workflow "$ci_text")" \
      'add-secret-scan-job' \
      'feat(ci): add secret-scan job'
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: add secret-scan script and ci.yml job"
    return 0
  fi

  if rp_ci_workflow_has_secret_scan_job "$ci_text"; then
    rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
      "$(rp_fix_ci_workflow_secret_scan_job "$ci_text")" \
      'sync-secret-scan-job' \
      'fix(ci): use canonical secret-scan job'
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: sync secret-scan script and ci.yml job"
  else
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: sync secret-scan script"
  fi
}

rp_queue_candidate_file_fix() {
  local slug="$1"
  local path="$2"
  local content="$3"
  local branch_suffix="$4"
  local message="$5"
  local key

  if [[ "$path" == /* || "$path" == *'..'* ]]; then
    rp_die "internal error: unsafe candidate fix path: ${path}"
  fi

  key="${slug}|${path}"
  if [[ -n "${rp_candidate_fix_seen[$key]:-}" ]]; then
    return 0
  fi
  rp_candidate_fix_seen[$key]=1
  rp_candidate_fix_keys+=("$key")
  rp_candidate_fix_paths[$key]="$path"
  rp_candidate_fix_contents[$key]="$content"
  rp_candidate_fix_branch_suffixes[$key]="$branch_suffix"
  rp_candidate_fix_messages[$key]="$message"
}

rp_git_remote_slug_for_dir() {
  local repo_dir="$1"
  local remote_url slug

  remote_url="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote_url" ]]; then
    return 1
  fi
  slug="$(printf '%s' "$remote_url" \
    | sed -E 's#^git@github.com:##; s#^ssh://git@github.com/##; s#^https://github.com/##; s#\.git$##')"
  if [[ "$slug" == */* ]]; then
    printf '%s\n' "$slug"
    return 0
  fi
  return 1
}

rp_resolve_local_repo_dir() {
  local slug="$1"
  local repo_root repo_slug

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$repo_root" ]]; then
    return 1
  fi
  repo_slug="$(rp_git_remote_slug_for_dir "$repo_root" || true)"
  if [[ "$repo_slug" == "$slug" ]]; then
    printf '%s\n' "$repo_root"
    return 0
  fi
  return 1
}

rp_candidate_worktree_path() {
  local repo_dir="$1"
  local primary_dir

  primary_dir="$(git -C "$repo_dir" worktree list --porcelain | awk 'NR == 1 { print $2; exit }')"
  if [[ -z "$primary_dir" ]]; then
    return 1
  fi
  printf '%s\n' "${primary_dir}/.worktrees/repo-practices-candidate-fixes-wt"
}

rp_prepare_candidate_worktree() {
  local repo_dir="$1"
  local default_branch="$2"
  local worktree_path worktrees_dir status

  worktree_path="$(rp_candidate_worktree_path "$repo_dir")"
  worktrees_dir="$(dirname "$worktree_path")"
  mkdir -p "$worktrees_dir"

  if [[ -d "$worktree_path" ]]; then
    status="$(git -C "$worktree_path" status --porcelain)"
    if [[ -n "$status" ]]; then
      rp_die "candidate fix worktree has local changes: ${worktree_path}"
    fi
    printf '%s\n' "$worktree_path"
    return 0
  fi

  git -C "$repo_dir" worktree prune >&2 || true
  if git -C "$repo_dir" worktree list --porcelain | grep -qF "worktree ${worktree_path}"; then
    git -C "$repo_dir" worktree remove --force "$worktree_path" >&2 || true
  fi
  rm -rf "$worktree_path"

  git -C "$repo_dir" fetch --prune origin >&2
  git -C "$repo_dir" worktree add --detach "$worktree_path" "origin/${default_branch}" >&2
  printf '%s\n' "$worktree_path"
}

rp_apply_candidate_fix_stack() {
  local slug="$1"
  local repo_dir default_branch worktree_path key key_slug path content branch_suffix message
  local branch parent_branch parent_ref created_any has_candidate path_dir status

  if [[ "$rp_apply_fix" -ne 1 ]]; then
    return 0
  fi

  has_candidate=0
  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    if [[ "$key_slug" == "$slug" ]]; then
      has_candidate=1
      break
    fi
  done
  if [[ "$has_candidate" -eq 0 ]]; then
    return 0
  fi

  created_any=0
  if ! repo_dir="$(rp_resolve_local_repo_dir "$slug")"; then
    rp_log_warn "${slug}: candidate workflow PRs require running --apply-fix from the local clone"
    return 0
  fi

  default_branch="$(gh api "repos/${slug}" --jq '.default_branch // "main"')"
  worktree_path="$(rp_prepare_candidate_worktree "$repo_dir" "$default_branch")"
  parent_branch="$default_branch"
  parent_ref="origin/${default_branch}"

  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    [[ "$key_slug" == "$slug" ]] || continue
    path="${rp_candidate_fix_paths[$key]}"
    content="${rp_candidate_fix_contents[$key]}"
    branch_suffix="${rp_candidate_fix_branch_suffixes[$key]}"
    message="${rp_candidate_fix_messages[$key]}"
    branch="repo-practices/${branch_suffix}"

    if git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${branch}"; then
      rp_log_warn "${slug}: candidate branch already exists, skipping ${branch}"
      parent_branch="$branch"
      parent_ref="$branch"
      continue
    fi

    git -C "$worktree_path" checkout -B "$branch" "$parent_ref"
    path_dir="$(dirname "${worktree_path}/${path}")"
    mkdir -p "$path_dir"
    printf '%s\n' "$content" >"${worktree_path}/${path}"
    git -C "$worktree_path" add "$path"
    if git -C "$worktree_path" diff --cached --quiet; then
      rp_log_warn "${slug}: candidate fix has no file changes for ${path}"
      continue
    fi
    git -C "$worktree_path" commit -m "$message"
    (cd "$worktree_path" && gt track --parent "$parent_branch")
    rp_log_warn "${slug}: created candidate branch ${branch} for ${path}"
    parent_branch="$branch"
    parent_ref="$branch"
    created_any=1
  done

  if [[ "$created_any" -eq 0 ]]; then
    return 0
  fi

  (cd "$worktree_path" && gt submit --publish --no-interactive)
  status="$(git -C "$worktree_path" status --porcelain)"
  if [[ -n "$status" ]]; then
    rp_die "candidate fix worktree is dirty after submit: ${worktree_path}"
  fi
  rp_log_warn "${slug}: submitted candidate workflow fix stack from ${worktree_path}"
}

rp_apply_codeowners_pr() {
  local slug="$1"
  local login default_branch base_sha branch_name existing_sha content encoded_content pr_url
  local -a put_args=()

  login="$(rp_authenticated_github_login)"
  default_branch="$(gh api "repos/${slug}" --jq '.default_branch // "main"')"
  base_sha="$(gh api "repos/${slug}/git/ref/heads/${default_branch}" --jq '.object.sha')"
  branch_name='repo-practices/add-codeowners'

  pr_url="$(
    gh pr list --repo "$slug" --head "$branch_name" --state open --json url \
      --jq '.[0].url // empty' 2>/dev/null || true
  )"
  if [[ -n "$pr_url" ]]; then
    rp_log_warn "${slug}: CODEOWNERS remediation PR already exists: ${pr_url}"
    return 0
  fi

  if ! gh api "repos/${slug}/git/ref/heads/${branch_name}" >/dev/null 2>&1; then
    gh api -X POST "repos/${slug}/git/refs" \
      -f "ref=refs/heads/${branch_name}" \
      -f "sha=${base_sha}" >/dev/null
  fi

  content="# Repository ownership"$'\n'"* @${login}"$'\n'
  encoded_content="$(printf '%s' "$content" | base64 | tr -d '\n')"
  existing_sha="$(
    gh api "repos/${slug}/contents/.github/CODEOWNERS?ref=${branch_name}" \
      --jq '.sha' 2>/dev/null || true
  )"

  put_args=(
    -X PUT
    "repos/${slug}/contents/.github/CODEOWNERS"
    -f "message=chore: add CODEOWNERS"
    -f "content=${encoded_content}"
    -f "branch=${branch_name}"
  )
  if [[ -n "$existing_sha" ]]; then
    put_args+=(-f "sha=${existing_sha}")
  fi
  gh api "${put_args[@]}" >/dev/null

  pr_url="$(
    gh pr create \
      --repo "$slug" \
      --head "$branch_name" \
      --base "$default_branch" \
      --title "chore: add CODEOWNERS" \
      --body "$(cat <<EOF
## Summary
- Add CODEOWNERS with ${login} as the owner of all files.

## Test plan
- Repository-practices remediation only.
EOF
)" \
  )"
  rp_log_warn "${slug}: created CODEOWNERS remediation PR: ${pr_url}"
}

