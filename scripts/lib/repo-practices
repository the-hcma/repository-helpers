rp_ci_workflow_guard_skip_step_text() {
  local text="$1"
  awk '
    /^  guard:/ { in_guard = 1 }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ && $0 !~ /^  guard:/ { exit }
    in_guard && /^      - id: (check|set-skip)$/ {
      in_skip = 1
      print
      next
    }
    in_guard && in_skip && /^      - id: / { exit }
    in_guard && in_skip { print }
  ' <<<"$text"
}

rp_ci_workflow_guard_skip_run_is_broken() {
  local text="$1"
  local skip_step_text
  skip_step_text="$(rp_ci_workflow_guard_skip_step_text "$text")"
  if [[ -z "$skip_step_text" ]]; then
    return 1
  fi
  if awk '
    BEGIN { prev_exit = 0; gh_token = 0 }
    /GH_TOKEN:/ {
      gh_token++
      if (gh_token > 1) { broken = 1 }
    }
    /exit 0/ {
      if (prev_exit) { broken = 1 }
      prev_exit = 1
      next
    }
    { prev_exit = 0 }
    END { exit(broken ? 0 : 1) }
  ' <<<"$skip_step_text"; then
    return 0
  fi
  if grep -qF "GITHUB_REPOSITORY_OWNER}:\${BRANCH}" <<<"$skip_step_text"; then
    return 0
  fi
  if grep -qF 'pull_request workflow covers' <<<"$skip_step_text"; then
    return 0
  fi
  return 1
}

rp_fix_ci_workflow_guard_permissions() {
