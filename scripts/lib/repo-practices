# Validates .github/secret-audit.json after a clean TruffleHog deep scan (#509).
# Missing markers FAIL under --new-repo only (intake gate). Under --strict-onboarding
# alone they SUGGEST so org-wide audits can roll out without failing every repo
# before operators write markers. Invalid/stale markers FAIL under --new-repo or
# --strict-onboarding; routine audits SUGGEST.
rp_check_secret_audit_marker() {
  local slug="$1"
  local marker_text validation_rc repo_fail=0 fetch_rc=0

  fetch_rc=0
  marker_text="$(rp_fetch_github_text_file "$slug" "$secret_audit_marker_relpath")" || fetch_rc=$?
  if (( fetch_rc == 2 )); then
    # Strict/intake: FAIL. Routine audit: WARN only (do not record FAIL then return 0).
    if [[ "$rp_strict_onboarding" -eq 1 || "$rp_new_repo" -eq 1 ]]; then
      rp_log_gh_api_fail "$slug" "secret-audit marker fetch (${secret_audit_marker_relpath})"
      repo_fail=1
      rp_log_check_fail "$slug" \
        'secret-audit marker fetch failed (GitHub API error)' \
        "$(rp_github_url "$slug" "/blob/main/${secret_audit_marker_relpath}")"
    else
      rp_log_warn \
        "${slug}: secret-audit marker fetch failed (GitHub API error); retry later"
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: retry secret-audit marker check after GitHub API recovers"
    fi
    return "$repo_fail"
  fi
  if [[ -z "$marker_text" || "$fetch_rc" -ne 0 ]]; then
    # Intake only: do not fail org --strict-onboarding --all on missing markers (v1 roll-out).
    if [[ "$rp_new_repo" -eq 1 ]]; then
      repo_fail=1
      rp_log_check_fail "$slug" \
        "secret-audit intake marker (${secret_audit_marker_relpath})" \
        "$(rp_github_url "$slug" "/new/main/${secret_audit_marker_relpath}")"
      printf 'ERROR: SECRET_AUDIT_MARKER_MISSING %s\n' "$slug" >&2
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: run scripts/secret-audit --repo ${slug} --write-marker after a clean TruffleHog deep scan (docs/secret-audit-trufflehog.md)"
      rp_log_manual_step \
        "scripts/secret-audit --repo ${slug} --write-marker"
    fi
    return "$repo_fail"
  fi

  validation_rc=0
  secret_audit_validate_marker_json "$marker_text" || validation_rc=$?
  if (( validation_rc != 0 )); then
    if [[ "$rp_strict_onboarding" -eq 1 || "$rp_new_repo" -eq 1 ]]; then
      repo_fail=1
      rp_log_check_fail "$slug" \
        'secret-audit marker invalid or stale' \
        "$(rp_github_url "$slug" "/blob/main/${secret_audit_marker_relpath}")"
      printf 'ERROR: SECRET_AUDIT_MARKER_INVALID %s\n' "$slug" >&2
    fi
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: re-run scripts/secret-audit --repo ${slug} --write-marker (marker invalid or stale)"
    fi
    return "$repo_fail"
  fi

  rp_log_check_ok "$slug" 'secret-audit intake marker' \
    "$(rp_github_url "$slug" "/blob/main/${secret_audit_marker_relpath}")"
  return 0
}

