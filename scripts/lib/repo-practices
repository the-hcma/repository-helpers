rp_repo_has_uv_python_layout() {
  # UV Python repos are identified by uv.lock + pyproject.toml at repo root.
  # We intentionally do not attempt to parse pyproject.toml to keep this check
  # lightweight and robust under API/mocking.
  # Returns 0 when both exist, 1 when either is missing, 2 on GitHub API error.
  local slug="$1"
  local uv_ec=0
  local py_ec=0

  rp_gh_path_check "$slug" 'uv.lock' || uv_ec=$?
  if (( uv_ec == 2 )); then
    return 2
  fi
  if (( uv_ec != 0 )); then
    return 1
  fi
  rp_gh_path_check "$slug" 'pyproject.toml' || py_ec=$?
  if (( py_ec == 2 )); then
    return 2
  fi
  (( py_ec == 0 ))
}

rp_cve_check_workflow_is_canonical() {
  local text="$1"

  # Canonical template hardening requirements.
  grep -qF 'cron: '\''0 8 * * *'\'' ' <<<"$text" || return 1
  grep -qF 'workflow_dispatch:' <<<"$text" || return 1
  grep -qF 'workflow_call:' <<<"$text" || return 1
  grep -qF 'issues: write' <<<"$text" || return 1
  grep -qF 'uv sync --frozen' <<<"$text" || return 1
  # pip-audit default env mode needs pip in the uv ephemeral env (pip-api).
  grep -qF 'uv run --no-progress --with pip --with pip-audit' <<<"$text" || return 1
  grep -qF 'pip-audit --skip-editable' <<<"$text" || return 1
  grep -qF -- '--format=json' <<<"$text" || return 1
  grep -qF 'cve-check: classify-json-outcome' <<<"$text" || return 1
  grep -qF 'security/cve' <<<"$text" || return 1
  grep -qF 'gh issue' <<<"$text" || return 1
  grep -qF 'ERROR: pip-audit found CVEs but failed to create security/cve issue' <<<"$text" || return 1
  grep -qF 'ERROR: pip-audit found CVEs but failed to comment on security/cve issue' <<<"$text" || return 1
  grep -qF 'persist-credentials: false' <<<"$text" || return 1
  # Fail loud on gh issue list — assignment must be followed by || return 1 (not || true).
  grep -qF ')" || return 1' <<<"$text" || return 1
  grep -qF 'rm -f "${audit_json}"' <<<"$text" || return 1
  grep -qF 'audit_rc=$?' <<<"$text" || return 1
  grep -qF 'audit_rc != 0 && audit_rc != 1' <<<"$text" || return 1

  if grep -qF 'WARN: failed to create security/cve issue' <<<"$text"; then
    return 1
  fi
  if grep -qF 'WARN: failed to comment on security/cve issue' <<<"$text"; then
    return 1
  fi

  # Blind retry on pip-audit exit code retries deterministic CVE results.
  if grep -qF 'uses: nick-fields/retry@v4' <<<"$text"; then
    return 1
  fi

  # Must not use pip-audit --strict with uv editable project installs.
  if grep -qE 'pip-audit[^\\n]*--strict' <<<"$text"; then
    return 1
  fi
  # Silent empty-on-failure for issue list is a regression (duplicate / stale issues).
  if grep -qF '|| true)"' <<<"$text"; then
    return 1
  fi
  return 0
}

rp_check_uv_python_cve_check_workflow() {
  local slug="$1"
  local repo_fail=0
  local workflow_path='.github/workflows/cve-check.yml'
  local canonical
  local workflow_text
  local layout_ec=0
  local path_ec=0
  local fetch_ec=0

  rp_repo_has_uv_python_layout "$slug" || layout_ec=$?
  if (( layout_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not detect uv Python layout (uv.lock / pyproject.toml)'
    return 1
  fi
  if (( layout_ec != 0 )); then
    return 0
  fi

  rp_gh_path_check "$slug" "$workflow_path" || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" "could not read ${workflow_path}"
    return 1
  fi
  if (( path_ec == 1 )); then
    repo_fail=1
    rp_log_fail "${slug}: missing ${workflow_path} for uv Python repos"
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      canonical="$(rp_candidate_cve_check_workflow)"
      rp_queue_candidate_file_fix "$slug" "$workflow_path" \
        "$canonical" 'add-cve-check-workflow' \
        'chore: add daily pip-audit CVE check workflow'
    elif [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: add ${workflow_path} (canonical template: cve-check.yml)"
    fi
    return "$repo_fail"
  fi

  fetch_ec=0
  workflow_text="$(rp_fetch_github_text_file "$slug" "$workflow_path")" || fetch_ec=$?
  if (( fetch_ec == 2 )); then
    rp_log_gh_api_fail "$slug" "could not read ${workflow_path}"
    return 1
  fi
  if [[ -z "$workflow_text" ]] || ! rp_cve_check_workflow_is_canonical "$workflow_text"; then
    repo_fail=1
    rp_log_fail "${slug}: ${workflow_path} must match hardened canonical config for uv Python repos"
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      canonical="$(rp_candidate_cve_check_workflow)"
      rp_queue_candidate_file_fix "$slug" "$workflow_path" \
        "$canonical" 'sync-cve-check-workflow' \
        'chore: sync daily pip-audit CVE check workflow to canonical template'
    elif [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: sync ${workflow_path} to canonical hardened config"
    fi
    return "$repo_fail"
  fi

  rp_log_check_ok "${slug}" 'uv Python: daily CVE check workflow (cve-check.yml)' \
    "$(rp_github_url "$slug" "/blob/main/${workflow_path}")"
  return 0
}

# Default Release Please config path when the workflow does not set config-file.
readonly rp_RELEASE_PLEASE_CONFIG_DEFAULT='release-please-config.json'

# Relpath of release-please config from workflow YAML (default when unset).
# Prefer the first non-comment `config-file:` under a `with:` block (not stray
# mentions elsewhere in the file).
rp_release_please_config_relpath_from_workflow() {
  local -r text="$1"
  local path

  path="$(
    awk '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*-[[:space:]]/ { in_with = 0 }
      /^[[:space:]]*with:[[:space:]]*$/ { in_with = 1; next }
      in_with && /^[[:space:]]*config-file:[[:space:]]*/ {
        line = $0
        sub(/^[[:space:]]*config-file:[[:space:]]*/, "", line)
        gsub(/["'\'']/, "", line)
        sub(/[[:space:]].*/, "", line)
        if (line != "" && line !~ /\$\{\{/) {
          print line
          exit
        }
      }
    ' <<<"$text"
  )"
  if [[ -n "$path" ]]; then
    printf '%s\n' "$path"
  else
    printf '%s\n' "$rp_RELEASE_PLEASE_CONFIG_DEFAULT"
  fi
}

# True when release-please config bumps the editable package version in uv.lock.
# Require @.name.value== — release-please's TOML updater treats string nodes as
# objects with .value; plain @.name== matches nothing ("No entries modified").
# Reject unreplaced placeholders (silent no-op bump).
# See googleapis/release-please#2561.
rp_release_please_config_has_uv_lock_extra_files() {
  local -r config_text="$1"
  local exit_code=0

  rp_runner_jq_file "repo-practices release-please uv.lock extra-files" \
    "$config_text" -e '
    def extras:
      ([.["extra-files"] // []]
        + [
            (.packages // {})
            | to_entries[]
            | .value["extra-files"] // []
          ])
      | flatten;
    extras
    | map(select(
        (.type // "") == "toml"
        and (.path // "") == "uv.lock"
        and ((.jsonpath // "") | test("\\$\\.package\\[\\?\\(@\\.name\\.value=="))
        and ((.jsonpath // "") | test("\\]\\.version$"))
        and (((.jsonpath // "") | test("<project\\.name>|YOUR_PACKAGE_NAME|<pkg>")) | not)
      ))
    | length > 0
  ' >/dev/null || exit_code=$?
  (( exit_code == 0 ))
}

# Suggest-only: CI assert that uv.lock self-version matches pyproject (optional).
# Match only the canonical script name/path — not incidental "uv.lock"+"pyproject"
# co-mentions that would suppress the suggestion.
rp_repo_mentions_uv_lock_version_assert() {
  local -r text="$1"

  grep -qiE \
    '(\.github/ci/)?assert-uv-lock-version([[:space:]"'\'']|$)' \
    <<<"$text"
}

rp_check_uv_release_please_lock_sync() {
  local slug="$1"
  local repo_fail=0
  local layout_ec=0
  local fetch_ec=0
  local path_ec=0
  local workflow_text config_relpath config_text
  local workflow_name workflow_path workflow_blob assert_found=0
  local suggest_probe_uncertain=0

  rp_repo_has_uv_python_layout "$slug" || layout_ec=$?
  if (( layout_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not detect uv Python layout (uv.lock / pyproject.toml)'
    return 1
  fi
  if (( layout_ec != 0 )); then
    return 0
  fi

  path_ec=0
  rp_gh_path_check "$slug" '.github/workflows/release-please.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not detect Release Please workflow'
    return 1
  fi
  if (( path_ec != 0 )); then
    return 0
  fi

  fetch_ec=0
  workflow_text="$(rp_fetch_github_text_file "$slug" \
    '.github/workflows/release-please.yml')" || fetch_ec=$?
  if (( fetch_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/workflows/release-please.yml'
    return 1
  fi
  if [[ -z "$workflow_text" ]]; then
    repo_fail=1
    rp_log_fail \
      "${slug}: .github/workflows/release-please.yml missing or empty after Release Please detection"
    return "$repo_fail"
  fi

  config_relpath="$(rp_release_please_config_relpath_from_workflow "$workflow_text")"
  if [[ "$config_relpath" == /* || "$config_relpath" == *'..'* ]]; then
    rp_log_fail "${slug}: unsafe release-please config-file path: ${config_relpath}"
    return 1
  fi
  path_ec=0
  rp_gh_path_check "$slug" "$config_relpath" || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" "could not read ${config_relpath}"
    return 1
  fi
  if (( path_ec == 1 )); then
    repo_fail=1
    rp_log_fail \
      "${slug}: missing ${config_relpath} with uv.lock extra-files for Release Please + uv"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add ${config_relpath} packages.\".\".extra-files toml entry for uv.lock (googleapis/release-please#2561; jsonpath \$.package[?(@.name.value=='<pkg>')].version — substitute pyproject project.name for <pkg>; use @.name.value not @.name)"
    fi
  else
    fetch_ec=0
    config_text="$(rp_fetch_github_text_file "$slug" "$config_relpath")" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${config_relpath}"
      return 1
    fi
    if [[ -z "$config_text" ]] \
      || ! rp_release_please_config_has_uv_lock_extra_files "$config_text"; then
      repo_fail=1
      rp_log_fail \
        "${slug}: ${config_relpath} must bump uv.lock package version via extra-files (Release Please + uv)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: add toml extra-files path=uv.lock jsonpath=\$.package[?(@.name.value=='<pkg>')].version (substitute pyproject project.name; not plain @.name; see googleapis/release-please#2561)"
      fi
    fi
  fi

  if (( repo_fail == 0 )); then
    rp_log_check_ok "$slug" 'uv Python: Release Please uv.lock self-version sync' \
      "$(rp_github_url "$slug" "/blob/main/${config_relpath}")"
  fi

  # Optional companion: CI assert before uv sync so silent jsonpath misses fail fast.
  if [[ "$rp_suggest" -eq 1 ]]; then
    assert_found=0
    suggest_probe_uncertain=0
    # Drain the process-substitution producer fully (no early break) to avoid
    # broken-pipe runner failures — same pattern as rp_workflow_uses_setup_pnpm_corepack.
    while IFS= read -r workflow_name; do
      [[ -n "$workflow_name" ]] || continue
      if (( suggest_probe_uncertain == 1 || assert_found == 1 )); then
        continue
      fi
      [[ "$workflow_name" == *.yml || "$workflow_name" == *.yaml ]] || continue
      workflow_path=".github/workflows/${workflow_name}"
      fetch_ec=0
      workflow_blob="$(rp_fetch_github_text_file "$slug" "$workflow_path")" || fetch_ec=$?
      if (( fetch_ec == 2 )); then
        suggest_probe_uncertain=1
        continue
      fi
      if (( fetch_ec != 0 )); then
        continue
      fi
      if rp_repo_mentions_uv_lock_version_assert "$workflow_blob"; then
        assert_found=1
        continue
      fi
    done < <(rp_fetch_workflow_file_names "$slug")
    path_ec=0
    rp_gh_path_check "$slug" '.github/ci/assert-uv-lock-version' || path_ec=$?
    if (( path_ec == 2 )); then
      suggest_probe_uncertain=1
    elif (( path_ec == 0 )); then
      assert_found=1
    fi
    if (( suggest_probe_uncertain == 0 && assert_found == 0 )); then
      rp_log_suggest \
        "${slug}: consider CI assert that uv.lock package version matches pyproject.toml project.version (run before uv sync; see scripts/lib/repo-practices-workflows/assert-uv-lock-version.snippet)"
    fi
  fi

  return "$repo_fail"
}

# Canonical job name for the combined Python lint/format/typecheck CI job.
readonly rp_PYTHON_STATIC_JOB_NAME='Python lint & format checks'
# Canonical CI wrapper script that runs ruff + typechecker in one uv sync.
readonly rp_PYTHON_STATIC_SCRIPT_PATH='.github/ci/python-static'

# True when a .github/ci/python-static script runs ruff check + format + a typechecker.
rp_python_static_wrapper_is_canonical() {
  local text="$1"
  grep -qE 'ruff[[:space:]]+check' <<<"$text" || return 1
  grep -qE 'ruff[[:space:]]+format[[:space:]]+--check' <<<"$text" || return 1
  grep -qE '(pyright|mypy)' <<<"$text" || return 1
  return 0
}

# Job / step / matrix `name:` lines that publish a legacy context (optional list
# dash; optional trailing YAML `#` comment).
readonly rp_PYTHON_STATIC_SPLIT_JOB_NAME_RE='^[[:space:]]*(-[[:space:]]*)?name:[[:space:]]*["'\'']?(Ruff|Pyright|Mypy|Backend Lint)["'\'']?[[:space:]]*(#.*)?$'

# Matrix/check `aliases:` that still publish leftover legacy contexts (end-state).
# Whole tokens only (space-separated) — not substrings like mypy-check / FooMypy.
readonly rp_PYTHON_STATIC_ALIASES_FIELD_RE='^[[:space:]]*aliases:[[:space:]]*(([^#[:space:]]+[[:space:]]+)*)(Ruff|Pyright|Mypy|Backend Lint)([[:space:]]|#|$)'

# Job display-name line (no list dash) with optional trailing comment.
readonly rp_PYTHON_STATIC_JOB_NAME_LINE_RE='^[[:space:]]*name:[[:space:]]*["'\'']?(Ruff|Pyright|Mypy|Backend Lint)["'\'']?[[:space:]]*(#.*)?$'

# Matrix list item name line with optional trailing comment.
readonly rp_PYTHON_STATIC_MATRIX_NAME_LINE_RE='^[[:space:]]*-[[:space:]]*name:[[:space:]]*["'\'']?(Ruff|Pyright|Mypy|Backend Lint)["'\'']?[[:space:]]*(#.*)?$'

# True when a workflow publishes standalone Ruff/Pyright/Mypy/Backend Lint contexts
# (split jobs, matrix primary names, checks-action names, or leftover aliases: fields).
rp_ci_workflow_has_split_python_static_jobs() {
  local text="$1"
  grep -qE "$rp_PYTHON_STATIC_SPLIT_JOB_NAME_RE" <<<"$text" \
    || grep -qE "$rp_PYTHON_STATIC_ALIASES_FIELD_RE" <<<"$text"
}

# Cutover alias stubs that `needs: python-static` but only gate on guard will
# still *run and succeed* when python-static fails (GitHub Actions re-evaluates
# a custom `if:` instead of the default success()). Required checks named
# Ruff/Pyright/… then go green while lint/typecheck failed.
#
# True when any split-named *job* block lacks the python-static success gate
# (scoped per job under `jobs:` — a gate on an unrelated job must not mask an
# unsafe alias). Matrix list items (`- name: Ruff`) are ignored here — see
# rp_workflow_has_unsafe_noop_legacy_python_static. Flags accumulate per job
# block and are evaluated at the block boundary, so YAML key ordering
# (`if:` before `name:`) and multi-line `if:` scalars are both handled. The
# job-key indent is learned from the first key under `jobs:` so 2-space and
# 4-space YAML both parse; deeper keys (steps, permissions) are ignored.
rp_ci_workflow_has_unsafe_python_static_cutover_aliases() {
  local text="$1"
  # Job display names only (no list dash) — matrix rows are handled separately.
  # Match only at job-property indent (learned from the first key under the job)
  # so step-level `name: Ruff` under `steps:` is not a false-positive cutover alias.
  grep -qE "$rp_PYTHON_STATIC_JOB_NAME_LINE_RE" <<<"$text" || return 1
  awk -v name_re="$rp_PYTHON_STATIC_JOB_NAME_LINE_RE" '
    BEGIN {
      unsafe = 0
      in_jobs = 0
      is_alias = 0
      has_gate = 0
      job_indent = 0
      prop_indent = -1
      in_steps = 0
    }
    /^jobs:[[:space:]]*$/ { in_jobs = 1; job_indent = 0; next }
    in_jobs && /^[^[:space:]]/ { in_jobs = 0 }
    !in_jobs { next }
    # Job key under jobs: (indent level learned from the first key seen).
    /^ +[A-Za-z0-9_.-]+:[[:space:]]*$/ {
      indent = match($0, /[^ ]/) - 1
      if (job_indent == 0) { job_indent = indent }
      if (indent == job_indent) {
        if (is_alias && !has_gate) { unsafe = 1 }
        is_alias = 0
        has_gate = 0
        prop_indent = -1
        in_steps = 0
        next
      }
    }
    {
      indent = match($0, /[^ ]/) - 1
      if (prop_indent < 0 && indent > job_indent && $0 ~ /^ +[A-Za-z0-9_.-]+:/) {
        prop_indent = indent
      }
      if (prop_indent >= 0 && indent == prop_indent && $0 ~ /^ +steps:/) {
        in_steps = 1
      }
      if (prop_indent >= 0 && indent == prop_indent && $0 ~ name_re) {
        is_alias = 1
        next
      }
      # Job-level if: (including multi-line if: > continuations) — not step if:.
      if (!in_steps && prop_indent >= 0 && indent >= prop_indent \
          && $0 ~ /needs\.python-static\.result[[:space:]]*==[[:space:]]*['\''"]?success['\''"]?/) {
        has_gate = 1
      }
    }
    END {
      if (is_alias && !has_gate) { unsafe = 1 }
      exit(unsafe ? 0 : 1)
    }
  ' <<<"$text"
}

# Matrix rows that publish a legacy check name via a no-op / cutover-ok stub in
# parallel with the real static job — those checks go green even when lint fails.
# Safe cutover publishes aliases from the real job/script with the same conclusion
# (e.g. aliases: Ruff Mypy on the python-static matrix row), not a separate no-op.
rp_workflow_has_unsafe_noop_legacy_python_static() {
  local text="$1"
  awk -v name_re="$rp_PYTHON_STATIC_MATRIX_NAME_LINE_RE" '
    BEGIN {
      unsafe = 0
      in_item = 0
      is_legacy = 0
      is_noop = 0
      saw_true_run = 0
      saw_real_action = 0
      item_indent = -1
    }
    function finish_item() {
      # run: true is a cutover stub only when the row has no other real action.
      if (saw_true_run && !saw_real_action) { is_noop = 1 }
      if (in_item && is_legacy && is_noop) { unsafe = 1 }
      in_item = 0
      is_legacy = 0
      is_noop = 0
      saw_true_run = 0
      saw_real_action = 0
      item_indent = -1
    }
    /^[[:space:]]*-[[:space:]]/ {
      cur = match($0, /[^ ]/) - 1
      # Next/sibling list item at this indent closes the current matrix row.
      if (in_item && cur <= item_indent) {
        finish_item()
      }
      if ($0 ~ name_re) {
        in_item = 1
        is_legacy = 1
        is_noop = 0
        saw_true_run = 0
        saw_real_action = 0
        item_indent = cur
        next
      }
    }
    in_item {
      cur = match($0, /[^ ]/) - 1
      # Only a shallower indent leaves the matrix row (same-indent keys are fields).
      if (cur >= 0 && cur < item_indent && $0 !~ /^[[:space:]]*$/) {
        finish_item()
        next
      }
      # Basename cutover-ok (optional dir prefix) — avoid validate-cutover-ok-setup FPs.
      if ($0 ~ /script:[[:space:]]*(.*\/)?cutover-ok([^A-Za-z0-9_-]|$)/) { is_noop = 1 }
      # Cutover stubs only — quoted or unquoted Covered-by echo.
      if ($0 ~ /run:[[:space:]]*echo[[:space:]]+["'\'']?Covered by(["'\''[:space:]]|$)/) { is_noop = 1 }
      if ($0 ~ /run:[[:space:]]*bash[[:space:]]+(.*\/)?cutover-ok([^A-Za-z0-9_-]|$)/) { is_noop = 1 }
      if ($0 ~ /run:[[:space:]]*exit[[:space:]]+0[[:space:]]*$/) { is_noop = 1 }
      if ($0 ~ /run:[[:space:]]*["'\'']?true["'\'']?[[:space:]]*$/) { saw_true_run = 1 }
      # Real matrix actions (not cutover stubs) suppress a lone run: true noop.
      if ($0 ~ /script:[[:space:]]/ \
          && $0 !~ /script:[[:space:]]*(.*\/)?cutover-ok([^A-Za-z0-9_-]|$)/) {
        saw_real_action = 1
      }
      if ($0 ~ /run:[[:space:]]/ \
          && $0 !~ /run:[[:space:]]*["'\'']?true["'\'']?[[:space:]]*$/ \
          && $0 !~ /run:[[:space:]]*echo[[:space:]]+["'\'']?Covered by(["'\''[:space:]]|$)/ \
          && $0 !~ /run:[[:space:]]*bash[[:space:]]+(.*\/)?cutover-ok([^A-Za-z0-9_-]|$)/ \
          && $0 !~ /run:[[:space:]]*exit[[:space:]]+0[[:space:]]*$/) {
        saw_real_action = 1
      }
    }
    END {
      finish_item()
      exit(unsafe ? 0 : 1)
    }
  ' <<<"$text"
}

# checks-action (or similar) that publishes a legacy name with a conclusion that
# is not derived from steps.*.outcome — success is then independent of the real
# static-check step (false-green). Outcome-tied conclusions are allowed for
# cutover but still fail end-state via rp_ci_workflow_has_split_python_static_jobs.
rp_workflow_has_unsafe_checks_action_python_static() {
  local text="$1"
  awk '
    BEGIN {
      unsafe = 0
      in_step = 0
      is_checks = 0
      has_legacy = 0
      has_outcome_gate = 0
      pending_conclusion = 0
      conclusion_indent = -1
      step_indent = -1
    }
    function finish_step() {
      if (in_step && is_checks && has_legacy && !has_outcome_gate) { unsafe = 1 }
      in_step = 0
      is_checks = 0
      has_legacy = 0
      has_outcome_gate = 0
      pending_conclusion = 0
      conclusion_indent = -1
      step_indent = -1
    }
    /^[[:space:]]*-[[:space:]]/ {
      cur = match($0, /[^ ]/) - 1
      if (in_step && cur <= step_indent) {
        finish_step()
      }
      # Any list step may later reveal uses: checks-action (name: may come first).
      in_step = 1
      # Action path segment …/checks-action@… — not arbitrary substring matches.
      is_checks = ($0 ~ /uses:[[:space:]]*[^[:space:]]*\/checks-action(@|[[:space:]]|$)/)
      has_legacy = ($0 ~ /^[[:space:]]*-[[:space:]]*name:[[:space:]]*["'\'']?(Ruff|Pyright|Mypy|Backend Lint)["'\'']?[[:space:]]*(#.*)?$/)
      has_outcome_gate = 0
      pending_conclusion = 0
      conclusion_indent = -1
      step_indent = cur
      next
    }
    in_step {
      cur = match($0, /[^ ]/) - 1
      if (cur >= 0 && cur <= step_indent && $0 !~ /^[[:space:]]*$/) {
        finish_step()
        next
      }
      if ($0 ~ /^[[:space:]]*uses:[[:space:]]*[^[:space:]]*\/checks-action(@|[[:space:]]|$)/) {
        is_checks = 1
      }
      if ($0 ~ /^[[:space:]]*name:[[:space:]]*["'\'']?(Ruff|Pyright|Mypy|Backend Lint)["'\'']?[[:space:]]*(#.*)?$/) {
        has_legacy = 1
      }
      if ($0 ~ /conclusion:[[:space:]]*/) {
        conclusion_indent = cur
        line_nocomment = $0
        sub(/#.*/, "", line_nocomment)
        if (line_nocomment ~ /steps\.[A-Za-z0-9_-]+\.outcome/) {
          has_outcome_gate = 1
          pending_conclusion = 0
        } else if (line_nocomment ~ /conclusion:[[:space:]]*[>|][-+]?/) {
          # Folded/literal scalar (incl. >- / |+) — only deeper continuation lines count.
          pending_conclusion = 1
        } else {
          # Inline value without outcome (e.g. conclusion: success) — not gated.
          pending_conclusion = 0
        }
      } else if (pending_conclusion) {
        line_nocomment = $0
        sub(/#.*/, "", line_nocomment)
        # Sibling with: keys end the scalar; other lines (any indent) may carry the value.
        if (cur <= conclusion_indent && line_nocomment ~ /^[[:space:]]*[A-Za-z0-9_.-]+:/) {
          pending_conclusion = 0
        } else if (line_nocomment ~ /steps\.[A-Za-z0-9_-]+\.outcome/) {
          has_outcome_gate = 1
          pending_conclusion = 0
        }
      }
    }
    END {
      finish_step()
      exit(unsafe ? 0 : 1)
    }
  ' <<<"$text"
}

# True when any workflow-level false-green publisher is present (unsafe job
# aliases, matrix no-op legacy rows, or ungated checks-action conclusions).
rp_workflow_has_unsafe_python_static_publishers() {
  local text="$1"
  rp_ci_workflow_has_unsafe_python_static_cutover_aliases "$text" \
    || rp_workflow_has_unsafe_noop_legacy_python_static "$text" \
    || rp_workflow_has_unsafe_checks_action_python_static "$text"
}

# True when ci.yml has one job that both uses the canonical display name and
# runs the wrapper (scoped to the same job block under `jobs:`). Name and
# wrapper flags accumulate per job block and are evaluated at the block
# boundary, so YAML key ordering (`steps:` before `name:`) is handled.
rp_ci_workflow_has_combined_python_static_job() {
  local text="$1"
  local -r job_name="$rp_PYTHON_STATIC_JOB_NAME"
  local -r wrapper="bash ${rp_PYTHON_STATIC_SCRIPT_PATH}"
  awk -v job_name="$job_name" -v wrapper="$wrapper" '
    BEGIN { found = 0; in_jobs = 0; has_name = 0; has_wrapper = 0; job_indent = 0 }
    /^jobs:[[:space:]]*$/ { in_jobs = 1; job_indent = 0; next }
    in_jobs && /^[^[:space:]]/ { in_jobs = 0 }
    !in_jobs { next }
    /^ +[A-Za-z0-9_.-]+:[[:space:]]*$/ {
      indent = match($0, /[^ ]/) - 1
      if (job_indent == 0) { job_indent = indent }
      if (indent == job_indent) {
        if (has_name && has_wrapper) { found = 1 }
        has_name = 0
        has_wrapper = 0
        next
      }
    }
    {
      name_re = "^[[:space:]]*name:[[:space:]]*[\"'\'']?" job_name "[\"'\'']?[[:space:]]*$"
      if ($0 ~ name_re) {
        has_name = 1
        next
      }
      # Exact wrapper invocation: reject suffixed paths like python-static-v2.
      pos = index($0, wrapper)
      if (pos > 0) {
        tail = substr($0, pos + length(wrapper), 1)
        if (tail == "" || tail == " " || tail == "\t" || tail == "\"" || tail == "'\''") {
          has_wrapper = 1
        }
      }
    }
    END {
      if (has_name && has_wrapper) { found = 1 }
      exit(found ? 0 : 1)
    }
  ' <<<"$text"
}

# Classify whether the repo lints Python with ruff in CI.
# Exit 0 = uses ruff (policy applies). Exit 1 = no ruff. Exit 2 = GitHub API error.
# Only ci.yml content or the canonical python-static wrapper count — a stale
# `.github/ci/ruff` path alone must not force the policy on.
rp_repo_uses_ruff_ci() {
  local slug="$1"
  local ci_text="$2"
  local path_ec=0

  if grep -qiF 'ruff' <<<"$ci_text"; then
    return 0
  fi

  rp_gh_path_check "$slug" "$rp_PYTHON_STATIC_SCRIPT_PATH" || path_ec=$?
  if (( path_ec == 2 )); then
    return 2
  fi
  if (( path_ec == 0 )); then
    return 0
  fi
  return 1
}

# Best practice: Python repos run ruff (check + format) and their typechecker
# (pyright/mypy) in ONE CI job (`Python lint & format checks`) driven by a shared
# `.github/ci/python-static` wrapper — not split across per-tool jobs. Splitting
# burns an extra runner + uv sync and adds a branch-protection context per tool
# (the source of the domesti-bot "missing Ruff" drift). Cutover aliases that omit
# `needs.python-static.result == 'success'` (or publish legacy names via a
# separate no-op / ungated checks-action from *any* workflow) falsely green
# required checks when the combined job fails. See the Python static CI cursor
# rule and AGENTS.md.
rp_check_python_static_ci_job() {
  local slug="$1"
  local repo_fail=0
  local py_ec=0
  local ruff_ec=0
  local path_ec=0
  local ci_text
  local wrapper_text
  local wrapper_ec=0
  local workflow_name
  local workflow_path
  local workflow_text
  local fetch_ec=0
  local workflow_count=0
  local saw_ci_workflow=0

  # Gate: only Python repos (pyproject.toml at root).
  rp_gh_path_check "$slug" 'pyproject.toml' || py_ec=$?
  if (( py_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not detect pyproject.toml for Python static CI check'
    return 1
  fi
  if (( py_ec != 0 )); then
    return 0
  fi

  # Distinguish missing ci.yml from GitHub API failures (do not treat empty
  # decode from a transient 502 as "no workflow").
  path_ec=0
  rp_gh_path_check "$slug" '.github/workflows/ci.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/workflows/ci.yml for Python static CI check'
    return 1
  fi
  if (( path_ec != 0 )); then
    return 0
  fi

  wrapper_ec=0
  ci_text="$(rp_fetch_github_text_file "$slug" '.github/workflows/ci.yml')" || wrapper_ec=$?
  if (( wrapper_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/workflows/ci.yml for Python static CI check'
    return 1
  fi
  if (( wrapper_ec != 0 )) || [[ -z "$ci_text" ]]; then
    # Path existed but content empty/unreadable — treat as missing workflow, skip.
    return 0
  fi

  # Gate: only repos that lint Python with ruff in CI.
  rp_repo_uses_ruff_ci "$slug" "$ci_text" || ruff_ec=$?
  if (( ruff_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not detect ruff CI usage for Python static check'
    return 1
  fi
  if (( ruff_ec != 0 )); then
    return 0
  fi

  # Scan every workflow — false-green publishers often live outside ci.yml
  # (release-please matrix no-ops, reusable checks-action stubs). Issue #390.
  while IFS= read -r workflow_name; do
    [[ -n "$workflow_name" ]] || continue
    [[ "$workflow_name" == *.yml ]] || continue
    workflow_count=$((workflow_count + 1))
    if [[ "$workflow_name" == 'ci.yml' ]]; then
      saw_ci_workflow=1
    fi
    workflow_path=".github/workflows/${workflow_name}"
    if [[ "$workflow_name" == 'ci.yml' ]]; then
      # Reuse the earlier successful fetch — a transient re-fetch miss must not
      # skip auditing ci.yml while saw_ci_workflow is already set.
      workflow_text="$ci_text"
    else
      fetch_ec=0
      workflow_text="$(rp_fetch_github_text_file "$slug" "$workflow_path")" || fetch_ec=$?
      if (( fetch_ec == 2 )); then
        rp_log_gh_api_fail "$slug" "could not read ${workflow_path} for Python static CI check"
        return 1
      fi
      # Listed workflows must be readable — empty/decode failure must not skip
      # non-ci.yml false-green publishers (unlike a truly missing path).
      if (( fetch_ec != 0 )) || [[ -z "$workflow_text" ]]; then
        rp_log_gh_api_fail "$slug" \
          "could not read ${workflow_path} for Python static CI check (listed but empty/unreadable)"
        return 1
      fi
    fi

    if rp_workflow_has_unsafe_python_static_publishers "$workflow_text"; then
      repo_fail=1
      rp_log_fail \
        "${slug}: ${workflow_path}: legacy Python static check publishers (Ruff/Pyright/Mypy/Backend Lint) are not gated on the combined job/step succeeding (false-green risk)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: ${workflow_path}: gate aliases with needs.python-static.result == 'success', share conclusion via aliases:/steps.*.outcome, or remove no-op publishers"
      fi
    elif rp_ci_workflow_has_split_python_static_jobs "$workflow_text"; then
      repo_fail=1
      rp_log_fail \
        "${slug}: ${workflow_path}: still publishes split/cutover Python static contexts (Ruff/Pyright/Mypy/Backend Lint); remove after protection retarget"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: ${workflow_path}: remove alias jobs/matrix rows/aliases: fields; keep only '${rp_PYTHON_STATIC_JOB_NAME}' via ${rp_PYTHON_STATIC_SCRIPT_PATH}"
      fi
    fi
  done < <(rp_fetch_workflow_file_names "$slug")

  # Empty listing while ci.yml exists means the directory list call failed open —
  # do not pass the audit (that would skip release-please.yml and friends).
  if (( workflow_count == 0 )); then
    rp_log_gh_api_fail "$slug" \
      'could not list .github/workflows for Python static CI check (refusing to skip non-ci.yml publishers)'
    return 1
  fi

  # Listing succeeded but omitted ci.yml — still audit the content we already fetched.
  if (( saw_ci_workflow == 0 )); then
    if rp_workflow_has_unsafe_python_static_publishers "$ci_text"; then
      repo_fail=1
      rp_log_fail \
        "${slug}: .github/workflows/ci.yml: legacy Python static check publishers (Ruff/Pyright/Mypy/Backend Lint) are not gated on the combined job/step succeeding (false-green risk)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: .github/workflows/ci.yml: alias if: must include needs.python-static.result == 'success' (or remove aliases after github-repo-lint --apply-fix)"
      fi
    elif rp_ci_workflow_has_split_python_static_jobs "$ci_text"; then
      repo_fail=1
      rp_log_fail \
        "${slug}: .github/workflows/ci.yml: still publishes split/cutover Python static contexts (Ruff/Pyright/Mypy/Backend Lint); remove after protection retarget"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: .github/workflows/ci.yml: remove alias jobs; keep only '${rp_PYTHON_STATIC_JOB_NAME}' via ${rp_PYTHON_STATIC_SCRIPT_PATH}"
      fi
    fi
  fi

  if ! rp_ci_workflow_has_combined_python_static_job "$ci_text"; then
    repo_fail=1
    rp_log_fail \
      "${slug}: ci.yml missing combined '${rp_PYTHON_STATIC_JOB_NAME}' job running ${rp_PYTHON_STATIC_SCRIPT_PATH}"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add a '${rp_PYTHON_STATIC_JOB_NAME}' job that runs 'bash ${rp_PYTHON_STATIC_SCRIPT_PATH}'"
    fi
  fi

  path_ec=0
  rp_gh_path_check "$slug" "$rp_PYTHON_STATIC_SCRIPT_PATH" || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" "could not read ${rp_PYTHON_STATIC_SCRIPT_PATH}"
    return 1
  fi
  if (( path_ec != 0 )); then
    repo_fail=1
    rp_log_fail "${slug}: missing ${rp_PYTHON_STATIC_SCRIPT_PATH} wrapper (ruff check + format + typecheck)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add ${rp_PYTHON_STATIC_SCRIPT_PATH} running ruff check, ruff format --check, and pyright/mypy after one uv sync"
    fi
  else
    wrapper_ec=0
    wrapper_text="$(rp_fetch_github_text_file "$slug" "$rp_PYTHON_STATIC_SCRIPT_PATH")" || wrapper_ec=$?
    if (( wrapper_ec == 2 )); then
      rp_log_gh_api_fail "$slug" "could not read ${rp_PYTHON_STATIC_SCRIPT_PATH}"
      return 1
    fi
    if [[ -z "$wrapper_text" ]] || ! rp_python_static_wrapper_is_canonical "$wrapper_text"; then
      repo_fail=1
      rp_log_fail \
        "${slug}: ${rp_PYTHON_STATIC_SCRIPT_PATH} must run ruff check, ruff format --check, and a typechecker"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: ${rp_PYTHON_STATIC_SCRIPT_PATH} should run ruff check, ruff format --check, and pyright/mypy"
      fi
    fi
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "${slug}" 'Python static checks combined in one CI job' \
      "$(rp_github_url "$slug" "/blob/main/${rp_PYTHON_STATIC_SCRIPT_PATH}")"
  fi

  return "$repo_fail"
}

