rp_ci_workflow_restricts_pr_branches() {
  local text="$1"
  # Graphite stacks open upstack PRs against a non-main base branch, so
  # restricting pull_request.branches to main prevents CI from running.
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1; found = 0 }
    /^on:[[:space:]]*$/ { in_on = 1; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_pr = 0; pr_indent = -1 }
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      next
    }
    in_pr {
      # If indentation backs out to pull_request: level or less, the block ended.
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) { in_pr = 0; next }
      if ($0 ~ /^[[:space:]]*branches:[[:space:]]*/) { found = 1 }
    }
    END { exit(found ? 0 : 1) }
  ' <<<"$text"
}

rp_fix_ci_workflow_for_stacked_prs() {
  local text="$1"
  # - Keep push triggers on main only.
  # - Remove any pull_request.branches restriction so stacked PRs run CI.
  # - Preserve the rest of the workflow verbatim.
  awk '
    BEGIN { in_on = 0; in_pr = 0; pr_indent = -1 }
    /^on:[[:space:]]*$/ { in_on = 1; print; next }
    in_on && /^[^[:space:]]/ { in_on = 0; in_pr = 0; pr_indent = -1; print; next }

    # Normalize push branches to main-only when on a single-line list.
    in_on && /^[[:space:]]*push:[[:space:]]*$/ { print; next }
    in_on && /^[[:space:]]*branches:[[:space:]]*\\[main, master\\][[:space:]]*$/ { sub(/\\[main, master\\]/, "[main]"); print; next }

    # Enter pull_request block; we keep the key but drop branches restriction.
    in_on && /^[[:space:]]*pull_request:[[:space:]]*$/ {
      in_pr = 1
      pr_indent = match($0, /[^ ]/) - 1
      print
      next
    }

    in_pr {
      cur = match($0, /[^ ]/) - 1
      if (cur <= pr_indent) { in_pr = 0; pr_indent = -1; print; next }
      # Drop pull_request.branches lines (both single-line list and multi-line style)
      if ($0 ~ /^[[:space:]]*branches:[[:space:]]*/) { next }
      if ($0 ~ /^[[:space:]]*-[[:space:]]*(main|master)[[:space:]]*$/) { next }
      print
      next
    }

    { print }
  ' <<<"$text"
}

# Emit CI check context names for branch protection (job display name, else job id).
# Skips guard/changed-files/secret-scan/workflow-lint (optional CI gates, not merge blockers).
rp_discover_ci_status_contexts() {
  local slug="$1"
  local text
  text="$(rp_fetch_ci_workflow_text "$slug" 2>/dev/null || true)"
  if [[ -z "$text" ]]; then
    return 0
  fi
  awk '
    function emit() {
      if (job == "" || job == "guard" || job == "changed-files" || job == "secret-scan" \
          || job == "workflow-lint") {
        return
      }
      if (disp != "") {
        print disp
      } else {
        print job
      }
    }
    BEGIN { in_jobs = 0; job = ""; disp = "" }
    /^jobs:/ { in_jobs = 1; next }
    !in_jobs { next }
    /^  [a-zA-Z0-9_-]+:/ {
      emit()
      job = $1
      sub(/^  /, "", job)
      sub(/:$/, "", job)
      disp = ""
      next
    }
    job != "" && /^    name:/ {
      sub(/^    name: /, "")
      disp = $0
      next
    }
    END { emit() }
  ' <<<"$text"
}

# rp_fetch_classic_main_protection_json <slug>
# Prints protection JSON on stdout. Returns 0 on success, 1 when protection is absent,
# 2 when GitHub API failed.
rp_fetch_classic_main_protection_json() {
  local slug="$1"
  local prot_exit_code=0
  set +e
  rp_runner_gh_api_stream "repo-practices classic main protection" --probe \
    "repos/${slug}/branches/main/protection" >/dev/null
  prot_exit_code=$?
  set -e
  if (( prot_exit_code != 0 )); then
    if rp_runner_last_stderr_summary | grep -qF '404'; then
      return 1
    fi
    return 2
  fi
  rp_runner_last_stdout
  return 0
}

rp_classic_protection_bypass_apps_json() {
  local slug="$1"
  local apps
  apps='["'"${rp_GRAPHITE_APP_SLUG}"'"]'
  if rp_repo_has_dependabot "$slug"; then
    apps='["'"${rp_GRAPHITE_APP_SLUG}"'","'"${rp_DEPENDABOT_APP_SLUG}"'"]'
  fi
  printf '%s' "$apps"
}

rp_validate_classic_main_protection_json() {
  local slug="$1"
  local protection_json="$2"
  local fail=0
  local expected
  local -a expected_contexts=()
  local ctx

  local jq_exit_code=0
  rp_runner_jq_file "repo-practices allow force pushes" "$protection_json" \
    -e '.allow_force_pushes.enabled == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code == 0 )); then
    rp_log_fail "${slug}: classic main protection must disallow force-push"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices allow deletions" "$protection_json" \
    -e '.allow_deletions.enabled == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code == 0 )); then
    rp_log_fail "${slug}: classic main protection must disallow branch deletion"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices dismiss stale reviews" "$protection_json" \
    -e '.required_pull_request_reviews.dismiss_stale_reviews == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must dismiss stale reviews"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices code owner reviews" "$protection_json" \
    -e '.required_pull_request_reviews.require_code_owner_reviews == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must require CODEOWNERS review"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices graphite review bypass" "$protection_json" \
    --arg slug "${rp_GRAPHITE_APP_SLUG}" \
    -e '[.required_pull_request_reviews.bypass_pull_request_allowances.apps[]?.slug] | index($slug) != null' \
    >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must bypass ${rp_GRAPHITE_APP_SLUG} for reviews"
    fail=1
  fi
  if rp_repo_has_dependabot "$slug"; then
    jq_exit_code=0
    rp_runner_jq_file "repo-practices dependabot review bypass" "$protection_json" \
      --arg slug "${rp_DEPENDABOT_APP_SLUG}" \
      -e '[.required_pull_request_reviews.bypass_pull_request_allowances.apps[]?.slug] | index($slug) != null' \
      >/dev/null || jq_exit_code=$?
    if (( jq_exit_code != 0 )); then
      rp_log_fail "${slug}: classic main protection must bypass dependabot when dependabot.yml exists"
      fail=1
    fi
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices graphite push restriction" "$protection_json" \
    --arg slug "${rp_GRAPHITE_APP_SLUG}" \
    -e '[.restrictions.apps[]?.slug] | index($slug) != null' \
    >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must restrict pushes on main to ${rp_GRAPHITE_APP_SLUG}"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices strict status checks" "$protection_json" \
    -e '.required_status_checks.strict == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must require branches up to date (strict)"
    fail=1
  fi

  while IFS= read -r expected; do
    [[ -n "$expected" ]] || continue
    expected_contexts+=("$expected")
  done < <(rp_discover_ci_status_contexts "$slug")

  if [[ "${#expected_contexts[@]}" -eq 0 ]]; then
    if rp_gh_path_exists "$slug" '.github/workflows/ci.yml'; then
      rp_log_fail "${slug}: could not discover CI status contexts from ci.yml"
      fail=1
    fi
  else
    for ctx in "${expected_contexts[@]}"; do
      jq_exit_code=0
      rp_runner_jq_file "repo-practices status context ${ctx}" "$protection_json" \
        --arg ctx "$ctx" \
        -e '[.required_status_checks.contexts[]?] | index($ctx) != null' \
        >/dev/null || jq_exit_code=$?
      if (( jq_exit_code != 0 )); then
        rp_log_fail "${slug}: classic main protection missing required status check: ${ctx}"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add CI context ${ctx} (from ci.yml) to main branch protection"
        fi
        fail=1
      fi
    done
  fi

  jq_exit_code=0
  rp_runner_jq_file "repo-practices enforce admins" "$protection_json" \
    -e '.enforce_admins.enabled == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code == 0 )); then
    rp_log_warn "${slug}: enforce_admins is enabled (org default is false)"
  fi

  return "$fail"
}

rp_apply_classic_main_protection() {
  local slug="$1"
  local -a contexts=()
  local ctx
  local bypass_apps_json payload

  while IFS= read -r ctx; do
    [[ -n "$ctx" ]] || continue
    contexts+=("$ctx")
  done < <(rp_discover_ci_status_contexts "$slug")

  bypass_apps_json="$(rp_classic_protection_bypass_apps_json "$slug")"

  if [[ "${#contexts[@]}" -eq 0 ]]; then
    payload="$(rp_runner_jq_n "repo-practices classic protection payload empty contexts" \
      --arg owner "${rp_ORG_OWNER_BYPASS_USER}" \
      --argjson bypass_apps "$bypass_apps_json" \
      '{
        required_status_checks: null,
        enforce_admins: false,
        required_pull_request_reviews: {
          dismiss_stale_reviews: true,
          require_code_owner_reviews: true,
          required_approving_review_count: 0,
          bypass_pull_request_allowances: {
            users: [$owner],
            teams: [],
            apps: $bypass_apps
          }
        },
        restrictions: {
          users: [],
          teams: [],
          apps: ["graphite-app"]
        },
        allow_force_pushes: false,
        allow_deletions: false
      }')"
  else
    local contexts_lines
    contexts_lines="$(printf '%s\n' "${contexts[@]}")"
    payload="$(rp_runner_jq_n "repo-practices classic protection payload" \
      --arg owner "${rp_ORG_OWNER_BYPASS_USER}" \
      --argjson bypass_apps "$bypass_apps_json" \
      --argjson contexts "$(rp_runner_jq_file "repo-practices protection contexts slurp" "$contexts_lines" -R -s 'split("\n") | map(select(length > 0))')" \
      '{
        required_status_checks: {
          strict: true,
          contexts: $contexts
        },
        enforce_admins: false,
        required_pull_request_reviews: {
          dismiss_stale_reviews: true,
          require_code_owner_reviews: true,
          required_approving_review_count: 0,
          bypass_pull_request_allowances: {
            users: [$owner],
            teams: [],
            apps: $bypass_apps
          }
        },
        restrictions: {
          users: [],
          teams: [],
          apps: ["graphite-app"]
        },
        allow_force_pushes: false,
        allow_deletions: false
      }')"
  fi

  rp_log_warn "${slug}: applying classic main branch protection (org standard)"
  printf '%s' "$payload" | runner_exec "repo-practices gh put classic protection" \
    -- gh api -X PUT "repos/${slug}/branches/main/protection" --input -
}

