# rp_ruleset_has_github_merge_queue <ruleset_json>
# True when protect-main includes a merge_queue rule (native GitHub MQ).
rp_ruleset_has_github_merge_queue() {
  local -r ruleset_json="${1:-}"
  [[ -n "$ruleset_json" ]] || return 1
  local jq_exit_code=0
  rp_runner_jq_file "repo-practices ruleset has merge_queue" "$ruleset_json" \
    -e '[.rules[]? | select(.type == "merge_queue")] | length > 0' >/dev/null \
    || jq_exit_code=$?
  (( jq_exit_code == 0 ))
}

# rp_github_mq_ruleset_org_compliant <ruleset_json>
# Quiet probe: exit 0 when merge_queue exists with org merge_method + timeout.
# Used by --apply-fix to decide whether to reshape (no FAIL logging).
rp_github_mq_ruleset_org_compliant() {
  local -r ruleset_json="${1:-}"
  local method
  local check_timeout_minutes

  rp_ruleset_has_github_merge_queue "$ruleset_json" || return 1

  method="$(rp_runner_jq_file "repo-practices mq compliant merge_method" "$ruleset_json" \
    -r '[.rules[]? | select(.type == "merge_queue") | .parameters.merge_method // empty] | first // empty')"
  [[ "$method" == "$rp_GITHUB_MQ_MERGE_METHOD" ]] || return 1

  check_timeout_minutes="$(rp_runner_jq_file "repo-practices mq compliant timeout" "$ruleset_json" \
    -r '[.rules[]? | select(.type == "merge_queue") | .parameters.check_response_timeout_minutes // empty] | first // empty')"
  [[ "$check_timeout_minutes" == "$rp_GITHUB_MQ_CHECK_RESPONSE_TIMEOUT_MINUTES" ]] || return 1

  return 0
}

# rp_repo_uses_github_merge_queue <slug>
# Exit 0 when protect-main requires GitHub's merge queue, 1 when it does not,
# 2 when the GitHub API call fails (do not treat as "not GitHub MQ").
rp_repo_uses_github_merge_queue() {
  local -r slug="$1"
  local ruleset_json
  local fetch_exit=0
  set +e
  ruleset_json="$(rp_fetch_protect_main_ruleset "$slug")"
  fetch_exit=$?
  set -e
  if (( fetch_exit == 2 )); then
    return 2
  fi
  if (( fetch_exit != 0 )); then
    return 1
  fi
  rp_ruleset_has_github_merge_queue "$ruleset_json"
}

# Exit 0 when protect-main is required, 1 when not, 2 on GitHub API failure
# (do not treat API errors as "not required").
rp_repo_requires_protect_main_ruleset() {
  local slug="$1"
  local mq_exit=0
  if [[ "$rp_merge_only" -eq 0 ]] && rp_is_strict_repo "$slug"; then
    return 0
  fi
  if rp_repo_has_release_please "$slug"; then
    return 0
  fi
  if rp_repo_has_merge_it_label "$slug"; then
    return 0
  fi
  rp_repo_uses_github_merge_queue "$slug" || mq_exit=$?
  if (( mq_exit == 0 )); then
    return 0
  fi
  if (( mq_exit == 2 )); then
    return 2
  fi
  return 1
}

