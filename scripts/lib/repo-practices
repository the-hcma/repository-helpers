rp_apply_protect_main_squash_methods() {
  local slug="$1"
  local owner name ruleset_id payload
  owner="${slug%%/*}"
  name="${slug#*/}"
  local ruleset_id_raw ruleset_exit_code=0
  set +e
  ruleset_id_raw="$(rp_runner_gh_api_stream "repo-practices patch ruleset id" \
    "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id')"
  ruleset_exit_code=$?
  set -e
  ruleset_id="${ruleset_id_raw//$'\n'/}"
  ruleset_id="$(printf '%s' "$ruleset_id" | head -n1)"
  if (( ruleset_exit_code != 0 )) || [[ -z "$ruleset_id" ]]; then
    rp_apply_protect_main_create "$slug"
    return 0
  fi

  set +e
  payload="$(rp_runner_gh_api_stream "repo-practices fetch ruleset for patch" \
    "repos/${owner}/${name}/rulesets/${ruleset_id}")"
  set -e
  payload="${payload//$'\n'/}"
  payload="$(rp_runner_jq_file "repo-practices patch ruleset payload" "$payload" '
    .rules |= map(
      if .type == "pull_request" then
        .parameters.allowed_merge_methods = ["squash"]
      else .
      end
    )
    | {
        name,
        target,
        enforcement,
        conditions,
        bypass_actors,
        rules
      }
  ')"

  rp_log_warn "${slug}: patching protect-main ruleset ${ruleset_id} (squash-only)"
  rp_runner_gh_api_input "repo-practices gh put protect-main ruleset" "$payload" \
    -X PUT "repos/${owner}/${name}/rulesets/${ruleset_id}"
}

# rp_apply_protect_main_github_mq_shape <slug>
# Ensure protect-main has merge_queue (SQUASH) and no Graphite Integration bypass.
rp_apply_protect_main_github_mq_shape() {
  local slug="$1"
  local owner name ruleset_id payload
  owner="${slug%%/*}"
  name="${slug#*/}"
  local ruleset_id_raw ruleset_exit_code=0
  set +e
  ruleset_id_raw="$(rp_runner_gh_api_stream "repo-practices github-mq ruleset id" \
    "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id')"
  ruleset_exit_code=$?
  set -e
  ruleset_id="${ruleset_id_raw//$'\n'/}"
  ruleset_id="$(printf '%s' "$ruleset_id" | head -n1)"
  if (( ruleset_exit_code != 0 )) || [[ -z "$ruleset_id" ]]; then
    rp_apply_protect_main_create "$slug"
    return 0
  fi

  set +e
  payload="$(rp_runner_gh_api_stream "repo-practices fetch ruleset for github-mq shape" \
    "repos/${owner}/${name}/rulesets/${ruleset_id}")"
  set -e
  payload="${payload//$'\n'/}"
  payload="$(rp_runner_jq_file "repo-practices github-mq ruleset payload" "$payload" \
    --arg method "$rp_GITHUB_MQ_MERGE_METHOD" \
    --argjson timeout "$rp_GITHUB_MQ_CHECK_RESPONSE_TIMEOUT_MINUTES" \
    --argjson graphite_id "$rp_GRAPHITE_APP_ACTOR_ID" '
    .bypass_actors = ((.bypass_actors // []) | map(
      select(.actor_id != $graphite_id or .actor_type != "Integration")
    ))
    | .rules = (
        (.rules // [])
        | map(
            if .type == "pull_request" then
              .parameters.allowed_merge_methods = ["squash"]
            elif .type == "merge_queue" then
              .parameters.merge_method = $method
              | .parameters.max_entries_to_build = (.parameters.max_entries_to_build // 5)
              | .parameters.min_entries_to_merge = (.parameters.min_entries_to_merge // 1)
              | .parameters.max_entries_to_merge = (.parameters.max_entries_to_merge // 5)
              | .parameters.min_entries_to_merge_wait_minutes =
                  (.parameters.min_entries_to_merge_wait_minutes // 0)
              | .parameters.grouping_strategy = (.parameters.grouping_strategy // "ALLGREEN")
              | .parameters.check_response_timeout_minutes = $timeout
            else .
            end
          )
        | if any(.type == "merge_queue") then .
          else . + [{
            type: "merge_queue",
            parameters: {
              merge_method: $method,
              max_entries_to_build: 5,
              min_entries_to_merge: 1,
              max_entries_to_merge: 5,
              min_entries_to_merge_wait_minutes: 0,
              grouping_strategy: "ALLGREEN",
              check_response_timeout_minutes: $timeout
            }
          }]
          end
      )
    | {
        name,
        target,
        enforcement,
        conditions,
        bypass_actors,
        rules
      }
  ')"

  rp_log_warn "${slug}: patching protect-main ruleset ${ruleset_id} (squash-only + GitHub merge queue)"
  rp_runner_gh_api_input "repo-practices gh put protect-main github-mq" "$payload" \
    -X PUT "repos/${owner}/${name}/rulesets/${ruleset_id}"
}

