rp_apply_protect_main_squash_methods() {
  local slug="$1"
  local owner name ruleset_id payload
  owner="${slug%%/*}"
  name="${slug#*/}"
  local ruleset_id_raw ruleset_exit_code=0
  set +e
  ruleset_id_raw="$(rp_runner_gh_api_stream "repo-practices patch ruleset id" \
    "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id')"
  ruleset_exit_code=$?
  set -e
  ruleset_id="${ruleset_id_raw//$'\n'/}"
  ruleset_id="$(printf '%s' "$ruleset_id" | head -n1)"
  if (( ruleset_exit_code != 0 )) || [[ -z "$ruleset_id" ]]; then
    rp_apply_protect_main_create "$slug"
    return 0
  fi

  set +e
  payload="$(rp_runner_exec_stdout "repo-practices fetch ruleset for patch" \
    -- gh api "repos/${owner}/${name}/rulesets/${ruleset_id}")"
  set -e
  payload="${payload//$'\n'/}"
  payload="$(rp_runner_jq_file "repo-practices patch ruleset payload" "$payload" '
    .rules |= map(
      if .type == "pull_request" then
        .parameters.allowed_merge_methods = ["squash"]
      else .
      end
    )
    | {
        name,
        target,
        enforcement,
        conditions,
        bypass_actors,
        rules
      }
  ')"

  rp_log_warn "${slug}: patching protect-main ruleset ${ruleset_id} (squash-only)"
  printf '%s' "$payload" | runner_exec "repo-practices gh put protect-main ruleset" \
    -- gh api -X PUT "repos/${owner}/${name}/rulesets/${ruleset_id}" --input -
}

