      [ ] pnpm-workspace.yaml: minimumReleaseAge: ${release_age_dep_updater_minutes} when using pnpm

    Corepack CI (when pnpm-lock.yaml or web/pnpm-lock.yaml exists):
      [ ] package.json (or web/package.json) has exact "packageManager": "pnpm@X.Y.Z"
      [ ] CI uses the-hcma/repository-helpers/actions/setup-pnpm-corepack after setup-node
          (pin full SHA on main; working-directory: . or web — see actions/setup-pnpm-corepack/README.md)
      [ ] Do not use pnpm/action-setup or setup-node cache: 'pnpm'
      [ ] Path filters / deps-changed gates include .github/workflows/** so adoption PRs run install

    Branch protection (required for GitHub MQ / Release Please / strict onboarding):
      [ ] protect-main ruleset on refs/heads/main (squash-only + merge_queue SQUASH)
      [ ] classic main protection (CODEOWNERS, CI contexts, no Graphite-only push restrictions)

    Release Please (optional):
      [ ] release-please.yml + squash-only repo settings (scripts/github-repo-lint --apply-fix)
      [ ] run scripts/github-repo-lint --repo ${slug} --suggest --strict-onboarding before merge

    Graphite app (manual):
      [ ] Disable this repo in Graphite merge queue settings so Graphite does not also try to land PRs
          (https://app.graphite.com/settings/merge-queue)

    Docs in the service repo:
      [ ] LICENSE with copyright notice
      [ ] CODEOWNERS with * @OWNER so all code requires CODEOWNER review
      [ ] .cursor/rules/git-commit-identity.mdc (no agent/machine co-authors; signing incl. pinentry/passphrase + cli-config attribution; template in ${rp_THIS_REPO_NAME})
      [ ] .cursor/rules/no-secret-exposure.mdc (never leak secrets into logs/PRs/commits; allowlist/existence; rotate if leaked; template in ${rp_THIS_REPO_NAME})
      [ ] .cursor/rules/pr-ship-and-review.mdc (agent review loop; template in ${rp_THIS_REPO_NAME})
      [ ] .cursor/rules/pre-pr-checks.mdc (format before check; no truncated output; template in ${rp_THIS_REPO_NAME})
      [ ] .cursor/rules/read-agents-and-rules.mdc (session-start read AGENTS.md + rules; template in ${rp_THIS_REPO_NAME})
      [ ] .cursor/rules/repo-practices-after-config-change.mdc (run github-repo-lint after config/workflow edits; template in ${rp_THIS_REPO_NAME})
      [ ] .gitignore must not ignore .cursor/rules/ (un-ignore if ignoring other .cursor content)
      [ ] .github/stacking-tool (graphite|gh-stack)
      [ ] .github/secret-audit.json after clean TruffleHog deep scan (scripts/secret-audit --write-marker; docs/secret-audit-trufflehog.md)
      [ ] .cursor/rules/stacking-tool.mdc (thin marker rule; template in ${rp_THIS_REPO_NAME})
      [ ] AGENTS.md + pr-ship submit block match the marker (no leftover Graphite-only gt/merge-it when gh-stack)
      [ ] No root GRAPHITE.md when marker is gh-stack (skill in ${rp_THIS_REPO_NAME} is SSOT)
      [ ] GitHub merge queue / auto-merge flow (AGENTS.md — use gh pr merge --auto --squash, not merge-it)
      [ ] RELEASING.md when using Release Please

CHECKLIST
}

rp_parse_args() {
  local prog="$1"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        rp_usage "$prog"
        exit 0
        ;;
      --org)
        [[ $# -ge 2 ]] || rp_die "--org requires a value"
        rp_org="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || rp_die "--repo requires OWNER/NAME"
        rp_repo_slugs+=("$2")
        shift 2
        ;;
      --apply-fix|--apply)
        rp_apply_fix=1
        shift
        ;;
      --suggest)
        rp_suggest=1
        shift
        ;;
      --new-repo)
        rp_new_repo=1
        rp_strict_onboarding=1
        rp_suggest=1
        shift
        ;;
      --strict-onboarding)
        rp_strict_onboarding=1
        rp_suggest=1
        shift
        ;;
      --compact)
        rp_compact=1
        rp_suggest=1
        shift
        ;;
      --all)
        rp_audit_all=1
        shift
        ;;
      --include-private)
        rp_include_private=1
        shift
        ;;
      --merge-only)
        rp_merge_only=1
        shift
        ;;
      *)
        rp_die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done

  if [[ "${GITHUB_REPO_LINT_INCLUDE_PRIVATE:-0}" == '1' ]]; then
    rp_include_private=1
  fi

  if [[ "$rp_new_repo" -eq 1 ]]; then
    if [[ "${#rp_repo_slugs[@]}" -ne 1 ]]; then
      rp_die "--new-repo requires exactly one --repo OWNER/NAME"
    fi
    return 0
  fi

  if [[ "${#rp_repo_slugs[@]}" -eq 0 ]]; then
    local slug
    if [[ "$rp_audit_all" -eq 0 ]]; then
      slug="$(rp_resolve_git_context_slug || true)"
      if [[ -n "$slug" ]]; then
        rp_repo_slugs+=("$slug")
        return 0
      fi
    fi
    while IFS= read -r slug; do
      [[ -n "$slug" ]] || continue
      rp_repo_slugs+=("$slug")
    done < <(rp_discover_audit_repos "$rp_org")
    if [[ "${#rp_repo_slugs[@]}" -eq 0 ]]; then
      rp_die "No repositories to audit under ${rp_org} (use --all or --repo)"
    fi
  fi
}

rp_validate_repo_settings_json() {
  local slug="$1"
  local settings_json="$2"
  local fail=0
  local v

  v="$(rp_runner_jq_file "repo-practices allow merge commit" "$settings_json" -r '.allow_merge_commit')"
  if [[ "$v" != 'false' ]]; then
    rp_log_fail "${slug}: allow_merge_commit must be false (got ${v})"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: run scripts/github-repo-lint --repo ${slug} --apply-fix (Release Please repos)"
    fi
    fail=1
  fi

  v="$(rp_runner_jq_file "repo-practices allow rebase merge" "$settings_json" -r '.allow_rebase_merge')"
  if [[ "$v" != 'false' ]]; then
    rp_log_fail "${slug}: allow_rebase_merge must be false (got ${v})"
    fail=1
  fi

  v="$(rp_runner_jq_file "repo-practices allow squash merge" "$settings_json" -r '.allow_squash_merge')"
  if [[ "$v" != 'true' ]]; then
    rp_log_fail "${slug}: allow_squash_merge must be true (got ${v})"
    fail=1
  fi

  v="$(rp_runner_jq_file "repo-practices squash merge commit message" "$settings_json" -r '.squash_merge_commit_message')"
  if [[ "$v" != 'BLANK' ]]; then
    rp_log_fail "${slug}: squash_merge_commit_message must be BLANK (got ${v})"
    fail=1
  fi

  v="$(rp_runner_jq_file "repo-practices squash merge commit title" "$settings_json" -r '.squash_merge_commit_title')"
  if [[ "$v" != 'PR_TITLE' ]]; then
    rp_log_fail "${slug}: squash_merge_commit_title must be PR_TITLE (got ${v})"
    fail=1
  fi

  return "$fail"
}

rp_validate_ruleset_methods_json() {
  local slug="$1"
  local methods_json="$2"
  local count methods_line
  local require_exit=0

  count="$(rp_runner_jq_file "repo-practices methods length" "$methods_json" 'length')"
  if [[ "$count" -eq 0 ]]; then
    rp_repo_requires_protect_main_ruleset "$slug" || require_exit=$?
    if (( require_exit == 2 )); then
      rp_log_gh_api_fail "$slug" 'could not determine whether protect-main is required'
      return 1
    fi
    if (( require_exit == 0 )); then
      rp_log_fail "${slug}: missing protect-main ruleset (squash-only merges on main)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add protect-main ruleset (see AGENTS.md) or run --apply-fix"
      fi
      return 1
    fi
    return 0
  fi

  methods_line="$(rp_runner_jq_file "repo-practices methods join" "$methods_json" -r 'join(", ")')"
  local squash_exit_code=0
  rp_runner_jq_file "repo-practices squash-only methods" "$methods_json" \
    -e '.[0] == "squash"' >/dev/null || squash_exit_code=$?
  if [[ "$count" -eq 1 ]] && (( squash_exit_code == 0 )); then
    return 0
  fi

  rp_log_fail "${slug}: protect-main allowed_merge_methods must be [squash] (got: ${methods_line})"
  return 1
}

rp_validate_graphite_bypass_json() {
  # Org default is GitHub merge queue. Leftover Graphite Integration bypass
  # (actor_id 158384) on protect-main is harmless and not required.
  # Keep signature for callers in rp_check_protect_main_ruleset.
  : "${1:-}" "${2:-}"
  return 0
