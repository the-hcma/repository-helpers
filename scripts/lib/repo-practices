# Every updates entry with package-ecosystem must include cooldown.default-days
# matching release_age_dependabot_days (all ecosystems, not npm-only).
rp_dependabot_has_release_age_cooldown() {
  local text="$1"
  local required_days="$release_age_dependabot_days"
  awk -v required_days="$required_days" '
    function finish_item() {
      if (has_ecosystem) {
        saw_entry = 1
        if (!item_cooldown_ok) {
          all_ok = 0
        }
      }
      has_ecosystem = 0
      item_cooldown_ok = 0
      in_cooldown = 0
      cd_indent = -1
    }
    BEGIN {
      in_updates = 0
      in_item = 0
      item_indent = -1
      has_ecosystem = 0
      in_cooldown = 0
      cd_indent = -1
      item_cooldown_ok = 0
      saw_entry = 0
      all_ok = 1
    }
    /^updates:[[:space:]]*$/ { in_updates = 1; next }
    !in_updates { next }
    /^[[:space:]]*-[[:space:]]/ {
      if (in_item) {
        finish_item()
      }
      in_item = 1
      item_indent = match($0, /[^ ]/) - 1
      if ($0 ~ /package-ecosystem:[[:space:]]*/) {
        has_ecosystem = 1
      }
      next
    }
    in_item {
      cur = match($0, /[^ ]/) - 1
      if (cur <= item_indent) {
        finish_item()
        in_item = 0
        next
      }
      if ($0 ~ /^[[:space:]]*package-ecosystem:[[:space:]]*/) {
        has_ecosystem = 1
      }
      if ($0 ~ /^[[:space:]]*cooldown:[[:space:]]*$/) {
        in_cooldown = 1
        cd_indent = match($0, /[^ ]/) - 1
        next
      }
      if (in_cooldown) {
        cur2 = match($0, /[^ ]/) - 1
        if (cur2 <= cd_indent) {
          in_cooldown = 0
          next
        }
        if ($0 ~ /^[[:space:]]*default-days:[[:space:]]*[0-9]+[[:space:]]*$/) {
          line = $0
          sub(/^[[:space:]]*default-days:[[:space:]]*/, "", line)
          sub(/[[:space:]]*$/, "", line)
          if ((line + 0) == required_days) {
            item_cooldown_ok = 1
          }
        }
      }
    }
    END {
      if (in_item) {
        finish_item()
      }
      exit((saw_entry && all_ok) ? 0 : 1)
    }
  ' <<<"$text"
}

