}

rp_check_graphite_merge_queue() {
  local slug="$1"
  local repo_fail=0
  local strict=0
  local labels_json
  local labels_fetch_exit=0
  local merge_it_exit=0

  set +e
  labels_json="$(rp_fetch_repo_labels_json "$slug")"
  labels_fetch_exit=$?
  set -e
  if (( labels_fetch_exit == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not list repository labels'
    rp_log_check_fail "$slug" 'Graphite merge queue setup (GitHub API error; retry)' \
      "$(rp_github_url "$slug" '/tree/main/.github/workflows')"
    return 1
  fi

  merge_it_exit=0
  rp_runner_jq_file "repo-practices merge-it label" "$labels_json" \
    -e 'index("merge-it") != null' >/dev/null || merge_it_exit=$?
  if (( merge_it_exit != 0 )); then
    if [[ "$rp_strict_onboarding" -eq 1 ]] \
      || { [[ "$rp_merge_only" -eq 0 ]] && rp_is_strict_repo "$slug"; }; then
      rp_log_fail "${slug}: merge-it label is required for full org onboarding"
      rp_log_suggest "${slug}: create merge-it label and enable Graphite merge queue on main"
      return 1
    fi
    if [[ "$rp_new_repo" -eq 1 ]]; then
      rp_log_suggest "${slug}: create merge-it label and enable Graphite merge queue on main"
    fi
    return 0
  fi

  if rp_is_strict_repo "$slug"; then
    strict=1
  fi

  if ! rp_validate_graphite_enqueue_labels "$slug" "$labels_json"; then
    repo_fail=1
  fi
  if ! rp_validate_graphite_workflows "$slug" "$strict" "$labels_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'Graphite merge queue GitHub wiring' \
      "$(rp_github_url "$slug" '/tree/main/.github/workflows')"
    rp_log_manual_step \
      'You: enable merge queue on main (squash strategy) in Graphite' \
      'https://app.graphite.com/settings/merge-queue'
  else
    rp_log_check_fail "$slug" 'Graphite merge queue setup (see AGENTS.md and GRAPHITE.md)' \
      "$(rp_github_url "$slug" '/tree/main/.github/workflows')"
    rp_log_manual_step \
      'You: enable merge queue on main (squash strategy) in Graphite' \
      'https://app.graphite.com/settings/merge-queue'
  fi

  return "$repo_fail"
}

