rp_parse_args() {
  local prog="$1"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        rp_usage "$prog"
        exit 0
        ;;
      --org)
        [[ $# -ge 2 ]] || rp_die "--org requires a value"
        rp_org="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || rp_die "--repo requires OWNER/NAME"
        rp_repo_slugs+=("$2")
        shift 2
        ;;
      --apply-fix|--apply)
        rp_apply_fix=1
        shift
        ;;
      --suggest)
        rp_suggest=1
        shift
        ;;
      --new-repo)
        rp_new_repo=1
        rp_strict_onboarding=1
        rp_suggest=1
        shift
        ;;
      --strict-onboarding)
        rp_strict_onboarding=1
        rp_suggest=1
        shift
        ;;
      --compact)
        rp_compact=1
        rp_suggest=1
        shift
        ;;
      --all)
        rp_audit_all=1
        shift
        ;;
      --merge-only)
        rp_merge_only=1
        shift
        ;;
      *)
        rp_die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done

  if [[ "$rp_new_repo" -eq 1 ]]; then
    if [[ "${#rp_repo_slugs[@]}" -ne 1 ]]; then
      rp_die "--new-repo requires exactly one --repo OWNER/NAME"
    fi
    return 0
  fi

  if [[ "${#rp_repo_slugs[@]}" -eq 0 ]]; then
    local slug
    if [[ "$rp_audit_all" -eq 0 ]]; then
      slug="$(rp_resolve_git_context_slug || true)"
      if [[ -n "$slug" ]]; then
        rp_repo_slugs+=("$slug")
        return 0
      fi
    fi
    while IFS= read -r slug; do
      [[ -n "$slug" ]] || continue
      rp_repo_slugs+=("$slug")
    done < <(rp_discover_audit_repos "$rp_org")
    if [[ "${#rp_repo_slugs[@]}" -eq 0 ]]; then
      rp_die "No repositories to audit under ${rp_org} (use --all or --repo)"
    fi
  fi
}

rp_validate_repo_settings_json() {
  local slug="$1"
  local settings_json="$2"
  local fail=0
  local v

  v="$(jq -r '.allow_merge_commit' <<<"$settings_json")"
  if [[ "$v" != 'false' ]]; then
    rp_log_fail "${slug}: allow_merge_commit must be false (got ${v})"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: run scripts/github-repo-lint --repo ${slug} --apply-fix (Release Please repos)"
    fi
    fail=1
  fi

  v="$(jq -r '.allow_rebase_merge' <<<"$settings_json")"
  if [[ "$v" != 'false' ]]; then
    rp_log_fail "${slug}: allow_rebase_merge must be false (got ${v})"
    fail=1
  fi

  v="$(jq -r '.allow_squash_merge' <<<"$settings_json")"
  if [[ "$v" != 'true' ]]; then
    rp_log_fail "${slug}: allow_squash_merge must be true (got ${v})"
    fail=1
  fi

  v="$(jq -r '.squash_merge_commit_message' <<<"$settings_json")"
  if [[ "$v" != 'BLANK' ]]; then
    rp_log_fail "${slug}: squash_merge_commit_message must be BLANK (got ${v})"
    fail=1
  fi

  v="$(jq -r '.squash_merge_commit_title' <<<"$settings_json")"
  if [[ "$v" != 'PR_TITLE' ]]; then
    rp_log_fail "${slug}: squash_merge_commit_title must be PR_TITLE (got ${v})"
    fail=1
  fi

  return "$fail"
}

rp_validate_ruleset_methods_json() {
  local slug="$1"
  local methods_json="$2"
  local count methods_line

  count="$(jq 'length' <<<"$methods_json")"
  if [[ "$count" -eq 0 ]]; then
    if rp_repo_requires_protect_main_ruleset "$slug"; then
      rp_log_fail "${slug}: missing protect-main ruleset (squash-only merges on main)"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add protect-main ruleset (see AGENTS.md) or run --apply-fix"
      fi
      return 1
    fi
    return 0
  fi

  methods_line="$(jq -r 'join(", ")' <<<"$methods_json")"
  if [[ "$count" -eq 1 ]] && jq -e '.[0] == "squash"' >/dev/null <<<"$methods_json"; then
    return 0
  fi

  rp_log_fail "${slug}: protect-main allowed_merge_methods must be [squash] (got: ${methods_line})"
  return 1
}

rp_validate_graphite_bypass_json() {
  local slug="$1"
  local ruleset_json="$2"

  if [[ -z "$ruleset_json" ]]; then
    rp_log_fail "${slug}: protect-main ruleset required (classic branch protection is not sufficient)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: create protect-main ruleset with Graphite App bypass (actor_id ${rp_GRAPHITE_APP_ACTOR_ID})"
    fi
    return 1
  fi

  if jq -e --argjson id "$rp_GRAPHITE_APP_ACTOR_ID" '
    .bypass_actors // []
    | any(
        .actor_id == $id
        and .actor_type == "Integration"
        and (.bypass_mode == "always" or .bypass_mode == "pull_request")
      )
  ' >/dev/null <<<"$ruleset_json"; then
    return 0
  fi

  rp_log_fail "${slug}: protect-main must bypass Graphite App (Integration actor_id ${rp_GRAPHITE_APP_ACTOR_ID})"
  return 1
}

rp_validate_graphite_enqueue_labels() {
  local slug="$1"
  local labels_json="$2"
  local label fail=0

  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    if jq -e --arg name "$label" 'index($name) != null' >/dev/null <<<"$labels_json"; then
      continue
    fi
    rp_log_fail "${slug}: missing Graphite enqueue label '${label}'"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: create GitHub label '${label}' and wire it in Graphite merge queue settings"
    fi
    fail=1
  done < <(rp_expected_enqueue_labels "$labels_json")

  return "$fail"
}

rp_validate_graphite_workflows() {
  local slug="$1"
  local strict="$2"
  local labels_json="$3"
  local fail=0
  local ci_text ci_fixed closer_text dependabot_workflow dependabot_auto_text

  if ! rp_gh_path_exists "$slug" '.github/workflows/merged-pr-closer.yml'; then
    if [[ "$strict" == '1' ]]; then
      rp_log_fail "${slug}: missing .github/workflows/merged-pr-closer.yml"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/merged-pr-closer.yml' \
          "$(rp_candidate_merged_pr_closer_workflow)" \
          'add-merged-pr-closer' \
          'chore: add merged-pr-closer workflow'
      fi
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add merged-pr-closer.yml (closes open PRs already on main via Graphite MQ)"
      fi
      fail=1
    else
      rp_log_warn "${slug}: missing merged-pr-closer.yml (optional for ${rp_THIS_REPO_NAME})"
    fi
  else
    closer_text="$(rp_fetch_github_text_file "$slug" '.github/workflows/merged-pr-closer.yml' || true)"
    if [[ -z "$closer_text" ]] \
      || ! grep -qF 'graphite-app' <<<"$closer_text" \
      || ! grep -qF 'Graphite merge queue' <<<"$closer_text"; then
      rp_log_fail "${slug}: merged-pr-closer.yml must detect graphite-app Graphite merge queue comments"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/merged-pr-closer.yml' \
          "$(rp_candidate_merged_pr_closer_workflow)" \
          'add-merged-pr-closer' \
          'chore: update merged-pr-closer workflow'
      fi
      fail=1
    fi
  fi

  if rp_gh_path_exists "$slug" '.github/workflows/ci.yml'; then
    ci_text="$(rp_fetch_github_text_file "$slug" '.github/workflows/ci.yml' || true)"
    if [[ -z "$ci_text" ]] || ! grep -qF 'gtmq_merge_' <<<"$ci_text"; then
      if [[ "$strict" == '1' ]]; then
        rp_log_fail "${slug}: ci.yml must skip gtmq_merge_* merge-queue staging branches"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add a guard job that sets skip=true when head_ref matches gtmq_merge_*"
        fi
        fail=1
      else
        rp_log_warn "${slug}: ci.yml does not skip gtmq_merge_* (recommended when using Graphite MQ)"
      fi
    fi

    # Stacked PRs: CI must run even when the PR base is not main.
    if rp_ci_workflow_restricts_pr_branches "$ci_text"; then
      rp_log_fail "${slug}: ci.yml restricts pull_request branches; stacked PRs will not run CI"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: remove pull_request.branches filters so CI runs for stacked PR base branches"
      fi
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        ci_fixed="$(rp_fix_ci_workflow_for_stacked_prs "$ci_text")"
        rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
          "$ci_fixed" \
          'fix-ci-stacked-prs' \
          'fix(ci): run CI for stacked PR base branches'
        rp_compact_record_fix "$slug" "${slug}: candidate PR: fix ci.yml pull_request trigger for stacked PRs"
      fi
      fail=1
    fi

    if rp_ci_workflow_has_secret_scan_coverage "$ci_text"; then
      secret_scan_script=""
      secret_scan_script="$(rp_fetch_github_text_file "$slug" '.github/ci/secret-scan' || true)"
      if [[ -z "$secret_scan_script" ]] \
        || ! rp_ci_secret_scan_script_is_canonical "$secret_scan_script" \
        || ! rp_ci_workflow_uses_canonical_secret_scan_invocation "$ci_text" \
        || rp_ci_workflow_has_brittle_gitleaks_install "$ci_text"; then
        rp_log_fail "${slug}: secret-scan must use the canonical scripts/lib/ci-secret-scan install"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add .github/ci/secret-scan from repository-helpers and invoke it from ci.yml"
        fi
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_ci_secret_scan_candidate_fixes "$slug" "$ci_text" 'sync'
        fi
        fail=1
      fi
    elif [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]]; then
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_warn "${slug}: ci.yml has no secret-scan job (optional for ${rp_THIS_REPO_NAME})"
      fi
    else
      rp_log_fail "${slug}: ci.yml must include a secret-scan job"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add .github/ci/secret-scan and a secret-scan job (see scripts/lib/ci-secret-scan)"
      fi
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_ci_secret_scan_candidate_fixes "$slug" "$ci_text" 'add'
      fi
      fail=1
    fi
  elif [[ "$strict" == '1' ]]; then
    rp_log_fail "${slug}: missing .github/workflows/ci.yml"
    fail=1
  fi

  if rp_gh_path_exists "$slug" '.github/dependabot.yml'; then
    dependabot_workflow="$(rp_dependabot_auto_merge_workflow_path "$slug" || true)"
    if [[ -z "$dependabot_workflow" ]]; then
      if [[ "$strict" == '1' ]]; then
        rp_log_fail "${slug}: dependabot.yml present but no dependabot auto-merge workflow"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" '.github/workflows/dependabot-auto-merge.yml' \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: add dependabot auto-merge workflow'
        fi
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add dependabot-auto-merge.yml (labels merge-it for Graphite MQ)"
        fi
        fail=1
      fi
    else
      dependabot_auto_text="$(rp_fetch_github_text_file "$slug" "$dependabot_workflow" || true)"
      if [[ -z "$dependabot_auto_text" ]] || ! grep -qF 'merge-it' <<<"$dependabot_auto_text"; then
        rp_log_fail "${slug}: ${dependabot_workflow} must add merge-it label"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" "$dependabot_workflow" \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: update dependabot auto-merge workflow'
        fi
        fail=1
      fi
      if jq -e 'index("merge-mq") != null' >/dev/null <<<"$labels_json" \
        && ! grep -qF 'merge-mq' <<<"$dependabot_auto_text"; then
        rp_log_fail "${slug}: ${dependabot_workflow} must add merge-mq when merge-mq label exists"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" "$dependabot_workflow" \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: update dependabot auto-merge workflow'
        fi
        fail=1
      fi
    fi
  fi

  return "$fail"
}

