# shellcheck shell=bash
# repo-practices — shared checks for org repository GitHub conventions.
#
# Sourced by scripts/github-repo-lint and scripts/check-merge-settings.
# Do not execute directly.
# shellcheck disable=SC2016  # jq filter and ci.yml marker strings use single quotes

rp_DEFAULT_ORG='the-hcma'
rp_GRAPHITE_APP_ACTOR_ID=158384
rp_GRAPHITE_APP_SLUG='graphite-app'
rp_DEPENDABOT_APP_SLUG='dependabot'
