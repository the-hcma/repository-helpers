# rp_validate_github_merge_queue_ruleset <slug> <ruleset_json>
# When protect-main exists, require a merge_queue rule with squash merge method
# and org-default check_response_timeout_minutes.
rp_validate_github_merge_queue_ruleset() {
  local slug="$1"
  local ruleset_json="$2"
  local method
  local check_timeout_minutes

  if [[ -z "$ruleset_json" ]]; then
    return 0
  fi

  if ! rp_ruleset_has_github_merge_queue "$ruleset_json"; then
    rp_log_fail "${slug}: protect-main must include a merge_queue rule (GitHub merge queue)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: add merge_queue (merge_method ${rp_GITHUB_MQ_MERGE_METHOD}) via --apply-fix"
    fi
    return 1
  fi

  method="$(rp_runner_jq_file "repo-practices merge_queue merge_method" "$ruleset_json" \
    -r '[.rules[]? | select(.type == "merge_queue") | .parameters.merge_method // empty] | first // empty')"
  if [[ "$method" != "$rp_GITHUB_MQ_MERGE_METHOD" ]]; then
    rp_log_fail "${slug}: protect-main merge_queue merge_method must be ${rp_GITHUB_MQ_MERGE_METHOD} (got: ${method:-missing})"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: set protect-main merge_queue parameters.merge_method to ${rp_GITHUB_MQ_MERGE_METHOD}"
    fi
    return 1
  fi

  check_timeout_minutes="$(rp_runner_jq_file "repo-practices merge_queue check_response_timeout" "$ruleset_json" \
    -r '[.rules[]? | select(.type == "merge_queue") | .parameters.check_response_timeout_minutes // empty] | first // empty')"
  if [[ "$check_timeout_minutes" == "$rp_GITHUB_MQ_CHECK_RESPONSE_TIMEOUT_MINUTES" ]]; then
    return 0
  fi

  rp_log_fail \
    "${slug}: protect-main merge_queue check_response_timeout_minutes must be ${rp_GITHUB_MQ_CHECK_RESPONSE_TIMEOUT_MINUTES} (got: ${check_timeout_minutes:-missing})"
  if [[ "$rp_suggest" -eq 1 ]]; then
    rp_log_suggest \
      "${slug}: set protect-main merge_queue check_response_timeout_minutes to ${rp_GITHUB_MQ_CHECK_RESPONSE_TIMEOUT_MINUTES} via --apply-fix"
  fi
  return 1
}

rp_validate_graphite_enqueue_labels() {
  local slug="$1"
  local labels_json="$2"
  local label fail=0

  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    local label_exit_code=0
    rp_runner_jq_file "repo-practices enqueue label ${label}" "$labels_json" \
      --arg name "$label" -e 'index($name) != null' >/dev/null || label_exit_code=$?
    if (( label_exit_code == 0 )); then
      continue
    fi
    rp_log_fail "${slug}: missing Graphite enqueue label '${label}'"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: create GitHub label '${label}' and wire it in Graphite merge queue settings"
    fi
    fail=1
  done < <(rp_expected_enqueue_labels "$labels_json")

  return "$fail"
}

rp_validate_graphite_workflows() {
  local slug="$1"
  local strict="$2"
  local labels_json="$3"
  local fail=0
  local ci_text ci_fixed closer_text dependabot_workflow dependabot_auto_text
  local path_ec=0
  local fetch_ec=0
  local secret_scan_script

  path_ec=0
  rp_gh_path_check "$slug" '.github/workflows/merged-pr-closer.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/workflows/merged-pr-closer.yml'
    fail=1
  elif (( path_ec == 1 )); then
    if [[ "$strict" == '1' ]]; then
      rp_log_fail "${slug}: missing .github/workflows/merged-pr-closer.yml"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/merged-pr-closer.yml' \
          "$(rp_candidate_merged_pr_closer_workflow)" \
          'add-merged-pr-closer' \
          'chore: add merged-pr-closer workflow'
      fi
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: add merged-pr-closer.yml (closes merged PRs and stale Graphite MQ draft group PRs)"
      fi
      fail=1
    else
      rp_log_warn "${slug}: missing merged-pr-closer.yml (optional for ${rp_THIS_REPO_NAME})"
    fi
  else
    fetch_ec=0
    closer_text="$(rp_fetch_github_text_file "$slug" \
      '.github/workflows/merged-pr-closer.yml')" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" 'could not read .github/workflows/merged-pr-closer.yml'
      fail=1
    elif [[ -z "$closer_text" ]] \
      || ! grep -qF "${rp_GRAPHITE_APP_SLUG}" <<<"$closer_text" \
      || ! grep -qF 'Graphite merge queue' <<<"$closer_text"; then
      rp_log_fail "${slug}: merged-pr-closer.yml must detect ${rp_GRAPHITE_APP_SLUG} Graphite merge queue comments"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/merged-pr-closer.yml' \
          "$(rp_candidate_merged_pr_closer_workflow)" \
          'add-merged-pr-closer' \
          'chore: update merged-pr-closer workflow'
      fi
      fail=1
    elif [[ "$strict" == '1' ]] \
      && { ! rp_merged_pr_closer_workflow_has_push_to_main_trigger "$closer_text" \
        || ! rp_merged_pr_closer_workflow_has_mq_draft_cleanup "$closer_text" \
        || ! rp_merged_pr_closer_workflow_deletes_head_branch "$closer_text"; }; then
      rp_log_fail "${slug}: merged-pr-closer.yml must run on main push, close stale Graphite MQ drafts, and delete head branches"
      if [[ "$rp_apply_fix" -eq 1 ]]; then
        rp_queue_candidate_file_fix "$slug" '.github/workflows/merged-pr-closer.yml' \
          "$(rp_candidate_merged_pr_closer_workflow)" \
          'update-merged-pr-closer-mq-draft' \
          'chore: update merged-pr-closer for stale Graphite MQ drafts'
      fi
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: sync merged-pr-closer.yml from scripts/lib/repo-practices-workflows"
      fi
      fail=1
    fi
  fi

  path_ec=0
  rp_gh_path_check "$slug" '.github/workflows/ci.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/workflows/ci.yml'
    fail=1
  elif (( path_ec == 0 )); then
    fetch_ec=0
    ci_text="$(rp_fetch_github_text_file "$slug" '.github/workflows/ci.yml')" || fetch_ec=$?
    if (( fetch_ec == 2 )); then
      rp_log_gh_api_fail "$slug" 'could not read .github/workflows/ci.yml'
      fail=1
      ci_text=""
    elif [[ -z "$ci_text" ]] || ! grep -qF 'gtmq_merge_' <<<"$ci_text"; then
      if [[ "$strict" == '1' ]]; then
        rp_log_fail "${slug}: ci.yml must skip gtmq_merge_* merge-queue staging branches"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add a guard job that sets skip=true when head_ref matches gtmq_merge_*"
        fi
        fail=1
      else
        rp_log_warn "${slug}: ci.yml does not skip gtmq_merge_* (recommended when using Graphite MQ)"
      fi
    fi

    if [[ -n "${ci_text:-}" ]]; then
      # Stacked PRs: CI must run even when the PR base is not main.
      if rp_ci_workflow_restricts_pr_branches "$ci_text"; then
        rp_log_fail "${slug}: ci.yml restricts pull_request branches; stacked PRs will not run CI"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: remove pull_request.branches filters so CI runs for stacked PR base branches"
        fi
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          ci_fixed="$(rp_fix_ci_workflow_for_stacked_prs "$ci_text")"
          rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
            "$ci_fixed" \
            'fix-ci-stacked-prs' \
            'fix(ci): run CI for stacked PR base branches'
          rp_compact_record_fix "$slug" "${slug}: candidate PR: fix ci.yml pull_request trigger for stacked PRs"
        fi
        fail=1
      fi

      if rp_ci_workflow_needs_graphite_restack_trigger_fix "$ci_text"; then
        rp_log_fail \
          "${slug}: ci.yml lacks full Graphite restack CI coverage (feature-branch push, guard push dedup with pull-requests read, pull_request edited type)"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest \
            "${slug}: sync ci.yml Graphite restack triggers (scripts/github-repo-lint --apply-fix)"
        fi
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
            "$(rp_fix_ci_workflow_hardening "$ci_text")" \
            'sync-graphite-restack-ci-v3' \
            'fix(ci): harden guard push-dedup gh pr list fallback'
          rp_compact_record_fix "$slug" \
            "${slug}: candidate PR: harden Graphite restack guard push dedup"
        fi
        fail=1
      fi

      if ! rp_ci_workflow_has_hardened_concurrency "$ci_text"; then
        rp_log_fail \
          "${slug}: ci.yml concurrency must key on head SHA (avoids zombie secret-scan checks)"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: sync ci.yml concurrency (scripts/github-repo-lint --apply-fix)"
        fi
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" '.github/workflows/ci.yml' \
            "$(rp_fix_ci_workflow_hardening "$ci_text")" \
            'sync-ci-concurrency' \
            'fix(ci): key CI concurrency on head SHA'
          rp_compact_record_fix "$slug" "${slug}: candidate PR: harden ci.yml concurrency and secret-scan"
        fi
        fail=1
      fi

      if rp_ci_workflow_has_secret_scan_coverage "$ci_text"; then
        secret_scan_script=""
        fetch_ec=0
        secret_scan_script="$(rp_fetch_github_text_file "$slug" '.github/ci/secret-scan')" \
          || fetch_ec=$?
        if (( fetch_ec == 2 )); then
          rp_log_gh_api_fail "$slug" 'could not read .github/ci/secret-scan'
          fail=1
        elif ! rp_ci_secret_scan_install_report_drift "$slug" "$secret_scan_script" "$ci_text"; then
          if [[ "$rp_apply_fix" -eq 1 ]]; then
            rp_queue_ci_secret_scan_candidate_fixes "$slug" "$ci_text" 'sync'
          fi
          fail=1
        fi
      elif [[ "$(rp_repo_short_name "$slug")" == "$rp_THIS_REPO_NAME" ]]; then
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_warn "${slug}: ci.yml has no secret-scan job (optional for ${rp_THIS_REPO_NAME})"
        fi
      else
        rp_log_fail "${slug}: ci.yml must include a secret-scan job"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add .github/ci/secret-scan and a secret-scan job (see scripts/lib/ci-secret-scan)"
        fi
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_ci_secret_scan_candidate_fixes "$slug" "$ci_text" 'add'
        fi
        fail=1
      fi
    fi
  elif [[ "$strict" == '1' ]]; then
    rp_log_fail "${slug}: missing .github/workflows/ci.yml"
    fail=1
  fi

  path_ec=0
  rp_gh_path_check "$slug" '.github/dependabot.yml' || path_ec=$?
  if (( path_ec == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read .github/dependabot.yml'
    fail=1
  elif (( path_ec == 0 )); then
    dependabot_workflow="$(rp_dependabot_auto_merge_workflow_path "$slug" || true)"
    if [[ -z "$dependabot_workflow" ]]; then
      if [[ "$strict" == '1' ]]; then
        rp_log_fail "${slug}: dependabot.yml present but no dependabot auto-merge workflow"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" '.github/workflows/dependabot-auto-merge.yml' \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: add dependabot auto-merge workflow'
        fi
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add dependabot-auto-merge.yml (gh pr merge --auto --squash for GitHub MQ)"
        fi
        fail=1
      fi
    else
      fetch_ec=0
      dependabot_auto_text="$(rp_fetch_github_text_file "$slug" "$dependabot_workflow")" \
        || fetch_ec=$?
      if (( fetch_ec == 2 )); then
        rp_log_gh_api_fail "$slug" "could not read ${dependabot_workflow}"
        fail=1
      elif [[ -z "$dependabot_auto_text" ]] \
        || ! grep -qF 'gh pr merge' <<<"$dependabot_auto_text" \
        || ! grep -qF -- '--auto' <<<"$dependabot_auto_text"; then
        rp_log_fail "${slug}: ${dependabot_workflow} must enable auto-merge via gh pr merge --auto"
        if [[ "$rp_apply_fix" -eq 1 ]]; then
          rp_queue_candidate_file_fix "$slug" "$dependabot_workflow" \
            "$(rp_candidate_dependabot_auto_merge_workflow)" \
            'add-dependabot-auto-merge' \
            'chore: update dependabot auto-merge workflow'
        fi
        fail=1
      fi
    fi
  fi

  return "$fail"
}

