      'fix(ci): harden secret-scan job and CI concurrency'
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: sync secret-scan script and ci.yml job"
  else
    rp_compact_record_fix "$slug" \
      "${slug}: candidate PR: sync secret-scan script"
  fi
}

rp_queue_candidate_file_fix() {
  local slug="$1"
  local path="$2"
  local content="$3"
  local branch_suffix="$4"
  local message="$5"
  local key

  if [[ "$path" == /* || "$path" == *'..'* ]]; then
    rp_die "internal error: unsafe candidate fix path: ${path}"
  fi

  key="${slug}|${path}"
  if [[ -n "${rp_candidate_fix_seen[$key]:-}" ]]; then
    return 0
  fi
  rp_candidate_fix_seen[$key]=1
  rp_candidate_fix_keys+=("$key")
  rp_candidate_fix_paths[$key]="$path"
  rp_candidate_fix_contents[$key]="$content"
  rp_candidate_fix_branch_suffixes[$key]="$branch_suffix"
  rp_candidate_fix_messages[$key]="$message"
}

rp_git_remote_slug_for_dir() {
  local repo_dir="$1"
  local remote_url

  local remote_exit_code=0
  set +e
  remote_url="$(rp_runner_exec_stdout "repo-practices git remote get-url origin" \
    -- git -C "$repo_dir" remote get-url origin)"
  remote_exit_code=$?
  set -e
  remote_url="${remote_url//$'\n'/}"
  if (( remote_exit_code != 0 )) || [[ -z "$remote_url" ]]; then
    return 1
  fi
  gh_slug_from_origin_url "$remote_url"
}

# Primary clone for this lib (not a linked worktree under .worktrees/).
rp_helpers_primary_checkout_dir() {
  local helpers_root primary_dir quoted_root porcelain line exit_code=0

  helpers_root="$(cd "${rp_lib_dir}/../.." && pwd)"
  quoted_root="$(printf '%q' "$helpers_root")"
  porcelain=""
  set +e
  porcelain="$(runner_sh_stdout "repo-practices primary worktree" -- \
    "git -C ${quoted_root} worktree list --porcelain")"
  exit_code=$?
  set -e
  primary_dir=""
  if (( exit_code == 0 )) && [[ -n "$porcelain" ]]; then
    while IFS= read -r line; do
      if [[ "$line" == worktree\ * ]]; then
        primary_dir="${line#worktree }"
        break
      fi
    done <<<"$porcelain"
  fi
  if [[ -n "$primary_dir" ]]; then
    printf '%s\n' "$primary_dir"
    return 0
  fi
  printf '%s\n' "$helpers_root"
}

# Index sibling clones under the scan root once per process (slug → checkout).
rp_index_scan_root_clones() {
  local root entry entry_name entry_real top entry_slug resolved exit_code=0

  if [[ "${rp_scan_root_clone_index_ready}" -eq 1 ]]; then
    return 0
  fi
  rp_scan_root_clone_index_ready=1

  root="$(rp_local_repo_scan_root || true)"
  [[ -n "$root" ]] || return 0

  for entry in "${root}"/*; do
    [[ -e "$entry" ]] || continue
    [[ -d "$entry" ]] || continue
    entry_name="${entry##*/}"
    [[ "$entry_name" == .* ]] && continue

    top=""
    set +e
    top="$(rp_runner_exec_stdout "repo-practices git show-toplevel scan" \
      -- git -C "$entry" rev-parse --show-toplevel)"
    exit_code=$?
    set -e
    top="${top//$'\n'/}"
    if (( exit_code != 0 )) || [[ -z "$top" ]]; then
      continue
    fi
    resolved=""
    set +e
    resolved="$(runner_exec_stdout "repo-practices realpath scan entry" -- realpath "$top")"
    exit_code=$?
    set -e
    resolved="${resolved//$'\n'/}"
    if (( exit_code != 0 )) || [[ -z "$resolved" ]]; then
      continue
    fi
    set +e
    entry_real="$(runner_exec_stdout "repo-practices realpath scan dir" -- realpath "$entry")"
    exit_code=$?
    set -e
    entry_real="${entry_real//$'\n'/}"
    if (( exit_code != 0 )) || [[ "$resolved" != "$entry_real" ]]; then
      continue
    fi

    entry_slug="$(rp_git_remote_slug_for_dir "$resolved" || true)"
    if [[ -n "$entry_slug" ]]; then
      rp_scan_root_clone_dirs["$entry_slug"]="$resolved"
    fi
  done
}

# Parent directory of sibling git clones (enforcer default: repository-helpers/..).
rp_local_repo_scan_root() {
  local root helpers_root resolved exit_code=0

  root="${GITHUB_REPO_LINT_SCAN_ROOT:-}"
  if [[ -z "$root" ]]; then
    helpers_root="$(rp_helpers_primary_checkout_dir)"
    root="${helpers_root}/.."
  fi
  resolved=""
  set +e
  resolved="$(runner_exec_stdout "repo-practices realpath scan root" -- realpath "$root")"
  exit_code=$?
  set -e
  resolved="${resolved//$'\n'/}"
  if (( exit_code != 0 )) || [[ -z "$resolved" ]] || [[ ! -d "$resolved" ]]; then
    return 1
  fi
  printf '%s\n' "$resolved"
}

# Resolve a local clone under GITHUB_REPO_LINT_SCAN_ROOT (or repository-helpers/..).
rp_resolve_local_repo_dir_from_scan_root() {
  local slug="$1"

  rp_index_scan_root_clones
  if [[ -n "${rp_scan_root_clone_dirs[$slug]:-}" ]]; then
    printf '%s\n' "${rp_scan_root_clone_dirs[$slug]}"
    return 0
  fi
  return 1
}

rp_resolve_local_repo_dir() {
  local slug="$1"
  local repo_root repo_slug
  local git_exit_code=0

  repo_root=""
  set +e
  repo_root="$(rp_runner_exec_stdout "repo-practices git rev-parse show-toplevel local" \
    -- git rev-parse --show-toplevel)"
  git_exit_code=$?
  set -e
  repo_root="${repo_root//$'\n'/}"
  if (( git_exit_code == 0 )) && [[ -n "$repo_root" ]]; then
    repo_slug="$(rp_git_remote_slug_for_dir "$repo_root" || true)"
    if [[ "$repo_slug" == "$slug" ]]; then
      printf '%s\n' "$repo_root"
      return 0
    fi
  fi

  rp_resolve_local_repo_dir_from_scan_root "$slug"
}

# True for single-file candidate fixes that can land via the GitHub Contents API.
rp_candidate_fix_path_is_api_eligible() {
  local -r path="$1"

  [[ "$path" == .cursor/rules/* ]] && return 0
  [[ "$path" == '.github/stacking-tool' ]] && return 0
  [[ "$path" == '.github/secret-audit.json' ]] && return 0
  return 1
}

# Create or update one file on a branch and open a PR (no local clone required).
rp_apply_file_pr_via_api() {
  local slug="$1"
  local path="$2"
  local content="$3"
  local branch_name="$4"
  local message="$5"
  local title="$6"
  local body="$7"
  local default_branch base_sha pr_url encoded_content existing_sha existing_ref_sha
  local quoted_content
  local ref_exit_code=0 pr_list_exit_code=0 existing_exit_code=0
  local default_exit_code=0 base_sha_exit_code=0 encode_exit_code=0
  local create_ref_exit_code=0 delete_exit_code=0 put_exit_code=0 create_pr_exit_code=0
  local existing_ref_sha_exit_code=0
  local -a put_args=()

  default_branch=""
  set +e
  default_branch="$(rp_runner_gh_api_stream "repo-practices file-pr default branch" "repos/${slug}" \
    --jq '.default_branch // "main"')"
  default_exit_code=$?
  set -e
  default_branch="${default_branch//$'\n'/}"
  if (( default_exit_code != 0 )) || [[ -z "$default_branch" ]]; then
    rp_log_warn "${slug}: failed to read default branch for API file PR (${path})"
    return 1
  fi

  base_sha=""
  set +e
  base_sha="$(rp_runner_gh_api_stream "repo-practices file-pr base sha" \
    "repos/${slug}/git/ref/heads/${default_branch}" --jq '.object.sha')"
  base_sha_exit_code=$?
  set -e
  base_sha="${base_sha//$'\n'/}"
  if (( base_sha_exit_code != 0 )) || [[ -z "$base_sha" ]]; then
    rp_log_warn "${slug}: failed to read ${default_branch} SHA for API file PR (${path})"
    return 1
  fi

  set +e
  pr_url="$(rp_runner_exec_stdout "repo-practices gh pr list file fix" \
    -- gh pr list --repo "$slug" --head "$branch_name" --state open --json url \
      --jq '.[0].url // empty')"
  pr_list_exit_code=$?
  set -e
  pr_url="${pr_url//$'\n'/}"
  if (( pr_list_exit_code != 0 )); then
    pr_url=""
  fi
  if [[ -n "$pr_url" ]]; then
    rp_log_warn "${slug}: candidate file PR already exists: ${pr_url}"
    return 0
  fi

  ref_exit_code=0
  rp_runner_gh_api_stream "repo-practices gh ref heads file fix branch" --probe \
    "repos/${slug}/git/ref/heads/${branch_name}" >/dev/null || ref_exit_code=$?
  if (( ref_exit_code == 0 )); then
    existing_ref_sha=""
    set +e
    existing_ref_sha="$(rp_runner_gh_api_stream "repo-practices file-pr existing ref sha" \
      "repos/${slug}/git/ref/heads/${branch_name}" --jq '.object.sha')"
    existing_ref_sha_exit_code=$?
    set -e
    existing_ref_sha="${existing_ref_sha//$'\n'/}"
    if (( existing_ref_sha_exit_code != 0 )) || [[ -z "$existing_ref_sha" ]]; then
      rp_log_warn "${slug}: failed to read existing ${branch_name} SHA for ${path}"
      return 1
    fi
    if [[ "$existing_ref_sha" != "$base_sha" ]]; then
      delete_exit_code=0
      rp_runner_gh_api_stream "repo-practices gh delete stale file fix ref" \
        -X DELETE "repos/${slug}/git/refs/heads/${branch_name}" \
        >/dev/null || delete_exit_code=$?
      if (( delete_exit_code != 0 )); then
        rp_log_warn "${slug}: failed to replace stale branch ${branch_name} for ${path}"
        return 1
      fi
      ref_exit_code=1
    fi
  fi
  if (( ref_exit_code != 0 )); then
    create_ref_exit_code=0
    rp_runner_gh_api_stream "repo-practices gh create file fix ref" \
      -X POST "repos/${slug}/git/refs" \
        -f "ref=refs/heads/${branch_name}" \
        -f "sha=${base_sha}" >/dev/null || create_ref_exit_code=$?
    if (( create_ref_exit_code != 0 )); then
      rp_log_warn "${slug}: failed to create branch ${branch_name} for ${path}"
      return 1
    fi
  fi

  quoted_content="$(printf '%q' "$content")"
  encoded_content=""
  set +e
  encoded_content="$(runner_sh_stdout "repo-practices file-pr base64" -- \
    "printf '%s' ${quoted_content} | base64 | tr -d '\\n'")"
  encode_exit_code=$?
  set -e
  encoded_content="${encoded_content//$'\n'/}"
  if (( encode_exit_code != 0 )) || [[ -z "$encoded_content" ]]; then
    rp_log_warn "${slug}: failed to encode ${path} for API file PR"
    return 1
  fi
  existing_sha=""
  set +e
  existing_sha="$(rp_runner_gh_api_stream "repo-practices gh file fix sha" --probe \
    "repos/${slug}/contents/${path}?ref=${branch_name}" --jq '.sha')"
  existing_exit_code=$?
  set -e
  existing_sha="${existing_sha//$'\n'/}"
  if (( existing_exit_code != 0 )); then
    existing_sha=""
  fi

  put_args=(
    -X PUT
    "repos/${slug}/contents/${path}"
    -f "message=${message}"
    -f "content=${encoded_content}"
    -f "branch=${branch_name}"
  )
  if [[ -n "$existing_sha" ]]; then
    put_args+=(-f "sha=${existing_sha}")
  fi
  put_exit_code=0
  rp_runner_gh_api_stream "repo-practices gh put file fix" "${put_args[@]}" \
    >/dev/null || put_exit_code=$?
  if (( put_exit_code != 0 )); then
    rp_log_warn "${slug}: failed to write ${path} via Contents API"
    return 1
  fi

  pr_url=""
  set +e
  pr_url="$(rp_runner_exec_stdout "repo-practices gh pr create file fix" \
    -- gh pr create \
      --repo "$slug" \
      --head "$branch_name" \
      --base "$default_branch" \
      --title "$title" \
      --body "$body")"
  create_pr_exit_code=$?
  set -e
  pr_url="${pr_url//$'\n'/}"
  if (( create_pr_exit_code != 0 )) || [[ -z "$pr_url" ]]; then
    rp_log_warn "${slug}: failed to open candidate file PR for ${path}"
    return 1
  fi
  rp_log_warn "${slug}: created candidate file PR: ${pr_url}"
}

# Apply API-eligible queued fixes when no local clone is available.
rp_apply_candidate_fixes_via_api() {
  local slug="$1"
  local key key_slug path content branch_suffix message branch_name title body
  local applied=0 skipped_ineligible=0 apply_exit_code=0

  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    [[ "$key_slug" == "$slug" ]] || continue
    path="${rp_candidate_fix_paths[$key]}"
    if ! rp_candidate_fix_path_is_api_eligible "$path"; then
      rp_log_warn "${slug}: candidate fix ${path} requires a local clone (not API-eligible)"
      skipped_ineligible=1
      continue
    fi
    content="${rp_candidate_fix_contents[$key]}"
    branch_suffix="${rp_candidate_fix_branch_suffixes[$key]}"
    message="${rp_candidate_fix_messages[$key]}"
    branch_name="repo-practices/${branch_suffix}"
    title="$message"
    body="$(cat <<EOF
## Summary
- Repository-practices remediation for \`${path}\`.

## Test plan
- Org cursor-rule / practices template sync only.
EOF
)"
    apply_exit_code=0
    rp_apply_file_pr_via_api "$slug" "$path" "$content" "$branch_name" \
      "$message" "$title" "$body" || apply_exit_code=$?
    if (( apply_exit_code != 0 )); then
      continue
    fi
    applied=1
  done

  if [[ "$applied" -eq 1 && "$skipped_ineligible" -eq 0 ]]; then
    return 0
  fi
  return 1
}

readonly rp_cursor_rules_gitignore_probe_path='.cursor/rules/pr-ship-and-review.mdc'

# True when gitignore text would ignore .cursor/rules/ without !.cursor/rules/ and !.cursor/rules/**.
rp_gitignore_text_blocks_cursor_rules() {
  local text="$1"

  [[ -n "$text" ]] || return 1
  if grep -qE '^/?\.cursor/rules(/|\*|$)|^/?\.cursor/rules/\*\*' <<<"$text"; then
    return 0
  fi
  if ! grep -qE '^/?\.cursor(/$|/\*$|$)' <<<"$text"; then
    return 1
  fi
  if grep -qF '!.cursor/rules/' <<<"$text" && grep -qF '!.cursor/rules/**' <<<"$text"; then
    return 1
  fi
  return 0
}

rp_check_cursor_rules_gitignore() {
  local slug="$1"
  local repo_fail=0
  local repo_dir gitignore_text

  if repo_dir="$(rp_resolve_local_repo_dir "$slug" 2>/dev/null)"; then
    local ignore_exit_code=0
    runner_exec "repo-practices git check-ignore cursor rules" --probe \
      -- git -C "$repo_dir" check-ignore --no-index -q "$rp_cursor_rules_gitignore_probe_path" \
      || ignore_exit_code=$?
    if (( ignore_exit_code == 0 )); then
      repo_fail=1
      rp_log_check_fail "$slug" \
        '.gitignore must not ignore .cursor/rules/ (org cursor rules must be trackable)' \
        "$(rp_github_url "$slug" '/blob/main/.gitignore')"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest \
          "${slug}: un-ignore .cursor/rules/ in .gitignore (e.g. .cursor/* with !.cursor/rules/ and !.cursor/rules/**)"
      fi
    else
      rp_log_check_ok "$slug" '.cursor/rules/ is trackable in .gitignore' \
        "$(rp_github_url "$slug" '/blob/main/.gitignore')"
    fi
    return "$repo_fail"
  fi

  gitignore_text="$(rp_fetch_github_text_file "$slug" ".gitignore" || true)"
  if [[ -z "$gitignore_text" ]]; then
    rp_log_check_ok "$slug" '.cursor/rules/ is trackable (.gitignore absent or no block)' \
      "$(rp_github_url "$slug" '/blob/main/.gitignore')"
    return 0
  fi
  if rp_gitignore_text_blocks_cursor_rules "$gitignore_text"; then
    repo_fail=1
    rp_log_check_fail "$slug" \
      '.gitignore must not ignore .cursor/rules/ (org cursor rules must be trackable)' \
      "$(rp_github_url "$slug" '/blob/main/.gitignore')"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: un-ignore .cursor/rules/ in .gitignore (e.g. .cursor/* with !.cursor/rules/ and !.cursor/rules/**)"
    fi
  else
    rp_log_check_ok "$slug" '.cursor/rules/ is trackable in .gitignore' \
      "$(rp_github_url "$slug" '/blob/main/.gitignore')"
  fi

  return "$repo_fail"
}

rp_candidate_branch_has_path() {
  local -r worktree_path="$1"
  local -r branch="$2"
  local -r path="$3"
  local exit_code=0

  runner_exec "repo-practices git show candidate path" \
    -- git -C "$worktree_path" show "${branch}:${path}" || exit_code=$?
  (( exit_code == 0 ))
}

rp_candidate_worktree_path() {
  local repo_dir="$1"
  local primary_dir wt_list wt_exit_code=0

  wt_list=""
  set +e
  rp_runner_git_stream "repo-practices git worktree list porcelain" \
    -C "$repo_dir" worktree list --porcelain >/dev/null
  wt_exit_code=$?
  set -e
  wt_list="$(rp_runner_last_stdout)"
  if (( wt_exit_code != 0 )) || [[ -z "$wt_list" ]]; then
    return 1
  fi
  primary_dir="$(printf '%s' "$wt_list" | awk 'NR == 1 { print $2; exit }')"
  if [[ -z "$primary_dir" ]]; then
    return 1
  fi
  printf '%s\n' "${primary_dir}/.worktrees/repo-practices-candidate-fixes-wt"
}

rp_prepare_candidate_worktree() {
  local repo_dir="$1"
  local default_branch="$2"
  local worktree_path worktrees_dir status

  worktree_path="$(rp_candidate_worktree_path "$repo_dir")"
  worktrees_dir="$(dirname "$worktree_path")"
  mkdir -p "$worktrees_dir"

  if [[ -d "$worktree_path" ]]; then
    status=""
    set +e
    status="$(rp_runner_exec_stdout "repo-practices git status porcelain candidate" \
      -- git -C "$worktree_path" status --porcelain)"
    set -e
    status="${status//$'\n'/}"
    if [[ -n "$status" ]]; then
      rp_die "candidate fix worktree has local changes: ${worktree_path}"
    fi
    printf '%s\n' "$worktree_path"
    return 0
  fi

  local wt_list

  runner_exec "repo-practices git worktree prune" \
    -- git -C "$repo_dir" worktree prune || true
  wt_list=""
  set +e
  rp_runner_git_stream "repo-practices git worktree list check" \
    -C "$repo_dir" worktree list --porcelain >/dev/null
  set -e
  wt_list="$(rp_runner_last_stdout)"
  if grep -qF "worktree ${worktree_path}" <<<"$wt_list"; then
    runner_exec "repo-practices git worktree remove" \
      -- git -C "$repo_dir" worktree remove --force "$worktree_path" || true
  fi
  rm -rf "$worktree_path"

  runner_exec "repo-practices git fetch origin" \
    -- git -C "$repo_dir" fetch --prune origin
  runner_exec "repo-practices git worktree add" \
    -- git -C "$repo_dir" worktree add --detach "$worktree_path" "origin/${default_branch}"
  printf '%s\n' "$worktree_path"
}

rp_apply_candidate_fix_stack() {
  local slug="$1"
  local repo_dir default_branch worktree_path key key_slug path content branch_suffix message
  local branch parent_branch parent_ref created_any has_candidate path_dir status
  local stacking_tool show_ref_exit_code diff_exit_code quoted_wt quoted_branches
  local -a created_branches=()

  if [[ "$rp_apply_fix" -ne 1 ]]; then
    return 0
  fi

  has_candidate=0
  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    if [[ "$key_slug" == "$slug" ]]; then
      has_candidate=1
      break
    fi
  done
  if [[ "$has_candidate" -eq 0 ]]; then
    return 0
  fi

  created_any=0
  if ! repo_dir="$(rp_resolve_local_repo_dir "$slug")"; then
    if rp_apply_candidate_fixes_via_api "$slug"; then
      return 0
    fi
    rp_log_warn "${slug}: candidate workflow PRs require running --apply-fix from the local clone"
    return 0
  fi

  # Match the marker content we would write for this slug (this-repo → gh-stack
  # trial default; consumers → local marker or org Graphite default).
  stacking_tool="$(rp_stacking_tool_marker_content_for_apply_fix "$slug")"

  default_branch="$(rp_runner_gh_api_stream "repo-practices default branch" "repos/${slug}" --jq '.default_branch // "main"')"
  worktree_path="$(rp_prepare_candidate_worktree "$repo_dir" "$default_branch")"
  parent_branch="$default_branch"
  parent_ref="origin/${default_branch}"

  for key in "${rp_candidate_fix_keys[@]}"; do
    key_slug="${key%%|*}"
    [[ "$key_slug" == "$slug" ]] || continue
    path="${rp_candidate_fix_paths[$key]}"
    content="${rp_candidate_fix_contents[$key]}"
    branch_suffix="${rp_candidate_fix_branch_suffixes[$key]}"
    message="${rp_candidate_fix_messages[$key]}"
    branch="repo-practices/${branch_suffix}"

    show_ref_exit_code=0
    runner_exec "repo-practices git show-ref branch" \
      -- git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${branch}" \
      || show_ref_exit_code=$?
    if (( show_ref_exit_code == 0 )); then
      if rp_candidate_branch_has_path "$worktree_path" "$branch" "$path"; then
        rp_log_warn "${slug}: candidate branch already exists, skipping ${branch}"
        parent_branch="$branch"
        parent_ref="$branch"
        continue
      fi
      rp_log_warn "${slug}: stale candidate branch ${branch} missing ${path}; recreating"
      runner_exec "repo-practices git branch delete stale" \
        -- git -C "$worktree_path" branch -D "$branch"
    fi

    runner_exec "repo-practices git checkout candidate branch" \
      -- git -C "$worktree_path" checkout -B "$branch" "$parent_ref"
    path_dir="$(dirname "${worktree_path}/${path}")"
    mkdir -p "$path_dir"
    printf '%s\n' "$content" >"${worktree_path}/${path}"
    runner_exec "repo-practices git add candidate path" \
      -- git -C "$worktree_path" add "$path"
    diff_exit_code=0
    runner_exec "repo-practices git diff cached quiet" \
      -- git -C "$worktree_path" diff --cached --quiet || diff_exit_code=$?
    if (( diff_exit_code == 0 )); then
      rp_log_warn "${slug}: candidate fix has no file changes for ${path}"
      continue
    fi
    runner_exec "repo-practices git commit candidate fix" \
      -- git -C "$worktree_path" commit -m "$message"
    if [[ "$stacking_tool" == "$stacking_tool_value_graphite" ]]; then
      # Keep runner_sh label+script on one line for the runner-adoption ratchet.
      runner_sh "repo-practices gt track" "cd \"${worktree_path}\" && gt track --parent \"${parent_branch}\""
    fi
    created_branches+=("$branch")
    rp_log_warn "${slug}: created candidate branch ${branch} for ${path}"
    parent_branch="$branch"
    parent_ref="$branch"
    created_any=1
  done

  if [[ "$created_any" -eq 0 ]]; then
    return 0
  fi

  if [[ "$stacking_tool" == "$stacking_tool_value_graphite" ]]; then
    stacking_tool_submit_as "$stacking_tool_value_graphite" "$worktree_path"
  else
    quoted_wt="$(printf '%q' "$worktree_path")"
    quoted_branches=''
    for branch in "${created_branches[@]}"; do
      quoted_branches+=" $(printf '%q' "$branch")"
    done
    # Keep runner_sh label+script on one line for the runner-adoption ratchet.
    runner_sh "repo-practices gh stack init" "cd ${quoted_wt} && gh stack init --base $(printf '%q' "$default_branch")${quoted_branches}"
    stacking_tool_submit_as "$stacking_tool_value_gh_stack" "$worktree_path"
  fi
  status=""
  set +e
  status="$(rp_runner_exec_stdout "repo-practices git status after submit" \
    -- git -C "$worktree_path" status --porcelain)"
  set -e
  status="${status//$'\n'/}"
  if [[ -n "$status" ]]; then
    rp_die "candidate fix worktree is dirty after submit: ${worktree_path}"
  fi
  rp_log_warn "${slug}: submitted candidate workflow fix stack from ${worktree_path}"
}

rp_apply_codeowners_pr() {
  local slug="$1"
  local login default_branch base_sha branch_name existing_sha content encoded_content pr_url
  local -a put_args=()

  login="$(rp_authenticated_github_login)"
  default_branch="$(rp_runner_gh_api_stream "repo-practices codeowners default branch" "repos/${slug}" --jq '.default_branch // "main"')"
  base_sha="$(rp_runner_gh_api_stream "repo-practices codeowners base sha" "repos/${slug}/git/ref/heads/${default_branch}" --jq '.object.sha')"
  branch_name='repo-practices/add-codeowners'

  local pr_list_exit_code=0
  set +e
  pr_url="$(rp_runner_exec_stdout "repo-practices gh pr list codeowners" \
    -- gh pr list --repo "$slug" --head "$branch_name" --state open --json url \
      --jq '.[0].url // empty')"
  pr_list_exit_code=$?
  set -e
  pr_url="${pr_url//$'\n'/}"
  if (( pr_list_exit_code != 0 )); then
    pr_url=""
  fi
  if [[ -n "$pr_url" ]]; then
    rp_log_warn "${slug}: CODEOWNERS remediation PR already exists: ${pr_url}"
    return 0
  fi

  local ref_exit_code=0
  rp_runner_gh_api_stream "repo-practices gh ref heads codeowners branch" --probe \
    "repos/${slug}/git/ref/heads/${branch_name}" >/dev/null || ref_exit_code=$?
  if (( ref_exit_code != 0 )); then
    rp_runner_gh_api_stream "repo-practices gh create codeowners ref" \
      -X POST "repos/${slug}/git/refs" \
        -f "ref=refs/heads/${branch_name}" \
        -f "sha=${base_sha}" >/dev/null
  fi

  content="# Repository ownership"$'\n'"* @${login}"$'\n'
  encoded_content="$(printf '%s' "$content" | base64 | tr -d '\n')"
  local existing_exit_code=0
  set +e
  existing_sha="$(rp_runner_gh_api_stream "repo-practices gh codeowners sha" --probe \
    "repos/${slug}/contents/.github/CODEOWNERS?ref=${branch_name}" \
      --jq '.sha')"
  existing_exit_code=$?
  set -e
  existing_sha="${existing_sha//$'\n'/}"
  if (( existing_exit_code != 0 )); then
    existing_sha=""
  fi

  put_args=(
    -X PUT
    "repos/${slug}/contents/.github/CODEOWNERS"
    -f "message=chore: add CODEOWNERS"
    -f "content=${encoded_content}"
    -f "branch=${branch_name}"
  )
  if [[ -n "$existing_sha" ]]; then
    put_args+=(-f "sha=${existing_sha}")
  fi
  rp_runner_gh_api_stream "repo-practices gh put codeowners" "${put_args[@]}" >/dev/null

  pr_url="$(rp_runner_exec_stdout "repo-practices gh pr create codeowners" \
    -- gh pr create \
      --repo "$slug" \
      --head "$branch_name" \
      --base "$default_branch" \
      --title "chore: add CODEOWNERS" \
      --body "$(cat <<EOF
## Summary
- Add CODEOWNERS with ${login} as the owner of all files.

## Test plan
- Repository-practices remediation only.
EOF
)")"
  pr_url="${pr_url//$'\n'/}"
  rp_log_warn "${slug}: created CODEOWNERS remediation PR: ${pr_url}"
}

rp_repo_has_release_please() {
  local slug="$1"
  rp_gh_path_exists "$slug" '.github/workflows/release-please.yml'
}

# rp_repo_merge_it_label_check <slug>
# Returns 0 when merge-it exists, 1 when labels were read but merge-it is absent,
# 2 when GitHub API could not list labels (do not treat as missing merge-it).
rp_repo_merge_it_label_check() {
  local slug="$1"
  local labels_json fetch_exit jq_exit

  fetch_exit=0
  labels_json="$(rp_fetch_repo_labels_json "$slug")" || fetch_exit=$?
  if (( fetch_exit == 2 )); then
    return 2
  fi
  if (( fetch_exit != 0 )) || [[ -z "$labels_json" ]]; then
    return 2
  fi
  jq_exit=0
  rp_runner_jq_file "repo-practices merge-it label" "$labels_json" \
    -e 'index("merge-it") != null' >/dev/null || jq_exit=$?
  if (( jq_exit == 0 )); then
    return 0
  fi
  return 1
}

rp_repo_has_merge_it_label() {
  local slug="$1"
  local check_exit=0

  rp_repo_merge_it_label_check "$slug" || check_exit=$?
  (( check_exit == 0 ))
}

rp_repo_should_audit_default() {
  local slug="$1"
  local mq_exit=0
  if rp_repo_has_release_please "$slug"; then
    return 0
  fi
  if rp_repo_has_merge_it_label "$slug"; then
    return 0
  fi
  rp_repo_uses_github_merge_queue "$slug" || mq_exit=$?
  if (( mq_exit == 0 )); then
    return 0
  fi
  return 1
}

rp_discover_org_repos() {
  local owner="$1"
  local jq_expr

  if [[ "$rp_include_private" -eq 0 && "${rp_exclude_archived:-0}" -eq 1 ]]; then
    jq_expr='.[] | select(.private == false and .archived == false) | .name'
  elif [[ "$rp_include_private" -eq 0 ]]; then
    jq_expr='.[] | select(.private == false) | .name'
  elif [[ "${rp_exclude_archived:-0}" -eq 1 ]]; then
    jq_expr='.[] | select(.archived == false) | .name'
  else
    jq_expr='.[].name'
  fi
  rp_runner_gh_api_stream "repo-practices org repos" "orgs/${owner}/repos" --paginate --jq "$jq_expr"
}

rp_discover_audit_repos() {
  local owner="$1"
  local name slug
  if [[ "$rp_audit_all" -eq 1 ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf '%s\n' "${owner}/${name}"
    done < <(rp_discover_org_repos "$owner")
    return 0
  fi
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    slug="${owner}/${name}"
    if rp_repo_should_audit_default "$slug"; then
      printf '%s\n' "$slug"
    fi
  done < <(rp_discover_org_repos "$owner")
}

