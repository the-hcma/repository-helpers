  awk -v block_path="$block_path" '
    BEGIN {
      while ((getline block_line < block_path) > 0) {
        block = block block_line "\n"
      }
      close(block_path)
    }
    /^  guard:/ {
      in_guard = 1
      guard_indent = match($0, /[^ ]/) - 1
      print
      next
    }
    in_guard && /^    permissions:/ {
      skipping_permissions = 1
      perm_indent = match($0, /[^ ]/) - 1
      next
    }
    skipping_permissions {
      cur = match($0, /[^ ]/) - 1
      if (cur <= perm_indent) {
        skipping_permissions = 0
      } else {
        next
      }
    }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ {
      in_guard = 0
      print block
      print
      next
    }
    in_guard && /^    (runs-on:|name:)/ && !inserted_permissions {
      printf "%s", block
      inserted_permissions = 1
      print
      next
    }
    { print }
    END {
      if (in_guard && !inserted_permissions) {
        printf "%s", block
      }
    }
  ' <<<"$text"
  rm -f "$block_path"
}

rp_fix_ci_workflow_guard_push_dedup() {
  local text="$1"
  local run_path
  if rp_ci_workflow_guard_has_push_dedup "$text" \
    && ! rp_ci_workflow_guard_skip_run_is_broken "$text"; then
    printf '%s' "$text"
    return 0
  fi
  run_path="$(mktemp)"
  rp_candidate_ci_guard_skip_run_yaml "$text" >"$run_path"
  awk -v run_path="$run_path" '
    BEGIN {
      in_guard = 0
      in_skip_step = 0
      in_env = 0
      env_indent = -1
      env_has_token = 0
      run_indent = -1
      replacing_run = 0
    }
    /^  guard:/ { in_guard = 1; print; next }
    in_guard && /^  [a-zA-Z0-9_.-]+:/ && $0 !~ /^  guard:/ {
      in_guard = 0
      in_skip_step = 0
      in_env = 0
      replacing_run = 0
      print
      next
    }
    in_guard && /^      - id: (check|set-skip)$/ {
      in_skip_step = 1
      in_env = 0
      replacing_run = 0
      env_has_token = 0
      print
      next
    }
    in_skip_step && /^        env:/ {
      in_env = 1
      env_indent = match($0, /[^ ]/) - 1
      print
      next
    }
    in_env {
      cur = match($0, /[^ ]/) - 1
      if (cur <= env_indent) {
        in_env = 0
        if (!env_has_token) {
          print "          GH_TOKEN: ${{ github.token }}"
          env_has_token = 1
        }
      } else {
        if ($0 ~ /GH_TOKEN:/) {
          if (env_has_token) {
            next
          }
          env_has_token = 1
        }
        if ($0 ~ /HEAD_REF: \$\{\{ github\.head_ref \}\}/) {
          sub(/github\.head_ref \}\}/, "github.head_ref || github.ref_name }}")
        }
        print
        next
      }
    }
    in_skip_step && /^        run: \|/ {
      print
      run_indent = match($0, /[^ ]/) - 1
      while ((getline run_line < run_path) > 0) {
        print run_line
      }
      close(run_path)
      replacing_run = 1
      next
    }
    replacing_run {
      cur = match($0, /[^ ]/) - 1
      if (cur <= run_indent && $0 ~ /^        [a-zA-Z]/) {
        replacing_run = 0
        in_skip_step = 0
        print
        next
      }
      if (cur <= run_indent && $0 ~ /^  [a-zA-Z]/) {
        replacing_run = 0
        in_skip_step = 0
        print
        next
      }
      next
    }
    { print }
  ' <<<"$text"
  rm -f "$run_path"
}

