rp_fetch_workflow_file_names() {
  local slug="$1"
  local response

  local fetch_exit_code=0
  set +e
  response="$(rp_runner_exec_stdout "repo-practices gh list workflows" \
    -- gh api "repos/${slug}/contents/.github/workflows")"
  fetch_exit_code=$?
  set -e
  if (( fetch_exit_code != 0 )) || [[ -z "$response" ]]; then
    return 0
