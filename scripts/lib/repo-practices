rp_validate_workflow_file_extensions() {
  local slug="$1"
  local fail=0
  local workflow yml_workflow

  while IFS= read -r workflow; do
    [[ -n "$workflow" ]] || continue
    if [[ "$workflow" != *.yaml ]]; then
      continue
    fi
    yml_workflow="${workflow%.yaml}.yml"
    rp_log_fail "${slug}: workflow ${workflow} must use the standard .yml extension"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest \
        "${slug}: rename .github/workflows/${workflow} to .github/workflows/${yml_workflow}"
    fi
    fail=1
  done < <(rp_fetch_workflow_file_names "$slug")

  return "$fail"
}

rp_apply_repo_settings() {
  local slug="$1"
  rp_log_warn "${slug}: applying squash-only repository settings"
  gh api -X PATCH "repos/${slug}" \
    -f allow_merge_commit=false \
    -f allow_rebase_merge=false \
    -f allow_squash_merge=true \
    -f squash_merge_commit_message=BLANK \
    -f squash_merge_commit_title=PR_TITLE >/dev/null
}

rp_apply_protect_main_squash_methods() {
  local slug="$1"
  local owner name ruleset_id payload
  owner="${slug%%/*}"
  name="${slug#*/}"
  ruleset_id="$(gh api "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id' 2>/dev/null | head -n1 || true)"
  if [[ -z "$ruleset_id" ]]; then
    rp_apply_protect_main_create "$slug"
    return 0
  fi

  payload="$(gh api "repos/${owner}/${name}/rulesets/${ruleset_id}")"
  payload="$(jq '
    .rules |= map(
      if .type == "pull_request" then
        .parameters.allowed_merge_methods = ["squash"]
      else .
      end
    )
    | {
        name,
        target,
        enforcement,
        conditions,
        bypass_actors,
        rules
      }
  ' <<<"$payload")"

  rp_log_warn "${slug}: patching protect-main ruleset ${ruleset_id} (squash-only)"
  gh api -X PUT "repos/${owner}/${name}/rulesets/${ruleset_id}" --input - <<<"$payload" >/dev/null
}

rp_check_release_please() {
  local slug="$1"
  local repo_fail=0
  local settings_json

  if ! rp_repo_has_release_please "$slug"; then
    if [[ "$rp_new_repo" -eq 1 ]] && [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: add release-please.yml only if you publish versioned releases"
    fi
    return 0
  fi

  settings_json="$(rp_fetch_repo_settings "$slug")"

  if [[ "$rp_apply_fix" -eq 1 ]]; then
    if ! rp_validate_repo_settings_json "$slug" "$settings_json"; then
      rp_apply_repo_settings "$slug"
      settings_json="$(rp_fetch_repo_settings "$slug")"
    fi
  fi

  if ! rp_validate_repo_settings_json "$slug" "$settings_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'release-please merge settings' \
      "$(rp_github_url "$slug" '/settings')"
  else
    rp_log_check_fail "$slug" 'release-please settings (fix with --apply-fix; see AGENTS.md)' \
      "$(rp_github_url "$slug" '/settings')"
  fi

  return "$repo_fail"
}

rp_check_protect_main_ruleset() {
  local slug="$1"
  local repo_fail=0
  local ruleset_json methods_json

  if ! rp_repo_requires_protect_main_ruleset "$slug"; then
    return 0
  fi

  ruleset_json="$(rp_fetch_protect_main_ruleset "$slug" 2>/dev/null || true)"
  if [[ -n "$ruleset_json" ]]; then
    methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
  else
    methods_json='[]'
  fi

  if [[ "$rp_apply_fix" -eq 1 ]]; then
    if [[ -z "$ruleset_json" ]]; then
      rp_apply_protect_main_create "$slug"
      ruleset_json="$(rp_fetch_protect_main_ruleset "$slug" 2>/dev/null || true)"
      if [[ -n "$ruleset_json" ]]; then
        methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
      fi
    elif ! rp_validate_ruleset_methods_json "$slug" "$methods_json"; then
      rp_apply_protect_main_squash_methods "$slug"
      ruleset_json="$(rp_fetch_protect_main_ruleset "$slug" 2>/dev/null || true)"
      if [[ -n "$ruleset_json" ]]; then
        methods_json="$(rp_fetch_protect_main_merge_methods "$ruleset_json")"
      fi
    fi
  fi

  if ! rp_validate_ruleset_methods_json "$slug" "$methods_json"; then
    repo_fail=1
  fi
  if ! rp_validate_graphite_bypass_json "$slug" "$ruleset_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'protect-main ruleset (squash-only + Graphite bypass)' \
      "$(rp_github_url "$slug" '/settings/rules')"
  else
    rp_log_check_fail "$slug" 'protect-main ruleset (see AGENTS.md; fix with --apply-fix)' \
      "$(rp_github_url "$slug" '/settings/rules')"
  fi

  return "$repo_fail"
}

rp_check_classic_main_protection() {
  local slug="$1"
  local repo_fail=0
  local protection_json

  if ! rp_repo_requires_protect_main_ruleset "$slug"; then
    return 0
  fi

  protection_json="$(rp_fetch_classic_main_protection_json "$slug" 2>/dev/null || true)"
  if [[ -z "$protection_json" ]]; then
    rp_log_fail "${slug}: classic main branch protection is required (see AGENTS.md)"
    if [[ "$rp_suggest" -eq 1 ]]; then
      rp_log_suggest "${slug}: enable classic protection on main or run --apply-fix"
    fi
    if [[ "$rp_apply_fix" -eq 1 ]]; then
      rp_apply_classic_main_protection "$slug"
      protection_json="$(rp_fetch_classic_main_protection_json "$slug" 2>/dev/null || true)"
    else
      return 1
    fi
  elif [[ "$rp_apply_fix" -eq 1 ]]; then
    if ! rp_validate_classic_main_protection_json "$slug" "$protection_json"; then
      rp_apply_classic_main_protection "$slug"
      protection_json="$(rp_fetch_classic_main_protection_json "$slug" 2>/dev/null || true)"
    fi
  fi

  if [[ -z "$protection_json" ]]; then
    rp_log_fail "${slug}: classic main branch protection missing after --apply-fix"
    return 1
  fi

  if ! rp_validate_classic_main_protection_json "$slug" "$protection_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'classic main branch protection' \
      "$(rp_github_url "$slug" '/settings/branches')"
  else
    rp_log_check_fail "$slug" 'classic main branch protection (fix with --apply-fix; see AGENTS.md)' \
      "$(rp_github_url "$slug" '/settings/branches')"
  fi

  return "$repo_fail"
}

rp_check_graphite_merge_queue() {
  local slug="$1"
  local repo_fail=0
  local strict=0
  local labels_json

  if ! rp_repo_has_merge_it_label "$slug"; then
    if [[ "$rp_strict_onboarding" -eq 1 ]] \
      || { [[ "$rp_merge_only" -eq 0 ]] && rp_is_strict_repo "$slug"; }; then
      rp_log_fail "${slug}: merge-it label is required for full org onboarding"
      rp_log_suggest "${slug}: create merge-it label and enable Graphite merge queue on main"
      return 1
    fi
    if [[ "$rp_new_repo" -eq 1 ]]; then
      rp_log_suggest "${slug}: create merge-it label and enable Graphite merge queue on main"
    fi
    return 0
  fi

  if rp_is_strict_repo "$slug"; then
    strict=1
  fi

  labels_json="$(rp_fetch_repo_labels_json "$slug")"

  if ! rp_validate_graphite_enqueue_labels "$slug" "$labels_json"; then
    repo_fail=1
  fi
  if ! rp_validate_graphite_workflows "$slug" "$strict" "$labels_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    rp_log_check_ok "$slug" 'Graphite merge queue GitHub wiring' \
      "$(rp_github_url "$slug" '/tree/main/.github/workflows')"
    rp_log_manual_step \
      'You: enable merge queue on main (squash strategy) in Graphite' \
      'https://app.graphite.com/settings/merge-queue'
  else
    rp_log_check_fail "$slug" 'Graphite merge queue setup (see AGENTS.md and GRAPHITE.md)' \
      "$(rp_github_url "$slug" '/tree/main/.github/workflows')"
    rp_log_manual_step \
      'You: enable merge queue on main (squash strategy) in Graphite' \
      'https://app.graphite.com/settings/merge-queue'
  fi

  return "$repo_fail"
}

