rp_classic_protection_bypass_apps_json() {
  local slug="$1"
  local apps
  # Org default is GitHub merge queue — do not grant graphite-app review bypass.
  apps='[]'
  if rp_repo_has_dependabot "$slug"; then
    apps='["'"${rp_DEPENDABOT_APP_SLUG}"'"]'
  fi
  printf '%s' "$apps"
}

rp_validate_classic_main_protection_json() {
  local slug="$1"
  local protection_json="$2"
  local fail=0
  local expected
  local -a expected_contexts=()
  local ctx
  # Org default is GitHub MQ: no Graphite-only push restrictions / review bypass.
  local github_mq=1
  local mq_exit=0

  rp_repo_uses_github_merge_queue "$slug" || mq_exit=$?
  if (( mq_exit == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset'
    return 1
  fi

  local jq_exit_code=0
  rp_runner_jq_file "repo-practices allow force pushes" "$protection_json" \
    -e '.allow_force_pushes.enabled == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code == 0 )); then
    rp_log_fail "${slug}: classic main protection must disallow force-push"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices allow deletions" "$protection_json" \
    -e '.allow_deletions.enabled == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code == 0 )); then
    rp_log_fail "${slug}: classic main protection must disallow branch deletion"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices dismiss stale reviews" "$protection_json" \
    -e '.required_pull_request_reviews.dismiss_stale_reviews == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must dismiss stale reviews"
    fail=1
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices code owner reviews" "$protection_json" \
    -e '.required_pull_request_reviews.require_code_owner_reviews == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must require CODEOWNERS review"
    fail=1
  fi
  if rp_repo_has_dependabot "$slug"; then
    jq_exit_code=0
    rp_runner_jq_file "repo-practices dependabot review bypass" "$protection_json" \
      --arg slug "${rp_DEPENDABOT_APP_SLUG}" \
      -e '[.required_pull_request_reviews.bypass_pull_request_allowances.apps[]?.slug] | index($slug) != null' \
      >/dev/null || jq_exit_code=$?
    if (( jq_exit_code != 0 )); then
      rp_log_fail "${slug}: classic main protection must bypass dependabot when dependabot.yml exists"
      fail=1
    fi
  fi
  if [[ "$github_mq" -eq 1 ]]; then
    jq_exit_code=0
    # GitHub merge queue must be able to land on main; Graphite-only push
    # restrictions block the native queue.
    rp_runner_jq_file "repo-practices no graphite-only push restriction" "$protection_json" \
      -e '(.restrictions == null) or ((.restrictions.apps // []) | length == 0)' \
      >/dev/null || jq_exit_code=$?
    if (( jq_exit_code != 0 )); then
      rp_log_fail \
        "${slug}: classic main protection must not restrict pushes when GitHub merge queue is enabled"
      if [[ "$rp_suggest" -eq 1 ]]; then
        rp_log_suggest "${slug}: clear classic push restrictions on main (GitHub MQ lands merges)"
      fi
      fail=1
    fi
  fi
  jq_exit_code=0
  rp_runner_jq_file "repo-practices strict status checks" "$protection_json" \
    -e '.required_status_checks.strict == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code != 0 )); then
    rp_log_fail "${slug}: classic main protection must require branches up to date (strict)"
    fail=1
  fi

  while IFS= read -r expected; do
    [[ -n "$expected" ]] || continue
    expected_contexts+=("$expected")
  done < <(rp_discover_ci_status_contexts "$slug")

  if [[ "${#expected_contexts[@]}" -eq 0 ]]; then
    if rp_gh_path_exists "$slug" '.github/workflows/ci.yml'; then
      rp_log_fail "${slug}: could not discover CI status contexts from ci.yml"
      fail=1
    fi
  else
    for ctx in "${expected_contexts[@]}"; do
      jq_exit_code=0
      rp_runner_jq_file "repo-practices status context ${ctx}" "$protection_json" \
        --arg ctx "$ctx" \
        -e '[.required_status_checks.contexts[]?] | index($ctx) != null' \
        >/dev/null || jq_exit_code=$?
      if (( jq_exit_code != 0 )); then
        rp_log_fail "${slug}: classic main protection missing required status check: ${ctx}"
        if [[ "$rp_suggest" -eq 1 ]]; then
          rp_log_suggest "${slug}: add CI context ${ctx} (from ci.yml) to main branch protection"
        fi
        fail=1
      fi
    done
  fi

  jq_exit_code=0
  rp_runner_jq_file "repo-practices enforce admins" "$protection_json" \
    -e '.enforce_admins.enabled == true' >/dev/null || jq_exit_code=$?
  if (( jq_exit_code == 0 )); then
    rp_log_warn "${slug}: enforce_admins is enabled (org default is false)"
  fi

  return "$fail"
}

rp_apply_classic_main_protection() {
  local slug="$1"
  local -a contexts=()
  local ctx
  local bypass_apps_json payload
  local restrictions_json
  local mq_exit=0

  while IFS= read -r ctx; do
    [[ -n "$ctx" ]] || continue
    contexts+=("$ctx")
  done < <(rp_discover_ci_status_contexts "$slug")

  bypass_apps_json="$(rp_classic_protection_bypass_apps_json "$slug")"
  mq_exit=0
  rp_repo_uses_github_merge_queue "$slug" || mq_exit=$?
  if (( mq_exit == 2 )); then
    rp_log_gh_api_fail "$slug" 'could not read protect-main ruleset'
    return 1
  fi
  # Org default is GitHub MQ: never restrict pushes to graphite-app.
  restrictions_json='null'

  if [[ "${#contexts[@]}" -eq 0 ]]; then
    payload="$(rp_runner_jq_n "repo-practices classic protection payload empty contexts" \
      --arg owner "${rp_ORG_OWNER_BYPASS_USER}" \
      --argjson bypass_apps "$bypass_apps_json" \
      --argjson restrictions "$restrictions_json" \
      '{
        required_status_checks: null,
        enforce_admins: false,
        required_pull_request_reviews: {
          dismiss_stale_reviews: true,
          require_code_owner_reviews: true,
          required_approving_review_count: 0,
          bypass_pull_request_allowances: {
            users: [$owner],
            teams: [],
            apps: $bypass_apps
          }
        },
        restrictions: $restrictions,
        allow_force_pushes: false,
        allow_deletions: false
      }')"
  else
    local contexts_lines
    contexts_lines="$(printf '%s\n' "${contexts[@]}")"
    payload="$(rp_runner_jq_n "repo-practices classic protection payload" \
      --arg owner "${rp_ORG_OWNER_BYPASS_USER}" \
      --argjson bypass_apps "$bypass_apps_json" \
      --argjson restrictions "$restrictions_json" \
      --argjson contexts "$(rp_runner_jq_file "repo-practices protection contexts slurp" "$contexts_lines" -R -s 'split("\n") | map(select(length > 0))')" \
      '{
        required_status_checks: {
          strict: true,
          contexts: $contexts
        },
        enforce_admins: false,
        required_pull_request_reviews: {
          dismiss_stale_reviews: true,
          require_code_owner_reviews: true,
          required_approving_review_count: 0,
          bypass_pull_request_allowances: {
            users: [$owner],
            teams: [],
            apps: $bypass_apps
          }
        },
        restrictions: $restrictions,
        allow_force_pushes: false,
        allow_deletions: false
      }')"
  fi

  rp_log_warn "${slug}: applying classic main branch protection (GitHub merge queue; no push restrictions)"
  rp_runner_gh_api_input "repo-practices gh put classic protection" "$payload" \
    -X PUT "repos/${slug}/branches/main/protection"
}

