#!/usr/bin/env bash
# agent-review-feedback — unified triage for review threads, issue comments, and
# pull-request review bodies (body-only findings with no inline threads).
# shellcheck disable=SC2016  # jq filter strings use $variables, not shell expansion

lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${lib_dir}/runner-ensure"

agent_review_feedback_resolved_state_file() {
  printf '%s\n' \
    "${AGENT_REVIEW_RESOLVED_COMMENTS_FILE:-${HOME}/scratch/repository-helpers/agent-review-resolved-issue-comments.env}"
}

agent_review_feedback_resolved_state_key() {
  local -r repo="$1"
  local -r pr="$2"

  printf '%s#%s' "${repo}" "${pr}"
}

agent_review_feedback_resolved_ids_for_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local state_file key line ids

  state_file="$(agent_review_feedback_resolved_state_file)"
  key="$(agent_review_feedback_resolved_state_key "${repo}" "${pr}")"
  ids=""
  if [[ -f "${state_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      [[ "${line}" == "${key}="* ]] || continue
      ids="${line#"${key}"=}"
      break
    done <"${state_file}"
  fi
  printf '%s' "${ids}"
}

# Persist a resolved feedback id (bare issue-comment id, or PRR_<review databaseId>).
agent_review_feedback_mark_id_resolved() {
  local -r repo="$1"
  local -r pr="$2"
  local -r resolved_id="$3"
  local state_file key dir existing new_ids tmp

  [[ -n "${resolved_id}" ]] || agent_review_die 'resolve requires a feedback id'
  state_file="$(agent_review_feedback_resolved_state_file)"
  key="$(agent_review_feedback_resolved_state_key "${repo}" "${pr}")"
  dir="$(dirname "${state_file}")"
  if [[ ! -d "${dir}" ]]; then
    run_command_or_die "agent-review feedback mkdir state dir" mkdir --parents "${dir}"
  fi
  existing="$(agent_review_feedback_resolved_ids_for_pr "${repo}" "${pr}")"
  if [[ -n "${existing}" ]]; then
    if [[ ",${existing}," == *",${resolved_id},"* ]]; then
      return 0
    fi
    new_ids="${existing},${resolved_id}"
  else
    new_ids="${resolved_id}"
  fi
  tmp="$(runner_exec_stdout "agent-review feedback mktemp" -- mktemp "${TMPDIR:-/tmp}/agent-review-resolved.XXXXXX")"
  if [[ -f "${state_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      [[ "${line}" == "${key}="* ]] && continue
      printf '%s\n' "${line}" >>"${tmp}"
    done <"${state_file}"
  else
    : >"${tmp}"
  fi
  printf '%s=%s\n' "${key}" "${new_ids}" >>"${tmp}"
  run_command_or_die "agent-review feedback persist resolved state" mv "${tmp}" "${state_file}"
}

agent_review_feedback_mark_issue_comment_resolved() {
  local -r repo="$1"
  local -r pr="$2"
  local -r comment_id="$3"

  [[ -n "${comment_id}" ]] || agent_review_die 'resolve-comment requires a comment id'
  agent_review_feedback_mark_id_resolved "${repo}" "${pr}" "${comment_id}"
}

agent_review_feedback_review_resolved_id() {
  local -r review_id="$1"

  printf 'PRR_%s' "$(agent_review_feedback_normalize_review_id "${review_id}")"
}

# Strip optional PRR_ prefix from --review-id / feedback ids (repository-helpers#539).
agent_review_feedback_normalize_review_id() {
  local id="${1:-}"

  id="${id#PRR_}"
  printf '%s' "${id}"
}

agent_review_feedback_mark_review_resolved() {
  local -r repo="$1"
  local -r pr="$2"
  local review_id="$3"

  review_id="$(agent_review_feedback_normalize_review_id "${review_id}")"
  [[ -n "${review_id}" ]] || agent_review_die 'resolve-comment --review-id requires a review id'
  agent_review_feedback_mark_id_resolved \
    "${repo}" "${pr}" "$(agent_review_feedback_review_resolved_id "${review_id}")"
}

# Canonical HTML anchor URL for a pull-request review databaseId.
agent_review_feedback_review_canonical_url() {
  local -r repo="$1"
  local -r pr="$2"
  local -r review_id="$3"

  printf 'https://github.com/%s/pull/%s#pullrequestreview-%s' \
    "${repo}" "${pr}" "$(agent_review_feedback_normalize_review_id "${review_id}")"
}

# Lookup review meta by databaseId across *all* non-PENDING reviews in the snapshot
# (not only the current head). Empty JSON object when missing.
agent_review_feedback_review_meta_json() {
  local -r snapshot="$1"
  local review_id="$2"

  review_id="$(agent_review_feedback_normalize_review_id "${review_id}")"
  ar_runner_jq_file "agent-review feedback review meta" "${snapshot}" \
    --arg id "${review_id}" '
      [(.data.repository.pullRequest.reviews.nodes // [])
        | .[]
        | select(.state != "PENDING")
        | select((.databaseId // null) != null)
        | select((.databaseId | tostring) == $id)
        | {
            review_id: (.databaseId | tostring),
            url: (.url // ""),
            submitted_at: (.submittedAt // "")
          }
      ] | first // {}'
}

agent_review_feedback_issue_comment_is_probe() {
  local -r body="${1:-}"
  local lower

  [[ -n "${body}" ]] || return 0
  lower="${body,,}"
  if [[ "${lower}" == *'wait-for-agent-review:'* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ ^@copilot[[:space:]]+please[[:space:]]+review ]]; then
    return 0
  fi
  # Bugbot explicit trigger (agent_review_profile_trigger_comment).
  if [[ "${lower}" =~ ^bugbot[[:space:]]+run[[:space:]]*$ ]]; then
    return 0
  fi
  if [[ "${lower}" == *'summarize by coderabbit.ai'* ]] \
    || [[ "${lower}" == *'walkthrough_start'* ]] \
    || [[ "${lower}" == *'cursor_summary'* ]]; then
    return 0
  fi
  # Bugbot quota / run-failed notices — observed for quota, not product triage.
  if [[ "${lower}" == *'bugbot'* ]] \
    && { [[ "${lower}" == *'usage limit'* ]] || [[ "${lower}" == *"couldn't run"* ]] \
      || [[ "${lower}" == *'could not run'* ]]; }; then
    return 0
  fi
  # Repository overview / architecture blurb (e.g. Vortex) — not actionable findings.
  if [[ "${lower}" == *'code-review-agent:overview'* ]]; then
    return 0
  fi
  # CodeRabbit auto-replies that only acknowledge a review command (no review content).
  if [[ "${lower}" == *'auto-generated reply by coderabbit'* ]] \
    && [[ "${lower}" == *'review triggered'* ]]; then
    return 0
  fi
  if [[ "${lower}" == *'action performed'* ]] \
    && { [[ "${lower}" == *'review triggered'* ]] || [[ "${lower}" == *'review finished'* ]]; }; then
    return 0
  fi
  if [[ "${lower}" == *'auto-generated reply by coderabbit'* ]] \
    && [[ "${lower}" == *'action performed'* ]]; then
    return 0
  fi
  return 1
}

# True when a PR review body is an empty / approve / all-clear pass (not triage).
agent_review_feedback_review_body_is_empty_pass() {
  local -r body="${1:-}"
  local lower

  [[ -n "${body}" ]] || return 0
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*0 ]]; then
    return 0
  fi
  if [[ "${lower}" == *'no actionable comments were generated'* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no[[:space:]]+issues[[:space:]]+found|all[[:space:]]+clear|looks[[:space:]]+good|lgtm|nothing[[:space:]]+to[[:space:]]+fix) ]]; then
    return 0
  fi
  # Markdown **Approve** / **Approve ** (optional space before closing **).
  if [[ "${lower}" =~ \*\*approve[[:space:]]*\*\* ]]; then
    return 0
  fi
  if [[ "${lower}" == *'review completed'* ]] \
    && [[ "${lower}" != *nitpick* ]] \
    && [[ "${lower}" != *actionable* ]] \
    && [[ "${lower}" != *'request changes'* ]] \
    && [[ "${lower}" != *'outside changed'* ]]; then
    return 0
  fi
  return 1
}

# True when a PR review body (or CHANGES_REQUESTED state) needs operator triage.
agent_review_feedback_review_body_is_actionable() {
  local -r body="${1:-}"
  local -r state="${2:-}"
  local -r login="${3:-}"
  local lower

  if [[ "${state}" == 'CHANGES_REQUESTED' ]]; then
    return 0
  fi
  [[ -n "${body}" ]] || return 1
  if agent_review_feedback_review_body_is_empty_pass "${body}"; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" == *'outside changed lines'* ]] \
    || [[ "${lower}" == *'outside the changed lines'* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ \*\*request[[:space:]]+changes\*\* ]] \
    || [[ "${lower}" == *'request changes'* ]]; then
    return 0
  fi
  if [[ "${lower}" == *'findings to address'* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ nitpick[[:space:]]+comments[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ potential[[:space:]]+issue[s]?[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (must[[:space:]]+fix|blocking[[:space:]]+comment) ]]; then
    return 0
  fi
  # CodeRabbit: any non-empty non-pass review body needs an operator PR comment
  # (preserves prior head_feedback_needs_operator_triage behaviour).
  if [[ "${login,,}" == *coderabbit* ]]; then
    return 0
  fi
  return 1
}

agent_review_feedback_issue_comment_is_resolved() {
  local -r repo="$1"
  local -r pr="$2"
  local -r comment_id="$3"
  local ids

  ids="$(agent_review_feedback_resolved_ids_for_pr "${repo}" "${pr}")"
  [[ -n "${ids}" ]] && [[ ",${ids}," == *",${comment_id},"* ]]
}

agent_review_feedback_review_is_resolved() {
  local -r repo="$1"
  local -r pr="$2"
  local -r review_id="$3"
  local ids rid

  rid="$(agent_review_feedback_review_resolved_id "${review_id}")"
  ids="$(agent_review_feedback_resolved_ids_for_pr "${repo}" "${pr}")"
  [[ -n "${ids}" ]] && [[ ",${ids}," == *",${rid},"* ]]
}

# Chronological issue comments as JSON array: [{id,login,body,html_url,created_at}, ...]
agent_review_feedback_issue_comments_array_json() {
  local -r repo="$1"
  local -r pr="$2"
  local api_json

  api_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  ar_runner_jq_file "agent-review feedback issue comments array" "${api_json}" -rs '
    [ .[] | .[]
      | {
          id: (.id | tostring),
          login: (.user.login // ""),
          body: (.body // ""),
          html_url: (.html_url // ""),
          created_at: (.created_at // "")
        }
    ]
    | sort_by(.created_at)'
}

agent_review_feedback_issue_comments_pending_from_array_json() {
  local -r operator_login="$1"
  local -r repo="$2"
  local -r pr="$3"
  local -r comments_json="$4"
  local resolved_csv

  resolved_csv="$(agent_review_feedback_resolved_ids_for_pr "${repo}" "${pr}")"
  # Include operator-authored conversation comments (product notes) as pending
  # feedback. Probe/bot boilerplate and triage replies ("In reply to …") stay
  # excluded. "Addressed" requires a later operator comment that cites this
  # comment's html_url — not merely any later operator comment (issue #385).
  ar_runner_jq_file "agent-review feedback pending issue comments" "${comments_json}" \
    --arg operator "${operator_login}" \
    --arg resolved_csv "${resolved_csv}" '
      def is_probe($body):
        ($body // "") | test("wait-for-agent-review:";"i")
        or test("^@copilot[[:space:]]+please[[:space:]]+review";"i")
        or test("^bugbot[[:space:]]+run[[:space:]]*$";"i")
        or test("summarize by coderabbit\\.ai";"i")
        or test("walkthrough_start";"i")
        or test("cursor_summary";"i")
        or (test("bugbot";"i") and (test("usage limit";"i")
             or test("couldn\u0027t run";"i") or test("could not run";"i")))
        or test("code-review-agent:overview";"i")
        or (test("action performed";"i") and (test("review triggered";"i") or test("review finished";"i")))
        or (test("auto-generated reply by coderabbit";"i") and test("action performed";"i"));
      def is_triage_reply($body):
        # reply-comment / reply-review append: "(In reply to <url>)" near the end.
        (($body // "") | test("[(]In reply to https?://[^)]+[)][[:space:]]*$"));
      def resolved_set:
        if ($resolved_csv | length) == 0 then []
        else ($resolved_csv | split(","))
        end;
      . as $all
      | [ range(0; ($all | length)) as $i
        | $all[$i] as $c
        | select(is_probe($c.body) | not)
        | select(is_triage_reply($c.body) | not)
        | select((resolved_set | index($c.id)) | not)
        | ($c.html_url // "") as $url
        | {
            kind: "issue_comment",
            feedback_id: ("IC_" + $c.id),
            comment_id: $c.id,
            author: $c.login,
            comment_url: $c.html_url,
            body: $c.body,
            state: (
              if ($url | length) == 0 then "unaddressed"
              elif ([ range($i + 1; ($all | length))
                      | $all[.]
                      | select(.login == $operator)
                      | select((.body // "") | index("(In reply to " + $url + ")") != null)
                    ] | length > 0)
              then "needs_resolve"
              else "unaddressed"
              end
            )
          }
        | select(.state == "unaddressed" or .state == "needs_resolve")
      ]'
}

agent_review_feedback_issue_comments_pending_json() {
  local -r repo="$1"
  local -r pr="$2"
  local operator_login comments_json

  operator_login="$(agent_review_authenticated_login)"
  comments_json="$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")"
  agent_review_feedback_issue_comments_pending_from_array_json \
    "${operator_login}" "${repo}" "${pr}" "${comments_json}"
}

# Fast REST path for exit-3 triage when GraphQL threads exist: merge issue comments
# when login + pagination succeed; return [] without rate-limit waits on failure.
agent_review_feedback_issue_comments_pending_json_fast() {
  local -r repo="$1"
  local -r pr="$2"
  local operator_login comments_json api_json

  if ! agent_review_authenticated_login_optional; then
    printf '[]'
    return 0
  fi
  # Set by agent_review_authenticated_login_optional (scripts/lib/agent-review).
  # shellcheck disable=SC2154
  operator_login="${_agent_review_viewer_login_cache}"
  api_json="$(GITHUB_API_RATE_LIMIT_MAX_RETRIES=1 \
    agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  comments_json="$(ar_runner_jq_file "agent-review feedback issue comments array fast" "${api_json}" -rs '
    [ .[] | .[]
      | {
          id: (.id | tostring),
          login: (.user.login // ""),
          body: (.body // ""),
          html_url: (.html_url // ""),
          created_at: (.created_at // "")
        }
    ]
    | sort_by(.created_at)')"
  agent_review_feedback_issue_comments_pending_from_array_json \
    "${operator_login}" "${repo}" "${pr}" "${comments_json}"
}

# Reviews on <head> from the GraphQL snapshot (all authors).
agent_review_feedback_reviews_on_head_array_json() {
  local -r snapshot="$1"
  local -r head="$2"
  local missing_ids

  missing_ids="$(ar_runner_jq_file "agent-review feedback reviews missing databaseId" "${snapshot}" \
    --arg head "${head}" -r '
    [(.data.repository.pullRequest.reviews.nodes // [])
      | .[]
      | select(.state != "PENDING")
      | select((.commit.oid // "") == $head)
      | select((.databaseId // null) == null)
    ] | length')"
  if [[ "${missing_ids}" =~ ^[1-9][0-9]*$ ]]; then
    printf 'wait-for-agent-review: warning: %s head review(s) lack databaseId — skipped for body-feedback triage (stale snapshot?)\n' \
      "${missing_ids}" >&2
  fi

  ar_runner_jq_file "agent-review feedback reviews on head" "${snapshot}" \
    --arg head "${head}" '
    [(.data.repository.pullRequest.reviews.nodes // [])
      | .[]
      | select(.state != "PENDING")
      | select((.commit.oid // "") == $head)
      | select((.databaseId // null) != null)
      | {
          review_id: (.databaseId | tostring),
          login: (.author.login // ""),
          state: (.state // ""),
          body: (.body // ""),
          url: (.url // ""),
          submitted_at: (.submittedAt // "")
        }
    ]
    | sort_by(.submitted_at)'
}

agent_review_feedback_reviews_pending_json() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local -r mode="${4:-}"
  local head operator_login reviews_json resolved_csv comments_json

  head="$(ar_runner_jq_file "agent-review feedback head sha" "${snapshot}" -r \
    '.data.repository.pullRequest.headRefOid // ""')"
  [[ -n "${head}" ]] || {
    printf '%s' '[]'
    return 0
  }
  if [[ "${mode}" == 'snapshot-only' ]]; then
    # GraphQL reviews only — skip gh api user and issue-comment pagination (#497).
    operator_login=''
    comments_json='[]'
  else
    operator_login="$(agent_review_authenticated_login)"
    comments_json="$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")"
  fi
  reviews_json="$(agent_review_feedback_reviews_on_head_array_json "${snapshot}" "${head}")"
  resolved_csv="$(agent_review_feedback_resolved_ids_for_pr "${repo}" "${pr}")"
  agent_review_feedback_reviews_pending_from_parts_json \
    "${operator_login}" "${reviews_json}" "${comments_json}" "${resolved_csv}"
}

# Fast REST merge for exit-3 triage when GraphQL threads exist (no rate-limit sleeps).
agent_review_feedback_reviews_pending_json_fast() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local -r operator_login="$4"
  local head reviews_json resolved_csv comments_json api_json

  head="$(ar_runner_jq_file "agent-review feedback head sha" "${snapshot}" -r \
    '.data.repository.pullRequest.headRefOid // ""')"
  [[ -n "${head}" ]] || {
    printf '%s' '[]'
    return 0
  }
  api_json="$(GITHUB_API_RATE_LIMIT_MAX_RETRIES=1 \
    agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  comments_json="$(ar_runner_jq_file "agent-review feedback issue comments array fast reviews" "${api_json}" -rs '
    [ .[] | .[]
      | {
          id: (.id | tostring),
          login: (.user.login // ""),
          body: (.body // ""),
          html_url: (.html_url // ""),
          created_at: (.created_at // "")
        }
    ]
    | sort_by(.created_at)')"
  reviews_json="$(agent_review_feedback_reviews_on_head_array_json "${snapshot}" "${head}")"
  resolved_csv="$(agent_review_feedback_resolved_ids_for_pr "${repo}" "${pr}")"
  agent_review_feedback_reviews_pending_from_parts_json \
    "${operator_login}" "${reviews_json}" "${comments_json}" "${resolved_csv}"
}

agent_review_feedback_reviews_pending_from_parts_json() {
  local -r operator_login="$1"
  local -r reviews_json="$2"
  local -r comments_json="$3"
  local -r resolved_csv="$4"

  ar_runner_jq_n "agent-review feedback pending reviews" \
    --argjson reviews "${reviews_json}" \
    --argjson comments "${comments_json}" \
    --arg operator "${operator_login}" \
    --arg resolved_csv "${resolved_csv}" '
      def resolved_set:
        if ($resolved_csv | length) == 0 then []
        else ($resolved_csv | split(","))
        end;
      def lower($s): ($s // "") | ascii_downcase;
      def is_empty_pass($body):
        lower($body) as $l
        | ($l | test("actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*0"))
        or ($l | test("no actionable comments were generated"))
        or ($l | test("no[[:space:]]+issues[[:space:]]+found|all[[:space:]]+clear|looks[[:space:]]+good|\\blgtm\\b|nothing[[:space:]]+to[[:space:]]+fix"))
        or ($l | test("\\*\\*approve[[:space:]]*\\*\\*"))
        or (
          ($l | test("review completed"))
          and ($l | test("nitpick") | not)
          and ($l | test("actionable") | not)
          and ($l | test("request changes") | not)
          and ($l | test("outside changed") | not)
        );
      def is_actionable($body; $state; $login):
        ($state == "CHANGES_REQUESTED")
        or (
          (($body // "") | length > 0)
          and (is_empty_pass($body) | not)
          and (
            (lower($body) | test("outside changed lines|outside the changed lines"))
            or (lower($body) | test("\\*\\*request[[:space:]]+changes\\*\\*|request changes"))
            or (lower($body) | test("findings to address"))
            or (lower($body) | test("actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9]"))
            or (lower($body) | test("nitpick[[:space:]]+comments[[:space:]]*\\([1-9]"))
            or (lower($body) | test("potential[[:space:]]+issues?[[:space:]]*\\([1-9]"))
            or (lower($body) | test("must[[:space:]]+fix|blocking[[:space:]]+comment"))
            or (lower($login) | test("coderabbit"))
          )
        );
      def operator_replied_to_review($review):
        ($review.url // "") as $url
        | ("pullrequestreview-" + $review.review_id) as $anchor
        | [ $comments[]
            | select(.login == $operator)
            | select(
                (($url | length) > 0 and ((.body // "") | index("(In reply to " + $url + ")") != null))
                or ((.body // "") | index($anchor + ")") != null)
              )
          ] | length > 0;
      [ $reviews[]
        | select(.login != $operator)
        | select(is_actionable(.body; .state; .login))
        | ("PRR_" + .review_id) as $rid
        | select((resolved_set | index($rid)) | not)
        | {
            kind: "pull_request_review",
            feedback_id: $rid,
            review_id: .review_id,
            author: .login,
            review_url: .url,
            body: .body,
            review_state: .state,
            submitted_at: .submitted_at,
            state: (
              if operator_replied_to_review(.) then "needs_resolve"
              else "unaddressed"
              end
            )
          }
      ]'
}

agent_review_feedback_threads_pending_json() {
  local -r snapshot="$1"

  agent_review_pending_threads_json_from_snapshot "${snapshot}"
}

agent_review_feedback_pending_json() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local threads_json issue_json reviews_json thread_count rest_login

  threads_json="$(agent_review_feedback_threads_pending_json "${snapshot}")"
  thread_count="$(ar_runner_jq_file "agent-review feedback snapshot thread count" \
    "${threads_json}" 'length')"
  thread_count="${thread_count:-0}"
  if (( thread_count > 0 )); then
    # GraphQL threads already justify exit 3. Try REST once without rate-limit
    # sleeps (repository-helpers#497); fall back to snapshot-only reviews when
    # gh api user or issue-comment pagination is depleted.
    rest_login=''
    if agent_review_authenticated_login_optional; then
      # Set by agent_review_authenticated_login_optional (scripts/lib/agent-review).
      # shellcheck disable=SC2154
      rest_login="${_agent_review_viewer_login_cache}"
      issue_json="$(agent_review_feedback_issue_comments_pending_json_fast "${repo}" "${pr}")"
      reviews_json="$(agent_review_feedback_reviews_pending_json_fast \
        "${repo}" "${pr}" "${snapshot}" "${rest_login}")"
    else
      issue_json='[]'
      reviews_json="$(agent_review_feedback_reviews_pending_json \
        "${repo}" "${pr}" "${snapshot}" snapshot-only)"
    fi
  else
    issue_json="$(agent_review_feedback_issue_comments_pending_json "${repo}" "${pr}")"
    reviews_json="$(agent_review_feedback_reviews_pending_json "${repo}" "${pr}" "${snapshot}")"
  fi
  ar_runner_jq_n "agent-review feedback pending merge" \
    --argjson threads "${threads_json}" \
    --argjson issues "${issue_json}" \
    --argjson reviews "${reviews_json}" '
      ($threads | map(. + {kind: "review_thread", feedback_id: .thread_id}))
      + $issues
      + $reviews
      | unique_by(.feedback_id)'
}

agent_review_feedback_pending_count() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"

  ar_runner_jq_file "agent-review feedback pending count" \
    "$(agent_review_feedback_pending_json "${repo}" "${pr}" "${snapshot}")" 'length'
}

# Count agent review threads, non-probe agent issue comments, and actionable body reviews.
agent_review_feedback_posted_count() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local bots thread_count issue_count review_count operator_login comments_json reviews_pending

  bots="$(agent_review_bot_login_regex)"
  thread_count="$(ar_runner_jq_file "agent-review feedback posted thread count" "${snapshot}" --arg bots "${bots}" '
      def is_bot_login($login):
        ($bots | split("|")) as $patterns
        | any($patterns[]; . as $p | ($login // "") | test($p;"i"));
      [.data.repository.pullRequest.reviewThreads.nodes[]
        | .comments.nodes[0] as $first
        | select(is_bot_login($first.author.login))] | length')"
  operator_login="$(agent_review_authenticated_login)"
  comments_json="$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")"
  issue_count="$(ar_runner_jq_file "agent-review feedback posted issue comment count" "${comments_json}" \
    --arg operator "${operator_login}" --arg bots "${bots}" '
      def is_bot_login($login):
        ($bots | split("|")) as $patterns
        | any($patterns[]; . as $p | ($login // "") | test($p;"i"));
      def is_probe($body):
        ($body // "") | test("wait-for-agent-review:";"i")
        or test("^@copilot[[:space:]]+please[[:space:]]+review";"i")
        or test("^bugbot[[:space:]]+run[[:space:]]*$";"i")
        or test("summarize by coderabbit\\.ai";"i")
        or test("walkthrough_start";"i")
        or test("cursor_summary";"i")
        or (test("bugbot";"i") and (test("usage limit";"i")
             or test("couldn\u0027t run";"i") or test("could not run";"i")))
        or test("code-review-agent:overview";"i")
        or (test("action performed";"i") and (test("review triggered";"i") or test("review finished";"i")))
        or (test("auto-generated reply by coderabbit";"i") and test("action performed";"i"));
      def is_triage_reply($body):
        (($body // "") | test("[(]In reply to https?://[^)]+[)][[:space:]]*$"));
      # Match pending triage: bot + operator product notes; exclude probes/replies.
      [ .[]
        | select(is_probe(.body) | not)
        | select(is_triage_reply(.body) | not)
        | select(is_bot_login(.login) or .login == $operator)
      ] | length')"
  # Pending reviews are a lower bound on posted body-feedback items (resolved ones
  # drop out of pending; still fine for email stats).
  reviews_pending="$(agent_review_feedback_reviews_pending_json "${repo}" "${pr}" "${snapshot}")"
  review_count="$(ar_runner_jq_file "agent-review feedback posted review count" \
    "${reviews_pending}" 'length')"
  printf '%s' "$((thread_count + issue_count + review_count))"
}

# One-line posted/addressed/pending summary for operator emails.
agent_review_feedback_stats_line_for_email() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local posted pending addressed

  posted="$(agent_review_feedback_posted_count "${repo}" "${pr}" "${snapshot}")"
  pending="$(agent_review_feedback_pending_count "${repo}" "${pr}" "${snapshot}")"
  addressed=$((posted - pending))
  if (( addressed < 0 )); then
    addressed=0
  fi
  printf '  Agent feedback: %s posted, %s addressed, %s pending' \
    "${posted}" "${addressed}" "${pending}"
}

agent_review_feedback_triage_json() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local thread_triage pending_json

  thread_triage="$(agent_review_triage_threads_json_from_snapshot "${snapshot}")"
  pending_json="$(agent_review_feedback_pending_json "${repo}" "${pr}" "${snapshot}")"
  ar_runner_jq_n "agent-review feedback triage json" \
    --argjson threads "${thread_triage}" \
    --argjson pending "${pending_json}" \
    '{
      threads: $threads,
      issue_comments: ($pending | map(select(.kind == "issue_comment"))),
      pull_request_reviews: ($pending | map(select(.kind == "pull_request_review"))),
      pending_feedback: $pending
    }'
}

agent_review_feedback_issue_comment_has_operator_reply() {
  local -r repo="$1"
  local -r pr="$2"
  local -r comment_id="$3"
  local comments_json operator_login result

  operator_login="$(agent_review_authenticated_login)"
  comments_json="$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")"
  # Require an explicit citation of the target comment URL (reply-comment appends
  # "(In reply to <url>)"). A later unrelated operator note must not count.
  # yes/no (not jq -e) avoids runner [FAIL] noise on expected misses (#539).
  result="$(
    ar_runner_jq_file "agent-review feedback issue comment has reply" "${comments_json}" \
      --arg id "${comment_id}" \
      --arg operator "${operator_login}" \
      -r '
        . as $all
        | (first(range(0; length) | select($all[.] | .id == $id)) // null) as $idx
        | if $idx == null then "no"
          else
            ($all[$idx].html_url // "") as $url
            | if ($url | length) == 0 then "no"
              else
                [ range($idx + 1; length)
                  | $all[.]
                  | select(.login == $operator)
                  | select((.body // "") | index("(In reply to " + $url + ")") != null)
                ] | if length > 0 then "yes" else "no" end
              end
          end'
  )"
  [[ "${result}" == 'yes' ]]
}

agent_review_feedback_review_has_operator_reply() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local review_id="$4"
  local meta review_url comments_json operator_login anchor canonical result

  review_id="$(agent_review_feedback_normalize_review_id "${review_id}")"
  [[ -n "${review_id}" ]] || return 1

  meta="$(agent_review_feedback_review_meta_json "${snapshot}" "${review_id}")"
  review_url="$(ar_runner_jq_file "agent-review feedback review url for reply check" "${meta}" -r \
    '.url // ""')"
  canonical="$(agent_review_feedback_review_canonical_url "${repo}" "${pr}" "${review_id}")"
  if [[ -z "${review_url}" ]]; then
    review_url="${canonical}"
  fi

  operator_login="$(agent_review_authenticated_login)"
  comments_json="$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")"
  anchor="pullrequestreview-${review_id}"
  # Citation is SSOT — do not require created_at > submitted_at (clock skew / same-second
  # replies) and do not require the review to still be on the current head (#539).
  # Use yes/no (not jq -e) so expected misses do not leak runner [FAIL] diagnostics.
  result="$(
    ar_runner_jq_file "agent-review feedback review has targeted reply" "${comments_json}" \
      --arg operator "${operator_login}" \
      --arg url "${review_url}" \
      --arg canonical "${canonical}" \
      --arg anchor "${anchor}" \
      -r '
        def cites($body):
          (($url | length) > 0 and ($body | index("(In reply to " + $url + ")") != null))
          or (($canonical | length) > 0 and ($body | index("(In reply to " + $canonical + ")") != null))
          or ($body | index($anchor + ")") != null);
        [ .[]
          | select(.login == $operator)
          | select(cites(.body // ""))
        ] | if length > 0 then "yes" else "no" end'
  )"
  [[ "${result}" == 'yes' ]]
}

# Locals use target_* / comment_* names so nested call from
# agent_review_reply_issue_comment (local -r repo/pr/comment_id/body) cannot
# collide under Bash dynamic scoping.
agent_review_feedback_issue_comment_mark_quota_exhausted_if_notice() {
  local -r target_repo="$1"
  local -r target_pr="$2"
  local -r target_comment_id="$3"
  local comments_json comment_body html_url

  comments_json="$(agent_review_feedback_issue_comments_array_json "${target_repo}" "${target_pr}")"
  comment_body="$(ar_runner_jq_file "agent-review feedback quota notice body" "${comments_json}" \
    --arg id "${target_comment_id}" -r 'map(select(.id == $id)) | first | .body // ""')"
  html_url="$(ar_runner_jq_file "agent-review feedback quota notice url" "${comments_json}" \
    --arg id "${target_comment_id}" -r 'map(select(.id == $id)) | first | .html_url // ""')"
  if [[ -z "${comment_body}" ]]; then
    # API failures return [] (see agent_review_pr_issue_comments_json); warn so
    # operators notice best-effort quota detection was skipped.
    if [[ "${comments_json}" == '[]' ]]; then
      printf \
        'wait-for-agent-review: warning: empty issue comments while looking up comment %s for quota notice detection on %s#%s\n' \
        "${target_comment_id}" "${target_repo}" "${target_pr}" >&2
    fi
    return 1
  fi

  if agent_review_bugbot_quota_text_is_exhausted "${comment_body}"; then
    agent_review_quota_mark_exhausted_for_agent bugbot \
      "Bugbot quota notice on ${target_repo}#${target_pr} issue comment ${target_comment_id}." \
      "${html_url}" || true
    return 0
  fi
  if agent_review_copilot_quota_text_is_exhausted "${comment_body}"; then
    agent_review_quota_mark_exhausted_for_agent copilot \
      "Copilot quota notice on ${target_repo}#${target_pr} issue comment ${target_comment_id}." \
      "${html_url}" || true
    return 0
  fi

  return 1
}

agent_review_reply_issue_comment() {
  local -r repo="$1"
  local -r pr="$2"
  local -r comment_id="$3"
  local -r body="$4"
  local full_body comment_url

  agent_review_require_cmd gh
  agent_review_feedback_issue_comment_mark_quota_exhausted_if_notice "${repo}" "${pr}" "${comment_id}" || true
  [[ -n "${body}" ]] || agent_review_die 'reply-comment requires --body'
  comment_url="$(ar_runner_jq_file "agent-review feedback reply target url" \
    "$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")" \
    --arg id "${comment_id}" -r 'map(select(.id == $id)) | first | .html_url // ""')"
  if [[ -n "${comment_url}" ]]; then
    full_body="${body}

(In reply to ${comment_url})"
  else
    full_body="${body}"
  fi
  runner_exec "agent-review reply issue comment" -- gh pr comment "${pr}" --repo "${repo}" --body "${full_body}" >/dev/null
  printf 'Replied on issue comment %s (PR #%s)\n' "${comment_id}" "${pr}" >&2
}

agent_review_reply_pull_request_review() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local review_id="$4"
  local -r body="$5"
  local meta review_url full_body

  agent_review_require_cmd gh
  [[ -n "${body}" ]] || agent_review_die 'reply-comment --review-id requires --body'
  review_id="$(agent_review_feedback_normalize_review_id "${review_id}")"
  [[ -n "${review_id}" ]] || agent_review_die 'reply-comment --review-id requires a review id'

  meta="$(agent_review_feedback_review_meta_json "${snapshot}" "${review_id}")"
  review_url="$(ar_runner_jq_file "agent-review feedback reply-review url" "${meta}" -r \
    '.url // ""')"
  if [[ -z "${review_url}" ]]; then
    review_url="$(agent_review_feedback_review_canonical_url "${repo}" "${pr}" "${review_id}")"
  fi
  full_body="${body}

(In reply to ${review_url})"
  # Keep gh on the same physical line as runner_exec so runner-adoption ratchet sees the wrap.
  runner_exec "agent-review reply pull request review" -- gh pr comment "${pr}" --repo "${repo}" --body "${full_body}" >/dev/null
  printf 'Replied on pull request review %s (PR #%s)\n' "${review_id}" "${pr}" >&2
}

agent_review_resolve_issue_comment() {
  local -r repo="$1"
  local -r pr="$2"
  local -r comment_id="$3"
  local force="${4:-0}"

  if [[ "${force}" != '1' ]]; then
    if ! agent_review_feedback_issue_comment_has_operator_reply "${repo}" "${pr}" "${comment_id}"; then
      agent_review_die "issue comment ${comment_id} has no operator reply — run reply-comment before resolve-comment"
    fi
  fi
  agent_review_feedback_issue_comment_mark_quota_exhausted_if_notice "${repo}" "${pr}" "${comment_id}" || true
  agent_review_feedback_mark_issue_comment_resolved "${repo}" "${pr}" "${comment_id}"
  printf 'Resolved issue comment %s\n' "${comment_id}" >&2
}

agent_review_resolve_pull_request_review() {
  local -r repo="$1"
  local -r pr="$2"
  local -r snapshot="$3"
  local -r review_id="$4"
  local force="${5:-0}"

  if [[ "${force}" != '1' ]]; then
    if ! agent_review_feedback_review_has_operator_reply "${repo}" "${pr}" "${snapshot}" "${review_id}"; then
      agent_review_die "pull request review ${review_id} has no operator reply — run reply-comment --review-id before resolve-comment"
    fi
  fi
  agent_review_feedback_mark_review_resolved "${repo}" "${pr}" "${review_id}"
  printf 'Resolved pull request review %s\n' "${review_id}" >&2
}

# True when the active agent profile has a non-probe issue comment on the current head.
agent_review_feedback_agent_issue_comment_on_head() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local body short_head login_regex comments_json

  if declare -F agent_review_profile_fresh_on_head >/dev/null 2>&1; then
    if agent_review_profile_fresh_on_head '{}' "${head}" "${repo}" "${pr}"; then
      return 0
    fi
  fi
  login_regex="${agent_review_profile_request_login_regex:-}"
  [[ -n "${login_regex}" ]] || return 1
  comments_json="$(agent_review_feedback_issue_comments_array_json "${repo}" "${pr}")"
  body="$(ar_runner_jq_file "agent-review feedback latest agent issue body" "${comments_json}" \
    --arg re "${login_regex}" -r '
      [ .[] | select((.login // "") | test($re;"i")) ] | last | .body // ""')"
  [[ -n "${body}" ]] || return 1
  if agent_review_feedback_issue_comment_is_probe "${body}"; then
    return 1
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    return 0
  fi
  short_head="${head:0:7}"
  [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]
}
