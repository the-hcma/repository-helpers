#!/usr/bin/env bash
# timer-singleton-lock — advisory flock for timer-driven oneshot entry scripts.
#
# Timer units can overlap (Persistent catch-up + OnCalendar, manual systemctl
# start while a run is active, or a stale default.target link on older installs).
# Each timer entry script must call timer_singleton_acquire_lock before doing work
# so the loser exits 0 and logs a skip line instead of sending a report.
set -euo pipefail

# timer_singleton_acquire_lock <lock_file> <log_file> <service_label>
# Hold an exclusive lock for the full run. Exit 0 with a log line when locked.
timer_singleton_acquire_lock() {
  local -r lock_file="$1"
  local -r log_file="$2"
  local -r service_label="$3"
  local lock_dir
  local lock_fd

  lock_dir="$(dirname "$lock_file")"
  mkdir -p "$lock_dir"
  # Bash picks an unused fd ({lock_fd}) so we never clobber a fixed number the
  # caller may already use (e.g. exec 9>). The fd stays open until this shell exits.
  exec {lock_fd}>"$lock_file"
  if ! flock --nonblock "${lock_fd}"; then
    printf 'Skipped: another %s run is already in progress (%s)\n' \
      "$service_label" "$(date -Is)" >>"$log_file"
    exit 0
  fi
}
