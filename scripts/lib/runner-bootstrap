#!/usr/bin/env bash
# scripts/lib/runner-bootstrap — standard runner session setup for scripts/*.
#
# Usage (after resolving script_dir):
#   source "${script_dir}/lib/runner-bootstrap"
set -euo pipefail

_runner_bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${_runner_bootstrap_dir}/runner"

runner_session_begin
trap 'runner_session_end' EXIT
