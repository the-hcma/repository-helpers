#!/usr/bin/env bash
# scripts/lib/runner-bootstrap — standard runner session setup for scripts/*.
#
# Begins a runner session, records command artifacts under RUNNER_SESSION_DIR, and
# removes the session directory on EXIT unless RUNNER_SESSION_KEEP=1. Chains with
# any EXIT trap already registered before this file is sourced.
#
# Nested executables: this file drops any inherited RUNNER_SESSION_DIR and begins
# a session owned by this process so the child's EXIT trap cannot rm -rf the
# parent's capture tree (repository-helpers#527 / #520 / #540). Re-sourcing in
# the same shell is a no-op once bootstrap is active.
#
# Usage (after resolving script_dir):
#   source "${script_dir}/lib/runner-bootstrap"
set -euo pipefail

# Already bootstrapped this shell — keep the session we own.
if [[ -n "${_RUNNER_BOOTSTRAP_ACTIVE:-}" ]]; then
  return 0
fi

_runner_bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _runner_bootstrap_dir
# shellcheck disable=SC1091
source "${_runner_bootstrap_dir}/runner"

_runner_bootstrap_prior_exit=''

_runner_bootstrap_capture_exit_trap() {
  local trap_line
  trap_line="$(trap -p EXIT 2>/dev/null || true)"
  if [[ -z "$trap_line" ]]; then
    return 0
  fi
  _runner_bootstrap_prior_exit="$(printf '%s' "$trap_line" | sed -E "s/^trap -- '(.*)' EXIT/\1/")"
  if [[ "$_runner_bootstrap_prior_exit" == "$trap_line" ]]; then
    _runner_bootstrap_prior_exit="$(printf '%s' "$trap_line" | sed -E 's/^trap -- "(.*)" EXIT/\1/')"
  fi
}

_runner_bootstrap_on_exit() {
  # Capture first: session teardown must never replace the script's exit status.
  local exit_code=$?
  runner_session_end || true
  if [[ -n "${_runner_bootstrap_prior_exit:-}" ]]; then
    eval "${_runner_bootstrap_prior_exit}" || true
  fi
  return "$exit_code"
}

# Drop an inherited parent session before begin. Do not unset RUNNER_SESSION_KEEP
# — operators may export it for a standalone debug run of this process.
unset RUNNER_SESSION_DIR
_runner_bootstrap_capture_exit_trap
runner_session_begin
_RUNNER_BOOTSTRAP_ACTIVE=1
trap '_runner_bootstrap_on_exit' EXIT
