#!/usr/bin/env bash
# shellcheck shell=bash
# github-markdown — lightweight lint for agent-authored GitHub Markdown bodies.
#
# Catches three GitHub-body failure modes (repository-helpers#651 / #653 / #660):
#   1. Assemblies with literal \\n escapes or missing blank lines (collapsed
#      lists/headings/fences).
#   2. Hand-wrapped paragraphs: consecutive prose lines joined by a single
#      newline. GitHub's issue/PR/comment renderer treats that lone \\n as a
#      visible hard break (unlike the file/blob CommonMark soft-break-as-space
#      rule), so ~80-column wraps render as a column of short lines.
#   3. Closing keywords (fix/close/resolve, any tense) that sit near an issue
#      reference but are not immediately adjacent to it — natural-language
#      phrasing that reads as intentional but never triggers GitHub's
#      auto-link/auto-close.
#
# Non-goals: full Markdown linter/formatter dependency.
set -euo pipefail

if declare -F ghm_lint_file >/dev/null 2>&1; then
  return 0
fi

# Fence markers as single-quoted literals (backticks in unquoted =~ are
# command substitution).
_ghm_fence_tick='```'
_ghm_fence_tilde='~~~'
readonly _ghm_fence_tick _ghm_fence_tilde

# GitHub closing keywords (any tense) and the issue-reference shape (#NNN or
# OWNER/REPO#NNN) it must sit directly next to — with nothing else in
# between — to auto-link/auto-close (repository-helpers#660).
_ghm_closing_keyword_re='(close|closes|closed|fix|fixes|fixed|resolve|resolves|resolved)'
_ghm_issue_ref_re='([a-z0-9_.-]+/[a-z0-9_.-]+)?#[0-9]+'
readonly _ghm_closing_keyword_re _ghm_issue_ref_re

# ghm_fence_parse <trimmed-line>
# Prints "char|len|kind" when the line is a fence (kind=open|close).
# open: optional language tag; close: no info string after the markers.
ghm_fence_parse() {
  local -r trimmed="$1"
  local char='' rest='' len=0 i c

  if [[ -z "$trimmed" ]]; then
    return 1
  fi
  c="${trimmed:0:1}"
  if [[ "$c" != '`' && "$c" != '~' ]]; then
    return 1
  fi
  char="$c"
  i=0
  while (( i < ${#trimmed} )) && [[ "${trimmed:i:1}" == "$char" ]]; do
    i=$((i + 1))
  done
  len=$i
  if (( len < 3 )); then
    return 1
  fi
  rest="${trimmed:len}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  rest="${rest%"${rest##*[![:space:]]}"}"
  if [[ -z "$rest" ]]; then
    printf '%s|%s|close\n' "$char" "$len"
    return 0
  fi
  if [[ "$rest" =~ ^[a-zA-Z0-9_+-]+$ ]]; then
    printf '%s|%s|open\n' "$char" "$len"
    return 0
  fi
  return 1
}

# ghm_strip_inline_code_spans <raw-line>
# Removes backtick-delimited inline code spans so a keyword or reference
# quoted for illustration (`` `fix` ``, `` `#651` ``) is not mistaken for real
# closing-keyword usage. Multi-line fenced code blocks are tracked separately
# by the fence-parsing loop in ghm_lint_text; this only handles a single
# line's inline spans. An unmatched trailing backtick is left as-is (fail
# open: keep the text rather than silently dropping it).
ghm_strip_inline_code_spans() {
  local line="$1" out='' before after

  while [[ "$line" == *'`'* ]]; do
    before="${line%%\`*}"
    after="${line#*\`}"
    if [[ "$after" != *'`'* ]]; then
      out+="${before}"'`'"${after}"
      line=''
      break
    fi
    out+="$before"
    line="${after#*\`}"
  done
  out+="$line"
  printf '%s' "$out"
}

# ghm_line_has_unlinked_closing_keyword <raw-line>
# True when the line uses a GitHub closing keyword (fix/close/resolve, any
# tense) together with an issue reference (#NNN or OWNER/REPO#NNN), but at
# least one such reference is not in the exact adjacent form GitHub requires
# to auto-link/close ("fixes #123" with nothing else in between). GitHub
# requires its own keyword before *each* reference ("resolves #10, resolves
# #11", not "resolves #10, #11"), so every reference on the line is checked
# individually. Catches natural-language phrasing like "this closes that gap
# (#651's remaining scope…)" that reads as intentional but never links
# (repository-helpers#660). Inline code spans are stripped first so
# illustrative text quoting the keyword or a reference in backticks is not
# mistaken for real usage. A bare "#" not preceded by a word boundary (e.g.
# "C#8") is not treated as an issue reference. Line-scoped heuristic: a
# keyword and reference split across two hand-wrapped lines are not caught
# here (the hand-wrap itself is already flagged separately).
ghm_line_has_unlinked_closing_keyword() {
  local -r has_keyword_re='[^a-z]'"${_ghm_closing_keyword_re}"'[^a-z]'
  local -r adjacent_re='(^|[^a-z])'"${_ghm_closing_keyword_re}"'[:]?[[:space:]]*$'
  local stripped padded remaining prefix matched before boundary_char
  local -i consumed=0 match_start=0 found_ref=0

  stripped="$(ghm_strip_inline_code_spans "$1")"
  padded=" ${stripped,,} "
  [[ "$padded" =~ $has_keyword_re ]] || return 1

  remaining="$padded"
  while [[ "$remaining" =~ $_ghm_issue_ref_re ]]; do
    matched="${BASH_REMATCH[0]}"
    before="${remaining%%"$matched"*}"
    match_start=$(( consumed + ${#before} ))

    boundary_char=''
    if (( match_start > 0 )); then
      boundary_char="${padded:match_start-1:1}"
    fi
    if [[ "$boundary_char" =~ [a-z0-9_./-] ]]; then
      # Not a real reference (e.g. the "#8" in "C#8") — skip past it.
      consumed=$(( match_start + ${#matched} ))
      remaining="${padded:consumed}"
      continue
    fi

    found_ref=1
    prefix="${padded:0:match_start}"
    if [[ ! "$prefix" =~ $adjacent_re ]]; then
      return 0
    fi
    consumed=$(( match_start + ${#matched} ))
    remaining="${padded:consumed}"
  done

  (( found_ref == 1 )) || return 1
  return 1
}

# ghm_line_is_prose <raw-line>
# True when the line is ordinary paragraph text (not a list/heading/quote/
# table/HTML/thematic break, and not an indented continuation). Used to detect
# hand-wrapped paragraphs: two consecutive prose lines without a blank line.
ghm_line_is_prose() {
  local -r raw="$1"
  local trimmed
  local list_re heading_re link_ref_re rule_re

  trimmed="${raw#"${raw%%[![:space:]]*}"}"
  [[ -n "$trimmed" ]] || return 1

  # Indented lines are list/blockquote continuations or indented code.
  if [[ "$raw" =~ ^[[:space:]] ]]; then
    return 1
  fi

  heading_re='^#{1,6}[[:space:]]'
  if [[ "$trimmed" =~ $heading_re ]]; then
    return 1
  fi
  # GFM ordered lists allow "." or ")" after the digits (keep regex in a
  # variable so ")" is not a [[ ]] parse error).
  list_re='^([-*+]|[[:digit:]]+[.)])[[:space:]]'
  if [[ "$trimmed" =~ $list_re ]]; then
    return 1
  fi
  if [[ "$trimmed" == '>'* ]]; then
    return 1
  fi
  if [[ "$trimmed" == '|'* ]]; then
    return 1
  fi
  if [[ "$trimmed" == '<'* ]]; then
    return 1
  fi
  link_ref_re='^\[.+\]:[[:space:]]'
  if [[ "$trimmed" =~ $link_ref_re ]]; then
    return 1
  fi
  # Thematic breaks and setext underlines (=== / --- / *** / ___).
  rule_re='^(-{3,}|\*{3,}|_{3,}|={3,})[[:space:]]*$'
  if [[ "$trimmed" =~ $rule_re ]]; then
    return 1
  fi
  return 0
}

# ghm_lint_file <path>
# Lint a Markdown file. Prints findings to stderr; exit 1 when dirty.
ghm_lint_file() {
  local -r path="$1"
  local out rc

  [[ -n "$path" ]] || {
    printf 'ERROR: ghm_lint_file requires a path\n' >&2
    return 1
  }
  [[ -f "$path" ]] || {
    printf 'ERROR: ghm_lint_file: not a file: %s\n' "$path" >&2
    return 1
  }

  out=''
  rc=0
  out="$(ghm_lint_text <"$path")" || rc=$?
  if (( rc != 0 )); then
    printf 'ERROR: GITHUB_MARKDOWN_LINT path=%s\n' "$path" >&2
    printf '%s\n' "$out" >&2
    return 1
  fi
  return 0
}

# ghm_lint_repo_file <path>
# Lint a Markdown file committed to a repository for hand-wrapped paragraphs,
# list items and blockquotes only (see ghm_unwrap_text). Prints findings to
# stderr; exit 1 when dirty.
ghm_lint_repo_file() {
  local -r path="$1"
  local out rc

  if [[ ! -f "$path" ]]; then
    printf 'ERROR: ghm_lint_repo_file: not a file: %s\n' "$path" >&2
    return 1
  fi

  out=''
  rc=0
  out="$(ghm_unwrap_text lint <"$path")" || rc=$?
  if (( rc != 0 )); then
    printf 'ERROR: GITHUB_MARKDOWN_WRAP path=%s\n' "$path" >&2
    printf '%s\n' "$out" >&2
    return 1
  fi
  return 0
}

# ghm_lint_text
# Reads Markdown on stdin. Prints "line:N: message" findings to stdout.
# Exit 0 when clean; 1 when any finding.
ghm_lint_text() {
  local line prev_blank=1 in_fence=0 lineno=0 findings=0
  local trimmed list_joined_re fence_info
  local fence_char='' fence_len=0 need_blank_after_fence=0
  local parsed_char parsed_len parsed_kind rest_info
  local prev_prose=0

  # Joined list items produce two markers on one line (e.g. "- a - b").
  # A single "item 1. below" or "diff - it works" is ordinary prose.
  list_joined_re='(^|[[:space:]])(-|\*|[[:digit:]]+\.)[[:space:]].+([[:space:]](-|\*|[[:digit:]]+\.)[[:space:]])'

  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    trimmed="${line#"${line%%[![:space:]]*}"}"

    fence_info=''
    if fence_info="$(ghm_fence_parse "$trimmed")"; then
      parsed_char="${fence_info%%|*}"
      rest_info="${fence_info#*|}"
      parsed_len="${rest_info%%|*}"
      parsed_kind="${rest_info#*|}"

      if (( in_fence == 0 )); then
        # Any fence line opens (``` / ```bash / ~~~~).
        if (( prev_blank == 0 )) && (( lineno > 1 )); then
          printf 'line:%d: fenced code block should be preceded by a blank line\n' "$lineno"
          findings=$((findings + 1))
        fi
        in_fence=1
        fence_char="$parsed_char"
        fence_len=$parsed_len
        need_blank_after_fence=0
        prev_blank=0
        prev_prose=0
        continue
      fi

      # Close only with same marker family, length >= opening, no info string.
      if [[ "$parsed_char" == "$fence_char" ]] \
        && (( parsed_len >= fence_len )) \
        && [[ "$parsed_kind" == 'close' ]]; then
        in_fence=0
        fence_char=''
        fence_len=0
        need_blank_after_fence=1
        prev_blank=0
        prev_prose=0
        continue
      fi
    fi

    # Fence marker present but not a clean fence line (e.g. joined onto prose).
    if (( in_fence == 0 )) \
      && { [[ "$line" == *" ${_ghm_fence_tick}"* ]] || [[ "$line" == *" ${_ghm_fence_tilde}"* ]]; }; then
      printf 'line:%d: fenced code marker is not at line start\n' "$lineno"
      findings=$((findings + 1))
    fi

    if (( in_fence )); then
      prev_blank=0
      prev_prose=0
      continue
    fi

    # Literal \n sequences outside fences (escaped-newline mangling). Inside
    # fences, \n is ordinary program text (printf, sed, …).
    if [[ "$line" == *'\n'* ]]; then
      printf 'line:%d: literal \\n escape in body (use a real newline / --body-file)\n' "$lineno"
      findings=$((findings + 1))
    fi

    if [[ -z "$trimmed" ]]; then
      prev_blank=1
      need_blank_after_fence=0
      prev_prose=0
      continue
    fi

    if (( need_blank_after_fence )); then
      printf 'line:%d: content after fenced code block should be preceded by a blank line\n' "$lineno"
      findings=$((findings + 1))
      need_blank_after_fence=0
    fi

    # Heading not preceded by blank line (except first line).
    if [[ "$trimmed" =~ ^#{1,6}[[:space:]] ]]; then
      if (( prev_blank == 0 )) && (( lineno > 1 )); then
        printf 'line:%d: heading should be preceded by a blank line\n' "$lineno"
        findings=$((findings + 1))
      fi
    fi

    # Joined list items (two markers on one line).
    if [[ "$line" =~ $list_joined_re ]]; then
      printf 'line:%d: list marker appears mid-line (items may have been joined)\n' "$lineno"
      findings=$((findings + 1))
    fi

    # Closing keyword near an issue reference but not adjacent to it — GitHub
    # only auto-links/closes on "fixes #123" with nothing in between (#660).
    if ghm_line_has_unlinked_closing_keyword "$line"; then
      printf 'line:%d: closing keyword near an issue reference but not immediately next to it (GitHub only auto-closes on e.g. "fixes #123", not "fixes … #123")\n' \
        "$lineno"
      findings=$((findings + 1))
    fi

    # Hand-wrapped paragraph: two consecutive prose lines with no blank line.
    # GitHub issue/PR/comment UI hard-breaks on the lone newline (#653).
    if ghm_line_is_prose "$line"; then
      if (( prev_prose )); then
        printf 'line:%d: hand-wrapped paragraph (join into one line, or blank-line-separate paragraphs)\n' \
          "$lineno"
        findings=$((findings + 1))
      fi
      prev_prose=1
    else
      prev_prose=0
    fi

    prev_blank=0
  done

  if (( findings > 0 )); then
    return 1
  fi
  return 0
}

# ghm_unwrap_file <path>
# Rewrite a committed Markdown file in place with ghm_unwrap_text fix. The
# file is not rewritten when nothing would change. Exit 1, with the findings
# on stderr, when lines remain that fix will not join (lazy list
# continuations).
ghm_unwrap_file() {
  local -r path="$1"
  local original unwrapped

  if [[ ! -f "$path" ]]; then
    printf 'ERROR: ghm_unwrap_file: not a file: %s\n' "$path" >&2
    return 1
  fi
  # read -d '' keeps trailing blank lines that $(...) would strip.
  IFS= read -r -d '' original <"$path" || :
  IFS= read -r -d '' unwrapped < <(ghm_unwrap_text fix <"$path") || :
  if [[ -n "$original" && "$original" != *$'\n' ]]; then
    unwrapped="${unwrapped%$'\n'}"
  fi
  if [[ "$unwrapped" != "$original" ]]; then
    printf '%s' "$unwrapped" >"$path"
  fi
  ghm_lint_repo_file "$path"
}

# ghm_unwrap_text <fix|lint>
# Reads Markdown committed to a repository on stdin and finds hand-wrapped
# paragraphs, list items and blockquotes: a line that only continues the
# paragraph above it (repository-helpers#671).
#   fix  — print the Markdown with each continuation joined onto its paragraph
#          (one physical line per paragraph / list item / blockquote).
#   lint — print "line:N: ..." for each continuation line; exit 1 when any.
# Never joins YAML front matter, fenced or indented code, HTML blocks
# (including multi-line comments), tables, headings, thematic breaks, link
# reference definitions, GitHub alert markers (> [!NOTE]), lines after a hard
# break (also with CRLF endings), lazy blockquote lines, or any line that
# starts a new block. Leading tabs count to the next multiple-of-4 column.
# A lazy list continuation (indented less than the open item's text) is
# ambiguous — usually a new paragraph missing its blank line — so fix leaves
# it on its own line and lint reports it for the author to resolve
# (repository-helpers#679).
# Joining a soft break with a space leaves the rendered HTML unchanged apart
# from whitespace.
ghm_unwrap_text() {
  local -r mode="$1"
  local -r quote_re='^[[:space:]]*>[[:space:]]?(.*)$'
  local -r fence_re='^(`{3,}|~{3,})(.*)$'
  local -r heading_re='^#{1,6}([[:space:]]|$)'
  local -r link_ref_re='^\[[^]]+\]:'
  local -r list_re='^([-*+]|[0-9]{1,9}[.)])(([[:space:]]+)(.*))?$'
  local -r alert_re='^\[![A-Za-z]+\][[:space:]]*$'
  local -r autolink_re='^<([A-Za-z][A-Za-z0-9+.-]{1,31}:[^[:space:]<>]*|[^[:space:]<>@]+@[^[:space:]<>]+)>'
  local -a lines=() out=()
  local line delim rest trimmed next prev run info marker spaces content fence_char=''
  local -i n=0 i=0 last=0 depth=0 indent=0 findings=0 threshold=0
  local -i in_front=0 in_fence=0 fence_len=0 in_comment=0 in_html=0 in_table=0
  local -i in_code=0 code_indent=0 in_list=0 content_indent=0
  local -i para_open=0 para_depth=0 prev_blank=1 is_block=0

  if [[ "$mode" != 'fix' && "$mode" != 'lint' ]]; then
    printf 'ERROR: ghm_unwrap_text: mode must be fix or lint (got %s)\n' "$mode" >&2
    return 1
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    lines+=("$line")
  done
  n=${#lines[@]}

  for (( i = 0; i < n; i++ )); do
    line="${lines[i]}"

    delim="${line#$'\xEF\xBB\xBF'}"
    delim="${delim%"${delim##*[![:space:]]}"}"
    if (( i == 0 )) && [[ "$delim" == '---' ]]; then
      in_front=1
      out+=("$line")
      continue
    fi
    if (( in_front )); then
      out+=("$line")
      if [[ "$delim" == '---' || "$delim" == '...' ]]; then
        in_front=0
      fi
      continue
    fi

    rest="$line"
    depth=0
    while [[ "$rest" =~ $quote_re ]]; do
      rest="${BASH_REMATCH[1]}"
      depth+=1
    done
    trimmed="${rest#"${rest%%[![:space:]]*}"}"
    _ghm_column_after 0 "${rest:0:${#rest}-${#trimmed}}" indent
    run=''
    info=''
    if [[ "$trimmed" =~ $fence_re ]]; then
      run="${BASH_REMATCH[1]}"
      info="${BASH_REMATCH[2]}"
    fi

    if (( in_fence )); then
      out+=("$line")
      if [[ -n "$run" && "${run:0:1}" == "$fence_char" ]] \
        && (( ${#run} >= fence_len )) \
        && [[ -z "${info//[[:space:]]/}" ]]; then
        in_fence=0
      fi
      continue
    fi
    if (( in_comment )); then
      out+=("$line")
      if [[ "$line" == *'-->'* ]]; then
        in_comment=0
      fi
      continue
    fi
    if (( in_html || in_table )) && [[ -n "$trimmed" ]]; then
      out+=("$line")
      continue
    fi
    in_html=0
    in_table=0
    if (( in_code )); then
      if [[ -z "$trimmed" ]] || (( indent >= code_indent )); then
        out+=("$line")
        continue
      fi
      in_code=0
    fi

    if [[ -z "$trimmed" ]]; then
      out+=("$line")
      para_open=0
      prev_blank=1
      continue
    fi

    threshold=4
    if (( in_list )); then
      threshold=$(( content_indent + 4 ))
    fi
    if (( ! para_open && indent >= threshold )); then
      in_code=1
      code_indent=$threshold
      out+=("$line")
      prev_blank=0
      continue
    fi

    if [[ -n "$run" ]] && { [[ "${run:0:1}" == '~' ]] || [[ "$info" != *'`'* ]]; }; then
      in_fence=1
      fence_char="${run:0:1}"
      fence_len=${#run}
      out+=("$line")
      para_open=0
      prev_blank=0
      continue
    fi

    is_block=1
    next=''
    if (( i + 1 < n )); then
      next="${lines[i + 1]}"
      next="${next#"${next%%[![:space:]>]*}"}"
    fi
    if [[ "$trimmed" == '<!--'* && "$trimmed" != *'-->'* ]]; then
      in_comment=1
    elif [[ "$trimmed" == '<'* && ! "$trimmed" =~ $autolink_re ]]; then
      in_html=1
    elif [[ "$trimmed" =~ $heading_re ]] || _ghm_is_thematic_or_setext "$trimmed"; then
      :
    elif [[ "$trimmed" == '|'* ]] || _ghm_is_table_delimiter "$trimmed" \
      || _ghm_is_table_delimiter "$next"; then
      in_table=1
    elif [[ "$trimmed" =~ $link_ref_re || "$trimmed" =~ $alert_re ]]; then
      :
    else
      is_block=0
    fi
    if (( is_block )); then
      out+=("$line")
      para_open=0
      prev_blank=0
      if (( indent < content_indent )); then
        in_list=0
      fi
      continue
    fi

    if [[ "$trimmed" =~ $list_re ]]; then
      marker="${BASH_REMATCH[1]}"
      spaces="${BASH_REMATCH[3]}"
      content="${BASH_REMATCH[4]}"
      in_list=1
      _ghm_column_after "$(( indent + ${#marker} ))" "$spaces" content_indent
      if (( content_indent - indent - ${#marker} > 4 )); then
        content_indent=$(( indent + ${#marker} + 1 ))
      fi
      out+=("$line")
      para_open=0
      if [[ -n "$content" ]]; then
        para_open=1
      fi
      para_depth=$depth
      prev_blank=0
      continue
    fi

    if (( prev_blank && in_list && indent < content_indent )); then
      in_list=0
    fi
    last=$(( ${#out[@]} - 1 ))
    if (( para_open && depth == para_depth && in_list && indent < content_indent )) \
      && ! _ghm_ends_with_hard_break "${out[last]}"; then
      if [[ "$mode" == 'lint' ]]; then
        printf 'line:%d: lazy continuation of the list item above (not joined by --fix; add a blank line before it for a new paragraph, or indent it to the item text to keep it in the item)\n' \
          "$(( i + 1 ))"
        findings+=1
      fi
      out+=("$line")
    elif (( para_open && depth == para_depth )) && ! _ghm_ends_with_hard_break "${out[last]}"; then
      if [[ "$mode" == 'lint' ]]; then
        printf 'line:%d: hand-wrapped line continues the previous line (one line per paragraph, list item or blockquote; fix with scripts/lint-github-markdown --repo-files --fix)\n' \
          "$(( i + 1 ))"
        findings+=1
      fi
      prev="${out[last]}"
      prev="${prev%"${prev##*[![:space:]]}"}"
      out[last]="${prev} ${trimmed}"
    elif (( para_open && depth < para_depth )); then
      out+=("$line")
      para_open=0
    else
      out+=("$line")
      para_open=1
      para_depth=$depth
    fi
    prev_blank=0
  done

  if [[ "$mode" == 'fix' ]]; then
    if (( ${#out[@]} > 0 )); then
      printf '%s\n' "${out[@]}"
    fi
    return 0
  fi
  if (( findings > 0 )); then
    return 1
  fi
  return 0
}

# _ghm_column_after <start_column> <whitespace> <out_var>
# Sets out_var to the visual column reached after whitespace that begins at
# start_column, expanding each tab to the next multiple of 4 (CommonMark).
_ghm_column_after() {
  local -r start="$1"
  local -r ws="$2"
  local -n _ghm_column_out="$3"
  local -i col="$start" j=0

  for (( j = 0; j < ${#ws}; j++ )); do
    if [[ "${ws:j:1}" == $'\t' ]]; then
      col=$(( col + 4 - col % 4 ))
    else
      col+=1
    fi
  done
  _ghm_column_out=$col
}

_ghm_ends_with_hard_break() {
  local -r text="${1%$'\r'}"
  [[ "$text" == *"\\" || "$text" == *'  ' ]]
}

# True for a thematic break (--- / *** / ___, spaces allowed between markers)
# or a setext heading underline (=== / ---).
_ghm_is_thematic_or_setext() {
  local -r text="$1"
  local -r setext_re='^(=+|-+)[[:space:]]*$'
  local -r dash_re='^(-[[:space:]]*){3,}$'
  local -r star_re='^(\*[[:space:]]*){3,}$'
  local -r under_re='^(_[[:space:]]*){3,}$'

  [[ "$text" =~ $setext_re || "$text" =~ $dash_re || "$text" =~ $star_re \
    || "$text" =~ $under_re ]]
}

# True for a GFM table delimiter row (| --- | :-: |); requires a pipe so a
# setext underline is not mistaken for one.
_ghm_is_table_delimiter() {
  local -r text="$1"
  local -r cell='[[:space:]]*:?-+:?[[:space:]]*'
  local -r delim_re="^\\|?${cell}(\\|${cell})*\\|?[[:space:]]*$"

  [[ "$text" == *'|'* && "$text" =~ $delim_re ]]
}
