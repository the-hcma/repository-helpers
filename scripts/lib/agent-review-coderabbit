#!/usr/bin/env bash
# agent-review-coderabbit — what CodeRabbit did with a head, and what the loop asked it (#717, #723).
#
# Two pure readers, kept out of the CodeRabbit profile so the loop can use them without switching the
# active agent profile:
#   * the head's CodeRabbit outcome ("Review completed" / "Finished" vs "Review rate limited"), the
#     reliable signal that a review ran (rate-limited heads end green with no review, and CodeRabbit also
#     posts empty stub reviews and thread replies). Older installs publish it as a commit status; current
#     ones publish only a `CodeRabbit` check run (#817), so both are read and the check run wins;
#   * the loop's "@coderabbitai full review" asks on a PR and CodeRabbit's replies to them, so a
#     rate-limited ask is repeated after the wait CodeRabbit stated instead of being counted as sent.
# The agent_review_default_coderabbit_* constants are assigned in scripts/lib/agent-review, which
# sources this lib; they exist by the time any function here runs.
# shellcheck disable=SC2154

# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/runner-ensure"

# agent_review_coderabbit_config_in_repo <repo> <ref>
# Exit 0 when the repository root at <ref> holds a CodeRabbit config (.coderabbit.yaml / .coderabbit.yml),
# 1 when it does not, 2 when the root cannot be listed. A config file is repository-level evidence that
# CodeRabbit is meant to review here, even before it has said anything on the PR (#759).
agent_review_coderabbit_config_in_repo() {
  local -r repo="$1"
  local -r ref="$2"
  local listing_json found

  if ! listing_json="$(ar_runner_gh_api_stream "agent-review coderabbit config listing" \
    "repos/${repo}/contents?ref=${ref}" 2>/dev/null)" || [[ -z "${listing_json}" ]]; then
    return 2
  fi
  if ! found="$(ar_runner_jq_file "coderabbit config in repo" "${listing_json}" -r '
    (if type == "array" then . else [] end)
    | any(.[]; (.name // "") | test("^\\.coderabbit\\.ya?ml$"))')"; then
    return 2
  fi
  [[ "${found}" == 'true' ]]
}

# agent_review_coderabbit_full_review_may_post <status-line> <now_epoch>
# Decides from agent_review_coderabbit_full_review_status_from_comments output whether a (new)
# ask may be posted: 0 yes, 1 no (CodeRabbit is working on it, its stated wait has not passed, or
# the attempts are used up). Never asks again while CodeRabbit says to wait (#723).
agent_review_coderabbit_full_review_may_post() {
  local -r line="${1:-}"
  local -r now="${2:-0}"
  local status attempts ready asked

  IFS=$'\t' read -r status attempts ready asked <<<"${line}"
  : "${attempts:=0}" "${ready:=0}" "${asked:=0}"
  case "${status}" in
    none)
      return 0
      ;;
    pending)
      # An ask CodeRabbit never answered is not repeated: an agent that is not configured on the
      # repository would be asked again every TTL for the whole loop (#759). Only an explicit
      # "rate limited" reply earns another ask.
      return 1
      ;;
    rate_limited)
      if (( attempts < agent_review_default_coderabbit_full_review_max_attempts )) \
        && (( now >= ready + agent_review_default_coderabbit_full_review_retry_margin_s )); then
        return 0
      fi
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

# agent_review_coderabbit_full_review_status_from_comments <comments-json> <head_sha>
# Reads the PR's issue comments and prints one tab-separated line:
#   <status> <attempts> <ready_epoch> <asked_epoch>
# status is one of
#   none          no ask for this head is on the PR
#   pending       the newest ask has no CodeRabbit reply yet
#   accepted      CodeRabbit replied that it ran (or started) the review
#   rate_limited  CodeRabbit replied "Review rate limited"; ready_epoch is when it said to retry
# A manual retry marker (coderabbit-full-retry) counts as an ask like the loop's own.
agent_review_coderabbit_full_review_status_from_comments() {
  local -r comments_json="${1:-}"
  local -r head="${2:-}"
  local base manual

  base="$(agent_review_coderabbit_full_review_marker "${head}")"
  manual="wait-for-agent-review:coderabbit-full-retry:${head}"
  # shellcheck disable=SC2016  # jq program uses $base / $manual from --arg
  ar_runner_jq_file "coderabbit full-review status" "${comments_json}" -r --slurp \
    --arg base "${base}" --arg manual "${manual}" '
    def ts: ((.created_at // "") | if . == "" then 0 else fromdateiso8601 end);
    def real_review:
      ((ascii_downcase) as $l
       | ($l | contains("walkthrough_start"))
         or ($l | contains("summarize by coderabbit"))
         or ($l | contains("review_stack_entry"))
         or ($l | test("actionable[[:space:]]+comments[[:space:]]+(posted|were[[:space:]]+generated)")));
    # A reply to a command carries the CodeRabbit reply markers; a markerless one is recognised the way
    # the profile does it (an ack phrase in a comment that is not a real review).
    def command_reply:
      ((.body // "") | test("auto-generated reply by coderabbit|command invocation"; "i"))
      or (((.body // "") | ascii_downcase) as $l
          | ((($l | contains("action performed")) or ($l | contains("full review finished"))
              or ($l | contains("action not completed")))
             and ((.body // "") | real_review | not)));
    def wait_secs:
      ((capture("available in (?<n>[0-9]+) (?<u>second|minute|hour)"; "i")? // null)
        | if . == null then 1800
          else ((.n | tonumber)
                * ((.u | ascii_downcase) as $u
                   | if $u == "hour" then 3600 elif $u == "minute" then 60 else 1 end))
          end);
    [ .[] | if type == "array" then .[] else . end ] as $all
    | ($all | map(select((.body // "") | (contains($base) or contains($manual))))
            | sort_by(.created_at // "")) as $asks
    | if ($asks | length) == 0 then ["none", 0, 0, 0]
      else
        ($asks | last) as $ask
        | ($all | map(select(((.user.login // "") | test("coderabbit|rabbit"; "i"))
                             and ((.created_at // "") > ($ask.created_at // ""))
                             and command_reply))
                | sort_by(.created_at // "")) as $replies
        | if ($replies | length) == 0 then ["pending", ($asks | length), 0, ($ask | ts)]
          else
            ($replies | last) as $reply
            | if (($reply.body // "") | test("rate limited|action not completed"; "i"))
              then ["rate_limited", ($asks | length), (($reply | ts) + (($reply.body // "") | wait_secs)),
                    ($ask | ts)]
              else ["accepted", ($asks | length), 0, ($ask | ts)] end
          end
      end
    | @tsv'
}

# agent_review_coderabbit_head_paused <repo> <head_sha> — live read of the head's statuses and check
# runs; exit 1 when neither read succeeds so a caller never resumes on a guess.
agent_review_coderabbit_head_paused() {
  local -r repo="$1"
  local -r head="$2"
  local statuses_json check_runs_json check_runs_line
  local statuses_ok=0 check_runs_ok=0

  if statuses_json="$(ar_runner_gh_api_stream "agent-review coderabbit head paused statuses" \
    "repos/${repo}/commits/${head}/statuses?per_page=50" 2>/dev/null)"; then
    statuses_ok=1
  fi
  if check_runs_json="$(ar_runner_gh_api_stream "agent-review coderabbit head paused check runs" \
    "repos/${repo}/commits/${head}/check-runs?check_name=CodeRabbit&per_page=100" 2>/dev/null)"; then
    check_runs_ok=1
  fi
  if (( statuses_ok == 0 && check_runs_ok == 0 )); then
    return 1
  fi
  # A CodeRabbit check run is the current outcome: decide from it alone, so an older "paused" commit status
  # cannot override a newer skipped, running or finished run. Statuses count only when there is no run.
  if (( check_runs_ok == 1 )); then
    check_runs_line="$(agent_review_coderabbit_head_status_from_check_runs "${check_runs_json}")" || check_runs_line=''
    if [[ -n "${check_runs_line}" && "${check_runs_line%%$'\t'*}" != 'none' ]]; then
      agent_review_coderabbit_head_paused_from_check_runs "${check_runs_json}"
      return $?
    fi
  fi
  (( statuses_ok == 1 )) && agent_review_coderabbit_head_paused_from_statuses "${statuses_json}"
}

# agent_review_coderabbit_head_paused_from_check_runs <check-runs-json>
# Exit 0 when the newest CodeRabbit check run on the head says the review is paused, 1 otherwise.
agent_review_coderabbit_head_paused_from_check_runs() {
  local -r check_runs_json="${1:-}"
  local paused

  if [[ -z "${check_runs_json}" || "${check_runs_json}" == 'null' ]]; then
    return 1
  fi
  # shellcheck disable=SC2016  # jq program text, not shell expansion
  paused="$(ar_runner_jq_file "coderabbit head paused check run" "${check_runs_json}" -r '
    (if type == "object" then (.check_runs // []) elif type == "array" then . else [] end)
    | map(select((.app.slug // "") | test("^coderabbitai$"; "i")))
    | sort_by([(.id // 0), (.started_at // .completed_at // "")]) | last
    | if . == null then false else ((.output.title // "") | test("paused"; "i")) end')" || return 1
  [[ "${paused}" == 'true' ]]
}

# agent_review_coderabbit_head_paused_from_statuses <statuses-json>
# Exit 0 when the newest CodeRabbit commit status on the head says the review is paused (its
# `auto_pause_after_reviewed_commits` setting stops on-push reviews on a PR with many commits), 1
# otherwise. The head status classifier calls a paused head `other`, as it does a skipped one; this
# tells the two apart, because only a paused review is resumed by `@coderabbitai full review` (#743).
agent_review_coderabbit_head_paused_from_statuses() {
  local -r statuses_json="${1:-}"
  local paused

  if [[ -z "${statuses_json}" || "${statuses_json}" == 'null' ]]; then
    return 1
  fi
  # shellcheck disable=SC2016  # jq program text, not shell expansion
  paused="$(ar_runner_jq_file "coderabbit head paused" "${statuses_json}" -r '
    (if type == "array" then . else [.] end)
    | map(select((.context // "") | test("coderabbit"; "i")))
    | sort_by(.updated_at // .created_at // "") | last
    | if . == null then false else ((.description // "") | test("paused"; "i")) end')" || return 1
  [[ "${paused}" == 'true' ]]
}

# agent_review_coderabbit_head_state <repo> <head_sha> — first field of agent_review_coderabbit_head_status.
agent_review_coderabbit_head_state() {
  local state rest

  IFS=$'\t' read -r state rest <<<"$(agent_review_coderabbit_head_status "$1" "$2")"
  : "${rest}"
  printf '%s\n' "${state:-unknown}"
}

# agent_review_coderabbit_head_status <repo> <head_sha>
# Same output as agent_review_coderabbit_head_status_from_statuses, read from the API (the head's commit
# statuses and its CodeRabbit check run) and reused for agent_review_default_coderabbit_head_state_cache_ttl_s.
# The check run wins when it says anything, then the commit status; "none" needs both reads to succeed
# and say nothing. Prints "unknown 0" when no read can settle it so callers can fall back to the older
# comment-based checks.
agent_review_coderabbit_head_status() {
  local -r repo="$1"
  local -r head="$2"
  local cache_dir cache_file now mtime statuses_json check_runs_json out
  local statuses_out='none'$'\t''0' check_runs_out='none'$'\t''0'
  local statuses_ok=0 check_runs_ok=0

  cache_dir="${AGENT_REVIEW_CODERABBIT_STATE_CACHE_DIR:-${HOME}/scratch/repository-helpers/coderabbit-head-state}"
  cache_file="${cache_dir}/${repo//\//__}__${head}"
  printf -v now '%(%s)T' -1
  if [[ -f "${cache_file}" ]]; then
    mtime="$(runner_exec_stdout "coderabbit head status cache mtime" -- stat --format=%Y "${cache_file}" 2>/dev/null || printf '0')"
    if [[ "${mtime}" =~ ^[0-9]+$ ]] \
      && (( now - mtime < agent_review_default_coderabbit_head_state_cache_ttl_s )); then
      printf '%s\n' "$(<"${cache_file}")"
      return 0
    fi
  fi
  if statuses_json="$(ar_runner_gh_api_stream "agent-review coderabbit head statuses" \
    "repos/${repo}/commits/${head}/statuses?per_page=50" 2>/dev/null)" \
    && statuses_out="$(agent_review_coderabbit_head_status_from_statuses "${statuses_json}")"; then
    statuses_ok=1
  fi
  if check_runs_json="$(ar_runner_gh_api_stream "agent-review coderabbit head check runs" \
    "repos/${repo}/commits/${head}/check-runs?check_name=CodeRabbit&per_page=100" 2>/dev/null)" \
    && check_runs_out="$(agent_review_coderabbit_head_status_from_check_runs "${check_runs_json}")"; then
    check_runs_ok=1
  fi
  if (( check_runs_ok == 1 )) && [[ "${check_runs_out%%$'\t'*}" != 'none' ]]; then
    out="${check_runs_out}"
  elif (( statuses_ok == 1 )) && [[ "${statuses_out%%$'\t'*}" != 'none' ]]; then
    out="${statuses_out}"
  elif (( statuses_ok == 1 && check_runs_ok == 1 )); then
    out="none"$'\t'"0"
  else
    printf 'unknown\t0\n'
    return 0
  fi
  if runner_exec "coderabbit head status cache dir" -- mkdir --parents "${cache_dir}" >/dev/null 2>&1; then
    printf '%s\n' "${out}" >"${cache_file}"
  fi
  printf '%s\n' "${out}"
}

# agent_review_coderabbit_head_status_from_check_runs <check-runs-json>
# The same "<state> <epoch>" line as agent_review_coderabbit_head_status_from_statuses, read from the
# CodeRabbit check run on the head (the response of commits/<sha>/check-runs?check_name=CodeRabbit, which
# holds only CodeRabbit's latest run, so a busy CI matrix cannot push it off the first page). Its output title is the
# signal: a failed run is failed whatever its title, "Finished" (success) is completed, "Review rate
# limited" is rate_limited, a run that has not completed is in_progress, "Review paused" / "Review
# skipped" are other. Only the CodeRabbit app's runs count (its exact slug), never a same-named run or a
# lookalike slug. The newest run is the one with the highest check-run id (a queued run has no timestamps yet).
agent_review_coderabbit_head_status_from_check_runs() {
  local -r check_runs_json="${1:-}"

  if [[ -z "${check_runs_json}" || "${check_runs_json}" == 'null' ]]; then
    printf 'none\t0\n'
    return 0
  fi
  # shellcheck disable=SC2016  # jq program text, not shell expansion
  ar_runner_jq_file "coderabbit head check run" "${check_runs_json}" -r '
    (if type == "object" then (.check_runs // []) elif type == "array" then . else [] end)
    | map(select((.app.slug // "") | test("^coderabbitai$"; "i")))
    | sort_by([(.id // 0), (.started_at // .completed_at // "")]) | last
    | if . == null then ["none", 0]
      else
        ((.output.title // "") | ascii_downcase) as $t
        | (.status // "") as $st
        | (.conclusion // "") as $c
        | (if ($c | test("^(failure|timed_out|cancelled|action_required|startup_failure|stale)$")) then "failed"
           elif ($t | test("rate[ -]?limit")) then "rate_limited"
           elif ($t | test("paus|skip")) then "other"
           elif ($st != "completed" or ($t | test("in progress|reviewing"))) then "in_progress"
           elif ($c == "success" and ($t | test("^(review )?(finished|completed)"))) then "completed"
           else "other" end) as $s
        | [$s, ((.completed_at // .started_at // "") | if . == "" then 0 else fromdateiso8601 end)]
      end
    | @tsv'
}

# agent_review_coderabbit_head_status_from_statuses <statuses-json>
# CodeRabbit publishes its outcome as a commit status on the head; a rate-limited head ends
# "success" with the description "Review rate limited" and no review (#717). Prints
# "<state> <updated_epoch>" for the newest CodeRabbit status, state being
#   completed     success / "Review completed"
#   rate_limited  description mentions a rate limit
#   in_progress   pending status
#   failed        failure or error
#   other         any other success text (for example a skipped review)
#   none          no CodeRabbit status on the head
agent_review_coderabbit_head_status_from_statuses() {
  local -r statuses_json="${1:-}"

  if [[ -z "${statuses_json}" || "${statuses_json}" == 'null' ]]; then
    printf 'none\t0\n'
    return 0
  fi
  # shellcheck disable=SC2016  # jq program text, not shell expansion
  ar_runner_jq_file "coderabbit head status" "${statuses_json}" -r '
    (if type == "array" then . else [.] end)
    | map(select((.context // "") | test("coderabbit"; "i")))
    | sort_by(.updated_at // .created_at // "") | last
    | if . == null then ["none", 0]
      else
        ((.description // "") | ascii_downcase) as $d
        | (if ($d | test("rate[ -]?limit")) then "rate_limited"
           elif (.state == "pending" or ($d | test("in progress|reviewing"))) then "in_progress"
           elif (.state == "failure" or .state == "error") then "failed"
           elif (.state == "success" and ($d | test("review completed"))) then "completed"
           else "other" end) as $s
        | [$s, ((.updated_at // .created_at // "") | if . == "" then 0 else fromdateiso8601 end)]
      end
    | @tsv'
}

# agent_review_coderabbit_hold_from_comments <comments-json>
# Reads the PR's issue comments and prints the state set by the newest `@coderabbitai pause` / `@coderabbitai resume`
# command (repository-helpers#865).
# The state is the comments themselves because that is what CodeRabbit obeys and what every reader of the PR
# sees; its own display of a pause (a status, a check title) is not documented, so nothing reads that. A command
# counts when the whole comment of a human is the command (CodeRabbit ignores a comment with other text), whoever
# posted it: anyone allowed to comment can pause the PR, and the loop must honour that too. CodeRabbit's documented
# aliases count as well: the `@coderabbit` handle, and `ignore` for a whole-comment pause. The newest command
# decides: "held\t<epoch>" for a pause, "released\t<epoch>" for a resume, "none" when there is no command.
agent_review_coderabbit_hold_from_comments() {
  local -r comments_json="${1:-}"

  ar_runner_jq_file "coderabbit hold state" "${comments_json}" -r --slurp '
    def ts: ((.created_at // "") | if . == "" then 0 else fromdateiso8601 end);
    def command:
      ((.body // "")
       | (capture("\\A[[:space:]]*@coderabbit(ai)?[[:space:]]+(?<c>pause|ignore|resume)[[:space:]]*\\z"; "i")? // null)
       | if . == null then null else (.c | ascii_downcase | if . == "resume" then "resume" else "pause" end) end);
    [ .[] | if type == "array" then .[] else . end ]
    | map(select(((.user.type // "") != "Bot")
                 and (((.user.login // "") | test("\\[bot\\]$|^coderabbitai?$"; "i")) | not)))
    | map(. + {cmd: command})
    | map(select(.cmd != null))
    | sort_by(.created_at // "")
    | if length == 0 then "none"
      elif (last | .cmd) == "pause" then "held\t\(last | ts)"
      else "released\t\(last | ts)" end'
}

# agent_review_coderabbit_seen_in_comments <comments-json>
# Exit 0 when a CodeRabbit account has commented on the PR (a walkthrough, a command reply, a rate-limit
# notice), 1 otherwise. The loop's own "@coderabbitai full review" asks are authored by the operator, so
# they never count: an ask nobody answered is not evidence that the agent exists (#759).
agent_review_coderabbit_seen_in_comments() {
  local -r comments_json="${1:-}"
  local seen

  if [[ -z "${comments_json}" || "${comments_json}" == 'null' ]]; then
    return 1
  fi
  # shellcheck disable=SC2016  # jq program text, not shell expansion
  seen="$(ar_runner_jq_file "coderabbit seen in comments" "${comments_json}" -r --slurp '
    [ .[] | if type == "array" then .[] else . end
      | select((.user.login // "") | test("^coderabbitai(\\[bot\\])?$"; "i")) ] | length > 0')" || return 1
  [[ "${seen}" == 'true' ]]
}

# agent_review_coderabbit_seen_on_pr <repo> <head_sha> <comments-json>
# Exit 0 when CodeRabbit is evidently set up on the repository (a commit status or check run on the head,
# or a comment on the PR), 1 when none exists, 2 when the head cannot be read and no comment settles it.
agent_review_coderabbit_seen_on_pr() {
  local -r repo="$1"
  local -r head="$2"
  local -r comments_json="${3:-}"
  local state

  if agent_review_coderabbit_seen_in_comments "${comments_json}"; then
    return 0
  fi
  state="$(agent_review_coderabbit_head_state "${repo}" "${head}")"
  case "${state}" in
    none) return 1 ;;
    unknown) return 2 ;;
    *) return 0 ;;
  esac
}

# agent_review_pr_hold_state <repo> <pr>
# Prints "held<TAB><epoch>", "released<TAB><epoch>" or "none" (see agent_review_coderabbit_hold_from_comments).
# Exit 1 when the comments cannot be read, so a caller can tell "not on hold" from "could not tell": a failed
# read must never look like a release or a completion.
agent_review_pr_hold_state() {
  local comments_json

  comments_json="$(agent_review_pr_issue_comments_json_strict "${1}" "${2}")" || return 1
  agent_review_coderabbit_hold_from_comments "${comments_json}"
}

# agent_review_pr_on_hold <repo> <pr>
# Exit 0 when the PR is on hold (its newest CodeRabbit pause/resume command is a pause), 1 when it is not, and 2
# when the state could not be read. Callers that guard a completion or a release treat 2 as "held".
agent_review_pr_on_hold() {
  local line

  line="$(agent_review_pr_hold_state "${1}" "${2}")" || return 2
  [[ "${line}" == held* ]]
}

# agent_review_pr_released_within <repo> <pr> <seconds>
# Exit 0 when the newest pause/resume command is a resume posted less than <seconds> ago. Right after `release`
# the head can still show CodeRabbit's old "Review paused" state until the incremental review registers, and the
# loop must not answer that with a second review request (#865). AGENT_REVIEW_NOW_EPOCH fixes the clock in tests.
agent_review_pr_released_within() {
  local line state epoch now

  line="$(agent_review_pr_hold_state "${1}" "${2}")" || return 1
  IFS=$'\t' read -r state epoch <<<"${line}"
  [[ "${state}" == released ]] || return 1
  now="${AGENT_REVIEW_NOW_EPOCH:-$(date +%s)}"
  (( now - epoch < 10#${3} ))
}

# agent_review_release_grace_s: prints the seconds after `release` during which the loop waits for the incremental
# review instead of asking for one (AGENT_REVIEW_RELEASE_GRACE_S; default 600, 0 turns it off). A value that is
# not a non-negative decimal integer falls back to the default; leading zeros are decimal (090 is 90).
agent_review_release_grace_s() {
  local -r value="${AGENT_REVIEW_RELEASE_GRACE_S:-600}"

  if [[ "${value}" =~ ^[0-9]{1,9}$ ]]; then
    printf '%s\n' "$((10#${value}))"
  else
    printf '600\n'
  fi
}

# agent_review_status_with_hold <status-json> <true|false|unknown>
# Adds "on_hold" to the status JSON and, while the PR is on hold or its state is unknown, forces complete_ready to
# false: a held PR has had pushes that CodeRabbit did not review, so it cannot complete without the review
# `release` asks for, and a failed read must not let it complete either.
agent_review_status_with_hold() {
  local -r status_json="${1:-}"
  local -r held="${2:-false}"

  # shellcheck disable=SC2016  # jq program uses $held from --arg
  ar_runner_jq_file "agent-review status with hold" "${status_json}" -c --arg held "${held}" '
    . + {on_hold: ($held == "true"), hold_unknown: ($held == "unknown")}
    | if $held != "false" then .complete_ready = false else . end'
}
