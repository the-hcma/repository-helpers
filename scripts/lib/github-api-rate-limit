#!/usr/bin/env bash
# shellcheck shell=bash
# github-api-rate-limit — detect GitHub API primary/secondary rate limits and wait.
#
# Used by agent-review and repo-practices gh wrappers so coding-agent flows sleep
# until reset instead of failing hard on HTTP 403 "API rate limit exceeded".
#
# Backoff prefers HTTP response headers (Retry-After, X-RateLimit-Reset) from
# `gh api --include rate_limit`, not guessed sleeps.
#
# Env overrides:
#   GITHUB_API_RATE_LIMIT_MAX_RETRIES   wait-and-retry cycles (default 3)
#   GITHUB_API_RATE_LIMIT_MAX_WAIT_S   total wait budget per wait (default 3600)
#   GITHUB_API_RATE_LIMIT_POLL_S       sleep chunk while waiting (default 30)
#   GITHUB_API_RATE_LIMIT_RETRY_SLEEP_S  fallback when headers unavailable (default 60)
#   GITHUB_API_RATE_LIMIT_QUOTA_INTACT_FAIL_FAST  when set to 1: on REST 403 with
#     intact primary quota, emit NOTE: GITHUB_REST_403_QUOTA_INTACT and return 125
#     without sleeping (repository-helpers#547)
#   GITHUB_API_SECONDARY_RATE_LIMIT_BACKOFF_S  comma-separated secondary cooldown
#     ladder by attempt (default 60,180,300). Used when Retry-After / body guidance
#     is absent for explicit secondary/abuse limits (repository-helpers#569).
#   GITHUB_API_TRANSIENT_NETWORK_MAX_RETRIES   bounded retries for transport
#     failures — DNS resolution, connection refused/reset, 502/503/504 — that are
#     not rate limits (default 3; repository-helpers#617). Reads only; a detected
#     mutation (non-GET `gh api`, a `gh api` body flag, a GraphQL `mutation`, or
#     any non-read `gh` subcommand forwarded by scripts/gh-api) is never retried.
#   GITHUB_API_TRANSIENT_NETWORK_BACKOFF_S     comma-separated backoff ladder by
#     attempt for the above (default 2,5,15).
#   GITHUB_API_ATTEMPT_TIMEOUT_S   per-attempt wall-clock cap on the wrapped command (default 300,
#     long enough for a large --paginate read; 0 disables). A killed attempt counts as a transient
#     failure: reads are retried under the transient-network bounds, a mutation is never repeated
#     (repository-helpers#741).

set -euo pipefail

if declare -F github_api_detail_is_rate_limited >/dev/null 2>&1; then
  return 0
fi

_github_api_rl_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _github_api_rl_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_github_api_rl_lib_dir}/runner-ensure"

github_api_rate_limit_max_retries="${GITHUB_API_RATE_LIMIT_MAX_RETRIES:-3}"
github_api_rate_limit_max_wait_s="${GITHUB_API_RATE_LIMIT_MAX_WAIT_S:-3600}"
github_api_rate_limit_poll_s="${GITHUB_API_RATE_LIMIT_POLL_S:-30}"
github_api_rate_limit_retry_sleep_s="${GITHUB_API_RATE_LIMIT_RETRY_SLEEP_S:-60}"
github_api_rate_limit_reset_cushion_s=2

# Effective max retries: re-read GITHUB_API_RATE_LIMIT_MAX_RETRIES on each exec so
# per-call env prefixes (e.g. GITHUB_API_RATE_LIMIT_MAX_RETRIES=1 cmd) work without
# re-sourcing the lib (repository-helpers#497).
_github_api_rate_limit_effective_max_retries() {
  local value

  value="${GITHUB_API_RATE_LIMIT_MAX_RETRIES:-${github_api_rate_limit_max_retries}}"
  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 )); then
    value=3
  fi
  printf '%s' "$value"
}

# github_api_detail_is_rate_limited <detail>
# True for primary/secondary GitHub API rate-limit wording (anchored; not bare "429").
github_api_detail_is_rate_limited() {
  local -r detail="$1"
  local lower

  lower="$(printf '%s' "$detail" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower" == *'(http 429)'* \
    || "$lower" == *'abuse detection mechanism'* \
    || "$lower" == *'api rate limit exceeded'* \
    || "$lower" == *'http 429'* \
    || "$lower" == *'secondary rate limit'* \
    || "$lower" == *'was made too recently'* ]]
}

# github_api_detail_is_secondary_rate_limited <detail>
# True when detail looks like a secondary / abuse / HTTP 429 limit (core.remaining may
# still be > 0).
github_api_detail_is_secondary_rate_limited() {
  local -r detail="$1"
  local lower

  lower="$(printf '%s' "$detail" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower" == *'(http 429)'* \
    || "$lower" == *'abuse detection mechanism'* \
    || "$lower" == *'http 429'* \
    || "$lower" == *'secondary rate limit'* \
    || "$lower" == *'was made too recently'* ]]
}

# github_api_detail_is_transient_network <detail>
# True for retryable transport failures — DNS resolution, connection
# refused/reset/timeout, unreachable network, TLS handshake, gateway 502/503/504.
# These are NOT rate limits (which have their own wait ladder), so a brief outage
# during a nightly run should retry rather than abort (repository-helpers#617).
# Covers both `gh` and `git`/libcurl phrasings ("failed to connect to", "the
# requested URL returned error: 503") since batch_run_git_fetch feeds raw
# `git fetch` stderr in here.
github_api_detail_is_transient_network() {
  local -r detail="$1"
  local lower

  lower="$(printf '%s' "$detail" | tr '[:upper:]' '[:lower:]')"

  case "$lower" in
    *'could not resolve host'* \
      | *'could not resolve proxy'* \
      | *'temporary failure in name resolution'* \
      | *'error connecting to'* \
      | *'failed to connect to'* \
      | *'could not connect to'* \
      | *"couldn't connect to"* \
      | *'connection refused'* \
      | *'connection reset'* \
      | *'connection timed out'* \
      | *'operation timed out'* \
      | *'timeout was reached'* \
      | *'network is unreachable'* \
      | *'no route to host'* \
      | *'tls handshake timeout'* \
      | *'i/o timeout'* \
      | *'unexpected eof'* \
      | *'(http 502)'* | *'(http 503)'* | *'(http 504)'* \
      | *'http 502'* | *'http 503'* | *'http 504'* \
      | *'returned error: 502'* | *'returned error: 503'* \
      | *'returned error: 504'* \
      | *'bad gateway'* | *'service unavailable'* | *'gateway timeout'*)
      return 0
      ;;
  esac
  return 1
}

# _github_api_rl_cmd_is_write <cmd…>
# Classify a gh invocation (possibly wrapped as `bash -c '…' … gh <args>` by
# scripts/gh-api) as a mutation, so the transient-network retry is skipped for
# it. scripts/gh-api forwards EVERY non-rejected gh subcommand through this same
# wrapper, so inspecting `gh api` body/method flags alone is not enough
# (repository-helpers#617 review):
#
#   gh api <path>       → read, unless the effective HTTP method is non-GET/HEAD.
#                         `gh api` defaults to GET, but a body flag
#                         (-f/-F/--field/--raw-field/--input) with no explicit
#                         --method promotes it to POST. With an explicit
#                         `--method GET` the same -f fields are query params, so
#                         it stays a read (scripts/dep-updater does exactly this).
#   gh api graphql …    → read, unless the payload mentions "mutation".
#   gh <subcommand> …   → read only for an allowlisted read verb
#                         (view/list/checks/diff/status) or `search`; every
#                         other subcommand (pr merge, pr comment, issue close, …)
#                         is treated as a mutation.
_github_api_rl_cmd_is_write() {
  local -a args=("$@")
  local n i gh_idx=-1 sub verb prev arg method='' has_body=0 method_upper

  n=${#args[@]}
  for (( i = 0; i < n; i++ )); do
    if [[ "${args[i]}" == 'gh' || "${args[i]}" == */gh ]]; then
      gh_idx=$i
      break
    fi
  done
  (( gh_idx >= 0 )) || return 0
  sub="${args[gh_idx + 1]:-}"

  if [[ "$sub" != 'api' ]]; then
    verb="${args[gh_idx + 2]:-}"
    case "${sub}:${verb}" in
      search:* | *:view | *:list | *:checks | *:diff | *:status)
        return 1 ;;
      *)
        return 0 ;;
    esac
  fi

  if [[ "${args[gh_idx + 2]:-}" == 'graphql' ]]; then
    for (( i = gh_idx + 3; i < n; i++ )); do
      [[ "${args[i]}" == *mutation* ]] && return 0
      # A query read from a file or stdin (-F query=@op.graphql, --input) hides its operation, so it may be a
      # mutation: treat it as a write and never repeat it after a timeout or a dropped connection.
      [[ "${args[i]}" == *=@* || "${args[i]}" == '--input' || "${args[i]}" == --input=* ]] && return 0
    done
    return 1
  fi

  # Resolve the effective method and whether a request body is present, then
  # decide — a body flag only makes it a POST when no method is set explicitly.
  prev=''
  for (( i = gh_idx + 2; i < n; i++ )); do
    arg="${args[i]}"
    case "$arg" in
      -f | -F | --field | --raw-field | --input) has_body=1 ;;
      -f* | -F* | --field=* | --raw-field=* | --input=*) has_body=1 ;;
      --method=*) method="${arg#--method=}" ;;
      -X*) verb="${arg#-X}"; method="${verb#=}" ;;
    esac
    if [[ "$prev" == '--method' || "$prev" == '-X' ]]; then
      method="$arg"
    fi
    prev="$arg"
  done

  if [[ -n "$method" ]]; then
    method_upper="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
    [[ "$method_upper" != 'GET' && "$method_upper" != 'HEAD' ]] && return 0
    return 1
  fi
  (( has_body )) && return 0
  return 1
}

# _github_api_transient_network_effective_max_retries
# Re-reads GITHUB_API_TRANSIENT_NETWORK_MAX_RETRIES on each exec (per-call env).
_github_api_transient_network_effective_max_retries() {
  local value

  value="${GITHUB_API_TRANSIENT_NETWORK_MAX_RETRIES:-3}"
  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 )); then
    value=3
  fi
  printf '%s' "$value"
}

# _github_api_transient_network_backoff_s <attempt>
# Backoff ladder (1-indexed) for transient transport retries. Override with
# GITHUB_API_TRANSIENT_NETWORK_BACKOFF_S=2,5,15 (comma-separated).
_github_api_transient_network_backoff_s() {
  local attempt="${1:-1}"
  local csv="${GITHUB_API_TRANSIENT_NETWORK_BACKOFF_S:-2,5,15}"
  local -a parts=()
  local idx value

  if [[ ! "$attempt" =~ ^[0-9]+$ ]] || (( attempt < 1 )); then
    attempt=1
  fi
  IFS=',' read -r -a parts <<<"$csv"
  ((${#parts[@]} > 0)) || parts=(2 5 15)
  idx=$((attempt - 1))
  if (( idx >= ${#parts[@]} )); then
    idx=$((${#parts[@]} - 1))
  fi
  value="${parts[$idx]}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    printf '%s' "$value"
  else
    printf '5'
  fi
}

# _github_api_attempt_timeout_s
# Per-attempt wall-clock cap for the wrapped command, in seconds. A stalled request must not block a caller
# forever (remote-timeouts-retries). GITHUB_API_ATTEMPT_TIMEOUT_S overrides the default, which is generous
# enough for a large --paginate read; 0 turns the cap off, anything else that is not an integer falls back
# to the default. Prints nothing when the cap is off. Fails (exit 2) when a cap is wanted but neither
# timeout(1) nor gtimeout(1) is on PATH: running uncapped would silently drop the guarantee.
_github_api_attempt_timeout_s() {
  local value

  value="${GITHUB_API_ATTEMPT_TIMEOUT_S:-300}"
  # At most six digits (about eleven days) so the arithmetic below cannot overflow.
  if [[ ! "$value" =~ ^[0-9]{1,6}$ ]]; then
    value=300
  fi
  # Decimal on purpose: a leading zero ("08") is not octal here.
  value=$((10#$value))
  (( value > 0 )) || return 0
  if ! runner_timeout_bin >/dev/null 2>&1; then
    printf 'github_api_exec_with_rate_limit_retry: GITHUB_API_ATTEMPT_TIMEOUT_S=%s needs timeout(1) or gtimeout(1) on PATH\n' \
      "$value" >&2
    printf '  install coreutils, or set GITHUB_API_ATTEMPT_TIMEOUT_S=0 to run uncapped\n' >&2
    return 2
  fi
  printf '%s' "$value"
}

# github_api_exec_with_rate_limit_retry <label> [--probe] -- <cmd> [args…]
# Runs via runner_exec (no mid-attempt stdout stream). On success, prints that
# attempt's captured stdout once — avoids concatenating partial --paginate pages
# from a rate-limited attempt with a full retry.
github_api_exec_with_rate_limit_retry() {
  local label probe=0
  local -a rl_cmd=()
  local exit_code attempt max_retries detail headers uuid should_wait wait_ec
  local final_quota_retry=0
  local net_attempt=1 net_max_retries net_sleep
  local attempt_timeout_s timed_out timeout_bin
  local -a exec_cmd=()

  label="${1:?github_api_exec_with_rate_limit_retry: label required}"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)
        probe=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'github_api_exec_with_rate_limit_retry: expected -- before command (label=%s)\n' \
          "$label" >&2
        return 2
        ;;
    esac
  done
  rl_cmd=("$@")
  ((${#rl_cmd[@]} > 0)) || {
    printf 'github_api_exec_with_rate_limit_retry: empty command (label=%s)\n' "$label" >&2
    return 2
  }

  max_retries="$(_github_api_rate_limit_effective_max_retries)"
  net_max_retries="$(_github_api_transient_network_effective_max_retries)"
  # The cap wraps only what runs; the read/write classification below keeps looking at the caller's command.
  exec_cmd=("${rl_cmd[@]}")
  attempt_timeout_s="$(_github_api_attempt_timeout_s)" || return $?
  if [[ -n "$attempt_timeout_s" ]]; then
    timeout_bin="$(runner_timeout_bin)"
    exec_cmd=("$timeout_bin" "--kill-after=${_runner_timeout_kill_after_sec:-5}" "${attempt_timeout_s}s" "${rl_cmd[@]}")
  fi

  attempt=1
  while (( attempt <= max_retries || final_quota_retry == 1 )); do
    exit_code=0
    github_api_pace_gate "$label"
    if (( probe )); then
      runner_exec "$label" --probe -- "${exec_cmd[@]}" || exit_code=$?
    else
      runner_exec "$label" -- "${exec_cmd[@]}" || exit_code=$?
    fi
    if (( exit_code == 0 )); then
      uuid="$(runner_last_id)"
      if [[ -n "$uuid" ]]; then
        runner_read "$uuid" stdout 2>/dev/null || true
      fi
      return 0
    fi
    detail="$(_github_api_last_stderr_summary)"
    # A killed attempt (timeout(1) exits 124, or 137 once --kill-after escalates) is a transient failure like
    # a dropped connection: the same bounded retry applies, and a mutation is still never repeated.
    timed_out=0
    if [[ -n "$attempt_timeout_s" ]] && (( exit_code == 124 || exit_code == 137 )); then
      timed_out=1
      detail="request timed out (attempt cap ${attempt_timeout_s}s, or the command's own timeout)"
    fi
    if ! github_api_detail_is_rate_limited "$detail"; then
      # Transient transport failure (DNS, connection, gateway 5xx): bounded retry
      # with backoff so a brief outage does not abort a nightly run (#617).
      # Read requests only — a 5xx / timeout on a mutation could mean the write
      # landed, and re-POSTing is not safe (remote-timeouts-retries.mdc).
      if (( timed_out )) || github_api_detail_is_transient_network "$detail"; then
        if _github_api_rl_cmd_is_write "${rl_cmd[@]}"; then
          printf 'NOTE: GITHUB_API_TRANSIENT_NETWORK_NO_RETRY label=%s reason=mutation detail=%s\n' \
            "$label" "$detail" >&2
        elif (( net_attempt < net_max_retries )); then
          net_sleep="$(_github_api_transient_network_backoff_s "$net_attempt")"
          printf 'NOTE: GITHUB_API_TRANSIENT_NETWORK label=%s attempt=%s/%s sleep=%ss detail=%s\n' \
            "$label" "$net_attempt" "$net_max_retries" "$net_sleep" "$detail" >&2
          if (( net_sleep > 0 )); then
            run_command "github-api transient-network backoff sleep" sleep "$net_sleep" || true
          fi
          net_attempt=$(( net_attempt + 1 ))
          continue
        else
          printf 'ERROR: GITHUB_API_TRANSIENT_NETWORK label=%s attempts=%s detail=%s\n' \
            "$label" "$net_max_retries" "$detail" >&2
        fi
      fi
      return "$exit_code"
    fi
    # Post-ladder re-run already consumed; fail closed.
    if (( final_quota_retry == 1 )); then
      printf 'ERROR: GITHUB_RATE_LIMIT label=%s attempts=%s detail=%s\n' \
        "$label" "$max_retries" "$detail" >&2
      return "$exit_code"
    fi
    printf 'NOTE: GITHUB_RATE_LIMIT_HIT label=%s attempt=%s/%s detail=%s\n' \
      "$label" "$attempt" "$max_retries" "$detail" >&2
    # Intermediate attempts always wait. Final-attempt wait also runs for
    # secondary / quota-intact REST 403 so the escalation ladder can finish
    # (repository-helpers#547 / #569). Ordinary primary-depleted stays
    # fail-closed on the last attempt without an extra up-to-max_wait stall.
    should_wait=0
    headers=''
    if (( attempt < max_retries )); then
      should_wait=1
    elif (( max_retries > 1 && attempt == max_retries )); then
      if github_api_detail_is_secondary_rate_limited "$detail"; then
        should_wait=1
      else
        # Headers reporting remaining=0 are ordinary primary depletion even when
        # the /rate_limit probe fails (it can 403 while depleted).
        headers="$(github_api_fetch_rate_limit_headers || true)"
        if ! github_api_headers_depleted_reset_epoch "$headers" >/dev/null \
          && _github_api_quota_intact_suspect; then
          should_wait=1
        fi
      fi
    fi
    if (( should_wait )); then
      if [[ -z "$headers" ]]; then
        headers="$(github_api_fetch_rate_limit_headers || true)"
      fi
      wait_ec=0
      github_api_wait_for_rate_limit "$detail" "$headers" "$attempt" || wait_ec=$?
      # Normalize WAIT_TIMEOUT to the original gh exit so callers are not
      # MAX_WAIT_S-dependent (#547). Keep fail-fast 125 distinct.
      if (( wait_ec == 124 )); then
        printf 'ERROR: GITHUB_RATE_LIMIT label=%s attempts=%s detail=%s\n' \
          "$label" "$attempt" "$detail" >&2
        return "$exit_code"
      fi
      if (( wait_ec != 0 )); then
        return "$wait_ec"
      fi
    fi
    if (( attempt >= max_retries )); then
      if (( should_wait )); then
        # Final rung cleared — one more command attempt (no further wait).
        final_quota_retry=1
        continue
      fi
      printf 'ERROR: GITHUB_RATE_LIMIT label=%s attempts=%s detail=%s\n' \
        "$label" "$max_retries" "$detail" >&2
      return "$exit_code"
    fi
    attempt=$((attempt + 1))
  done
  return "$exit_code"
}

# github_api_fetch_rate_limit_headers
# Prints `gh api --include rate_limit` output (status/headers/body) for backoff parsing.
github_api_fetch_rate_limit_headers() {
  local out exit_code

  exit_code=0
  # gh must stay on the runner_exec_stdout line (runner-adoption ratchet).
  out="$(runner_exec_stdout "github-api-rate-limit include rate_limit" --probe --timeout 30 -- gh api --include rate_limit 2>/dev/null)" \
    || exit_code=$?
  if (( exit_code != 0 )) && [[ -z "$out" ]]; then
    return 1
  fi
  printf '%s' "$out"
  return 0
}

# github_api_headers_depleted_reset_epoch <headers_text>
# Prints X-RateLimit-Reset and returns 0 when the last HTTP response block reports
# X-RateLimit-Remaining: 0 for the core resource (or no resource header). This is
# authoritative primary depletion and must not be second-guessed by the
# /rate_limit probe, which can itself fail while the quota is exhausted.
github_api_headers_depleted_reset_epoch() {
  local -r headers="$1"
  local block remaining reset resource

  block="$(_github_api_last_response_headers "$headers")"
  remaining="$(_github_api_header_value "$block" 'x-ratelimit-remaining' || true)"
  reset="$(_github_api_header_value "$block" 'x-ratelimit-reset' || true)"
  resource="$(_github_api_header_value "$block" 'x-ratelimit-resource' || true)"
  [[ "$remaining" == '0' && "$reset" =~ ^[0-9]+$ ]] || return 1
  [[ -z "$resource" || "$resource" == 'core' ]] || return 1
  printf '%s' "$reset"
}

# github_api_rate_limit_core_reset_epoch
# Prints core.reset unix epoch from gh api rate_limit JSON (empty on failure).
github_api_rate_limit_core_reset_epoch() {
  local out exit_code

  exit_code=0
  out="$(runner_exec_stdout "github-api-rate-limit core reset" --probe --timeout 30 -- gh api rate_limit --jq '.resources.core.reset // empty' 2>/dev/null)" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    return 1
  fi
  if [[ "$out" =~ ^[0-9]+$ ]]; then
    printf '%s' "$out"
    return 0
  fi
  return 1
}

# github_api_rate_limit_depleted_reset_epoch
# Soonest .reset among core/graphql/search resources with remaining == 0.
github_api_rate_limit_depleted_reset_epoch() {
  local out exit_code

  exit_code=0
  # shellcheck disable=SC2016  # jq program is a literal string
  out="$(runner_exec_stdout "github-api-rate-limit depleted reset" --probe --timeout 30 -- gh api rate_limit --jq '[.resources.core, .resources.graphql, .resources.search] | map(select((.remaining // 0) == 0) | .reset) | if length == 0 then empty else min end' 2>/dev/null)" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    return 1
  fi
  if [[ "$out" =~ ^[0-9]+$ ]]; then
    printf '%s' "$out"
    return 0
  fi
  return 1
}

# github_api_runner_last_detail_is_rate_limited
# True when the most recent runner stderr summary looks rate-limited.
github_api_runner_last_detail_is_rate_limited() {
  local detail

  detail="$(_github_api_last_stderr_summary)"
  github_api_detail_is_rate_limited "$detail"
}

# github_api_wait_for_rate_limit [detail] [headers_text] [attempt]
# Sleeps using Retry-After / X-RateLimit-Reset headers when available.
# Exit 124 on WAIT_TIMEOUT. max_wait=0 means fail-fast (no sleep).
# Exit 125 when quota-intact fail-fast is enabled (repository-helpers#547).
# attempt (default 1) selects exponential backoff for REST 403 + intact primary quota.
github_api_wait_for_rate_limit() {
  local -r detail="${1:-}"
  local headers="${2:-}"
  local attempt="${3:-1}"
  local max_wait poll fallback_sleep
  local waited=0 sleep_s remaining reset_epoch now retry_after_s
  local secondary=0 header_reset header_retry retry_after_from_header=0
  local deadline=0 quota_intact=0 quota_intact_backoff_s secondary_backoff_s
  local header_block header_remaining header_resource depleted_reset=''

  max_wait="${github_api_rate_limit_max_wait_s}"
  poll="${github_api_rate_limit_poll_s}"
  fallback_sleep="${github_api_rate_limit_retry_sleep_s}"
  if [[ ! "$max_wait" =~ ^[0-9]+$ ]]; then
    max_wait=3600
  fi
  if [[ ! "$poll" =~ ^[0-9]+$ ]] || (( poll < 1 )); then
    poll=30
  fi
  if [[ ! "$fallback_sleep" =~ ^[0-9]+$ ]] || (( fallback_sleep < 1 )); then
    fallback_sleep=60
  fi
  if [[ ! "$attempt" =~ ^[0-9]+$ ]] || (( attempt < 1 )); then
    attempt=1
  fi

  if (( max_wait == 0 )); then
    printf 'ERROR: WAIT_TIMEOUT GITHUB_RATE_LIMIT timeout=0s\n' >&2
    return 124
  fi

  if github_api_detail_is_secondary_rate_limited "$detail"; then
    secondary=1
  fi

  if [[ -z "$headers" ]]; then
    headers="$(github_api_fetch_rate_limit_headers || true)"
  fi
  # GET /rate_limit can report a wrong core figure (always full); a real core response's headers
  # are authoritative, so prefer them whenever they show primary depletion (#710).
  # Skip the extra call when the response already settles it (an explicit Retry-After, or headers
  # already showing depletion): more requests during a secondary limit can extend the block.
  if ! github_api_headers_depleted_reset_epoch "$headers" >/dev/null \
    && [[ -z "$(_github_api_header_value "$(_github_api_last_response_headers "$headers")" 'retry-after' || true)" ]]; then
    # A new wait always probes fresh; the poll loop and the intact check then reuse that result.
    _github_api_core_probe_clean_at=0
    if _github_api_core_probe_refresh; then
      headers="$_github_api_core_headers_value"
    fi
  fi

  # Read headers from the last HTTP response only (an earlier redirect block may
  # carry stale or malformed values); fall back to the raw text without one.
  header_block="$(_github_api_last_response_headers "$headers")"
  if [[ -z "$header_block" ]]; then
    header_block="$headers"
  fi
  header_retry="$(_github_api_header_value "$header_block" 'retry-after' || true)"
  header_reset="$(_github_api_header_value "$header_block" 'x-ratelimit-reset' || true)"
  retry_after_s="$(_github_api_parse_retry_after_seconds "$detail" || true)"
  if [[ -n "$header_retry" && "$header_retry" =~ ^[0-9]+$ ]]; then
    retry_after_s="$header_retry"
    retry_after_from_header=1
  fi

  now="$(date +%s)"
  # Primary: prefer X-RateLimit-Reset from the rate_limit probe over body phrases
  # like "a few minutes" (180s), which would clear long before the real window reset.
  # Body-phrase / Retry-After apply for explicit secondary; otherwise escalate
  # secondary_fallback across attempts (60 → 180 → 300; repository-helpers#569).
  # For unclassified REST 403 (#547) the quota-intact attempt ladder wins inside
  # the wait loop.
  if (( secondary == 0 )) && [[ -n "$header_reset" && "$header_reset" =~ ^[0-9]+$ ]]; then
    deadline="$header_reset"
    header_remaining="$(_github_api_header_value "$header_block" 'x-ratelimit-remaining' || true)"
    header_resource="$(_github_api_header_value "$header_block" 'x-ratelimit-resource' || true)"
    printf 'NOTE: GITHUB_RATE_LIMIT_HEADERS x_ratelimit_reset=%s remaining=%s resource=%s\n' \
      "$header_reset" "${header_remaining:-unknown}" "${header_resource:-unknown}" >&2
  elif (( retry_after_from_header == 1 )) \
    && [[ -n "$retry_after_s" && "$retry_after_s" =~ ^[0-9]+$ ]]; then
    deadline=$((now + retry_after_s))
    printf 'NOTE: GITHUB_RATE_LIMIT_HEADERS retry_after=%ss source=header\n' \
      "$retry_after_s" >&2
  elif (( secondary == 1 )) \
    && [[ -n "$retry_after_s" && "$retry_after_s" =~ ^[0-9]+$ ]]; then
    deadline=$((now + retry_after_s))
    printf 'NOTE: GITHUB_RATE_LIMIT_HEADERS retry_after=%ss source=body\n' \
      "$retry_after_s" >&2
  elif (( secondary == 1 )); then
    secondary_backoff_s="$(_github_api_secondary_backoff_s "$attempt")"
    if (( secondary_backoff_s > max_wait )); then
      secondary_backoff_s="$max_wait"
    fi
    deadline=$((now + secondary_backoff_s))
    printf 'NOTE: GITHUB_RATE_LIMIT_HEADERS secondary_fallback=%ss attempt=%s\n' \
      "$secondary_backoff_s" "$attempt" >&2
  fi

  # Headers say remaining=0: wait for the reset they report (plus clock-skew
  # cushion) and never consult the /rate_limit probe, which can fail while
  # depleted and would otherwise select the short #547 ladder. A secondary limit
  # (429, Retry-After) on the same response cannot clear before core resets, so
  # keep whichever deadline is later.
  depleted_reset="$(github_api_headers_depleted_reset_epoch "$headers" || true)"
  if [[ -n "$depleted_reset" ]]; then
    if (( secondary == 0 )) \
      || (( deadline < depleted_reset + github_api_rate_limit_reset_cushion_s )); then
      deadline=$((depleted_reset + github_api_rate_limit_reset_cushion_s))
    fi
    github_api_pace_publish_block "$deadline"
    while (( waited < max_wait )); do
      now="$(date +%s)"
      if (( now >= deadline )); then
        printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR header_reset_reached waited=%ss\n' "$waited" >&2
        return 0
      fi
      sleep_s=$((deadline - now))
      printf 'NOTE: GITHUB_RATE_LIMIT_WAIT deadline=%s remaining=%ss sleep_budget=%ss waited=%ss/%ss source=header_depleted\n' \
        "$deadline" "$sleep_s" "$poll" "$waited" "$max_wait" >&2
      if (( sleep_s > poll )); then
        sleep_s="$poll"
      fi
      if (( waited + sleep_s > max_wait )); then
        sleep_s=$((max_wait - waited))
      fi
      run_command "github-api-rate-limit wait sleep" sleep "$sleep_s"
      waited=$((waited + sleep_s))
    done
    now="$(date +%s)"
    if (( now >= deadline )); then
      printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR header_reset_reached waited=%ss\n' "$waited" >&2
      return 0
    fi
    printf 'ERROR: WAIT_TIMEOUT GITHUB_RATE_LIMIT timeout=%ss\n' "$max_wait" >&2
    return 124
  fi

  if (( deadline > 0 )); then
    github_api_pace_publish_block "$deadline"
  fi
  while (( waited < max_wait )); do
    now="$(date +%s)"
    sleep_s=0
    reset_epoch=""

    # Primary: clear when core/graphql/search all have remaining > 0 (GraphQL and
    # Search use separate budgets; core-only would skip the wait entirely).
    # waited==0 + remaining>0 (or rate_limit probe failed) after a 403 "API rate
    # limit exceeded" with *no* secondary phrase is unclassified REST abuse —
    # repository-helpers#547. Do not treat as a fixed 60s secondary_fallback.
    if (( secondary == 0 )) && _github_api_quota_intact_suspect; then
      if (( waited == 0 )); then
        secondary=1
        quota_intact=1
        now="$(date +%s)"
        if [[ "${GITHUB_API_RATE_LIMIT_QUOTA_INTACT_FAIL_FAST:-0}" == '1' ]]; then
          printf 'NOTE: GITHUB_REST_403_QUOTA_INTACT attempt=%s fail_fast=1\n' \
            "$attempt" >&2
          printf 'ERROR: GITHUB_REST_403_QUOTA_INTACT attempt=%s\n' "$attempt" >&2
          return 125
        fi
        # Prefer attempt ladder over body-phrase estimates ("a few minutes" → 180s).
        # Honor an explicit Retry-After *header* when present (#547 canonical body).
        if (( retry_after_from_header == 1 )) \
          && [[ -n "$retry_after_s" && "$retry_after_s" =~ ^[0-9]+$ ]]; then
          deadline=$((now + retry_after_s))
          printf 'NOTE: GITHUB_REST_403_QUOTA_INTACT attempt=%s retry_after=%ss\n' \
            "$attempt" "$retry_after_s" >&2
        else
          quota_intact_backoff_s="$(_github_api_quota_intact_backoff_s "$attempt")"
          deadline=$((now + quota_intact_backoff_s))
          github_api_pace_publish_block "$deadline"
          printf 'NOTE: GITHUB_REST_403_QUOTA_INTACT attempt=%s backoff=%ss\n' \
            "$attempt" "$quota_intact_backoff_s" >&2
        fi
      else
        printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR remaining_ok waited=%ss\n' "$waited" >&2
        return 0
      fi
    fi
    if (( deadline > 0 && now >= deadline )); then
      if (( secondary == 1 )); then
        if (( quota_intact == 1 )); then
          printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR quota_intact_deadline_reached waited=%ss\n' \
            "$waited" >&2
        else
          printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR deadline_reached waited=%ss\n' "$waited" >&2
        fi
        return 0
      fi
      # Primary still depleted after a soft deadline: keep waiting on depleted reset.
      printf 'NOTE: GITHUB_RATE_LIMIT_WAIT deadline_elapsed_still_depleted waited=%ss\n' \
        "$waited" >&2
      deadline=0
    fi

    if (( deadline > now )); then
      sleep_s=$((deadline - now))
      printf 'NOTE: GITHUB_RATE_LIMIT_WAIT deadline=%s remaining=%ss sleep_budget=%ss waited=%ss/%ss\n' \
        "$deadline" "$sleep_s" "$poll" "$waited" "$max_wait" >&2
    elif (( secondary == 0 )) && reset_epoch="$(github_api_rate_limit_depleted_reset_epoch)"; then
      remaining=$((reset_epoch - now))
      if (( remaining > 0 )); then
        sleep_s="$remaining"
        printf 'NOTE: GITHUB_RATE_LIMIT_WAIT reset_epoch=%s remaining=%ss waited=%ss/%ss\n' \
          "$reset_epoch" "$remaining" "$waited" "$max_wait" >&2
      fi
    fi

    if (( sleep_s < 1 )); then
      sleep_s="$fallback_sleep"
      printf 'NOTE: GITHUB_RATE_LIMIT_WAIT reset_unknown sleep=%ss waited=%ss/%ss\n' \
        "$sleep_s" "$waited" "$max_wait" >&2
    fi
    if (( sleep_s > poll )); then
      sleep_s="$poll"
    fi
    if (( waited + sleep_s > max_wait )); then
      sleep_s=$((max_wait - waited))
    fi
    if (( sleep_s < 1 )); then
      break
    fi

    run_command "github-api-rate-limit wait sleep" sleep "$sleep_s"
    waited=$((waited + sleep_s))
  done

  # Quota-intact / secondary deadlines may land exactly on max_wait; treat as
  # clear so the outer retry can run (do not convert a completed backoff into
  # WAIT_TIMEOUT). repository-helpers#547 / #569.
  now="$(date +%s)"
  if (( deadline > 0 && now >= deadline )); then
    if (( quota_intact == 1 )); then
      printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR quota_intact_deadline_reached waited=%ss\n' \
        "$waited" >&2
      return 0
    fi
    if (( secondary == 1 )); then
      printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR deadline_reached waited=%ss\n' \
        "$waited" >&2
      return 0
    fi
  fi

  printf 'ERROR: WAIT_TIMEOUT GITHUB_RATE_LIMIT timeout=%ss\n' "$max_wait" >&2
  return 124
}

# --- shared pacing (repository-helpers#710) ---
#
# Every GitHub call made through github_api_exec_with_rate_limit_retry first passes
# github_api_pace_gate, which coordinates ALL callers on the host (parallel workers, the agent
# review loop, scripts/gh-api, dep-updater) through a small shared state directory:
#
#   blocked_until   epoch: nobody starts a call before it (set by any caller's rate-limit wait)
#   quota           "remaining reset observed_epoch" for the core resource, from real response
#                   headers (GET /rate_limit reports a wrong core figure on some accounts)
#   next_slot       microsecond epoch of the next free call slot (minimum spacing between calls)
#   calls           number of calls admitted through the gate
#   probing_until   epoch until which one caller is refreshing the quota (probed without the lock)
#
# State is guarded by flock(1) where available, else an atomic mkdir lock. The gate never
# blocks a caller forever and never breaks one: an unusable state directory or a lock timeout makes
# it fail open with a single NOTE.
#
# Env overrides:
#   GITHUB_API_PACING             0 disables the gate (tests, emergencies); default 1
#   GITHUB_API_STATE_DIR          shared state directory
#                                 (default ~/scratch/repository-helpers/github-api-state)
#   GITHUB_API_MIN_INTERVAL_MS    minimum spacing between call starts, host-wide (default 100)
#   GITHUB_API_QUOTA_RESERVE      stop admitting calls at this many remaining and wait for the
#                                 reset instead (default 200)
#   GITHUB_API_QUOTA_TTL_S        re-probe the quota when the cached value is older (default 30)
#   GITHUB_API_PACE_LOCK          mkdir forces the portable mkdir lock even when flock exists
#                                 (default: flock when available)

# github_api_pacing_enabled
github_api_pacing_enabled() {
  [[ "${GITHUB_API_PACING:-1}" != '0' && -z "${_github_api_pace_disabled:-}" ]]
}

# github_api_fetch_core_quota_headers
# Prints `gh api --include zen` output: a real core-resource response, whose X-RateLimit-* headers
# are the authoritative core counters (one core call; GET /rate_limit is not trusted for core).
github_api_fetch_core_quota_headers() {
  local out exit_code

  exit_code=0
  # gh must stay on the runner_exec_stdout line (runner-adoption ratchet).
  out="$(runner_exec_stdout "github-api-pace core quota probe" --probe --timeout 5 -- gh api --include zen 2>/dev/null)" \
    || exit_code=$?
  if (( exit_code != 0 )) && [[ -z "$out" ]]; then
    return 1
  fi
  printf '%s' "$out"
}

# _github_api_core_probe_refresh
# Probes core quota (no subshell, so the cache survives). Sets _github_api_core_headers_value to the
# headers when they report remaining=0 (return 0), else clears it (return 1). A probe that found the
# quota intact is reused for GITHUB_API_QUOTA_TTL_S, so one wait does not re-probe per poll (#710).
_github_api_core_probe_clean_at=0
_github_api_core_headers_value=''
_github_api_core_probe_refresh() {
  local headers ttl

  _github_api_core_headers_value=''
  ttl="${GITHUB_API_QUOTA_TTL_S:-30}"
  [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=30
  if (( _github_api_core_probe_clean_at > 0 && EPOCHSECONDS - _github_api_core_probe_clean_at < ttl )); then
    return 1
  fi
  headers="$(github_api_fetch_core_quota_headers || true)"
  if github_api_headers_depleted_reset_epoch "$headers" >/dev/null; then
    _github_api_core_headers_value="$headers"
    _github_api_core_probe_clean_at=0
    return 0
  fi
  if [[ -n "$headers" ]]; then
    _github_api_core_probe_clean_at="$EPOCHSECONDS"
  fi
  return 1
}

# github_api_core_depleted_headers
# Prints the core probe headers and returns 0 only when they report remaining=0.
github_api_core_depleted_headers() {
  if _github_api_core_probe_refresh; then
    printf '%s' "$_github_api_core_headers_value"
    return 0
  fi
  return 1
}

# github_api_pace_publish_block <epoch>
# Raises the shared blocked_until to <epoch> (never lowers it) so every caller waits with us.
github_api_pace_publish_block() {
  local -r until_epoch="${1:-0}"
  local state_dir current

  [[ "$until_epoch" =~ ^[1-9][0-9]*$ ]] || return 0
  github_api_pacing_enabled || return 0
  _github_api_pace_dir || return 0
  state_dir="$_github_api_pace_dir_value"
  _github_api_pace_lock "$state_dir" || return 0
  current="$(_github_api_pace_read "${state_dir}/blocked_until")"
  if [[ ! "$current" =~ ^[0-9]+$ ]] || (( until_epoch > current )); then
    _github_api_pace_write "${state_dir}/blocked_until" "$until_epoch"
  fi
  _github_api_pace_unlock "$state_dir"
}

# github_api_pace_gate [label]
# Blocks until this caller may start a GitHub call: honors the shared blocked_until, stops at the
# quota reserve (waiting for the reset), then claims the next minimum-spacing slot.
github_api_pace_gate() {
  local -r label="${1:-gh}"
  local state_dir now until_epoch claim_ec sleep_s waited=0 max_wait poll noted=0 probe_waits=0

  github_api_pacing_enabled || return 0
  if ! _github_api_pace_dir; then
    _github_api_pace_disabled=1
    printf 'NOTE: GITHUB_API_PACE_DISABLED reason=state_dir_unusable\n' >&2
    return 0
  fi
  state_dir="$_github_api_pace_dir_value"
  max_wait="${github_api_rate_limit_max_wait_s}"
  poll="${github_api_rate_limit_poll_s}"
  [[ "$max_wait" =~ ^[0-9]+$ ]] || max_wait=3600
  [[ "$poll" =~ ^[1-9][0-9]*$ ]] || poll=30

  while :; do
    now="$EPOCHSECONDS"
    until_epoch="$(_github_api_pace_read "${state_dir}/blocked_until")"
    [[ "$until_epoch" =~ ^[0-9]+$ ]] || until_epoch=0
    if (( now < until_epoch )); then
      sleep_s=$(( until_epoch - now ))
      if (( sleep_s > poll )); then
        sleep_s="$poll"
      fi
      if (( waited + sleep_s > max_wait )); then
        printf 'NOTE: GITHUB_API_PACE_GIVE_UP label=%s waited=%ss\n' "$label" "$waited" >&2
        return 0
      fi
      if (( noted == 0 )); then
        printf 'NOTE: GITHUB_API_PACE_WAIT label=%s until=%s remaining=%ss\n' \
          "$label" "$until_epoch" "$(( until_epoch - now ))" >&2
        noted=1
      fi
      run_command "github-api pace wait" sleep "$sleep_s"
      waited=$(( waited + sleep_s ))
      continue
    fi
    claim_ec=0
    _github_api_pace_claim "$state_dir" "$label" || claim_ec=$?
    if (( claim_ec == 0 )); then
      if [[ -n "${_github_api_pace_slot_sleep_s:-}" ]]; then
        run_command "github-api pace slot" sleep "$_github_api_pace_slot_sleep_s"
      fi
      return 0
    fi
    if (( claim_ec == 11 )); then
      # Another caller is refreshing the quota (a probe is bounded by its 5 s timeout).
      probe_waits=$(( probe_waits + 1 ))
      if (( probe_waits > 300 )); then
        printf 'NOTE: GITHUB_API_PACE_GIVE_UP label=%s reason=probe_in_flight\n' "$label" >&2
        return 0
      fi
      run_command "github-api pace probe wait" sleep 0.05
      continue
    fi
    if (( claim_ec != 10 )); then
      printf 'NOTE: GITHUB_API_PACE_DISABLED reason=lock_timeout label=%s\n' "$label" >&2
      return 0
    fi
  done
}

# --- private ---

# _github_api_header_value <headers_text> <name>
# Prints the first matching HTTP header value (case-insensitive name).
_github_api_header_value() {
  local -r text="$1"
  local -r name="$2"
  local line lower_name key val

  lower_name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ "$line" == *:* ]] || continue
    key="${line%%:*}"
    val="${line#*:}"
    val="${val#"${val%%[![:space:]]*}"}"
    key="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')"
    if [[ "$key" == "$lower_name" ]]; then
      printf '%s' "$val"
      return 0
    fi
  done <<<"$text"
  return 1
}

# _github_api_last_response_headers <text>
# Prints the header lines of the last HTTP response in `gh api --include` output
# (from its final `HTTP/` status line up to the first blank line).
_github_api_last_response_headers() {
  local -r text="$1"
  local line block='' in_headers=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    if [[ "$line" == HTTP/* ]]; then
      block="${line}"$'\n'
      in_headers=1
      continue
    fi
    if (( in_headers )); then
      if [[ -z "$line" ]]; then
        in_headers=0
      else
        block+="${line}"$'\n'
      fi
    fi
  done <<<"$text"
  printf '%s' "$block"
}

_github_api_last_stderr_summary() {
  local uuid stderr_text line

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || {
    printf ''
    return 0
  }
  stderr_text="$(runner_read "$uuid" stderr 2>/dev/null || true)"
  line="$(printf '%s\n' "$stderr_text" | grep -m1 '.' || true)"
  line="${line//$'\r'/}"
  line="${line#gh: }"
  printf '%s' "$line"
}

# _github_api_parse_retry_after_seconds <detail>
# Best-effort parse of "Retry after N seconds" / "wait N minute(s)" from body text.
_github_api_parse_retry_after_seconds() {
  local -r detail="$1"
  local lower n

  lower="$(printf '%s' "$detail" | tr '[:upper:]' '[:lower:]')"
  if [[ "$lower" =~ retry[[:space:]]+after[[:space:]]+([0-9]+)[[:space:]]*second ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  if [[ "$lower" =~ ([0-9]+)[[:space:]]*minutes? ]]; then
    n="${BASH_REMATCH[1]}"
    printf '%s' "$((n * 60))"
    return 0
  fi
  # "a few minutes" → conservative 180s
  if [[ "$lower" == *'few minutes'* ]]; then
    printf '180'
    return 0
  fi
  return 1
}

# _github_api_primary_quota_available
# True when core, graphql, and search each report remaining > 0.
_github_api_primary_quota_available() {
  local out exit_code

  exit_code=0
  # shellcheck disable=SC2016  # jq program is a literal string
  out="$(runner_exec_stdout "github-api-rate-limit primary remaining" --probe --timeout 30 -- gh api rate_limit --jq '([.resources.core.remaining // 0, .resources.graphql.remaining // 0, .resources.search.remaining // 0] | all(. > 0))' 2>/dev/null)" \
    || exit_code=$?
  (( exit_code == 0 )) || return 1
  [[ "$out" == 'true' ]]
}

# _github_api_quota_intact_suspect
# True for the #547 ladder: primary quota reports remaining>0, *or* the rate_limit
# probe itself failed (oracle unreliable during a global REST 403). False when the
# probe succeeds and reports depleted remaining (ordinary primary wait).
_github_api_quota_intact_suspect() {
  local out exit_code

  # Real core headers showing depletion beat the (unreliable) /rate_limit core figure (#710).
  if _github_api_core_probe_refresh; then
    return 1
  fi
  exit_code=0
  # shellcheck disable=SC2016  # jq program is a literal string
  out="$(runner_exec_stdout "github-api-rate-limit primary remaining" --probe --timeout 30 -- gh api rate_limit --jq '([.resources.core.remaining // 0, .resources.graphql.remaining // 0, .resources.search.remaining // 0] | all(. > 0))' 2>/dev/null)" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    return 0
  fi
  [[ "$out" == 'true' ]]
}

# _github_api_quota_intact_backoff_s <attempt>
# Bounded exponential backoff for REST 403 + intact primary quota (60 → 120 → 300).
_github_api_quota_intact_backoff_s() {
  local -r attempt="${1:-1}"

  case "$attempt" in
    1) printf '60' ;;
    2) printf '120' ;;
    *) printf '300' ;;
  esac
}

# _github_api_secondary_backoff_s <attempt>
# Escalating secondary/abuse cooldown when Retry-After / body guidance is absent
# (60 → 180 → 300; repository-helpers#569). Override with
# GITHUB_API_SECONDARY_RATE_LIMIT_BACKOFF_S=60,180,300 (comma-separated, 1-indexed).
_github_api_secondary_backoff_s() {
  local attempt="${1:-1}"
  local csv="${GITHUB_API_SECONDARY_RATE_LIMIT_BACKOFF_S:-}"
  local -a parts=()
  local idx value

  if [[ ! "$attempt" =~ ^[0-9]+$ ]] || (( attempt < 1 )); then
    attempt=1
  fi
  if [[ -n "$csv" ]]; then
    IFS=',' read -r -a parts <<<"$csv"
    idx=$((attempt - 1))
    if (( idx < ${#parts[@]} )); then
      value="${parts[$idx]}"
      value="${value#"${value%%[![:space:]]*}"}"
      value="${value%"${value##*[![:space:]]}"}"
      if [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 )); then
        printf '%s' "$value"
        return 0
      fi
    elif ((${#parts[@]} > 0)); then
      # Portable last-element index (avoid bash-4.3+ parts[-1]).
      value="${parts[${#parts[@]} - 1]}"
      value="${value#"${value%%[![:space:]]*}"}"
      value="${value%"${value##*[![:space:]]}"}"
      if [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 )); then
        printf '%s' "$value"
        return 0
      fi
    fi
  fi
  case "$attempt" in
    1) printf '60' ;;
    2) printf '180' ;;
    *) printf '300' ;;
  esac
}

# _github_api_pace_dir
# Sets _github_api_pace_dir_value to the shared state directory, creating it (0700) on first use;
# fails when unusable. Callers must not wrap it in $(...): the cache lives in this shell.
_github_api_pace_dir() {
  local state_dir

  if [[ -n "${_github_api_pace_dir_value:-}" && -d "$_github_api_pace_dir_value" ]]; then
    return 0
  fi
  state_dir="${GITHUB_API_STATE_DIR:-}"
  if [[ -z "$state_dir" ]]; then
    [[ -n "${HOME:-}" ]] || return 1
    state_dir="${HOME}/scratch/repository-helpers/github-api-state"
  fi
  if [[ ! -d "$state_dir" ]]; then
    mkdir -p -- "$state_dir" 2>/dev/null || return 1
    chmod 700 -- "$state_dir" 2>/dev/null || true
  fi
  [[ -d "$state_dir" && -w "$state_dir" ]] || return 1
  _github_api_pace_dir_value="$state_dir"
}

# _github_api_pace_lock <state_dir>
# Takes the state lock. Primary path is flock(1) on <state_dir>/lock.file (released by the kernel when
# the holder dies, so no stale locks); hosts without flock fall back to an atomic mkdir lock. The
# fallback only breaks a lock that has been held for more than 30 s (critical sections last
# milliseconds, so that is a crashed holder). It deliberately does not judge staleness by owner
# pid liveness: a waiter can read an owner that has since exited normally and then remove the
# lock of the next holder, which admits two callers at once. ~5 s budget either way, then fails.
_github_api_pace_lock() {
  local -r lockdir="${1}/lock"
  local tries=0 since nosince=0 now

  if [[ "${GITHUB_API_PACE_LOCK:-}" != 'mkdir' ]] && command -v flock >/dev/null 2>&1; then
    exec {_github_api_pace_lock_fd}>"${1}/lock.file" || return 1
    if flock --exclusive --timeout 5 "$_github_api_pace_lock_fd"; then
      return 0
    fi
    exec {_github_api_pace_lock_fd}>&-
    _github_api_pace_lock_fd=''
    return 1
  fi
  while ! mkdir -- "$lockdir" 2>/dev/null; do
    since=''
    { read -r since <"${lockdir}/since"; } 2>/dev/null || true
    now="$EPOCHSECONDS"
    if [[ "$since" =~ ^[0-9]+$ ]]; then
      nosince=0
      if (( now - since > 30 )); then
        _github_api_pace_break_stale "$lockdir" "$since"
        continue
      fi
    else
      # A holder writes "since" microseconds after mkdir; only a long, unbroken absence means it
      # crashed in between.
      nosince=$(( nosince + 1 ))
      if (( nosince > 100 )); then
        _github_api_pace_break_stale "$lockdir" ''
        nosince=0
        continue
      fi
    fi
    tries=$(( tries + 1 ))
    if (( tries > 500 )); then
      return 1
    fi
    run_command "github-api pace lock wait" sleep 0.01
  done
  printf '%s\n' "$EPOCHSECONDS" >"${lockdir}/since"
}

# _github_api_pace_break_stale <lockdir> <seen-since>
# Removes a lock judged stale. The rename is atomic, so of several waiters only one removes it; the
# renamed copy is then checked against the "since" value the waiter judged by, and a lock that is
# not that one (a fresh holder took over in between) is put back untouched. Best-effort only:
# real mutual exclusion is the flock path; this fallback just must not wedge a crashed holder.
_github_api_pace_break_stale() {
  local -r lockdir="$1"
  local -r seen="$2"
  local -r grave="${lockdir}.stale.${BASHPID}"
  local actual=''

  mv -- "$lockdir" "$grave" 2>/dev/null || return 0
  { read -r actual <"${grave}/since"; } 2>/dev/null || true
  if [[ "$actual" == "$seen" ]]; then
    rm -rf -- "$grave"
    return 0
  fi
  # -T: when a third waiter already re-created $lockdir, never nest the grave inside it; whatever is
  # left of the grave afterwards is discarded.
  mv -n -T -- "$grave" "$lockdir" 2>/dev/null || true
  rm -rf -- "$grave"
}

# _github_api_pace_unlock <state_dir>
_github_api_pace_unlock() {
  if [[ -n "${_github_api_pace_lock_fd:-}" ]]; then
    exec {_github_api_pace_lock_fd}>&-
    _github_api_pace_lock_fd=''
    return 0
  fi
  rm -rf -- "${1}/lock"
}

# _github_api_pace_read <file>
# Prints the first line of <file>, or nothing.
_github_api_pace_read() {
  local line=''

  { read -r line <"$1"; } 2>/dev/null || true
  printf '%s' "$line"
}

# _github_api_pace_write <file> <text>
# Replaces <file> atomically so unlocked readers never see a partial value.
_github_api_pace_write() {
  local -r tmp="${1}.tmp.${BASHPID}"

  printf '%s\n' "$2" >"$tmp" && mv -f -- "$tmp" "$1"
}

# _github_api_pace_probe_quota
# Prints "remaining reset" from a real core response, or nothing when the probe is unusable.
_github_api_pace_probe_quota() {
  local headers block remaining reset resource

  headers="$(github_api_fetch_core_quota_headers || true)"
  block="$(_github_api_last_response_headers "$headers")"
  remaining="$(_github_api_header_value "$block" 'x-ratelimit-remaining' || true)"
  reset="$(_github_api_header_value "$block" 'x-ratelimit-reset' || true)"
  resource="$(_github_api_header_value "$block" 'x-ratelimit-resource' || true)"
  [[ "$remaining" =~ ^[0-9]+$ && "$reset" =~ ^[0-9]+$ ]] || return 0
  [[ -z "$resource" || "$resource" == 'core' ]] || return 0
  printf '%s %s' "$remaining" "$reset"
}

# Reset probing_until only while it still holds our marker (a later prober may have replaced it).
# Caller holds the state lock.
_github_api_pace_clear_probe_marker() {
  local -r state_dir="$1"
  local -r marker="$2"
  local current

  current="$(_github_api_pace_read "${state_dir}/probing_until")"
  if [[ "$current" == "$marker" ]]; then
    _github_api_pace_write "${state_dir}/probing_until" 0
  fi
}

# _github_api_pace_claim <state_dir> <label>
# Admits one call. Under the state lock only (never across a network call): honor a block published
# since the caller looked, refresh a stale quota, stop at the reserve, else claim the next call slot
# and count the call. A stale quota is refreshed by one caller at a time without holding the lock:
# it publishes a short probing_until marker, drops the lock, probes, then re-locks to record the
# result; callers that arrive meanwhile get status 11 and retry shortly.
# Returns 0 admitted (slot wait in _github_api_pace_slot_sleep_s), 10 blocked (blocked_until set or
# raised; caller re-loops), 11 a probe is in flight (caller retries), 1 lock timeout.
_github_api_pace_claim() {
  local -r state_dir="$1"
  local -r label="$2"
  local now now_us quota remaining reset observed ttl reserve interval_us slot calls cushion probed
  local wait_us until_epoch probing current_block probe_marker

  _github_api_pace_slot_sleep_s=''
  ttl="${GITHUB_API_QUOTA_TTL_S:-30}"
  reserve="${GITHUB_API_QUOTA_RESERVE:-200}"
  interval_us="${GITHUB_API_MIN_INTERVAL_MS:-100}"
  cushion="${github_api_rate_limit_reset_cushion_s}"
  [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=30
  [[ "$reserve" =~ ^[0-9]+$ ]] || reserve=200
  [[ "$interval_us" =~ ^[0-9]+$ ]] || interval_us=100
  interval_us=$(( interval_us * 1000 ))

  _github_api_pace_lock "$state_dir" || return 1
  now="$EPOCHSECONDS"
  until_epoch="$(_github_api_pace_read "${state_dir}/blocked_until")"
  if [[ "$until_epoch" =~ ^[0-9]+$ ]] && (( now < until_epoch )); then
    _github_api_pace_unlock "$state_dir"
    return 10
  fi
  quota="$(_github_api_pace_read "${state_dir}/quota")"
  remaining='' reset='' observed=''
  read -r remaining reset observed <<<"$quota" || true
  if [[ ! "$observed" =~ ^[0-9]+$ ]] || (( now - observed > ttl )); then
    probing="$(_github_api_pace_read "${state_dir}/probing_until")"
    if [[ "$probing" =~ ^[0-9]+$ ]] && (( now < probing )); then
      _github_api_pace_unlock "$state_dir"
      return 11
    fi
    # Claim the probe: the marker outlives the probe timeout, so a killed prober delays nobody for
    # long, and the network call happens with the state lock released.
    probe_marker="$(( now + 10 ))"
    _github_api_pace_write "${state_dir}/probing_until" "$probe_marker"
    _github_api_pace_unlock "$state_dir"
    probed="$(_github_api_pace_probe_quota)"
    if ! _github_api_pace_lock "$state_dir"; then
      # Best effort: one more try so a lock hiccup does not leave the marker up for its full expiry.
      if _github_api_pace_lock "$state_dir"; then
        _github_api_pace_clear_probe_marker "$state_dir" "$probe_marker"
        _github_api_pace_unlock "$state_dir"
      fi
      return 1
    fi
    now="$EPOCHSECONDS"
    if [[ -n "$probed" ]]; then
      read -r remaining reset <<<"$probed"
    else
      # Probe failed: the cached figure is stale, so do not enforce the reserve on it. Record the
      # attempt time so the next callers do not each re-probe a failing endpoint within the TTL.
      remaining='?' reset='?'
    fi
    observed="$now"
    _github_api_pace_write "${state_dir}/quota" "${remaining} ${reset} ${observed}"
    _github_api_pace_clear_probe_marker "$state_dir" "$probe_marker"
    until_epoch="$(_github_api_pace_read "${state_dir}/blocked_until")"
    if [[ "$until_epoch" =~ ^[0-9]+$ ]] && (( now < until_epoch )); then
      _github_api_pace_unlock "$state_dir"
      return 10
    fi
  fi
  now_us="${EPOCHREALTIME//[!0-9]/}"

  if [[ "$remaining" =~ ^[0-9]+$ && "$reset" =~ ^[0-9]+$ && "$observed" =~ ^[0-9]+$ ]]; then
    if (( remaining <= reserve && now < reset )); then
      _github_api_pace_write "${state_dir}/quota" "${remaining} ${reset} ${observed}"
      printf 'NOTE: GITHUB_API_PACE_RESERVE label=%s remaining=%s reserve=%s reset=%s\n' \
        "$label" "$remaining" "$reserve" "$reset" >&2
      # Only ever raise the shared block (another caller may have published a later deadline).
      current_block="$(_github_api_pace_read "${state_dir}/blocked_until")"
      if [[ ! "$current_block" =~ ^[0-9]+$ ]] || (( reset + cushion > current_block )); then
        _github_api_pace_write "${state_dir}/blocked_until" "$(( reset + cushion ))"
      fi
      _github_api_pace_unlock "$state_dir"
      return 10
    fi
    if (( remaining > 0 )); then
      remaining=$(( remaining - 1 ))
    fi
    _github_api_pace_write "${state_dir}/quota" "${remaining} ${reset} ${observed}"
  fi

  slot="$(_github_api_pace_read "${state_dir}/next_slot")"
  [[ "$slot" =~ ^[0-9]+$ ]] || slot=0
  if (( slot < now_us )); then
    slot="$now_us"
  fi
  _github_api_pace_write "${state_dir}/next_slot" "$(( slot + interval_us ))"
  calls="$(_github_api_pace_read "${state_dir}/calls")"
  [[ "$calls" =~ ^[0-9]+$ ]] || calls=0
  _github_api_pace_write "${state_dir}/calls" "$(( calls + 1 ))"
  _github_api_pace_unlock "$state_dir"

  wait_us=$(( slot - now_us ))
  if (( wait_us > 5000 )); then
    printf -v _github_api_pace_slot_sleep_s '%d.%06d' "$(( wait_us / 1000000 ))" "$(( wait_us % 1000000 ))"
  fi
  return 0
}
