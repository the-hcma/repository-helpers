# shellcheck shell=bash
# github-api-rate-limit — detect GitHub API primary/secondary rate limits and wait.
#
# Used by agent-review and repo-practices gh wrappers so coding-agent flows sleep
# until reset instead of failing hard on HTTP 403 "API rate limit exceeded".
#
# Env overrides:
#   GITHUB_API_RATE_LIMIT_MAX_RETRIES   wait-and-retry cycles (default 3)
#   GITHUB_API_RATE_LIMIT_MAX_WAIT_S   total wait budget per wait (default 3600)
#   GITHUB_API_RATE_LIMIT_POLL_S       sleep chunk while waiting (default 30)
#   GITHUB_API_RATE_LIMIT_RETRY_SLEEP_S  fallback when reset unknown (default 60)

if declare -F github_api_detail_is_rate_limited >/dev/null 2>&1; then
  return 0
fi

_github_api_rl_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _github_api_rl_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_github_api_rl_lib_dir}/runner-ensure"

github_api_rate_limit_max_retries="${GITHUB_API_RATE_LIMIT_MAX_RETRIES:-3}"
github_api_rate_limit_max_wait_s="${GITHUB_API_RATE_LIMIT_MAX_WAIT_S:-3600}"
github_api_rate_limit_poll_s="${GITHUB_API_RATE_LIMIT_POLL_S:-30}"
github_api_rate_limit_retry_sleep_s="${GITHUB_API_RATE_LIMIT_RETRY_SLEEP_S:-60}"

# github_api_detail_is_rate_limited <detail>
# True for primary/secondary GitHub API rate-limit wording (403 or 429).
github_api_detail_is_rate_limited() {
  local -r detail="$1"
  local lower

  lower="$(printf '%s' "$detail" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower" == *'rate limit'* \
    || "$lower" == *'rate limited'* \
    || "$lower" == *'secondary rate'* \
    || "$detail" == *'429'* ]]
}

# github_api_exec_with_rate_limit_retry <label> [--probe] -- <cmd> [args…]
# Runs via runner_exec --stream-stdout. On rate-limit stderr, waits and retries.
github_api_exec_with_rate_limit_retry() {
  local label probe=0
  local -a cmd=()
  local exit_code attempt max_retries detail

  label="${1:?github_api_exec_with_rate_limit_retry: label required}"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)
        probe=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'github_api_exec_with_rate_limit_retry: expected -- before command (label=%s)\n' \
          "$label" >&2
        return 2
        ;;
    esac
  done
  cmd=("$@")
  ((${#cmd[@]} > 0)) || {
    printf 'github_api_exec_with_rate_limit_retry: empty command (label=%s)\n' "$label" >&2
    return 2
  }

  max_retries="${github_api_rate_limit_max_retries}"
  if [[ ! "$max_retries" =~ ^[0-9]+$ ]] || (( max_retries < 1 )); then
    max_retries=3
  fi

  attempt=1
  while (( attempt <= max_retries )); do
    exit_code=0
    if (( probe )); then
      runner_exec "$label" --probe --stream-stdout -- "${cmd[@]}" || exit_code=$?
    else
      runner_exec "$label" --stream-stdout -- "${cmd[@]}" || exit_code=$?
    fi
    if (( exit_code == 0 )); then
      return 0
    fi
    detail="$(_github_api_last_stderr_summary)"
    if ! github_api_detail_is_rate_limited "$detail"; then
      return "$exit_code"
    fi
    if (( attempt >= max_retries )); then
      printf 'ERROR: GITHUB_RATE_LIMIT label=%s attempts=%s detail=%s\n' \
        "$label" "$max_retries" "$detail" >&2
      return "$exit_code"
    fi
    printf 'NOTE: GITHUB_RATE_LIMIT_HIT label=%s attempt=%s/%s detail=%s\n' \
      "$label" "$attempt" "$max_retries" "$detail" >&2
    github_api_wait_for_rate_limit "$detail" || return $?
    attempt=$((attempt + 1))
  done
  return "$exit_code"
}

# github_api_rate_limit_core_reset_epoch
# Prints core.reset unix epoch from gh api rate_limit (empty on failure).
github_api_rate_limit_core_reset_epoch() {
  local out exit_code

  exit_code=0
  # gh must stay on the runner_exec_stdout line (runner-adoption ratchet).
  out="$(runner_exec_stdout "github-api-rate-limit core reset" --probe -- gh api rate_limit --jq '.resources.core.reset // empty' 2>/dev/null)" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    return 1
  fi
  if [[ "$out" =~ ^[0-9]+$ ]]; then
    printf '%s' "$out"
    return 0
  fi
  return 1
}

# github_api_runner_last_detail_is_rate_limited
# True when the most recent runner stderr summary looks rate-limited.
github_api_runner_last_detail_is_rate_limited() {
  local detail

  detail="$(_github_api_last_stderr_summary)"
  github_api_detail_is_rate_limited "$detail"
}

# github_api_wait_for_rate_limit [detail]
# Sleeps until core reset (or fallback backoff). Exit 124 on WAIT_TIMEOUT.
github_api_wait_for_rate_limit() {
  local -r detail="${1:-}"
  local max_wait poll fallback_sleep
  local waited=0 sleep_s remaining reset_epoch now retry_after_s

  max_wait="${github_api_rate_limit_max_wait_s}"
  poll="${github_api_rate_limit_poll_s}"
  fallback_sleep="${github_api_rate_limit_retry_sleep_s}"
  if [[ ! "$max_wait" =~ ^[0-9]+$ ]]; then
    max_wait=3600
  fi
  if [[ ! "$poll" =~ ^[0-9]+$ ]] || (( poll < 1 )); then
    poll=30
  fi
  if [[ ! "$fallback_sleep" =~ ^[0-9]+$ ]] || (( fallback_sleep < 1 )); then
    fallback_sleep=60
  fi

  retry_after_s="$(_github_api_parse_retry_after_seconds "$detail")"

  while (( waited < max_wait )); do
    reset_epoch=""
    if reset_epoch="$(github_api_rate_limit_core_reset_epoch)"; then
      now="$(date +%s)"
      remaining=$((reset_epoch - now))
      if (( remaining <= 0 )); then
        printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR reset=%s waited=%ss\n' \
          "$reset_epoch" "$waited" >&2
        return 0
      fi
      sleep_s="$remaining"
      if (( sleep_s > poll )); then
        sleep_s="$poll"
      fi
      if (( waited + sleep_s > max_wait )); then
        sleep_s=$((max_wait - waited))
      fi
      if (( sleep_s < 1 )); then
        sleep_s=1
      fi
      printf 'NOTE: GITHUB_RATE_LIMIT_WAIT reset_epoch=%s remaining=%ss sleep=%ss waited=%ss/%ss\n' \
        "$reset_epoch" "$remaining" "$sleep_s" "$waited" "$max_wait" >&2
    else
      sleep_s="$fallback_sleep"
      if [[ -n "$retry_after_s" ]]; then
        sleep_s="$retry_after_s"
        retry_after_s=""
      fi
      if (( sleep_s > poll )); then
        sleep_s="$poll"
      fi
      if (( waited + sleep_s > max_wait )); then
        sleep_s=$((max_wait - waited))
      fi
      if (( sleep_s < 1 )); then
        sleep_s=1
      fi
      printf 'NOTE: GITHUB_RATE_LIMIT_WAIT reset_unknown sleep=%ss waited=%ss/%ss\n' \
        "$sleep_s" "$waited" "$max_wait" >&2
    fi
    run_command "github-api-rate-limit wait sleep" sleep "$sleep_s"
    waited=$((waited + sleep_s))

    # Re-check: if remaining quota returned, stop early.
    if reset_epoch="$(github_api_rate_limit_core_reset_epoch)"; then
      now="$(date +%s)"
      remaining=$((reset_epoch - now))
      # Also check remaining count when available.
      if _github_api_core_remaining_positive; then
        printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR remaining_ok waited=%ss\n' "$waited" >&2
        return 0
      fi
      if (( remaining <= 0 )); then
        printf 'NOTE: GITHUB_RATE_LIMIT_CLEAR reset=%s waited=%ss\n' \
          "$reset_epoch" "$waited" >&2
        return 0
      fi
    fi
  done

  printf 'ERROR: WAIT_TIMEOUT GITHUB_RATE_LIMIT timeout=%ss\n' "$max_wait" >&2
  return 124
}

# --- private ---

_github_api_core_remaining_positive() {
  local out exit_code

  exit_code=0
  out="$(runner_exec_stdout "github-api-rate-limit core remaining" --probe -- gh api rate_limit --jq '.resources.core.remaining // 0' 2>/dev/null)" \
    || exit_code=$?
  (( exit_code == 0 )) || return 1
  [[ "$out" =~ ^[0-9]+$ ]] || return 1
  (( out > 0 ))
}

_github_api_last_stderr_summary() {
  local uuid stderr_text line

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || {
    printf ''
    return 0
  }
  stderr_text="$(runner_read "$uuid" stderr 2>/dev/null || true)"
  line="$(printf '%s\n' "$stderr_text" | grep -m1 '.' || true)"
  line="${line//$'\r'/}"
  line="${line#gh: }"
  printf '%s' "$line"
}

# _github_api_parse_retry_after_seconds <detail>
# Best-effort parse of "Retry after N seconds" / "wait N minute(s)".
_github_api_parse_retry_after_seconds() {
  local -r detail="$1"
  local lower n

  lower="$(printf '%s' "$detail" | tr '[:upper:]' '[:lower:]')"
  if [[ "$lower" =~ retry[[:space:]]+after[[:space:]]+([0-9]+)[[:space:]]*second ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  if [[ "$lower" =~ ([0-9]+)[[:space:]]*minute ]]; then
    n="${BASH_REMATCH[1]}"
    printf '%s' "$((n * 60))"
    return 0
  fi
  return 1
}
