#!/usr/bin/env bash
# CodeRabbit agent profile for wait-for-agent-review.
# shellcheck disable=SC2034  # profile contract variables are read by scripts/lib/agent-review after source
#
# CodeRabbit reviews run automatically on PR updates in org repos that have it enabled.
# This profile waits for those reviews and triages inline/summary feedback — it does
# not post @coderabbitai review (see agent_review_profile_auto_review).

agent_review_profile_id='coderabbit'
agent_review_profile_auto_review=true
agent_review_profile_request_login_regex='coderabbit|rabbit'
agent_review_profile_thread_login_regex='coderabbit|rabbit'

# agent_review_profile_login_matches <github_login>
agent_review_profile_login_matches() {
  local -r login="${1:-}"

  [[ "${login,,}" == *coderabbit* || "${login,,}" == *rabbit* ]]
}

# agent_review_profile_text_is_quota_exhausted <text>
# True when CodeRabbit issue-comment or review body reports billing or usage limits.
# Normal walkthrough reviews discuss quota-related code — those are not exhaustion.
agent_review_profile_text_is_quota_exhausted() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  if agent_review_profile_review_has_actionable_feedback "${text}"; then
    return 1
  fi
  lower="${text,,}"
  # Rate-limit / review-limit notices often include the summarize marker — check first.
  if [[ "${lower}" =~ usage[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limit"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limited"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"summarize by coderabbit"* ]] \
    || [[ "${lower}" == *"walkthrough_start"* ]] \
    || [[ "${lower}" == *"review_stack_entry"* ]] \
    || [[ "${lower}" == *"review paused"* ]]; then
    return 1
  fi
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted ]]; then
    return 1
  fi
  if [[ "${lower}" =~ review[[:space:]]+completed ]]; then
    return 1
  fi
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|issue) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ subscription[[:space:]]+(limit|expired) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ could[[:space:]]+not[[:space:]]+run ]] \
    && [[ "${lower}" =~ (quota|usage|limit|billing|subscription|rate[[:space:]]+limit) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_text_is_coderabbit_billing_block <text>
# True when text unmistakably reports CodeRabbit billing or usage limits (not walkthrough prose).
agent_review_profile_text_is_coderabbit_billing_block() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  lower="${text,,}"
  if [[ "${lower}" =~ usage[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]+of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|issue) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ subscription[[:space:]]+(limit|expired) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ could[[:space:]]+not[[:space:]]+run ]] \
    && [[ "${lower}" =~ (quota|usage|limit|billing|subscription|rate[[:space:]]+limit) ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limit"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limited"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_issue_comment_is_quota_exhausted <login> <body>
agent_review_profile_issue_comment_is_quota_exhausted() {
  local -r login="${1:-}"
  local -r body="${2:-}"

  if ! agent_review_profile_text_is_coderabbit_billing_block "${body}"; then
    return 1
  fi
  if agent_review_profile_login_matches "${login}"; then
    return 0
  fi
  agent_review_profile_text_is_quota_exhausted "${body}"
}

# agent_review_profile_review_is_quota_exhausted <review_body>
agent_review_profile_review_is_quota_exhausted() {
  local -r body="${1:-}"

  agent_review_profile_text_is_quota_exhausted "${body}"
}

# agent_review_profile_review_has_actionable_feedback <review_body>
# True when CodeRabbit posted actionable inline feedback or summary-body findings.
agent_review_profile_review_has_actionable_feedback() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ nitpick[[:space:]]+comments[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ potential[[:space:]]+issue[s]?[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ inline[[:space:]]+comments: ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (must[[:space:]]+fix|blocking[[:space:]]+comment) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_review_is_empty <review_body>
# True when CodeRabbit's latest head review reports no actionable feedback.
agent_review_profile_review_is_empty() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  if agent_review_profile_review_has_actionable_feedback "${body}"; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*0 ]]; then
    return 0
  fi
  if [[ "${lower}" == *"no actionable comments were generated"* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no[[:space:]]+issues[[:space:]]+found|all[[:space:]]+clear|looks[[:space:]]+good|lgtm) ]]; then
    return 0
  fi
  if [[ "${lower}" == *"review completed"* ]] \
    && [[ "${lower}" != *nitpick* ]] \
    && [[ "${lower}" != *actionable* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_fresh_on_head <snapshot> <head> <repo> <pr>
# CodeRabbit posts walkthrough summaries as issue comments, not GraphQL reviews.
agent_review_profile_fresh_on_head() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    return 1
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    return 0
  fi
  short_head="${head:0:7}"
  [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]
}

# agent_review_profile_latest_review_body_on_head <snapshot> <head> <repo> <pr>
agent_review_profile_latest_review_body_on_head() {
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    printf '\n'
    return 0
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  short_head="${head:0:7}"
  if [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  printf '\n'
}

# agent_review_profile_request <repo> <pr>
# Not used — cmd_request skips manual triggers when agent_review_profile_auto_review is true.
agent_review_profile_request() {
  local -r repo="$1"
  local -r pr="$2"

  printf 'wait-for-agent-review: coderabbit profile_request called but CodeRabbit is auto-review only (PR #%s)\n' \
    "${pr}" >&2
  return 1
}
