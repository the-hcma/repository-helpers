#!/usr/bin/env bash
# CodeRabbit agent profile for wait-for-agent-review.
# shellcheck disable=SC2034  # profile contract variables are read by scripts/lib/agent-review after source
#
# Agent trigger kinds (issue #347):
#   on_push  — reviews run automatically after pushes (CodeRabbit). Never post a nudge comment
#              for ordinary asks. Last-resort full review is loop-gated after cooldown+grace.
#   nudge    — need an explicit PR comment / request (Copilot, Bugbot).
#
# CodeRabbit is on_push: wait for automatic reviews and triage feedback. Do not post
# an ordinary coderabbitai review nudge (see agent_review_profile_auto_review /
# agent_review_profile_trigger). Last-resort full review uses a separate helper.

agent_review_profile_id='coderabbit'
agent_review_profile_auto_review=true
# on_push | nudge — specialized loop behavior (auto wait vs explicit request).
agent_review_profile_trigger='on_push'
agent_review_profile_request_login_regex='coderabbit|rabbit'
agent_review_profile_thread_login_regex='coderabbit|rabbit'

if [[ -z "${_coderabbit_lib_dir:-}" ]]; then
  _coderabbit_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  readonly _coderabbit_lib_dir
fi
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_coderabbit_lib_dir}/../runner-ensure"

# agent_review_profile_login_matches <github_login>
agent_review_profile_login_matches() {
  local -r login="${1:-}"

  [[ "${login,,}" == *coderabbit* || "${login,,}" == *rabbit* ]]
}

# agent_review_profile_text_is_quota_exhausted <text>
# True when CodeRabbit issue-comment or review body reports billing or usage limits.
# Normal walkthrough reviews discuss quota-related code — those are not exhaustion.
agent_review_profile_text_is_quota_exhausted() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  if agent_review_profile_review_has_actionable_feedback "${text}"; then
    return 1
  fi
  lower="${text,,}"
  # Rate-limit / review-limit notices often include the summarize marker — check first.
  if [[ "${lower}" =~ usage[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  # Cooldown-only wording (e.g. after full review) may omit "review limit reached".
  if [[ "${lower}" =~ next[[:space:]]+review[[:space:]]+available[[:space:]]+in ]]; then
    return 0
  fi
  if [[ "${lower}" =~ more[[:space:]]+reviews?[[:space:]]+(will[[:space:]]+be[[:space:]]+)?available[[:space:]]+in ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limit"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limited"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"summarize by coderabbit"* ]] \
    || [[ "${lower}" == *"walkthrough_start"* ]] \
    || [[ "${lower}" == *"review_stack_entry"* ]] \
    || [[ "${lower}" == *"review paused"* ]]; then
    return 1
  fi
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted ]]; then
    return 1
  fi
  if [[ "${lower}" =~ review[[:space:]]+completed ]]; then
    return 1
  fi
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|issue) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ subscription[[:space:]]+(limit|expired) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ could[[:space:]]+not[[:space:]]+run ]] \
    && [[ "${lower}" =~ (quota|usage|limit|billing|subscription|rate[[:space:]]+limit) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_text_is_coderabbit_billing_block <text>
# True when text unmistakably reports CodeRabbit billing or usage limits (not walkthrough prose).
agent_review_profile_text_is_coderabbit_billing_block() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  lower="${text,,}"
  if [[ "${lower}" =~ usage[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  # Cooldown-only wording is for CodeRabbit-authored comments (see text_is_quota_exhausted).
  # Do not treat walkthroughs/Bugbot summaries that quote those phrases as billing blocks.
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]+of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|issue) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ subscription[[:space:]]+(limit|expired) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ could[[:space:]]+not[[:space:]]+run ]] \
    && [[ "${lower}" =~ (quota|usage|limit|billing|subscription|rate[[:space:]]+limit) ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limit"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limited"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_text_quota_retry_after_iso <text> <anchor_timestamp_iso>
# Prints UTC ISO-8601 when a rate-limited comment says the next review is available.
# Second arg is the anchor timestamp (prefer comment updated_at; fall back to created_at).
agent_review_profile_text_quota_retry_after_iso() {
  local -r text="${1:-}"
  local -r anchor_at="${2:-}"
  local lower minutes hours seconds retry_at

  if [[ -z "${text}" || -z "${anchor_at}" ]]; then
    return 1
  fi
  lower="${text,,}"
  # Prefer seconds before minutes so "28 seconds" is not ignored (issue #347).
  # Match "Next review available in …" and "More reviews will be available in …"
  # (CodeRabbit's post-`@coderabbitai full review` cooldown on limited plans).
  if [[ "${lower}" =~ (next[[:space:]]+review[[:space:]]+available|more[[:space:]]+reviews?[[:space:]]+(will[[:space:]]+be[[:space:]]+)?available)[[:space:]]+in[^0-9]*([0-9]+)[[:space:]]*seconds? ]]; then
    seconds="${BASH_REMATCH[3]}"
    retry_at="$(runner_exec_stdout "coderabbit retry_after +seconds" -- \
      date -u -d "${anchor_at} + ${seconds} seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  if [[ "${lower}" =~ (next[[:space:]]+review[[:space:]]+available|more[[:space:]]+reviews?[[:space:]]+(will[[:space:]]+be[[:space:]]+)?available)[[:space:]]+in[^0-9]*([0-9]+)[[:space:]]*minutes? ]]; then
    minutes="${BASH_REMATCH[3]}"
    retry_at="$(runner_exec_stdout "coderabbit retry_after +minutes" -- \
      date -u -d "${anchor_at} + ${minutes} minutes" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  if [[ "${lower}" =~ (next[[:space:]]+review[[:space:]]+available|more[[:space:]]+reviews?[[:space:]]+(will[[:space:]]+be[[:space:]]+)?available)[[:space:]]+in[^0-9]*([0-9]+)[[:space:]]*hours? ]]; then
    hours="${BASH_REMATCH[3]}"
    retry_at="$(runner_exec_stdout "coderabbit retry_after +hours" -- \
      date -u -d "${anchor_at} + ${hours} hours" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  if [[ "${lower}" =~ (resets?[[:space:]]+at|available[[:space:]]+again[[:space:]]+at)[[:space:]]*:*[[:space:]]*([0-9]{4}-[0-9]{2}-[0-9]{2}[^[:space:]<]+) ]]; then
    retry_at="$(runner_exec_stdout "coderabbit retry_after absolute" -- \
      date -u -d "${BASH_REMATCH[2]}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  return 1
}

# agent_review_profile_issue_comment_is_quota_exhausted <login> <body>
agent_review_profile_issue_comment_is_quota_exhausted() {
  local -r login="${1:-}"
  local -r body="${2:-}"
  local lower

  if agent_review_profile_login_matches "${login}"; then
    if agent_review_profile_text_is_quota_exhausted "${body}"; then
      return 0
    fi
    agent_review_profile_text_is_coderabbit_billing_block "${body}"
    return $?
  fi
  # Other authors (e.g. github-actions): require an unmistakable billing block that
  # names CodeRabbit. Soft "quota exceeded" prose from Copilot reviews must not match.
  if ! agent_review_profile_text_is_coderabbit_billing_block "${body}"; then
    return 1
  fi
  lower="${body,,}"
  [[ "${lower}" == *coderabbit* ]]
}

# agent_review_profile_review_is_quota_exhausted <review_body>
agent_review_profile_review_is_quota_exhausted() {
  local -r body="${1:-}"

  agent_review_profile_text_is_coderabbit_billing_block "${body}"
}

# agent_review_profile_review_has_actionable_feedback <review_body>
# True when CodeRabbit posted actionable inline feedback or summary-body findings.
agent_review_profile_review_has_actionable_feedback() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ nitpick[[:space:]]+comments[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ potential[[:space:]]+issue[s]?[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ inline[[:space:]]+comments: ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (must[[:space:]]+fix|blocking[[:space:]]+comment) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_review_has_inline_actionable_feedback <review_body>
# True when CodeRabbit posted inline actionable findings (not nitpick-only summaries).
agent_review_profile_review_has_inline_actionable_feedback() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ potential[[:space:]]+issue[s]?[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ inline[[:space:]]+comments: ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (must[[:space:]]+fix|blocking[[:space:]]+comment) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_head_feedback_needs_operator_triage <snapshot> <head> <repo> <pr>
# True when the latest head review has nitpick/actionable body feedback with no operator reply yet.
agent_review_profile_head_feedback_needs_operator_triage() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local reviews_json body submitted_at

  reviews_json="$(agent_review_agent_reviews_on_head "${snapshot}" "${head}")"
  body="$(ar_runner_jq_file "coderabbit profile latest head review body" "${reviews_json}" -r \
    '[.[] | select((.body // "") | length > 0)]
    | if length > 0 then (sort_by(.submittedAt) | last | .body // "") else "" end')"
  if [[ -z "${body}" ]] || agent_review_profile_review_is_empty "${body}"; then
    return 1
  fi
  submitted_at="$(ar_runner_jq_file "coderabbit profile latest head review time" "${reviews_json}" -r \
    '[.[] | select((.body // "") | length > 0)]
    | if length > 0 then (sort_by(.submittedAt) | last | .submittedAt // "") else "" end')"
  if [[ -n "${submitted_at}" ]] \
    && agent_review_pr_has_operator_issue_comment_after "${repo}" "${pr}" "${submitted_at}"; then
    return 1
  fi
  return 0
}

# agent_review_profile_review_is_empty <review_body>
# True when CodeRabbit's latest head review reports no actionable feedback.
agent_review_profile_review_is_empty() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  if agent_review_profile_review_has_actionable_feedback "${body}"; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*0 ]]; then
    return 0
  fi
  if [[ "${lower}" == *"no actionable comments were generated"* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no[[:space:]]+issues[[:space:]]+found|all[[:space:]]+clear|looks[[:space:]]+good|lgtm) ]]; then
    return 0
  fi
  if [[ "${lower}" == *"review completed"* ]] \
    && [[ "${lower}" != *nitpick* ]] \
    && [[ "${lower}" != *actionable* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_fresh_on_head <snapshot> <head> <repo> <pr>
# CodeRabbit posts walkthrough summaries as issue comments, not GraphQL reviews.
# Rate-limit / billing stubs often mention the head SHA in "Reviewing files…" metadata —
# those are not completed reviews and must not count as fresh (repository-helpers#368).
# Commit status "Review completed" alone is also not enough — complete requires a real
# sign-off body/check from an agent on this head (issue #369 follow-up).
agent_review_profile_fresh_on_head() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head lower

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" == *"rate limited by coderabbit"* ]] \
    || [[ "${lower}" == *"rate limited by coderabbit.ai"* ]] \
    || [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]] \
    || agent_review_profile_text_is_quota_exhausted "${body}" \
    || agent_review_profile_text_is_coderabbit_billing_block "${body}"; then
    return 1
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    return 0
  fi
  # Intentional: CodeRabbit often embeds the abbreviated SHA. Rate-limit/quota stubs
  # are rejected above before we reach SHA matching.
  short_head="${head:0:7}"
  if [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_latest_review_body_on_head <snapshot> <head> <repo> <pr>
agent_review_profile_latest_review_body_on_head() {
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    printf '\n'
    return 0
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  short_head="${head:0:7}"
  if [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  printf '\n'
}

# agent_review_coderabbit_full_review_marker <head_sha>
agent_review_coderabbit_full_review_marker() {
  local -r head="$1"

  printf 'wait-for-agent-review:coderabbit-full:%s' "${head}"
}

# agent_review_coderabbit_full_review_comment_body <head_sha>
agent_review_coderabbit_full_review_comment_body() {
  local -r head="$1"
  local marker

  marker="$(agent_review_coderabbit_full_review_marker "${head}")"
  printf '@coderabbitai full review\n\n<!-- %s -->' "${marker}"
}

# True when a last-resort full-review ask is already on this PR for <head>.
# Exit 0 = marker present, 1 = marker absent, 2 = comment lookup failed (caller must not
# treat as absent or it may re-post and break one-shot-per-head).
agent_review_coderabbit_full_review_already_sent() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local marker comments_json

  marker="$(agent_review_coderabbit_full_review_marker "${head}")"
  if ! comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"; then
    return 2
  fi
  # shellcheck disable=SC2016  # jq filter uses $marker
  ar_runner_jq_file "coderabbit full-review marker" "${comments_json}" -res \
    --arg marker "${marker}" \
    '[ .[] | .[] | .body // "" | select(contains($marker)) ] | length > 0' \
    >/dev/null 2>&1
}

# agent_review_profile_request <repo> <pr>
# Hard no-op for ordinary request: CodeRabbit is on_push (issue #347). Never post
# an ordinary review prompt. Last-resort full review is a separate gated helper.
agent_review_profile_request() {
  local -r pr="${2:-}"

  printf 'wait-for-agent-review: coderabbit is on_push — refusing ordinary review-request nudge (PR #%s; push or wait)\n' \
    "${pr}" >&2
  return 0
}

# agent_review_profile_request_last_resort_full_review <repo> <pr> <head>
# Posts "@coderabbitai full review" once per head after cooldown + grace (loop-gated).
agent_review_profile_request_last_resort_full_review() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local body sent_rc=0

  if [[ -z "${head}" ]]; then
    return 1
  fi
  agent_review_coderabbit_full_review_already_sent "${repo}" "${pr}" "${head}" || sent_rc=$?
  if (( sent_rc == 0 )); then
    printf 'wait-for-agent-review: coderabbit full review already requested for head %s on PR #%s\n' \
      "${head:0:7}" "${pr}" >&2
    return 0
  fi
  if (( sent_rc == 2 )); then
    printf 'wait-for-agent-review: coderabbit full-review marker lookup failed for PR #%s — will retry\n' \
      "${pr}" >&2
    return 2
  fi
  body="$(agent_review_coderabbit_full_review_comment_body "${head}")"
  runner_exec "coderabbit profile last-resort full review" -- gh pr comment "${pr}" --repo "${repo}" --body "${body}"
}
