#!/usr/bin/env bash
# CodeRabbit agent profile for wait-for-agent-review.
# shellcheck disable=SC2034  # profile contract variables are read by scripts/lib/agent-review after source
#
# CodeRabbit reviews run automatically on PR updates in org repos that have it enabled.
# This profile waits for those reviews and triages inline/summary feedback — it does
# not post @coderabbitai review (see agent_review_profile_auto_review).

agent_review_profile_id='coderabbit'
agent_review_profile_auto_review=true
agent_review_profile_request_login_regex='coderabbit|rabbit'
agent_review_profile_thread_login_regex='coderabbit|rabbit'

# agent_review_profile_login_matches <github_login>
agent_review_profile_login_matches() {
  local -r login="${1:-}"

  [[ "${login,,}" == *coderabbit* || "${login,,}" == *rabbit* ]]
}

# agent_review_profile_text_is_quota_exhausted <text>
# True when CodeRabbit issue-comment or review body reports billing or usage limits.
# Normal walkthrough reviews discuss quota-related code — those are not exhaustion.
agent_review_profile_text_is_quota_exhausted() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  if agent_review_profile_review_has_actionable_feedback "${text}"; then
    return 1
  fi
  lower="${text,,}"
  # Rate-limit / review-limit notices often include the summarize marker — check first.
  if [[ "${lower}" =~ usage[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limit"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limited"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"summarize by coderabbit"* ]] \
    || [[ "${lower}" == *"walkthrough_start"* ]] \
    || [[ "${lower}" == *"review_stack_entry"* ]] \
    || [[ "${lower}" == *"review paused"* ]]; then
    return 1
  fi
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted ]]; then
    return 1
  fi
  if [[ "${lower}" =~ review[[:space:]]+completed ]]; then
    return 1
  fi
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|issue) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ subscription[[:space:]]+(limit|expired) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ could[[:space:]]+not[[:space:]]+run ]] \
    && [[ "${lower}" =~ (quota|usage|limit|billing|subscription|rate[[:space:]]+limit) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_text_is_coderabbit_billing_block <text>
# True when text unmistakably reports CodeRabbit billing or usage limits (not walkthrough prose).
agent_review_profile_text_is_coderabbit_billing_block() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  lower="${text,,}"
  if [[ "${lower}" =~ usage[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+limit[[:space:]]+reached ]]; then
    return 0
  fi
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]+of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|issue) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ subscription[[:space:]]+(limit|expired) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ could[[:space:]]+not[[:space:]]+run ]] \
    && [[ "${lower}" =~ (quota|usage|limit|billing|subscription|rate[[:space:]]+limit) ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limit"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  if [[ "${lower}" == *"rate limited"* && "${lower}" == *coderabbit* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_text_quota_retry_after_iso <text> <comment_created_at_iso>
# Prints UTC ISO-8601 when a rate-limited comment says the next review is available.
agent_review_profile_text_quota_retry_after_iso() {
  local -r text="${1:-}"
  local -r comment_created_at="${2:-}"
  local lower minutes hours retry_at

  if [[ -z "${text}" || -z "${comment_created_at}" ]]; then
    return 1
  fi
  lower="${text,,}"
  if [[ "${lower}" =~ next[[:space:]]+review[[:space:]]+available[[:space:]]+in[^0-9]*([0-9]+)[[:space:]]*minutes? ]]; then
    minutes="${BASH_REMATCH[1]}"
    retry_at="$(date -u -d "${comment_created_at} + ${minutes} minutes" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  if [[ "${lower}" =~ next[[:space:]]+review[[:space:]]+available[[:space:]]+in[^0-9]*([0-9]+)[[:space:]]*hours? ]]; then
    hours="${BASH_REMATCH[1]}"
    retry_at="$(date -u -d "${comment_created_at} + ${hours} hours" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  if [[ "${lower}" =~ (resets?[[:space:]]+at|available[[:space:]]+again[[:space:]]+at)[[:space:]]*:*[[:space:]]*([0-9]{4}-[0-9]{2}-[0-9]{2}[^[:space:]<]+) ]]; then
    retry_at="$(date -u -d "${BASH_REMATCH[2]}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "${retry_at}" ]]; then
      printf '%s' "${retry_at}"
      return 0
    fi
  fi
  return 1
}

# agent_review_profile_issue_comment_is_quota_exhausted <login> <body>
agent_review_profile_issue_comment_is_quota_exhausted() {
  local -r login="${1:-}"
  local -r body="${2:-}"

  if ! agent_review_profile_text_is_coderabbit_billing_block "${body}"; then
    return 1
  fi
  if agent_review_profile_login_matches "${login}"; then
    return 0
  fi
  agent_review_profile_text_is_quota_exhausted "${body}"
}

# agent_review_profile_review_is_quota_exhausted <review_body>
agent_review_profile_review_is_quota_exhausted() {
  local -r body="${1:-}"

  agent_review_profile_text_is_coderabbit_billing_block "${body}"
}

# agent_review_profile_review_has_actionable_feedback <review_body>
# True when CodeRabbit posted actionable inline feedback or summary-body findings.
agent_review_profile_review_has_actionable_feedback() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ nitpick[[:space:]]+comments[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ potential[[:space:]]+issue[s]?[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ inline[[:space:]]+comments: ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (must[[:space:]]+fix|blocking[[:space:]]+comment) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_review_has_inline_actionable_feedback <review_body>
# True when CodeRabbit posted inline actionable findings (not nitpick-only summaries).
agent_review_profile_review_has_inline_actionable_feedback() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*[1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ potential[[:space:]]+issue[s]?[[:space:]]*\([1-9] ]]; then
    return 0
  fi
  if [[ "${lower}" =~ inline[[:space:]]+comments: ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (must[[:space:]]+fix|blocking[[:space:]]+comment) ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_head_feedback_needs_operator_triage <snapshot> <head> <repo> <pr>
# True when the latest head review has nitpick/actionable body feedback with no operator reply yet.
agent_review_profile_head_feedback_needs_operator_triage() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local reviews_json body submitted_at

  reviews_json="$(agent_review_agent_reviews_on_head "${snapshot}" "${head}")"
  body="$(ar_runner_jq_file "coderabbit profile latest head review body" "${reviews_json}" -r \
    '[.[] | select((.body // "") | length > 0)]
    | if length > 0 then (sort_by(.submittedAt) | last | .body // "") else "" end')"
  if [[ -z "${body}" ]] || agent_review_profile_review_is_empty "${body}"; then
    return 1
  fi
  submitted_at="$(ar_runner_jq_file "coderabbit profile latest head review time" "${reviews_json}" -r \
    '[.[] | select((.body // "") | length > 0)]
    | if length > 0 then (sort_by(.submittedAt) | last | .submittedAt // "") else "" end')"
  if [[ -n "${submitted_at}" ]] \
    && agent_review_pr_has_operator_issue_comment_after "${repo}" "${pr}" "${submitted_at}"; then
    return 1
  fi
  return 0
}

# agent_review_profile_review_is_empty <review_body>
# True when CodeRabbit's latest head review reports no actionable feedback.
agent_review_profile_review_is_empty() {
  local -r body="${1:-}"
  local lower

  if [[ -z "${body}" ]]; then
    return 1
  fi
  if agent_review_profile_review_has_actionable_feedback "${body}"; then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ actionable[[:space:]]+comments[[:space:]]+posted:[[:space:]]*0 ]]; then
    return 0
  fi
  if [[ "${lower}" == *"no actionable comments were generated"* ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no[[:space:]]+issues[[:space:]]+found|all[[:space:]]+clear|looks[[:space:]]+good|lgtm) ]]; then
    return 0
  fi
  if [[ "${lower}" == *"review completed"* ]] \
    && [[ "${lower}" != *nitpick* ]] \
    && [[ "${lower}" != *actionable* ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_fresh_on_head <snapshot> <head> <repo> <pr>
# CodeRabbit posts walkthrough summaries as issue comments, not GraphQL reviews.
agent_review_profile_fresh_on_head() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    return 1
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    return 0
  fi
  short_head="${head:0:7}"
  [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]
}

# agent_review_profile_latest_review_body_on_head <snapshot> <head> <repo> <pr>
agent_review_profile_latest_review_body_on_head() {
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    printf '\n'
    return 0
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  short_head="${head:0:7}"
  if [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  printf '\n'
}

# agent_review_profile_request <repo> <pr>
# Not used for routine probes — cmd_request skips when agent_review_profile_auto_review is true.
# agent_review_profile_post_rate_limit_retry <repo> <pr> <head>
# Posts @coderabbitai review after a temporary rate-limit window (CodeRabbit docs).
agent_review_coderabbit_rate_limit_retry_marker() {
  local -r head="${1:-}"

  printf 'wait-for-agent-review:coderabbit-rate-limit-retry:%s' "${head:0:7}"
}

agent_review_coderabbit_rate_limit_retry_sent_for_head() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local marker comments_json exit_code

  [[ -n "${head}" ]] || return 1
  marker="$(agent_review_coderabbit_rate_limit_retry_marker "${head}")"
  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  exit_code=0
  # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
  ar_runner_jq_file "coderabbit rate limit retry marker" "${comments_json}" -res \
    --arg marker "${marker}" \
    '[ .[] | .[] | .body // "" | select(contains($marker)) ] | length > 0' \
    >/dev/null || exit_code=$?
  (( exit_code == 0 ))
}

agent_review_profile_post_rate_limit_retry() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local marker body

  if agent_review_coderabbit_rate_limit_retry_sent_for_head "${repo}" "${pr}" "${head}"; then
    printf 'wait-for-agent-review: CodeRabbit rate-limit retry already posted for head %s on PR #%s\n' \
      "${head:0:7}" "${pr}" >&2
    return 0
  fi
  marker="$(agent_review_coderabbit_rate_limit_retry_marker "${head}")"
  body="@coderabbitai review

<!-- ${marker} -->"
  if ! runner_exec "coderabbit profile rate-limit retry comment" -- gh pr comment "${pr}" --repo "${repo}" --body "${body}"; then
    return 1
  fi
  printf 'wait-for-agent-review: posted CodeRabbit rate-limit retry on PR #%s (head %s)\n' \
    "${pr}" "${head:0:7}" >&2
}

agent_review_profile_request() {
  local -r repo="$1"
  local -r pr="$2"

  printf 'wait-for-agent-review: coderabbit profile_request called but CodeRabbit is auto-review only (PR #%s)\n' \
    "${pr}" >&2
  return 1
}
