#!/usr/bin/env bash
# Copilot agent profile for wait-for-agent-review.
# shellcheck disable=SC2034  # profile contract variables are read by scripts/lib/agent-review after source
# shellcheck disable=SC2016  # jq filter strings use single-quoted $variables, not shell expansion

agent_review_profile_id='copilot'
agent_review_profile_request_login_regex='copilot'
agent_review_profile_thread_login_regex='copilot'
# nudge | on_push — Copilot needs an explicit @copilot PR comment (issue #347).
agent_review_profile_trigger='nudge'
# Copilot is triggered by mentioning @copilot in a PR comment (not --add-reviewer).
agent_review_profile_request_visible='true'

if [[ -z "${_copilot_lib_dir:-}" ]]; then
  _copilot_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  readonly _copilot_lib_dir
fi
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_copilot_lib_dir}/../runner-ensure"

# _copilot_runner_jq_file <label> <input-json> [jq-args…]
_copilot_runner_jq_file() {
  local -r label="$1"
  local -r input_json="$2"
  shift 2
  local tmp exit_code

  tmp="$(mktemp "${TMPDIR:-/tmp}/copilot-jq.XXXXXX")"
  printf '%s' "${input_json}" >"${tmp}"
  exit_code=0
  runner_exec "copilot profile ${label}" --stream-stdout -- jq "$@" "${tmp}" || exit_code=$?
  rm -f "${tmp}"
  return "${exit_code}"
}

# _copilot_jq <label> <json> [jq args…]
_copilot_jq() {
  local -r label="$1"
  local -r json="$2"
  shift 2

  if declare -F ar_runner_jq_file >/dev/null 2>&1; then
    ar_runner_jq_file "copilot profile ${label}" "${json}" "$@"
  else
    _copilot_runner_jq_file "${label}" "${json}" "$@"
  fi
}

# agent_review_profile_login_matches <github_login>
agent_review_profile_login_matches() {
  local -r login="${1:-}"

  [[ "${login,,}" == *copilot* ]]
}

# agent_review_profile_text_is_quota_exhausted <text>
# True when stderr/review body indicates Copilot review quota or billing limits.
agent_review_profile_text_is_quota_exhausted() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  lower="${text,,}"
  if [[ "${lower}" =~ quota[_\ -]?exceeded ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]of)[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ review[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ quota[[:space:]]+limit ]]; then
    return 0
  fi
  if [[ "${lower}" =~ reached[[:space:]]+(their[[:space:]]+)?quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (no|out[[:space:]]of)[[:space:]]+premium[[:space:]]+requests? ]]; then
    return 0
  fi
  if [[ "${lower}" =~ premium[[:space:]]+requests?[[:space:]]+(exhausted|exceeded|limit) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ used[[:space:]]+all[[:space:]]+(of[[:space:]]+)?(your[[:space:]]+)?premium[[:space:]]+requests? ]]; then
    return 0
  fi
  if [[ "${lower}" =~ budget[[:space:]]+limit ]]; then
    return 0
  fi
  if [[ "${lower}" =~ billing[[:space:]]+(limit|quota|budget) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ you[[:space:]]+have[[:space:]]+no[[:space:]]+quota ]]; then
    return 0
  fi
  if [[ "${lower}" =~ \"code\"[[:space:]]*:[[:space:]]*\"quota_exceeded\" ]]; then
    return 0
  fi
  if [[ "${lower}" =~ run[[:space:]]+out[[:space:]]+of[[:space:]]+your[[:space:]]+included[[:space:]]+ai[[:space:]]+credits ]]; then
    return 0
  fi
  if [[ "${lower}" =~ included[[:space:]]+ai[[:space:]]+credits[[:space:]]+for[[:space:]]+the[[:space:]]+month ]]; then
    return 0
  fi
  if [[ "${lower}" =~ monthly[[:space:]]+credit[[:space:]]+limit ]]; then
    return 0
  fi
  if [[ "${lower}" =~ copilot[[:space:]]+stopped[[:space:]]+work ]]; then
    return 0
  fi
  if [[ "${lower}" =~ manage[[:space:]]+your[[:space:]]+ai[[:space:]]+credit[[:space:]]+budget ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_text_is_copilot_billing_block <text>
# True when quota exhaustion text is unmistakably from Copilot billing (not generic agent limits).
agent_review_profile_text_is_copilot_billing_block() {
  local -r text="${1:-}"
  local lower

  if [[ -z "${text}" ]]; then
    return 1
  fi
  lower="${text,,}"
  if [[ "${lower}" =~ run[[:space:]]+out[[:space:]]+of[[:space:]]+your[[:space:]]+included[[:space:]]+ai[[:space:]]+credits ]]; then
    return 0
  fi
  if [[ "${lower}" =~ copilot[[:space:]]+stopped[[:space:]]+work ]]; then
    return 0
  fi
  if [[ "${lower}" =~ included[[:space:]]+ai[[:space:]]+credits[[:space:]]+for[[:space:]]+the[[:space:]]+month ]]; then
    return 0
  fi
  if [[ "${lower}" =~ manage[[:space:]]+your[[:space:]]+ai[[:space:]]+credit[[:space:]]+budget ]]; then
    return 0
  fi
  if [[ "${lower}" =~ session[[:space:]]+could[[:space:]]+not[[:space:]]+start.*included[[:space:]]+ai[[:space:]]+credits ]]; then
    return 0
  fi
  return 1
}

# agent_review_profile_issue_comment_is_quota_exhausted <login> <body>
# GitHub may post Copilot billing failures without a copilot* login on the comment author.
agent_review_profile_issue_comment_is_quota_exhausted() {
  local -r login="${1:-}"
  local -r body="${2:-}"

  if ! agent_review_profile_text_is_quota_exhausted "${body}"; then
    return 1
  fi
  if agent_review_profile_login_matches "${login}"; then
    return 0
  fi
  agent_review_profile_text_is_copilot_billing_block "${body}"
}

# agent_review_profile_review_is_quota_exhausted <review_body>
agent_review_profile_review_is_quota_exhausted() {
  local -r body="${1:-}"

  agent_review_profile_text_is_quota_exhausted "${body}"
}

# agent_review_profile_review_is_empty <review_body>
# True when Copilot posted a pass with no new inline comments.
agent_review_profile_review_is_empty() {
  local -r body="${1:-}"
  local lower

  if [[ "${body}" =~ [Gg]enerated[[:space:]]+no[[:space:]]+new[[:space:]]+comments ]]; then
    return 0
  fi
  lower="${body,,}"
  if [[ "${lower}" == *"didn't find any issues"* ]] \
    || [[ "${lower}" == *"did not find any issues"* ]] \
    || [[ "${lower}" == *"no issues that require changes"* ]] \
    || [[ "${lower}" == *"don't see any additional changes needed"* ]] \
    || [[ "${lower}" == *"do not see any additional changes needed"* ]] \
    || [[ "${lower}" == *"no additional changes needed"* ]] \
    || [[ "${lower}" == *"no new issues found"* ]] \
    || [[ "${lower}" == *"no issues found"* ]] \
    || [[ "${lower}" == *"observations (neither blocking)"* ]] \
    || [[ "${lower}" =~ reviewed[[:space:]]+the[[:space:]]+current[[:space:]]+diff.*(didn.t|did[[:space:]]+not)[[:space:]]+find ]]; then
    return 0
  fi
  return 1
}

# agent_review_copilot_review_requests_pending_in_snapshot <snapshot>
# True when GitHub still shows a pending Copilot review request on the PR.
agent_review_copilot_review_requests_pending_in_snapshot() {
  local -r snapshot="$1"
  local exit_code

  exit_code=0
  # shellcheck disable=SC2016  # jq filter uses $re variable, not shell expansion
  ar_runner_jq_file "copilot profile review requests pending" "${snapshot}" -e \
    --arg re "${agent_review_profile_request_login_regex}" \
    '[.data.repository.pullRequest.reviewRequests.nodes[]
      | .requestedReviewer | (.login // .slug // "")
      | select(test($re;"i"))] | length > 0' >/dev/null || exit_code=$?
  (( exit_code == 0 ))
}

# agent_review_copilot_review_delivered_on_head <snapshot> <head> <repo> <pr>
# True when Copilot posted a formal review or substantive issue-comment reply for this head.
agent_review_copilot_review_delivered_on_head() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local comments_json body

  if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
    return 0
  fi
  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  body="$(agent_review_copilot_success_issue_comment_for_head "${comments_json}" "${head}")"
  [[ -n "${body}" ]]
}

# agent_review_profile_review_outstanding <snapshot> <head> <repo> <pr>
# True while a Copilot review was requested but has not finished on the current head.
agent_review_profile_review_outstanding() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local comments_json

  if agent_review_copilot_review_requests_pending_in_snapshot "${snapshot}"; then
    return 0
  fi
  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  if agent_review_copilot_probe_comment_sent_for_head "${comments_json}" "${head}" \
    && ! agent_review_copilot_review_delivered_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    return 0
  fi
  return 1
}

# agent_review_profile_review_complete_on_head <snapshot> <head> <repo> <pr>
agent_review_profile_review_complete_on_head() {
  local -r snapshot="$1"
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"

  if agent_review_profile_review_outstanding "${snapshot}" "${head}" "${repo}" "${pr}"; then
    return 1
  fi
  agent_review_copilot_review_delivered_on_head "${snapshot}" "${head}" "${repo}" "${pr}"
}

# agent_review_profile_fresh_on_head <snapshot> <head> <repo> <pr>
# Copilot review is fresh only when the requested review has actually completed.
agent_review_profile_fresh_on_head() {
  agent_review_profile_review_complete_on_head "${1}" "${2}" "${3}" "${4}"
}

# agent_review_profile_latest_review_body_on_head <snapshot> <head> <repo> <pr>
agent_review_profile_latest_review_body_on_head() {
  local -r head="$2"
  local -r repo="$3"
  local -r pr="$4"
  local body short_head comments_json

  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  body="$(agent_review_copilot_success_issue_comment_for_head "${comments_json}" "${head}")"
  if [[ -n "${body}" ]]; then
    printf '%s' "${body}"
    return 0
  fi

  body="$(agent_review_latest_issue_comment_body_for_profile "${repo}" "${pr}")"
  if [[ -z "${body}" ]]; then
    printf '\n'
    return 0
  fi
  if agent_review_copilot_issue_comment_is_probe "${body}"; then
    printf '\n'
    return 0
  fi
  if [[ "${body}" == *"${head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  short_head="${head:0:7}"
  if [[ -n "${short_head}" ]] && [[ "${body}" == *"${short_head}"* ]]; then
    printf '%s' "${body}"
    return 0
  fi
  printf '\n'
}

# agent_review_copilot_issue_comment_is_probe <body>
# Case-insensitive probe/request detection for Copilot issue comments.
agent_review_copilot_issue_comment_is_probe() {
  local -r body="${1:-}"
  local lower

  [[ -n "${body}" ]] || return 0
  lower="${body,,}"
  if [[ "${lower}" == *'wait-for-agent-review:copilot:'* ]] \
    && [[ "${lower}" =~ @copilot[[:space:]]+please[[:space:]]+review ]]; then
    return 0
  fi
  return 1
}

# agent_review_copilot_request_marker <head_oid>
agent_review_copilot_request_marker() {
  local -r head="${1:-}"

  printf 'wait-for-agent-review:copilot:%s' "${head:0:7}"
}

# agent_review_copilot_pr_head <repo> <pr>
agent_review_copilot_pr_head() {
  local -r repo="$1"
  local -r pr="$2"

  runner_exec_stdout "copilot profile pr head" -- gh pr view "${pr}" --repo "${repo}" --json headRefOid -q .headRefOid
}

# agent_review_copilot_request_comment_body <head_oid>
agent_review_copilot_request_comment_body() {
  local -r head="$1"
  local marker

  marker="$(agent_review_copilot_request_marker "${head}")"
  printf '@copilot please review this pull request.\n\n<!-- %s -->' "${marker}"
}

# agent_review_copilot_comments_contain_marker <comments_json> <marker> [paginated]
# When paginated is "true", comments_json is gh api --paginate output (slurp pages).
agent_review_copilot_comments_contain_marker() {
  local -r comments_json="$1"
  local -r marker="$2"
  local -r paginated="${3:-false}"
  local exit_code tmp_comments

  [[ -n "${comments_json}" && -n "${marker}" ]] || return 1
  exit_code=0
  if declare -F ar_runner_jq_file >/dev/null 2>&1; then
    if [[ "${paginated}" == 'true' ]]; then
      # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
      ar_runner_jq_file "copilot profile comment marker jq" "${comments_json}" -res \
        --arg marker "${marker}" \
        '[ .[] | .[] | .body // "" | select(contains($marker)) ] | length > 0' \
        >/dev/null || exit_code=$?
      if (( exit_code == 0 )); then
        return 0
      fi
      exit_code=0
      # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
      ar_runner_jq_file "copilot profile comment marker jq flat" "${comments_json}" -re \
        --arg marker "${marker}" \
        '[ .[] | .body // "" | select(contains($marker)) ] | length > 0' \
        >/dev/null || exit_code=$?
    else
      # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
      ar_runner_jq_file "copilot profile comment marker jq" "${comments_json}" -re \
        --arg marker "${marker}" \
        '[ .[] | .body // "" | select(contains($marker)) ] | length > 0' \
        >/dev/null || exit_code=$?
    fi
    (( exit_code == 0 ))
    return $?
  fi
  tmp_comments="$(mktemp "${TMPDIR:-/tmp}/copilot-comments.XXXXXX")"
  printf '%s' "${comments_json}" >"${tmp_comments}"
  if [[ "${paginated}" == 'true' ]]; then
    # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
    _copilot_runner_jq_file "comment marker jq" "${comments_json}" -res --arg marker "${marker}" \
      '[ .[] | .[] | .body // "" | select(contains($marker)) ] | length > 0' \
      >/dev/null || exit_code=$?
    if (( exit_code == 0 )); then
      rm -f "${tmp_comments}"
      return 0
    fi
    exit_code=0
    # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
    _copilot_runner_jq_file "comment marker jq flat" "${comments_json}" -re --arg marker "${marker}" \
      '[ .[] | .body // "" | select(contains($marker)) ] | length > 0' \
      >/dev/null || exit_code=$?
  else
    # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
    _copilot_runner_jq_file "comment marker jq" "${comments_json}" -re --arg marker "${marker}" \
      '[ .[] | .body // "" | select(contains($marker)) ] | length > 0' \
      >/dev/null || exit_code=$?
  fi
  rm -f "${tmp_comments}"
  (( exit_code == 0 ))
}

# agent_review_copilot_probe_comment_sent_for_head <comments_json> <head_oid>
# True when wait-for-agent-review already posted an @copilot probe comment for this head.
agent_review_copilot_probe_comment_sent_for_head() {
  local -r comments_json="$1"
  local -r head="$2"
  local marker

  [[ -n "${comments_json}" && -n "${head}" ]] || return 1
  marker="$(agent_review_copilot_request_marker "${head}")"
  agent_review_copilot_comments_contain_marker "${comments_json}" "${marker}" false
}

# agent_review_copilot_issue_comment_is_ack_only <body>
# True for session-start / "I'll review" acknowledgments that are not a finished review.
agent_review_copilot_issue_comment_is_ack_only() {
  local -r body="${1:-}"
  local lower
  # Long bodies that open with an ack phrase are still real reviews (CodeRabbit on #357).
  local -r max_ack_len=200

  [[ -n "${body}" ]] || return 1
  if (( ${#body} > max_ack_len )); then
    return 1
  fi
  lower="${body,,}"
  if [[ "${lower}" =~ i(\'ll| will)[[:space:]]+(take[[:space:]]+a[[:space:]]+look|review) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (starting|started)[[:space:]]+(a[[:space:]]+)?(review|session) ]]; then
    return 0
  fi
  if [[ "${lower}" =~ looking[[:space:]]+(into|at)[[:space:]]+(this|the)[[:space:]]+pr ]]; then
    return 0
  fi
  if [[ "${lower}" =~ (on[[:space:]]+it|got[[:space:]]+it)[[:space:]]*\.?[[:space:]]*$ ]]; then
    return 0
  fi
  if [[ "${lower}" =~ session[[:space:]]+could[[:space:]]+not[[:space:]]+start ]]; then
    return 0
  fi
  return 1
}

# agent_review_copilot_success_issue_comment_for_head <comments_json> <head_oid>
# Prints a successful Copilot issue-comment reply after the wait-for-agent-review probe.
agent_review_copilot_success_issue_comment_for_head() {
  local -r comments_json="$1"
  local -r head="$2"
  local marker probe_at created_at login body min_len

  [[ -n "${comments_json}" && -n "${head}" ]] || return 1
  marker="$(agent_review_copilot_request_marker "${head}")"
  min_len=$(( ${#marker} + 40 ))
  if declare -F ar_runner_jq_file >/dev/null 2>&1; then
    # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
    probe_at="$(ar_runner_jq_file "copilot profile probe comment time" "${comments_json}" -rs \
      --arg marker "${marker}" \
      '[ .[] | .[] | select((.body // "") | contains($marker)) ]
      | sort_by(.created_at) | last | .created_at // ""')"
  else
    return 1
  fi
  [[ -n "${probe_at}" ]] || return 1
  while IFS=$'\t' read -r created_at login body; do
    [[ -n "${created_at}" ]] || continue
    if [[ "${created_at}" < "${probe_at}" ]]; then
      continue
    fi
    if ! agent_review_profile_login_matches "${login}"; then
      continue
    fi
    if agent_review_profile_text_is_quota_exhausted "${body}"; then
      continue
    fi
    if agent_review_copilot_issue_comment_is_ack_only "${body}"; then
      continue
    fi
    if [[ "${#body}" -lt "${min_len}" ]] && [[ "${body}" == *"${marker}"* ]]; then
      continue
    fi
    printf '%s' "${body}"
    return 0
  done < <(
    # shellcheck disable=SC2016  # jq filter uses $re variable, not shell expansion
    ar_runner_jq_file "copilot profile success comment scan" "${comments_json}" -rs \
      --arg re "${agent_review_profile_request_login_regex}" \
      '[ .[] | .[] | select((.user.login // "") | test($re;"i")) ]
      | sort_by(.created_at) | .[] | [.created_at, (.user.login // ""), (.body // "")] | @tsv')
  return 1
}

# agent_review_copilot_success_issue_comment_url_for_head <comments_json> <head_oid>
agent_review_copilot_success_issue_comment_url_for_head() {
  local -r comments_json="$1"
  local -r head="$2"
  local marker probe_at created_at login body min_len comment_url

  [[ -n "${comments_json}" && -n "${head}" ]] || return 1
  marker="$(agent_review_copilot_request_marker "${head}")"
  min_len=$(( ${#marker} + 40 ))
  if declare -F ar_runner_jq_file >/dev/null 2>&1; then
    # shellcheck disable=SC2016  # jq filter uses $marker variable, not shell expansion
    probe_at="$(ar_runner_jq_file "copilot profile probe comment time" "${comments_json}" -rs \
      --arg marker "${marker}" \
      '[ .[] | .[] | select((.body // "") | contains($marker)) ]
      | sort_by(.created_at) | last | .created_at // ""')"
  else
    return 1
  fi
  [[ -n "${probe_at}" ]] || return 1
  while IFS=$'\t' read -r created_at login body comment_url; do
    [[ -n "${created_at}" ]] || continue
    if [[ "${created_at}" < "${probe_at}" ]]; then
      continue
    fi
    if ! agent_review_profile_login_matches "${login}"; then
      continue
    fi
    if agent_review_profile_text_is_quota_exhausted "${body}"; then
      continue
    fi
    if agent_review_copilot_issue_comment_is_ack_only "${body}"; then
      continue
    fi
    if [[ "${#body}" -lt "${min_len}" ]] && [[ "${body}" == *"${marker}"* ]]; then
      continue
    fi
    printf '%s' "${comment_url}"
    return 0
  done < <(
    # shellcheck disable=SC2016  # jq filter uses $re variable, not shell expansion
    ar_runner_jq_file "copilot profile success comment url scan" "${comments_json}" -rs \
      --arg re "${agent_review_profile_request_login_regex}" \
      '[ .[] | .[] | select((.user.login // "") | test($re;"i")) ]
      | sort_by(.created_at) | .[] | [.created_at, (.user.login // ""), (.body // ""), (.html_url // "")] | @tsv')
  return 1
}

# agent_review_profile_request_already_sent <repo> <pr>
# True when this head already has an @copilot probe comment from wait-for-agent-review.
agent_review_profile_request_already_sent() {
  local -r repo="$1"
  local -r pr="$2"
  local head marker comments_json

  head="$(agent_review_copilot_pr_head "${repo}" "${pr}")"
  [[ -n "${head}" ]] || return 1
  marker="$(agent_review_copilot_request_marker "${head}")"
  comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
  agent_review_copilot_comments_contain_marker "${comments_json}" "${marker}" true
}

# agent_review_profile_agent_requested_from_snapshot <snapshot>
agent_review_profile_agent_requested_from_snapshot() {
  local -r snapshot="$1"
  local head marker comments_json tmp_snapshot exit_code

  if agent_review_copilot_review_requests_pending_in_snapshot "${snapshot}"; then
    return 0
  fi
  tmp_snapshot="$(mktemp "${TMPDIR:-/tmp}/copilot-snapshot.XXXXXX")"
  printf '%s' "${snapshot}" >"${tmp_snapshot}"
  exit_code=0
  head="$(runner_exec_stdout "copilot profile snapshot head" -- jq -r '.data.repository.pullRequest.headRefOid // ""' "${tmp_snapshot}")" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "${head}" ]]; then
    rm -f "${tmp_snapshot}"
    return 1
  fi
  marker="$(agent_review_copilot_request_marker "${head}")"
  comments_json="$(runner_exec_stdout "copilot profile snapshot comments" -- jq -c '.data.repository.pullRequest.comments.nodes // []' "${tmp_snapshot}")" || comments_json=''
  rm -f "${tmp_snapshot}"
  if [[ -z "${comments_json}" || "${comments_json}" == 'null' || "${comments_json}" == '[]' ]]; then
    return 1
  fi
  agent_review_copilot_comments_contain_marker "${comments_json}" "${marker}" false
}

# agent_review_profile_request <repo> <pr>
# Exit 7 when Copilot review quota/billing blocks the request.
agent_review_profile_request() {
  local -r repo="$1"
  local -r pr="$2"
  local head body err_file err_text request_exit

  if agent_review_profile_request_already_sent "${repo}" "${pr}"; then
    return 0
  fi
  head="$(agent_review_copilot_pr_head "${repo}" "${pr}")"
  body="$(agent_review_copilot_request_comment_body "${head}")"
  err_file="$(mktemp "${TMPDIR:-/tmp}/agent-review-request.XXXXXX")"
  request_exit=0
  if runner_exec "copilot profile request comment" -- gh pr comment "${pr}" --repo "${repo}" --body "${body}" 2>"${err_file}"; then
    rm -f "${err_file}"
    return 0
  fi
  request_exit=$?
  err_text="$(<"${err_file}")"
  if agent_review_profile_text_is_quota_exhausted "${err_text}"; then
    printf '%s\n' "${err_text}" >&2
    rm -f "${err_file}"
    return 7
  fi
  printf '%s\n' "${err_text}" >&2
  rm -f "${err_file}"
  return "${request_exit}"
}
