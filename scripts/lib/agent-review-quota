  agent_review_bugbot_quota_refresh_for_today
  if [[ "${agent_review_bugbot_quota_exhausted_today:-0}" == '1' ]]; then
    printf 'Bugbot usage limit reached (cached for %s; source=%s)\n' \
      "$(agent_review_copilot_quota_local_day)" "${agent_review_bugbot_quota_cache_source:-cache}" >&2
    if [[ -n "${agent_review_bugbot_quota_cache_reason:-}" ]]; then
      printf '  %s\n' "${agent_review_bugbot_quota_cache_reason}" >&2
    fi
    return 0
  fi
  return 1
