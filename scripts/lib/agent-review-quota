agent_review_bugbot_quota_probe_open_prs() {
  agent_review_bugbot_quota_probe_recent_signals
}

agent_review_bugbot_quota_refresh_for_today() {
  if agent_review_bugbot_quota_read_cache; then
    return 0
  fi
  agent_review_bugbot_quota_probe_recent_signals || true
