agent_review_agent_quota_mark_exhausted() {
  local -r reason="${1:-Agent review quota exhausted.}"

  case "${AGENT_REVIEW_AGENT:-copilot}" in
    copilot) agent_review_copilot_quota_mark_exhausted "${reason}" ;;
    bugbot) agent_review_bugbot_quota_mark_exhausted "${reason}" ;;
    coderabbit) agent_review_coderabbit_quota_mark_exhausted "${reason}" ;;
  esac
}

agent_review_agent_quota_skip_request() {
  case "${AGENT_REVIEW_AGENT:-copilot}" in
    copilot) agent_review_copilot_quota_skip_request ;;
    bugbot) agent_review_bugbot_quota_skip_request ;;
    *) return 1 ;;
  esac
}

