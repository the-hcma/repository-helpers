        | . as $pr
        | .comments.nodes[]
        | select((.author.login // "") | test("coderabbit|rabbit";"i"))
        | select((.body // "") | length > 0)
        | {repo: $pr.repository.nameWithOwner, pr: ($pr.number | tostring), body: .body, at: .createdAt}
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body]
      | @tsv'
  )
  if [[ "${found_today}" == '1' ]]; then
    agent_review_coderabbit_quota_mark_available
    return 1
  fi
  agent_review_coderabbit_quota_write_cache 0 probe 'No CodeRabbit comments found for today on open PRs.'
  return 1
}

agent_review_coderabbit_quota_refresh_for_today() {
  if agent_review_coderabbit_quota_read_cache; then
    return 0
  fi
  agent_review_coderabbit_quota_probe_recent_comments || true
}

# Ordered agent ids reported at the start of each review cycle.
agent_review_cycle_quota_agent_ids() {
  printf '%s\n' copilot bugbot coderabbit
}

# Human-readable quota status for one agent (no side effects beyond cache refresh).
agent_review_agent_quota_status_label() {
  local -r agent_id="$1"

  if agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    printf 'exhausted (will not request)\n'
    return 0
  fi
  if [[ "${agent_id}" == 'coderabbit' ]]; then
    printf 'available (auto-review; no manual request)\n'
    return 0
  fi
  printf 'available\n'
}

# Log Copilot, Bugbot, and CodeRabbit quota status once at loop start / cycle preamble.
agent_review_log_cycle_quota_preamble() {
  local agent status

  printf '==> Agent review quota (local day %s):\n' \
    "$(agent_review_copilot_quota_local_day)" >&2
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    status="$(agent_review_agent_quota_status_label "${agent}")"
    printf '    %s: %s' "${agent}" "${status}" >&2
  done < <(agent_review_cycle_quota_agent_ids)
}

# True when <agent_id> daily quota cache reports exhaustion (no log output).
agent_review_agent_quota_exhausted_for_agent() {
  local -r agent_id="$1"

  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      [[ "${agent_review_copilot_quota_exhausted_today:-0}" == '1' ]]
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      [[ "${agent_review_bugbot_quota_exhausted_today:-0}" == '1' ]]
      ;;
    coderabbit)
      agent_review_coderabbit_quota_refresh_for_today
      [[ "${agent_review_coderabbit_quota_exhausted_today:-0}" == '1' ]]
      ;;
    *) return 1 ;;
  esac
}

# True when Copilot, Bugbot, and CodeRabbit daily quota caches all report exhaustion.
agent_review_all_quotas_exhausted() {
  agent_review_copilot_quota_refresh_for_today
  agent_review_bugbot_quota_refresh_for_today
  agent_review_coderabbit_quota_refresh_for_today
  [[ "${agent_review_copilot_quota_exhausted_today:-0}" == '1' \
    && "${agent_review_bugbot_quota_exhausted_today:-0}" == '1' \
    && "${agent_review_coderabbit_quota_exhausted_today:-0}" == '1' ]]
}
