#!/usr/bin/env bash
# agent-review-quota — daily agent review quota caches and programmatic probes.
#
# GitHub does not expose per-user Copilot or Bugbot quota APIs. We cache exhaustion
# and confirmed availability for the local calendar day under ~/scratch/repository-helpers.
#
# Those *.env files are the SSOT breadcrumbs for other coding agents on this host
# (same developer GitHub identity / same $HOME). Do not post quota exhaustion onto
# PRs — leave and read filesystem state only:
#   ~/scratch/repository-helpers/copilot-review-quota.env
#   ~/scratch/repository-helpers/bugbot-review-quota.env
#   ~/scratch/repository-helpers/coderabbit-review-quota.env
# Fields: valid_date, exhausted, confirmed, probe_requested, probe_requested_at,
# probe_attempted, timeline_probed_slug, source, reason, evidence_url.
# Passive scans may record exhaustion from prior signals; availability is confirmed only
# after a successful review or GitHub check on the PR under review (not from stale probes).
#
# probe_requested_at — unix epoch when probe_requested was set. After
# AGENT_REVIEW_PROBE_REQUESTED_TTL (default 15m) with no review, expire the wait
# (source=probe_expired), re-scan the current PR timeline, and allow quota fallback
# without hanging forever (repository-helpers#408).
# timeline_probed_slug — OWNER/NAME#N of the PR whose timeline was negatively probed;
# a blank/other slug must not skip scanning a different PR.
# shellcheck disable=SC2016  # GraphQL and jq filter strings use single quotes

# Default TTL for an outstanding probe_requested wait (seconds). Overridden by
# AGENT_REVIEW_PROBE_REQUESTED_TTL via agent_review_load_env.
agent_review_default_probe_requested_ttl_s=900

agent_review_probe_requested_ttl_s() {
  printf '%s\n' "${agent_review_default_probe_requested_ttl_s:-900}"
}

agent_review_copilot_quota_state_file() {
  printf '%s\n' \
    "${AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE:-${HOME}/scratch/repository-helpers/copilot-review-quota.env}"
}

agent_review_copilot_quota_local_day() {
  date +%Y-%m-%d
}

# True when a UTC ISO-8601 timestamp falls on the given local calendar day (YYYY-MM-DD).
agent_review_quota_timestamp_on_local_day() {
  local -r iso_ts="$1"
  local -r local_day="$2"
  local ts_day

  [[ -n "${iso_ts}" && -n "${local_day}" ]] || return 1
  ts_day="$(date -d "${iso_ts}" +%Y-%m-%d 2>/dev/null)" || return 1
  [[ "${ts_day}" == "${local_day}" ]]
}

agent_review_quota_quote_env_value() {
  local -r value="$1"

  printf '%q' "${value}"
}

# Read valid_date and exhausted from a scratch cache without sourcing (avoids clobbering callers).
agent_review_quota_cache_read_fields() {
  local -r state_file="$1"
  local line

  agent_review_quota_cache_valid_date=''
  agent_review_quota_cache_exhausted=''
  agent_review_quota_cache_confirmed=''
  agent_review_quota_cache_probe_requested=''
  agent_review_quota_cache_probe_requested_at=''
  agent_review_quota_cache_probe_attempted=''
  agent_review_quota_cache_timeline_probed_slug=''
  [[ -f "${state_file}" ]] || return 1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "${line}" in
      valid_date=*) agent_review_quota_cache_valid_date="${line#valid_date=}" ;;
      exhausted=*) agent_review_quota_cache_exhausted="${line#exhausted=}" ;;
      confirmed=*) agent_review_quota_cache_confirmed="${line#confirmed=}" ;;
      probe_requested=*) agent_review_quota_cache_probe_requested="${line#probe_requested=}" ;;
      probe_requested_at=*) agent_review_quota_cache_probe_requested_at="${line#probe_requested_at=}" ;;
      probe_attempted=*) agent_review_quota_cache_probe_attempted="${line#probe_attempted=}" ;;
      timeline_probed_slug=*) agent_review_quota_cache_timeline_probed_slug="${line#timeline_probed_slug=}" ;;
    esac
  done <"${state_file}"
  [[ -n "${agent_review_quota_cache_valid_date}" ]]
}

agent_review_copilot_quota_ensure_state_dir() {
  local state_file state_dir

  state_file="$(agent_review_copilot_quota_state_file)"
  state_dir="$(dirname "${state_file}")"
  if [[ ! -d "${state_dir}" ]]; then
    mkdir -p "${state_dir}"
  fi
}

agent_review_copilot_quota_text_is_exhausted() {
  local -r text="${1:-}"
  local profiles_dir copilot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  copilot_profile="${profiles_dir}/copilot"
  if [[ ! -f "${copilot_profile}" ]]; then
    agent_review_die 'copilot profile missing for quota detection'
  fi
  COPILOT_QUOTA_PROBE_TEXT="${text}" bash -c \
    "source '${copilot_profile}'; agent_review_profile_text_is_quota_exhausted \"\${COPILOT_QUOTA_PROBE_TEXT}\""
}

agent_review_copilot_quota_issue_comment_is_exhausted() {
  local -r login="${1:-}"
  local -r body="${2:-}"
  local profiles_dir copilot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  copilot_profile="${profiles_dir}/copilot"
  if [[ ! -f "${copilot_profile}" ]]; then
    agent_review_die 'copilot profile missing for quota detection'
  fi
  COPILOT_QUOTA_PROBE_LOGIN="${login}" COPILOT_QUOTA_PROBE_BODY="${body}" bash -c \
    "source '${copilot_profile}';
     agent_review_profile_issue_comment_is_quota_exhausted \
       \"\${COPILOT_QUOTA_PROBE_LOGIN}\" \"\${COPILOT_QUOTA_PROBE_BODY}\""
}

agent_review_copilot_quota_read_cache() {
  # evidence_url/retry_after/checked_at must be local: sourcing the cache would otherwise
  # collide with caller `local -r evidence_url` (e.g. mark_exhausted) and abort under set -e.
  local state_file today valid_date exhausted confirmed probe_requested source reason
  local evidence_url retry_after checked_at probe_requested_at probe_attempted timeline_probed_slug

  agent_review_copilot_quota_exhausted_today=0
  agent_review_copilot_quota_confirmed_today=0
  agent_review_copilot_quota_probe_requested_today=0
  agent_review_copilot_quota_probe_requested_at=0
  agent_review_copilot_quota_probe_attempted_today=0
  agent_review_copilot_quota_timeline_probed_slug=''
  agent_review_copilot_quota_cache_source=''
  agent_review_copilot_quota_cache_reason=''
  agent_review_copilot_quota_cache_evidence_url=''
  agent_review_copilot_quota_cache_retry_after=''
  today="$(agent_review_copilot_quota_local_day)"
  state_file="$(agent_review_copilot_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    return 1
  fi
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  confirmed="${confirmed:-0}"
  probe_requested="${probe_requested:-0}"
  probe_requested_at="${probe_requested_at:-0}"
  probe_attempted="${probe_attempted:-0}"
  timeline_probed_slug="${timeline_probed_slug:-}"
  source="${source:-cache}"
  reason="${reason:-}"
  if [[ "${valid_date}" != "${today}" ]]; then
    return 1
  fi
  agent_review_copilot_quota_cache_source="${source}"
  agent_review_copilot_quota_cache_reason="${reason}"
  agent_review_copilot_quota_cache_evidence_url="${evidence_url:-}"
  agent_review_copilot_quota_cache_retry_after="${retry_after:-}"
  agent_review_copilot_quota_probe_requested_at="${probe_requested_at}"
  agent_review_copilot_quota_timeline_probed_slug="${timeline_probed_slug}"
  if [[ "${exhausted}" == '1' ]]; then
    agent_review_copilot_quota_exhausted_today=1
  else
    agent_review_copilot_quota_exhausted_today=0
  fi
  if [[ "${confirmed}" == '1' ]]; then
    agent_review_copilot_quota_confirmed_today=1
  else
    agent_review_copilot_quota_confirmed_today=0
  fi
  if [[ "${probe_requested}" == '1' ]]; then
    agent_review_copilot_quota_probe_requested_today=1
  else
    agent_review_copilot_quota_probe_requested_today=0
  fi
  if [[ "${probe_attempted}" == '1' || "${probe_requested}" == '1' \
    || "${source}" == 'probe_expired' || "${source}" == 'probe_requested' ]]; then
    agent_review_copilot_quota_probe_attempted_today=1
  else
    agent_review_copilot_quota_probe_attempted_today=0
  fi
  return 0
}

agent_review_copilot_quota_write_cache() {
  local -r exhausted_flag="$1"
  local -r source_tag="$2"
  local -r reason_text="${3:-}"
  local confirmed_flag="${4:-}"
  local probe_requested_flag="${5:-}"
  local evidence_url="${6:-}"
  local retry_after="${7:-}"
  local timeline_slug_arg="${8:-}"
  local state_file today checked_at reason_quoted evidence_quoted retry_quoted
  local probe_at='' probe_attempted_flag=0 timeline_slug='' slug_quoted

  if [[ -z "${confirmed_flag}" ]]; then
    if [[ "${exhausted_flag}" == '1' ]]; then
      confirmed_flag=0
    elif [[ "${source_tag}" == 'confirmed' ]]; then
      confirmed_flag=1
    else
      confirmed_flag=0
    fi
  fi
  state_file="$(agent_review_copilot_quota_state_file)"
  today="$(agent_review_copilot_quota_local_day)"
  if agent_review_quota_cache_read_fields "${state_file}" \
    && [[ "${agent_review_quota_cache_valid_date}" == "${today}" ]]; then
    if [[ -z "${probe_requested_flag}" ]]; then
      probe_requested_flag="${agent_review_quota_cache_probe_requested:-0}"
    fi
    probe_at="${agent_review_quota_cache_probe_requested_at:-}"
    probe_attempted_flag="${agent_review_quota_cache_probe_attempted:-0}"
    timeline_slug="${agent_review_quota_cache_timeline_probed_slug:-}"
  fi
  # Prefer last sourced slug (unquoted) over raw line-parse of %q-encoded cache values.
  if [[ -n "${agent_review_copilot_quota_timeline_probed_slug:-}" ]]; then
    timeline_slug="${agent_review_copilot_quota_timeline_probed_slug}"
  fi
  probe_requested_flag="${probe_requested_flag:-0}"
  if [[ "${exhausted_flag}" == '0' && "${confirmed_flag}" != '1' ]] \
    && agent_review_quota_cache_read_fields "${state_file}" \
    && [[ "${agent_review_quota_cache_valid_date}" == "${today}" \
      && "${agent_review_quota_cache_exhausted}" == '1' \
      && "${agent_review_quota_cache_confirmed:-0}" != '1' ]]; then
    return 0
  fi
  if [[ "${source_tag}" == 'probe_requested' && "${probe_requested_flag}" == '1' ]]; then
    probe_at="$(date +%s)"
    probe_attempted_flag=1
  elif [[ "${probe_requested_flag}" == '1' ]]; then
    if [[ -z "${probe_at}" || ! "${probe_at}" =~ ^[0-9]+$ ]]; then
      probe_at="$(date +%s)"
    fi
    probe_attempted_flag=1
  elif [[ "${source_tag}" == 'probe_expired' ]]; then
    probe_at=''
    probe_attempted_flag=1
  fi
  if [[ -n "${timeline_slug_arg}" ]]; then
    timeline_slug="${timeline_slug_arg}"
  fi
  if [[ "${source_tag}" == 'timeline_probed' && -z "${timeline_slug}" ]]; then
    timeline_slug="${agent_review_copilot_quota_timeline_probed_slug:-}"
  fi
  agent_review_copilot_quota_ensure_state_dir
  checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  reason_quoted="$(agent_review_quota_quote_env_value "${reason_text}")"
  {
    cat <<EOF
valid_date=${today}
exhausted=${exhausted_flag}
confirmed=${confirmed_flag}
probe_requested=${probe_requested_flag}
probe_attempted=${probe_attempted_flag}
source=${source_tag}
checked_at=${checked_at}
reason=${reason_quoted}
EOF
    # Numeric epoch — write raw so `source` and line parsers agree (no %q).
    if [[ -n "${probe_at}" && "${probe_at}" =~ ^[0-9]+$ ]]; then
      printf 'probe_requested_at=%s\n' "${probe_at}"
    fi
    if [[ -n "${timeline_slug}" ]]; then
      slug_quoted="$(agent_review_quota_quote_env_value "${timeline_slug}")"
      printf 'timeline_probed_slug=%s\n' "${slug_quoted}"
    fi
    if [[ -n "${evidence_url}" ]]; then
      evidence_quoted="$(agent_review_quota_quote_env_value "${evidence_url}")"
      printf 'evidence_url=%s\n' "${evidence_quoted}"
    fi
    if [[ -n "${retry_after}" ]]; then
      retry_quoted="$(agent_review_quota_quote_env_value "${retry_after}")"
      printf 'retry_after=%s\n' "${retry_quoted}"
    fi
  } >"${state_file}"
  agent_review_copilot_quota_exhausted_today="${exhausted_flag}"
  if [[ "${confirmed_flag}" == '1' ]]; then
    agent_review_copilot_quota_confirmed_today=1
  else
    agent_review_copilot_quota_confirmed_today=0
  fi
  if [[ "${probe_requested_flag}" == '1' ]]; then
    agent_review_copilot_quota_probe_requested_today=1
  else
    agent_review_copilot_quota_probe_requested_today=0
  fi
  agent_review_copilot_quota_probe_attempted_today="${probe_attempted_flag}"
  agent_review_copilot_quota_probe_requested_at="${probe_at:-0}"
  agent_review_copilot_quota_timeline_probed_slug="${timeline_slug}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_copilot_quota_cache_source="${source_tag}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_copilot_quota_cache_reason="${reason_text}"
  # shellcheck disable=SC2034  # cache metadata read by operator emails
  agent_review_copilot_quota_cache_evidence_url="${evidence_url}"
  # shellcheck disable=SC2034  # cache metadata read by operator emails
  agent_review_copilot_quota_cache_retry_after="${retry_after}"
}

agent_review_copilot_quota_mark_exhausted() {
  local -r reason="${1:-Copilot review quota exhausted.}"
  local -r evidence_url="${2:-}"
  local -r retry_after="${3:-}"

  agent_review_copilot_quota_write_cache 1 observed "${reason}" '' '' "${evidence_url}" "${retry_after}"
}

agent_review_copilot_quota_mark_confirmed() {
  local -r reason="${1:-Copilot review today confirms quota is available.}"
  local -r evidence_url="${2:-}"

  agent_review_copilot_quota_write_cache 0 confirmed "${reason}" 1 '' "${evidence_url}"
}

agent_review_copilot_quota_mark_probe_requested() {
  local -r reason="${1:-Copilot review requested to probe quota.}"

  agent_review_copilot_quota_read_cache || true
  # Clear confirmed: a new ask can still hit credit exhaustion (timeline failure).
  agent_review_copilot_quota_write_cache \
    "${agent_review_copilot_quota_exhausted_today:-0}" \
    probe_requested "${reason}" \
    0 1
}

# Expire an outstanding probe_requested wait after AGENT_REVIEW_PROBE_REQUESTED_TTL.
# Returns 0 when the probe was expired (caller should re-scan the PR timeline).
# Returns 1 when there is no active probe or the TTL has not elapsed.
agent_review_copilot_quota_expire_stale_probe_requested() {
  local now ttl at age reason

  agent_review_copilot_quota_read_cache || return 1
  [[ "${agent_review_copilot_quota_probe_requested_today:-0}" == '1' ]] || return 1
  at="${agent_review_copilot_quota_probe_requested_at:-0}"
  ttl="$(agent_review_probe_requested_ttl_s)"
  now="$(date +%s)"
  if [[ ! "${at}" =~ ^[0-9]+$ ]] || (( at <= 0 )); then
    # Legacy caches without a timestamp: treat as already stale.
    age="${ttl}"
  else
    age=$(( now - at ))
  fi
  if (( age < ttl )); then
    return 1
  fi
  reason="Copilot probe_requested expired after ${ttl}s without a review (repository-helpers#408)."
  # Pass the sourced slug explicitly — raw line-parse of %q-encoded values is unreliable.
  agent_review_copilot_quota_write_cache 0 probe_expired "${reason}" 0 0 '' '' \
    "${agent_review_copilot_quota_timeline_probed_slug:-}"
  printf 'wait-for-agent-review: %s\n' "${reason}" >&2
  return 0
}

# Record a same-day Copilot timeline probe with no exhaustion signal (negative cache).
# Scoped to OWNER/NAME#N so another PR's probe cannot skip this PR's timeline (#408).
# Does not mark confirmed or exhausted — only prevents re-fetching the same PR timeline
# when no @copilot ask is outstanding (probe_requested is preserved from the prior write).
agent_review_copilot_quota_mark_timeline_probed() {
  local -r reason="${1:-Copilot PR timeline probed; no same-day quota failure.}"
  local -r slug="${2:-}"

  agent_review_copilot_quota_read_cache || true
  # Preserve probe_expired so quota fallback still treats this agent as attempted.
  if [[ "${agent_review_copilot_quota_cache_source:-}" == 'probe_expired' ]]; then
    agent_review_copilot_quota_write_cache 0 probe_expired "${reason}" 0 0 '' '' "${slug}"
    return 0
  fi
  agent_review_copilot_quota_write_cache 0 timeline_probed "${reason}" 0 '' '' '' "${slug}"
}

# True when today's Copilot cache already records a negative timeline probe for this PR.
agent_review_copilot_timeline_probed_for_pr_today() {
  local -r slug="$1"

  agent_review_copilot_quota_refresh_for_today || return 1
  [[ "${agent_review_copilot_quota_cache_source:-}" == 'timeline_probed' ]] || return 1
  [[ -n "${slug}" ]] || return 1
  [[ "${agent_review_copilot_quota_timeline_probed_slug:-}" == "${slug}" ]]
}

# Backward-compatible alias: any same-day timeline_probed (not PR-scoped). Prefer
# agent_review_copilot_timeline_probed_for_pr_today for observe gates.
agent_review_copilot_timeline_probed_today() {
  agent_review_copilot_quota_refresh_for_today || return 1
  [[ "${agent_review_copilot_quota_cache_source:-}" == 'timeline_probed' ]]
}

# Probe open PRs for Copilot reviews and issue comments without requesting a new review.
# Exit 0 when quota exhausted today, 1 when not exhausted (may still be unconfirmed).
agent_review_copilot_quota_probe_recent_reviews() {
  local probe_json today repo pr at body login reason

  agent_review_require_cmd gh
  agent_review_require_cmd jq
  today="$(agent_review_copilot_quota_local_day)"
  probe_json="$(ar_runner_gh_api_stream "agent-review quota copilot probe graphql" graphql -f query='
query {
  viewer {
    pullRequests(first: 15, states: OPEN, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number
        repository { nameWithOwner }
        comments(last: 30) {
          nodes { author { login } body createdAt }
        }
        reviews(last: 8) {
          nodes { author { login } body submittedAt }
        }
      }
    }
  }
}')"
  while IFS=$'\t' read -r repo pr at body login; do
    [[ -n "${at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${at}" "${today}"; then
      continue
    fi
    if agent_review_copilot_quota_issue_comment_is_exhausted "${login}" "${body}"; then
      reason="Copilot comment on ${repo}#${pr} at ${at} reports quota exhaustion."
      agent_review_copilot_quota_write_cache 1 probe_recent_comments "${reason}"
      return 0
    fi
  done < <(
    ar_runner_jq_file "agent-review quota copilot comments tsv" "${probe_json}" -r '
      [.data.viewer.pullRequests.nodes[]
        | . as $pr
        | .comments.nodes[]
        | select((.body // "") | length > 0)
        | {
            repo: $pr.repository.nameWithOwner,
            pr: ($pr.number | tostring),
            body: .body,
            at: .createdAt,
            login: (.author.login // "")
          }
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body, .login]
      | @tsv'
  )
  while IFS=$'\t' read -r repo pr at body; do
    [[ -n "${at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${at}" "${today}"; then
      continue
    fi
    if agent_review_copilot_quota_text_is_exhausted "${body}"; then
      reason="Copilot review on ${repo}#${pr} at ${at} reports quota exhaustion."
      agent_review_copilot_quota_write_cache 1 probe_recent_reviews "${reason}"
      return 0
    fi
  done < <(
    ar_runner_jq_file "agent-review quota copilot reviews tsv" "${probe_json}" -r '
      [.data.viewer.pullRequests.nodes[]
        | . as $pr
        | .reviews.nodes[]
        | select((.author.login // "") | test("copilot";"i"))
        | select((.body // "") | length > 0)
        | {repo: $pr.repository.nameWithOwner, pr: ($pr.number | tostring), body: .body, at: .submittedAt}
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body]
      | @tsv'
  )
  return 1
}

# Load or refresh the daily cache. Uses cache when valid_date is today; otherwise probes once.
agent_review_copilot_quota_refresh_for_today() {
  if agent_review_copilot_quota_read_cache; then
    return 0
  fi
  agent_review_copilot_quota_probe_recent_reviews || true
}

agent_review_copilot_quota_skip_request() {
  if [[ "${AGENT_REVIEW_AGENT:-copilot}" != 'copilot' ]]; then
    return 1
  fi
  agent_review_copilot_quota_refresh_for_today
  if [[ "${agent_review_copilot_quota_exhausted_today:-0}" == '1' ]]; then
    printf 'Copilot review quota exhausted (cached for %s; source=%s)\n' \
      "$(agent_review_copilot_quota_local_day)" "${agent_review_copilot_quota_cache_source:-cache}" >&2
    if [[ -n "${agent_review_copilot_quota_cache_reason:-}" ]]; then
      printf '  %s\n' "${agent_review_copilot_quota_cache_reason}" >&2
    fi
    return 0
  fi
  return 1
}

agent_review_bugbot_quota_state_file() {
  printf '%s\n' \
    "${AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE:-${HOME}/scratch/repository-helpers/bugbot-review-quota.env}"
}

agent_review_bugbot_quota_ensure_state_dir() {
  local state_file state_dir

  state_file="$(agent_review_bugbot_quota_state_file)"
  state_dir="$(dirname "${state_file}")"
  if [[ ! -d "${state_dir}" ]]; then
    mkdir -p "${state_dir}"
  fi
}

agent_review_bugbot_quota_text_is_exhausted() {
  local -r text="${1:-}"
  local profiles_dir bugbot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  bugbot_profile="${profiles_dir}/bugbot"
  if [[ ! -f "${bugbot_profile}" ]]; then
    agent_review_die 'bugbot profile missing for quota detection'
  fi
  BUGBOT_QUOTA_PROBE_TEXT="${text}" bash -c \
    "source '${bugbot_profile}'; agent_review_profile_text_is_quota_exhausted \"\${BUGBOT_QUOTA_PROBE_TEXT}\""
}

# True when cursor[bot] reports Bugbot disabled for the repository (#449).
agent_review_bugbot_quota_text_is_repo_disabled() {
  local -r text="${1:-}"
  local profiles_dir bugbot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  bugbot_profile="${profiles_dir}/bugbot"
  if [[ ! -f "${bugbot_profile}" ]]; then
    agent_review_die 'bugbot profile missing for quota detection'
  fi
  BUGBOT_QUOTA_PROBE_TEXT="${text}" bash -c \
    "source '${bugbot_profile}'; agent_review_profile_text_is_repo_disabled \"\${BUGBOT_QUOTA_PROBE_TEXT}\""
}

# Current OWNER/NAME for per-repo Bugbot disable checks (optional; empty when unknown).
agent_review_bugbot_quota_context_repo() {
  local repo

  repo="${AGENT_REVIEW_GITHUB_REPO:-}"
  if [[ -z "${repo}" ]] && declare -F agent_review_repo_from_git_origin >/dev/null 2>&1; then
    repo="$(agent_review_repo_from_git_origin || true)"
  fi
  if [[ -z "${repo}" ]]; then
    return 1
  fi
  printf '%s' "${repo}"
}

# True when <repo> is in today's Bugbot disabled_repos list (#449).
agent_review_bugbot_quota_repo_is_disabled() {
  local -r repo="$1"
  local entry

  [[ -n "${repo}" ]] || return 1
  agent_review_bugbot_quota_read_cache || return 1
  while IFS= read -r entry || [[ -n "${entry}" ]]; do
    [[ -z "${entry}" ]] && continue
    if [[ "${entry}" == "${repo}" ]]; then
      return 0
    fi
  done < <(printf '%s' "${agent_review_bugbot_quota_disabled_repos:-}" | tr ',' '\n')
  return 1
}

# Merge <repo> into disabled_repos without marking org-wide exhausted (#449).
agent_review_bugbot_quota_mark_repo_disabled() {
  local -r repo="$1"
  local -r reason_text="${2:-Bugbot disabled for this repository.}"
  local evidence_url="${3:-}"
  local state_file today checked_at reason_quoted evidence_quoted repos_quoted retry_quoted
  local exhausted_flag=0 confirmed_flag=0 probe_requested_flag=0 probe_attempted_flag=0
  local probe_at='' existing_repos='' entry found=0 retry_after=''

  [[ -n "${repo}" ]] || return 1
  agent_review_bugbot_quota_read_cache || true
  exhausted_flag="${agent_review_bugbot_quota_exhausted_today:-0}"
  confirmed_flag=0
  probe_requested_flag="${agent_review_bugbot_quota_probe_requested_today:-0}"
  probe_attempted_flag="${agent_review_bugbot_quota_probe_attempted_today:-0}"
  probe_at="${agent_review_bugbot_quota_probe_requested_at:-}"
  existing_repos="${agent_review_bugbot_quota_disabled_repos:-}"
  retry_after="${agent_review_bugbot_quota_cache_retry_after:-}"
  if [[ -z "${evidence_url}" ]]; then
    evidence_url="${agent_review_bugbot_quota_cache_evidence_url:-}"
  fi
  while IFS= read -r entry || [[ -n "${entry}" ]]; do
    [[ -z "${entry}" ]] && continue
    if [[ "${entry}" == "${repo}" ]]; then
      found=1
      break
    fi
  done < <(printf '%s' "${existing_repos}" | tr ',' '\n')
  if [[ "${found}" != '1' ]]; then
    if [[ -n "${existing_repos}" ]]; then
      existing_repos="${existing_repos},${repo}"
    else
      existing_repos="${repo}"
    fi
  fi
  agent_review_bugbot_quota_ensure_state_dir
  state_file="$(agent_review_bugbot_quota_state_file)"
  today="$(agent_review_copilot_quota_local_day)"
  checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  reason_quoted="$(agent_review_quota_quote_env_value "${reason_text}")"
  repos_quoted="$(agent_review_quota_quote_env_value "${existing_repos}")"
  {
    cat <<EOF
valid_date=${today}
exhausted=${exhausted_flag}
confirmed=${confirmed_flag}
probe_requested=${probe_requested_flag}
probe_attempted=${probe_attempted_flag}
source=observed_repo_disabled
checked_at=${checked_at}
reason=${reason_quoted}
disabled_repos=${repos_quoted}
EOF
    if [[ -n "${probe_at}" && "${probe_at}" =~ ^[0-9]+$ ]]; then
      printf 'probe_requested_at=%s\n' "${probe_at}"
    fi
    if [[ -n "${evidence_url}" ]]; then
      evidence_quoted="$(agent_review_quota_quote_env_value "${evidence_url}")"
      printf 'evidence_url=%s\n' "${evidence_quoted}"
    fi
    if [[ -n "${retry_after}" ]]; then
      retry_quoted="$(agent_review_quota_quote_env_value "${retry_after}")"
      printf 'retry_after=%s\n' "${retry_quoted}"
    fi
  } >"${state_file}"
  agent_review_bugbot_quota_exhausted_today="${exhausted_flag}"
  agent_review_bugbot_quota_confirmed_today=0
  agent_review_bugbot_quota_disabled_repos="${existing_repos}"
  agent_review_bugbot_quota_cache_source='observed_repo_disabled'
  agent_review_bugbot_quota_cache_reason="${reason_text}"
  agent_review_bugbot_quota_cache_evidence_url="${evidence_url}"
  agent_review_bugbot_quota_cache_retry_after="${retry_after}"
}

agent_review_bugbot_quota_check_run_is_exhausted() {
  local -r run_json="${1:-}"
  local profiles_dir bugbot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  bugbot_profile="${profiles_dir}/bugbot"
  if [[ ! -f "${bugbot_profile}" ]]; then
    agent_review_die 'bugbot profile missing for quota detection'
  fi
  BUGBOT_QUOTA_PROBE_JSON="${run_json}" bash -c \
    "source '${bugbot_profile}'; agent_review_profile_head_check_is_quota_exhausted \"\${BUGBOT_QUOTA_PROBE_JSON}\""
}

agent_review_bugbot_quota_check_run_is_available() {
  local -r run_json="${1:-}"
  local profiles_dir bugbot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  bugbot_profile="${profiles_dir}/bugbot"
  if [[ ! -f "${bugbot_profile}" ]]; then
    return 1
  fi
  BUGBOT_QUOTA_PROBE_JSON="${run_json}" bash -c \
    "source '${bugbot_profile}';
     agent_review_profile_head_check_is_complete \"\${BUGBOT_QUOTA_PROBE_JSON}\" \
       && ! agent_review_profile_head_check_is_quota_exhausted \"\${BUGBOT_QUOTA_PROBE_JSON}\""
}

agent_review_bugbot_quota_read_cache() {
  # evidence_url/retry_after/checked_at must be local: sourcing the cache would otherwise
  # collide with caller `local -r evidence_url` (e.g. mark_exhausted) and abort under set -e.
  local state_file today valid_date exhausted confirmed probe_requested source reason
  local evidence_url retry_after checked_at probe_requested_at probe_attempted disabled_repos

  agent_review_bugbot_quota_exhausted_today=0
  agent_review_bugbot_quota_confirmed_today=0
  agent_review_bugbot_quota_probe_requested_today=0
  agent_review_bugbot_quota_probe_requested_at=0
  agent_review_bugbot_quota_probe_attempted_today=0
  agent_review_bugbot_quota_disabled_repos=''
  agent_review_bugbot_quota_cache_source=''
  agent_review_bugbot_quota_cache_reason=''
  agent_review_bugbot_quota_cache_evidence_url=''
  agent_review_bugbot_quota_cache_retry_after=''
  today="$(agent_review_copilot_quota_local_day)"
  state_file="$(agent_review_bugbot_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    return 1
  fi
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  confirmed="${confirmed:-0}"
  probe_requested="${probe_requested:-0}"
  probe_requested_at="${probe_requested_at:-0}"
  probe_attempted="${probe_attempted:-0}"
  source="${source:-cache}"
  reason="${reason:-}"
  disabled_repos="${disabled_repos:-}"
  if [[ "${valid_date}" != "${today}" ]]; then
    return 1
  fi
  agent_review_bugbot_quota_cache_source="${source}"
  agent_review_bugbot_quota_cache_reason="${reason}"
  agent_review_bugbot_quota_cache_evidence_url="${evidence_url:-}"
  agent_review_bugbot_quota_cache_retry_after="${retry_after:-}"
  agent_review_bugbot_quota_probe_requested_at="${probe_requested_at}"
  agent_review_bugbot_quota_disabled_repos="${disabled_repos}"
  if [[ "${exhausted}" == '1' ]]; then
    agent_review_bugbot_quota_exhausted_today=1
  else
    agent_review_bugbot_quota_exhausted_today=0
  fi
  if [[ "${confirmed}" == '1' ]]; then
    agent_review_bugbot_quota_confirmed_today=1
  else
    agent_review_bugbot_quota_confirmed_today=0
  fi
  if [[ "${probe_requested}" == '1' ]]; then
    agent_review_bugbot_quota_probe_requested_today=1
  else
    agent_review_bugbot_quota_probe_requested_today=0
  fi
  if [[ "${probe_attempted}" == '1' || "${probe_requested}" == '1' \
    || "${source}" == 'probe_expired' || "${source}" == 'probe_requested' ]]; then
    agent_review_bugbot_quota_probe_attempted_today=1
  else
    agent_review_bugbot_quota_probe_attempted_today=0
  fi
  return 0
}

agent_review_bugbot_quota_write_cache() {
  local -r exhausted_flag="$1"
  local -r source_tag="$2"
  local -r reason_text="${3:-}"
  local confirmed_flag="${4:-}"
  local probe_requested_flag="${5:-}"
  local evidence_url="${6:-}"
  local retry_after="${7:-}"
  local state_file today checked_at reason_quoted evidence_quoted retry_quoted repos_quoted
  local probe_at='' probe_attempted_flag=0 disabled_repos=''

  if [[ -z "${confirmed_flag}" ]]; then
    if [[ "${exhausted_flag}" == '1' ]]; then
      confirmed_flag=0
    elif [[ "${source_tag}" == 'confirmed' ]]; then
      confirmed_flag=1
    else
      confirmed_flag=0
    fi
  fi
  state_file="$(agent_review_bugbot_quota_state_file)"
  today="$(agent_review_copilot_quota_local_day)"
  if agent_review_quota_cache_read_fields "${state_file}" \
    && [[ "${agent_review_quota_cache_valid_date}" == "${today}" ]]; then
    if [[ -z "${probe_requested_flag}" ]]; then
      probe_requested_flag="${agent_review_quota_cache_probe_requested:-0}"
    fi
    probe_at="${agent_review_quota_cache_probe_requested_at:-}"
    probe_attempted_flag="${agent_review_quota_cache_probe_attempted:-0}"
  fi
  # Preserve same-day per-repo disabled list across unrelated cache writes (#449).
  # Never copy yesterday's list into a new valid_date (stale disable would stick).
  if [[ -n "${agent_review_bugbot_quota_disabled_repos:-}" ]]; then
    disabled_repos="${agent_review_bugbot_quota_disabled_repos}"
  elif [[ -f "${state_file}" ]]; then
    # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
    disabled_repos="$(
      valid_date=''
      disabled_repos=''
      # shellcheck disable=SC2034  # only valid_date/disabled_repos used from sourced cache
      source "${state_file}"
      if [[ "${valid_date:-}" == "${today}" ]]; then
        printf '%s' "${disabled_repos:-}"
      fi
    )"
  fi
  probe_requested_flag="${probe_requested_flag:-0}"
  if [[ "${exhausted_flag}" == '0' && "${confirmed_flag}" != '1' ]] \
    && agent_review_quota_cache_read_fields "${state_file}" \
    && [[ "${agent_review_quota_cache_valid_date}" == "${today}" \
      && "${agent_review_quota_cache_exhausted}" == '1' \
      && "${agent_review_quota_cache_confirmed:-0}" != '1' ]]; then
    return 0
  fi
  if [[ "${source_tag}" == 'probe_requested' && "${probe_requested_flag}" == '1' ]]; then
    probe_at="$(date +%s)"
    probe_attempted_flag=1
  elif [[ "${probe_requested_flag}" == '1' ]]; then
    if [[ -z "${probe_at}" || ! "${probe_at}" =~ ^[0-9]+$ ]]; then
      probe_at="$(date +%s)"
    fi
    probe_attempted_flag=1
  elif [[ "${source_tag}" == 'probe_expired' ]]; then
    probe_at=''
    probe_attempted_flag=1
  fi
  agent_review_bugbot_quota_ensure_state_dir
  checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  reason_quoted="$(agent_review_quota_quote_env_value "${reason_text}")"
  {
    cat <<EOF
valid_date=${today}
exhausted=${exhausted_flag}
confirmed=${confirmed_flag}
probe_requested=${probe_requested_flag}
probe_attempted=${probe_attempted_flag}
source=${source_tag}
checked_at=${checked_at}
reason=${reason_quoted}
EOF
    if [[ -n "${probe_at}" && "${probe_at}" =~ ^[0-9]+$ ]]; then
      printf 'probe_requested_at=%s\n' "${probe_at}"
    fi
    if [[ -n "${disabled_repos}" ]]; then
      repos_quoted="$(agent_review_quota_quote_env_value "${disabled_repos}")"
      printf 'disabled_repos=%s\n' "${repos_quoted}"
    fi
    if [[ -n "${evidence_url}" ]]; then
      evidence_quoted="$(agent_review_quota_quote_env_value "${evidence_url}")"
      printf 'evidence_url=%s\n' "${evidence_quoted}"
    fi
    if [[ -n "${retry_after}" ]]; then
      retry_quoted="$(agent_review_quota_quote_env_value "${retry_after}")"
      printf 'retry_after=%s\n' "${retry_quoted}"
    fi
  } >"${state_file}"
  agent_review_bugbot_quota_exhausted_today="${exhausted_flag}"
  agent_review_bugbot_quota_disabled_repos="${disabled_repos}"
  if [[ "${confirmed_flag}" == '1' ]]; then
    agent_review_bugbot_quota_confirmed_today=1
  else
    agent_review_bugbot_quota_confirmed_today=0
  fi
  if [[ "${probe_requested_flag}" == '1' ]]; then
    agent_review_bugbot_quota_probe_requested_today=1
  else
    agent_review_bugbot_quota_probe_requested_today=0
  fi
  agent_review_bugbot_quota_probe_attempted_today="${probe_attempted_flag}"
  agent_review_bugbot_quota_probe_requested_at="${probe_at:-0}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_bugbot_quota_cache_source="${source_tag}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_bugbot_quota_cache_reason="${reason_text}"
  # shellcheck disable=SC2034  # cache metadata read by operator emails
  agent_review_bugbot_quota_cache_evidence_url="${evidence_url}"
  # shellcheck disable=SC2034  # cache metadata read by operator emails
  agent_review_bugbot_quota_cache_retry_after="${retry_after}"
}

agent_review_bugbot_quota_mark_exhausted() {
  local -r reason="${1:-Bugbot usage limit reached.}"
  local -r evidence_url="${2:-}"
  local -r retry_after="${3:-}"

  agent_review_bugbot_quota_write_cache 1 observed "${reason}" '' '' "${evidence_url}" "${retry_after}"
}

# Drop same-day observed exhaustion when posting a fresh Bugbot request so a new
# run can proceed after a stale pre-request signal was cached.
#
# A genuine "usage limit reached" observation is a hard daily/spend limit tied to the
# developer's GitHub identity (not a short cooldown), so it must stay sticky for the whole
# local calendar day and be honored across every org repo (see issue #379). Never clear it.
agent_review_bugbot_quota_clear_observed_cache() {
  local state_file today valid_date exhausted source
  local evidence_url retry_after checked_at reason confirmed probe_requested

  state_file="$(agent_review_bugbot_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    return 0
  fi
  today="$(agent_review_copilot_quota_local_day)"
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  source="${source:-cache}"
  reason="${reason:-}"
  if [[ "${valid_date}" == "${today}" && "${exhausted}" == '1' && "${source}" == 'observed' ]]; then
    if agent_review_bugbot_quota_text_is_exhausted "${reason}"; then
      return 0
    fi
    rm -f "${state_file}"
    agent_review_bugbot_quota_exhausted_today=0
    agent_review_bugbot_quota_confirmed_today=0
    agent_review_bugbot_quota_cache_source=''
    agent_review_bugbot_quota_cache_reason=''
  fi
}

agent_review_bugbot_quota_mark_confirmed() {
  local -r reason="${1:-Bugbot check today confirms usage is available.}"
  local -r evidence_url="${2:-}"

  agent_review_bugbot_quota_write_cache 0 confirmed "${reason}" 1 '' "${evidence_url}"
}

agent_review_bugbot_quota_mark_probe_requested() {
  local -r reason="${1:-Bugbot review requested to probe quota.}"

  agent_review_bugbot_quota_read_cache || true
  agent_review_bugbot_quota_write_cache \
    "${agent_review_bugbot_quota_exhausted_today:-0}" \
    probe_requested "${reason}" \
    0 1
}

# Expire an outstanding Bugbot probe_requested wait after AGENT_REVIEW_PROBE_REQUESTED_TTL.
# Returns 0 when expired; 1 when still active or not set.
agent_review_bugbot_quota_expire_stale_probe_requested() {
  local now ttl at age reason

  agent_review_bugbot_quota_read_cache || return 1
  [[ "${agent_review_bugbot_quota_probe_requested_today:-0}" == '1' ]] || return 1
  at="${agent_review_bugbot_quota_probe_requested_at:-0}"
  ttl="$(agent_review_probe_requested_ttl_s)"
  now="$(date +%s)"
  if [[ ! "${at}" =~ ^[0-9]+$ ]] || (( at <= 0 )); then
    age="${ttl}"
  else
    age=$(( now - at ))
  fi
  if (( age < ttl )); then
    return 1
  fi
  reason="Bugbot probe_requested expired after ${ttl}s without a review (repository-helpers#408)."
  agent_review_bugbot_quota_write_cache 0 probe_expired "${reason}" 0 0
  printf 'wait-for-agent-review: %s\n' "${reason}" >&2
  return 0
}

# Probe open PRs for Bugbot PR comments, reviews, and head checks without requesting a new review.
# Exit 0 when usage limit exhausted today, 1 when not exhausted (may still be unconfirmed).
agent_review_bugbot_quota_probe_recent_signals() {
  local probe_json today repo pr at body head run_json reason lib_dir

  agent_review_require_cmd gh
  agent_review_require_cmd jq
  lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  today="$(agent_review_copilot_quota_local_day)"
  probe_json="$(ar_runner_gh_api_stream "agent-review quota bugbot probe graphql" graphql -f query='
query {
  viewer {
    pullRequests(first: 15, states: OPEN, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number
        repository { nameWithOwner }
        headRefOid
        comments(last: 30) {
          nodes { author { login } body createdAt }
        }
        reviews(last: 8) {
          nodes { author { login } body submittedAt }
        }
      }
    }
  }
}')"
  while IFS=$'\t' read -r repo pr at body; do
    [[ -n "${at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${at}" "${today}"; then
      continue
    fi
    if agent_review_bugbot_quota_text_is_exhausted "${body}"; then
      if agent_review_bugbot_quota_text_is_repo_disabled "${body}"; then
        reason="Bugbot comment on ${repo}#${pr} at ${at} reports disabled for this repository."
        agent_review_bugbot_quota_mark_repo_disabled "${repo}" "${reason}"
        continue
      elif [[ "${body,,}" == *"disabled"* || "${body,,}" == *"not enabled"* ]]; then
        reason="Bugbot comment on ${repo}#${pr} at ${at} reports disabled for your account."
      else
        reason="Bugbot comment on ${repo}#${pr} at ${at} reports usage limit reached."
      fi
      agent_review_bugbot_quota_write_cache 1 probe_recent_comments "${reason}"
      return 0
    fi
  done < <(
    ar_runner_jq_file "agent-review quota bugbot comments tsv" "${probe_json}" -r '
      [.data.viewer.pullRequests.nodes[]
        | . as $pr
        | [
            ($pr.comments.nodes[]
              | {
                  repo: $pr.repository.nameWithOwner,
                  pr: ($pr.number | tostring),
                  body: .body,
                  at: .createdAt,
                  login: (.author.login // "")
                }),
            ($pr.reviews.nodes[]
              | {
                  repo: $pr.repository.nameWithOwner,
                  pr: ($pr.number | tostring),
                  body: .body,
                  at: .submittedAt,
                  login: (.author.login // "")
                })
          ]
        | .[]
        | select(.login | test("cursor";"i"))
        | select((.body // "") | length > 0)
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body]
      | @tsv'
  )
  while IFS=$'\t' read -r repo head; do
    [[ -n "${head}" ]] || continue
    run_json="$(runner_exec_stdout "agent-review quota bugbot head check" -- bash -c '
      source "$1/agent-review"
      agent_review_use_agent bugbot
      agent_review_head_check_run_json_for_head "$2" "$3"
    ' bash "${lib_dir}" "${repo}" "${head}" || true)"
    if [[ -z "${run_json}" || "${run_json}" == 'null' ]]; then
      continue
    fi
    if ! agent_review_quota_timestamp_on_local_day \
        "$(ar_runner_jq_file "agent-review quota bugbot started_at" "${run_json}" -r '.started_at // ""')" "${today}" \
      && ! agent_review_quota_timestamp_on_local_day \
        "$(ar_runner_jq_file "agent-review quota bugbot completed_at" "${run_json}" -r '.completed_at // ""')" "${today}"; then
      continue
    fi
    if agent_review_bugbot_quota_check_run_is_exhausted "${run_json}"; then
      reason="Bugbot check on ${repo} head ${head:0:7} reports usage limit reached."
      agent_review_bugbot_quota_write_cache 1 probe_head_checks "${reason}"
      return 0
    fi
  done < <(
    ar_runner_jq_file "agent-review quota bugbot pr heads" "${probe_json}" -r '
      .data.viewer.pullRequests.nodes[]
      | "\(.repository.nameWithOwner)\t\(.headRefOid)"'
  )
  return 1
}

# Backward-compatible alias for callers/tests.
agent_review_bugbot_quota_probe_open_prs() {
  agent_review_bugbot_quota_probe_recent_signals
}

agent_review_bugbot_quota_refresh_for_today() {
  if agent_review_bugbot_quota_read_cache; then
    return 0
  fi
  agent_review_bugbot_quota_probe_recent_signals || true
}

agent_review_bugbot_quota_skip_request() {
  local context_repo

  if [[ "${AGENT_REVIEW_AGENT:-copilot}" != 'bugbot' ]]; then
    return 1
  fi
  agent_review_bugbot_quota_refresh_for_today
  if [[ "${agent_review_bugbot_quota_exhausted_today:-0}" == '1' ]]; then
    printf 'Bugbot unavailable (cached for %s; source=%s)\n' \
      "$(agent_review_copilot_quota_local_day)" "${agent_review_bugbot_quota_cache_source:-cache}" >&2
    if [[ -n "${agent_review_bugbot_quota_cache_reason:-}" ]]; then
      printf '  %s\n' "${agent_review_bugbot_quota_cache_reason}" >&2
    fi
    return 0
  fi
  context_repo="$(agent_review_bugbot_quota_context_repo || true)"
  if [[ -n "${context_repo}" ]] \
    && agent_review_bugbot_quota_repo_is_disabled "${context_repo}"; then
    printf 'Bugbot disabled for %s (cached for %s; source=%s)\n' \
      "${context_repo}" \
      "$(agent_review_copilot_quota_local_day)" \
      "${agent_review_bugbot_quota_cache_source:-cache}" >&2
    if [[ -n "${agent_review_bugbot_quota_cache_reason:-}" ]]; then
      printf '  %s\n' "${agent_review_bugbot_quota_cache_reason}" >&2
    fi
    return 0
  fi
  return 1
}

# Persist daily quota exhaustion for a specific agent profile id.
agent_review_quota_mark_exhausted_for_agent() {
  local -r agent_id="$1"
  local -r reason="${2:-Agent review quota exhausted.}"
  local -r evidence_url="${3:-}"
  local -r retry_after="${4:-}"

  case "${agent_id}" in
    copilot) agent_review_copilot_quota_mark_exhausted "${reason}" "${evidence_url}" "${retry_after}" ;;
    bugbot) agent_review_bugbot_quota_mark_exhausted "${reason}" "${evidence_url}" "${retry_after}" ;;
    coderabbit) agent_review_coderabbit_quota_mark_exhausted "${reason}" "${evidence_url}" "${retry_after}" ;;
    *) return 1 ;;
  esac
}

# Persist confirmed daily availability after a successful review or check on the PR under review.
agent_review_quota_mark_confirmed_for_agent() {
  local -r agent_id="$1"
  local -r reason="${2:-Agent review today confirms quota is available.}"
  local -r evidence_url="${3:-}"

  case "${agent_id}" in
    copilot) agent_review_copilot_quota_mark_confirmed "${reason}" "${evidence_url}" ;;
    bugbot) agent_review_bugbot_quota_mark_confirmed "${reason}" "${evidence_url}" ;;
    coderabbit) agent_review_coderabbit_quota_mark_confirmed "${reason}" "${evidence_url}" ;;
    *) return 1 ;;
  esac
}

# Record that a manual review request was sent to probe quota for this agent today.
agent_review_quota_mark_probe_requested_for_agent() {
  local -r agent_id="$1"
  local -r reason="${2:-Review requested to probe quota.}"

  case "${agent_id}" in
    copilot) agent_review_copilot_quota_mark_probe_requested "${reason}" ;;
    bugbot) agent_review_bugbot_quota_mark_probe_requested "${reason}" ;;
    coderabbit) return 0 ;;
    *) return 1 ;;
  esac
}

agent_review_agent_quota_mark_exhausted() {
  local reason="${1:-Agent review quota exhausted.}"
  local agent_id="${2:-${AGENT_REVIEW_AGENT:-copilot}}"

  agent_review_quota_mark_exhausted_for_agent "${agent_id}" "${reason}"
}

agent_review_agent_quota_skip_request() {
  case "${AGENT_REVIEW_AGENT:-copilot}" in
    copilot) agent_review_copilot_quota_skip_request ;;
    bugbot) agent_review_bugbot_quota_skip_request ;;
    *) return 1 ;;
