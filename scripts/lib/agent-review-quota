# True when <agent_id> daily quota cache reports exhaustion (no log output).
agent_review_agent_quota_exhausted_for_agent() {
  local -r agent_id="$1"
  local exhausted retry_after now now_epoch retry_epoch context_repo

  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      exhausted="${agent_review_copilot_quota_exhausted_today:-0}"
      retry_after="${agent_review_copilot_quota_cache_retry_after:-}"
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      exhausted="${agent_review_bugbot_quota_exhausted_today:-0}"
      retry_after="${agent_review_bugbot_quota_cache_retry_after:-}"
      if [[ "${exhausted}" != '1' ]]; then
        context_repo="$(agent_review_bugbot_quota_context_repo || true)"
        if [[ -n "${context_repo}" ]] \
          && agent_review_bugbot_quota_repo_is_disabled "${context_repo}"; then
          return 0
        fi
      fi
      ;;
    coderabbit)
      agent_review_coderabbit_quota_refresh_for_today
      exhausted="${agent_review_coderabbit_quota_exhausted_today:-0}"
      retry_after="${agent_review_coderabbit_quota_cache_retry_after:-}"
      ;;
    *) return 1 ;;
  esac
  if [[ "${exhausted}" != '1' ]]; then
    return 1
  fi
  if [[ -n "${retry_after}" ]]; then
    now="$(runner_exec_stdout "agent-review quota now iso" -- date -u +%Y-%m-%dT%H:%M:%SZ)"
    now_epoch="$(runner_exec_stdout "agent-review quota now epoch" -- date -u -d "${now}" +%s)"
    retry_epoch="$(runner_exec_stdout "agent-review quota retry epoch" -- \
      date -u -d "${retry_after}" +%s 2>/dev/null || true)"
    if [[ -n "${retry_epoch}" ]] && (( now_epoch > retry_epoch )); then
      return 1
    fi
  fi
  return 0
}

# True when <agent_id> is in a temporary rate-limit window (retry_after still in the future).
agent_review_agent_quota_rate_limited_for_agent() {
  local -r agent_id="$1"
  local retry_after

  if ! agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    return 1
  fi
  retry_after="$(agent_review_agent_quota_cache_retry_after_for_agent "${agent_id}")"
  [[ -n "${retry_after}" ]]
}

# Prints seconds until retry_after for <agent_id> (0 when due now, empty on failure).
agent_review_agent_quota_seconds_until_retry_for_agent() {
  local -r agent_id="$1"
  local retry_after now retry_epoch remaining

  retry_after="$(agent_review_agent_quota_cache_retry_after_for_agent "${agent_id}")"
  [[ -n "${retry_after}" ]] || return 1
  now="$(date -u +%s)"
  retry_epoch="$(date -u -d "${retry_after}" +%s 2>/dev/null || true)"
  [[ -n "${retry_epoch}" ]] || return 1
  remaining=$((retry_epoch - now))
  if (( remaining < 0 )); then
    remaining=0
  fi
  printf '%s' "${remaining}"
}

# Clear observed exhaustion for <agent_id> (after a rate-limit window elapses).
agent_review_agent_quota_clear_observed_for_agent() {
  local -r agent_id="$1"

  case "${agent_id}" in
    bugbot) agent_review_bugbot_quota_clear_observed_cache ;;
    coderabbit) agent_review_coderabbit_quota_clear_observed_cache ;;
    *) return 1 ;;
  esac
}

# True when all agents in the quota chain are exhausted without a retry window.
agent_review_all_quotas_exhausted() {
  agent_review_agent_quota_exhausted_for_agent copilot \
    && agent_review_agent_quota_exhausted_for_agent bugbot \
    && agent_review_agent_quota_exhausted_for_agent coderabbit
}

# agent_review_agent_unavailable_reason_for_agent <agent_id>
# Compact machine token for check JSON / wait_reason (empty when agent is available).
agent_review_agent_unavailable_reason_for_agent() {
  local -r agent_id="$1"
  local reason retry_after lower bugbot_repo

  if agent_review_agent_quota_rate_limited_for_agent "${agent_id}"; then
    retry_after="$(agent_review_agent_quota_cache_retry_after_for_agent "${agent_id}")"
    if [[ -n "${retry_after}" ]]; then
      printf 'rate_limited_until=%s' "${retry_after}"
      return 0
    fi
    printf 'rate_limited'
    return 0
  fi
  if ! agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    return 1
  fi
  reason="$(agent_review_agent_quota_cache_reason_for_agent "${agent_id}")"
  lower="${reason,,}"
  # Precise repo-disabled wording only (#449). Do not match bare "repository" in the
  # slug (e.g. the-hcma/repository-helpers + "disabled for your account").
  if [[ "${lower}" == *"disabled for this repository"* ]] \
    || [[ "${lower}" == *"disabled for the repository"* ]] \
    || [[ "${lower}" == *"disabled_for_repository"* ]]; then
    printf 'disabled_for_repository'
    return 0
  fi
  if [[ "${agent_id}" == 'bugbot' ]]; then
    bugbot_repo=''
    bugbot_repo="$(agent_review_bugbot_quota_context_repo || true)"
    if [[ -n "${bugbot_repo}" ]] \
      && agent_review_bugbot_quota_repo_is_disabled "${bugbot_repo}"; then
      printf 'disabled_for_repository'
      return 0
    fi
  fi
  if [[ "${lower}" == *"disabled"* ]]; then
    printf 'disabled_for_account'
    return 0
  fi
  if [[ "${lower}" == *"copilot_work_finished_failure"* ]]; then
    printf 'copilot_work_finished_failure'
    return 0
  fi
  if [[ "${lower}" == *"usage limit"* || "${lower}" == *"spend limit"* \
    || "${lower}" == *"billing"* || "${lower}" == *"quota"* ]]; then
    printf 'quota_exhausted'
    return 0
  fi
  if [[ -n "${reason}" ]]; then
    printf 'unavailable'
    return 0
  fi
  printf 'exhausted'
}

# agent_review_agents_availability_json
# Per-cycle-agent availability for check JSON (repository-helpers#415).
agent_review_agents_availability_json() {
  local agent available reason out

  out='{}'
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    available=true
    reason=''
    if reason="$(agent_review_agent_unavailable_reason_for_agent "${agent}")"; then
      available=false
    else
      reason=''
    fi
    out="$(ar_runner_jq_file "agent-review agents availability merge" "${out}" \
      --arg id "${agent}" \
      --argjson available "${available}" \
      --arg reason "${reason}" \
      '. * {($id): {available: $available, reason: (if $reason == "" then null else $reason end)}}')"
  done < <(agent_review_cycle_quota_agent_ids)
  printf '%s\n' "${out}"
}

# agent_review_wait_reason_from_agent_availability
# Prefer explicit per-agent unavailability over a CodeRabbit-only cooldown string.
agent_review_wait_reason_from_agent_availability() {
  local agent reason pieces cr_retry

  pieces=()
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if reason="$(agent_review_agent_unavailable_reason_for_agent "${agent}")"; then
      pieces+=("${agent}=${reason}")
    fi
  done < <(agent_review_cycle_quota_agent_ids)
  if (( ${#pieces[@]} > 0 )); then
    local IFS=','
    printf '%s' "${pieces[*]}"
    return 0
  fi
  if agent_review_agent_quota_rate_limited_for_agent 'coderabbit'; then
    cr_retry="$(agent_review_agent_quota_cache_retry_after_for_agent 'coderabbit')"
    if [[ -n "${cr_retry}" ]]; then
      printf 'coderabbit_rate_limited_until=%s' "${cr_retry}"
      return 0
    fi
  fi
  return 1
}
