#!/usr/bin/env bash
# agent-review-quota — daily agent review quota caches and programmatic probes.
#
# GitHub does not expose per-user Copilot or Bugbot quota APIs. We cache exhaustion
# for the local calendar day under ~/scratch/repository-helpers and refresh once per
# day by scanning recent agent signals on the viewer's open PRs.

agent_review_copilot_quota_state_file() {
  printf '%s\n' \
    "${AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE:-${HOME}/scratch/repository-helpers/copilot-review-quota.env}"
}

agent_review_copilot_quota_local_day() {
  date +%Y-%m-%d
}

# True when a UTC ISO-8601 timestamp falls on the given local calendar day (YYYY-MM-DD).
agent_review_quota_timestamp_on_local_day() {
  local -r iso_ts="$1"
  local -r local_day="$2"
  local ts_day

  [[ -n "${iso_ts}" && -n "${local_day}" ]] || return 1
  ts_day="$(date -d "${iso_ts}" +%Y-%m-%d 2>/dev/null)" || return 1
  [[ "${ts_day}" == "${local_day}" ]]
}

agent_review_quota_quote_env_value() {
  local -r value="$1"

  printf '%q' "${value}"
}

agent_review_copilot_quota_ensure_state_dir() {
  local state_file state_dir

  state_file="$(agent_review_copilot_quota_state_file)"
  state_dir="$(dirname "${state_file}")"
  if [[ ! -d "${state_dir}" ]]; then
    mkdir -p "${state_dir}"
  fi
}

agent_review_copilot_quota_text_is_exhausted() {
  local -r text="${1:-}"
  local profiles_dir copilot_profile

  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  copilot_profile="${profiles_dir}/copilot"
  if [[ ! -f "${copilot_profile}" ]]; then
    agent_review_die 'copilot profile missing for quota detection'
  fi
  COPILOT_QUOTA_PROBE_TEXT="${text}" bash -c \
    "source '${copilot_profile}'; agent_review_profile_text_is_quota_exhausted \"\${COPILOT_QUOTA_PROBE_TEXT}\""
}

agent_review_copilot_quota_read_cache() {
  local state_file today valid_date exhausted source reason

  agent_review_copilot_quota_exhausted_today=0
  agent_review_copilot_quota_cache_source=''
  agent_review_copilot_quota_cache_reason=''
  today="$(agent_review_copilot_quota_local_day)"
  state_file="$(agent_review_copilot_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    return 1
  fi
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  source="${source:-cache}"
  reason="${reason:-}"
  if [[ "${valid_date}" != "${today}" ]]; then
    return 1
  fi
  agent_review_copilot_quota_cache_source="${source}"
  agent_review_copilot_quota_cache_reason="${reason}"
  if [[ "${exhausted}" == '1' ]]; then
    agent_review_copilot_quota_exhausted_today=1
  else
    agent_review_copilot_quota_exhausted_today=0
  fi
  return 0
}

agent_review_copilot_quota_write_cache() {
  local -r exhausted_flag="$1"
  local -r source_tag="$2"
  local -r reason_text="${3:-}"
  local state_file today checked_at reason_quoted

  agent_review_copilot_quota_ensure_state_dir
  state_file="$(agent_review_copilot_quota_state_file)"
  today="$(agent_review_copilot_quota_local_day)"
  checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  reason_quoted="$(agent_review_quota_quote_env_value "${reason_text}")"
  cat >"${state_file}" <<EOF
valid_date=${today}
exhausted=${exhausted_flag}
source=${source_tag}
checked_at=${checked_at}
reason=${reason_quoted}
EOF
  agent_review_copilot_quota_exhausted_today="${exhausted_flag}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_copilot_quota_cache_source="${source_tag}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_copilot_quota_cache_reason="${reason_text}"
}

agent_review_copilot_quota_mark_exhausted() {
  local -r reason="${1:-Copilot review quota exhausted.}"

  agent_review_copilot_quota_write_cache 1 observed "${reason}"
}

agent_review_copilot_quota_mark_available() {
  agent_review_copilot_quota_write_cache 0 probe 'Recent Copilot reviews show quota is available.'
}

# Probe open PRs for the authenticated viewer without requesting a new review.
# Exit 0 when quota exhausted today, 1 when available/unknown (not exhausted).
agent_review_copilot_quota_probe_recent_reviews() {
  local probe_json today repo pr at body reason found_today

  agent_review_require_cmd gh
  agent_review_require_cmd jq
  today="$(agent_review_copilot_quota_local_day)"
  probe_json="$(gh api graphql -f query='
query {
  viewer {
    pullRequests(first: 15, states: OPEN, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number
        repository { nameWithOwner }
        reviews(last: 8) {
          nodes { author { login } body submittedAt }
        }
      }
    }
  }
}')"
  found_today=0
  while IFS=$'\t' read -r repo pr at body; do
    [[ -n "${at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${at}" "${today}"; then
      continue
    fi
    found_today=1
    if agent_review_copilot_quota_text_is_exhausted "${body}"; then
      reason="Copilot review on ${repo}#${pr} at ${at} reports quota exhaustion."
      agent_review_copilot_quota_write_cache 1 probe_recent_reviews "${reason}"
      return 0
    fi
  done < <(
    printf '%s' "${probe_json}" | jq -r '
      [.data.viewer.pullRequests.nodes[]
        | . as $pr
        | .reviews.nodes[]
        | select((.author.login // "") | test("copilot";"i"))
        | select((.body // "") | length > 0)
        | {repo: $pr.repository.nameWithOwner, pr: ($pr.number | tostring), body: .body, at: .submittedAt}
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body]
      | @tsv'
  )
  if [[ "${found_today}" == '1' ]]; then
    agent_review_copilot_quota_mark_available
    return 1
  fi
  agent_review_copilot_quota_write_cache 0 probe 'No Copilot reviews found for today on open PRs.'
  return 1
}

# Load or refresh the daily cache. Uses cache when valid_date is today; otherwise probes once.
agent_review_copilot_quota_refresh_for_today() {
  if agent_review_copilot_quota_read_cache; then
    return 0
  fi
  agent_review_copilot_quota_probe_recent_reviews || true
}

agent_review_copilot_quota_skip_request() {
  if [[ "${AGENT_REVIEW_AGENT:-copilot}" != 'copilot' ]]; then
    return 1
  fi
  agent_review_copilot_quota_refresh_for_today
  if [[ "${agent_review_copilot_quota_exhausted_today:-0}" == '1' ]]; then
    printf 'Copilot review quota exhausted (cached for %s; source=%s)\n' \
      "$(agent_review_copilot_quota_local_day)" "${agent_review_copilot_quota_cache_source:-cache}" >&2
    if [[ -n "${agent_review_copilot_quota_cache_reason:-}" ]]; then
      printf '  %s\n' "${agent_review_copilot_quota_cache_reason}" >&2
    fi
    return 0
  fi
  return 1
}

