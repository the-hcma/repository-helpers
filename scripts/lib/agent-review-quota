agent_review_coderabbit_quota_read_cache() {
  # evidence_url/retry_after/checked_at must be local: sourcing the cache would otherwise
  # collide with caller `local -r evidence_url` (e.g. mark_exhausted) and abort under set -e.
  local state_file today valid_date exhausted confirmed probe_requested source reason
  local evidence_url retry_after checked_at

  agent_review_coderabbit_quota_exhausted_today=0
  agent_review_coderabbit_quota_confirmed_today=0
  agent_review_coderabbit_quota_probe_requested_today=0
  agent_review_coderabbit_quota_cache_source=''
  agent_review_coderabbit_quota_cache_reason=''
  agent_review_coderabbit_quota_cache_evidence_url=''
  agent_review_coderabbit_quota_cache_retry_after=''
  today="$(agent_review_copilot_quota_local_day)"
  state_file="$(agent_review_coderabbit_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    return 1
  fi
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  confirmed="${confirmed:-0}"
  probe_requested="${probe_requested:-0}"
  source="${source:-cache}"
  reason="${reason:-}"
  if [[ "${valid_date}" != "${today}" ]]; then
    return 1
  fi
  agent_review_coderabbit_quota_cache_source="${source}"
  agent_review_coderabbit_quota_cache_reason="${reason}"
  agent_review_coderabbit_quota_cache_evidence_url="${evidence_url:-}"
  agent_review_coderabbit_quota_cache_retry_after="${retry_after:-}"
  if [[ "${exhausted}" == '1' ]]; then
    agent_review_coderabbit_quota_exhausted_today=1
  else
    agent_review_coderabbit_quota_exhausted_today=0
  fi
  if [[ "${confirmed}" == '1' ]]; then
    agent_review_coderabbit_quota_confirmed_today=1
  else
    agent_review_coderabbit_quota_confirmed_today=0
  fi
  if [[ "${probe_requested}" == '1' ]]; then
    agent_review_coderabbit_quota_probe_requested_today=1
  else
    agent_review_coderabbit_quota_probe_requested_today=0
  fi
  return 0
}

agent_review_coderabbit_quota_write_cache() {
  local -r exhausted_flag="$1"
  local -r source_tag="$2"
  local -r reason_text="${3:-}"
  local confirmed_flag="${4:-}"
  local probe_requested_flag="${5:-}"
  local evidence_url="${6:-}"
  local retry_after="${7:-}"
  local state_file today checked_at reason_quoted evidence_quoted retry_quoted

  if [[ -z "${confirmed_flag}" ]]; then
    if [[ "${exhausted_flag}" == '1' ]]; then
      confirmed_flag=0
    elif [[ "${source_tag}" == 'confirmed' ]]; then
      confirmed_flag=1
    else
      confirmed_flag=0
    fi
  fi
  state_file="$(agent_review_coderabbit_quota_state_file)"
  today="$(agent_review_copilot_quota_local_day)"
  if agent_review_quota_cache_read_fields "${state_file}" \
    && [[ "${agent_review_quota_cache_valid_date}" == "${today}" ]]; then
    if [[ -z "${probe_requested_flag}" ]]; then
      probe_requested_flag="${agent_review_quota_cache_probe_requested:-0}"
    fi
  fi
  probe_requested_flag="${probe_requested_flag:-0}"
  if [[ "${exhausted_flag}" == '0' && "${confirmed_flag}" != '1' ]] \
    && agent_review_quota_cache_read_fields "${state_file}" \
    && [[ "${agent_review_quota_cache_valid_date}" == "${today}" \
      && "${agent_review_quota_cache_exhausted}" == '1' \
      && "${agent_review_quota_cache_confirmed:-0}" != '1' ]]; then
    return 0
  fi
  agent_review_coderabbit_quota_ensure_state_dir
  checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  reason_quoted="$(agent_review_quota_quote_env_value "${reason_text}")"
  {
    cat <<EOF
valid_date=${today}
exhausted=${exhausted_flag}
confirmed=${confirmed_flag}
probe_requested=${probe_requested_flag}
source=${source_tag}
checked_at=${checked_at}
reason=${reason_quoted}
EOF
    if [[ -n "${evidence_url}" ]]; then
      evidence_quoted="$(agent_review_quota_quote_env_value "${evidence_url}")"
      printf 'evidence_url=%s\n' "${evidence_quoted}"
    fi
    if [[ -n "${retry_after}" ]]; then
      retry_quoted="$(agent_review_quota_quote_env_value "${retry_after}")"
      printf 'retry_after=%s\n' "${retry_quoted}"
    fi
  } >"${state_file}"
  agent_review_coderabbit_quota_exhausted_today="${exhausted_flag}"
  if [[ "${confirmed_flag}" == '1' ]]; then
    agent_review_coderabbit_quota_confirmed_today=1
  else
    agent_review_coderabbit_quota_confirmed_today=0
  fi
  if [[ "${probe_requested_flag}" == '1' ]]; then
    agent_review_coderabbit_quota_probe_requested_today=1
  else
    agent_review_coderabbit_quota_probe_requested_today=0
  fi
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_coderabbit_quota_cache_source="${source_tag}"
  # shellcheck disable=SC2034  # cache metadata read by wait-for-agent-review logging
  agent_review_coderabbit_quota_cache_reason="${reason_text}"
  # shellcheck disable=SC2034  # cache metadata read by operator emails
  agent_review_coderabbit_quota_cache_evidence_url="${evidence_url}"
  # shellcheck disable=SC2034  # cache metadata read by operator emails
  agent_review_coderabbit_quota_cache_retry_after="${retry_after}"
}

agent_review_coderabbit_quota_mark_exhausted() {
  local -r reason="${1:-CodeRabbit usage limit reached.}"
  local -r evidence_url="${2:-}"
  local retry_after="${3:-}"
  local existing_retry now evidence_keep now_epoch existing_epoch new_epoch

  # Prefer the later still-future retry_after so a stale probe on another PR
  # (expired "Next review available…") cannot clobber a newer cooldown window.
  # Compare via UTC epochs — not locale-sensitive [[ string < string ]] (CR on #368).
  agent_review_coderabbit_quota_read_cache || true
  existing_retry="${agent_review_coderabbit_quota_cache_retry_after:-}"
  now="$(runner_exec_stdout "coderabbit quota mark_exhausted now" -- date -u +%Y-%m-%dT%H:%M:%SZ)"
  now_epoch="$(runner_exec_stdout "coderabbit quota mark_exhausted now epoch" -- \
    date -u -d "${now}" +%s)"
  evidence_keep="${evidence_url}"
  if [[ -n "${existing_retry}" ]]; then
    existing_epoch="$(runner_exec_stdout "coderabbit quota mark_exhausted existing epoch" -- \
      date -u -d "${existing_retry}" +%s 2>/dev/null || true)"
    if [[ -n "${existing_epoch}" ]] && (( now_epoch < existing_epoch )); then
      if [[ -z "${retry_after}" ]]; then
        retry_after="${existing_retry}"
        if [[ -z "${evidence_keep}" ]]; then
          evidence_keep="${agent_review_coderabbit_quota_cache_evidence_url:-}"
        fi
      else
        new_epoch="$(runner_exec_stdout "coderabbit quota mark_exhausted new epoch" -- \
          date -u -d "${retry_after}" +%s 2>/dev/null || true)"
        if [[ -z "${new_epoch}" ]] || (( new_epoch < existing_epoch )); then
          retry_after="${existing_retry}"
          if [[ -z "${evidence_keep}" ]]; then
            evidence_keep="${agent_review_coderabbit_quota_cache_evidence_url:-}"
          fi
        fi
      fi
    fi
  fi

  agent_review_coderabbit_quota_write_cache 1 observed "${reason}" '' '' \
    "${evidence_keep}" "${retry_after}"
}

agent_review_coderabbit_quota_mark_confirmed() {
  local -r reason="${1:-CodeRabbit comment today confirms usage is available.}"
  local -r evidence_url="${2:-}"

  agent_review_coderabbit_quota_write_cache 0 confirmed "${reason}" 1 '' "${evidence_url}"
}

# Drop same-day observed rate-limit exhaustion so a retry can run after retry_after.
agent_review_coderabbit_quota_clear_observed_cache() {
  local state_file today valid_date exhausted source
  local evidence_url retry_after checked_at reason confirmed probe_requested

  state_file="$(agent_review_coderabbit_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    # shellcheck disable=SC2034  # clear stale in-memory retry_after when cache file is gone
    agent_review_coderabbit_quota_cache_retry_after=''
    return 0
  fi
  today="$(agent_review_copilot_quota_local_day)"
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  source="${source:-cache}"
  if [[ "${valid_date}" == "${today}" && "${exhausted}" == '1' && "${source}" == 'observed' ]]; then
    rm -f "${state_file}"
    agent_review_coderabbit_quota_exhausted_today=0
    agent_review_coderabbit_quota_confirmed_today=0
    # shellcheck disable=SC2034  # cache metadata reset after clear (read by wait loop)
    agent_review_coderabbit_quota_cache_source=''
    # shellcheck disable=SC2034  # cache metadata reset after clear (read by wait loop)
    agent_review_coderabbit_quota_cache_reason=''
    # shellcheck disable=SC2034  # must clear in-memory retry_after or handle re-enters forever
    agent_review_coderabbit_quota_cache_retry_after=''
    # shellcheck disable=SC2034  # cache metadata reset after clear (read by wait loop)
    agent_review_coderabbit_quota_cache_evidence_url=''
  fi
}

# Probe open PR issue comments for CodeRabbit quota signals without requesting a review.
# Exit 0 when usage limit exhausted today, 1 when not exhausted (may still be unconfirmed).
# Prefer comment updatedAt (fall back to createdAt) for day filter and retry_after (issue #366).
agent_review_coderabbit_quota_probe_recent_comments() {
  local probe_json today repo pr at body reason retry_after profiles_dir coderabbit_profile

  agent_review_require_cmd gh
  agent_review_require_cmd jq
  today="$(agent_review_copilot_quota_local_day)"
  profiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/agent-review-profiles" && pwd)"
  coderabbit_profile="${profiles_dir}/coderabbit"
  probe_json="$(ar_runner_gh_api_stream "agent-review quota coderabbit probe graphql" graphql -f query='
query {
  viewer {
    pullRequests(first: 15, states: OPEN, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number
        repository { nameWithOwner }
        comments(last: 30) {
          nodes { author { login } body createdAt updatedAt }
        }
      }
    }
  }
}')"
  while IFS=$'\t' read -r repo pr at body login; do
    [[ -n "${at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${at}" "${today}"; then
      continue
    fi
    if agent_review_coderabbit_quota_issue_comment_is_exhausted "${login}" "${body}"; then
      reason="CodeRabbit comment on ${repo}#${pr} at ${at} reports usage limit reached."
      retry_after=''
      if [[ -f "${coderabbit_profile}" ]]; then
        retry_after="$(
          CODERABBIT_QUOTA_PROBE_BODY="${body}" CODERABBIT_QUOTA_PROBE_AT="${at}" \
            runner_sh_stdout "agent-review quota coderabbit retry_after" -- \
            "source '${coderabbit_profile}';
             agent_review_profile_text_quota_retry_after_iso \
               \"\${CODERABBIT_QUOTA_PROBE_BODY}\" \"\${CODERABBIT_QUOTA_PROBE_AT}\"" \
            2>/dev/null || true
        )"
      fi
      agent_review_coderabbit_quota_write_cache 1 probe_recent_comments "${reason}" '' '' '' "${retry_after}"
      return 0
    fi
  done < <(
    ar_runner_jq_file "agent-review quota coderabbit comments tsv" "${probe_json}" -r '
      [.data.viewer.pullRequests.nodes[]
        | . as $pr
        | .comments.nodes[]
        | select((.body // "") | length > 0)
        | {
            repo: $pr.repository.nameWithOwner,
            pr: ($pr.number | tostring),
            body: .body,
            at: (.updatedAt // .createdAt),
            login: (.author.login // "")
          }
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body, .login]
      | @tsv'
  )
  return 1
}

agent_review_coderabbit_quota_refresh_for_today() {
  if agent_review_coderabbit_quota_read_cache; then
    return 0
  fi
  agent_review_coderabbit_quota_probe_recent_comments || true
}

# Ordered agent ids for daily quota escalation (default: coderabbit,copilot,bugbot).
agent_review_quota_escalation_chain_raw() {
  local chain="${AGENT_REVIEW_QUOTA_FALLBACK_CHAIN:-}"

  if [[ -z "${chain}" ]]; then
    chain='coderabbit,copilot,bugbot'
  fi
  printf '%s' "${chain}"
}

# Only one agent is probed per PR head to conserve review quota.
agent_review_quota_escalation_agent_ids() {
  local chain remaining part trimmed

  chain="$(agent_review_quota_escalation_chain_raw)"
  remaining="${chain},"
  while [[ "${remaining}" == *,* ]]; do
    part="${remaining%%,*}"
    remaining="${remaining#*,}"
    trimmed="${part#"${part%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    if [[ -n "${trimmed}" ]]; then
      printf '%s\n' "${trimmed}"
    fi
  done
}

# Prints the next escalation agent after <from_agent>, or returns 1 when none remain.
agent_review_quota_escalation_next_agent() {
  local -r from_agent="$1"
  local found=0 agent

  [[ -n "${from_agent}" ]] || return 1
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if [[ "${found}" == '1' ]]; then
      printf '%s\n' "${agent}"
      return 0
    fi
    if [[ "${agent}" == "${from_agent}" ]]; then
      found=1
    fi
  done < <(agent_review_quota_escalation_agent_ids)
  return 1
}

# Pick the single agent to use for today's quota probe / reviews on this PR.
# Prefers the first confirmed agent in escalation order; otherwise the first agent
# that is not cached exhausted and has not already had an inconclusive manual probe.
agent_review_quota_probe_agent_for_today() {
  local agent

  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if agent_review_agent_quota_confirmed_for_agent "${agent}"; then
      printf '%s\n' "${agent}"
      return 0
    fi
  done < <(agent_review_quota_escalation_agent_ids)
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      continue
    fi
    if agent_review_agent_quota_probe_attempted_for_agent "${agent}" \
      && ! agent_review_agent_is_auto_review "${agent}"; then
      continue
    fi
    printf '%s\n' "${agent}"
    return 0
  done < <(agent_review_quota_escalation_agent_ids)
  return 1
}

# True when at least one agent is confirmed available today, or every agent is exhausted.
agent_review_daily_quota_probe_satisfied() {
  local agent any_confirmed=0 any_unresolved=0

  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    if agent_review_agent_quota_confirmed_for_agent "${agent}"; then
      any_confirmed=1
      continue
    fi
    if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
      continue
    fi
    any_unresolved=1
  done < <(agent_review_quota_escalation_agent_ids)
  if (( any_confirmed == 1 )); then
    return 0
  fi
  if (( any_unresolved == 0 )); then
    return 0
  fi
  return 1
}

# Ordered agent ids reported at the start of each review cycle.
agent_review_cycle_quota_agent_ids() {
  agent_review_quota_escalation_agent_ids
}

# Human-readable quota status for one agent. May expire a stale probe_requested
# wait (writes source=probe_expired) via probe_requested_for_agent / TTL checks.
agent_review_agent_quota_status_label() {
  local -r agent_id="$1"

  if agent_review_agent_quota_exhausted_for_agent "${agent_id}"; then
    printf 'exhausted (will not request)\n'
    return 0
  fi
  if agent_review_agent_quota_confirmed_for_agent "${agent_id}"; then
    if [[ "${agent_id}" == 'coderabbit' ]]; then
      printf 'available (auto-review; no manual request)\n'
    else
      printf 'available\n'
    fi
    return 0
  fi
  if [[ "${agent_id}" == 'coderabbit' ]]; then
    printf 'unconfirmed (auto-review; no manual request)\n'
    return 0
  fi
  if agent_review_agent_quota_probe_requested_for_agent "${agent_id}"; then
    printf 'probe requested (awaiting review; TTL %ss)\n' "$(agent_review_probe_requested_ttl_s)"
    return 0
  fi
  if agent_review_agent_quota_probe_expired_for_agent "${agent_id}"; then
    printf 'probe expired (no review within TTL; will not re-request today)\n'
    return 0
  fi
  printf 'unconfirmed (will request to probe)\n'
}

# Log Copilot, Bugbot, and CodeRabbit quota status once at loop start / cycle preamble.
agent_review_log_cycle_quota_preamble() {
  local agent status

  printf '==> Agent review quota (local day %s):\n' \
    "$(agent_review_copilot_quota_local_day)" >&2
  while IFS= read -r agent || [[ -n "${agent}" ]]; do
    [[ -z "${agent}" ]] && continue
    status="$(agent_review_agent_quota_status_label "${agent}")"
    printf '    %s: %s' "${agent}" "${status}" >&2
  done < <(agent_review_cycle_quota_agent_ids)
}

# True when <agent_id> daily quota cache reports a manual probe request was sent today
# and the wait has not yet expired (AGENT_REVIEW_PROBE_REQUESTED_TTL).
agent_review_agent_quota_probe_requested_for_agent() {
  local -r agent_id="$1"

  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      agent_review_copilot_quota_expire_stale_probe_requested || true
      [[ "${agent_review_copilot_quota_probe_requested_today:-0}" == '1' ]]
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      agent_review_bugbot_quota_expire_stale_probe_requested || true
      [[ "${agent_review_bugbot_quota_probe_requested_today:-0}" == '1' ]]
      ;;
    coderabbit)
      agent_review_coderabbit_quota_refresh_for_today
      [[ "${agent_review_coderabbit_quota_probe_requested_today:-0}" == '1' ]]
      ;;
    *) return 1 ;;
  esac
}

# True when a nudge/probe was attempted today (active wait, expired wait, or probe_attempted).
# Used so quota fallback does not re-request the same agent after TTL expiry (#408).
# This is a per-day host-wide signal (same as other quota caches): a probe on PR A
# blocks re-probing that agent on PR B until the local calendar day rolls.
agent_review_agent_quota_probe_attempted_for_agent() {
  local -r agent_id="$1"

  if agent_review_agent_quota_probe_requested_for_agent "${agent_id}"; then
    return 0
  fi
  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      [[ "${agent_review_copilot_quota_probe_attempted_today:-0}" == '1' \
        || "${agent_review_copilot_quota_cache_source:-}" == 'probe_expired' ]]
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      [[ "${agent_review_bugbot_quota_probe_attempted_today:-0}" == '1' \
        || "${agent_review_bugbot_quota_cache_source:-}" == 'probe_expired' ]]
      ;;
    coderabbit)
      agent_review_agent_quota_probe_requested_for_agent coderabbit
      ;;
    *) return 1 ;;
  esac
}

# True when today's probe_requested wait expired without a review (source=probe_expired).
agent_review_agent_quota_probe_expired_for_agent() {
  local -r agent_id="$1"

  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      [[ "${agent_review_copilot_quota_cache_source:-}" == 'probe_expired' ]]
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      [[ "${agent_review_bugbot_quota_cache_source:-}" == 'probe_expired' ]]
      ;;
    *) return 1 ;;
  esac
}

# True when <agent_id> daily quota cache reports confirmed availability today.
agent_review_agent_quota_confirmed_for_agent() {
  local -r agent_id="$1"

  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      [[ "${agent_review_copilot_quota_confirmed_today:-0}" == '1' ]]
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      [[ "${agent_review_bugbot_quota_confirmed_today:-0}" == '1' ]]
      ;;
    coderabbit)
      agent_review_coderabbit_quota_refresh_for_today
      [[ "${agent_review_coderabbit_quota_confirmed_today:-0}" == '1' ]]
      ;;
    *) return 1 ;;
  esac
}

# Prints the cached reason string for <agent_id> today (may be empty).
agent_review_agent_quota_cache_reason_for_agent() {
  local -r agent_id="$1"

  case "${agent_id}" in
    copilot)
      agent_review_copilot_quota_refresh_for_today
      printf '%s' "${agent_review_copilot_quota_cache_reason:-}"
      ;;
    bugbot)
      agent_review_bugbot_quota_refresh_for_today
      printf '%s' "${agent_review_bugbot_quota_cache_reason:-}"
      ;;
    coderabbit)
      agent_review_coderabbit_quota_refresh_for_today
      printf '%s' "${agent_review_coderabbit_quota_cache_reason:-}"
      ;;
    *) return 1 ;;
  esac
}

