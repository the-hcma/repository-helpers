# Drop same-day observed exhaustion when posting a fresh Bugbot request so a new
# run can proceed after a stale pre-request signal was cached.
agent_review_bugbot_quota_clear_observed_cache() {
  local state_file today valid_date exhausted source

  state_file="$(agent_review_bugbot_quota_state_file)"
  if [[ ! -f "${state_file}" ]]; then
    return 0
  fi
  today="$(agent_review_copilot_quota_local_day)"
  # shellcheck disable=SC1090  # scratch cache path is operator-local runtime state
  source "${state_file}"
  valid_date="${valid_date:-}"
  exhausted="${exhausted:-0}"
  source="${source:-cache}"
  if [[ "${valid_date}" == "${today}" && "${exhausted}" == '1' && "${source}" == 'observed' ]]; then
    rm -f "${state_file}"
    agent_review_bugbot_quota_exhausted_today=0
    agent_review_bugbot_quota_cache_source=''
    agent_review_bugbot_quota_cache_reason=''
  fi
}

agent_review_bugbot_quota_mark_available() {
  agent_review_bugbot_quota_write_cache 0 probe 'Recent Bugbot checks show usage is available.'
}

# Probe open PRs for Bugbot PR comments, reviews, and head checks without requesting a new review.
# Exit 0 when usage limit exhausted today, 1 when available/unknown (not exhausted).
agent_review_bugbot_quota_probe_recent_signals() {
  local probe_json today repo pr at body head run_json reason lib_dir found_today found_available

  agent_review_require_cmd gh
  agent_review_require_cmd jq
  lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  today="$(agent_review_copilot_quota_local_day)"
  found_today=0
  found_available=0
  probe_json="$(gh api graphql -f query='
query {
  viewer {
    pullRequests(first: 15, states: OPEN, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number
        repository { nameWithOwner }
        headRefOid
        comments(last: 30) {
          nodes { author { login } body createdAt }
        }
        reviews(last: 8) {
          nodes { author { login } body submittedAt }
        }
      }
    }
  }
}')"
  while IFS=$'\t' read -r repo pr at body; do
    [[ -n "${at}" ]] || continue
    if ! agent_review_quota_timestamp_on_local_day "${at}" "${today}"; then
      continue
    fi
    found_today=1
    if agent_review_bugbot_quota_text_is_exhausted "${body}"; then
      reason="Bugbot comment on ${repo}#${pr} at ${at} reports usage limit reached."
      agent_review_bugbot_quota_write_cache 1 probe_recent_comments "${reason}"
      return 0
    fi
    found_available=1
  done < <(
    printf '%s' "${probe_json}" | jq -r '
      [.data.viewer.pullRequests.nodes[]
        | . as $pr
        | [
            ($pr.comments.nodes[]
              | {
                  repo: $pr.repository.nameWithOwner,
                  pr: ($pr.number | tostring),
                  body: .body,
                  at: .createdAt,
                  login: (.author.login // "")
                }),
            ($pr.reviews.nodes[]
              | {
                  repo: $pr.repository.nameWithOwner,
                  pr: ($pr.number | tostring),
                  body: .body,
                  at: .submittedAt,
                  login: (.author.login // "")
                })
          ]
        | .[]
        | select(.login | test("cursor";"i"))
        | select((.body // "") | length > 0)
      ]
      | sort_by(.at)
      | .[]
      | [.repo, .pr, .at, .body]
      | @tsv'
  )
  while IFS=$'\t' read -r repo head; do
    [[ -n "${head}" ]] || continue
    run_json="$(BUGBOT_PROBE_REPO="${repo}" BUGBOT_PROBE_HEAD="${head}" BUGBOT_LIB="${lib_dir}" bash -c '
      source "${BUGBOT_LIB}/agent-review"
      agent_review_use_agent bugbot
      agent_review_head_check_run_json_for_head "${BUGBOT_PROBE_REPO}" "${BUGBOT_PROBE_HEAD}"
    ' 2>/dev/null || true)"
    if [[ -z "${run_json}" || "${run_json}" == 'null' ]]; then
      continue
    fi
    if ! agent_review_quota_timestamp_on_local_day \
        "$(printf '%s' "${run_json}" | jq -r '.started_at // ""')" "${today}" \
      && ! agent_review_quota_timestamp_on_local_day \
        "$(printf '%s' "${run_json}" | jq -r '.completed_at // ""')" "${today}"; then
      continue
    fi
    found_today=1
    if agent_review_bugbot_quota_check_run_is_exhausted "${run_json}"; then
      reason="Bugbot check on ${repo} head ${head:0:7} reports usage limit reached."
      agent_review_bugbot_quota_write_cache 1 probe_head_checks "${reason}"
      return 0
    fi
    if agent_review_bugbot_quota_check_run_is_available "${run_json}"; then
      found_available=1
    fi
  done < <(
    printf '%s' "${probe_json}" | jq -r '
      .data.viewer.pullRequests.nodes[]
      | "\(.repository.nameWithOwner)\t\(.headRefOid)"'
  )
  if [[ "${found_available}" == '1' ]]; then
    agent_review_bugbot_quota_mark_available
    return 1
  fi
  if [[ "${found_today}" == '1' ]]; then
    agent_review_bugbot_quota_mark_available
    return 1
  fi
  agent_review_bugbot_quota_write_cache 0 probe 'No Bugbot signals found for today on open PRs.'
  return 1
}

