#!/usr/bin/env bash
# Shared sendmail wrapper for scripts/*.
set -euo pipefail

if declare -F repo_helpers_sendmail >/dev/null 2>&1; then
  return 0
fi

_sendmail_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _sendmail_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_sendmail_lib_dir}/runner-ensure"

# repo_helpers_sendmail <from_addr>
# Reads an RFC-822 email from stdin and sends it via sendmail.
#
# Stdin is copied to a temp file first, then fed to sendmail via an explicit
# redirect inside the runner command. Do not rely on pipeline stdin reaching a
# backgrounded runner_exec child — that coupling is fragile (same class of bug
# as notifier HTML escape via runner here-string).
#
# Test-mode (never invoke real MTA):
#   REPO_HELPERS_TEST_MODE=1
# Optional breadcrumb:
#   REPO_HELPERS_SENDMAIL_BREADCRUMB=/path/to/file
repo_helpers_sendmail() {
  local -r from_addr="$1"
  local msg_file exit_code

  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' ]]; then
    if [[ -n "${REPO_HELPERS_SENDMAIL_BREADCRUMB:-}" ]]; then
      : >"${REPO_HELPERS_SENDMAIL_BREADCRUMB}"
    fi
    cat >/dev/null
    return 0
  fi

  msg_file="$(mktemp)"
  exit_code=0
  if ! cat >"$msg_file"; then
    rm -f "$msg_file"
    return 1
  fi

  # bash -c keeps the <file redirect on sendmail after runner_exec backgrounds.
  runner_exec "sendmail deliver" -- \
    bash -c 'sendmail -t -oi -f "$1" <"$2"' bash "$from_addr" "$msg_file" \
    || exit_code=$?
  rm -f "$msg_file"
  return "$exit_code"
}
