          # Skip when the PR is already merged — a stack rebase can push a commit to the
          # next branch after a merge lands, which would otherwise trigger a redundant CI
          # run on an already-validated diff.
          if [[ -n "${PR_NUMBER}" ]]; then
            state=$(gh pr view "${PR_NUMBER}" --repo "${REPOSITORY}" --json state -q .state 2>/dev/null || true)
            if [[ "${state}" == "MERGED" ]]; then
              echo "skip=true" >> "$GITHUB_OUTPUT"
              exit 0
            fi
          fi
