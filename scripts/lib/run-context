# shellcheck shell=bash
# run-context — unified run footer for scheduled checker email reports.

if declare -F repo_helpers_run_context_host >/dev/null 2>&1; then
  return 0
fi

_rc_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _rc_lib_dir
# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_rc_lib_dir}/runner-ensure"

# rc_runner_exec_stdout <label> -- <cmd> [args…]
rc_runner_exec_stdout() {
  local -r label="$1"
  shift
  runner_exec_stdout "$label" "$@"
}

# rc_runner_git_rev_parse <label> <repo_dir>
rc_runner_git_rev_parse() {
  local -r label="$1"
  local -r repo_dir="$2"
  local exit_code

  exit_code=0
  rc_runner_exec_stdout "$label" -- git -C "$repo_dir" rev-parse HEAD 2>/dev/null \
    || exit_code=$?
  return "$exit_code"
}

repo_helpers_run_context_host() {
  hostname -s 2>/dev/null || hostname 2>/dev/null || printf 'unknown'
}

repo_helpers_run_context_user() {
  id -un 2>/dev/null || printf '?'
}

# repo_helpers_run_context_commit <workdir>
# Prints HEAD commit (DEPLOYED_COMMIT when set, else git rev-parse).
repo_helpers_run_context_commit() {
  local -r workdir="${1:-}"
  if [[ -n "${DEPLOYED_COMMIT:-}" ]]; then
    printf '%s' "${DEPLOYED_COMMIT}"
    return 0
  fi
  if [[ -n "$workdir" ]] \
    && rc_runner_git_rev_parse "run-context git rev-parse HEAD probe" "$workdir" >/dev/null 2>&1; then
    rc_runner_git_rev_parse "run-context git rev-parse HEAD" "$workdir"
    return 0
  fi
  return 1
}

# repo_helpers_run_context_footer <command-line> [separator]
# Legacy footer (host, user, command). Prefer repo_helpers_run_context_footer_full.
repo_helpers_run_context_footer() {
  local -r cmd_line="$1"
  local separator
  if [[ -n "${2:-}" ]]; then
    separator="$2"
  else
    separator='----------------------------------------------------------------'
  fi
  local host user

  host="$(repo_helpers_run_context_host)"
  user="$(repo_helpers_run_context_user)"

  printf '\n'
  printf '%s\n' "$separator"
  printf 'Run context:\n'
  printf 'Host:    %s\n' "$host"
  printf 'User:    %s\n' "$user"
  printf 'Command: %s\n' "$cmd_line"
}

# repo_helpers_run_context_footer_full <command> <workdir> <started> <finished> <logfile> [separator]
# Prints the unified trailing Run context block for checker emails.
repo_helpers_run_context_footer_full() {
  local -r cmd_line="$1"
  local -r workdir="$2"
  local -r started_at="$3"
  local -r finished_at="$4"
  local -r log_file="$5"
  local separator
  if [[ -n "${6:-}" ]]; then
    separator="$6"
  else
    separator='────────────────────────────────────────────────────────────────'
  fi
  local commit

  commit="$(repo_helpers_run_context_commit "$workdir" 2>/dev/null || true)"

  printf '\n'
  printf '%s\n' "$separator"
  printf 'Run context:\n'
  printf 'Host:     %s\n' "$(repo_helpers_run_context_host)"
  printf 'User:     %s\n' "$(repo_helpers_run_context_user)"
  printf 'Workdir:  %s\n' "$workdir"
  printf 'Command:  %s\n' "$cmd_line"
  if [[ -n "$commit" ]]; then
    printf 'Commit:   %s\n' "$commit"
  fi
  printf 'Started:  %s\n' "$started_at"
  printf 'Finished: %s\n' "$finished_at"
  printf 'Log file: %s\n' "$log_file"
}
