# shellcheck shell=bash
# gnu-sed — resolve GNU sed and perform in-place edits.
#
# macOS /usr/bin/sed is BSD; Homebrew installs GNU sed as gsed. Linux sed is
# typically GNU. Scripts that use sed -i must go through this module.
#
# Defines:
#   tooling_prereq_sed_is_gnu
#   tooling_prereq_gnu_sed_path
#   tooling_prereq_check_gnu_sed
#   gnu_sed_inplace

if declare -F gnu_sed_inplace >/dev/null 2>&1; then
  return 0
fi

_gs_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _gs_lib_dir
# shellcheck disable=SC1091
source "${_gs_lib_dir}/tooling-prereqs"

# tooling_prereq_sed_is_gnu <sed_binary>
# Returns 0 when the binary reports GNU sed.
tooling_prereq_sed_is_gnu() {
  local -r sed_bin="$1"

  [[ -n "$sed_bin" && -x "$sed_bin" ]] || return 1
  "$sed_bin" --version 2>/dev/null | grep -q GNU
}

# tooling_prereq_gnu_sed_path
# Prints absolute path to GNU sed (gsed on macOS, or GNU sed). Returns 1 when missing.
tooling_prereq_gnu_sed_path() {
  local path

  path="$(tooling_prereq_tool_path gsed)"
  if [[ -n "$path" ]] && tooling_prereq_sed_is_gnu "$path"; then
    printf '%s' "$path"
    return 0
  fi

  path="$(tooling_prereq_tool_path sed)"
  if [[ -n "$path" ]] && tooling_prereq_sed_is_gnu "$path"; then
    printf '%s' "$path"
    return 0
  fi

  return 1
}

# tooling_prereq_check_gnu_sed
# Logs status and returns 1 when GNU sed is not available.
tooling_prereq_check_gnu_sed() {
  local path version

  tooling_prereq_emit "[gnu sed]"
  if path="$(tooling_prereq_gnu_sed_path)"; then
    version="$("$path" --version 2>/dev/null | head -1 || echo '?')"
    tooling_prereq_emit "  gnu sed: ${path} (${version})"
    return 0
  fi

  if [[ "$(uname -s)" == Darwin ]]; then
    tooling_prereq_emit "  ERROR: GNU sed (gsed) is required on macOS for in-place edits."
    tooling_prereq_emit "         BSD /usr/bin/sed is not supported."
    tooling_prereq_emit "         Install: brew install gnu-sed"
  else
    tooling_prereq_emit "  ERROR: GNU sed is required (sed --version must report GNU)."
    tooling_prereq_emit "         On macOS: brew install gnu-sed"
  fi
  return 1
}

# gnu_sed_inplace [-E] [-e script]… <file>…
# In-place edit using GNU sed. All arguments after optional leading -E are passed
# to sed after -i [-E].
gnu_sed_inplace() {
  local gsed_bin extended=()

  gsed_bin="$(tooling_prereq_gnu_sed_path)" || return 1
  if [[ "${1:-}" == '-E' ]]; then
    extended=(-E)
    shift
  fi
  "$gsed_bin" -i "${extended[@]}" "$@"
}
