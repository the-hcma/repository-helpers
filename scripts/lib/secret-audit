# shellcheck shell=bash
#
# secret-audit — TruffleHog wrapper, marker schema, and scan helpers (#509).
#
# Deep-scans full git history (not PR diffs). Complements gitleaks in
# scripts/lib/ci-secret-scan. See docs/secret-audit-trufflehog.md.

if declare -F secret_audit_marker_path >/dev/null 2>&1; then
  return 0
fi

_secret_audit_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _secret_audit_lib_dir

# shellcheck disable=SC1091  # runner-ensure loads scripts/lib/runner at runtime
source "${_secret_audit_lib_dir}/runner-ensure"

# shellcheck source=scripts/lib/time-log
# shellcheck disable=SC1091
source "${_secret_audit_lib_dir}/time-log"

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_marker_relpath='.github/secret-audit.json'
readonly secret_audit_marker_relpath

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_marker_status_clean='clean'
readonly secret_audit_marker_status_clean

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_scanner_name='trufflehog'
readonly secret_audit_scanner_name

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_default_results_filter='verified'
# shellcheck disable=SC2034
readonly secret_audit_default_results_filter

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_marker_stale_days=90
# shellcheck disable=SC2034
readonly secret_audit_marker_stale_days

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_tool_name='repository-helpers/secret-audit'
# shellcheck disable=SC2034
readonly secret_audit_tool_name

# TruffleHog --fail exits 183 when matching --results are found.
# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_trufflehog_leak_exit=183
# shellcheck disable=SC2034
readonly secret_audit_trufflehog_leak_exit

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_trufflehog_version='3.97.0'
readonly secret_audit_trufflehog_version

# shellcheck disable=SC2034  # sourced by scripts/tests/lint
secret_audit_trufflehog_download_retries=3
readonly secret_audit_trufflehog_download_retries

secret_audit_die() {
  printf 'ERROR: secret-audit: %s\n' "$*" >&2
  exit 1
}

secret_audit_jq_stdout() {
  local -r label="$1"
  shift
  runner_exec_stdout "$label" -- jq "$@"
}

secret_audit_marker_path() {
  local -r repo_dir="$1"
  printf '%s/%s' "$repo_dir" "$secret_audit_marker_relpath"
}

secret_audit_trufflehog_release_os() {
  local os
  os="$(uname -s)"
  case "$os" in
    Linux) printf '%s\n' 'linux' ;;
    Darwin) printf '%s\n' 'darwin' ;;
    *)
      printf 'ERROR: unsupported OS for trufflehog: %s\n' "$os" >&2
      return 1
      ;;
  esac
}

secret_audit_trufflehog_arch() {
  local arch
  arch="$(uname -m)"
  case "$arch" in
    x86_64) printf '%s\n' 'amd64' ;;
    aarch64 | arm64) printf '%s\n' 'arm64' ;;
    *)
      printf 'ERROR: unsupported architecture for trufflehog: %s\n' "$arch" >&2
      return 1
      ;;
  esac
}

# Prints installed TruffleHog semver (no leading v).
secret_audit_trufflehog_installed_version() {
  local bin="${1:-trufflehog}"
  local version_line version resolved

  resolved="$bin"
  if [[ "$bin" == 'trufflehog' ]]; then
    resolved="$(command -v trufflehog 2>/dev/null || true)"
  fi
  if [[ -z "$resolved" || ! -x "$resolved" ]]; then
    return 1
  fi
  version_line="$(runner_exec_stdout "secret-audit trufflehog --version" -- \
    "$resolved" --version 2>/dev/null || true)"
  version="${version_line##* }"
  version="${version#v}"
  if [[ -z "$version" ]]; then
    return 1
  fi
  printf '%s\n' "$version"
}

# Prints the in-repo SHA-256 for a TruffleHog release asset, or fails when the
# pin is missing (bump secret_audit_trufflehog_version and these digests together).
# Do not download a release checksum manifest from the same mutable host as the
# tarball.
secret_audit_trufflehog_pinned_sha256() {
  local -r version="$1"
  local -r os="$2"
  local -r arch="$3"
  local asset_name

  asset_name="trufflehog_${version}_${os}_${arch}.tar.gz"
  case "$asset_name" in
    trufflehog_3.97.0_darwin_amd64.tar.gz)
      printf '%s\n' '037e4aeb197870555ff515432bb5f1f2c98dce5f1214631a689112b5e0e4c9fd'
      ;;
    trufflehog_3.97.0_darwin_arm64.tar.gz)
      printf '%s\n' 'ad0a99bd48d6df80eabab24d11d0fd771e245fc55ed347f943cafb5e5f497c5c'
      ;;
    trufflehog_3.97.0_linux_amd64.tar.gz)
      printf '%s\n' '62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4'
      ;;
    trufflehog_3.97.0_linux_arm64.tar.gz)
      printf '%s\n' 'f48f57e3d4343377865b1b64653f96d381d61a7792d89d026e85524732039fde'
      ;;
    *)
      printf 'ERROR: SECRET_AUDIT_SCAN_FAILED no in-repo SHA-256 pin for %s\n' \
        "$asset_name" >&2
      return 1
      ;;
  esac
}

secret_audit_trufflehog_verify_tarball_sha256() {
  local -r tarball="$1"
  local -r version="$2"
  local -r os="$3"
  local -r arch="$4"
  local expected actual

  expected="$(secret_audit_trufflehog_pinned_sha256 "$version" "$os" "$arch")" || return 1
  # GNU sha256sum (Homebrew coreutils gnubin on Darwin via tooling_path_ensure_gnu_userland).
  if ! command -v sha256sum >/dev/null 2>&1; then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED sha256sum required (GNU coreutils; run tooling_path_ensure_gnu_userland)\n' >&2
    return 1
  fi
  actual="$(runner_exec_stdout "secret-audit sha256sum tarball" -- sha256sum "$tarball" | awk '{ print $1 }')"
  if [[ "$actual" != "$expected" ]]; then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED trufflehog checksum mismatch (want=%s got=%s)\n' \
      "$expected" "$actual" >&2
    return 1
  fi
  return 0
}

secret_audit_install_trufflehog() {
  local arch os version url tmpdir tarball dest_dir attempt http_code bin_path installed_version gzip_ok

  version="${TRUFFLEHOG_VERSION:-$secret_audit_trufflehog_version}"
  if bin_path="$(command -v trufflehog 2>/dev/null || true)" \
    && [[ -n "$bin_path" ]]; then
    installed_version="$(secret_audit_trufflehog_installed_version "$bin_path" || true)"
    if [[ "$installed_version" == "$version" ]]; then
      return 0
    fi
  fi

  os="$(secret_audit_trufflehog_release_os)"
  arch="$(secret_audit_trufflehog_arch)"
  url="https://github.com/trufflesecurity/trufflehog/releases/download/v${version}/trufflehog_${version}_${os}_${arch}.tar.gz"
  tmpdir="$(runner_exec_stdout "secret-audit mktemp -d" -- mktemp -d)"
  tarball="${tmpdir}/trufflehog.tar.gz"
  dest_dir="${SECRET_AUDIT_BIN_DIR:-${HOME}/.cache/repository-helpers/bin}"

  for attempt in $(seq 1 "$secret_audit_trufflehog_download_retries"); do
    http_code=''
    http_code="$(runner_exec_stdout "secret-audit curl trufflehog release" -- curl -fSL --retry 2 --retry-delay 1 -o "$tarball" -w '%{http_code}' "$url" 2>/dev/null || true)"
    gzip_ok=0
    # shellcheck disable=SC2016  # bash -c program uses positional $1 from argv
    if runner_exec "secret-audit file gzip probe" --probe -- \
      bash -c 'file -b "$1" | grep -qi gzip' _ "$tarball"; then
      gzip_ok=1
    fi
    if [[ "$http_code" == '200' ]] \
      && [[ -s "$tarball" ]] \
      && secret_audit_trufflehog_verify_tarball_sha256 "$tarball" "$version" "$os" "$arch" \
      && [[ "$gzip_ok" -eq 1 ]] \
      && runner_exec "secret-audit tar list trufflehog" --probe -- tar -tzf "$tarball" trufflehog >/dev/null; then
      runner_exec "secret-audit tar extract trufflehog" -- tar -xzf "$tarball" -C "$tmpdir" trufflehog
      runner_exec "secret-audit mkdir bin dir" -- mkdir -p "$dest_dir"
      runner_exec "secret-audit install trufflehog" -- install -m 0755 "${tmpdir}/trufflehog" "${dest_dir}/trufflehog"
      PATH="${dest_dir}:${PATH}"
      export PATH
      runner_exec "secret-audit rm tmpdir" -- rm -rf "$tmpdir"
      return 0
    fi
    runner_exec "secret-audit rm tarball" --probe -- rm -f "$tarball" || true
    if (( attempt < secret_audit_trufflehog_download_retries )); then
      sleep $((attempt * 2))
    fi
  done

  runner_exec "secret-audit rm tmpdir fail" --probe -- rm -rf "$tmpdir" || true
  printf 'ERROR: SECRET_AUDIT_SCAN_FAILED trufflehog download failed after %s attempts (url=%s)\n' \
    "$secret_audit_trufflehog_download_retries" "$url" >&2
  return 1
}

secret_audit_ensure_full_clone() {
  local -r repo_dir="$1"
  local is_shallow

  is_shallow="$(runner_exec_stdout "secret-audit git is-shallow" -- git -C "$repo_dir" rev-parse --is-shallow-repository 2>/dev/null || printf 'false')"
  if [[ "$is_shallow" == 'true' ]]; then
    run_command "secret-audit git fetch --unshallow" --timeout 600 \
      -- git -C "$repo_dir" fetch --unshallow origin
  fi
  run_command "secret-audit git fetch --prune" --timeout 120 \
    -- git -C "$repo_dir" fetch --prune origin
}

# shellcheck disable=SC2016  # jq programs use single-quoted JSON filters
secret_audit_build_marker_json() {
  local -r git_tip="$1"
  local -r results_filter="$2"
  local -r scanner_version="$3"
  local scanned_at

  scanned_at="$(time_log_date_utc '%Y-%m-%dT%H:%M:%SZ')"
  secret_audit_jq_stdout "secret-audit jq build marker" -nc \
    --arg status "$secret_audit_marker_status_clean" \
    --arg scanned_at "$scanned_at" \
    --arg scanner "$secret_audit_scanner_name" \
    --arg scanner_version "$scanner_version" \
    --arg git_tip "$git_tip" \
    --arg results_filter "$results_filter" \
    --arg tool "$secret_audit_tool_name" \
    '{
      status: $status,
      scanned_at: $scanned_at,
      scanner: $scanner,
      scanner_version: $scanner_version,
      git_tip: $git_tip,
      results_filter: $results_filter,
      tool: $tool
    }'
}

# Prints validation error on stderr; exit 0 when valid and not stale.
# shellcheck disable=SC2016  # jq programs use single-quoted JSON filters
secret_audit_validate_marker_json() {
  local -r json_text="$1"
  local status scanner git_tip scanned_at age_days now_epoch scanned_epoch tip_len
  local jq_rc field value

  jq_rc=0
  # Require a JSON object: valid non-objects ([], 123, "x", null) must not reach
  # field indexing under set -e (would abort github-repo-lint --all).
  secret_audit_jq_stdout "secret-audit jq parse marker" -e -n --argjson doc "$json_text" \
    '$doc | type == "object"' >/dev/null 2>&1 || jq_rc=$?
  if (( jq_rc != 0 )); then
    printf 'marker must be a JSON object\n' >&2
    return 1
  fi

  status="$(secret_audit_jq_stdout "secret-audit jq marker status" -r -n \
    --argjson doc "$json_text" '$doc.status // empty')"
  if [[ "$status" != "$secret_audit_marker_status_clean" ]]; then
    printf 'marker status must be %s (got %s)\n' \
      "$secret_audit_marker_status_clean" "$status" >&2
    return 1
  fi

  scanner="$(secret_audit_jq_stdout "secret-audit jq marker scanner" -r -n \
    --argjson doc "$json_text" '$doc.scanner // empty')"
  if [[ "$scanner" != "$secret_audit_scanner_name" ]]; then
    printf 'marker scanner must be %s\n' "$secret_audit_scanner_name" >&2
    return 1
  fi

  for field in scanned_at scanner_version git_tip results_filter tool; do
    value="$(secret_audit_jq_stdout "secret-audit jq marker field ${field}" -r -n \
      --argjson doc "$json_text" --arg f "$field" '$doc[$f] // empty')"
    if [[ -z "$value" ]]; then
      printf 'marker missing required field: %s\n' "$field" >&2
      return 1
    fi
  done

  git_tip="$(secret_audit_jq_stdout "secret-audit jq marker git_tip" -r -n \
    --argjson doc "$json_text" '$doc.git_tip')"
  tip_len="${#git_tip}"
  if (( tip_len < 7 || tip_len > 64 )); then
    printf 'marker git_tip looks invalid\n' >&2
    return 1
  fi

  scanned_at="$(secret_audit_jq_stdout "secret-audit jq marker scanned_at" -r -n \
    --argjson doc "$json_text" '$doc.scanned_at')"
  scanned_epoch="$(time_log_iso8601_utc_to_epoch "$scanned_at" || true)"
  if [[ -z "$scanned_epoch" ]]; then
    printf 'marker scanned_at is not ISO-8601 UTC\n' >&2
    return 1
  fi

  now_epoch="$(time_log_now_utc_epoch)"
  # Compare epochs directly — bash integer day division truncates toward zero, so
  # scanned_at up to ~24h ahead would otherwise yield age_days=0 and pass.
  if (( scanned_epoch > now_epoch )); then
    printf 'marker scanned_at is in the future\n' >&2
    return 1
  fi
  age_days=$(( (now_epoch - scanned_epoch) / 86400 ))
  if (( age_days > secret_audit_marker_stale_days )); then
    printf 'marker scanned_at is older than %s days\n' "$secret_audit_marker_stale_days" >&2
    return 1
  fi

  return 0
}

secret_audit_write_marker() {
  local -r repo_dir="$1"
  local -r git_tip="$2"
  local -r results_filter="$3"
  local marker_path scanner_version json_text marker_dir

  scanner_version="$(secret_audit_trufflehog_installed_version trufflehog \
    || printf '%s' "$secret_audit_trufflehog_version")"
  json_text="$(secret_audit_build_marker_json "$git_tip" "$results_filter" "$scanner_version")"
  if ! secret_audit_validate_marker_json "$json_text"; then
    secret_audit_die 'internal error: built marker failed validation'
  fi

  marker_path="$(secret_audit_marker_path "$repo_dir")"
  marker_dir="$(dirname "$marker_path")"
  mkdir -p "$marker_dir"
  printf '%s\n' "$json_text" >"$marker_path"
}

secret_audit_print_leak_mitigation() {
  local -r slug="${1:-}"

  printf '\n' >&2
  printf 'ERROR: SECRET_AUDIT_LEAK trufflehog reported matching credentials\n' >&2
  printf '\n' >&2
  printf 'Deep scans walk full git history. Assume any reported credential is compromised.\n' >&2
  printf '\n' >&2
  printf 'Mitigation (complete all steps):\n' >&2
  printf '  1. Revoke and rotate every credential trufflehog reported.\n' >&2
  printf '  2. Do not write or refresh a clean intake marker until the repo is clean.\n' >&2
  printf '  3. Remove secrets from the working tree; never recommit the same material.\n' >&2
  printf '  4. Coordinate history rewrite (filter-repo) only with org owners — never auto-purge.\n' >&2
  if [[ -n "$slug" ]]; then
    printf '  5. Re-run: scripts/secret-audit --repo %s\n' "$slug" >&2
  else
    printf '  5. Re-run: scripts/secret-audit --repo OWNER/NAME\n' >&2
  fi
  printf '\n' >&2
  printf 'Prevention: enable GitHub push protection; use scripts/dev/secret-scan before push.\n' >&2
  printf 'See docs/secret-audit-trufflehog.md for TruffleHog vs gitleaks roles.\n' >&2
  printf '\n' >&2
}

# Resolve a GitHub token for trufflehog github scans. Prefer GH_TOKEN/GITHUB_TOKEN.
# Never capture `gh auth token` via runner_exec_stdout (session stdout would persist the PAT).
secret_audit_resolve_github_token() {
  local token tmp

  token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if [[ -n "$token" ]]; then
    printf '%s\n' "$token"
    return 0
  fi
  tmp="$(runner_exec_stdout "secret-audit mktemp token" -- \
    mktemp "${TMPDIR:-/tmp}/secret-audit-token.XXXXXX")" || return 1
  if ! runner_exec "secret-audit chmod token file" -- chmod 600 "$tmp"; then
    runner_exec "secret-audit rm token file" --probe -- rm -f "$tmp" || true
    return 1
  fi
  # shellcheck disable=SC2016  # bash -c program uses positional $1 from argv
  if ! runner_exec "secret-audit gh auth token" --probe -- \
    bash -c 'gh auth token >"$1"' _ "$tmp" \
    || [[ ! -s "$tmp" ]]; then
    runner_exec "secret-audit rm token file" --probe -- rm -f "$tmp" || true
    return 1
  fi
  # Builtin file read — do not cat via runner_exec_stdout (would persist the PAT).
  token="$(<"$tmp")"
  runner_exec "secret-audit rm token file" --probe -- rm -f "$tmp" || true
  if [[ -z "$token" ]]; then
    return 1
  fi
  printf '%s\n' "$token"
}

secret_audit_run_git_scan() {
  local -r repo_dir="$1"
  local -r results_filter="$2"
  local scan_rc file_url

  file_url="file://${repo_dir}"
  scan_rc=0
  run_command "secret-audit trufflehog git scan" --timeout 3600 \
    -- trufflehog --no-update git "$file_url" \
      --results="$results_filter" \
      --fail || scan_rc=$?

  if (( scan_rc == secret_audit_trufflehog_leak_exit )); then
    secret_audit_print_leak_mitigation ""
  elif (( scan_rc != 0 )); then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED exit=%s\n' "$scan_rc" >&2
  fi
  return "$scan_rc"
}

secret_audit_run_github_repo_scan() {
  local -r slug="$1"
  local -r results_filter="$2"
  local token scan_rc

  token="$(secret_audit_resolve_github_token || true)"
  if [[ -z "$token" ]]; then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED missing GH token for trufflehog github scan\n' >&2
    return 2
  fi

  scan_rc=0
  # Token via env (GITHUB_TOKEN) — never argv (runner session cmdline / ps).
  GITHUB_TOKEN="$token" run_command "secret-audit trufflehog github repo scan" --timeout 3600 \
    -- trufflehog --no-update github --repo="$slug" \
      --results="$results_filter" \
      --fail || scan_rc=$?

  if (( scan_rc == secret_audit_trufflehog_leak_exit )); then
    secret_audit_print_leak_mitigation "$slug"
  elif (( scan_rc != 0 )); then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED exit=%s\n' "$scan_rc" >&2
  fi
  return "$scan_rc"
}

secret_audit_run_github_org_scan() {
  local -r org="$1"
  local -r results_filter="$2"
  local token scan_rc

  token="$(secret_audit_resolve_github_token || true)"
  if [[ -z "$token" ]]; then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED missing GH token for trufflehog org scan\n' >&2
    return 2
  fi

  scan_rc=0
  # Token via env (GITHUB_TOKEN) — never argv (runner session cmdline / ps).
  GITHUB_TOKEN="$token" run_command "secret-audit trufflehog github org scan" --timeout 7200 \
    -- trufflehog --no-update github --org="$org" \
      --results="$results_filter" \
      --fail || scan_rc=$?

  if (( scan_rc == secret_audit_trufflehog_leak_exit )); then
    secret_audit_print_leak_mitigation "${org}/*"
  elif (( scan_rc != 0 )); then
    printf 'ERROR: SECRET_AUDIT_SCAN_FAILED exit=%s\n' "$scan_rc" >&2
  fi
  return "$scan_rc"
}
