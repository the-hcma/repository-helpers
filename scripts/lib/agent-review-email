#!/usr/bin/env bash
# agent-review-email — operator notifications for wait-for-agent-review.
# shellcheck disable=SC2016  # jq filter strings use single quotes

agent_review_email_require_config() {
  if [[ -z "${AGENT_REVIEW_REPORT_TO:-}" ]]; then
    agent_review_die 'AGENT_REVIEW_REPORT_TO is required (set in ~/.config/agent-review.env)'
  fi
  if [[ -z "${AGENT_REVIEW_REPORT_FROM:-}" ]]; then
    agent_review_die 'AGENT_REVIEW_REPORT_FROM is required (set in ~/.config/agent-review.env)'
  fi
  if [[ -z "${DEP_UPDATER_SMTP_HOST:-}" ]]; then
    agent_review_die 'DEP_UPDATER_SMTP_HOST is required for email (set in ~/.config/agent-review.env or dep-updater.env)'
  fi
}

agent_review_email_load_smtp() {
  local dep_env="${HOME}/.config/dep-updater.env"
  local allexport_was_on=0
  if [[ -f "${dep_env}" ]]; then
    if [[ $- == *a* ]]; then
      allexport_was_on=1
    fi
    set -a
    # shellcheck disable=SC1090  # dep-updater env path is runtime-only
    source "${dep_env}"
    if [[ $allexport_was_on -eq 0 ]]; then
      set +a
    fi
  fi
}

agent_review_email_send_plain() {
  local -r subject="$1"
  local -r body="$2"
  local from_addr to_addr

  agent_review_email_load_smtp
  agent_review_email_require_config
  from_addr="${AGENT_REVIEW_REPORT_FROM}"
  to_addr="${AGENT_REVIEW_REPORT_TO}"

  # shellcheck disable=SC1091  # shared email helpers sourced at runtime from scripts/lib
  source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/email-multipart"
  # shellcheck disable=SC1091  # shared email helpers sourced at runtime from scripts/lib
  source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/smtp-mail"

  repo_helpers_email_write_multipart "${to_addr}" "${from_addr}" "${from_addr}" "${subject}" "${body}" "agent-review" \
    | repo_helpers_smtp_send "${from_addr}" "${to_addr}"
}

agent_review_email_pr_meta() {
  local -r repo="$1"
  local -r pr="$2"
  local pr_json title url owner name exit_code

  agent_review_require_cmd gh
  exit_code=0
  pr_json="$(runner_exec_stdout "agent-review email pr meta" -- gh pr view "${pr}" --repo "${repo}" --json title,url)" || exit_code=$?
  if (( exit_code == 0 )) && [[ -n "${pr_json}" ]]; then
    title="$(ar_runner_jq_file "agent-review email title" "${pr_json}" -r '.title // empty')"
    url="$(ar_runner_jq_file "agent-review email url" "${pr_json}" -r '.url // empty')"
  else
    title=''
    url=''
  fi
  if [[ -z "${url}" ]]; then
    read -r owner name < <(agent_review_repo_parts "${repo}")
    url="https://github.com/${owner}/${name}/pull/${pr}"
  fi
  if [[ -z "${title}" ]]; then
    exit_code=0
    title="$(runner_exec_stdout "agent-review email title retry" -- gh pr view "${pr}" --repo "${repo}" --json title -q .title)" || exit_code=$?
    if (( exit_code != 0 )) || [[ -z "${title}" ]]; then
      title="(title unavailable — see PR #${pr})"
    fi
  fi
  printf '%s\n' "${title}"
  printf '%s\n' "${url}"
}

# Load PR title and URL for operator emails (newline-delimited; safe for titles with tabs).
agent_review_email_read_pr_meta() {
  local -r repo="$1"
  local -r pr="$2"
  local -a meta_lines=()

  mapfile -t meta_lines < <(agent_review_email_pr_meta "${repo}" "${pr}")
  agent_review_email_pr_title="${meta_lines[0]:-}"
  agent_review_email_pr_url="${meta_lines[1]:-}"
  if [[ -z "${agent_review_email_pr_url}" ]]; then
    agent_review_die "could not resolve PR #${pr} URL for email (repo=${repo})"
  fi
  if [[ -z "${agent_review_email_pr_title}" ]]; then
    agent_review_email_pr_title="(title unavailable — see PR #${pr})"
  fi
}

agent_review_email_gh_user_login() {
  local gh_user exit_code

  exit_code=0
  gh_user="$(ar_runner_gh_api_stream "agent-review email gh user login" user --jq '.login')" \
    || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "${gh_user}" ]]; then
    printf 'unknown'
    return 0
  fi
  printf '%s' "${gh_user}"
}

# Friendly display name for known review agents; humans keep their login.
agent_review_email_reviewer_display_name() {
  local -r login="$1"
  local lower

  lower="${login,,}"
  case "${lower}" in
    *copilot*)
      printf 'copilot'
      ;;
    *bugbot*|*cursor*)
      printf 'bugbot'
      ;;
    *coderabbit*|*rabbit*)
      printf 'coderabbitai'
      ;;
    *)
      printf '%s' "${login}"
      ;;
  esac
}

# Comma-separated reviewers (bots + humans) from PR reviews, deduped by login.
agent_review_email_reviewers_list() {
  local -r repo="$1"
  local -r pr="$2"
  local reviews_json exit_code login display result
  local -a logins=()
  local -a displays=()
  local -A seen_logins=()
  local -A seen_display=()

  exit_code=0
  reviews_json="$(runner_exec_stdout "agent-review email pr reviews" -- gh pr view "${pr}" --repo "${repo}" --json reviews)" \
    || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "${reviews_json}" ]]; then
    printf 'unknown'
    return 0
  fi

  mapfile -t logins < <(ar_runner_jq_file "agent-review email review logins" "${reviews_json}" -r '
    [.reviews[]?
      | select(.state != "PENDING")
      | (.author.login // empty)
      | select(. != "")]
    | reduce .[] as $l ([]; if index($l) then . else . + [$l] end)
    | .[]')

  for login in "${logins[@]}"; do
    [[ -z "${login}" ]] && continue
    [[ -n "${seen_logins[${login}]+x}" ]] && continue
    seen_logins["${login}"]=1
    display="$(agent_review_email_reviewer_display_name "${login}")"
    [[ -n "${seen_display[${display}]+x}" ]] && continue
    seen_display["${display}"]=1
    displays+=("${display}")
  done

  if (( ${#displays[@]} == 0 )); then
    printf 'none'
    return 0
  fi

  result="$(printf '%s, ' "${displays[@]}")"
  printf '%s' "${result%, }"
}

# Actual mergeStateStatus from the PR (e.g. CLEAN, BLOCKED), or unknown.
agent_review_email_merge_state_status() {
  local -r repo="$1"
  local -r pr="$2"
  local merge_json merge_state exit_code

  exit_code=0
  merge_json="$(agent_review_pr_merge_json "${repo}" "${pr}")" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "${merge_json}" ]]; then
    printf 'unknown'
    return 0
  fi
  merge_state="$(ar_runner_jq_file "agent-review email mergeStateStatus" "${merge_json}" \
    -r '.mergeStateStatus // empty')"
  if [[ -z "${merge_state}" ]]; then
    printf 'unknown'
    return 0
  fi
  printf '%s' "${merge_state}"
}

# Multi-line checklist proving no open feedback or in-flight agent work (for operator emails).
agent_review_email_work_complete_checklist() {
  local -r repo="$1"
  local -r pr="$2"
  local owner name snapshot head pending_count open_threads coderabbit_pending bugbot_pending
  local copilot_pending ci_conclusion feedback_stats lines=()
  local saved_agent

  read -r owner name < <(agent_review_repo_parts "${repo}")
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  head="$(ar_runner_jq_file "agent-review email head sha" "${snapshot}" -r '.data.repository.pullRequest.headRefOid')"
  pending_count="$(agent_review_pending_thread_count_from_snapshot "${repo}" "${pr}" "${snapshot}")"
  open_threads="$(ar_runner_jq_file "agent-review email open threads" \
    "$(agent_review_pending_threads_json_from_snapshot "${snapshot}")" 'length')"
  if agent_review_named_pr_check_is_pending "${repo}" "${pr}" 'CodeRabbit'; then
    coderabbit_pending='running'
  else
    coderabbit_pending='not running'
  fi
  if agent_review_named_pr_check_is_pending "${repo}" "${pr}" 'Cursor Bugbot'; then
    bugbot_pending='running'
  else
    bugbot_pending='not running'
  fi
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  agent_review_use_agent 'copilot'
  if declare -F agent_review_profile_review_outstanding >/dev/null 2>&1 \
    && agent_review_profile_review_outstanding "${snapshot}" "${head}" "${repo}" "${pr}"; then
    if declare -F agent_review_copilot_review_requests_pending_in_snapshot >/dev/null 2>&1 \
      && agent_review_copilot_review_requests_pending_in_snapshot "${snapshot}"; then
      copilot_pending='awaiting review completion (review requested on PR)'
    else
      copilot_pending='awaiting review completion (response pending)'
    fi
  elif agent_review_agent_requested_from_snapshot "${snapshot}"; then
    copilot_pending='review requested (visible on PR)'
  else
    copilot_pending='no outstanding request'
  fi
  agent_review_use_agent "${saved_agent}"
  ci_conclusion="$(ar_runner_jq_file "agent-review email ci conclusion" \
    "$(agent_review_ci_status_json_for_pr "${repo}" "${pr}")" -r '.ci_conclusion // "unknown"')"
  feedback_stats="$(agent_review_feedback_stats_line_for_email "${repo}" "${pr}" "${snapshot}")"

  lines+=("Work complete (verified at email time):")
  lines+=("${feedback_stats}")
  lines+=("  Pending feedback (threads + PR comments): ${pending_count}")
  lines+=("  Open review threads needing action: ${open_threads}")
  lines+=("  Copilot review request: ${copilot_pending}")
  lines+=("  Bugbot check workflow: ${bugbot_pending}")
  lines+=("  CodeRabbit workflow: ${coderabbit_pending}")
  if agent_review_coderabbit_head_feedback_needs_operator_triage "${repo}" "${pr}" "${head}" "${snapshot}"; then
    lines+=("  CodeRabbit review body feedback: needs operator PR comment")
  else
    lines+=("  CodeRabbit review body feedback: none pending")
  fi
  lines+=("  Required CI: ${ci_conclusion}")
  (IFS=$'\n'; printf '%s' "${lines[*]}")
}

agent_review_email_complete() {
  local -r repo="$1"
  local -r pr="$2"
  local body agent_id gh_user reviewers merge_state

  agent_review_require_cmd gh
  agent_review_email_read_pr_meta "${repo}" "${pr}"
  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  gh_user="$(agent_review_email_gh_user_login)"
  reviewers="$(agent_review_email_reviewers_list "${repo}" "${pr}")"
  merge_state="$(agent_review_email_merge_state_status "${repo}" "${pr}")"
  body="PR #${pr} passed the ${agent_id} agent review loop.

URL: ${agent_review_email_pr_url}
Title: ${agent_review_email_pr_title}

Reviewers: ${reviewers}
Open feedback: none
Action: PR approved via gh as ${gh_user}.
Merge: mergeStateStatus=${merge_state}"

  agent_review_email_send_plain \
    "PR approved after ${agent_id} review: ${agent_review_email_pr_title} (#${pr})" "${body}"
  printf 'Sent complete email for PR #%s to %s\n' "${pr}" "${AGENT_REVIEW_REPORT_TO}" >&2
}

agent_review_email_idle_complete() {
  local -r repo="$1"
  local -r pr="$2"
  local -r idle_s="$3"
  local mode="${4:-idle}"
  local body gh_user quota_summary subject reviewers merge_state work_checklist

  agent_review_require_cmd gh
  agent_review_email_read_pr_meta "${repo}" "${pr}"
  gh_user="$(agent_review_email_gh_user_login)"
  reviewers="$(agent_review_email_reviewers_list "${repo}" "${pr}")"
  merge_state="$(agent_review_email_merge_state_status "${repo}" "${pr}")"
  quota_summary="$(agent_review_quota_summary_for_email "${repo}" "${pr}")"
  work_checklist="$(agent_review_email_work_complete_checklist "${repo}" "${pr}")"
  if [[ "${mode}" == 'early' ]]; then
    subject="PR review cycle complete (nothing outstanding): ${agent_review_email_pr_title} (#${pr})"
    body="PR #${pr} review cycle complete — nothing outstanding.

URL: ${agent_review_email_pr_url}
Title: ${agent_review_email_pr_title}

Reviewers: ${reviewers}

${work_checklist}

Agent quota today:
${quota_summary}

Action: PR approved via gh as ${gh_user} when merge checks pass.
Merge: mergeStateStatus=${merge_state}"
  else
    subject="PR review cycle complete (idle): ${agent_review_email_pr_title} (#${pr})"
    body="PR #${pr} review cycle complete — no new feedback for ${idle_s}s.

URL: ${agent_review_email_pr_url}
Title: ${agent_review_email_pr_title}

Reviewers: ${reviewers}

${work_checklist}

No new reviews or comments arrived within AGENT_REVIEW_CYCLE_TIMEOUT (${idle_s}s).

Agent quota today:
${quota_summary}

Action: PR approved via gh as ${gh_user} when merge checks pass.
Merge: mergeStateStatus=${merge_state}"
  fi

  agent_review_email_send_plain "${subject}" "${body}"
  printf 'Sent idle-complete email for PR #%s to %s\n' "${pr}" "${AGENT_REVIEW_REPORT_TO}" >&2
}

agent_review_loop_stop_subject_short() {
  local -r reason_code="${2:-}"
  local -r pending_threads="${3:-}"

  case "${reason_code}" in
    CI_FAILED)
      printf 'CI failed'
      ;;
    THREADS_PENDING)
      if [[ -n "${pending_threads}" ]] && [[ "${pending_threads}" != '0' ]]; then
        printf '%s feedback item(s) need a reply or resolve' "${pending_threads}"
      else
        printf 'feedback items need a reply or resolve'
      fi
      ;;
    NO_FRESH_REVIEW_AFTER_IDLE_BREAK)
      printf 'no fresh agent review after idle break'
      ;;
    RESTACK_FAILED)
      printf 'restack failed'
      ;;
    MERGE_STATE_BLOCKED)
      printf 'merge state blocked'
      ;;
    AGENT_CHECK_ERROR)
      printf 'agent check failed to run'
      ;;
    QUOTA_EXHAUSTED)
      printf 'agent review quota exhausted'
      ;;
    TIMEOUT)
      printf 'agent review timed out'
      ;;
    REQUEST_FAILED)
      printf 'agent review request failed'
      ;;
    LOOP_STOPPED)
      printf 'agent review loop stopped'
      ;;
    *)
      printf 'agent review loop stopped'
      ;;
  esac
}

agent_review_loop_stop_human_headline() {
  local -r exit_code="$1"
  local -r reason_code="$2"
  local -r pending_threads="${3:-}"
  local short_label

  short_label="$(agent_review_loop_stop_subject_short \
    "${exit_code}" "${reason_code}" "${pending_threads}")"
  printf '%s (%s=%s)' "${short_label}" "${reason_code}" "${exit_code}"
}

agent_review_email_loop_stopped() {
  local -r repo="$1"
  local -r pr="$2"
  local -r exit_code="$3"
  local -r reason_code="$4"
  local -r reason_detail="$5"
  local context_json="${6:-}"
  local title url body agent_id headline subject pending_threads head_sha ci_conclusion
  local merge_state last_error attempts max_attempts

  if [[ -z "${context_json}" ]]; then
    context_json='{}'
  fi

  agent_review_require_cmd gh
  agent_review_email_read_pr_meta "${repo}" "${pr}"
  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  pending_threads="$(ar_runner_jq_file "agent-review email pending threads" "${context_json}" -r '.pending_threads // empty')"
  head_sha="$(ar_runner_jq_file "agent-review email head sha" "${context_json}" -r '.head_sha // empty')"
  ci_conclusion="$(ar_runner_jq_file "agent-review email ci conclusion" "${context_json}" -r '.ci_conclusion // empty')"
  merge_state="$(ar_runner_jq_file "agent-review email merge state" "${context_json}" -r '.merge_state_status // empty')"
  last_error="$(ar_runner_jq_file "agent-review email last error" "${context_json}" -r '.last_error // empty')"
  attempts="$(ar_runner_jq_file "agent-review email attempts" "${context_json}" -r '.attempts // empty')"
  max_attempts="$(ar_runner_jq_file "agent-review email max attempts" "${context_json}" -r '.max_attempts // empty')"
  headline="$(agent_review_loop_stop_human_headline \
    "${exit_code}" "${reason_code}" "${pending_threads}")"
  subject="PR agent review stopped: ${headline} — ${agent_review_email_pr_title} (#${pr})"
  body="The automated agent review loop stopped without reaching complete_ready.

PR #${pr}: ${agent_review_email_pr_url}
Title: ${agent_review_email_pr_title}
Reason: ${headline}
Agent: ${agent_id}"

  if [[ -n "${head_sha}" ]]; then
    body="${body}
Head: ${head_sha}"
  fi
  if [[ -n "${pending_threads}" ]]; then
    body="${body}
Pending threads: ${pending_threads}"
  fi
  if [[ -n "${ci_conclusion}" ]]; then
    body="${body}
CI conclusion: ${ci_conclusion}"
  fi
  if [[ -n "${merge_state}" ]]; then
    body="${body}
Merge state: ${merge_state}"
  fi
  if [[ -n "${attempts}" && -n "${max_attempts}" ]] && [[ "${max_attempts}" != '0' ]]; then
    body="${body}
Attempts: ${attempts}/${max_attempts}"
  fi
  if [[ -n "${last_error}" ]]; then
    body="${body}
Last error: ${last_error}"
  fi

  body="${body}

Details: ${reason_detail}

Please review manually on GitHub and re-run scripts/wait-for-agent-review loop --pr ${pr} when ready."

  agent_review_email_send_plain "${subject}" "${body}"
  printf 'Sent loop-stopped email for PR #%s to %s\n' "${pr}" "${AGENT_REVIEW_REPORT_TO}" >&2
}

agent_review_email_failure() {
  local -r repo="$1"
  local -r pr="$2"
  local -r reason="$3"

  agent_review_email_loop_stopped "${repo}" "${pr}" 6 TIMEOUT "${reason}" '{}'
}

agent_review_post_fallback_comment() {
  local -r repo="$1"
  local -r pr="$2"
  local -r reason="$3"
  local -r from_agent="$4"
  local -r fallback_agent="$5"
  local title url comment_body exit_code

  agent_review_require_cmd gh
  agent_review_email_read_pr_meta "${repo}" "${pr}"
  comment_body="## Agent review fallback

**${from_agent}** review quota or usage limit is exhausted; continuing with **${fallback_agent}** instead.

${reason}

- **PR:** ${agent_review_email_pr_url}
- **Title:** ${agent_review_email_pr_title}
- **Previous agent:** ${from_agent}
- **Fallback agent:** ${fallback_agent}"

  exit_code=0
  runner_exec "agent-review email fallback comment" -- gh pr comment "${pr}" --repo "${repo}" \
    --body "${comment_body}" || exit_code=$?
  if (( exit_code != 0 )); then
    return 1
  fi
  printf 'Posted fallback comment on PR #%s (%s → %s)\n' \
    "${pr}" "${from_agent}" "${fallback_agent}" >&2
}

agent_review_post_loop_stopped_comment() {
  local -r repo="$1"
  local -r pr="$2"
  local -r exit_code="$3"
  local -r reason_code="$4"
  local -r reason_detail="$5"
  local title url comment_body agent_id headline runner_exit

  agent_review_require_cmd gh
  agent_review_email_read_pr_meta "${repo}" "${pr}"
  agent_id="${AGENT_REVIEW_AGENT:-copilot}"
  headline="$(agent_review_loop_stop_human_headline "${exit_code}" "${reason_code}")"
  comment_body="## Agent review loop stopped: ${headline}

${reason_detail}

- **PR:** ${agent_review_email_pr_url}
- **Title:** ${agent_review_email_pr_title}
- **Agent:** ${agent_id}

Manual follow-up required: triage remaining agent threads, push fixes, and re-run \`scripts/wait-for-agent-review loop --pr ${pr}\` when ready."

  runner_exit=0
  runner_exec "agent-review email loop stopped comment" -- gh pr comment "${pr}" --repo "${repo}" \
    --body "${comment_body}" || runner_exit=$?
  if (( runner_exit != 0 )); then
    return 1
  fi
  printf 'Posted loop-stopped comment on PR #%s\n' "${pr}" >&2
}

agent_review_post_give_up_comment() {
  local -r repo="$1"
  local -r pr="$2"
  local -r reason="$3"
  local mode="${4:-}"

  if [[ "${mode}" == 'quota' ]]; then
    agent_review_post_loop_stopped_comment "${repo}" "${pr}" 7 QUOTA_EXHAUSTED "${reason}"
  else
    agent_review_post_loop_stopped_comment "${repo}" "${pr}" 6 TIMEOUT "${reason}"
  fi
}
