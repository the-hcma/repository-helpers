# shellcheck shell=bash
# coderabbit-skills — detect-first notice for the CodeRabbit CLI agent skills (repository-helpers#860).
#
# `coderabbit skills` installs the skills at user level (never into a repository), one directory per
# skill under each detected agent's skills root. This lib only looks for those directories and prints
# one NOTE; it never installs anything (the install needs the user's approval, see
# .agents/rules/coderabbit-skills.md) and makes no network call.
#
# Sourced by scripts/dev/start-development.

if declare -F coderabbit_skills_notice >/dev/null 2>&1; then
  return 0
fi

readonly coderabbit_skills_names=(autofix code-review coderabbit-config)
readonly coderabbit_skills_agent_roots=(.claude/skills .codex/skills .cursor/skills .gemini/skills .copilot/skills .agents/skills)

# coderabbit_skills_installed: exit 0 when a CodeRabbit skill directory exists under $HOME. `autofix` and `code-review`
# are generic names, so a directory of that name counts only when its SKILL.md names CodeRabbit; a user's own
# `code-review` skill must not hide the notice. `coderabbit-config` is specific enough to count by name. A CodeRabbit
# plugin directory (up to three levels under ~/.claude/plugins or ~/.codex/plugins) counts too: the official plugins
# bring their own skills, which `coderabbit skills` never replaces.
coderabbit_skills_installed() {
  local root name dir skill_text

  for root in "${coderabbit_skills_agent_roots[@]}"; do
    for name in "${coderabbit_skills_names[@]}"; do
      dir="${HOME}/${root}/${name}"
      if [[ ! -d "${dir}" ]]; then
        continue
      fi
      if [[ "${name}" == 'coderabbit-config' ]]; then
        return 0
      fi
      if [[ -f "${dir}/SKILL.md" ]]; then
        skill_text="$(<"${dir}/SKILL.md")"
        if [[ "${skill_text}" == *[Cc]ode[Rr]abbit* ]]; then
          return 0
        fi
      fi
    done
  done
  # Skills the official Claude Code or Codex plugin installed live under the plugin directories, not under the
  # agent skills roots; a plugin user is not missing them and must not be told to run `coderabbit skills`. Only
  # directories count, and a marketplace listing (added, not installed) does not.
  for root in .claude/plugins .codex/plugins; do
    for dir in "${HOME}/${root}"/*[Cc]ode[Rr]abbit* "${HOME}/${root}"/*/*[Cc]ode[Rr]abbit* \
      "${HOME}/${root}"/*/*/*[Cc]ode[Rr]abbit*; do
      if [[ -d "${dir}" && "${dir}" != */marketplaces/* ]]; then
        return 0
      fi
    done
  done
  return 1
}

# coderabbit_skills_notice: print one NOTE when the CLI is on PATH but no skill is installed.
# CODERABBIT_SKILLS_NOTICE=0 turns the note off. Always exits 0.
coderabbit_skills_notice() {
  local cli

  if [[ "${CODERABBIT_SKILLS_NOTICE:-1}" == '0' ]]; then
    return 0
  fi
  # The preview command must name the executable that is really on PATH (`cr` is the CLI's short alias).
  if command -v coderabbit >/dev/null 2>&1; then
    cli='coderabbit'
  elif command -v cr >/dev/null 2>&1; then
    cli='cr'
  else
    return 0
  fi
  if coderabbit_skills_installed; then
    return 0
  fi
  printf 'NOTE: CODERABBIT_SKILLS_MISSING the CodeRabbit CLI is installed but no CodeRabbit skill is; preview with: %s skills --agent, and install only after the user approves (.agents/rules/coderabbit-skills.md, set CODERABBIT_SKILLS_NOTICE=0 to silence)\n' "$cli"
  return 0
}
