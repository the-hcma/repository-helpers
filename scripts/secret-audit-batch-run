#!/usr/bin/env bash
# secret-audit-batch-run — periodic TruffleHog org deep scan + SMTP report.
#
# Entry point for the secret-audit systemd timer. Reuses ~/.config/dep-updater.env
# for SMTP unless ~/.config/secret-audit.env overrides.
#
# Usage:
#   secret-audit-batch-run [--print]
#   secret-audit-batch-run --help
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "$script_dir/.." && pwd)"
readonly repo_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/tooling-path"
if [[ "${REPO_HELPERS_TEST_MODE:-0}" != '1' ]]; then
  tooling_path_bootstrap_cron_minimal || exit 1
else
  tooling_path_ensure_gnu_userland || exit 1
fi

# shellcheck disable=SC1091
source "${script_dir}/lib/smtp-mail"
# shellcheck disable=SC1091
source "${script_dir}/lib/email-multipart"
# shellcheck disable=SC1091
source "${script_dir}/lib/run-context"
# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/timer-singleton-lock"

readonly secret_audit="${script_dir}/secret-audit"
readonly subject_prefix="${SECRET_AUDIT_REPORT_SUBJECT_PREFIX:-[secret-audit-batch]}"
readonly report_separator='────────────────────────────────────────────────────────────────'

env_file="${SECRET_AUDIT_ENV_FILE:-${HOME}/.config/secret-audit.env}"
fallback_env_file="${SECRET_AUDIT_FALLBACK_ENV_FILE:-${HOME}/.config/dep-updater.env}"
log_file="${SECRET_AUDIT_BATCH_LOG:-${HOME}/scratch/repository-helpers/secret-audit-batch.log}"
lock_file="${SECRET_AUDIT_BATCH_LOCK_FILE:-${HOME}/scratch/repository-helpers/secret-audit-batch.lock}"
org="${SECRET_AUDIT_ORG:-the-hcma}"
include_private="${SECRET_AUDIT_INCLUDE_PRIVATE:-0}"

print_only=0
run_log=""
clean_log=""

# shellcheck disable=SC2317,SC2329
batch_cleanup() {
  rm -f "${run_log:-}" "${clean_log:-}" 2>/dev/null || true
}
trap batch_cleanup EXIT

usage() {
  sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}

load_env() {
  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' && "${SECRET_AUDIT_BATCH_SKIP_ENV_FILE:-0}" == '1' ]]; then
    return 0
  fi
  if [[ -f "$fallback_env_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$fallback_env_file"
    set +a
  fi
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$env_file"
    set +a
  fi
  org="${SECRET_AUDIT_ORG:-the-hcma}"
  include_private="${SECRET_AUDIT_INCLUDE_PRIVATE:-0}"
}

apply_mail_defaults() {
  if [[ -z "${SECRET_AUDIT_REPORT_TO:-}" ]]; then
    SECRET_AUDIT_REPORT_TO="${DEP_UPDATER_REPORT_TO:-}"
  fi
  if [[ -z "${SECRET_AUDIT_REPORT_FROM:-}" ]]; then
    SECRET_AUDIT_REPORT_FROM="${DEP_UPDATER_REPORT_FROM:-secret-audit-batch@example.com}"
  fi
  if [[ -z "${SECRET_AUDIT_REPORT_REPLY_TO:-}" ]]; then
    SECRET_AUDIT_REPORT_REPLY_TO="${SECRET_AUDIT_REPORT_FROM}"
  fi
  export SECRET_AUDIT_REPORT_TO SECRET_AUDIT_REPORT_FROM SECRET_AUDIT_REPORT_REPLY_TO
}

report_body() {
  local -r exit_code="$1"
  local -r started_at="$2"
  local -r finished_at="$3"
  local status_text

  if [[ "$exit_code" -eq 0 ]]; then
    status_text='PASSED'
  else
    status_text='FAILED'
  fi

  printf 'Secret audit batch (%s)\n' "$status_text"
  printf '%s\n' "$report_separator"
  printf 'Org:      %s\n' "$org"
  printf 'Started:  %s\n' "$started_at"
  printf 'Finished: %s\n' "$finished_at"
  printf 'Exit:     %s\n' "$exit_code"
  printf '%s\n\n' "$report_separator"
  if [[ -s "${clean_log:-}" ]]; then
    cat "$clean_log"
  else
    printf '(no scan output captured)\n'
  fi
  printf '\n'
  repo_helpers_run_context_footer_full \
    "${secret_audit} --all --org ${org}" \
    "$repo_dir" "$started_at" "$finished_at" "$log_file" "$report_separator"
}

send_report() {
  local -r exit_code="$1"
  local -r body="$2"
  local status_text subject

  if [[ -z "${SECRET_AUDIT_REPORT_TO:-}" ]]; then
    printf 'WARNING: SECRET_AUDIT_REPORT_TO unset; skipping email\n' >&2
    printf '%s\n' "$body"
    return 0
  fi

  if [[ "$exit_code" -eq 0 ]]; then
    status_text='PASSED'
  else
    status_text='FAILED'
  fi
  subject="${subject_prefix} ${status_text}: org=${org}"

  repo_helpers_email_write_multipart \
    "$SECRET_AUDIT_REPORT_TO" \
    "$SECRET_AUDIT_REPORT_FROM" \
    "$SECRET_AUDIT_REPORT_REPLY_TO" \
    "$subject" \
    "$body" \
    'secret-audit-batch' \
    | repo_helpers_smtp_send "$SECRET_AUDIT_REPORT_FROM" "$SECRET_AUDIT_REPORT_TO"
}

main() {
  local started_at finished_at run_exit body
  local -a scan_args

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print)
        print_only=1
        shift
        ;;
      --help | -h)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done

  load_env
  apply_mail_defaults
  mkdir -p "$(dirname "$log_file")"

  run_log="$(mktemp)"
  clean_log="$(mktemp)"

  if [[ "$print_only" -eq 1 ]]; then
    printf 'Sample secret-audit-batch report for org=%s (no scan)\n' "$org" >"$run_log"
    cp "$run_log" "$clean_log"
    started_at="$(date -Is)"
    finished_at="$started_at"
    body="$(report_body 0 "$started_at" "$finished_at")"
    printf '%s\n' "$body"
    exit 0
  fi

  timer_singleton_acquire_lock "$lock_file" "$log_file" 'secret-audit batch'

  started_at="$(date -Is)"
  # Periodic path: deep org scan; refresh local markers only when clean.
  scan_args=(--all --org "$org" --write-marker)
  if [[ "$include_private" == '1' ]]; then
    scan_args+=(--include-private)
  fi

  {
    printf 'Started: %s\n' "$started_at"
    printf 'Command: %s %s\n' "$secret_audit" "${scan_args[*]}"
    printf '\n'
  } | tee -a "$run_log" >>"$log_file"

  run_exit=0
  # Capture output without process substitution (runner-friendly).
  if ! run_command "secret-audit batch org scan" --timeout 7200 \
    -- "$secret_audit" "${scan_args[@]}" >>"$run_log" 2>&1; then
    run_exit=$?
  fi
  tee -a "$log_file" <"$run_log" >/dev/null

  finished_at="$(date -Is)"
  printf 'Finished: %s (exit=%s)\n' "$finished_at" "$run_exit" | tee -a "$run_log" >>"$log_file"
  sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' "$run_log" >"$clean_log"

  body="$(report_body "$run_exit" "$started_at" "$finished_at")"
  send_report "$run_exit" "$body"
  exit "$run_exit"
}

main "$@"
