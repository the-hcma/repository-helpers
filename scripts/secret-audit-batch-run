#!/usr/bin/env bash
# secret-audit-batch-run — periodic TruffleHog org deep scan + SMTP report.
#
# Entry point for the secret-audit systemd timer. Reuses ~/.config/dep-updater.env
# for SMTP unless ~/.config/secret-audit.env overrides.
#
# Email is summary-only (status / pass-fail / findings counts / repo list / result /
# local detail path). Full TruffleHog output is deposited on the host — never in
# the message body. See repository-helpers#559.
#
# Usage:
#   secret-audit-batch-run [--print]
#   secret-audit-batch-run --help
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
helpers_repo_dir="$(cd "$script_dir/.." && pwd)"
readonly helpers_repo_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/tooling-path"
if [[ "${REPO_HELPERS_TEST_MODE:-0}" != '1' ]]; then
  tooling_path_bootstrap_cron_minimal || exit 1
else
  tooling_path_ensure_gnu_userland || exit 1
fi

# shellcheck disable=SC1091
source "${script_dir}/lib/smtp-mail"
# shellcheck disable=SC1091
source "${script_dir}/lib/email-multipart"
# shellcheck disable=SC1091
source "${script_dir}/lib/run-context"
# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/timer-singleton-lock"
# shellcheck disable=SC1091
source "${script_dir}/lib/repo-practices"
# shellcheck disable=SC1091
source "${script_dir}/lib/secret-audit"

readonly secret_audit="${script_dir}/secret-audit"
readonly subject_prefix="${SECRET_AUDIT_REPORT_SUBJECT_PREFIX:-[secret-audit-batch]}"
readonly report_separator='────────────────────────────────────────────────────────────────'

env_file="${SECRET_AUDIT_ENV_FILE:-${HOME}/.config/secret-audit.env}"
fallback_env_file="${SECRET_AUDIT_FALLBACK_ENV_FILE:-${HOME}/.config/dep-updater.env}"
log_file="${SECRET_AUDIT_BATCH_LOG:-${HOME}/scratch/repository-helpers/secret-audit-batch.log}"
detail_dir="${SECRET_AUDIT_DETAIL_DIR:-${HOME}/scratch/repository-helpers/secret-audit-runs}"
lock_file="${SECRET_AUDIT_BATCH_LOCK_FILE:-${HOME}/scratch/repository-helpers/secret-audit-batch.lock}"
org="${SECRET_AUDIT_ORG:-the-hcma}"
include_private="${SECRET_AUDIT_INCLUDE_PRIVATE:-0}"

print_only=0
run_log=""
clean_log=""
detail_file=""
# Short repo names in scope for the email (OWNER/NAME listed at report time).
# Populated by batch_load_scoped_repos; empty when discovery is skipped/fails.
batch_scoped_repo_names=()

# shellcheck disable=SC2317,SC2329
batch_cleanup() {
  rm -f "${run_log:-}" "${clean_log:-}" 2>/dev/null || true
}
trap batch_cleanup EXIT

usage() {
  runner_sh_stdout "secret-audit-batch usage" -- \
    "sed -n '2,12p' $(printf '%q' "${BASH_SOURCE[0]}") | sed 's/^# \{0,1\}//'"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}

load_env() {
  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' && "${SECRET_AUDIT_BATCH_SKIP_ENV_FILE:-0}" == '1' ]]; then
    return 0
  fi
  if [[ -f "$fallback_env_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$fallback_env_file"
    set +a
  fi
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$env_file"
    set +a
  fi
  org="${SECRET_AUDIT_ORG:-the-hcma}"
  include_private="${SECRET_AUDIT_INCLUDE_PRIVATE:-0}"
  detail_dir="${SECRET_AUDIT_DETAIL_DIR:-${HOME}/scratch/repository-helpers/secret-audit-runs}"
}

apply_mail_defaults() {
  if [[ -z "${SECRET_AUDIT_REPORT_TO:-}" ]]; then
    SECRET_AUDIT_REPORT_TO="${DEP_UPDATER_REPORT_TO:-}"
  fi
  if [[ -z "${SECRET_AUDIT_REPORT_FROM:-}" ]]; then
    SECRET_AUDIT_REPORT_FROM="${DEP_UPDATER_REPORT_FROM:-secret-audit-batch@example.com}"
  fi
  if [[ -z "${SECRET_AUDIT_REPORT_REPLY_TO:-}" ]]; then
    SECRET_AUDIT_REPORT_REPLY_TO="${SECRET_AUDIT_REPORT_FROM}"
  fi
  export SECRET_AUDIT_REPORT_TO SECRET_AUDIT_REPORT_FROM SECRET_AUDIT_REPORT_REPLY_TO
}

# Extract safe aggregate counters from TruffleHog info logs (never finding payloads).
# Matches both logrus JSON fields ("num_repos": 12) and key=value text (num_repos=12).
batch_safe_scan_stats() {
  local -r log_path="$1"
  local line num_repos verified unverified duration

  num_repos=''
  verified=''
  unverified=''
  duration=''
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ \"num_repos\":[[:space:]]*([0-9]+) ]]; then
      num_repos="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ (^|[[:space:]])num_repos=([0-9]+) ]]; then
      num_repos="${BASH_REMATCH[2]}"
    fi
    if [[ "$line" =~ \"verified_secrets\":[[:space:]]*([0-9]+) ]]; then
      verified="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ (^|[[:space:]])verified_secrets=([0-9]+) ]]; then
      verified="${BASH_REMATCH[2]}"
    fi
    if [[ "$line" =~ \"unverified_secrets\":[[:space:]]*([0-9]+) ]]; then
      unverified="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ (^|[[:space:]])unverified_secrets=([0-9]+) ]]; then
      unverified="${BASH_REMATCH[2]}"
    fi
    if [[ "$line" =~ \"scan_duration\":[[:space:]]*\"([^\"]+)\" ]]; then
      duration="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ (^|[[:space:]])scan_duration=([^[:space:]]+) ]]; then
      duration="${BASH_REMATCH[2]}"
    fi
  done <"$log_path"

  printf 'num_repos=%s\n' "${num_repos:-unknown}"
  printf 'verified_secrets=%s\n' "${verified:-unknown}"
  printf 'unverified_secrets=%s\n' "${unverified:-unknown}"
  printf 'scan_duration=%s\n' "${duration:-unknown}"
}

# Discover non-archived org repo short names for the email (same filters as --all).
# Names only — never finding payloads. Skipped in --print / when network is unavailable.
batch_load_scoped_repos() {
  local name sorted_names
  batch_scoped_repo_names=()
  if [[ "$print_only" -eq 1 ]]; then
    return 0
  fi
  # Consumed by rp_discover_org_repos (sourced lib).
  # shellcheck disable=SC2034
  rp_include_private="$include_private"
  # shellcheck disable=SC2034
  rp_exclude_archived=1
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    batch_scoped_repo_names+=("$name")
  done < <(rp_discover_org_repos "$org" 2>/dev/null || true)
  if ((${#batch_scoped_repo_names[@]} > 1)); then
    # Stable email order (ASCII).
    sorted_names="$(
      runner_sh_stdout "secret-audit-batch sort scoped repos" -- \
        "printf '%s\\n' $(printf '%q ' "${batch_scoped_repo_names[@]}") | LC_ALL=C sort"
    )"
    mapfile -t batch_scoped_repo_names <<<"$sorted_names"
  fi
}

# Round TruffleHog/Go scan_duration for email (two decimal places).
# Examples: 6.535816612s → 6.54s; 83.456s → 1m 23.46s; unknown → unknown.
# Parses raw values only at display time — batch_safe_scan_stats stays verbatim.
batch_format_scan_duration() {
  local -r raw="${1:-}"
  local total_sec rounded mins secs_part

  if [[ -z "$raw" || "$raw" == "unknown" ]]; then
    printf '%s' 'unknown'
    return 0
  fi

  # Typical TruffleHog / Go Duration.String(): "7.168075341s"
  if [[ "$raw" =~ ^([0-9]+(\.[0-9]+)?)s$ ]]; then
    total_sec="${BASH_REMATCH[1]}"
  # Go compound form once past a minute: "1m23.456789s"
  elif [[ "$raw" =~ ^([0-9]+)m([0-9]+(\.[0-9]+)?)s$ ]]; then
    total_sec="$(
      LC_ALL=C awk -v m="${BASH_REMATCH[1]}" -v s="${BASH_REMATCH[2]}" \
        'BEGIN { printf "%.10f", (m * 60) + s }'
    )"
  else
    # Unrecognized shape — keep verbatim rather than inventing a value.
    printf '%s' "$raw"
    return 0
  fi

  rounded="$(LC_ALL=C awk -v t="$total_sec" 'BEGIN { printf "%.2f", t }')"
  mins="$(LC_ALL=C awk -v t="$rounded" 'BEGIN { printf "%d", int(t / 60) }')"
  secs_part="$(
    LC_ALL=C awk -v t="$rounded" -v m="$mins" \
      'BEGIN { printf "%.2f", t - (m * 60) }'
  )"
  if (( mins > 0 )); then
    printf '%dm %ss' "$mins" "$secs_part"
  else
    printf '%ss' "$rounded"
  fi
}

batch_log_line() {
  local -r line="$1"
  runner_sh "secret-audit-batch log line" -- \
    "printf '%s\n' $(printf '%q' "$line") | tee -a $(printf '%q' "$run_log") >>$(printf '%q' "$log_file")"
}

batch_log_block() {
  local -r text="$1"
  runner_sh "secret-audit-batch log block" -- \
    "printf '%s' $(printf '%q' "$text") | tee -a $(printf '%q' "$run_log") >>$(printf '%q' "$log_file")"
}

batch_sync_run_log_to_file() {
  runner_sh "secret-audit-batch sync run log" -- \
    "tee -a $(printf '%q' "$log_file") <$(printf '%q' "$run_log") >/dev/null"
}

batch_write_clean_log() {
  runner_sh "secret-audit-batch strip ansi" -- \
    "sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' $(printf '%q' "$run_log") >$(printf '%q' "$clean_log")"
}

batch_ensure_log_file_private() {
  # 0600 before tee -a: batch log may contain TruffleHog finding payloads.
  runner_exec "secret-audit-batch touch log_file" -- touch "$log_file"
  runner_exec "secret-audit-batch chmod log_file" -- chmod 0600 "$log_file"
}

# Org scan stderr (including replayed TruffleHog stats from scripts/lib/secret-audit)
# is merged into run_log for email summaries.
batch_run_org_scan() {
  local -r run_log_path="$1"
  shift
  local -a scan_cmd=("$@")
  local scan_shell_cmd arg

  # Isolate the child runner session: secret-audit sources runner-bootstrap and
  # would otherwise inherit RUNNER_SESSION_DIR, then rm -rf it on EXIT — wiping
  # this batch-run's capture artifacts (stdout/cmdline) before failure triage.
  scan_shell_cmd='env -u RUNNER_SESSION_DIR -u RUNNER_SESSION_KEEP'
  scan_shell_cmd+=" $(printf '%q' "${scan_cmd[0]}")"
  for arg in "${scan_cmd[@]:1}"; do
    scan_shell_cmd+=" $(printf '%q' "$arg")"
  done
  scan_shell_cmd+=" >>$(printf '%q' "$run_log_path") 2>&1"

  runner_sh "secret-audit batch org scan" --timeout 7200 -- "$scan_shell_cmd"
}

deposit_scan_detail() {
  local -r source_log="$1"
  local -r stamp="$2"
  local dest

  # Best-effort: never abort the batch before SMTP (leak alerts must still send).
  if ! runner_exec "secret-audit-batch mkdir detail_dir" -- mkdir -p "$detail_dir"; then
    printf 'WARNING: could not create detail dir %s\n' "$detail_dir" >&2
    return 1
  fi
  dest="${detail_dir}/${stamp}-org-${org}.log"
  # 0600: may contain credential material from TruffleHog findings.
  if ! runner_exec "secret-audit-batch cp detail transcript" -- cp -- "$source_log" "$dest"; then
    printf 'WARNING: could not deposit detail transcript to %s\n' "$dest" >&2
    return 1
  fi
  if ! runner_exec "secret-audit-batch chmod detail transcript" -- chmod 0600 "$dest"; then
    printf 'WARNING: could not chmod 0600 detail transcript %s\n' "$dest" >&2
    return 1
  fi
  detail_file="$dest"
  batch_log_line "Detail transcript: ${detail_file}"
  return 0
}

report_body() {
  local -r exit_code="$1"
  local -r started_at="$2"
  local -r finished_at="$3"
  local status_text stats_line num_repos verified unverified duration
  local scoped_count passed failed name result_class

  if [[ "$exit_code" -eq 0 ]]; then
    status_text='PASSED'
  else
    status_text='FAILED'
  fi

  num_repos='unknown'
  verified='unknown'
  unverified='unknown'
  duration='unknown'
  if [[ -n "${clean_log:-}" && -f "$clean_log" ]]; then
    while IFS= read -r stats_line; do
      case "$stats_line" in
        num_repos=*) num_repos="${stats_line#num_repos=}" ;;
        verified_secrets=*) verified="${stats_line#verified_secrets=}" ;;
        unverified_secrets=*) unverified="${stats_line#unverified_secrets=}" ;;
        scan_duration=*) duration="${stats_line#scan_duration=}" ;;
      esac
    done < <(batch_safe_scan_stats "$clean_log")
  fi

  scoped_count="${#batch_scoped_repo_names[@]}"
  # Prefer GitHub discovery count for pass/fail; fall back to TruffleHog num_repos.
  if (( scoped_count > 0 )); then
    num_repos="$scoped_count"
  fi

  # Org scan is one TruffleHog github --org run: clean ⇒ all in-scope repos passed;
  # non-zero ⇒ treat the whole scope as failed (per-repo attribution stays on-host).
  if [[ "$exit_code" -eq 0 ]]; then
    if [[ "$num_repos" =~ ^[0-9]+$ ]]; then
      passed="$num_repos"
      failed=0
    else
      passed='unknown'
      failed=0
    fi
  else
    passed=0
    if [[ "$num_repos" =~ ^[0-9]+$ ]]; then
      failed="$num_repos"
    else
      failed='unknown'
    fi
  fi

  # shellcheck disable=SC2154  # assigned in sourced scripts/lib/secret-audit
  if (( exit_code == secret_audit_trufflehog_leak_exit )); then
    result_class="SECRET_AUDIT_LEAK (TruffleHog --fail / exit ${secret_audit_trufflehog_leak_exit})"
  elif (( exit_code != 0 )); then
    result_class='SECRET_AUDIT_SCAN_FAILED'
  else
    result_class='clean'
  fi

  printf 'Secret audit batch (%s)\n' "$status_text"
  printf '%s\n' "$report_separator"
  printf 'Org:       %s\n' "$org"
  printf 'Exit:      %s\n' "$exit_code"
  printf 'Result:    %s\n' "$result_class"
  printf 'Repos:     %s in scope (archived excluded)\n' "$num_repos"
  printf '  Passed:  %s\n' "$passed"
  printf '  Failed:  %s\n' "$failed"
  printf 'Findings:  %s verified, %s unverified (TruffleHog secret matches)\n' \
    "$verified" "$unverified"
  printf 'Scan time: %s\n' "$(batch_format_scan_duration "$duration")"
  if (( scoped_count > 0 )); then
    printf 'Repos in scope:\n'
    for name in "${batch_scoped_repo_names[@]}"; do
      printf '  - %s/%s\n' "$org" "$name"
    done
  elif [[ "$print_only" -eq 1 ]]; then
    printf 'Repos in scope: (omitted in --print sample)\n'
  else
    printf 'Repos in scope: (names unavailable; see host transcript)\n'
  fi
  printf '%s\n\n' "$report_separator"
  # Never include raw TruffleHog findings (may contain credential material).
  printf 'Finding details are omitted from email (may contain secret material).\n'
  if [[ -n "${detail_file:-}" ]]; then
    printf 'Full scan transcript (host only): %s\n' "$detail_file"
  fi
  printf 'Batch append log: %s\n' "$log_file"
  if (( exit_code == secret_audit_trufflehog_leak_exit )); then
    printf 'Action: rotate credentials on the host using the transcript; do not email findings.\n'
  fi
  printf '\n'
  # Started/Finished live only in the run-context footer (avoid duplicating the header).
  repo_helpers_run_context_footer_full \
    "${secret_audit} --all --org ${org}" \
    "$helpers_repo_dir" "$started_at" "$finished_at" "$log_file" "$report_separator"
}

send_report() {
  local -r exit_code="$1"
  local -r body="$2"
  local status_text subject

  if [[ -z "${SECRET_AUDIT_REPORT_TO:-}" ]]; then
    printf 'WARNING: SECRET_AUDIT_REPORT_TO unset; skipping email\n' >&2
    printf '%s\n' "$body"
    return 0
  fi

  if [[ "$exit_code" -eq 0 ]]; then
    status_text='PASSED'
  else
    status_text='FAILED'
  fi
  subject="${subject_prefix} ${status_text}: org=${org}"

  repo_helpers_email_write_multipart \
    "$SECRET_AUDIT_REPORT_TO" \
    "$SECRET_AUDIT_REPORT_FROM" \
    "$SECRET_AUDIT_REPORT_REPLY_TO" \
    "$subject" \
    "$body" \
    'secret-audit-batch' \
    | repo_helpers_smtp_send "$SECRET_AUDIT_REPORT_FROM" "$SECRET_AUDIT_REPORT_TO"
}

main() {
  local started_at finished_at run_exit body stamp header_text
  local -a scan_args

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print)
        print_only=1
        shift
        ;;
      --help | -h)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done

  load_env
  apply_mail_defaults
  runner_exec "secret-audit-batch mkdir batch log dir" -- mkdir -p "$(dirname "$log_file")"
  batch_ensure_log_file_private

  run_log="$(runner_exec_stdout "secret-audit-batch mktemp run log" -- mktemp)"
  clean_log="$(runner_exec_stdout "secret-audit-batch mktemp clean log" -- mktemp)"

  if [[ "$print_only" -eq 1 ]]; then
    printf 'Sample secret-audit-batch report for org=%s (no scan)\n' "$org" >"$run_log"
    runner_exec "secret-audit-batch cp print sample" -- cp "$run_log" "$clean_log"
    # Print mode does not deposit a transcript — leave detail_file empty so
    # report_body omits the "Full scan transcript" path (no fake SAMPLE path).
    # Skip org discovery (no network in --print / tests).
    detail_file=''
    batch_scoped_repo_names=()
    started_at="$(runner_exec_stdout "secret-audit-batch print started_at" -- date -Is)"
    finished_at="$started_at"
    body="$(report_body 0 "$started_at" "$finished_at")"
    printf '%s\n' "$body"
    exit 0
  fi

  timer_singleton_acquire_lock "$lock_file" "$log_file" 'secret-audit batch'

  started_at="$(runner_exec_stdout "secret-audit-batch started_at" -- date -Is)"
  stamp="$(runner_exec_stdout "secret-audit-batch utc stamp" -- date -u +%Y%m%dT%H%M%SZ)"
  # Periodic path: deep org scan only. No --write-marker: github-repo-lint reads the
  # marker from the remote default branch, so a local write never reaches it and only
  # dirties the primary clone (repository-helpers#534). Markers are intake artifacts
  # valid for secret_audit_marker_stale_days; github-repo-lint reports staleness.
  scan_args=(--all --org "$org")
  if [[ "$include_private" == '1' ]]; then
    scan_args+=(--include-private)
  fi

  batch_load_scoped_repos

  header_text="$(printf 'Started: %s\nCommand: %s %s\n' "$started_at" "$secret_audit" "${scan_args[*]}")"
  if [[ -n "${SECRET_AUDIT_CONCURRENCY:-}" ]]; then
    header_text+="$(printf 'SECRET_AUDIT_CONCURRENCY=%s\n' "$SECRET_AUDIT_CONCURRENCY")"
  fi
  header_text+=$'\n'
  batch_log_block "$header_text"

  run_exit=0
  # secret-audit replays safe TruffleHog counters to stderr; merge into run_log here.
  batch_run_org_scan "$run_log" "$secret_audit" "${scan_args[@]}" || run_exit=$?
  batch_sync_run_log_to_file

  finished_at="$(runner_exec_stdout "secret-audit-batch finished_at" -- date -Is)"
  batch_log_line "Finished: ${finished_at} (exit=${run_exit})"
  batch_write_clean_log
  if ! deposit_scan_detail "$clean_log" "$stamp"; then
    printf 'WARNING: detail transcript deposit failed; email will still send\n' >&2
  fi

  body="$(report_body "$run_exit" "$started_at" "$finished_at")"
  send_report "$run_exit" "$body"
  exit "$run_exit"
}

main "$@"
