#!/usr/bin/env bash
# secret-audit — TruffleHog deep secret/credential scan (full git history).
#
# Complements gitleaks PR/pre-submit scans. See docs/secret-audit-trufflehog.md.
#
# Usage:
#   scripts/secret-audit --repo OWNER/NAME [--write-marker] [--results=verified]
#   scripts/secret-audit --all [--org ORG] [--include-private] [--dry-run]
#   scripts/secret-audit --help
#
# Options:
#   --repo OWNER/NAME       Deep-scan one repository (local clone or trufflehog github)
#   --all                   Scan every org repo (trufflehog github --org)
#   --org ORG               Org for --all (default: the-hcma)
#   --include-private       Include private repos in --all discovery (marker refresh only)
#   --write-marker          After a clean scan, write .github/secret-audit.json
#   --results FILTER        TruffleHog --results value (default: verified)
#   --dry-run               Print planned actions without running trufflehog
#   --help                  Show usage
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/repo-practices"
# shellcheck disable=SC1091
source "${script_dir}/lib/secret-audit"

export SECRET_AUDIT_BIN_DIR="${SECRET_AUDIT_BIN_DIR:-${HOME}/.cache/repository-helpers/bin}"
PATH="${SECRET_AUDIT_BIN_DIR}:${PATH}"
export PATH

# Assigned in sourced scripts/lib/repo-practices and scripts/lib/secret-audit
# (shellcheck cannot follow SC1091).
# shellcheck disable=SC2154
sa_org="$rp_DEFAULT_ORG"
sa_repo_slugs=()
sa_scan_all=0
sa_include_private=0
sa_write_marker=0
sa_dry_run=0
# shellcheck disable=SC2154
sa_results_filter="$secret_audit_default_results_filter"

usage() {
  sed -n '2,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        usage
        exit 0
        ;;
      --org)
        [[ $# -ge 2 ]] || die '--org requires a value'
        sa_org="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || die '--repo requires OWNER/NAME'
        sa_repo_slugs+=("$2")
        shift 2
        ;;
      --all)
        sa_scan_all=1
        shift
        ;;
      --include-private)
        sa_include_private=1
        shift
        ;;
      --write-marker)
        sa_write_marker=1
        shift
        ;;
      --dry-run)
        sa_dry_run=1
        shift
        ;;
      --results=*)
        sa_results_filter="${1#--results=}"
        shift
        ;;
      --results)
        [[ $# -ge 2 ]] || die '--results requires a value'
        sa_results_filter="$2"
        shift 2
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

sa_scan_one_repo() {
  local -r slug="$1"
  local repo_dir git_tip scan_rc cwd_slug

  if [[ "$sa_dry_run" -eq 1 ]]; then
    printf 'DRY-RUN: would deep-scan %s (results=%s write_marker=%s)\n' \
      "$slug" "$sa_results_filter" "$sa_write_marker"
    return 0
  fi

  secret_audit_install_trufflehog || die 'trufflehog install failed'
  PATH="${SECRET_AUDIT_BIN_DIR}:${PATH}"
  export PATH

  # Prefer a local clone (scan-root index or cwd). Tokenized HTTPS remotes are
  # normalized in rp_git_remote_slug_for_dir so cloud checkouts resolve correctly.
  repo_dir="$(rp_resolve_local_repo_dir "$slug" || true)"
  if [[ -z "$repo_dir" ]]; then
    repo_dir="$(runner_exec_stdout "secret-audit git rev-parse toplevel cwd" -- git rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$repo_dir" ]]; then
      cwd_slug="$(rp_git_remote_slug_for_dir "$repo_dir" || true)"
      if [[ "$cwd_slug" != "$slug" ]]; then
        repo_dir=""
      fi
    fi
  fi
  if [[ -n "$repo_dir" && -d "$repo_dir" ]]; then
    if ! secret_audit_ensure_full_clone "$repo_dir"; then
      printf 'ERROR: SECRET_AUDIT_SCAN_FAILED full-clone ensure failed for %s\n' "$slug" >&2
      return 1
    fi
    scan_rc=0
    secret_audit_run_git_scan "$repo_dir" "$sa_results_filter" || scan_rc=$?
    if (( scan_rc != 0 )); then
      return "$scan_rc"
    fi
    if [[ "$sa_write_marker" -eq 1 ]]; then
      git_tip="$(runner_exec_stdout "secret-audit git rev-parse HEAD" -- git -C "$repo_dir" rev-parse HEAD)"
      secret_audit_write_marker "$repo_dir" "$git_tip" "$sa_results_filter"
      # shellcheck disable=SC2154
      printf 'Wrote marker: %s/%s\n' "$repo_dir" "$secret_audit_marker_relpath"
    fi
    return 0
  fi

  scan_rc=0
  secret_audit_run_github_repo_scan "$slug" "$sa_results_filter" || scan_rc=$?
  if (( scan_rc != 0 )); then
    return "$scan_rc"
  fi
  if [[ "$sa_write_marker" -eq 1 ]]; then
    die '--write-marker requires a local clone under GITHUB_REPO_LINT_SCAN_ROOT or cwd'
  fi
  return 0
}

# Org-wide github scan. On failure: do not write markers. On success: refresh
# markers only for local clones that already exist (remote-only repos need a
# local clone for --write-marker). Local refresh leaks fail closed (exit 183);
# one broken clone origin must not abort the rest of the sweep.
sa_scan_all_repos() {
  local slug scan_rc name repo_dir git_tip saw_leak

  # Consumed by rp_discover_org_repos (sourced lib).
  # shellcheck disable=SC2034
  rp_include_private="$sa_include_private"

  if [[ "$sa_dry_run" -eq 1 ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf 'DRY-RUN: would deep-scan %s/%s\n' "$sa_org" "$name"
    done < <(rp_discover_org_repos "$sa_org")
    return 0
  fi

  secret_audit_install_trufflehog || die 'trufflehog install failed'
  PATH="${SECRET_AUDIT_BIN_DIR}:${PATH}"
  export PATH

  scan_rc=0
  secret_audit_run_github_org_scan "$sa_org" "$sa_results_filter" || scan_rc=$?
  if (( scan_rc != 0 )); then
    # Never refresh clean markers when the org scan reported leaks or failed.
    return "$scan_rc"
  fi

  if [[ "$sa_write_marker" -ne 1 ]]; then
    return 0
  fi

  # Marker refresh is local-clone only, and only after a clean *local* git scan so
  # the attested git_tip matches history we actually walked (not an unscanned tip).
  saw_leak=0
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    slug="${sa_org}/${name}"
    repo_dir="$(rp_resolve_local_repo_dir "$slug" || true)"
    if [[ -z "$repo_dir" || ! -d "$repo_dir" ]]; then
      continue
    fi
    if ! secret_audit_ensure_full_clone "$repo_dir"; then
      printf 'WARN: skipping marker for %s (full-clone ensure failed)\n' "$slug" >&2
      continue
    fi
    scan_rc=0
    secret_audit_run_git_scan "$repo_dir" "$sa_results_filter" || scan_rc=$?
    if (( scan_rc != 0 )); then
      printf 'WARN: skipping marker for %s (local scan exit=%s)\n' "$slug" "$scan_rc" >&2
      # shellcheck disable=SC2154  # assigned in sourced scripts/lib/secret-audit
      if (( scan_rc == secret_audit_trufflehog_leak_exit )); then
        saw_leak=1
      fi
      continue
    fi
    git_tip="$(runner_exec_stdout "secret-audit git rev-parse HEAD" -- git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n "$git_tip" ]]; then
      secret_audit_write_marker "$repo_dir" "$git_tip" "$sa_results_filter"
      # shellcheck disable=SC2154
      printf 'Wrote marker: %s/%s\n' "$repo_dir" "$secret_audit_marker_relpath"
    fi
  done < <(rp_discover_org_repos "$sa_org")

  if (( saw_leak == 1 )); then
    # shellcheck disable=SC2154
    return "$secret_audit_trufflehog_leak_exit"
  fi
  return 0
}

main() {
  local slug scan_rc total_fail saw_leak

  parse_args "$@"

  if [[ "$sa_scan_all" -eq 1 ]]; then
    sa_scan_all_repos
    exit $?
  fi

  if [[ ${#sa_repo_slugs[@]} -eq 0 ]]; then
    slug="$(rp_resolve_git_context_slug || true)"
    if [[ -z "$slug" ]]; then
      die 'Specify --repo OWNER/NAME, --all, or run inside a git clone'
    fi
    sa_repo_slugs=("$slug")
  fi

  total_fail=0
  saw_leak=0
  for slug in "${sa_repo_slugs[@]}"; do
    scan_rc=0
    sa_scan_one_repo "$slug" || scan_rc=$?
    # shellcheck disable=SC2154  # assigned in sourced scripts/lib/secret-audit
    if (( scan_rc == secret_audit_trufflehog_leak_exit )); then
      saw_leak=1
    elif (( scan_rc != 0 )); then
      total_fail=$((total_fail + 1))
    fi
  done
  if (( saw_leak == 1 )); then
    # shellcheck disable=SC2154  # assigned in sourced scripts/lib/secret-audit
    exit "$secret_audit_trufflehog_leak_exit"
  fi
  exit "$total_fail"
}

main "$@"
