#!/usr/bin/env bash
# Poll GitHub for agent pull-request review state (default: Copilot).
#
# Subcommands:
#   status              JSON status for the configured agent
#   request             Ask the agent to review (idempotent)
#   wait                Block until the agent posts a review for the current head
#   list-threads        Print agent threads still needing a human reply (JSON)
#   list-human-threads  Print human reviewer threads still needing a reply (JSON)
#   check               Exit 0 when complete_ready or PR merged
#   complete            Approve PR + email operator (only when agent review is empty)
#   restack             Sync and restack when mergeStateStatus is BEHIND
#   resolve-thread      Resolve one thread by GraphQL node id
#   resolve-addressed   Resolve agent threads that already have a human reply
#   resolve-human-addressed  Resolve human threads that already have a reply
#   email-failure       Email operator that the agent loop timed out
#   give-up             Email + PR comment that the agent loop is stopping
#   loop                Run request/wait/check until complete, triage needed, or timeout
#
# See .cursor/rules/pr-ship-and-review.mdc for the full loop.
# shellcheck disable=SC2016  # jq filter strings passed to ar_runner_jq_file helpers
set -euo pipefail

agent_review_loop_fallback_index=0
agent_review_loop_notified=0
agent_review_loop_stop_reason_code=''
agent_review_loop_stop_reason_detail=''

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for lib runner_exec calls
source "${script_dir}/lib/runner-bootstrap"

# shellcheck disable=SC1091  # shared libs sourced at runtime from scripts/lib
source "${script_dir}/lib/agent-review"
# shellcheck disable=SC1091  # shared libs sourced at runtime from scripts/lib
source "${script_dir}/lib/agent-review-email"

wait_ar_jq_status() {
  local -r json="$1"
  local -r filter="$2"
  ar_runner_jq_file "wait-for-agent-review jq status" "$json" -r "$filter"
}

wait_ar_jq_snapshot() {
  local -r json="$1"
  local -r filter="$2"
  ar_runner_jq_file "wait-for-agent-review jq snapshot" "$json" -r "$filter"
}

wait_ar_jq_check_state() {
  local -r json="$1"
  local -r filter="$2"
  ar_runner_jq_file "wait-for-agent-review jq check state" "$json" -r "$filter"
}


usage() {
  cat <<'EOF'
Usage: scripts/wait-for-agent-review <command> [options]

Commands:
  status [--pr N] [--repo OWNER/NAME]
  request [--pr N] [--repo OWNER/NAME]
  wait [--pr N] [--repo OWNER/NAME] [--timeout SECONDS] [--poll-interval SECONDS]
  list-threads [--pr N] [--repo OWNER/NAME]
  list-human-threads [--pr N] [--repo OWNER/NAME]
  check [--pr N] [--repo OWNER/NAME]
  complete [--pr N] [--repo OWNER/NAME]
  restack [--pr N] [--repo OWNER/NAME]
  resolve-thread --thread-id ID
  resolve-addressed [--pr N] [--repo OWNER/NAME]
  resolve-human-addressed [--pr N] [--repo OWNER/NAME]
  email-failure [--pr N] [--repo OWNER/NAME] [--reason TEXT]
  give-up [--pr N] [--repo OWNER/NAME] [--reason TEXT]
  loop [--pr N] [--repo OWNER/NAME]

Environment:
  AGENT_REVIEW_AGENT            Agent profile name (default: copilot)
  AGENT_REVIEW_FALLBACK_AGENT   First quota fallback when chain unset (default: bugbot)
  AGENT_REVIEW_QUOTA_FALLBACK_CHAIN  Comma-separated quota fallbacks (default: bugbot,coderabbit)
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE  Daily Copilot quota cache (default: ~/scratch/repository-helpers/copilot-review-quota.env)
  AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE   Daily Bugbot usage cache (default: ~/scratch/repository-helpers/bugbot-review-quota.env)
  AGENT_REVIEW_GITHUB_REPO      Default repo (OWNER/NAME; else git remote origin)
  AGENT_REVIEW_PR_NUMBER        Default PR number when --pr is omitted
  AGENT_REVIEW_REPORT_TO        Operator email recipient (required for complete/email-failure)
  AGENT_REVIEW_REPORT_FROM      Email sender (required for complete/email-failure)
  AGENT_REVIEW_CYCLE_TIMEOUT    Per review-request cycle cap (default: 30m)
  AGENT_REVIEW_PR_TIMEOUT       Overall PR agent review cap (default: 12h)
  AGENT_REVIEW_IDLE_BREAK_TIMEOUT  Idle break when all quotas exhausted (default: 15m)
  AGENT_REVIEW_BOT_LOGIN_REGEX  Bot logins excluded from human thread triage
  AGENT_REVIEW_LOOP_TIMEOUT     Deprecated alias for AGENT_REVIEW_CYCLE_TIMEOUT
  AGENT_REVIEW_ENV_FILE         Config file (default: ~/.config/agent-review.env)
  DEP_UPDATER_SMTP_HOST         SMTP host (from dep-updater.env or agent-review.env)

Exit codes:
  0  success / complete_ready / PR merged
  1  usage / prerequisite error
  2  timed out waiting for agent review (wait) or not fresh on head (check)
  3  agent or human review threads still lack a reply (check; JSON on stdout)
  4  mergeStateStatus is BEHIND/DIRTY/CONFLICTING (run restack)
  5  fresh review but agent did not report "no new comments" yet (check/complete)
  6  loop give-up (cycle or PR timeout; email + PR comment posted)
  7  agent review quota exhausted with no fallback (give-up email + PR comment posted)
  8  agent GitHub check failed to run (non-quota; see check output on PR)
  9  wait idle break — no PR activity with all agent quotas exhausted (loop continues to check)
 10  required CI checks failed (fix CI before agent review or thread triage)

Non-success loop exits (2–8, 10, and other failures) email AGENT_REVIEW_REPORT_TO and post a PR
comment when the loop command exits. Success (0 after complete, or PR merged) sends no failure notify.
Give-up paths (6/7) notify once inside give-up; the loop epilogue skips duplicate email.
EOF
}

cmd_status() {
  local repo pr owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  agent_review_status_json_from_snapshot "${snapshot}" "${repo}" "${pr}"
}

cmd_loop_abort_if_ci_failed() {
  local repo pr ci_rc

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  ci_rc=0
  agent_review_ci_check_for_pr "${repo}" "${pr}" || ci_rc=$?
  if (( ci_rc == 1 )); then
    agent_review_print_ci_failures "${repo}" "${pr}"
    return 10
  fi
  if (( ci_rc == 2 )); then
    return 2
  fi
  return 0
}

agent_review_loop_set_stop() {
  agent_review_loop_stop_reason_code="${1:-}"
  agent_review_loop_stop_reason_detail="${2:-}"
}

agent_review_loop_default_stop_for_exit() {
  local -r exit_code="$1"

  case "${exit_code}" in
    2)
      agent_review_loop_set_stop 'NO_FRESH_REVIEW_AFTER_IDLE_BREAK' \
        'No fresh agent review on the current PR head.'
      ;;
    3)
      agent_review_loop_set_stop 'THREADS_PENDING' \
        'Review threads still need a reply or resolve (bot and human).'
      ;;
    4)
      agent_review_loop_set_stop 'RESTACK_FAILED' \
        'Branch is BEHIND or restack failed — human intervention required.'
      ;;
    6)
      agent_review_loop_set_stop 'TIMEOUT' \
        'Agent review loop timed out.'
      ;;
    7)
      agent_review_loop_set_stop 'QUOTA_EXHAUSTED' \
        'Agent review quota or usage limit exhausted with no fallback.'
      ;;
    8)
      agent_review_loop_set_stop 'AGENT_CHECK_ERROR' \
        'Agent GitHub check failed to run (non-quota).'
      ;;
    10)
      agent_review_loop_set_stop 'CI_FAILED' \
        'Required CI checks failed.'
      ;;
    *)
      agent_review_loop_set_stop 'LOOP_STOPPED' \
        "Agent review loop stopped (exit ${exit_code})."
      ;;
  esac
}

agent_review_loop_status_context_json() {
  local -r repo="$1"
  local -r pr="$2"
  local status

  status="$(cmd_status "${repo}" "${pr}" 2>/dev/null || true)"
  if [[ -z "${status}" ]]; then
    printf '{}'
    return 0
  fi
  ar_runner_jq_file "wait-for-agent-review status context" "$status" -c '{
    pending_threads: (.pending_threads // 0),
    head_sha: (.head_sha // ""),
    ci_conclusion: (.ci_conclusion // "")
  }' 2>/dev/null || printf '{}'
}

agent_review_loop_notify_stopped() {
  local -r repo="$1"
  local -r pr="$2"
  local -r exit_code="$3"
  local reason_code reason_detail context_json

  reason_code="${agent_review_loop_stop_reason_code}"
  reason_detail="${agent_review_loop_stop_reason_detail}"
  if [[ -z "${reason_code}" ]] || [[ -z "${reason_detail}" ]]; then
    agent_review_loop_default_stop_for_exit "${exit_code}"
    reason_code="${agent_review_loop_stop_reason_code}"
    reason_detail="${agent_review_loop_stop_reason_detail}"
  fi
  context_json="$(agent_review_loop_status_context_json "${repo}" "${pr}")"
  agent_review_require_cmd gh
  if ! agent_review_email_loop_stopped \
      "${repo}" "${pr}" "${exit_code}" "${reason_code}" "${reason_detail}" "${context_json}"; then
    printf 'wait-for-agent-review: loop-stopped email failed (continuing with PR comment)\n' >&2
  fi
  if ! agent_review_post_loop_stopped_comment \
      "${repo}" "${pr}" "${exit_code}" "${reason_code}" "${reason_detail}"; then
    printf 'wait-for-agent-review: loop-stopped PR comment failed\n' >&2
  fi
}

cmd_loop_exit_notify() {
  local -r repo="$1"
  local -r pr="$2"
  local -r exit_code="$3"

  if (( exit_code == 0 )); then
    return 0
  fi
  if (( agent_review_loop_notified == 1 )); then
    return 0
  fi
  agent_review_loop_notify_stopped "${repo}" "${pr}" "${exit_code}"
}

cmd_request() {
  local repo pr owner name snapshot request_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  if agent_review_pr_is_merged "${repo}" "${pr}"; then
    printf 'PR #%s is already merged — skipping agent request\n' "${pr}" >&2
    return 0
  fi
  if agent_review_agent_quota_skip_request; then
    return 7
  fi
  if [[ "${agent_review_profile_auto_review:-false}" == 'true' ]]; then
    printf 'wait-for-agent-review: %s reviews run automatically — skipping manual request on PR #%s\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
    return 0
  fi
  snapshot="$(agent_review_graphql_request_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_review_requests_complete "${snapshot}"
  if agent_review_agent_requested_from_snapshot "${snapshot}"; then
    printf '%s review already requested on PR #%s\n' "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
    return 0
  fi
  request_exit=0
  agent_review_profile_request "${repo}" "${pr}" || request_exit=$?
  if (( request_exit == 7 )); then
    agent_review_agent_quota_mark_exhausted \
      "${AGENT_REVIEW_AGENT:-copilot} review request blocked by quota or usage limits (see gh stderr above)."
    return 7
  fi
  if (( request_exit != 0 )); then
    agent_review_die 'failed to request agent review'
  fi
  agent_review_mark_profile_requested
  printf 'Requested %s review on PR #%s\n' "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
}

cmd_wait() {
  local repo pr timeout interval owner name head started snapshot review_body check_state_json check_state quota_hit
  local last_activity now_epoch idle_break idle_s ci_rc

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  timeout="${3:-${agent_review_default_wait_timeout_s}}"
  interval="${4:-${agent_review_default_poll_interval_s}}"
  agent_review_validate_positive_int --timeout "${timeout}"
  agent_review_validate_positive_int --poll-interval "${interval}"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  # shellcheck disable=SC2154  # agent_review_default_idle_break_s from sourced lib
  idle_break="${agent_review_default_idle_break_s}"
  started="$(date +%s)"
  last_activity=0
  while true; do
    if agent_review_pr_is_merged "${repo}" "${pr}"; then
      printf 'PR #%s is already merged — stopping wait\n' "${pr}" >&2
      return 0
    fi
    ci_rc=0
    agent_review_ci_check_for_pr "${repo}" "${pr}" || ci_rc=$?
    if (( ci_rc == 1 )); then
      agent_review_print_ci_failures "${repo}" "${pr}"
      return 10
    fi
    snapshot="$(agent_review_graphql_wait_snapshot "${owner}" "${name}" "${pr}")"
    head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid')"
    now_epoch="$(agent_review_last_activity_epoch_from_snapshot "${snapshot}")"
    if (( now_epoch > last_activity )); then
      last_activity="${now_epoch}"
    fi
    if agent_review_all_quotas_exhausted \
      || agent_review_agent_quota_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}"; then
      if (( last_activity > 0 )); then
        idle_s=$(( $(date +%s) - last_activity ))
      else
        idle_s=$(( $(date +%s) - started ))
      fi
      if (( idle_s >= idle_break )); then
        if agent_review_all_quotas_exhausted; then
          printf 'wait-for-agent-review: idle break — no PR activity for %ss with all agent quotas exhausted (PR #%s)\n' \
            "${idle_s}" "${pr}" >&2
        else
          printf 'wait-for-agent-review: idle break — no PR activity for %ss with %s quota exhausted (PR #%s)\n' \
            "${idle_s}" "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
        fi
        return 9
      fi
    fi
    if agent_review_skip_wait_for_quota_exhausted_agent "${snapshot}" "${head}" "${repo}"; then
      printf 'wait-for-agent-review: %s daily quota exhausted — skipping wait for pending review/check (PR #%s)\n' \
        "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
      return 7
    fi
    if agent_review_fresh_agent_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
      if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
        review_body="$(agent_review_latest_agent_review_body_on_head "${snapshot}" "${head}")"
        if agent_review_profile_review_is_quota_exhausted "${review_body}"; then
          case "${AGENT_REVIEW_AGENT:-copilot}" in
            copilot)
              agent_review_copilot_quota_mark_exhausted \
                "Copilot review on head ${head:0:7} reports quota exhaustion (PR #${pr})."
              ;;
            bugbot)
              agent_review_bugbot_quota_mark_exhausted \
                "Bugbot review on head ${head:0:7} reports usage limit reached (PR #${pr})."
              ;;
            coderabbit)
              agent_review_coderabbit_quota_mark_exhausted \
                "CodeRabbit review on head ${head:0:7} reports usage limit reached (PR #${pr})."
              ;;
          esac
          printf '%s review on head %s reports quota exhaustion (PR #%s)\n' \
            "${AGENT_REVIEW_AGENT:-copilot}" "${head:0:7}" "${pr}" >&2
          return 7
        fi
        printf '%s review posted for head %s (PR #%s)\n' \
          "${AGENT_REVIEW_AGENT:-copilot}" "${head:0:7}" "${pr}" >&2
        return 0
      fi
      if [[ "${agent_review_profile_uses_head_check:-false}" == 'true' ]]; then
        check_state_json="$(agent_review_head_check_state_json "${repo}" "${head}")"
        quota_hit="$(wait_ar_jq_check_state "$check_state_json" '.quota')"
        if [[ "${quota_hit}" == 'true' ]]; then
          agent_review_agent_quota_mark_exhausted \
            "Bugbot check on head ${head:0:7} reports usage limit reached (PR #${pr})."
          printf '%s GitHub check reports usage limit for head %s (PR #%s)\n' \
            "${AGENT_REVIEW_AGENT:-copilot}" "${head:0:7}" "${pr}" >&2
          return 7
        fi
        check_state="$(wait_ar_jq_check_state "$check_state_json" 'if .error then "error" elif .clean then "clean" elif .findings then "findings" else .conclusion end')"
        printf '%s GitHub check completed (%s) for head %s (PR #%s)\n' \
          "${AGENT_REVIEW_AGENT:-copilot}" "${check_state}" "${head:0:7}" "${pr}" >&2
        return 0
      fi
    fi
    if (( $(date +%s) - started >= timeout )); then
      if agent_review_agent_quota_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
        || agent_review_all_quotas_exhausted; then
        if (( last_activity > 0 )); then
          idle_s=$(( $(date +%s) - last_activity ))
        else
          idle_s=$(( $(date +%s) - started ))
        fi
        if (( idle_s >= idle_break )); then
          printf 'wait-for-agent-review: idle break at wait timeout — no PR activity for %ss with %s quota exhausted (PR #%s)\n' \
            "${idle_s}" "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
          return 9
        fi
        printf 'wait-for-agent-review: %s daily quota exhausted — ending wait at cycle timeout (PR #%s)\n' \
          "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
        return 7
      fi
      printf 'ERROR: WAIT_TIMEOUT wait-for-agent-review pr=%s head=%s waited=%ss timeout=%ss agent=%s\n' \
        "${pr}" "${head:0:7}" "$(( $(date +%s) - started ))" "${timeout}" "${AGENT_REVIEW_AGENT:-copilot}" >&2
      return 2
    fi
    printf 'Waiting for %s review on PR #%s (head %s)…\n' "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" "${head:0:7}" >&2
    sleep "${interval}"
  done
}

cmd_list_threads() {
  local repo pr owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  agent_review_threads_json_from_snapshot "${snapshot}"
}

cmd_list_human_threads() {
  local repo pr owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  agent_review_human_threads_json_from_snapshot "${snapshot}"
}

cmd_check() {
  local repo pr owner name snapshot status complete_ready fresh merge_state pr_merged agent_empty agent_quota
  local head_check_error head_check_findings head review_body all_quotas_exhausted pending_count

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  status="$(agent_review_status_json_from_snapshot "${snapshot}" "${repo}" "${pr}")"
  pr_merged="$(wait_ar_jq_status "$status" '.pr_merged')"
  if [[ "${pr_merged}" == 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: PR #%s is merged — loop complete\n' "${pr}" >&2
    return 0
  fi
  if [[ "$(wait_ar_jq_status "$status" '.ci_conclusion // ""')" == 'failure' ]]; then
    agent_review_print_ci_failures "${repo}" "${pr}"
    printf '%s\n' "${status}" >&2
    return 10
  fi
  complete_ready="$(wait_ar_jq_status "$status" '.complete_ready')"
  all_quotas_exhausted="$(wait_ar_jq_status "$status" '.all_quotas_exhausted')"
  pending_count="$(agent_review_pending_thread_count_from_snapshot "${snapshot}")"
  fresh="$(wait_ar_jq_status "$status" '.fresh_review_on_head')"
  agent_empty="$(wait_ar_jq_status "$status" '.agent_review_empty')"
  agent_quota="$(wait_ar_jq_status "$status" '.agent_quota_exhausted')"
  head_check_error="$(wait_ar_jq_status "$status" '.head_check_error')"
  head_check_findings="$(wait_ar_jq_status "$status" '.head_check_findings')"
  merge_state="$(wait_ar_jq_status "$status" '.merge_state_status')"
  if [[ "${complete_ready}" == 'true' ]]; then
    printf '%s\n' "${status}"
    return 0
  fi
  if (( pending_count > 0 )); then
    printf '%s\n' "${status}" >&2
    agent_review_triage_threads_json_from_snapshot "${snapshot}"
    printf 'wait-for-agent-review: %s review thread(s) still need a reply or resolve (bot and human)\n' \
      "${pending_count}" >&2
    return 3
  fi
  if [[ "${agent_quota}" == 'true' ]] && [[ "${all_quotas_exhausted}" != 'true' ]]; then
    agent_review_agent_quota_mark_exhausted \
      "${AGENT_REVIEW_AGENT:-copilot} review on the current PR head reports quota or usage limit exhaustion."
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s review quota or usage limit exhausted on current head\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 7
  fi
  if [[ "${head_check_error}" == 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s GitHub check failed to run (see check output on PR)\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 8
  fi
  if [[ "${fresh}" != 'true' ]]; then
    printf '%s\n' "${status}"
    return 2
  fi
  if [[ "${head_check_findings}" == 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s GitHub check reports findings — review comments expected on PR\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 5
  fi
  if ! agent_review_merge_state_ready "${merge_state}"; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: mergeStateStatus=%s — run restack (BEHIND) or fix conflicts\n' \
      "${merge_state}" >&2
    return 4
  fi
  if [[ "${agent_empty}" != 'true' ]]; then
    if [[ "${AGENT_REVIEW_AGENT:-copilot}" == 'coderabbit' ]] \
      && [[ "$(wait_ar_jq_status "$status" '.pending_threads // 0')" == '0' ]]; then
      head="$(wait_ar_jq_status "$status" '.head_sha')"
      review_body="$(agent_review_latest_agent_review_body_on_head "${snapshot}" "${head}")"
      if agent_review_profile_review_has_body_feedback "${review_body}"; then
        printf '%s\n' "${status}" >&2
        printf 'wait-for-agent-review: CodeRabbit review on head %s has actionable summary feedback — triage required\n' \
          "${head:0:7}" >&2
        return 3
      fi
    fi
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s reviewed head but did not report "no new comments" yet\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 5
  fi
  printf '%s\n' "${status}"
  return 0
}

cmd_complete() {
  local repo pr status complete_ready gh_user existing pr_merged reviews_json

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  if agent_review_pr_is_merged "${repo}" "${pr}"; then
    printf 'PR #%s is already merged — skipping approve/email\n' "${pr}" >&2
    return 0
  fi
  status="$(cmd_status "${repo}" "${pr}")"
  pr_merged="$(wait_ar_jq_status "$status" '.pr_merged')"
  if [[ "${pr_merged}" == 'true' ]]; then
    printf 'PR #%s is already merged — skipping approve/email\n' "${pr}" >&2
    return 0
  fi
  complete_ready="$(wait_ar_jq_status "$status" '.complete_ready')"
  if [[ "${complete_ready}" != 'true' ]]; then
    agent_review_die 'complete requires agent and human review empty on current head with no unaddressed threads'
  fi
  gh_user="$(ar_runner_gh_api_stream "gh api user login" user --jq '.login')"
  reviews_json="$(ar_runner_gh_pr_jq "wait-for-agent-review pr reviews" "${repo}" "${pr}" reviews)"
  existing="$(ar_runner_jq_file "wait-for-agent-review last user review state" "${reviews_json}" \
    -r --arg user "${gh_user}" '
      [.reviews[]
        | select(.author.login == $user)
        | select(.state != "PENDING")
        | {state, submittedAt}]
      | sort_by(.submittedAt)
      | last
      | .state // empty')"
  if [[ "${existing}" != 'APPROVED' ]]; then
    runner_exec "wait-for-agent-review pr approve" -- gh pr review "${pr}" --repo "${repo}" --approve \
      --body "Agent review (${AGENT_REVIEW_AGENT:-copilot}): no new comments on current head."
    printf 'Approved PR #%s as %s\n' "${pr}" "${gh_user}" >&2
  else
    printf 'PR #%s already approved by %s — skipping approve\n' "${pr}" "${gh_user}" >&2
  fi
  agent_review_email_complete "${repo}" "${pr}"
}

cmd_resolve_thread() {
  local -r thread_id="${1:-}"

  if [[ -z "${thread_id}" ]]; then
    agent_review_die 'resolve-thread requires --thread-id'
  fi
  agent_review_require_cmd gh
  agent_review_resolve_thread_id "${thread_id}"
  printf 'Resolved thread %s\n' "${thread_id}" >&2
}

cmd_resolve_addressed() {
  local repo pr owner name snapshot ids id needs_resolve_json

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  needs_resolve_json="$(agent_review_agent_threads_needs_resolve_json_from_snapshot "${snapshot}")"
  mapfile -t ids < <(
    ar_runner_jq_file "wait-for-agent-review agent addressed thread ids" "${needs_resolve_json}" \
      -r '.[].thread_id'
  )
  if ((${#ids[@]} == 0)); then
    printf 'No addressed agent threads to resolve on PR #%s\n' "${pr}" >&2
    return 0
  fi
  for id in "${ids[@]}"; do
    agent_review_resolve_thread_id "${id}"
    printf 'Resolved thread %s\n' "${id}" >&2
  done
}

cmd_resolve_human_addressed() {
  local repo pr owner name snapshot ids id needs_resolve_json

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  needs_resolve_json="$(agent_review_human_threads_needs_resolve_json_from_snapshot "${snapshot}")"
  mapfile -t ids < <(
    ar_runner_jq_file "wait-for-agent-review human addressed thread ids" "${needs_resolve_json}" \
      -r '.[].thread_id'
  )
  if ((${#ids[@]} == 0)); then
    printf 'No addressed human review threads to resolve on PR #%s\n' "${pr}" >&2
    return 0
  fi
  for id in "${ids[@]}"; do
    agent_review_resolve_thread_id "${id}"
    printf 'Resolved human thread %s\n' "${id}" >&2
  done
}

cmd_restack() {
  local repo pr merge_state head_branch pr_head_branch attempt base_branch pr_fields_json

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd gt
  agent_review_require_cmd git
  if agent_review_pr_is_merged "${repo}" "${pr}"; then
    printf 'PR #%s is already merged — skipping restack\n' "${pr}" >&2
    return 0
  fi
  agent_review_assert_checkout_matches_repo "${repo}"
  agent_review_assert_not_primary_worktree
  pr_fields_json="$(ar_runner_gh_pr_jq "wait-for-agent-review pr restack fields" "${repo}" "${pr}" \
    "headRefName,mergeStateStatus,baseRefName")"
  head_branch="$(ar_runner_jq_file "wait-for-agent-review headRefName" "${pr_fields_json}" \
    -r '.headRefName')"
  pr_head_branch="$(runner_exec_stdout "wait-for-agent-review git current branch" \
    -- git branch --show-current || true)"
  if [[ -z "${pr_head_branch}" ]] || [[ "${pr_head_branch}" != "${head_branch}" ]]; then
    agent_review_die "current branch ${pr_head_branch@Q} is not PR #${pr} head ${head_branch@Q}"
  fi
  merge_state="$(ar_runner_jq_file "wait-for-agent-review mergeStateStatus" "${pr_fields_json}" \
    -r '.mergeStateStatus')"
  if [[ "${merge_state}" != 'BEHIND' ]]; then
    if agent_review_merge_state_ready "${merge_state}"; then
      printf 'PR #%s mergeStateStatus=%s (no restack needed)\n' "${pr}" "${merge_state}" >&2
      return 0
    fi
    printf 'PR #%s mergeStateStatus=%s — cannot restack (resolve conflicts or fix merge state)\n' \
      "${pr}" "${merge_state}" >&2
    return 4
  fi
  base_branch="$(ar_runner_jq_file "wait-for-agent-review baseRefName" "${pr_fields_json}" \
    -r '.baseRefName')"
  printf 'PR #%s is BEHIND %s — running gt sync and gt restack…\n' "${pr}" "${base_branch}" >&2
  if ! runner_exec "wait-for-agent-review gt sync" -- gt sync; then
    printf 'gt sync failed during restack for PR #%s\n' "${pr}" >&2
    return 4
  fi
  if ! runner_exec "wait-for-agent-review gt restack" -- gt restack; then
    printf 'gt restack failed for PR #%s\n' "${pr}" >&2
    return 4
  fi
  if ! runner_exec "wait-for-agent-review gt submit after restack" -- gt submit --no-interactive --publish; then
    printf 'gt submit failed after restack for PR #%s\n' "${pr}" >&2
    return 4
  fi
  attempt=0
  while (( attempt < 12 )); do
    pr_fields_json="$(ar_runner_gh_pr_jq "wait-for-agent-review pr merge state poll" "${repo}" "${pr}" \
      mergeStateStatus)"
    merge_state="$(ar_runner_jq_file "wait-for-agent-review mergeStateStatus poll" "${pr_fields_json}" \
      -r '.mergeStateStatus')"
    if [[ "${merge_state}" != 'BEHIND' ]]; then
      if agent_review_merge_state_ready "${merge_state}"; then
        printf 'After restack: mergeStateStatus=%s\n' "${merge_state}" >&2
        return 0
      fi
      printf 'After restack: mergeStateStatus=%s — still not merge-ready\n' "${merge_state}" >&2
      return 4
    fi
    sleep 5
    attempt=$((attempt + 1))
  done
  printf 'ERROR: WAIT_TIMEOUT restack pr=%s waited=60s\n' "${pr}" >&2
  return 4
}

cmd_handle_quota_exhaustion() {
  local repo pr reason fallback_exit from_agent

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  reason="${3:-Agent review quota exhausted.}"
  from_agent="${AGENT_REVIEW_AGENT:-copilot}"

  if [[ "${from_agent}" == 'coderabbit' ]]; then
    cmd_give_up "${repo}" "${pr}" \
      "${reason} No further automated reviews are available." quota
    return $?
  fi
  fallback_exit=0
  cmd_try_quota_fallback "${repo}" "${pr}" "${from_agent}" "${reason}" || fallback_exit=$?
  return "${fallback_exit}"
}

cmd_try_quota_fallback() {
  local repo pr from_agent reason fallback_agent profile_path profiles_dir

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  from_agent="${3:-copilot}"
  reason="${4:-Agent review quota exhausted.}"

  profiles_dir="$(cd "${script_dir}/lib/agent-review-profiles" && pwd)"
  while true; do
    if ! fallback_agent="$(agent_review_quota_fallback_agent_at "${agent_review_loop_fallback_index}")"; then
      cmd_give_up "${repo}" "${pr}" \
        "${reason} No further automated reviews are available." quota
      return $?
    fi
    agent_review_loop_fallback_index=$(( agent_review_loop_fallback_index + 1 ))
    profile_path="${profiles_dir}/${fallback_agent}"
    if [[ ! -f "${profile_path}" ]]; then
      cmd_give_up "${repo}" "${pr}" \
        "${reason} Fallback profile ${fallback_agent@Q} is not installed." quota
      return $?
    fi
    if agent_review_agent_quota_exhausted_for_agent "${fallback_agent}"; then
      printf 'wait-for-agent-review: skipping fallback to %s — daily quota exhausted\n' \
        "${fallback_agent}" >&2
      continue
    fi
    break
  done
  printf 'wait-for-agent-review: %s — falling back to %s\n' \
    "${reason}" "${fallback_agent}" >&2
  if ! agent_review_post_fallback_comment \
      "${repo}" "${pr}" "${reason}" "${from_agent}" "${fallback_agent}"; then
    printf 'wait-for-agent-review: fallback PR comment failed (continuing with %s)\n' \
      "${fallback_agent}" >&2
  fi
  agent_review_use_agent "${fallback_agent}"
  return 0
}

cmd_give_up() {
  local repo pr reason mode error_tag exit_code pending_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  reason="${3:-Agent review loop stopped without reaching complete_ready.}"
  mode="${4:-}"
  pending_exit=0
  agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
  if (( pending_exit == 3 )); then
    agent_review_loop_set_stop 'THREADS_PENDING' \
      'Review threads still need a reply or resolve (bot and human).'
    return 3
  fi
  agent_review_require_cmd gh
  if [[ "${mode}" == 'quota' ]]; then
    if ! agent_review_email_loop_stopped \
        "${repo}" "${pr}" 7 QUOTA_EXHAUSTED "${reason}" '{}'; then
      printf 'wait-for-agent-review: give-up email failed (continuing with PR comment)\n' >&2
    fi
  else
    if ! agent_review_email_loop_stopped \
        "${repo}" "${pr}" 6 TIMEOUT "${reason}" '{}'; then
      printf 'wait-for-agent-review: give-up email failed (continuing with PR comment)\n' >&2
    fi
  fi
  if ! agent_review_post_give_up_comment "${repo}" "${pr}" "${reason}" "${mode}"; then
    printf 'wait-for-agent-review: give-up PR comment failed\n' >&2
  fi
  agent_review_loop_notified=1
  if [[ "${mode}" == 'quota' ]]; then
    error_tag='AGENT_REVIEW_QUOTA_EXHAUSTED'
    exit_code=7
  else
    error_tag='WAIT_TIMEOUT agent-review-give-up'
    exit_code=6
  fi
  printf 'ERROR: %s pr=%s repo=%s reason=%s\n' \
    "${error_tag}" "${pr}" "${repo}" "${reason}" >&2
  return "${exit_code}"
}

cmd_loop_finish_quota() {
  local repo pr reason

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  reason="${3:-Agent review quota exhausted.}"
  cmd_give_up "${repo}" "${pr}" \
    "${reason} No further automated reviews are available." quota
  return $?
}

# Resolve wait stall (cycle cap or wait timeout) without TIMEOUT give-up when quota is
# exhausted or review threads / complete_ready allow human handoff. Returns 99 to break
# the inner request/wait loop and continue quota-skip or fallback monitoring.
cmd_loop_resolve_wait_stall() {
  local repo pr reason check_exit pending_exit fallback_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  reason="${3:-Agent review wait stalled.}"

  pending_exit=0
  agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
  if (( pending_exit == 3 )); then
    agent_review_loop_set_stop 'THREADS_PENDING' \
      'Review threads still need a reply or resolve (bot and human).'
    return 3
  fi

  check_exit=0
  cmd_check "${repo}" "${pr}" || check_exit=$?
  case "${check_exit}" in
    0)
      cmd_complete "${repo}" "${pr}"
      return 0
      ;;
    3)
      agent_review_loop_set_stop 'THREADS_PENDING' \
        'Review threads still need a reply or resolve (bot and human).'
      return 3
      ;;
    4)
      if ! cmd_restack "${repo}" "${pr}"; then
        agent_review_loop_set_stop 'RESTACK_FAILED' \
          'Branch is BEHIND or restack failed — human intervention required.'
        return 4
      fi
      return 99
      ;;
    7)
      fallback_exit=0
      cmd_handle_quota_exhaustion "${repo}" "${pr}" \
        "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted while waiting for a review." \
        || fallback_exit=$?
      if (( fallback_exit == 0 )); then
        return 99
      fi
      cmd_loop_finish_quota "${repo}" "${pr}" \
        "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted while waiting for a review."
      return $?
      ;;
    10)
      agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
      return 10
      ;;
  esac

  if agent_review_agent_quota_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
    || agent_review_all_quotas_exhausted; then
    if ! agent_review_activate_first_requestable_agent >/dev/null; then
      printf 'wait-for-agent-review loop: %s — all agent quotas exhausted; continuing CI and thread checks (PR #%s)\n' \
        "${reason}" "${pr}" >&2
      return 99
    fi
    fallback_exit=0
    cmd_handle_quota_exhaustion "${repo}" "${pr}" \
      "${reason} Active agent quota exhausted — switching fallback before another wait cycle." \
      || fallback_exit=$?
    if (( fallback_exit == 0 )); then
      return 99
    fi
    cmd_loop_finish_quota "${repo}" "${pr}" \
      "${reason} Active agent quota exhausted with no fallback available."
    return $?
  fi

  cmd_give_up "${repo}" "${pr}" "${reason}"
  return $?
}

# When every agent quota is exhausted, skip review requests and poll CI + check instead.
# Returns 99 to continue the outer loop; other codes match cmd_loop inner dispatch.
cmd_loop_quota_skip_tick() {
  local repo pr check_exit ci_exit pending_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"

  ci_exit=0
  cmd_loop_abort_if_ci_failed "${repo}" "${pr}" || ci_exit=$?
  if (( ci_exit == 10 )); then
    agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
    return 10
  fi
  if (( ci_exit == 2 )); then
    printf 'wait-for-agent-review loop: waiting for CI on PR #%s (agent quotas exhausted)…\n' \
      "${pr}" >&2
    sleep "${agent_review_default_poll_interval_s}"
    return 99
  fi

  check_exit=0
  cmd_check "${repo}" "${pr}" || check_exit=$?
  case "${check_exit}" in
    0)
      cmd_complete "${repo}" "${pr}"
      return 0
      ;;
    3)
      agent_review_loop_set_stop 'THREADS_PENDING' \
        'Review threads still need a reply or resolve (bot and human).'
      return 3
      ;;
    4)
      if ! cmd_restack "${repo}" "${pr}"; then
        agent_review_loop_set_stop 'RESTACK_FAILED' \
          'Branch is BEHIND or restack failed — human intervention required.'
        return 4
      fi
      return 99
      ;;
    10)
      agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
      return 10
      ;;
    2|5|7|8)
      printf 'wait-for-agent-review loop: agent quotas exhausted — monitoring CI and threads on PR #%s…\n' \
        "${pr}" >&2
      sleep "${agent_review_default_poll_interval_s}"
      return 99
      ;;
    *)
      agent_review_loop_set_stop 'LOOP_STOPPED' \
        "Agent review check failed (exit ${check_exit}) while agent quotas exhausted."
      return "${check_exit}"
      ;;
  esac
}

cmd_loop() {
  local repo pr pr_started cycle_started now pr_cap cycle_cap check_exit wait_exit request_exit
  local remaining status fallback_exit pending_exit pending_all ci_exit quota_skip_exit stall_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_loop_fallback_index=0
  # shellcheck disable=SC2154  # agent_review_default_* timeout constants from sourced lib
  pr_cap="${agent_review_default_pr_timeout_s}"
  # shellcheck disable=SC2154  # agent_review_default_cycle_timeout_s from sourced lib
  cycle_cap="${agent_review_default_cycle_timeout_s}"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  pr_started="$(date +%s)"
  agent_review_log_cycle_quota_preamble
  printf 'Agent review loop for PR #%s (cycle cap=%ss, PR cap=%ss)\n' \
    "${pr}" "${cycle_cap}" "${pr_cap}" >&2

  while true; do
    now="$(date +%s)"
    if (( now - pr_started >= pr_cap )); then
      cmd_give_up "${repo}" "${pr}" \
        "Overall PR agent review exceeded AGENT_REVIEW_PR_TIMEOUT (${pr_cap}s)."
      return $?
    fi
    if agent_review_pr_is_merged "${repo}" "${pr}"; then
      printf 'PR #%s is merged — loop complete\n' "${pr}" >&2
      return 0
    fi
    ci_exit=0
    cmd_loop_abort_if_ci_failed "${repo}" "${pr}" || ci_exit=$?
    if (( ci_exit == 10 )); then
      agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
      return 10
    fi
    if (( ci_exit == 2 )); then
      printf 'wait-for-agent-review loop: waiting for CI on PR #%s…\n' "${pr}" >&2
      sleep "${agent_review_default_poll_interval_s}"
      continue
    fi

    cycle_started="$(date +%s)"
    if ! agent_review_activate_first_requestable_agent >/dev/null; then
      printf 'wait-for-agent-review loop: all agent quotas exhausted — skipping requests; continuing CI and thread checks (PR #%s)\n' \
        "${pr}" >&2
      quota_skip_exit=0
      cmd_loop_quota_skip_tick "${repo}" "${pr}" || quota_skip_exit=$?
      if (( quota_skip_exit == 99 )); then
        continue
      fi
      return "${quota_skip_exit}"
    fi
    request_exit=0
    cmd_request "${repo}" "${pr}" || request_exit=$?
    if (( request_exit == 7 )); then
      fallback_exit=0
      cmd_handle_quota_exhaustion "${repo}" "${pr}" \
        "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted while requesting a review." \
        || fallback_exit=$?
      if (( fallback_exit == 0 )); then
        continue
      fi
      cmd_loop_finish_quota "${repo}" "${pr}" \
        "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted while requesting a review."
      return $?
    fi
    if (( request_exit != 0 )); then
      agent_review_loop_set_stop 'REQUEST_FAILED' \
        "Agent review request failed (exit ${request_exit})."
      return "${request_exit}"
    fi

    while true; do
      now="$(date +%s)"
      if (( now - pr_started >= pr_cap )); then
        cmd_give_up "${repo}" "${pr}" \
          "Overall PR agent review exceeded AGENT_REVIEW_PR_TIMEOUT (${pr_cap}s)."
        return $?
      fi
      if (( now - cycle_started >= cycle_cap )); then
        stall_exit=0
        cmd_loop_resolve_wait_stall "${repo}" "${pr}" \
          "Agent review request cycle exceeded AGENT_REVIEW_CYCLE_TIMEOUT (${cycle_cap}s) without completing." \
          || stall_exit=$?
        if (( stall_exit == 99 )); then
          break
        fi
        return "${stall_exit}"
      fi

      remaining="$(agent_review_remaining_s "${cycle_started}" "${cycle_cap}")"
      if (( remaining < 1 )); then
        remaining=1
      fi

      wait_exit=0
      cmd_wait "${repo}" "${pr}" "${remaining}" "${agent_review_default_poll_interval_s}" || wait_exit=$?
      if (( wait_exit == 9 )); then
        agent_review_activate_first_requestable_agent >/dev/null || true
        pending_exit=0
        agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
        if (( pending_exit == 3 )); then
          agent_review_loop_set_stop 'THREADS_PENDING' \
            'Review threads still need a reply or resolve (bot and human).'
          return 3
        fi
      elif (( wait_exit == 7 )); then
        fallback_exit=0
        cmd_handle_quota_exhaustion "${repo}" "${pr}" \
          "${AGENT_REVIEW_AGENT:-copilot} posted a review or check on the current head indicating quota or usage limit exhaustion." \
          || fallback_exit=$?
        if (( fallback_exit == 0 )); then
          break
        fi
        cmd_loop_finish_quota "${repo}" "${pr}" \
          "${AGENT_REVIEW_AGENT:-copilot} posted a review or check on the current head indicating quota or usage limit exhaustion."
        return $?
      elif (( wait_exit == 2 )); then
        stall_exit=0
        cmd_loop_resolve_wait_stall "${repo}" "${pr}" \
          "Timed out waiting for ${AGENT_REVIEW_AGENT:-copilot} review within AGENT_REVIEW_CYCLE_TIMEOUT (${cycle_cap}s)." \
          || stall_exit=$?
        if (( stall_exit == 99 )); then
          break
        fi
        return "${stall_exit}"
      fi
      if (( wait_exit != 0 )) && (( wait_exit != 9 )); then
        agent_review_loop_set_stop 'LOOP_STOPPED' \
          "Agent review wait failed (exit ${wait_exit})."
        return "${wait_exit}"
      fi

      ci_exit=0
      cmd_loop_abort_if_ci_failed "${repo}" "${pr}" || ci_exit=$?
      if (( ci_exit == 10 )); then
        agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
        return 10
      fi
      if (( ci_exit == 2 )); then
        printf 'wait-for-agent-review loop: waiting for CI on PR #%s…\n' "${pr}" >&2
        sleep "${agent_review_default_poll_interval_s}"
        continue
      fi

      check_exit=0
      cmd_check "${repo}" "${pr}" || check_exit=$?
      case "${check_exit}" in
        0)
          cmd_complete "${repo}" "${pr}"
          return 0
          ;;
        7)
          fallback_exit=0
          cmd_handle_quota_exhaustion "${repo}" "${pr}" \
            "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted on the current PR head." \
            || fallback_exit=$?
          if (( fallback_exit == 0 )); then
            break
          fi
          cmd_loop_finish_quota "${repo}" "${pr}" \
            "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted on the current PR head."
          return $?
          ;;
        3)
          printf 'wait-for-agent-review loop: review threads need a reply or resolve before continuing\n' >&2
          agent_review_loop_set_stop 'THREADS_PENDING' \
            'Review threads still need a reply or resolve (bot and human).'
          return 3
          ;;
        4)
          if ! cmd_restack "${repo}" "${pr}"; then
            printf 'wait-for-agent-review loop: restack failed — human intervention required\n' >&2
            agent_review_loop_set_stop 'RESTACK_FAILED' \
              'Branch is BEHIND or restack failed — human intervention required.'
            return 4
          fi
          break
          ;;
        5)
          status="$(cmd_status "${repo}" "${pr}")"
          pending_all="$(wait_ar_jq_status "$status" '.pending_threads // 0')"
          if (( pending_all > 0 )); then
            printf 'wait-for-agent-review loop: fresh review with unaddressed threads\n' >&2
            agent_review_loop_set_stop 'THREADS_PENDING' \
              'Fresh agent review has unaddressed threads.'
            return 3
          fi
          if [[ "${AGENT_REVIEW_AGENT:-copilot}" == 'coderabbit' ]] \
            && [[ "$(wait_ar_jq_status "$status" '.agent_review_empty')" != 'true' ]]; then
            printf 'wait-for-agent-review loop: CodeRabbit summary feedback needs triage\n' >&2
            agent_review_loop_set_stop 'THREADS_PENDING' \
              'CodeRabbit summary feedback needs triage.'
            return 3
          fi
          if [[ "$(wait_ar_jq_status "$status" '.head_check_findings')" == 'true' ]]; then
            printf 'wait-for-agent-review loop: %s check reports findings — waiting for review comments\n' \
              "${AGENT_REVIEW_AGENT:-copilot}" >&2
            sleep "${agent_review_default_poll_interval_s}"
            continue
          fi
          if ! agent_review_activate_first_requestable_agent >/dev/null; then
            printf 'wait-for-agent-review loop: all agent quotas exhausted — continuing CI and thread checks (PR #%s)\n' \
              "${pr}" >&2
            break
          fi
          request_exit=0
          cmd_request "${repo}" "${pr}" || request_exit=$?
          if (( request_exit == 7 )); then
            fallback_exit=0
            cmd_handle_quota_exhaustion "${repo}" "${pr}" \
              "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted while re-requesting a review." \
              || fallback_exit=$?
            if (( fallback_exit == 0 )); then
              break
            fi
            cmd_loop_finish_quota "${repo}" "${pr}" \
              "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted while re-requesting a review."
            return $?
          fi
          if (( request_exit != 0 )); then
            agent_review_loop_set_stop 'REQUEST_FAILED' \
              "Agent review request failed (exit ${request_exit})."
            return "${request_exit}"
          fi
          ;;
        8)
          printf 'wait-for-agent-review loop: %s GitHub check failed to run — human intervention required\n' \
            "${AGENT_REVIEW_AGENT:-copilot}" >&2
          agent_review_loop_set_stop 'AGENT_CHECK_ERROR' \
            'Agent GitHub check failed to run (non-quota).'
          return 8
          ;;
        10)
          printf 'wait-for-agent-review loop: CI failed — fix required checks before continuing\n' >&2
          agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
          return 10
          ;;
        2)
          pending_exit=0
          agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
          if (( pending_exit == 3 )); then
            agent_review_loop_set_stop 'THREADS_PENDING' \
              'Review threads still need a reply or resolve (bot and human).'
            return 3
          fi
          if (( wait_exit == 9 )) \
            && { agent_review_all_quotas_exhausted \
              || agent_review_agent_quota_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}"; }; then
            printf 'wait-for-agent-review loop: idle break with agent quota exhausted — continuing CI and thread checks (PR #%s)\n' \
              "${pr}" >&2
            break
          fi
          if (( wait_exit == 9 )); then
            printf 'wait-for-agent-review loop: no fresh agent review after idle break (quotas exhausted on PR #%s)\n' \
              "${pr}" >&2
            agent_review_loop_set_stop 'NO_FRESH_REVIEW_AFTER_IDLE_BREAK' \
              'All agent quotas exhausted; no fresh review on the current head after idle break.'
            return 2
          fi
          ;;
        *)
          agent_review_loop_set_stop 'LOOP_STOPPED' \
            "Agent review check failed (exit ${check_exit})."
          return "${check_exit}"
          ;;
      esac
    done
  done
}

main() {
  local cmd="${1:-}"
  shift || true
  local repo_arg='' pr_arg='' timeout_arg='' interval_arg='' thread_id='' reason=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        repo_arg="$(agent_review_require_option_value --repo "${2:-}")"
        shift 2
        ;;
      --pr)
        pr_arg="$(agent_review_require_option_value --pr "${2:-}")"
        shift 2
        ;;
      --timeout)
        timeout_arg="$(agent_review_require_option_value --timeout "${2:-}")"
        shift 2
        ;;
      --poll-interval)
        interval_arg="$(agent_review_require_option_value --poll-interval "${2:-}")"
        shift 2
        ;;
      --thread-id)
        thread_id="$(agent_review_require_option_value --thread-id "${2:-}")"
        shift 2
        ;;
      --reason)
        reason="$(agent_review_require_option_value --reason "${2:-}")"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        agent_review_die "unknown argument: $1"
        ;;
    esac
  done

  case "${cmd}" in
    -h|--help|help)
      usage
      exit 0
      ;;
    '')
      usage >&2
      exit 1
      ;;
  esac

  agent_review_load_env
  agent_review_load_agent_profile

  case "${cmd}" in
    status)
      cmd_status "${repo_arg}" "${pr_arg}"
      ;;
    request)
      cmd_request "${repo_arg}" "${pr_arg}"
      ;;
    wait)
      cmd_wait "${repo_arg}" "${pr_arg}" \
        "${timeout_arg:-${agent_review_default_wait_timeout_s}}" \
        "${interval_arg:-${agent_review_default_poll_interval_s}}"
      ;;
    list-threads)
      cmd_list_threads "${repo_arg}" "${pr_arg}"
      ;;
    list-human-threads)
      cmd_list_human_threads "${repo_arg}" "${pr_arg}"
      ;;
    check)
      cmd_check "${repo_arg}" "${pr_arg}"
      ;;
    complete)
      cmd_complete "${repo_arg}" "${pr_arg}"
      ;;
    restack)
      cmd_restack "${repo_arg}" "${pr_arg}"
      ;;
    resolve-thread)
      cmd_resolve_thread "${thread_id}"
      ;;
    resolve-addressed)
      cmd_resolve_addressed "${repo_arg}" "${pr_arg}"
      ;;
    resolve-human-addressed)
      cmd_resolve_human_addressed "${repo_arg}" "${pr_arg}"
      ;;
    email-failure)
      agent_review_email_failure \
        "$(agent_review_resolve_repo "${repo_arg}")" \
        "$(agent_review_resolve_pr "${pr_arg}" "$(agent_review_resolve_repo "${repo_arg}")")" \
        "${reason:-Agent review loop stopped without reaching complete_ready.}"
      ;;
    give-up)
      cmd_give_up \
        "$(agent_review_resolve_repo "${repo_arg}")" \
        "$(agent_review_resolve_pr "${pr_arg}" "$(agent_review_resolve_repo "${repo_arg}")")" \
        "${reason:-Agent review loop stopped without reaching complete_ready.}"
      ;;
    loop)
      local loop_repo loop_pr loop_exit=0
      loop_repo="$(agent_review_resolve_repo "${repo_arg}")"
      loop_pr="$(agent_review_resolve_pr "${pr_arg}" "${loop_repo}")"
      agent_review_loop_notified=0
      agent_review_loop_stop_reason_code=''
      agent_review_loop_stop_reason_detail=''
      cmd_loop "${repo_arg}" "${pr_arg}" || loop_exit=$?
      cmd_loop_exit_notify "${loop_repo}" "${loop_pr}" "${loop_exit}"
      exit "${loop_exit}"
      ;;
    *)
      agent_review_die "unknown command: ${cmd} (run with --help)"
      ;;
  esac
}

main "$@"
