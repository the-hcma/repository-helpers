#!/usr/bin/env bash
# Poll GitHub for agent pull-request review state (default: Copilot).
#
# Subcommands:
#   status              JSON status for the configured agent
#   request             Ask the agent to review (idempotent)
#   wait                Block until the agent posts a review for the current head
#   list-threads        Print agent threads still needing a human reply (JSON)
#   list-human-threads  Print human reviewer threads still needing a reply (JSON)
#   list-feedback       Print all pending feedback (threads + issue comments + review bodies, JSON)
#                       Includes operator-authored PR conversation comments (non-probe) until
#                       an explicit reply cites the comment URL and resolve-comment runs.
#   reply-comment       Post a top-level PR comment in reply to agent feedback
#   resolve-comment     Mark an issue comment or review body addressed (requires operator reply)
#   check               Exit 0 when complete_ready or PR merged
#   complete            Email operator when agent review is complete (no PR self-approve)
#   restack             Sync and restack when mergeStateStatus is BEHIND
#   resolve-thread      Resolve one thread by GraphQL node id (requires human reply)
#   reply-thread          Post an on-thread human reply (GraphQL)
#   resolve-addressed   Resolve agent threads that already have a human reply
#   resolve-human-addressed  Resolve human threads that already have a reply
#   email-failure       Email operator that the agent loop timed out
#   give-up             Email + PR comment that the agent loop is stopping
#   loop                Run request/wait/check until complete, triage needed, or timeout
#
# See .cursor/rules/pr-ship-and-review.mdc for the full loop.
# shellcheck disable=SC2016  # jq filter strings passed to ar_runner_jq_file helpers
set -euo pipefail

agent_review_loop_notified=0
agent_review_loop_stop_reason_code=''
agent_review_loop_stop_reason_detail=''
agent_review_loop_last_error=''
agent_review_loop_last_merge_state=''
agent_review_loop_attempt_count=0
agent_review_loop_attempt_max=0
# Per-head agents we requested and are still waiting on (space-separated).
agent_review_loop_wait_head=''
agent_review_loop_wait_agents=''

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for lib runner_exec calls
source "${script_dir}/lib/runner-bootstrap"

# shellcheck disable=SC1091  # shared libs sourced at runtime from scripts/lib
source "${script_dir}/lib/agent-review"
# shellcheck disable=SC1091  # shared libs sourced at runtime from scripts/lib
source "${script_dir}/lib/agent-review-email"
# shellcheck disable=SC1091  # stacking-tool selects gt vs gh stack for restack
source "${script_dir}/lib/stacking-tool"

wait_ar_jq_status() {
  local -r json="$1"
  local -r filter="$2"
  ar_runner_jq_file "wait-for-agent-review jq status" "$json" -r "$filter"
}

wait_ar_jq_snapshot() {
  local -r json="$1"
  local -r filter="$2"
  ar_runner_jq_file "wait-for-agent-review jq snapshot" "$json" -r "$filter"
}

wait_ar_jq_check_state() {
  local -r json="$1"
  local -r filter="$2"
  ar_runner_jq_file "wait-for-agent-review jq check state" "$json" -r "$filter"
}


usage() {
  cat <<'EOF'
Usage: scripts/wait-for-agent-review <command> [options]

Commands:
  status [--pr N] [--repo OWNER/NAME]
  request [--pr N] [--repo OWNER/NAME]
  wait [--pr N] [--repo OWNER/NAME] [--timeout SECONDS] [--poll-interval SECONDS]
  list-threads [--pr N] [--repo OWNER/NAME]
  list-human-threads [--pr N] [--repo OWNER/NAME]
  list-feedback [--pr N] [--repo OWNER/NAME]
  check [--pr N] [--repo OWNER/NAME]
  complete [--pr N] [--repo OWNER/NAME]
  restack [--pr N] [--repo OWNER/NAME]
  resolve-thread --thread-id ID [--force]
  reply-thread --thread-id ID --body TEXT
  reply-comment (--comment-id ID | --review-id ID) --body TEXT [--pr N] [--repo OWNER/NAME]
  resolve-comment (--comment-id ID | --review-id ID) [--pr N] [--repo OWNER/NAME] [--force]
  resolve-addressed [--pr N] [--repo OWNER/NAME]
  resolve-human-addressed [--pr N] [--repo OWNER/NAME]
  email-failure [--pr N] [--repo OWNER/NAME] [--reason TEXT]
  give-up [--pr N] [--repo OWNER/NAME] [--reason TEXT]
  loop [--pr N] [--repo OWNER/NAME]

Environment:
  AGENT_REVIEW_AGENT            Agent profile name (default: copilot)
  AGENT_REVIEW_FALLBACK_AGENT   Legacy; ignored when AGENT_REVIEW_QUOTA_FALLBACK_CHAIN is unset
  AGENT_REVIEW_QUOTA_FALLBACK_CHAIN  Comma-separated quota escalation (default: coderabbit,copilot,bugbot)
  AGENT_REVIEW_COPILOT_QUOTA_STATE_FILE  Daily Copilot quota breadcrumb on the filesystem
                                         (default: ~/scratch/repository-helpers/copilot-review-quota.env;
                                         readable by other coding agents on this host — not posted to PRs)
  AGENT_REVIEW_BUGBOT_QUOTA_STATE_FILE   Daily Bugbot usage breadcrumb on the filesystem
                                         (default: ~/scratch/repository-helpers/bugbot-review-quota.env)
  AGENT_REVIEW_GITHUB_REPO      Default repo (OWNER/NAME; else git remote origin)
  AGENT_REVIEW_PR_NUMBER        Default PR number when --pr is omitted
  AGENT_REVIEW_REPORT_TO        Operator email recipient (required for complete/email-failure)
  AGENT_REVIEW_REPORT_FROM      Email sender (required for complete/email-failure)
  AGENT_REVIEW_CYCLE_TIMEOUT    Legacy idle dwell (default: 15m); loop completes early when nothing is outstanding
  AGENT_REVIEW_PR_TIMEOUT       Non-convergence cap while review cycles keep iterating (default: 12h)
  AGENT_REVIEW_PROBE_REQUESTED_TTL  Expire outstanding Copilot/Bugbot probe waits (default: 15m)
  AGENT_REVIEW_TRANSIENT_RETRIES  Retries for transient merge/restack failures (default: 5)
  AGENT_REVIEW_TRANSIENT_RETRY_SLEEP  Sleep between transient retries (default: 30s)
  AGENT_REVIEW_IDLE_BREAK_TIMEOUT  Deprecated; use AGENT_REVIEW_CYCLE_TIMEOUT idle-success semantics
  AGENT_REVIEW_BOT_LOGIN_REGEX  Bot logins excluded from human thread triage
  AGENT_REVIEW_LOOP_TIMEOUT     Deprecated alias for AGENT_REVIEW_CYCLE_TIMEOUT
  AGENT_REVIEW_ENV_FILE         Config file (default: ~/.config/agent-review.env)
  DEP_UPDATER_SMTP_HOST         SMTP host (from dep-updater.env or agent-review.env)

Exit codes:
  0  success / complete_ready / PR merged
  1  usage / prerequisite error
  2  wait: not fresh on head, pending CI, or transient mergeability (UNSTABLE/UNKNOWN)
  3  agent or human feedback still lacks a reply or resolve (check; JSON on stdout)
  4  mergeStateStatus is BEHIND (restack) or restack permanently failed / retries exhausted
  5  fresh review but agent did not report "no new comments" yet (check/complete)
  6  loop give-up (PR non-convergence timeout; email + PR comment posted)
  7  agent review quota exhausted with no fallback (give-up email + PR comment posted)
  8  agent GitHub check failed to run (non-quota; see check output on PR)
  9  wait idle break — no PR activity with all agent quotas exhausted (loop continues to check)
 10  required CI checks failed (fix CI before agent review or thread triage)
 11  permanent merge block (DIRTY/CONFLICTING/DRAFT) — human intervention required

Non-success loop exits (2–8, 10, and other failures) email AGENT_REVIEW_REPORT_TO and post a PR
comment when the loop command exits. Success (0 after complete, or PR merged) sends no failure notify.
Give-up paths (6/7) notify once inside give-up; the loop epilogue skips duplicate email.
EOF
}

cmd_status() {
  local repo pr owner name snapshot head

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid')"
  agent_review_observe_all_agent_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}" || true
  agent_review_status_json_from_snapshot "${snapshot}" "${repo}" "${pr}"
}

cmd_loop_abort_if_ci_failed() {
  local repo pr ci_rc

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  ci_rc=0
  agent_review_ci_check_for_pr "${repo}" "${pr}" || ci_rc=$?
  if (( ci_rc == 1 )); then
    agent_review_print_ci_failures "${repo}" "${pr}"
    return 10
  fi
  if (( ci_rc == 2 )); then
    return 2
  fi
  return 0
}

agent_review_loop_set_last_error() {
  agent_review_loop_last_error="${1:-}"
}

agent_review_loop_set_stop() {
  local code="${1:-}"
  local detail="${2:-}"
  local runner_fail

  agent_review_loop_stop_reason_code="${code}"
  if [[ -z "${detail}" && -n "${agent_review_loop_last_error}" ]]; then
    detail="${agent_review_loop_last_error}"
  fi
  runner_fail="$(agent_review_runner_last_failure_text || true)"
  if [[ -n "${runner_fail}" ]]; then
    if [[ -z "${detail}" ]]; then
      detail="${runner_fail}"
    elif [[ "${detail}" != *"${runner_fail}"* ]]; then
      detail="${detail}
Last command failure: ${runner_fail}"
    fi
  fi
  if [[ -n "${agent_review_loop_last_merge_state}" ]]; then
    if [[ -z "${detail}" ]]; then
      detail="mergeStateStatus=${agent_review_loop_last_merge_state}"
    elif [[ "${detail}" != *"mergeStateStatus=${agent_review_loop_last_merge_state}"* ]]; then
      detail="mergeStateStatus=${agent_review_loop_last_merge_state}
${detail}"
    fi
  fi
  if (( agent_review_loop_attempt_max > 0 )); then
    detail="${detail}
Attempts: ${agent_review_loop_attempt_count}/${agent_review_loop_attempt_max}"
  fi
  agent_review_loop_stop_reason_detail="${detail}"
}

agent_review_loop_default_stop_for_exit() {
  local -r exit_code="$1"

  case "${exit_code}" in
    2)
      agent_review_loop_set_stop 'NO_FRESH_REVIEW_AFTER_IDLE_BREAK' \
        'No fresh agent review on the current PR head.'
      ;;
    3)
      agent_review_loop_set_stop 'THREADS_PENDING' \
        'Feedback items still need a reply or resolve (threads, issue comments, review bodies).'
      ;;
    4)
      agent_review_loop_set_stop 'RESTACK_FAILED' \
        'Restack failed or transient merge/restack retries exhausted — human intervention required.'
      ;;
    6)
      agent_review_loop_set_stop 'TIMEOUT' \
        'Agent review loop timed out.'
      ;;
    7)
      agent_review_loop_set_stop 'QUOTA_EXHAUSTED' \
        'Agent review quota or usage limit exhausted with no fallback.'
      ;;
    8)
      agent_review_loop_set_stop 'AGENT_CHECK_ERROR' \
        'Agent GitHub check failed to run (non-quota).'
      ;;
    10)
      agent_review_loop_set_stop 'CI_FAILED' \
        'Required CI checks failed.'
      ;;
    11)
      agent_review_loop_set_stop 'MERGE_STATE_BLOCKED' \
        'Permanent merge block (DIRTY/CONFLICTING/DRAFT) — human intervention required.'
      ;;
    *)
      agent_review_loop_set_stop 'LOOP_STOPPED' \
        "Agent review loop stopped (exit ${exit_code})."
      ;;
  esac
}

agent_review_loop_status_context_json() {
  local -r repo="$1"
  local -r pr="$2"
  local status

  status="$(cmd_status "${repo}" "${pr}" 2>/dev/null || true)"
  if [[ -z "${status}" ]]; then
    status='{}'
  fi
  ar_runner_jq_file "wait-for-agent-review status context" "$status" \
    --arg last_error "${agent_review_loop_last_error}" \
    --arg merge_state "${agent_review_loop_last_merge_state}" \
    --argjson attempts "${agent_review_loop_attempt_count}" \
    --argjson max_attempts "${agent_review_loop_attempt_max}" \
    -c '{
      pending_threads: (.pending_threads // 0),
      head_sha: (.head_sha // ""),
      ci_conclusion: (.ci_conclusion // ""),
      merge_state_status: (if $merge_state != "" then $merge_state else (.merge_state_status // "") end),
      last_error: $last_error,
      attempts: $attempts,
      max_attempts: $max_attempts
    }' 2>/dev/null || printf '{}'
}

agent_review_loop_notify_stopped() {
  local -r repo="$1"
  local -r pr="$2"
  local -r exit_code="$3"
  local reason_code reason_detail context_json

  reason_code="${agent_review_loop_stop_reason_code}"
  reason_detail="${agent_review_loop_stop_reason_detail}"
  if [[ -z "${reason_code}" ]] || [[ -z "${reason_detail}" ]]; then
    agent_review_loop_default_stop_for_exit "${exit_code}"
    reason_code="${agent_review_loop_stop_reason_code}"
    reason_detail="${agent_review_loop_stop_reason_detail}"
  fi
  context_json="$(agent_review_loop_status_context_json "${repo}" "${pr}")"
  agent_review_require_cmd gh
  if ! agent_review_email_loop_stopped \
      "${repo}" "${pr}" "${exit_code}" "${reason_code}" "${reason_detail}" "${context_json}"; then
    printf 'wait-for-agent-review: loop-stopped email failed (continuing with PR comment)\n' >&2
  fi
  if ! agent_review_post_loop_stopped_comment \
      "${repo}" "${pr}" "${exit_code}" "${reason_code}" "${reason_detail}"; then
    printf 'wait-for-agent-review: loop-stopped PR comment failed\n' >&2
  fi
}

cmd_loop_exit_notify() {
  local -r repo="$1"
  local -r pr="$2"
  local -r exit_code="$3"

  if (( exit_code == 0 )); then
    return 0
  fi
  if (( exit_code == 3 )); then
    return 0
  fi
  if (( agent_review_loop_notified == 1 )); then
    return 0
  fi
  agent_review_loop_notify_stopped "${repo}" "${pr}" "${exit_code}"
}

cmd_request() {
  local repo pr owner name snapshot request_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  if agent_review_pr_is_merged "${repo}" "${pr}"; then
    printf 'PR #%s is already merged — skipping agent request\n' "${pr}" >&2
    return 0
  fi
  if agent_review_agent_quota_skip_request; then
    return 7
  fi
  if agent_review_agent_quota_probe_requested_for_agent "${AGENT_REVIEW_AGENT:-copilot}"; then
    printf 'wait-for-agent-review: %s quota probe already requested today - skipping request on PR #%s\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
    return 0
  fi
  if [[ "${agent_review_profile_trigger:-nudge}" == 'on_push' \
    || "${agent_review_profile_auto_review:-false}" == 'true' ]]; then
    printf 'wait-for-agent-review: %s is on_push — skipping nudge request on PR #%s\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
    return 0
  fi
  snapshot="$(agent_review_graphql_request_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_review_requests_complete "${snapshot}"
  if declare -F agent_review_profile_request_already_sent >/dev/null 2>&1; then
    if agent_review_profile_request_already_sent "${repo}" "${pr}"; then
      printf '%s review already requested on PR #%s\n' "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
      return 0
    fi
  elif agent_review_agent_requested_from_snapshot "${snapshot}"; then
    printf '%s review already requested on PR #%s\n' "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
    return 0
  fi
  request_exit=0
  agent_review_profile_request "${repo}" "${pr}" || request_exit=$?
  if (( request_exit == 7 )); then
    agent_review_agent_quota_mark_exhausted \
      "${AGENT_REVIEW_AGENT:-copilot} review request blocked by quota or usage limits (see gh stderr above)."
    return 7
  fi
  if (( request_exit != 0 )); then
    agent_review_die 'failed to request agent review'
  fi
  agent_review_mark_profile_requested
  printf 'Requested %s review on PR #%s\n' "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
  if ! agent_review_profile_request_is_visible; then
    printf 'wait-for-agent-review: %s review requests may not appear as pending reviewers on GitHub\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
  fi
}

cmd_wait() {
  local repo pr timeout interval owner name head started snapshot review_body check_state_json check_state quota_hit
  local last_activity now_epoch idle_break idle_s ci_rc

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  timeout="${3:-${agent_review_default_wait_timeout_s}}"
  interval="${4:-${agent_review_default_poll_interval_s}}"
  agent_review_validate_positive_int --timeout "${timeout}"
  agent_review_validate_positive_int --poll-interval "${interval}"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  # shellcheck disable=SC2154  # agent_review_default_idle_break_s from sourced lib
  idle_break="${agent_review_default_idle_break_s}"
  started="$(date +%s)"
  last_activity=0
  while true; do
    if agent_review_pr_is_merged "${repo}" "${pr}"; then
      printf 'PR #%s is already merged — stopping wait\n' "${pr}" >&2
      return 0
    fi
    ci_rc=0
    agent_review_ci_check_for_pr "${repo}" "${pr}" || ci_rc=$?
    if (( ci_rc == 1 )); then
      agent_review_print_ci_failures "${repo}" "${pr}"
      return 10
    fi
    snapshot="$(agent_review_graphql_wait_snapshot "${owner}" "${name}" "${pr}")"
    head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid')"
    agent_review_observe_all_agent_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}" || true
    # Expire stale probe_requested waits so timeline re-scan / fallback can proceed (#408).
    agent_review_copilot_quota_expire_stale_probe_requested || true
    agent_review_bugbot_quota_expire_stale_probe_requested || true
    now_epoch="$(agent_review_last_activity_epoch_from_snapshot "${snapshot}")"
    if (( now_epoch > last_activity )); then
      last_activity="${now_epoch}"
    fi
    if agent_review_all_quotas_exhausted \
      || agent_review_agent_quota_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}"; then
      if (( last_activity > 0 )); then
        idle_s=$(( $(date +%s) - last_activity ))
      else
        idle_s=$(( $(date +%s) - started ))
      fi
      if (( idle_s >= idle_break )); then
        if agent_review_all_quotas_exhausted; then
          printf 'wait-for-agent-review: idle break — no PR activity for %ss with all agent quotas exhausted (PR #%s)\n' \
            "${idle_s}" "${pr}" >&2
        else
          printf 'wait-for-agent-review: idle break — no PR activity for %ss with %s quota exhausted (PR #%s)\n' \
            "${idle_s}" "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
        fi
        return 9
      fi
    fi
    if agent_review_skip_wait_for_quota_exhausted_agent "${snapshot}" "${head}" "${repo}"; then
      printf 'wait-for-agent-review: %s daily quota exhausted — skipping wait for pending review/check (PR #%s)\n' \
        "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
      return 7
    fi
    if agent_review_fresh_agent_review_on_head "${snapshot}" "${head}"; then
      review_body="$(agent_review_latest_agent_review_body_on_head "${snapshot}" "${head}")"
      if [[ -n "${review_body}" ]] \
        && agent_review_profile_review_is_quota_exhausted "${review_body}"; then
        agent_review_quota_mark_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
          "${AGENT_REVIEW_AGENT:-copilot} review on head ${head:0:7} reports quota exhaustion (PR #${pr})."
        printf '%s review on head %s reports quota exhaustion (PR #%s)\n' \
          "${AGENT_REVIEW_AGENT:-copilot}" "${head:0:7}" "${pr}" >&2
        return 7
      fi
      agent_review_quota_mark_confirmed_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
        "${AGENT_REVIEW_AGENT:-copilot} review on head ${head:0:7} confirms quota available (PR #${pr})."
      printf '%s review posted for head %s (PR #%s)\n' \
        "${AGENT_REVIEW_AGENT:-copilot}" "${head:0:7}" "${pr}" >&2
      return 0
    fi
    if agent_review_fresh_agent_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
      if [[ "${agent_review_profile_uses_head_check:-false}" == 'true' ]]; then
        check_state_json="$(agent_review_head_check_state_json "${repo}" "${head}")"
        quota_hit="$(wait_ar_jq_check_state "$check_state_json" '.quota')"
        if [[ "${quota_hit}" == 'true' ]]; then
          agent_review_quota_mark_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
            "${AGENT_REVIEW_AGENT:-copilot} check on head ${head:0:7} reports usage limit reached (PR #${pr})."
          printf '%s GitHub check reports usage limit for head %s (PR #%s)\n' \
            "${AGENT_REVIEW_AGENT:-copilot}" "${head:0:7}" "${pr}" >&2
          return 7
        fi
        check_state="$(wait_ar_jq_check_state "$check_state_json" 'if .error then "error" elif .clean then "clean" elif .findings then "findings" else .conclusion end')"
        if [[ "${quota_hit}" != 'true' ]] && [[ "${check_state}" != 'error' ]]; then
          agent_review_quota_mark_confirmed_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
            "${AGENT_REVIEW_AGENT:-copilot} check on head ${head:0:7} confirms quota available (PR #${pr})."
        fi
        printf '%s GitHub check completed (%s) for head %s (PR #%s)\n' \
          "${AGENT_REVIEW_AGENT:-copilot}" "${check_state}" "${head:0:7}" "${pr}" >&2
        return 0
      fi
    fi
    if (( $(date +%s) - started >= timeout )); then
      if agent_review_agent_quota_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
        || agent_review_all_quotas_exhausted; then
        if (( last_activity > 0 )); then
          idle_s=$(( $(date +%s) - last_activity ))
        else
          idle_s=$(( $(date +%s) - started ))
        fi
        if (( idle_s >= idle_break )); then
          printf 'wait-for-agent-review: idle break at wait timeout — no PR activity for %ss with %s quota exhausted (PR #%s)\n' \
            "${idle_s}" "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
          return 9
        fi
        printf 'wait-for-agent-review: %s daily quota exhausted — ending wait at cycle timeout (PR #%s)\n' \
          "${AGENT_REVIEW_AGENT:-copilot}" "${pr}" >&2
        return 7
      fi
      printf 'ERROR: WAIT_TIMEOUT wait-for-agent-review pr=%s head=%s waited=%ss timeout=%ss agent=%s\n' \
        "${pr}" "${head:0:7}" "$(( $(date +%s) - started ))" "${timeout}" "${AGENT_REVIEW_AGENT:-copilot}" >&2
      return 2
    fi
    agent_review_print_wait_for_review "${pr}" "${head}"
    sleep "${interval}"
  done
}

cmd_list_threads() {
  local repo pr owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  agent_review_threads_json_from_snapshot "${snapshot}"
}

cmd_list_human_threads() {
  local repo pr owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  agent_review_human_threads_json_from_snapshot "${snapshot}"
}

cmd_list_feedback() {
  local repo pr owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  agent_review_feedback_pending_json "${repo}" "${pr}" "${snapshot}"
}

cmd_check() {
  local repo pr owner name snapshot status complete_ready fresh merge_state pr_merged agent_empty agent_quota
  local head_check_error head_check_findings head all_quotas_exhausted pending_count
  local ci_conclusion merge_class

  # Drop stale diagnostics from prior polls so stop emails stay actionable.
  agent_review_loop_last_error=''
  agent_review_loop_last_merge_state=''

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid')"
  agent_review_observe_all_agent_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}" || true
  status="$(agent_review_status_json_from_snapshot "${snapshot}" "${repo}" "${pr}")"
  pr_merged="$(wait_ar_jq_status "$status" '.pr_merged')"
  if [[ "${pr_merged}" == 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: PR #%s is merged — loop complete\n' "${pr}" >&2
    return 0
  fi
  ci_conclusion="$(wait_ar_jq_status "$status" '.ci_conclusion // ""')"
  if [[ "${ci_conclusion}" == 'failure' ]]; then
    agent_review_print_ci_failures "${repo}" "${pr}"
    printf '%s\n' "${status}" >&2
    return 10
  fi
  if [[ "${ci_conclusion}" == 'pending' ]] \
    || [[ "$(wait_ar_jq_status "$status" '.ci_ready')" != 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: CI pending on PR #%s (ci_conclusion=%s) — waiting\n' \
      "${pr}" "${ci_conclusion:-unknown}" >&2
    return 2
  fi
  complete_ready="$(wait_ar_jq_status "$status" '.complete_ready')"
  all_quotas_exhausted="$(wait_ar_jq_status "$status" '.all_quotas_exhausted')"
  pending_count="$(agent_review_pending_thread_count_from_snapshot "${repo}" "${pr}" "${snapshot}")"
  fresh="$(wait_ar_jq_status "$status" '.fresh_review_on_head')"
  agent_empty="$(wait_ar_jq_status "$status" '.agent_review_empty')"
  agent_quota="$(wait_ar_jq_status "$status" '.agent_quota_exhausted')"
  head_check_error="$(wait_ar_jq_status "$status" '.head_check_error')"
  head_check_findings="$(wait_ar_jq_status "$status" '.head_check_findings')"
  merge_state="$(wait_ar_jq_status "$status" '.merge_state_status')"
  agent_review_loop_last_merge_state="${merge_state}"
  if [[ "${complete_ready}" == 'true' ]]; then
    printf '%s\n' "${status}"
    return 0
  fi
  if (( pending_count > 0 )); then
    printf '%s\n' "${status}" >&2
    agent_review_feedback_triage_json "${repo}" "${pr}" "${snapshot}"
    printf 'wait-for-agent-review: %s feedback item(s) still need a reply or resolve (threads and comments)\n' \
      "${pending_count}" >&2
    return 3
  fi
  if [[ "${agent_quota}" == 'true' ]] && [[ "${all_quotas_exhausted}" != 'true' ]]; then
    agent_review_quota_mark_exhausted_for_agent "${AGENT_REVIEW_AGENT:-copilot}" \
      "${AGENT_REVIEW_AGENT:-copilot} review on the current PR head reports quota or usage limit exhaustion."
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s review quota or usage limit exhausted on current head\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 7
  fi
  if [[ "${head_check_error}" == 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s GitHub check failed to run (see check output on PR)\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 8
  fi
  if [[ "${fresh}" != 'true' ]]; then
    printf '%s\n' "${status}"
    return 2
  fi
  if [[ "${head_check_findings}" == 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s GitHub check reports findings — review comments expected on PR\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 5
  fi
  merge_class="$(agent_review_merge_state_class "${merge_state}")"
  case "${merge_class}" in
    ready)
      :
      ;;
    behind)
      printf '%s\n' "${status}"
      agent_review_loop_set_last_error \
        "mergeStateStatus=${merge_state} — branch is BEHIND base; restack required."
      printf 'wait-for-agent-review: mergeStateStatus=%s — restack required\n' \
        "${merge_state}" >&2
      return 4
      ;;
    transient)
      printf '%s\n' "${status}"
      agent_review_loop_set_last_error \
        "mergeStateStatus=${merge_state} — transient mergeability; waiting (not restackable)."
      printf 'wait-for-agent-review: mergeStateStatus=%s — waiting for mergeability\n' \
        "${merge_state}" >&2
      return 2
      ;;
    *)
      printf '%s\n' "${status}"
      agent_review_loop_set_last_error \
        "mergeStateStatus=${merge_state} — permanent merge block; resolve conflicts or undraft the PR."
      printf 'wait-for-agent-review: mergeStateStatus=%s — permanent merge block\n' \
        "${merge_state}" >&2
      return 11
      ;;
  esac
  if [[ "${agent_empty}" != 'true' ]]; then
    printf '%s\n' "${status}"
    printf 'wait-for-agent-review: %s reviewed head but did not report "no new comments" yet\n' \
      "${AGENT_REVIEW_AGENT:-copilot}" >&2
    return 5
  fi
  printf '%s\n' "${status}"
  return 0
}

cmd_complete() {
  local repo pr status complete_ready pr_merged

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  if agent_review_pr_is_merged "${repo}" "${pr}"; then
    printf 'PR #%s is already merged — skipping complete email\n' "${pr}" >&2
    return 0
  fi
  status="$(cmd_status "${repo}" "${pr}")"
  pr_merged="$(wait_ar_jq_status "$status" '.pr_merged')"
  if [[ "${pr_merged}" == 'true' ]]; then
    printf 'PR #%s is already merged — skipping complete email\n' "${pr}" >&2
    return 0
  fi
  complete_ready="$(wait_ar_jq_status "$status" '.complete_ready')"
  if [[ "${complete_ready}" != 'true' ]]; then
    agent_review_die 'complete requires agent and human review empty on current head with no unaddressed threads'
  fi
  # Do not gh-approve: the authenticated operator often authors the PR, and GitHub
  # rejects self-approvals. Merge remains an explicit operator step (merge-it).
  agent_review_email_complete "${repo}" "${pr}"
  printf 'Agent review complete on PR #%s — emailed operator (no self-approve)\n' "${pr}" >&2
}

cmd_resolve_thread() {
  local -r thread_id="${1:-}"
  local force="${2:-0}"

  if [[ -z "${thread_id}" ]]; then
    agent_review_die 'resolve-thread requires --thread-id'
  fi
  agent_review_require_cmd gh
  agent_review_resolve_thread_id "${thread_id}" "${force}"
  printf 'Resolved thread %s\n' "${thread_id}" >&2
}

cmd_reply_thread() {
  local -r thread_id="${1:-}"
  local -r body="${2:-}"

  if [[ -z "${thread_id}" ]]; then
    agent_review_die 'reply-thread requires --thread-id'
  fi
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  agent_review_reply_thread_id "${thread_id}" "${body}"
}

cmd_reply_comment() {
  local repo pr comment_id review_id body owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  comment_id="${3:-}"
  review_id="${4:-}"
  body="${5:-}"
  if [[ -n "${comment_id}" && -n "${review_id}" ]]; then
    agent_review_die 'reply-comment accepts only one of --comment-id or --review-id'
  fi
  if [[ -z "${comment_id}" && -z "${review_id}" ]]; then
    agent_review_die 'reply-comment requires --comment-id or --review-id'
  fi
  agent_review_require_cmd gh
  if [[ -n "${review_id}" ]]; then
    read -r owner name < <(agent_review_repo_parts "${repo}")
    snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
    agent_review_assert_snapshot_complete "${snapshot}"
    agent_review_reply_pull_request_review "${repo}" "${pr}" "${snapshot}" "${review_id}" "${body}"
    return 0
  fi
  agent_review_reply_issue_comment "${repo}" "${pr}" "${comment_id}" "${body}"
}

cmd_resolve_comment() {
  local repo pr comment_id review_id force owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  comment_id="${3:-}"
  review_id="${4:-}"
  force="${5:-0}"
  if [[ -n "${comment_id}" && -n "${review_id}" ]]; then
    agent_review_die 'resolve-comment accepts only one of --comment-id or --review-id'
  fi
  if [[ -z "${comment_id}" && -z "${review_id}" ]]; then
    agent_review_die 'resolve-comment requires --comment-id or --review-id'
  fi
  if [[ -n "${review_id}" ]]; then
    read -r owner name < <(agent_review_repo_parts "${repo}")
    snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
    agent_review_assert_snapshot_complete "${snapshot}"
    agent_review_resolve_pull_request_review "${repo}" "${pr}" "${snapshot}" "${review_id}" "${force}"
    return 0
  fi
  agent_review_resolve_issue_comment "${repo}" "${pr}" "${comment_id}" "${force}"
}

cmd_resolve_addressed() {
  local repo pr owner name snapshot ids id needs_resolve_json comment_ids cid issue_json
  local review_ids rid reviews_json

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  needs_resolve_json="$(agent_review_agent_threads_needs_resolve_json_from_snapshot "${snapshot}")"
  mapfile -t ids < <(
    ar_runner_jq_file "wait-for-agent-review agent addressed thread ids" "${needs_resolve_json}" \
      -r '.[].thread_id'
  )
  if ((${#ids[@]} == 0)); then
    printf 'No addressed agent threads to resolve on PR #%s\n' "${pr}" >&2
  else
    for id in "${ids[@]}"; do
      agent_review_resolve_thread_id "${id}"
      printf 'Resolved thread %s\n' "${id}" >&2
    done
  fi
  issue_json="$(agent_review_feedback_issue_comments_pending_json "${repo}" "${pr}")"
  mapfile -t comment_ids < <(
    ar_runner_jq_file "wait-for-agent-review addressed issue comment ids" "${issue_json}" \
      -r 'map(select(.state == "needs_resolve")) | .[].comment_id'
  )
  for cid in "${comment_ids[@]}"; do
    agent_review_resolve_issue_comment "${repo}" "${pr}" "${cid}"
  done
  reviews_json="$(agent_review_feedback_reviews_pending_json "${repo}" "${pr}" "${snapshot}")"
  mapfile -t review_ids < <(
    ar_runner_jq_file "wait-for-agent-review addressed review ids" "${reviews_json}" \
      -r 'map(select(.state == "needs_resolve")) | .[].review_id'
  )
  for rid in "${review_ids[@]}"; do
    agent_review_resolve_pull_request_review "${repo}" "${pr}" "${snapshot}" "${rid}"
  done
  if ((${#ids[@]} == 0)) && ((${#comment_ids[@]} == 0)) && ((${#review_ids[@]} == 0)); then
    printf 'No addressed feedback to resolve on PR #%s\n' "${pr}" >&2
  fi
}

cmd_resolve_human_addressed() {
  local repo pr owner name snapshot ids id needs_resolve_json

  repo="$(agent_review_resolve_repo "${1:-}")"
  read -r owner name < <(agent_review_repo_parts "${repo}")
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  needs_resolve_json="$(agent_review_human_threads_needs_resolve_json_from_snapshot "${snapshot}")"
  mapfile -t ids < <(
    ar_runner_jq_file "wait-for-agent-review human addressed thread ids" "${needs_resolve_json}" \
      -r '.[].thread_id'
  )
  if ((${#ids[@]} == 0)); then
    printf 'No addressed human review threads to resolve on PR #%s\n' "${pr}" >&2
    return 0
  fi
  for id in "${ids[@]}"; do
    agent_review_resolve_thread_id "${id}"
    printf 'Resolved human thread %s\n' "${id}" >&2
  done
}

# Restack when BEHIND.
# Exit 0 success, 2 transient (retry), 4 permanent failure.
cmd_restack() {
  local repo pr merge_state head_branch pr_head_branch attempt base_branch pr_fields_json
  local merge_class runner_fail msg tool checkout_root

  agent_review_loop_last_error=''
  agent_review_loop_last_merge_state=''

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  agent_review_require_cmd gh
  agent_review_require_cmd git
  checkout_root="$(runner_exec_stdout "wait-for-agent-review git rev-parse show-toplevel" \
    -- git rev-parse --show-toplevel)" \
    || agent_review_die 'could not resolve checkout toplevel for restack'
  tool="$(stacking_tool_read "${checkout_root}")"
  stacking_tool_require_cli "${tool}"
  if agent_review_pr_is_merged "${repo}" "${pr}"; then
    printf 'PR #%s is already merged — skipping restack\n' "${pr}" >&2
    return 0
  fi
  agent_review_assert_checkout_matches_repo "${repo}"
  agent_review_assert_not_primary_worktree
  pr_fields_json="$(ar_runner_gh_pr_jq "wait-for-agent-review pr restack fields" "${repo}" "${pr}" \
    "headRefName,mergeStateStatus,baseRefName")"
  head_branch="$(ar_runner_jq_file "wait-for-agent-review headRefName" "${pr_fields_json}" \
    -r '.headRefName')"
  pr_head_branch="$(runner_exec_stdout "wait-for-agent-review git current branch" \
    -- git branch --show-current || true)"
  if [[ -z "${pr_head_branch}" ]] || [[ "${pr_head_branch}" != "${head_branch}" ]]; then
    agent_review_die "current branch ${pr_head_branch@Q} is not PR #${pr} head ${head_branch@Q}"
  fi
  merge_state="$(ar_runner_jq_file "wait-for-agent-review mergeStateStatus" "${pr_fields_json}" \
    -r '.mergeStateStatus')"
  agent_review_loop_last_merge_state="${merge_state}"
  merge_class="$(agent_review_merge_state_class "${merge_state}")"
  case "${merge_class}" in
    ready)
      printf 'PR #%s mergeStateStatus=%s (no restack needed)\n' "${pr}" "${merge_state}" >&2
      return 0
      ;;
    behind)
      :
      ;;
    transient)
      msg="PR #${pr} mergeStateStatus=${merge_state} — cannot restack yet (transient mergeability)."
      agent_review_loop_set_last_error "${msg}"
      printf '%s\n' "${msg}" >&2
      return 2
      ;;
    *)
      msg="PR #${pr} mergeStateStatus=${merge_state} — cannot restack (permanent merge block)."
      agent_review_loop_set_last_error "${msg}"
      printf '%s\n' "${msg}" >&2
      return 4
      ;;
  esac
  base_branch="$(ar_runner_jq_file "wait-for-agent-review baseRefName" "${pr_fields_json}" \
    -r '.baseRefName')"
  printf 'PR #%s is BEHIND %s — restacking via stacking-tool (%s)…\n' \
    "${pr}" "${base_branch}" "${tool}" >&2
  if ! stacking_tool_restack "${checkout_root}"; then
    runner_fail="$(agent_review_runner_last_failure_text || true)"
    msg="stacking-tool restack failed for PR #${pr} (tool=${tool})"
    if [[ -n "${runner_fail}" ]]; then
      msg="${msg}: ${runner_fail}"
    fi
    agent_review_loop_set_last_error "${msg}"
    printf '%s\n' "${msg}" >&2
    # Conflicts and hard stack errors are permanent; network-ish failures retry.
    if [[ "${runner_fail}" == *[Cc]onflict* ]] \
      || [[ "${runner_fail}" == *[Cc]onflicting* ]] \
      || [[ "${runner_fail}" == *'uncommitted changes'* ]]; then
      return 4
    fi
    return 2
  fi
  attempt=0
  while (( attempt < 12 )); do
    if agent_review_pr_is_merged "${repo}" "${pr}"; then
      printf 'PR #%s merged during restack poll — stopping\n' "${pr}" >&2
      return 0
    fi
    pr_fields_json="$(ar_runner_gh_pr_jq "wait-for-agent-review pr merge state poll" "${repo}" "${pr}" \
      mergeStateStatus)"
    merge_state="$(ar_runner_jq_file "wait-for-agent-review mergeStateStatus poll" "${pr_fields_json}" \
      -r '.mergeStateStatus')"
    agent_review_loop_last_merge_state="${merge_state}"
    merge_class="$(agent_review_merge_state_class "${merge_state}")"
    case "${merge_class}" in
      ready)
        printf 'After restack: mergeStateStatus=%s\n' "${merge_state}" >&2
        return 0
        ;;
      behind)
        :
        ;;
      transient)
        msg="After restack: mergeStateStatus=${merge_state} — waiting for mergeability."
        agent_review_loop_set_last_error "${msg}"
        printf '%s\n' "${msg}" >&2
        return 2
        ;;
      *)
        msg="After restack: mergeStateStatus=${merge_state} — permanent merge block."
        agent_review_loop_set_last_error "${msg}"
        printf '%s\n' "${msg}" >&2
        return 4
        ;;
    esac
    sleep 5
    attempt=$((attempt + 1))
  done
  msg="ERROR: WAIT_TIMEOUT restack pr=${pr} waited=60s (still BEHIND)"
  agent_review_loop_set_last_error "${msg}"
  printf '%s\n' "${msg}" >&2
  return 2
}

cmd_handle_quota_exhaustion() {
  local repo pr reason fallback_exit from_agent

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  reason="${3:-Agent review quota exhausted.}"
  from_agent="${AGENT_REVIEW_AGENT:-copilot}"

  fallback_exit=0
  cmd_try_quota_fallback "${repo}" "${pr}" "${from_agent}" "${reason}" || fallback_exit=$?
  return "${fallback_exit}"
}

cmd_try_quota_fallback() {
  local repo pr from_agent reason fallback_agent profile_path profiles_dir current_agent candidate

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  from_agent="${3:-copilot}"
  reason="${4:-Agent review quota exhausted.}"

  profiles_dir="$(cd "${script_dir}/lib/agent-review-profiles" && pwd)"
  current_agent="${from_agent}"
  fallback_agent=''
  while candidate="$(agent_review_quota_escalation_next_agent "${current_agent}" 2>/dev/null)"; do
    current_agent="${candidate}"
    if agent_review_agent_quota_exhausted_for_agent "${candidate}"; then
      printf 'wait-for-agent-review: skipping fallback to %s — daily quota exhausted\n' \
        "${candidate}" >&2
      continue
    fi
    fallback_agent="${candidate}"
    break
  done
  if [[ -z "${fallback_agent}" ]]; then
    printf 'wait-for-agent-review: %s — continuing review monitoring (humans + agents with quota)\n' \
      "${reason}" >&2
    return 0
  fi
  profile_path="${profiles_dir}/${fallback_agent}"
  if [[ ! -f "${profile_path}" ]]; then
    printf 'wait-for-agent-review: fallback profile %s missing — continuing review monitoring\n' \
      "${fallback_agent}" >&2
    return 0
  fi
  printf 'wait-for-agent-review: %s — falling back to %s\n' \
    "${reason}" "${fallback_agent}" >&2
  if ! agent_review_post_fallback_comment \
      "${repo}" "${pr}" "${reason}" "${from_agent}" "${fallback_agent}"; then
    printf 'wait-for-agent-review: fallback PR comment failed (continuing with %s)\n' \
      "${fallback_agent}" >&2
  fi
  agent_review_use_agent "${fallback_agent}"
  return 0
}

cmd_give_up() {
  local repo pr reason mode error_tag exit_code pending_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  reason="${3:-Agent review loop stopped without reaching complete_ready.}"
  mode="${4:-}"
  pending_exit=0
  agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
  if (( pending_exit == 3 )); then
    agent_review_loop_set_stop 'THREADS_PENDING' \
      'Feedback items still need a reply or resolve (threads, issue comments, review bodies).'
    return 3
  fi
  agent_review_require_cmd gh
  if [[ "${mode}" == 'quota' ]]; then
    if ! agent_review_email_loop_stopped \
        "${repo}" "${pr}" 7 QUOTA_EXHAUSTED "${reason}" '{}'; then
      printf 'wait-for-agent-review: give-up email failed (continuing with PR comment)\n' >&2
    fi
  else
    if ! agent_review_email_loop_stopped \
        "${repo}" "${pr}" 6 TIMEOUT "${reason}" '{}'; then
      printf 'wait-for-agent-review: give-up email failed (continuing with PR comment)\n' >&2
    fi
  fi
  if ! agent_review_post_give_up_comment "${repo}" "${pr}" "${reason}" "${mode}"; then
    printf 'wait-for-agent-review: give-up PR comment failed\n' >&2
  fi
  agent_review_loop_notified=1
  if [[ "${mode}" == 'quota' ]]; then
    error_tag='AGENT_REVIEW_QUOTA_EXHAUSTED'
    exit_code=7
  else
    error_tag='WAIT_TIMEOUT agent-review-give-up'
    exit_code=6
  fi
  printf 'ERROR: %s pr=%s repo=%s reason=%s\n' \
    "${error_tag}" "${pr}" "${repo}" "${reason}" >&2
  return "${exit_code}"
}

cmd_loop_observe_quota_on_pr() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="$4"

  agent_review_observe_all_agent_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}" || true
}

# True when all feedback is addressed and we may start the idle-success timer.
cmd_loop_ready_for_idle_wait() {
  local -r status="$1"
  local pending ci_ready merge_ready

  pending="$(wait_ar_jq_status "$status" '.pending_threads // 0')"
  if (( pending > 0 )); then
    return 1
  fi
  ci_ready="$(wait_ar_jq_status "$status" '.ci_ready')"
  merge_ready="$(wait_ar_jq_status "$status" '.merge_ready')"
  [[ "${ci_ready}" == 'true' && "${merge_ready}" == 'true' ]]
}

agent_review_loop_wait_reset_head() {
  local -r head="$1"

  if [[ "${agent_review_loop_wait_head}" != "${head}" ]]; then
    agent_review_loop_wait_head="${head}"
    agent_review_loop_wait_agents=''
  fi
}

agent_review_loop_wait_add() {
  local -r agent="$1"
  local -r head="$2"

  if [[ -z "${agent}" || -z "${head}" ]]; then
    return 0
  fi
  agent_review_loop_wait_reset_head "${head}"
  if [[ " ${agent_review_loop_wait_agents} " == *" ${agent} "* ]]; then
    return 0
  fi
  if [[ -z "${agent_review_loop_wait_agents}" ]]; then
    agent_review_loop_wait_agents="${agent}"
  else
    agent_review_loop_wait_agents="${agent_review_loop_wait_agents} ${agent}"
  fi
}

agent_review_loop_wait_remove() {
  local -r agent="$1"
  local out='' a

  for a in ${agent_review_loop_wait_agents}; do
    if [[ "${a}" != "${agent}" ]]; then
      if [[ -z "${out}" ]]; then
        out="${a}"
      else
        out="${out} ${a}"
      fi
    fi
  done
  agent_review_loop_wait_agents="${out}"
}

agent_review_loop_wait_any() {
  [[ -n "${agent_review_loop_wait_agents}" ]]
}

# True when the agent has responded on this head (or is exhausted — stop waiting).
cmd_loop_agent_response_seen() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r agent="$4"
  local -r snapshot="$5"
  local saved_agent

  if agent_review_agent_quota_exhausted_for_agent "${agent}"; then
    if agent_review_agent_quota_rate_limited_for_agent "${agent}"; then
      return 1
    fi
    return 0
  fi
  # Stale probe_requested TTL: stop waiting so the loop can fall through the chain (#408).
  if agent_review_agent_quota_probe_expired_for_agent "${agent}"; then
    return 0
  fi
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  agent_review_use_agent "${agent}"
  if [[ "${agent}" == 'copilot' ]] \
    && declare -F agent_review_profile_review_complete_on_head >/dev/null 2>&1; then
    if agent_review_profile_review_complete_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
      agent_review_use_agent "${saved_agent}"
      return 0
    fi
    agent_review_use_agent "${saved_agent}"
    return 1
  fi
  if agent_review_fresh_agent_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    agent_review_use_agent "${saved_agent}"
    return 0
  fi
  if [[ "${agent}" == 'coderabbit' ]] \
    && agent_review_fresh_agent_review_on_head "${snapshot}" "${head}" \
    && ! agent_review_named_pr_check_is_pending "${repo}" "${pr}" 'CodeRabbit'; then
    agent_review_use_agent "${saved_agent}"
    return 0
  fi
  if agent_review_head_has_inline_actionable_review_on_head "${snapshot}" "${head}"; then
    agent_review_use_agent "${saved_agent}"
    return 0
  fi
  if [[ "${agent}" == 'copilot' ]] \
    && declare -F agent_review_copilot_success_issue_comment_for_head >/dev/null 2>&1; then
    local comments_json success_body
    comments_json="$(agent_review_pr_issue_comments_json "${repo}" "${pr}")"
    success_body="$(agent_review_copilot_success_issue_comment_for_head "${comments_json}" "${head}")"
    if [[ -n "${success_body}" ]]; then
      agent_review_use_agent "${saved_agent}"
      return 0
    fi
  fi
  if agent_review_head_check_complete_on_head "${repo}" "${head}"; then
    agent_review_use_agent "${saved_agent}"
    return 0
  fi
  agent_review_use_agent "${saved_agent}"
  return 1
}

cmd_loop_refresh_waiting_agents() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="$4"
  local agent agents

  agent_review_loop_wait_reset_head "${head}"
  agents="${agent_review_loop_wait_agents}"
  for agent in ${agents}; do
    if cmd_loop_agent_response_seen "${repo}" "${pr}" "${head}" "${agent}" "${snapshot}"; then
      agent_review_loop_wait_remove "${agent}"
    fi
  done
}

cmd_loop_track_outstanding_agent_reviews() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local -r snapshot="$4"
  local saved_agent agent

  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  for agent in copilot bugbot; do
    agent_review_use_agent "${agent}"
    if declare -F agent_review_profile_review_outstanding >/dev/null 2>&1 \
      && agent_review_profile_review_outstanding "${snapshot}" "${head}" "${repo}" "${pr}"; then
      agent_review_loop_wait_add "${agent}" "${head}"
    elif agent_review_agent_requested_from_snapshot "${snapshot}" \
      && ! cmd_loop_agent_response_seen "${repo}" "${pr}" "${head}" "${agent}" "${snapshot}"; then
      agent_review_loop_wait_add "${agent}" "${head}"
    fi
  done
  agent_review_use_agent "${saved_agent}"
}

# True when feedback/CI/merge are green and no agent wait remains for this head
# (requested Copilot/Bugbot, or expected CodeRabbit auto-review).
cmd_loop_nothing_outstanding() {
  local -r repo="$1"
  local -r pr="$2"
  local -r status="$3"
  local -r snapshot="$4"
  local -r head="$5"
  local saved_agent agent

  if ! cmd_loop_ready_for_idle_wait "${status}"; then
    return 1
  fi
  # Head must have at least one agent sign-off (real pass) — not a bare CR status.
  if ! agent_review_agent_signed_off_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    return 1
  fi
  # Also block while a CodeRabbit workflow is actively running (even if wait list
  # was cleared by a stale prior-head signal).
  if ! agent_review_agent_quota_exhausted_for_agent 'coderabbit' \
    && agent_review_named_pr_check_is_pending "${repo}" "${pr}" 'CodeRabbit'; then
    return 1
  fi
  if agent_review_agent_quota_rate_limited_for_agent 'coderabbit' \
    && ! agent_review_agent_signed_off_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    return 1
  fi
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  for agent in copilot bugbot; do
    agent_review_use_agent "${agent}"
    if declare -F agent_review_profile_review_outstanding >/dev/null 2>&1 \
      && agent_review_profile_review_outstanding "${snapshot}" "${head}" "${repo}" "${pr}"; then
      agent_review_use_agent "${saved_agent}"
      return 1
    fi
    if agent_review_agent_requested_from_snapshot "${snapshot}" \
      && ! cmd_loop_agent_response_seen "${repo}" "${pr}" "${head}" "${agent}" "${snapshot}"; then
      agent_review_use_agent "${saved_agent}"
      return 1
    fi
  done
  agent_review_use_agent "${saved_agent}"
  cmd_loop_refresh_waiting_agents "${repo}" "${pr}" "${head}" "${snapshot}"
  if agent_review_loop_wait_any; then
    return 1
  fi
  return 0
}

# Sleep until CodeRabbit retry_after (if any), then wait for automatic on-push review.
# Ordinary "@coderabbitai review" is never posted. After cooldown +
# AGENT_REVIEW_CODERABBIT_POST_COOLDOWN_GRACE (default 60s), if still no review on head,
# post a one-shot "@coderabbitai full review" (issue #347 / operator policy).
# Long cooldowns wait until retry_after with short feedback-poll chunks (issues #366 / #369).
# Returns 0 when this iteration should continue (rate-limit handling consumed the turn),
# including when the PR merges mid-wait (outer loop then exits 0).
# Returns 3 when pending human/agent feedback appears mid-wait (triage immediately).
cmd_loop_handle_coderabbit_rate_limit() {
  local -r repo="$1"
  local -r pr="$2"
  local -r head="$3"
  local snapshot="${4:-}"
  local saved_agent retry_after remaining sleep_s retry_epoch now_epoch grace_s grace_remaining
  local profiles_dir coderabbit_profile _owner _name sent_rc
  local poll_s pending_exit provisional_retry

  if [[ -n "${snapshot}" ]] \
    && agent_review_agent_signed_off_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    printf 'wait-for-agent-review: skipping CodeRabbit rate-limit sleep — an agent signed off on head %s (PR #%s)\n' \
      "${head:0:7}" "${pr}" >&2
    return 1
  fi
  # Do not treat bare "CodeRabbit: Review completed" commit status as a sign-off.
  # A rate-limit/summarize stub can still flip that status while no real review exists.
  retry_after="$(agent_review_agent_quota_cache_retry_after_for_agent 'coderabbit')"
  if [[ -z "${retry_after}" ]]; then
    return 1
  fi
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  agent_review_use_agent 'coderabbit'
  if agent_review_agent_quota_rate_limited_for_agent 'coderabbit'; then
    agent_review_loop_wait_add 'coderabbit' "${head}"
    agent_review_use_agent "${saved_agent}"
    # shellcheck disable=SC2154  # rate-limit poll/wait defaults assigned in scripts/lib/agent-review
    poll_s="${agent_review_default_coderabbit_rate_limit_poll_s}"
    if (( poll_s < 1 )); then
      poll_s=1
    fi
    if (( poll_s < 5 )); then
      poll_s=5
    fi
    # shellcheck disable=SC2154  # agent_review_default_coderabbit_rate_limit_wait_max_s from lib
    # Clamp to WAIT_MAX last so the documented max is authoritative (even if < 5s).
    if (( poll_s > agent_review_default_coderabbit_rate_limit_wait_max_s )); then
      poll_s="${agent_review_default_coderabbit_rate_limit_wait_max_s}"
    fi
    if (( poll_s < 1 )); then
      poll_s=1
    fi
    # Poll pending feedback / merge between short sleeps so triage and early
    # exit are not deferred for the full CodeRabbit cooldown (issues #369 / merge wake).
    while agent_review_agent_quota_rate_limited_for_agent 'coderabbit'; do
      if agent_review_pr_is_merged "${repo}" "${pr}"; then
        printf 'wait-for-agent-review: PR #%s merged during CodeRabbit rate-limit wait — stopping\n' \
          "${pr}" >&2
        agent_review_loop_wait_remove 'coderabbit' || true
        return 0
      fi
      # Refresh snapshot each chunk — a mid-wait Copilot/Bugbot/CR sign-off must be visible.
      read -r _owner _name < <(agent_review_repo_parts "${repo}")
      snapshot="$(agent_review_graphql_pr_snapshot "${_owner}" "${_name}" "${pr}" 2>/dev/null || true)"
      if [[ -n "${snapshot}" ]] \
        && agent_review_agent_signed_off_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
        agent_review_agent_quota_clear_observed_for_agent 'coderabbit'
        printf 'wait-for-agent-review: agent signed off during CodeRabbit rate-limit wait on PR #%s — clearing wait\n' \
          "${pr}" >&2
        agent_review_loop_wait_remove 'coderabbit' || true
        return 1
      fi
      pending_exit=0
      agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
      if (( pending_exit == 3 )); then
        agent_review_loop_set_stop 'THREADS_PENDING' \
          'Feedback items still need a reply or resolve (threads, issue comments, review bodies).'
        printf 'wait-for-agent-review: pending feedback during CodeRabbit rate-limit wait on PR #%s — surfacing triage (exit 3)\n' \
          "${pr}" >&2
        return 3
      fi
      remaining="$(agent_review_agent_quota_seconds_until_retry_for_agent 'coderabbit' || true)"
      if [[ -z "${remaining}" ]]; then
        remaining="${poll_s}"
      fi
      if (( remaining <= 0 )); then
        break
      fi
      if (( remaining > poll_s )); then
        sleep_s="${poll_s}"
      else
        # Final chunk: pad slightly past retry_after so the next iteration sees elapsed.
        sleep_s=$((remaining + 5))
      fi
      if (( sleep_s < 1 )); then
        sleep_s=1
      fi
      if (( sleep_s < 5 )); then
        sleep_s=5
      fi
      # shellcheck disable=SC2154  # agent_review_default_coderabbit_rate_limit_wait_max_s from lib
      # WAIT_MAX last — must remain the hard ceiling even when configured below 5s.
      if (( sleep_s > agent_review_default_coderabbit_rate_limit_wait_max_s )); then
        sleep_s="${agent_review_default_coderabbit_rate_limit_wait_max_s}"
      fi
      if (( sleep_s < 1 )); then
        sleep_s=1
      fi
      printf 'wait-for-agent-review: CodeRabbit rate-limited until %s (%ss remaining) — sleeping poll chunk %ss (poll=%ss, max=%ss) on PR #%s\n' \
        "${retry_after}" "${remaining}" "${sleep_s}" "${poll_s}" \
        "${agent_review_default_coderabbit_rate_limit_wait_max_s}" "${pr}" >&2
      run_command "coderabbit rate-limit poll sleep" sleep "${sleep_s}"
    done
    return 0
  fi

  # Cooldown elapsed: wait POST_COOLDOWN_GRACE for on-push, then last-resort full review
  # once if still missing. Keep observed cache (with past retry_after) until we finish so
  # the next poll still sees retry_after after grace sleep.
  agent_review_loop_wait_add 'coderabbit' "${head}"

  if [[ -n "${snapshot}" ]] \
    && cmd_loop_agent_response_seen "${repo}" "${pr}" "${head}" 'coderabbit' "${snapshot}"; then
    agent_review_agent_quota_clear_observed_for_agent 'coderabbit'
    printf 'wait-for-agent-review: CodeRabbit rate-limit window elapsed — review already present on head %s (PR #%s)\n' \
      "${head:0:7}" "${pr}" >&2
    agent_review_loop_wait_remove 'coderabbit'
    agent_review_use_agent "${saved_agent}"
    return 1
  fi

  profiles_dir="$(cd "${script_dir}/lib/agent-review-profiles" && pwd)"
  coderabbit_profile="${profiles_dir}/coderabbit"
  # shellcheck disable=SC1090,SC1091  # profile loaded at runtime for last-resort helpers
  source "${coderabbit_profile}"

  sent_rc=0
  agent_review_coderabbit_full_review_already_sent "${repo}" "${pr}" "${head}" || sent_rc=$?
  if (( sent_rc == 0 )); then
    agent_review_agent_quota_clear_observed_for_agent 'coderabbit'
    printf 'wait-for-agent-review: CodeRabbit full review already requested for head %s — waiting on PR #%s\n' \
      "${head:0:7}" "${pr}" >&2
    agent_review_use_agent "${saved_agent}"
    return 1
  fi
  if (( sent_rc == 2 )); then
    printf 'wait-for-agent-review: CodeRabbit full-review marker lookup failed for PR #%s — will retry\n' \
      "${pr}" >&2
    agent_review_use_agent "${saved_agent}"
    return 0
  fi

  retry_epoch="$(runner_exec_stdout "coderabbit cooldown retry_after epoch" -- \
    date -u -d "${retry_after}" +%s 2>/dev/null || true)"
  now_epoch="$(runner_exec_stdout "coderabbit cooldown now epoch" -- date -u +%s)"
  # shellcheck disable=SC2154  # agent_review_default_coderabbit_post_cooldown_grace_s from lib
  grace_s="${agent_review_default_coderabbit_post_cooldown_grace_s}"
  if [[ -z "${retry_epoch}" ]]; then
    grace_remaining="${grace_s}"
  else
    grace_remaining=$((retry_epoch + grace_s - now_epoch))
  fi
  if (( grace_remaining > 0 )); then
    if agent_review_pr_is_merged "${repo}" "${pr}"; then
      printf 'wait-for-agent-review: PR #%s merged before CodeRabbit post-cooldown grace — stopping\n' \
        "${pr}" >&2
      agent_review_loop_wait_remove 'coderabbit' || true
      agent_review_use_agent "${saved_agent}"
      return 0
    fi
    sleep_s="${grace_remaining}"
    if (( sleep_s < 1 )); then
      sleep_s=1
    fi
    if (( sleep_s < 5 )); then
      sleep_s=5
    fi
    # WAIT_MAX last so the documented ceiling stays authoritative.
    if (( sleep_s > agent_review_default_coderabbit_rate_limit_wait_max_s )); then
      sleep_s="${agent_review_default_coderabbit_rate_limit_wait_max_s}"
    fi
    if (( sleep_s < 1 )); then
      sleep_s=1
    fi
    printf 'wait-for-agent-review: CodeRabbit cooldown elapsed at %s — waiting %ss grace (of %ss) for on-push review before full review on PR #%s\n' \
      "${retry_after}" "${sleep_s}" "${grace_s}" "${pr}" >&2
    agent_review_use_agent "${saved_agent}"
    run_command "coderabbit post-cooldown grace sleep" sleep "${sleep_s}"
    return 0
  fi

  # Re-check after grace (parameter snapshot may be stale).
  local fresh_snapshot
  read -r _owner _name < <(agent_review_repo_parts "${repo}")
  fresh_snapshot="$(agent_review_graphql_pr_snapshot "${_owner}" "${_name}" "${pr}" 2>/dev/null || true)"
  if [[ -n "${fresh_snapshot}" ]] \
    && agent_review_agent_signed_off_on_head "${fresh_snapshot}" "${head}" "${repo}" "${pr}"; then
    agent_review_agent_quota_clear_observed_for_agent 'coderabbit'
    printf 'wait-for-agent-review: agent signed off during grace on head %s (PR #%s) — skipping full review\n' \
      "${head:0:7}" "${pr}" >&2
    agent_review_loop_wait_remove 'coderabbit'
    agent_review_use_agent "${saved_agent}"
    return 1
  fi
  if [[ -n "${fresh_snapshot}" ]] \
    && cmd_loop_agent_response_seen "${repo}" "${pr}" "${head}" 'coderabbit' "${fresh_snapshot}"; then
    agent_review_agent_quota_clear_observed_for_agent 'coderabbit'
    printf 'wait-for-agent-review: CodeRabbit on-push review arrived during grace on head %s (PR #%s) — skipping full review\n' \
      "${head:0:7}" "${pr}" >&2
    agent_review_loop_wait_remove 'coderabbit'
    agent_review_use_agent "${saved_agent}"
    return 1
  fi
  # Bare "Review completed" commit status is not a sign-off — still may post full review.
  if agent_review_named_pr_check_is_pending "${repo}" "${pr}" 'CodeRabbit'; then
    printf 'wait-for-agent-review: CodeRabbit workflow still in progress on PR #%s — deferring last-resort full review\n' \
      "${pr}" >&2
    agent_review_use_agent "${saved_agent}"
    return 0
  fi

  printf 'wait-for-agent-review: CodeRabbit still missing after cooldown+%ss — posting last-resort full review on PR #%s head %s\n' \
    "${grace_s}" "${pr}" "${head:0:7}" >&2
  # Re-check rate-limit immediately before posting — a mid-grace CR "wait N minutes"
  # reply must block the ask (when told to wait, wait; do not re-ask).
  if agent_review_agent_quota_rate_limited_for_agent 'coderabbit'; then
    printf 'wait-for-agent-review: CodeRabbit became rate-limited before full review on PR #%s — waiting instead of asking\n' \
      "${pr}" >&2
    agent_review_use_agent "${saved_agent}"
    return 0
  fi
  if ! agent_review_profile_request_last_resort_full_review "${repo}" "${pr}" "${head}"; then
    printf 'wait-for-agent-review: failed to request CodeRabbit full review; retrying\n' >&2
    agent_review_use_agent "${saved_agent}"
    return 0
  fi
  # Keep the wait gate closed until CR replies (observe extends retry_after) or grace
  # elapses. Clearing observed here used to allow another full-review ask while CR's
  # "More reviews will be available in N minutes" reply was still in flight.
  if ! [[ "${grace_s}" =~ ^[0-9]+$ ]] || (( grace_s < 1 )); then
    grace_s="${agent_review_default_coderabbit_post_cooldown_grace_s:-60}"
  fi
  if ! [[ "${grace_s}" =~ ^[0-9]+$ ]] || (( grace_s < 1 )); then
    grace_s=60
  fi
  provisional_retry=''
  provisional_retry="$(runner_exec_stdout "coderabbit post-full-review provisional retry_after" -- \
    date --utc --date="now + ${grace_s} seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  if [[ -z "${provisional_retry}" ]]; then
    printf 'wait-for-agent-review: warning: could not compute provisional retry_after (grace_s=%s) on PR #%s — using +60s fallback\n' \
      "${grace_s}" "${pr}" >&2
    provisional_retry="$(runner_exec_stdout "coderabbit post-full-review provisional retry_after fallback" -- \
      date --utc --date='now + 60 seconds' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  fi
  if [[ -n "${provisional_retry}" ]]; then
    agent_review_coderabbit_quota_mark_exhausted \
      "CodeRabbit full review requested on ${repo}#${pr}; holding asks until response or grace." \
      "" "${provisional_retry}" || true
  else
    printf 'wait-for-agent-review: error: provisional retry_after unavailable after full review on PR #%s — refusing to clear wait gate\n' \
      "${pr}" >&2
  fi
  agent_review_use_agent "${saved_agent}"
  # Return 1 so observe-rewritten past retry_after does not spin forever after the nudge.
  return 1
}

# Request one probe agent on a new head (coderabbit → copilot → bugbot).
# Two trigger kinds (issue #347):
#   on_push — wait for automatic review after push (CodeRabbit); never post a nudge.
#   nudge   — post an explicit PR comment / request (Copilot, Bugbot).
# Escalates to the next agent when a request is blocked or quota is exhausted.
cmd_loop_maybe_request_agents_on_head() {
  local repo pr head last_head agent profiles_dir profile_path request_exit saved_agent
  local current_agent owner name snapshot

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  head="${3:-}"
  last_head="${4:-}"
  if [[ -z "${head}" ]]; then
    return 0
  fi
  if [[ -n "${last_head}" && "${head}" == "${last_head}" ]]; then
    return 0
  fi
  profiles_dir="$(cd "${script_dir}/lib/agent-review-profiles" && pwd)"
  saved_agent="${AGENT_REVIEW_AGENT:-copilot}"
  current_agent=''
  read -r owner name < <(agent_review_repo_parts "${repo}")
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}" 2>/dev/null || true)"
  while true; do
    if ! agent="$(agent_review_quota_probe_agent_for_today 2>/dev/null)"; then
      printf 'wait-for-agent-review: all agent quotas exhausted for today — no review requests on PR #%s\n' \
        "${pr}" >&2
      break
    fi
    if [[ "${agent}" == "${current_agent}" ]]; then
      break
    fi
    current_agent="${agent}"
    profile_path="${profiles_dir}/${agent}"
    if [[ ! -f "${profile_path}" ]]; then
      break
    fi
    # shellcheck disable=SC1090  # agent profile contract loaded at runtime
    # shellcheck disable=SC1091
    source "${profile_path}"
    agent_review_use_agent "${agent}"
    if [[ "${agent_review_profile_trigger:-nudge}" == 'on_push' \
      || "${agent_review_profile_auto_review:-false}" == 'true' ]]; then
      printf 'wait-for-agent-review: %s is on_push — skipping nudge; waiting for automatic review on PR #%s\n' \
        "${agent}" "${pr}" >&2
      # Expect an on-push review on this head; clear once fresh/check-complete/exhausted.
      agent_review_loop_wait_add "${agent}" "${head}"
      break
    fi
    # Skip re-request when this head already has a fresh agent response (issue #347).
    if [[ -n "${snapshot}" ]] \
      && cmd_loop_agent_response_seen "${repo}" "${pr}" "${head}" "${agent}" "${snapshot}"; then
      printf 'wait-for-agent-review: skip_request_reason=already_reviewed_on_head agent=%s head=%s PR #%s\n' \
        "${agent}" "${head:0:7}" "${pr}" >&2
      agent_review_loop_wait_remove "${agent}"
      break
    fi
    request_exit=0
    cmd_request "${repo}" "${pr}" || request_exit=$?
    if (( request_exit == 7 )); then
      agent_review_quota_mark_exhausted_for_agent "${agent}" \
        "${agent} review quota or usage limit exhausted while requesting a review."
      cmd_handle_quota_exhaustion "${repo}" "${pr}" \
        "${agent} review quota or usage limit exhausted while requesting a review." || true
      continue
    fi
    if (( request_exit != 0 )); then
      agent_review_die 'failed to request agent review'
    fi
    agent_review_quota_mark_probe_requested_for_agent "${agent}" \
      "${agent} review requested on PR #${pr} to probe quota."
    agent_review_loop_wait_add "${agent}" "${head}"
    agent_review_use_agent "${agent}"
    return 0
  done
  agent_review_sync_active_probe_agent || agent_review_use_agent "${saved_agent}"
}

cmd_loop_give_up_non_convergence() {
  local repo pr pr_cap status quota_summary pending head_sha reason

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  pr_cap="${3:-0}"
  status="$(cmd_status "${repo}" "${pr}" 2>/dev/null || true)"
  quota_summary="$(agent_review_quota_summary_for_email "${repo}" "${pr}")"
  pending="$(wait_ar_jq_status "$status" '.pending_threads // 0' 2>/dev/null || echo 0)"
  head_sha="$(wait_ar_jq_status "$status" '.head_sha // ""' 2>/dev/null || true)"
  reason="Overall PR review exceeded AGENT_REVIEW_PR_TIMEOUT (${pr_cap}s) without reaching idle-success.

Pending threads: ${pending}
Head: ${head_sha}

Agent quota today:
${quota_summary}

The PR kept receiving reviews or still has unaddressed feedback. Triage open threads, fix CI/merge blockers, then re-run: scripts/wait-for-agent-review loop --pr ${pr}"
  cmd_give_up "${repo}" "${pr}" "${reason}"
  return $?
}

cmd_complete_idle() {
  local repo pr idle_s cycle_cap status complete_ready owner name snapshot head
  local mode pending_count work_checklist

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  idle_s="${3:-0}"
  cycle_cap="${4:-0}"
  mode="${5:-idle}"
  # Early complete (nothing outstanding) must not block on daily quota probes.
  if [[ "${mode}" != 'early' ]] && ! agent_review_daily_quota_probe_satisfied; then
    printf 'wait-for-agent-review: idle wait elapsed but daily quota probe is unsatisfied — not completing\n' >&2
    return 2
  fi
  read -r owner name < <(agent_review_repo_parts "${repo}")
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
  agent_review_assert_snapshot_complete "${snapshot}"
  head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid')"
  agent_review_observe_all_agent_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}" || true
  status="$(cmd_status "${repo}" "${pr}")"
  if [[ "${mode}" == 'early' ]] \
    && ! cmd_loop_nothing_outstanding "${repo}" "${pr}" "${status}" "${snapshot}" "${head}"; then
    printf 'wait-for-agent-review: refusing early complete — agent review still outstanding on PR #%s\n' \
      "${pr}" >&2
    return 2
  fi
  # Re-check pending feedback immediately before complete email (issue #347 / #352):
  # Bugbot quota comments can land between the loop gate and this path.
  pending_count="$(agent_review_pending_thread_count_from_snapshot "${repo}" "${pr}" "${snapshot}")"
  if (( pending_count > 0 )); then
    printf 'wait-for-agent-review: refusing idle complete — %s feedback item(s) still pending on PR #%s\n' \
      "${pending_count}" "${pr}" >&2
    return 3
  fi
  complete_ready="$(wait_ar_jq_status "$status" '.complete_ready')"
  if [[ "${complete_ready}" == 'true' ]]; then
    cmd_complete "${repo}" "${pr}"
    return $?
  fi
  # Final checklist must agree with the gate (single source of truth for operator email).
  work_checklist="$(agent_review_email_work_complete_checklist "${repo}" "${pr}")"
  if grep -qE 'Pending feedback \(threads \+ PR comments\): [1-9]' <<<"${work_checklist}" \
    || grep -qF 'review requested (visible on PR)' <<<"${work_checklist}" \
    || grep -qF 'awaiting review completion' <<<"${work_checklist}"; then
    printf 'wait-for-agent-review: refusing idle complete — work checklist still shows outstanding work on PR #%s\n' \
      "${pr}" >&2
    return 2
  fi
  # Do not email "complete" without an agent sign-off on this head (bare CR status is not enough).
  if ! agent_review_agent_signed_off_on_head "${snapshot}" "${head}" "${repo}" "${pr}"; then
    printf 'wait-for-agent-review: refusing idle complete — no agent sign-off on head %s (PR #%s)\n' \
      "${head:0:7}" "${pr}" >&2
    return 2
  fi
  # No gh self-approve — email only; merge stays an explicit operator step.
  agent_review_email_idle_complete "${repo}" "${pr}" "${idle_s}" "${mode}"
  if [[ "${mode}" == 'early' ]]; then
    printf 'PR #%s review cycle complete (nothing outstanding; emailed operator, no self-approve)\n' \
      "${pr}" >&2
  else
    printf 'PR #%s review cycle complete (idle %ss; emailed operator, no self-approve)\n' \
      "${pr}" "${idle_s}" >&2
  fi
  return 0
}

cmd_loop() {
  local repo pr pr_started last_head head now
  local pr_cap cycle_cap check_exit ci_exit pending_exit rate_exit status
  local owner name snapshot complete_exit
  local transient_retries transient_max transient_sleep restack_exit

  repo="$(agent_review_resolve_repo "${1:-}")"
  pr="$(agent_review_resolve_pr "${2:-}" "${repo}")"
  # shellcheck disable=SC2154  # agent_review_default_* timeout constants from sourced lib
  pr_cap="${agent_review_default_pr_timeout_s}"
  # shellcheck disable=SC2154  # agent_review_default_cycle_timeout_s from sourced lib
  cycle_cap="${agent_review_default_cycle_timeout_s}"
  # shellcheck disable=SC2154  # agent_review_default_transient_* from sourced lib
  transient_max="${agent_review_default_transient_retries}"
  # shellcheck disable=SC2154
  transient_sleep="${agent_review_default_transient_retry_sleep_s}"
  agent_review_require_cmd gh
  agent_review_require_cmd jq
  pr_started="$(date +%s)"
  last_head=''
  transient_retries=0
  agent_review_loop_wait_head=''
  agent_review_loop_wait_agents=''
  agent_review_loop_attempt_max="${transient_max}"
  agent_review_log_cycle_quota_preamble
  agent_review_sync_active_probe_agent || true
  printf 'Agent review loop for PR #%s (early-complete when idle, PR cap=%ss, transient retries=%s)\n' \
    "${pr}" "${pr_cap}" "${transient_max}" >&2

  while true; do
    now="$(date +%s)"
    if (( now - pr_started >= pr_cap )); then
      status="$(cmd_status "${repo}" "${pr}" 2>/dev/null || true)"
      read -r owner name < <(agent_review_repo_parts "${repo}")
      snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}" 2>/dev/null || true)"
      head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid' 2>/dev/null || true)"
      if [[ -n "${snapshot}" && -n "${head}" ]] \
        && cmd_loop_nothing_outstanding "${repo}" "${pr}" "${status}" "${snapshot}" "${head}"; then
        complete_exit=0
        cmd_complete_idle "${repo}" "${pr}" 0 "${cycle_cap}" early || complete_exit=$?
        if (( complete_exit == 0 )); then
          return 0
        fi
      fi
      cmd_loop_give_up_non_convergence "${repo}" "${pr}" "${pr_cap}"
      return $?
    fi
    if agent_review_pr_is_merged "${repo}" "${pr}"; then
      printf 'PR #%s is merged — loop complete\n' "${pr}" >&2
      return 0
    fi
    ci_exit=0
    cmd_loop_abort_if_ci_failed "${repo}" "${pr}" || ci_exit=$?
    if (( ci_exit == 10 )); then
      agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
      return 10
    fi
    if (( ci_exit == 2 )); then
      printf 'wait-for-agent-review loop: waiting for CI on PR #%s…\n' "${pr}" >&2
      sleep "${agent_review_default_poll_interval_s}"
      continue
    fi

    pending_exit=0
    agent_review_abort_if_pending_threads "${repo}" "${pr}" || pending_exit=$?
    if (( pending_exit == 3 )); then
      agent_review_loop_set_stop 'THREADS_PENDING' \
        'Feedback items still need a reply or resolve (threads, issue comments, review bodies).'
      return 3
    fi

    read -r owner name < <(agent_review_repo_parts "${repo}")
    snapshot="$(agent_review_graphql_pr_snapshot "${owner}" "${name}" "${pr}")"
    agent_review_assert_snapshot_complete "${snapshot}"
    head="$(wait_ar_jq_snapshot "$snapshot" '.data.repository.pullRequest.headRefOid')"
    cmd_loop_observe_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}"
    agent_review_sync_active_probe_agent || true
    # Wait for an in-flight CodeRabbit on-push check before last-resort full review.
    # handle_coderabbit_rate_limit used to run first and could post @coderabbitai full review
    # while the push-triggered workflow was still pending (repository-helpers#368).
    if ! agent_review_agent_quota_exhausted_for_agent 'coderabbit' \
      && agent_review_named_pr_check_is_pending "${repo}" "${pr}" 'CodeRabbit'; then
      printf 'wait-for-agent-review loop: CodeRabbit workflow in progress on PR #%s…\n' "${pr}" >&2
      sleep "${agent_review_default_poll_interval_s}"
      continue
    fi
    rate_exit=0
    cmd_loop_handle_coderabbit_rate_limit "${repo}" "${pr}" "${head}" "${snapshot}" || rate_exit=$?
    if (( rate_exit == 3 )); then
      return 3
    fi
    if (( rate_exit == 0 )); then
      continue
    fi
    if [[ -z "${last_head}" ]]; then
      cmd_loop_maybe_request_agents_on_head "${repo}" "${pr}" "${head}" ""
      last_head="${head}"
    elif [[ "${head}" != "${last_head}" ]]; then
      cmd_loop_maybe_request_agents_on_head "${repo}" "${pr}" "${head}" "${last_head}"
      last_head="${head}"
    fi

    check_exit=0
    cmd_check "${repo}" "${pr}" || check_exit=$?
    case "${check_exit}" in
      0)
        cmd_complete "${repo}" "${pr}"
        return 0
        ;;
      3)
        agent_review_loop_set_stop 'THREADS_PENDING' \
          'Feedback items still need a reply or resolve (threads, issue comments, review bodies).'
        return 3
        ;;
      4)
        restack_exit=0
        cmd_restack "${repo}" "${pr}" || restack_exit=$?
        if (( restack_exit == 0 )); then
          transient_retries=0
          agent_review_loop_attempt_count=0
          agent_review_loop_last_error=''
          agent_review_loop_last_merge_state=''
          last_head=''
          continue
        fi
        if (( restack_exit == 4 )); then
          agent_review_loop_attempt_count=$((transient_retries + 1))
          agent_review_loop_set_stop 'RESTACK_FAILED' \
            "${agent_review_loop_last_error:-Restack failed permanently — human intervention required.}"
          return 4
        fi
        # Transient restack / mergeability failure — retry with backoff.
        # Count this failure toward the cap; stop when attempts reach the max.
        transient_retries=$((transient_retries + 1))
        agent_review_loop_attempt_count="${transient_retries}"
        if (( transient_retries >= transient_max )); then
          agent_review_loop_set_stop 'RESTACK_FAILED' \
            "${agent_review_loop_last_error:-Transient restack/mergeability failures exhausted.}"
          return 4
        fi
        printf 'wait-for-agent-review loop: transient restack/mergeability issue on PR #%s (retry %s/%s)…\n' \
          "${pr}" "${transient_retries}" "${transient_max}" >&2
        sleep "${transient_sleep}"
        continue
        ;;
      7)
        cmd_handle_quota_exhaustion "${repo}" "${pr}" \
          "${AGENT_REVIEW_AGENT:-copilot} review quota or usage limit exhausted on the current PR head." \
          || true
        sleep "${agent_review_default_poll_interval_s}"
        continue
        ;;
      8)
        agent_review_loop_set_stop 'AGENT_CHECK_ERROR' \
          'Agent GitHub check failed to run (non-quota).'
        return 8
        ;;
      10)
        agent_review_loop_set_stop 'CI_FAILED' 'Required CI checks failed.'
        return 10
        ;;
      11)
        agent_review_loop_set_stop 'MERGE_STATE_BLOCKED' \
          "${agent_review_loop_last_error:-Permanent merge block — human intervention required.}"
        return 11
        ;;
      5)
        # Fresh review without "no new comments" — still allow early-complete when
        # nothing is outstanding (threads clear, agents delivered, CodeRabbit idle).
        :
        ;;
      2)
        # Pending CI, transient mergeability, or no fresh review yet — keep polling.
        :
        ;;
      *)
        agent_review_loop_set_stop 'LOOP_STOPPED' \
          "Agent review check failed (exit ${check_exit})."
        return "${check_exit}"
        ;;
    esac

    status="$(cmd_status "${repo}" "${pr}")"
    cmd_loop_track_outstanding_agent_reviews "${repo}" "${pr}" "${head}" "${snapshot}"
    cmd_loop_refresh_waiting_agents "${repo}" "${pr}" "${head}" "${snapshot}"

    if cmd_loop_nothing_outstanding "${repo}" "${pr}" "${status}" "${snapshot}" "${head}"; then
      printf 'wait-for-agent-review loop: nothing outstanding — completing on PR #%s\n' \
        "${pr}" >&2
      complete_exit=0
      cmd_complete_idle "${repo}" "${pr}" 0 "${cycle_cap}" early || complete_exit=$?
      if (( complete_exit == 0 )); then
        return 0
      fi
      printf 'wait-for-agent-review loop: early complete aborted (exit %s) — continuing on PR #%s\n' \
        "${complete_exit}" "${pr}" >&2
    fi

    if cmd_loop_ready_for_idle_wait "${status}"; then
      # Feedback/CI/merge are green but we are still waiting on a requested agent
      # or a running CodeRabbit workflow — keep polling (no mandatory idle dwell).
      if agent_review_loop_wait_any; then
        printf 'wait-for-agent-review loop: waiting on agent review(s) [%s] for head %s on PR #%s…\n' \
          "${agent_review_loop_wait_agents}" "${head:0:7}" "${pr}" >&2
      else
        printf 'wait-for-agent-review loop: waiting for CodeRabbit workflow on PR #%s…\n' \
          "${pr}" >&2
      fi
    else
      printf 'wait-for-agent-review loop: waiting for reviews (agents with quota + humans) on PR #%s…\n' \
        "${pr}" >&2
    fi

    # Re-check PR timeline / quota signals before sleeping so Copilot
    # copilot_work_finished_failure (or probe TTL expiry) wakes the loop (#408).
    cmd_loop_observe_quota_on_pr "${repo}" "${pr}" "${head}" "${snapshot}"
    cmd_loop_refresh_waiting_agents "${repo}" "${pr}" "${head}" "${snapshot}"
    if cmd_loop_nothing_outstanding "${repo}" "${pr}" "${status}" "${snapshot}" "${head}"; then
      continue
    fi
    sleep "${agent_review_default_poll_interval_s}"
  done
}

main() {
  local cmd="${1:-}"
  shift || true
  local repo_arg='' pr_arg='' timeout_arg='' interval_arg='' thread_id='' comment_id='' review_id='' reason='' body='' force_resolve=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        repo_arg="$(agent_review_require_option_value --repo "${2:-}")"
        shift 2
        ;;
      --pr)
        pr_arg="$(agent_review_require_option_value --pr "${2:-}")"
        shift 2
        ;;
      --timeout)
        timeout_arg="$(agent_review_require_option_value --timeout "${2:-}")"
        shift 2
        ;;
      --poll-interval)
        interval_arg="$(agent_review_require_option_value --poll-interval "${2:-}")"
        shift 2
        ;;
      --thread-id)
        thread_id="$(agent_review_require_option_value --thread-id "${2:-}")"
        shift 2
        ;;
      --comment-id)
        comment_id="$(agent_review_require_option_value --comment-id "${2:-}")"
        shift 2
        ;;
      --review-id)
        review_id="$(agent_review_require_option_value --review-id "${2:-}")"
        shift 2
        ;;
      --body)
        body="$(agent_review_require_option_value --body "${2:-}")"
        shift 2
        ;;
      --force)
        force_resolve=1
        shift
        ;;
      --reason)
        reason="$(agent_review_require_option_value --reason "${2:-}")"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        agent_review_die "unknown argument: $1"
        ;;
    esac
  done

  case "${cmd}" in
    -h|--help|help)
      usage
      exit 0
      ;;
    '')
      usage >&2
      exit 1
      ;;
  esac

  agent_review_load_env
  agent_review_load_agent_profile

  case "${cmd}" in
    status)
      cmd_status "${repo_arg}" "${pr_arg}"
      ;;
    request)
      cmd_request "${repo_arg}" "${pr_arg}"
      ;;
    wait)
      cmd_wait "${repo_arg}" "${pr_arg}" \
        "${timeout_arg:-${agent_review_default_wait_timeout_s}}" \
        "${interval_arg:-${agent_review_default_poll_interval_s}}"
      ;;
    list-threads)
      cmd_list_threads "${repo_arg}" "${pr_arg}"
      ;;
    list-human-threads)
      cmd_list_human_threads "${repo_arg}" "${pr_arg}"
      ;;
    list-feedback)
      cmd_list_feedback "${repo_arg}" "${pr_arg}"
      ;;
    check)
      cmd_check "${repo_arg}" "${pr_arg}"
      ;;
    complete)
      cmd_complete "${repo_arg}" "${pr_arg}"
      ;;
    restack)
      cmd_restack "${repo_arg}" "${pr_arg}"
      ;;
    resolve-thread)
      cmd_resolve_thread "${thread_id}" "${force_resolve}"
      ;;
    reply-thread)
      cmd_reply_thread "${thread_id}" "${body}"
      ;;
    reply-comment)
      cmd_reply_comment "${repo_arg}" "${pr_arg}" "${comment_id}" "${review_id}" "${body}"
      ;;
    resolve-comment)
      cmd_resolve_comment "${repo_arg}" "${pr_arg}" "${comment_id}" "${review_id}" "${force_resolve}"
      ;;
    resolve-addressed)
      cmd_resolve_addressed "${repo_arg}" "${pr_arg}"
      ;;
    resolve-human-addressed)
      cmd_resolve_human_addressed "${repo_arg}" "${pr_arg}"
      ;;
    email-failure)
      agent_review_email_failure \
        "$(agent_review_resolve_repo "${repo_arg}")" \
        "$(agent_review_resolve_pr "${pr_arg}" "$(agent_review_resolve_repo "${repo_arg}")")" \
        "${reason:-Agent review loop stopped without reaching complete_ready.}"
      ;;
    give-up)
      cmd_give_up \
        "$(agent_review_resolve_repo "${repo_arg}")" \
        "$(agent_review_resolve_pr "${pr_arg}" "$(agent_review_resolve_repo "${repo_arg}")")" \
        "${reason:-Agent review loop stopped without reaching complete_ready.}"
      ;;
    loop)
      local loop_repo loop_pr loop_exit=0
      loop_repo="$(agent_review_resolve_repo "${repo_arg}")"
      loop_pr="$(agent_review_resolve_pr "${pr_arg}" "${loop_repo}")"
      agent_review_loop_notified=0
      agent_review_loop_stop_reason_code=''
      agent_review_loop_stop_reason_detail=''
      cmd_loop "${repo_arg}" "${pr_arg}" || loop_exit=$?
      cmd_loop_exit_notify "${loop_repo}" "${loop_pr}" "${loop_exit}"
      exit "${loop_exit}"
      ;;
    *)
      agent_review_die "unknown command: ${cmd} (run with --help)"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
