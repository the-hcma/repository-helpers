#!/usr/bin/env bash

# Setup script for a systemd user service.
# Derives the service name from the git remote URL — no hardcoding.
# Repo-specific build/deploy logic belongs in scripts/on-deploy (optional hook).
#
# Worktree behaviour: all paths (service template, on-deploy, @@REPO_DIR@@ in the
# service file) are resolved from the worktree this script is called from.
# Calling setup-service from a feature worktree therefore deploys that worktree's
# code and template, which is the intended behaviour for local development.
#
# Running commit: the generated unit sets Environment=DEPLOYED_COMMIT=<sha> from
# HEAD at setup time. The running process inherits that value until restart; it is
# not inferred from git HEAD at the process cwd (which changes on pull).

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091  # service-host-guard is a sibling lib, not a package
source "${script_dir}/lib/service-host-guard"

# ss_runner_git_c_stdout <repo> <label> -- <git-args…>
ss_runner_git_c_stdout() {
    local -r repo="$1"
    local -r label="$2"
    shift 2
    [[ "${1:-}" == '--' ]] || {
        printf 'ss_runner_git_c_stdout: expected -- before git args (label=%s)\n' "$label" >&2
        return 2
    }
    shift
    local exit_code out

    exit_code=0
    out="$(runner_exec_stdout "$label" -- git -C "$repo" "$@")" || exit_code=$?
    if (( exit_code != 0 )); then
        return "$exit_code"
    fi
    printf '%s' "$out"
}

# ss_runner_git_c_stdout_or_empty <repo> <label> -- <git-args…>
ss_runner_git_c_stdout_or_empty() {
    local -r repo="$1"
    local -r label="$2"
    shift 2
    [[ "${1:-}" == '--' ]] || {
        printf 'ss_runner_git_c_stdout_or_empty: expected -- before git args (label=%s)\n' "$label" >&2
        return 2
    }
    shift
    local exit_code out

    exit_code=0
    out="$(runner_exec_stdout "$label" -- git -C "$repo" "$@")" || exit_code=$?
    if (( exit_code != 0 )); then
        return 0
    fi
    printf '%s' "$out"
}

repo_dir="$(ss_runner_git_c_stdout "$PWD" "setup-service git toplevel" -- rev-parse --show-toplevel)"
readonly repo_dir
# Derive service name from the remote URL so it is stable regardless of which
# worktree or directory name is used (mirrors start-development's approach).
gh_remote="$(
    ss_runner_git_c_stdout "$repo_dir" "setup-service git remote url" -- remote get-url origin \
        | sed 's|.*github.com[:/]||;s|\.git$||'
)"
service_name="${gh_remote##*/}"
readonly service_name
readonly target_dir="${HOME}/.config/systemd/user"
log_dir="${HOME}/scratch/${service_name}"
readonly log_dir
kernel_name="$(uname -s)"
readonly kernel_name
readonly deployed_commit_env_name="DEPLOYED_COMMIT"
readonly expanded_units_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/share/systemd-units"
readonly condition_host_config_path="${HOME}/.config/user-services-host"
readonly condition_host_fqdn_config_path="${HOME}/.config/user-services-host-fqdn"
readonly condition_machine_id_config_path="${HOME}/.config/user-services-machine-id"
readonly service_host_min_systemd_version=259
condition_host_value=""
condition_host_fqdn_value=""
condition_host_machine_id=""
condition_host_cli=""
condition_host_fqdn_cli=""
service_host_machine_id_failure=""

# current_hostname_short
# Short hostname for status messages and setup-service host checks.
current_hostname_short() {
    hostname -s 2>/dev/null || hostname
}

# machine_id_is_valid <id>
# True when id looks like a systemd /etc/machine-id value (32 lowercase hex chars).
machine_id_is_valid() {
    local -r id="$1"

    [[ "$id" =~ ^[0-9a-f]{32}$ ]]
}

# normalize_machine_id <id>
# Strips whitespace and lowercases hex (systemd /etc/machine-id is lowercase).
normalize_machine_id() {
    local id="$1"

    id="$(tr -d '[:space:]' <<<"$id")"
    id="${id,,}"
    printf '%s\n' "$id"
}

# config_file_first_line <path>
# Reads the first line without sed|head pipes (avoids SIGPIPE under set -euo pipefail).
config_file_first_line() {
    local -r path="$1"

    head -n1 "$path"
}

# read_local_hostname_fqdn
# Prints the FQDN from hostname(1) when available, else the short hostname.
read_local_hostname_fqdn() {
    local fqdn short

    short="$(current_hostname_short)"
    fqdn="$(hostname --fqdn 2>/dev/null || true)"
    fqdn="${fqdn#"${fqdn%%[![:space:]]*}"}"
    fqdn="${fqdn%"${fqdn##*[![:space:]]}"}"
    [[ -n "$fqdn" ]] || fqdn="$short"
    printf '%s\n' "$fqdn"
}

# read_local_machine_id
# Prints this machine's ID from /etc/machine-id (used in ConditionHost=|… guards).
read_local_machine_id() {
    local id

    if [[ ! -r /etc/machine-id ]]; then
        return 1
    fi
    id="$(normalize_machine_id "$(< /etc/machine-id)")"
    if ! machine_id_is_valid "$id"; then
        return 1
    fi
    printf '%s\n' "$id"
}

# host_name_matches_service_host
# True when this machine's hostname matches the configured service-host label.
host_name_matches_service_host() {
    local short fqdn

    short="$(current_hostname_short)"
    fqdn="$(hostname 2>/dev/null || printf '%s' "$short")"
    [[ "$short" == "$condition_host_value" ]] \
        || [[ "$fqdn" == "$condition_host_value" ]] \
        || [[ "$fqdn" == "${condition_host_value}."* ]]
}

# save_condition_host_config
# Persists the chosen service host for future setup-service runs.
save_condition_host_config() {
    mkdir -p "$(dirname "$condition_host_config_path")"
    printf '%s\n' "$condition_host_value" >"$condition_host_config_path"
}

# save_condition_host_fqdn_config
# Persists the service-host FQDN (from hostname on that machine).
save_condition_host_fqdn_config() {
    mkdir -p "$(dirname "$condition_host_fqdn_config_path")"
    printf '%s\n' "$condition_host_fqdn_value" >"$condition_host_fqdn_config_path"
}

# save_condition_machine_id_config
# Persists the service-host machine-id (from /etc/machine-id on that host).
save_condition_machine_id_config() {
    mkdir -p "$(dirname "$condition_machine_id_config_path")"
    printf '%s\n' "$condition_host_machine_id" >"$condition_machine_id_config_path"
}

# prompt_for_condition_host
# Interactive first-time setup when ~/.config/user-services-host is missing.
prompt_for_condition_host() {
    local input=""
    local default_host

    default_host="$(current_hostname_short)"
    if [[ ! -t 0 ]]; then
        die "Service host required: create ${condition_host_config_path} or pass --condition-host NAME"
    fi

    echo "Systemd user units run on a single host (ConditionHost=|<machine-id> on systemd ${service_host_min_systemd_version}+, plus hostname fallback)."
    read -r -p "Hostname where services should run [${default_host}]: " input
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"
    if [[ -z "$input" ]]; then
        input="$default_host"
    fi
    condition_host_value="$input"
    save_condition_host_config
    echo "✅ Service host saved to ${condition_host_config_path}"
}

# resolve_condition_host
# Uses --condition-host, then ~/.config/user-services-host, then prompts on first setup.
resolve_condition_host() {
    if [[ -n "$condition_host_cli" ]]; then
        condition_host_value="$condition_host_cli"
        save_condition_host_config
        return 0
    fi

    if [[ -f "$condition_host_config_path" ]]; then
        condition_host_value="$(
            tr -d '[:space:]' <<<"$(config_file_first_line "$condition_host_config_path")"
        )"
        if [[ -n "$condition_host_value" ]]; then
            return 0
        fi
    fi

    prompt_for_condition_host
}

# resolve_condition_host_fqdn
# Uses --condition-host-fqdn, then ~/.config/user-services-host-fqdn, then captures on the service host.
resolve_condition_host_fqdn() {
    if [[ -n "$condition_host_fqdn_cli" ]]; then
        condition_host_fqdn_value="$condition_host_fqdn_cli"
        save_condition_host_fqdn_config
        return 0
    fi

    if [[ -f "$condition_host_fqdn_config_path" ]]; then
        condition_host_fqdn_value="$(
            tr -d '[:space:]' <<<"$(config_file_first_line "$condition_host_fqdn_config_path")"
        )"
        if [[ -n "$condition_host_fqdn_value" ]]; then
            return 0
        fi
    fi

    if host_name_matches_service_host; then
        condition_host_fqdn_value="$(read_local_hostname_fqdn)"
        save_condition_host_fqdn_config
        echo "✅ Service host FQDN captured into ${condition_host_fqdn_config_path}"
        return 0
    fi

    condition_host_fqdn_value=""
    if [[ "$status_only" == "1" ]]; then
        return 1
    fi

    die "Service host FQDN not configured (${condition_host_fqdn_config_path}). Run setup-service on ${condition_host_value} once to capture hostname -f, or pass --condition-host-fqdn."
}

# resolve_service_host_machine_id
# Sets condition_host_machine_id from ~/.config/user-services-machine-id or captures
# /etc/machine-id when setup-service runs on the configured service host.
resolve_service_host_machine_id() {
    local local_id

    service_host_machine_id_failure=""

    if [[ -f "$condition_machine_id_config_path" ]]; then
        condition_host_machine_id="$(
            normalize_machine_id "$(config_file_first_line "$condition_machine_id_config_path")"
        )"
        if [[ -n "$condition_host_machine_id" ]]; then
            if machine_id_is_valid "$condition_host_machine_id"; then
                return 0
            fi
            service_host_machine_id_failure="invalid"
            if [[ "$status_only" == "1" ]]; then
                return 1
            fi
            die "Invalid machine-id in ${condition_machine_id_config_path} (expected 32 lowercase hex chars from /etc/machine-id)"
        fi
    fi

    if host_name_matches_service_host; then
        local_id="$(read_local_machine_id)" \
            || die "Cannot read /etc/machine-id on service host ${condition_host_value}"
        condition_host_machine_id="$local_id"
        save_condition_machine_id_config
        echo "✅ Service host machine-id captured from /etc/machine-id into ${condition_machine_id_config_path}"
        return 0
    fi

    service_host_machine_id_failure="missing"
    if [[ "$status_only" == "1" ]]; then
        return 1
    fi

    die "Service host machine-id not configured (${condition_machine_id_config_path}). Run setup-service on ${condition_host_value} once to capture /etc/machine-id, or create that file manually."
}

# load_machine_id_from_installed_units_for_status
# Sets condition_host_machine_id from ConditionHost=|… or a legacy bogus unit line in installed units.
load_machine_id_from_installed_units_for_status() {
    local unit_path candidate

    if [[ ! -d "$target_dir" ]]; then
        return 1
    fi

    for unit_path in "${target_dir}/"*.service; do
        if [[ ! -f "$unit_path" ]]; then
            continue
        fi
        if ! unit_is_repo_managed "$unit_path"; then
            continue
        fi
        candidate="$(service_host_guard_machine_id_from_unit_file "$unit_path" 2>/dev/null || true)"
        if machine_id_is_valid "$candidate"; then
            condition_host_machine_id="$candidate"
            return 0
        fi
    done
    return 1
}

# systemd_user_version_major
# Prints the systemd user-session version major (first integer on the version line).
systemd_user_version_major() {
    local version_line major

    version_line="$(systemctl --version 2>/dev/null | head -n1 || true)"
    if [[ "$version_line" =~ ^systemd[[:space:]]+([0-9]+) ]]; then
        major="${BASH_REMATCH[1]}"
        printf '%s\n' "$major"
        return 0
    fi
    return 1
}

# systemd_supports_machine_id_condition_host
# True when ConditionHost=|<machine-id> is understood (systemd 259+).
systemd_supports_machine_id_condition_host() {
    local major

    major="$(systemd_user_version_major)" || return 1
    (( major >= service_host_min_systemd_version ))
}

# host_machine_id_matches
# True when this machine's /etc/machine-id matches the configured service host.
host_machine_id_matches() {
    local local_id

    [[ -n "$condition_host_machine_id" ]] || return 1
    local_id="$(read_local_machine_id)" || return 1
    [[ "$local_id" == "$condition_host_machine_id" ]]
}

# host_runs_units
# True when this machine matches the full injected guard set (machine-id + hostname).
# systemd 259+ only affects whether machine-id ConditionHost is reliable in units;
# timers still enable here when both guards match (hostname ConditionHost is the fallback).
host_runs_units() {
    host_machine_id_matches && host_name_matches_service_host
}

# timer_standby_disable <timer_filename>
# Standby hosts (shared NFS home): never ``systemctl disable`` this repo's timer.
# That removes shared ``timers.target.wants/`` and stops schedules on the service
# host. ``ConditionHost`` already prevents the timer from firing here. Called only
# for the specific ``*.timer`` being installed in this setup-service run; stop that
# timer locally if active (enable links stay intact for the service host).
timer_standby_disable() {
    local -r timer_filename="$1"
    local is_active_exit=0
    local stop_exit=0

    if host_runs_units; then
        return 0
    fi
    if [[ "$timer_filename" != *.timer ]]; then
        echo "⏭️  ${timer_filename}: timer_standby_disable expects a *.timer unit; skipping"
        return 0
    fi

    # Exit 0 = active; 3 = inactive (systemd); other = probe failure.
    # --probe: inactive (3) is the common standby case after the first stop.
    runner_exec "systemctl is-active --quiet ${timer_filename}" --probe -- \
      systemctl --user is-active --quiet "$timer_filename" || is_active_exit=$?
    if (( is_active_exit == 0 )); then
        stop_exit=0
        run_command "systemctl stop ${timer_filename}" \
          systemctl --user stop "$timer_filename" || stop_exit=$?
        if (( stop_exit != 0 )); then
            # Best-effort: ConditionHost already prevents firing; do not abort setup-service.
            echo "⚠️  ${timer_filename}: stop failed on $(current_hostname_short) (exit ${stop_exit}); leaving unit as-is (NFS wants intact)."
            return 0
        fi
        echo "⏭️  ${timer_filename}: stopped on $(current_hostname_short) (ConditionHost skips schedule; NFS wants left intact for ${condition_host_value})."
        return 0
    fi
    if (( is_active_exit != 3 )); then
        # Best-effort: standby may lack a user manager (no linger / bus unreachable).
        # Do not abort setup-service — ConditionHost already prevents the timer from firing.
        echo "⚠️  ${timer_filename}: is-active probe failed on $(current_hostname_short) (exit ${is_active_exit}); skipping local stop (user systemd unavailable?)."
        return 0
    fi
    echo "⏭️  ${timer_filename}: skipped on $(current_hostname_short) (ConditionHost; not disabling shared NFS wants — timers run on ${condition_host_value})."
}

# warn_host_skips_service
# Emits a warning when setup-service runs on a host that will not execute units.
warn_host_skips_service() {
    local current_host

    current_host="$(current_hostname_short)"
    if host_runs_units; then
        if ! systemd_supports_machine_id_condition_host; then
            echo "⚠️  WARNING: Service host ${condition_host_value} (machine-id ${condition_host_machine_id}) matches this machine, but systemd $(systemd_user_version_major 2>/dev/null || echo '?') is older than ${service_host_min_systemd_version}; hostname ConditionHost is the active guard until systemd is upgraded."
        fi
        return 0
    fi
    echo "⚠️  WARNING: Service host ${condition_host_value} (machine-id ${condition_host_machine_id}) but this machine is ${current_host}; systemd will not run these units here."
}

# discover_unit_basenames
# Prints unit basenames (no extension), one per line.
# When GITHUB_REPO_LINT_SERVICE_UNIT is set, only that unit is managed (wrapper support).
discover_unit_basenames() {
    local unit
    local -a discovered=()

    if [[ -n "${GITHUB_REPO_LINT_SERVICE_UNIT:-}" ]]; then
        printf '%s\n' "$GITHUB_REPO_LINT_SERVICE_UNIT"
        return 0
    fi

    if [[ ! -d "${repo_dir}/etc/systemd" ]]; then
        return 0
    fi

    for unit in "${repo_dir}/etc/systemd/"*.service; do
        if [[ ! -f "$unit" ]]; then
            continue
        fi
        unit="$(basename "$unit")"
        discovered+=("${unit%.service}")
    done

    if [[ "${#discovered[@]}" -eq 0 ]]; then
        return 0
    fi
    printf '%s\n' "${discovered[@]}"
}

# unit_source_service_path <unit_basename>
unit_source_service_path() {
    local -r unit_basename="$1"
    local template_path

    template_path="${repo_dir}/etc/systemd/${unit_basename}.service"
    if [[ -f "$template_path" ]]; then
        printf '%s\n' "$template_path"
        return 0
    fi
    die "No service template for ${unit_basename} (expected ${template_path})"
}

# unit_source_timer_path <unit_basename>
unit_source_timer_path() {
    local -r unit_basename="$1"
    local template_path

    template_path="${repo_dir}/etc/systemd/${unit_basename}.timer"
    if [[ -f "$template_path" ]]; then
        printf '%s\n' "$template_path"
        return 0
    fi
    return 1
}

# expanded_unit_service_path <unit_basename>
expanded_unit_service_path() {
    local -r unit_basename="$1"
    printf '%s\n' "${expanded_units_dir}/${unit_basename}.service"
}

# expanded_unit_timer_path <unit_basename>
expanded_unit_timer_path() {
    local -r unit_basename="$1"
    printf '%s\n' "${expanded_units_dir}/${unit_basename}.timer"
}

# write_expanded_unit_files <unit_basename> <target_service> [target_timer]
# Keeps a readable copy of installed units under ~/.config/share/systemd-units/
# for show-services (systemd loads from ~/.config/systemd/user/ instead).
# Only copies when the mirror is missing or differs; prints unchanged vs updated.
write_expanded_unit_files() {
    local -r unit_basename="$1"
    local -r target_service="$2"
    local target_timer="${3:-}"
    local mirror_service
    local mirror_timer
    local service_copy_changed=false
    local timer_copy_changed=false
    local diff_rc

    mirror_service="$(expanded_unit_service_path "$unit_basename")"
    mkdir -p "$expanded_units_dir"

    if [[ ! -f "$mirror_service" ]]; then
        cp "$target_service" "$mirror_service"
        service_copy_changed=true
    else
        diff_rc=0
        diff --brief "$target_service" "$mirror_service" > /dev/null 2>&1 || diff_rc=$?
        if [[ "$diff_rc" -eq 1 ]]; then
            cp "$target_service" "$mirror_service"
            service_copy_changed=true
        elif [[ "$diff_rc" -ge 2 ]]; then
            echo "⚠️  Readable service unit copy: diff failed (exit ${diff_rc}); leaving ${mirror_service} as-is." >&2
        fi
    fi

    if [[ -n "$target_timer" && -f "$target_timer" ]]; then
        mirror_timer="$(expanded_unit_timer_path "$unit_basename")"
        if [[ ! -f "$mirror_timer" ]]; then
            cp "$target_timer" "$mirror_timer"
            timer_copy_changed=true
        else
            diff_rc=0
            diff --brief "$target_timer" "$mirror_timer" > /dev/null 2>&1 || diff_rc=$?
            if [[ "$diff_rc" -eq 1 ]]; then
                cp "$target_timer" "$mirror_timer"
                timer_copy_changed=true
            elif [[ "$diff_rc" -ge 2 ]]; then
                echo "⚠️  Readable timer unit copy: diff failed (exit ${diff_rc}); leaving ${mirror_timer} as-is." >&2
            fi
        fi
    fi

    if [[ "$service_copy_changed" == "true" ]]; then
        echo "✅ Readable service unit copy updated: $mirror_service"
    else
        echo "✅ Readable service unit copy unchanged: $mirror_service"
    fi
    if [[ -n "${mirror_timer:-}" ]]; then
        if [[ "$timer_copy_changed" == "true" ]]; then
            echo "✅ Readable timer unit copy updated: $mirror_timer"
        else
            echo "✅ Readable timer unit copy unchanged: $mirror_timer"
        fi
    fi
    echo "   (for show-services; installed units are under ${target_dir}/)"
}

# unit_target_service_path <unit_basename>
unit_target_service_path() {
    local -r unit_basename="$1"
    printf '%s\n' "${target_dir}/${unit_basename}.service"
}

# unit_target_timer_path <unit_basename>
unit_target_timer_path() {
    local -r unit_basename="$1"
    printf '%s\n' "${target_dir}/${unit_basename}.timer"
}

# unit_service_filename <unit_basename>
unit_service_filename() {
    local -r unit_basename="$1"
    printf '%s\n' "${unit_basename}.service"
}

# unit_timer_filename <unit_basename>
unit_timer_filename() {
    local -r unit_basename="$1"
    printf '%s\n' "${unit_basename}.timer"
}

# generate_service_unit
# generate_service_unit <source_service_path>
# Substitute @@REPO_DIR@@ and inject DEPLOYED_COMMIT into the [Service] section.
generate_service_unit() {
    local -r source_service="$1"
    local deployed_sha
    local generated

    deployed_sha="$(ss_runner_git_c_stdout_or_empty "$repo_dir" "setup-service git rev-parse HEAD" \
        -- rev-parse HEAD)"
    if [[ -z "$deployed_sha" ]]; then
        die "Could not resolve HEAD in: ${repo_dir}"
    fi

    generated="$(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_service")"
    if grep -qF '@@DEPLOYED_COMMIT@@' <<<"$generated"; then
        generated="$(sed "s|@@DEPLOYED_COMMIT@@|${deployed_sha}|g" <<<"$generated")"
    fi
    if grep -q "^Environment=${deployed_commit_env_name}=" <<<"$generated"; then
        generated="$(
            printf '%s\n' "$generated" \
                | sed "s|^Environment=${deployed_commit_env_name}=.*|Environment=${deployed_commit_env_name}=${deployed_sha}|"
        )"
    else
        generated="$(
            awk -v var="$deployed_commit_env_name" -v sha="$deployed_sha" '
                /^\[Service\]/ && !inserted {
                    print
                    print "Environment=" var "=" sha
                    inserted = 1
                    next
                }
                { print }
            ' <<<"$generated"
        )"
    fi
    if [[ -z "$condition_host_value" ]]; then
        die "Service host is not set (internal error)"
    fi
    if [[ -z "$condition_host_machine_id" ]]; then
        die "Service host machine-id is not set (internal error)"
    fi
    generated="$(service_host_guard_inject_into_unit "$generated" "$condition_host_value" "$condition_host_fqdn_value" "$condition_host_machine_id")"
    printf '%s' "$generated"
}

# generate_timer_unit
# generate_timer_unit <source_timer_path>
# Substitute @@REPO_DIR@@ in the timer template (no DEPLOYED_COMMIT injection).
generate_timer_unit() {
    local -r source_timer="$1"
    local generated

    generated="$(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_timer")"
    if [[ -z "$condition_host_value" ]]; then
        die "Service host is not set (internal error)"
    fi
    if [[ -z "$condition_host_machine_id" ]]; then
        die "Service host machine-id is not set (internal error)"
    fi
    service_host_guard_inject_into_unit "$generated" "$condition_host_value" "$condition_host_fqdn_value" "$condition_host_machine_id"
}

# service_unit_is_oneshot [unit_file]
# True when Type=oneshot (timer-driven jobs stay idle between runs).
service_unit_is_oneshot() {
    local -r unit_path="$1"
    [[ -f "$unit_path" ]] && grep -qE '^Type=oneshot([[:space:]]|$)' "$unit_path"
}

# timer_only_drop_stale_default_target_link <service_filename>
# Timer-only oneshots have no [Install] section; systemctl disable prints noisy
# warnings when the unit is merely static. Remove a legacy default.target.wants
# symlink from older installs instead (PR #278 timer-only activation).
timer_only_drop_stale_default_target_link() {
    local -r service_filename="$1"
    local -r default_link="${target_dir}/default.target.wants/${service_filename}"

    if [[ -z "$service_filename" ]] || [[ "$service_filename" == */* ]] || [[ "$service_filename" == *..* ]]; then
        die "timer_only_drop_stale_default_target_link: service_filename must be a plain unit basename, got: ${service_filename}"
    fi

    if [[ -L "$default_link" || -f "$default_link" ]]; then
        rm -f "$default_link"
        echo "⏭️  ${service_filename}: removed stale default.target link (timer-only activation)."
    fi
}

# service_display_label
# Human-readable name from the unit Description= line, else service_name.
service_display_label() {
    local -r source_service="$1"
    local label
    label=""
    if [[ -f "$source_service" ]]; then
        label="$(grep -m1 '^Description=' "$source_service" 2>/dev/null | sed 's/^Description=//' || true)"
    fi
    if [[ -z "$label" ]]; then
        label="$service_name"
    fi
    printf '%s\n' "$label"
}

# unit_is_repo_managed <unit_path>
# True when the installed unit file references this repo worktree path.
unit_is_repo_managed() {
    local -r unit_path="$1"

    [[ -f "$unit_path" ]] && grep -qF "$repo_dir" "$unit_path"
}

# unit_timer_activation_service_basename <timer_path>
# Prints the service basename (no .service) from Unit=, or empty.
unit_timer_activation_service_basename() {
    local -r timer_path="$1"
    local unit_line

    unit_line="$(grep -m1 '^Unit=' "$timer_path" 2>/dev/null || true)"
    unit_line="${unit_line#Unit=}"
    unit_line="${unit_line%.service}"
    printf '%s\n' "$unit_line"
}

# remove_stale_unit_file <unit_filename>
# On the service host: disable + delete. On standby hosts, only skip NFS-destructive
# cleanup for ``*.timer`` units (shared ``timers.target.wants/``). Other stale units
# still must not be ``disable``d on standby (shared wants if present); skip those
# too when off the service host so the shared user unit dir is not mutated there.
remove_stale_unit_file() {
    local -r unit="$1"

    if ! host_runs_units; then
        if [[ "$unit" == *.timer ]]; then
            echo "⏭️  ${unit}: skip stale timer remove on $(current_hostname_short) (shared NFS wants — run setup-service on ${condition_host_value})."
            return 0
        fi
        echo "⏭️  ${unit}: skip stale remove on $(current_hostname_short) (shared user unit dir — run setup-service on ${condition_host_value})."
        return 0
    fi

    echo "🗑️  Removing stale unit: ${unit}"
    systemctl --user disable --now "$unit" 2>/dev/null || true
    rm -f "${target_dir}/${unit}"
}

# unit_should_remove_stale_timer <timer_path> <timer_base> <desired_csv> <removed_stale_bases...>
# Timer templates often omit repo_dir; match paired services or repo-managed companions.
unit_should_remove_stale_timer() {
    local -r timer_path="$1"
    local -r timer_base="$2"
    local -r desired_csv="$3"
    shift 3
    local removed_csv service_base companion_path

    if unit_is_repo_managed "$timer_path"; then
        return 0
    fi

    removed_csv=",$(printf '%s,' "$@"),"
    service_base="$(unit_timer_activation_service_basename "$timer_path")"
    if [[ -z "$service_base" ]]; then
        return 1
    fi
    if [[ "$desired_csv" == *",${service_base},"* ]]; then
        return 1
    fi
    if [[ "$removed_csv" == *",${service_base},"* ]]; then
        return 0
    fi
    if [[ "$timer_base" != "$service_base" ]]; then
        return 1
    fi

    companion_path="${target_dir}/${service_base}.service"
    if [[ ! -f "$companion_path" ]]; then
        return 0
    fi
    if unit_is_repo_managed "$companion_path"; then
        return 0
    fi
    return 1
}

# remove_stale_managed_units <desired_unit_basenames...>
# Stops/disables/removes installed user units that reference repo_dir but are no longer shipped.
remove_stale_managed_units() {
    local desired_csv unit_path unit base
    local stale_count
    local removed_stale_bases=()

    desired_csv=",$(printf '%s,' "$@")"
    stale_count=0

    if [[ ! -d "$target_dir" ]]; then
        return 1
    fi

    for unit_path in "${target_dir}/"*.service; do
        if [[ ! -f "$unit_path" ]]; then
            continue
        fi
        if ! unit_is_repo_managed "$unit_path"; then
            continue
        fi
        unit="$(basename "$unit_path")"
        base="${unit%.*}"
        if [[ "$desired_csv" == *",${base},"* ]]; then
            continue
        fi

        stale_count=$(( stale_count + 1 ))
        removed_stale_bases+=("$base")
        remove_stale_unit_file "$unit"
    done

    for unit_path in "${target_dir}/"*.timer; do
        if [[ ! -f "$unit_path" ]]; then
            continue
        fi
        unit="$(basename "$unit_path")"
        base="${unit%.*}"
        if [[ "$desired_csv" == *",${base},"* ]]; then
            continue
        fi
        if ! unit_should_remove_stale_timer "$unit_path" "$base" "$desired_csv" "${removed_stale_bases[@]}"; then
            continue
        fi

        stale_count=$(( stale_count + 1 ))
        remove_stale_unit_file "$unit"
    done

    if [[ "$stale_count" -gt 0 ]]; then
        return 0
    fi
    return 1
}

# read_deployed_commit_from_pid <main_pid>
# Reads DEPLOYED_COMMIT from the process environment (set by systemd at start).
read_deployed_commit_from_pid() {
    local -r main_pid="$1"
    local env_line sha

    env_line="$(
        tr '\0' '\n' <"/proc/${main_pid}/environ" 2>/dev/null \
            | grep "^${deployed_commit_env_name}=" \
            | head -n1 \
            || true
    )"
    if [[ -z "$env_line" ]]; then
        return 1
    fi
    sha="${env_line#"${deployed_commit_env_name}"=}"
    if [[ -z "$sha" ]]; then
        return 1
    fi
    printf '%s\n' "$sha"
}

# service_main_pid
# Prints systemd MainPID or empty when the service is not running.
service_main_pid() {
    local -r service_filename="$1"
    local main_pid
    main_pid="$(systemctl --user show "$service_filename" --property=MainPID --value 2>/dev/null || true)"
    if [[ -z "$main_pid" || "$main_pid" == "0" ]]; then
        return 1
    fi
    printf '%s\n' "$main_pid"
}

# installed_unit_lacks_deployed_commit_env
# True when the installed user unit has no DEPLOYED_COMMIT Environment line.
installed_unit_lacks_deployed_commit_env() {
    local -r target_service="$1"
    [[ -f "$target_service" ]] \
        && ! grep -q "^Environment=${deployed_commit_env_name}=" "$target_service"
}

# running_service_lacks_deployed_commit_env <main_pid>
running_service_lacks_deployed_commit_env() {
    local -r main_pid="$1"
    ! read_deployed_commit_from_pid "$main_pid" >/dev/null 2>&1
}

# print_running_commit
# Report DEPLOYED_COMMIT from the running service MainPID (never git HEAD at cwd).
print_running_commit() {
    local -r service_filename="$1"
    local main_pid
    local deployed_sha

    if ! main_pid="$(service_main_pid "$service_filename")"; then
        echo "   Running commit: (service not running)"
        return 0
    fi

    if deployed_sha="$(read_deployed_commit_from_pid "$main_pid")"; then
        echo "   Running commit: ${deployed_sha:0:7}  (from ${deployed_commit_env_name})"
        return 0
    fi

    echo "   Running commit: (unknown; ${deployed_commit_env_name} not set — will refresh)"
}

die() {
    echo "❌ Error: $*" >&2
    exit 1
}

# resolve_lockfile_drift_lib
# Prints the path to scripts/lib/lockfile-drift (repository-helpers checkout).
resolve_lockfile_drift_lib() {
    local candidate rh_root setup_script_dir

    setup_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    candidate="${setup_script_dir}/lib/lockfile-drift"
    if [[ -f "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi

    if [[ -n "${REPOSITORY_HELPERS_DIR:-}" ]]; then
        candidate="${REPOSITORY_HELPERS_DIR}/scripts/lib/lockfile-drift"
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    fi

    rh_root=""
    if cd "${repo_dir}/../repository-helpers" 2>/dev/null; then
        rh_root="$(pwd)"
    fi
    if [[ -n "$rh_root" ]]; then
        candidate="${rh_root}/scripts/lib/lockfile-drift"
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    fi

    if [[ -n "${HOME:-}" ]]; then
        candidate="${HOME}/work/ai/repository-helpers/scripts/lib/lockfile-drift"
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    fi

    return 1
}

# run_lockfile_drift_preflight
# Checks manifest/lock drift before on-deploy. With --fix-lockfiles, regenerates
# stale lockfiles locally; on-deploy then installs from those locks (--frozen).
run_lockfile_drift_preflight() {
    local lib_path drift_rc

    if ! lib_path="$(resolve_lockfile_drift_lib)"; then
        echo "ℹ️  lockfile-drift: library not found; skipping preflight"
        return 0
    fi

    # shellcheck source=/dev/null
    source "$lib_path"

    drift_rc=0
    if [[ "$fix_lockfiles" == "1" ]]; then
        echo "Checking lockfile drift (auto-fix enabled)..."
        if ! lockfile_drift_remediate_repo --repo-dir "$repo_dir" --strict "$strict_lockfiles"; then
            drift_rc=1
        fi
    else
        echo "Checking lockfile drift (warn-only unless --strict-lockfiles)..."
        if ! lockfile_drift_check_repo --repo-dir "$repo_dir" --strict "$strict_lockfiles"; then
            drift_rc=1
        fi
    fi
    if [[ "$drift_rc" -ne 0 ]]; then
        die "Lockfile drift remains after preflight. Regenerate and commit lockfiles before deploy (uv lock / pnpm install)."
    fi
}

# resolve_service_log_file
# resolve_service_log_file <service_filename> <target_service> <source_service>
# Prints the service log path from the installed unit, source template, or scratch default.
resolve_service_log_file() {
    local -r service_filename="$1"
    local -r target_service="$2"
    local -r source_service="$3"
    local unit_text exec_start log_file args

    unit_text="$(systemctl --user cat "${service_filename}" 2>/dev/null || true)"
    if [[ -z "$unit_text" && -f "$target_service" ]]; then
        unit_text="$(cat "$target_service")"
    elif [[ -z "$unit_text" && -f "$source_service" ]]; then
        unit_text="$(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_service")"
    fi

    log_file=""
    exec_start="$(printf '%s\n' "$unit_text" | grep '^ExecStart=' | sed 's/^ExecStart=//' | head -n1 || true)"
    if [[ -n "$exec_start" ]]; then
        args="$(printf '%s\n' "$exec_start" | cut -d' ' -f2-)"
        log_file="$(printf '%s\n' "$args" | grep -oP -- '--log-file \K\S+' | sed "s|%h|${HOME}|g" || true)"
    fi
    if [[ -z "$log_file" ]]; then
        log_file="$(
            printf '%s\n' "$unit_text" \
                | grep -E '^Standard(Output|Error)=' \
                | head -n1 \
                | grep -oP 'append:\K\S+' \
                | sed "s|%h|${HOME}|g" \
                || true
        )"
    fi
    if [[ -z "$log_file" ]]; then
        log_file="${log_dir}/${service_name}.log"
    fi
    printf '%s\n' "$log_file"
}

# resolve_service_environment_file
# resolve_service_environment_file <service_filename> <target_service> <source_service>
# Prints the user-editable EnvironmentFile path from the installed unit or source template.
resolve_service_environment_file() {
    local -r service_filename="$1"
    local -r target_service="$2"
    local -r source_service="$3"
    local unit_text env_file

    unit_text="$(systemctl --user cat "${service_filename}" 2>/dev/null || true)"
    if [[ -z "$unit_text" && -f "$target_service" ]]; then
        unit_text="$(cat "$target_service")"
    elif [[ -z "$unit_text" && -f "$source_service" ]]; then
        unit_text="$(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_service")"
    fi

    env_file="$(
        printf '%s\n' "$unit_text" \
            | grep '^EnvironmentFile=' \
            | head -n1 \
            | sed 's/^EnvironmentFile=-\?//' \
            | cut -d' ' -f1 \
            | sed "s|%h|${HOME}|g" \
            || true
    )"
    printf '%s\n' "$env_file"
}

# print_service_failure_hint
# After a failed systemctl start/restart, point the operator at service logs.
print_service_failure_hint() {
    local -r service_filename="$1"
    local -r target_service="$2"
    local -r source_service="$3"
    local log_file

    log_file="$(resolve_service_log_file "$service_filename" "$target_service" "$source_service")"
    echo "" >&2
    echo "❌ ${service_filename} failed to start or restart." >&2
    echo "   Service log:  tail --follow=name --retry ${log_file}" >&2
    if [[ "$kernel_name" != "Darwin" ]]; then
        echo "   systemd:      journalctl --user -xeu ${service_filename}" >&2
    fi
}

# systemctl_user_or_fail <action> [systemctl args...]
# Runs systemctl --user; on failure prints log hints and returns non-zero.
systemctl_user_or_fail() {
    local action="$1"
    local service_filename="$2"
    local target_service="$3"
    local source_service="$4"
    shift
    shift
    shift
    shift

    if systemctl --user "$action" "$@"; then
        return 0
    fi
    print_service_failure_hint "$service_filename" "$target_service" "$source_service"
    return 1
}

# Function to display help
show_help() {
    cat << EOF
${service_name} Setup Utility - Persistent Service

USAGE:
    ./scripts/setup-service [OPTIONS]

DESCRIPTION:
    Configures ${service_name} to run as a persistent background service using systemd.
    Ensures lingering is enabled for the user so the service starts on boot
    and remains active without a login session.

OPTIONS:
    -s, --status
        Check the current configuration status and service health.

    -r, --force-restart
        Force a service restart even when setup detects no unit/code changes.
        Useful after changing user config files referenced by the unit.

    --fix-lockfiles
        Regenerate stale uv.lock, pnpm-lock.yaml, or Cargo.lock before on-deploy.
        start-development --refresh passes this automatically.

    --strict-lockfiles
        Fail when lockfiles still drift after checks (or after --fix-lockfiles).
        Default is warn-only.

    --condition-host NAME
        Short hostname label for the machine where systemd should run these units
        (e.g. svc-host). Saved to ~/.config/user-services-host.

    --condition-host-fqdn NAME
        Fully qualified hostname for the service host (e.g. svc-host.example).
        Saved to ~/.config/user-services-host-fqdn. When omitted, setup-service
        captures hostname -f on the first run on the service host.

        setup-service also captures /etc/machine-id into
        ~/.config/user-services-machine-id and injects ConditionHost=|<machine-id>
        into each unit so timers and services run only on that host even when
        jobs run on one designated host even when unit files live on NFS.

    -h, --help
        Display this help message and exit.

    (no options)
        Install or update the systemd service configuration.

EXAMPLES:
    # Set up or update the service
    ./scripts/setup-service

    # Check the current status
    ./scripts/setup-service --status
EOF
    exit 0
}

# Function to check current status
check_status() {
    local unit_basename source_service service_filename target_service
    local source_timer timer_filename target_timer
    local desired_units
    local overall_good=true
    local any_running_pid=""
    local all_good is_oneshot has_timer running_pid display_name
    local unit_text exec_start exec_post args port user_config_file log_file
    local current_user timer_line status_can_diff_units

    desired_units="$(discover_unit_basenames)"
    if [[ -z "$desired_units" ]]; then
        echo "ℹ️  ${service_name} has no service templates — not a systemd service repo."
        return 0
    fi

    if [[ "$kernel_name" == "Darwin" ]]; then
        echo "🔍 Verifying ${service_name} service configuration..."
        echo "----------------------------------------"
        echo "ℹ️  macOS:   systemd user services are not installed on this platform."
        local desired_sha
        desired_sha="$(ss_runner_git_c_stdout_or_empty "$repo_dir" "setup-service git rev-parse short HEAD" \
            -- rev-parse --short HEAD)"
        if [[ -n "$desired_sha" ]]; then
            echo "   Desired commit: ${desired_sha}  (${repo_dir})"
        fi
        echo "----------------------------------------"
        echo "✨ ${service_name}: no systemd setup on macOS (use Linux or run the app manually)."
        return 0
    fi

    current_user="$(whoami)"

    echo "🔍 Verifying ${service_name} service configuration..."
    echo "----------------------------------------"

    if loginctl show-user "$current_user" --property=Linger | grep -q "Linger=yes"; then
        echo "✅ Linger:   Enabled for $current_user"
    else
        echo "❌ Linger:   Disabled (Service won't survive reboots!)"
        overall_good=false
    fi

    status_can_diff_units=true

    if [[ -f "$condition_host_config_path" ]]; then
        condition_host_value="$(
            tr -d '[:space:]' <<<"$(config_file_first_line "$condition_host_config_path")"
        )"
    else
        condition_host_value=""
    fi
    if [[ -n "$condition_host_value" ]]; then
        if [[ -f "$condition_host_fqdn_config_path" ]]; then
            condition_host_fqdn_value="$(
                tr -d '[:space:]' <<<"$(config_file_first_line "$condition_host_fqdn_config_path")"
            )"
        else
            condition_host_fqdn_value=""
        fi
        if resolve_service_host_machine_id; then
            if host_runs_units; then
                if systemd_supports_machine_id_condition_host; then
                    if [[ -n "$condition_host_fqdn_value" ]]; then
                        echo "✅ Host:     ${condition_host_value} (${condition_host_fqdn_value}; machine-id ${condition_host_machine_id}; systemd $(systemd_user_version_major)) — this machine"
                    else
                        echo "✅ Host:     ${condition_host_value} (machine-id ${condition_host_machine_id}; systemd $(systemd_user_version_major)) — this machine"
                    fi
                else
                    if [[ -n "$condition_host_fqdn_value" ]]; then
                        echo "✅ Host:     ${condition_host_value} (${condition_host_fqdn_value}; machine-id ${condition_host_machine_id}; systemd $(systemd_user_version_major)) — this machine (hostname ConditionHost guard; upgrade systemd for machine-id guard)"
                    else
                        echo "✅ Host:     ${condition_host_value} (machine-id ${condition_host_machine_id}; systemd $(systemd_user_version_major)) — this machine (hostname ConditionHost guard; upgrade systemd for machine-id guard)"
                    fi
                fi
            else
                if [[ -n "$condition_host_fqdn_value" ]]; then
                    echo "⚠️  Host:     ${condition_host_value} (${condition_host_fqdn_value}; machine-id ${condition_host_machine_id}) — this machine is $(current_hostname_short); units skip here"
                else
                    echo "⚠️  Host:     ${condition_host_value} (machine-id ${condition_host_machine_id}) — this machine is $(current_hostname_short); units skip here"
                fi
                overall_good=false
            fi
            if [[ -z "$condition_host_fqdn_value" ]]; then
                echo "⚠️  Host FQDN: not configured (${condition_host_fqdn_config_path}); re-run setup-service on ${condition_host_value} to capture hostname -f"
                overall_good=false
            fi
        else
            if [[ "$service_host_machine_id_failure" == "invalid" ]]; then
                echo "❌ Host:     ${condition_host_value} — invalid machine-id in ${condition_machine_id_config_path} (expected 32 lowercase hex chars from /etc/machine-id)"
            else
                echo "⚠️  Host:     ${condition_host_value} — machine-id not configured (${condition_machine_id_config_path}); run setup-service on ${condition_host_value} once"
            fi
            overall_good=false
            condition_host_machine_id=""
            if load_machine_id_from_installed_units_for_status; then
                echo "ℹ️  Host:     using machine-id from installed unit(s) for template comparison"
            else
                status_can_diff_units=false
            fi
        fi
    else
        echo "❌ Host:     Service host not configured (${condition_host_config_path})"
        overall_good=false
        condition_host_machine_id=""
        if load_machine_id_from_installed_units_for_status; then
            echo "ℹ️  Host:     using machine-id from installed unit(s) for template comparison"
        else
            status_can_diff_units=false
        fi
    fi

    while IFS= read -r unit_basename; do
        all_good=true
        is_oneshot=false
        has_timer=false
        running_pid=""
        port=""

        source_service="$(unit_source_service_path "$unit_basename")"
        service_filename="$(unit_service_filename "$unit_basename")"
        target_service="$(unit_target_service_path "$unit_basename")"
        source_timer=""
        source_timer="$(unit_source_timer_path "$unit_basename" || true)"
        timer_filename="$(unit_timer_filename "$unit_basename")"
        target_timer="$(unit_target_timer_path "$unit_basename")"

        display_name="$(service_display_label "$source_service")"
        echo ""
        echo "🧩 Unit: ${service_filename}  (${display_name})"

        if [[ -f "$source_timer" ]]; then
            has_timer=true
        fi
        if [[ -f "$target_service" ]] && service_unit_is_oneshot "$target_service"; then
            is_oneshot=true
        elif [[ -f "$source_service" ]] \
            && grep -qE '^Type=oneshot([[:space:]]|$)' <(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_service"); then
            is_oneshot=true
        fi

        if [[ ! -f "$target_service" ]]; then
            echo "❌ Service:  Not installed (Run setup to install it)"
            all_good=false
        elif [[ "$status_can_diff_units" == "false" ]]; then
            echo "⚠️  Service:  Installed ($target_service); cannot verify template match (machine-id unresolved)"
            all_good=false
        elif diff --brief <(generate_service_unit "$source_service") "$target_service" > /dev/null 2>&1; then
            echo "✅ Service:  Up to date ($target_service)"
        else
            echo "❌ Service:  Outdated (Run setup to update it)"
            all_good=false
        fi

        if [[ "$is_oneshot" == "true" ]]; then
            if [[ "$has_timer" == "true" ]]; then
                echo "✅ Active:   Oneshot (idle until timer runs)"
            else
                echo "✅ Active:   Oneshot (start manually when needed)"
            fi
        elif systemctl --user is-active "${service_filename}" > /dev/null 2>&1; then
            echo "✅ Active:   Running"
            running_pid="$(service_main_pid "$service_filename" || true)"
            if [[ -n "$running_pid" && -z "$any_running_pid" ]]; then
                any_running_pid="$running_pid"
            fi
        else
            echo "❌ Active:   Inactive (Stopped)"
            all_good=false
        fi

        if systemctl --user is-enabled "${service_filename}" > /dev/null 2>&1; then
            echo "✅ Enabled:  Service unit enabled"
        else
            echo "❌ Enabled:  Service unit disabled"
            all_good=false
        fi

        if [[ "$has_timer" == "true" ]]; then
            if [[ ! -f "$target_timer" ]]; then
                echo "❌ Timer:    Not installed (Run setup to install it)"
                all_good=false
            elif [[ "$status_can_diff_units" == "false" ]]; then
                echo "⚠️  Timer:    Installed ($target_timer); cannot verify template match (machine-id unresolved)"
                all_good=false
            elif diff --brief <(generate_timer_unit "$source_timer") "$target_timer" > /dev/null 2>&1; then
                echo "✅ Timer:    Up to date ($target_timer)"
            else
                echo "❌ Timer:    Outdated (Run setup to update it)"
                all_good=false
            fi
            if systemctl --user is-enabled "${timer_filename}" > /dev/null 2>&1; then
                echo "✅ Timer:    Enabled"
            else
                echo "❌ Timer:    Disabled"
                all_good=false
            fi
            timer_line="$(
                systemctl --user list-timers "${timer_filename}" --no-pager 2>/dev/null \
                    | awk 'NR==2 { print $1, $2, $3, $4, $5 }' \
                    || true
            )"
            if [[ -n "$timer_line" ]]; then
                echo "   Next run:  ${timer_line}"
            fi
        fi

        if [[ "$is_oneshot" != "true" ]]; then
            print_running_commit "$service_filename"
        fi

        unit_text="$(systemctl --user cat "${service_filename}" 2>/dev/null || true)"
        exec_start="$(printf '%s\n' "$unit_text" | grep '^ExecStart=' | sed 's/^ExecStart=//' | head -n1 || true)"
        exec_post="$(printf '%s\n' "$unit_text" | grep '^ExecStartPost=' | sed 's/^ExecStartPost=//' | head -n1 || true)"
        if [[ -n "$exec_start" ]]; then
            args="$(printf '%s\n' "$exec_start" | cut -d' ' -f2-)"
            port="$(printf '%s\n' "$args" | grep -oP -- '--(http-)?port \K\d+' || true)"
            echo "✅ Starts:    $exec_start"
        fi
        if [[ -n "$exec_post" ]]; then
            echo "✅ Health:    $exec_post"
        fi
        if [[ -n "${port:-}" ]]; then
            echo "   URL:       http://localhost:${port}"
        fi
        echo "   Config:    ${target_service}"
        user_config_file="$(resolve_service_environment_file "$service_filename" "$target_service" "$source_service")"
        if [[ -n "$user_config_file" ]]; then
            echo "   User cfg:  ${user_config_file}"
        fi
        log_file="$(resolve_service_log_file "$service_filename" "$target_service" "$source_service")"
        echo "   Logs:      tail --follow=name --retry ${log_file}"

        if ! $all_good; then
            overall_good=false
        fi
    done <<<"$desired_units"

    echo ""
    echo "----------------------------------------"
    if $overall_good; then
        if [[ -n "$any_running_pid" ]]; then
            echo "✨ Everything looks good! ${service_name} systemd units are correctly configured and running as pid ${any_running_pid}."
        else
            echo "✨ Everything looks good! ${service_name} systemd units are correctly configured."
        fi
        return 0
    fi
    echo "⚠️  Some issues were found. Run ./scripts/setup-service to fix them."
    return 1
}

# Handle arguments
force_restart=0
status_only=0
strict_lockfiles=0
fix_lockfiles=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        -s|--status)
            status_only=1
            shift
            ;;
        -r|--force-restart)
            force_restart=1
            shift
            ;;
        --strict-lockfiles)
            strict_lockfiles=1
            shift
            ;;
        --fix-lockfiles)
            fix_lockfiles=1
            shift
            ;;
        --condition-host)
            if [[ $# -lt 2 ]]; then
                die "--condition-host requires a hostname argument"
            fi
            condition_host_cli="$2"
            shift 2
            ;;
        --condition-host=*)
            condition_host_cli="${1#--condition-host=}"
            if [[ -z "$condition_host_cli" ]]; then
                die "--condition-host requires a hostname argument"
            fi
            shift
            ;;
        --condition-host-fqdn)
            if [[ $# -lt 2 ]]; then
                die "--condition-host-fqdn requires a hostname argument"
            fi
            condition_host_fqdn_cli="$2"
            shift 2
            ;;
        --condition-host-fqdn=*)
            condition_host_fqdn_cli="${1#--condition-host-fqdn=}"
            if [[ -z "$condition_host_fqdn_cli" ]]; then
                die "--condition-host-fqdn requires a hostname argument"
            fi
            shift
            ;;
        *)
            echo "❌ Error: Unknown option: $1"
            echo "Run './scripts/setup-service --help' for usage information"
            exit 1
            ;;
    esac
done
readonly force_restart
readonly status_only
readonly strict_lockfiles
readonly fix_lockfiles

if [[ "$status_only" == "1" ]]; then
    check_status
    exit $?
fi

# run_on_deploy_hook
# Invokes scripts/on-deploy when executable. Exit 0 → code changed; 1 → unchanged; 2+ → abort.
run_on_deploy_hook() {
    local on_deploy_exit on_deploy_stderr

    if [[ ! -x "${repo_dir}/scripts/on-deploy" ]]; then
        return 0
    fi

    on_deploy_exit=0
    on_deploy_stderr="$(mktemp)"
    "${repo_dir}/scripts/on-deploy" 2>"$on_deploy_stderr" || on_deploy_exit=$?
    if [[ "$on_deploy_exit" -eq 0 ]]; then
        rm -f "$on_deploy_stderr"
        return 0
    fi
    if [[ "$on_deploy_exit" -ge 2 ]]; then
        echo "❌ Error: on-deploy exited with code ${on_deploy_exit}" >&2
        if [[ -s "$on_deploy_stderr" ]]; then
            echo "--- on-deploy stderr ---" >&2
            cat "$on_deploy_stderr" >&2
        fi
        rm -f "$on_deploy_stderr"
        exit "$on_deploy_exit"
    fi
    rm -f "$on_deploy_stderr"
    return 1
}

# Main installation flow
unit_basenames="$(discover_unit_basenames)"
readonly unit_basenames
if [[ -z "$unit_basenames" ]]; then
    echo "ℹ️  ${service_name} has no service templates — not a systemd service repo. Skipping."
    exit 0
fi

echo "Setting up ${service_name} systemd units..."

# macOS has no systemd user units — skip install and deploy pipeline (no service to refresh).
if [[ "$kernel_name" == "Darwin" ]]; then
    echo "ℹ️  macOS: skipping systemd user service installation (Linux hosts only)."
    desired_sha="$(ss_runner_git_c_stdout_or_empty "$repo_dir" "setup-service git rev-parse short HEAD macos" \
        -- rev-parse --short HEAD)"
    if [[ -n "$desired_sha" ]]; then
        echo "   Desired commit: ${desired_sha}  (${repo_dir})"
    fi
    echo ""
    echo "✨ ${service_name}: no systemd setup on macOS (use Linux or run on-deploy manually if needed)."
    exit 0
fi

# 2. Ensure target directory exists
mkdir -p "$target_dir"

resolve_condition_host
resolve_condition_host_fqdn
resolve_service_host_machine_id
warn_host_skips_service

desired_sha="$(ss_runner_git_c_stdout_or_empty "$repo_dir" "setup-service git rev-parse short HEAD" \
    -- rev-parse --short HEAD)"
desired_full="$(ss_runner_git_c_stdout_or_empty "$repo_dir" "setup-service git rev-parse HEAD full" \
    -- rev-parse HEAD)"
if [[ -n "$desired_sha" ]]; then
    echo "   Desired commit: ${desired_sha}  (${repo_dir})"
fi

any_unit_changed=false
any_timer_changed=false
any_stale_removed=false
any_deploy_refresh_needed=false
any_runtime_action=false

desired_unit_args=()
while IFS= read -r unit_basename; do
    if [[ -n "$unit_basename" ]]; then
        desired_unit_args+=("$unit_basename")
    fi
done <<<"$unit_basenames"

# Remove stale/renamed units (e.g. removed templates after a rename).
if remove_stale_managed_units "${desired_unit_args[@]}"; then
    any_stale_removed=true
fi

# 3. Generate service/timer files with repo path and DEPLOYED_COMMIT substituted
while IFS= read -r unit_basename; do
    local_source_service=""
    local_target_service=""
    local_source_timer=""
    local_target_timer=""
    service_filename=""
    timer_filename=""
    deploy_refresh_needed=0
    service_changed=true
    timer_changed=false
    running_full=""

    local_source_service="$(unit_source_service_path "$unit_basename")"
    local_target_service="$(unit_target_service_path "$unit_basename")"
    service_filename="$(unit_service_filename "$unit_basename")"
    local_source_timer=""
    local_source_timer="$(unit_source_timer_path "$unit_basename" || true)"
    local_target_timer="$(unit_target_timer_path "$unit_basename")"
    timer_filename="$(unit_timer_filename "$unit_basename")"

    echo ""
    echo "🧩 Unit: ${service_filename}"
    print_running_commit "$service_filename"

    main_pid=""
    if main_pid="$(service_main_pid "$service_filename")"; then
        if running_full="$(read_deployed_commit_from_pid "$main_pid")"; then
            if [[ -n "$desired_full" && "$running_full" != "$desired_full" ]]; then
                deploy_refresh_needed=1
                echo "⚠️  Running commit (${running_full:0:7}) differs from desired (${desired_sha}) — will refresh."
            fi
        else
            deploy_refresh_needed=1
            echo "⚠️  Running service lacks ${deployed_commit_env_name}; treating as stale (will refresh)."
        fi
    fi
    if installed_unit_lacks_deployed_commit_env "$local_target_service"; then
        deploy_refresh_needed=1
        echo "⚠️  Installed unit lacks ${deployed_commit_env_name}; updating unit (conservative refresh)."
    fi
    if [[ "$deploy_refresh_needed" == "1" ]]; then
        any_deploy_refresh_needed=true
    elif [[ -n "$desired_full" && -n "$running_full" && "$running_full" == "$desired_full" ]]; then
        echo "   Already at desired commit — verifying install only (no deploy/restart unless something differs)."
    fi

    if [[ -L "$local_target_service" ]]; then
        echo "🔗 Removing old symlink..."
        rm "$local_target_service"
    elif [[ -f "$local_target_service" ]]; then
        if diff --brief <(generate_service_unit "$local_source_service") "$local_target_service" > /dev/null 2>&1; then
            if [[ "$deploy_refresh_needed" == "1" ]]; then
                echo "🔄 Service file needs ${deployed_commit_env_name}; updating..."
            else
                echo "✅ Service file unchanged: $local_target_service"
                service_changed=false
            fi
        else
            echo "🔄 Service file changed. Updating..."
        fi
    fi

    if [[ "$service_changed" == "true" ]]; then
        generate_service_unit "$local_source_service" >"$local_target_service"
        any_unit_changed=true
        echo "✅ Service file generated: $local_target_service (repo: $repo_dir)"
    fi

    if [[ -f "$local_source_timer" ]]; then
        if [[ ! -f "$local_target_timer" ]]; then
            generate_timer_unit "$local_source_timer" >"$local_target_timer"
            timer_changed=true
            echo "✅ Timer file generated: $local_target_timer"
        elif ! diff --brief <(generate_timer_unit "$local_source_timer") "$local_target_timer" > /dev/null 2>&1; then
            generate_timer_unit "$local_source_timer" >"$local_target_timer"
            timer_changed=true
            echo "🔄 Timer file changed. Updating..."
        else
            echo "✅ Timer file unchanged: $local_target_timer"
        fi
    elif [[ -f "$local_target_timer" ]]; then
        remove_stale_unit_file "$timer_filename"
        rm -f "$(expanded_unit_timer_path "$unit_basename")"
        any_stale_removed=true
        timer_changed=true
    fi

    if [[ "$timer_changed" == "true" ]]; then
        any_timer_changed=true
    fi

    if [[ -f "$local_target_service" ]]; then
        write_expanded_unit_files "$unit_basename" "$local_target_service" "$local_target_timer"
    fi
done <<<"$unit_basenames"

# 4. Create log directory
mkdir -p "$log_dir"
echo "✅ Log directory ready: $log_dir"

# 5. Enable lingering for the current user (designated host only)
current_user="$(whoami)"
linger_status=""
if host_runs_units; then
    if [[ "$kernel_name" == "Darwin" ]]; then
        echo "ℹ️  Skipping loginctl enable-linger (Linux hosts only; not available on macOS)."
    else
        linger_status="$(loginctl show-user "$current_user" -p Linger --value 2>/dev/null || true)"
        if [[ "$linger_status" == "yes" ]]; then
            echo "✅ User lingering already enabled for $current_user (no change)."
        else
            echo "👤 Enabling lingering for user: $current_user"
            loginctl enable-linger "$current_user"
        fi
    fi
else
    echo "ℹ️  Skipping loginctl enable-linger (service host ${condition_host_value} / ${condition_host_machine_id}; this host is $(current_hostname_short))"
fi

# 6. Lockfile drift preflight, then repo-specific deploy hook (see run_on_deploy_hook).
run_lockfile_drift_preflight
code_changed=false
if run_on_deploy_hook; then
    code_changed=true
fi
if [[ "$any_deploy_refresh_needed" == "true" ]]; then
    code_changed=true
fi

# 7. Reload daemon when unit files changed
if [[ "$any_unit_changed" == "true" || "$any_timer_changed" == "true" || "$any_stale_removed" == "true" ]]; then
    echo "🔄 Reloading systemd user daemon..."
    systemctl --user daemon-reload
fi

# 8. Enable service (and timer when present); start/restart long-running units only
while IFS= read -r unit_basename; do
    local_source_service=""
    local_target_service=""
    local_source_timer=""
    local_target_timer=""
    service_filename=""
    timer_filename=""
    is_oneshot=false

    local_source_service="$(unit_source_service_path "$unit_basename")"
    local_target_service="$(unit_target_service_path "$unit_basename")"
    service_filename="$(unit_service_filename "$unit_basename")"
    local_source_timer=""
    local_source_timer="$(unit_source_timer_path "$unit_basename" || true)"
    local_target_timer="$(unit_target_timer_path "$unit_basename")"
    timer_filename="$(unit_timer_filename "$unit_basename")"

    if [[ -f "$local_target_service" ]] && service_unit_is_oneshot "$local_target_service"; then
        is_oneshot=true
    fi

    if [[ "$is_oneshot" == "true" && -f "$local_source_timer" ]]; then
        # Timer-driven oneshots: enable the timer only. Do not link the service into
        # default.target (that caused a second run on every user-session start, overlapping
        # the daily timer and doubling GitHub API traffic).
        timer_only_drop_stale_default_target_link "$service_filename"
        if host_runs_units; then
            echo "⏰ Enabling timer: ${timer_filename}"
            if ! systemctl --user is-enabled --quiet "$timer_filename" 2>/dev/null \
                || ! systemctl --user is-active --quiet "$timer_filename" 2>/dev/null; then
                any_runtime_action=true
            fi
            systemctl --user enable --now "$timer_filename"
            echo "⏭️  ${service_filename}: oneshot — runs on timer schedule (not started now)."
        else
            timer_standby_disable "$timer_filename"
            echo "⏭️  ${service_filename}: oneshot — skipped on $(current_hostname_short) (service host ${condition_host_value} / ${condition_host_machine_id})."
        fi
        continue
    fi

    if host_runs_units; then
        if ! systemctl --user is-enabled --quiet "$service_filename" 2>/dev/null; then
            any_runtime_action=true
        fi
        systemctl --user enable "$service_filename"
    fi
    if [[ -f "$local_source_timer" ]]; then
        if host_runs_units; then
            echo "⏰ Enabling timer: ${timer_filename}"
            if ! systemctl --user is-enabled --quiet "$timer_filename" 2>/dev/null \
                || ! systemctl --user is-active --quiet "$timer_filename" 2>/dev/null; then
                any_runtime_action=true
            fi
            systemctl --user enable --now "$timer_filename"
        else
            timer_standby_disable "$timer_filename"
        fi
    fi

    if [[ "$is_oneshot" == "true" ]]; then
        if host_runs_units; then
            echo "⏭️  ${service_filename}: oneshot — no timer; start manually with systemctl --user start ${service_filename}"
        else
            echo "⏭️  ${service_filename}: oneshot — skipped on $(current_hostname_short) (service host ${condition_host_value} / ${condition_host_machine_id})."
        fi
        continue
    fi

    if ! host_runs_units; then
        echo "⏭️  ${service_filename}: skipped start/restart on $(current_hostname_short) (service host ${condition_host_value} / ${condition_host_machine_id})."
        continue
    fi

    if [[ "$any_unit_changed" == "true" || "$any_timer_changed" == "true" ]]; then
        echo "🔄 Restarting ${service_filename} (config changed)..."
        systemctl_user_or_fail restart "$service_filename" "$local_target_service" "$local_source_service" "$service_filename" || exit 1
        any_runtime_action=true
        continue
    fi
    if [[ "$code_changed" == "true" ]]; then
        echo "🔄 Restarting ${service_filename} (code changed)..."
        systemctl_user_or_fail restart "$service_filename" "$local_target_service" "$local_source_service" "$service_filename" || exit 1
        any_runtime_action=true
        continue
    fi
    if ! systemctl --user is-active --quiet "$service_filename"; then
        echo "🚀 Starting ${service_filename} (was not running)..."
        systemctl_user_or_fail start "$service_filename" "$local_target_service" "$local_source_service" "$service_filename" || exit 1
        any_runtime_action=true
        continue
    fi
    if [[ "$force_restart" == "1" ]]; then
        echo "🔄 Restarting ${service_filename} (forced)..."
        systemctl_user_or_fail restart "$service_filename" "$local_target_service" "$local_source_service" "$service_filename" || exit 1
        any_runtime_action=true
        continue
    fi
    echo "⏭️  ${service_filename}: config and code unchanged — no restart needed."
done <<<"$unit_basenames"

echo ""
if [[ "$any_unit_changed" == "false" \
    && "$any_timer_changed" == "false" \
    && "$any_stale_removed" == "false" \
    && "$any_deploy_refresh_needed" == "false" \
    && "$code_changed" == "false" \
    && "$any_runtime_action" == "false" ]]; then
    echo "✨ ${service_name} unit/deploy state already up to date."
else
    echo "✨ ${service_name} systemd units successfully configured!"
fi
check_status
