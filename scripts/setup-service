#!/usr/bin/env bash

# Setup script for a systemd user service.
# Derives the service name from the git remote URL — no hardcoding.
# Repo-specific build/deploy logic belongs in scripts/on-deploy (optional hook).
#
# Worktree behaviour: all paths (service template, on-deploy, @@REPO_DIR@@ in the
# service file) are resolved from the worktree this script is called from.
# Calling setup-service from a feature worktree therefore deploys that worktree's
# code and template, which is the intended behaviour for local development.
#
# Running commit: the generated unit sets Environment=DEPLOYED_COMMIT=<sha> from
# HEAD at setup time. The running process inherits that value until restart; it is
# not inferred from git HEAD at the process cwd (which changes on pull).

set -euo pipefail

repo_dir="$(git -C "$PWD" rev-parse --show-toplevel)"
readonly repo_dir
# Derive service name from the remote URL so it is stable regardless of which
# worktree or directory name is used (mirrors start-development's approach).
gh_remote="$(git -C "$repo_dir" remote get-url origin | sed 's|.*github.com[:/]||;s|\.git$||')"
service_name="${gh_remote##*/}"
readonly service_name
service_filename="${service_name}.service"
readonly service_filename
readonly source_service="${repo_dir}/etc/systemd/${service_filename}"
readonly target_dir="${HOME}/.config/systemd/user"
readonly target_service="${target_dir}/${service_filename}"
log_dir="${HOME}/scratch/${service_name}"
readonly log_dir
kernel_name="$(uname -s)"
readonly kernel_name
readonly deployed_commit_env_name="DEPLOYED_COMMIT"

# generate_service_unit
# Substitute @@REPO_DIR@@ and inject DEPLOYED_COMMIT into the [Service] section.
generate_service_unit() {
    local deployed_sha
    local generated

    deployed_sha="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
    if [[ -z "$deployed_sha" ]]; then
        die "Could not resolve HEAD in: ${repo_dir}"
    fi

    generated="$(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_service")"
    if grep -qF '@@DEPLOYED_COMMIT@@' <<<"$generated"; then
        generated="$(sed "s|@@DEPLOYED_COMMIT@@|${deployed_sha}|g" <<<"$generated")"
    fi
    if grep -q "^Environment=${deployed_commit_env_name}=" <<<"$generated"; then
        generated="$(
            printf '%s\n' "$generated" \
                | sed "s|^Environment=${deployed_commit_env_name}=.*|Environment=${deployed_commit_env_name}=${deployed_sha}|"
        )"
    else
        generated="$(
            awk -v var="$deployed_commit_env_name" -v sha="$deployed_sha" '
                /^\[Service\]/ && !inserted {
                    print
                    print "Environment=" var "=" sha
                    inserted = 1
                    next
                }
                { print }
            ' <<<"$generated"
        )"
    fi
    printf '%s' "$generated"
}

# read_deployed_commit_from_pid <main_pid>
# Reads DEPLOYED_COMMIT from the process environment (set by systemd at start).
read_deployed_commit_from_pid() {
    local -r main_pid="$1"
    local env_line sha

    env_line="$(
        tr '\0' '\n' <"/proc/${main_pid}/environ" 2>/dev/null \
            | grep "^${deployed_commit_env_name}=" \
            | head -n1 \
            || true
    )"
    if [[ -z "$env_line" ]]; then
        return 1
    fi
    sha="${env_line#"${deployed_commit_env_name}"=}"
    if [[ -z "$sha" ]]; then
        return 1
    fi
    printf '%s\n' "$sha"
}

# service_main_pid
# Prints systemd MainPID or empty when the service is not running.
service_main_pid() {
    local main_pid
    main_pid="$(systemctl --user show "$service_filename" --property=MainPID --value 2>/dev/null || true)"
    if [[ -z "$main_pid" || "$main_pid" == "0" ]]; then
        return 1
    fi
    printf '%s\n' "$main_pid"
}

# installed_unit_lacks_deployed_commit_env
# True when the installed user unit has no DEPLOYED_COMMIT Environment line.
installed_unit_lacks_deployed_commit_env() {
    [[ -f "$target_service" ]] \
        && ! grep -q "^Environment=${deployed_commit_env_name}=" "$target_service"
}

# running_service_lacks_deployed_commit_env <main_pid>
running_service_lacks_deployed_commit_env() {
    local -r main_pid="$1"
    ! read_deployed_commit_from_pid "$main_pid" >/dev/null 2>&1
}

# print_running_commit
# Report DEPLOYED_COMMIT from the running service MainPID (never git HEAD at cwd).
print_running_commit() {
    local main_pid
    local deployed_sha

    if ! main_pid="$(service_main_pid)"; then
        echo "   Running commit: (service not running)"
        return 0
    fi

    if deployed_sha="$(read_deployed_commit_from_pid "$main_pid")"; then
        echo "   Running commit: ${deployed_sha:0:7}  (from ${deployed_commit_env_name})"
        return 0
    fi

    echo "   Running commit: (unknown; ${deployed_commit_env_name} not set — will refresh)"
}

die() {
    echo "❌ Error: $*" >&2
    exit 1
}

# resolve_service_log_file
# Prints the service log path from the installed unit, source template, or scratch default.
resolve_service_log_file() {
    local unit_text exec_start log_file args

    unit_text="$(systemctl --user cat "${service_filename}" 2>/dev/null || true)"
    if [[ -z "$unit_text" && -f "$target_service" ]]; then
        unit_text="$(cat "$target_service")"
    elif [[ -z "$unit_text" && -f "$source_service" ]]; then
        unit_text="$(sed "s|@@REPO_DIR@@|${repo_dir}|g" "$source_service")"
    fi

    log_file=""
    exec_start="$(printf '%s\n' "$unit_text" | grep '^ExecStart=' | sed 's/^ExecStart=//' | head -n1 || true)"
    if [[ -n "$exec_start" ]]; then
        args="$(printf '%s\n' "$exec_start" | cut -d' ' -f2-)"
        log_file="$(printf '%s\n' "$args" | grep -oP -- '--log-file \K\S+' | sed "s|%h|${HOME}|g" || true)"
    fi
    if [[ -z "$log_file" ]]; then
        log_file="$(
            printf '%s\n' "$unit_text" \
                | grep -E '^Standard(Output|Error)=' \
                | head -n1 \
                | grep -oP 'append:\K\S+' \
                | sed "s|%h|${HOME}|g" \
                || true
        )"
    fi
    if [[ -z "$log_file" ]]; then
        log_file="${log_dir}/${service_name}.log"
    fi
    printf '%s\n' "$log_file"
}

# print_service_failure_hint
# After a failed systemctl start/restart, point the operator at service logs.
print_service_failure_hint() {
    local log_file

    log_file="$(resolve_service_log_file)"
    echo "" >&2
    echo "❌ ${service_filename} failed to start or restart." >&2
    echo "   Service log:  tail --follow=name --retry ${log_file}" >&2
    if [[ "$kernel_name" != "Darwin" ]]; then
        echo "   systemd:      journalctl --user -xeu ${service_filename}" >&2
    fi
}

# systemctl_user_or_fail <action> [systemctl args...]
# Runs systemctl --user; on failure prints log hints and returns non-zero.
systemctl_user_or_fail() {
    local action="$1"
    shift

    if systemctl --user "$action" "$@"; then
        return 0
    fi
    print_service_failure_hint
    return 1
}

# Function to display help
show_help() {
    cat << EOF
${service_name} Setup Utility - Persistent Service

USAGE:
    ./scripts/setup-service [OPTIONS]

DESCRIPTION:
    Configures ${service_name} to run as a persistent background service using systemd.
    Ensures lingering is enabled for the user so the service starts on boot
    and remains active without a login session.

OPTIONS:
    -s, --status
        Check the current configuration status and service health.

    -h, --help
        Display this help message and exit.

    (no options)
        Install or update the systemd service configuration.

EXAMPLES:
    # Set up or update the service
    ./scripts/setup-service

    # Check the current status
    ./scripts/setup-service --status
EOF
    exit 0
}

# Function to check current status
check_status() {
    if [[ ! -f "$source_service" ]]; then
        echo "ℹ️  ${service_name} has no service template — not a systemd service repo."
        return 0
    fi

    if [[ "$kernel_name" == "Darwin" ]]; then
        echo "🔍 Verifying ${service_name} service configuration..."
        echo "----------------------------------------"
        echo "ℹ️  macOS:   systemd user services are not installed on this platform."
        local desired_sha
        desired_sha="$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || true)"
        if [[ -n "$desired_sha" ]]; then
            echo "   Desired commit: ${desired_sha}  (${repo_dir})"
        fi
        echo "----------------------------------------"
        echo "✨ ${service_name}: no systemd setup on macOS (use Linux or run the app manually)."
        return 0
    fi

    local all_good=true
    echo "🔍 Verifying ${service_name} service configuration..."
    echo "----------------------------------------"

    # 1. Check service file is installed and up to date
    if [[ ! -f "$target_service" ]]; then
        echo "❌ Service:  Not installed (Run setup to install it)"
        all_good=false
    elif diff --brief <(generate_service_unit) "$target_service" > /dev/null 2>&1; then
        echo "✅ Service:  Up to date ($target_service)"
    else
        echo "❌ Service:  Outdated (Run setup to update it)"
        all_good=false
    fi

    # 2. Check Lingering
    local current_user
    current_user="$(whoami)"
    if [[ "$kernel_name" == "Darwin" ]]; then
        echo "ℹ️  Linger:   Skipped on macOS (loginctl enable-linger is for Linux hosts only)"
    elif loginctl show-user "$current_user" --property=Linger | grep -q "Linger=yes"; then
        echo "✅ Linger:   Enabled for $current_user"
    else
        echo "❌ Linger:   Disabled (Service won't survive reboots!)"
        all_good=false
    fi

    # 3. Check Systemd Service Status
    if systemctl --user is-active "${service_filename}" > /dev/null 2>&1; then
        echo "✅ Active:   Running"
    else
        echo "❌ Active:   Inactive (Stopped)"
        all_good=false
    fi

    if systemctl --user is-enabled "${service_filename}" > /dev/null 2>&1; then
        echo "✅ Enabled:  Auto-start is active"
    else
        echo "❌ Enabled:  Auto-start is disabled"
        all_good=false
    fi

    print_running_commit

    # 4. Show how the service is invoked
    local unit_text exec_start exec_post args port log_file
    unit_text="$(systemctl --user cat "${service_filename}" 2>/dev/null)"
    exec_start="$(printf '%s\n' "$unit_text" | grep '^ExecStart=' | sed 's/^ExecStart=//' | head -n1 || true)"
    exec_post="$(printf '%s\n' "$unit_text" | grep '^ExecStartPost=' | sed 's/^ExecStartPost=//')"
    if [[ -n "$exec_start" ]]; then
        args="$(printf '%s\n' "$exec_start" | cut -d' ' -f2-)"
        port="$(printf '%s\n' "$args" | grep -oP -- '--(http-)?port \K\d+' || true)"
        echo "✅ Starts:    $exec_start"
    fi
    if [[ -n "$exec_post" ]]; then
        echo "✅ Health:    $exec_post"
    fi
    if [[ -n "${port:-}" ]]; then
        echo "   URL:       http://localhost:${port}"
    fi
    log_file="$(resolve_service_log_file)"
    echo "   Logs:      tail --follow=name --retry ${log_file}"

    echo "----------------------------------------"
    if $all_good; then
        echo "✨ Everything looks good! ${service_name} is correctly configured."
        return 0
    else
        echo "⚠️  Some issues were found. Run ./scripts/setup-service to fix them."
        return 1
    fi
}

# Handle arguments
if [[ $# -gt 0 ]]; then
    case $1 in
        -h|--help)
            show_help
            ;;
        -s|--status)
            check_status
            exit $?
            ;;
        *)
            echo "❌ Error: Unknown option: $1"
            echo "Run './scripts/setup-service --help' for usage information"
            exit 1
            ;;
    esac
fi

# run_on_deploy_hook
# Invokes scripts/on-deploy when executable. Exit 0 → code changed; 1 → unchanged; 2+ → abort.
run_on_deploy_hook() {
    local on_deploy_exit on_deploy_stderr

    if [[ ! -x "${repo_dir}/scripts/on-deploy" ]]; then
        return 0
    fi

    on_deploy_exit=0
    on_deploy_stderr="$(mktemp)"
    "${repo_dir}/scripts/on-deploy" 2>"$on_deploy_stderr" || on_deploy_exit=$?
    if [[ "$on_deploy_exit" -eq 0 ]]; then
        rm -f "$on_deploy_stderr"
        return 0
    fi
    if [[ "$on_deploy_exit" -ge 2 ]]; then
        echo "❌ Error: on-deploy exited with code ${on_deploy_exit}" >&2
        if [[ -s "$on_deploy_stderr" ]]; then
            echo "--- on-deploy stderr ---" >&2
            cat "$on_deploy_stderr" >&2
        fi
        rm -f "$on_deploy_stderr"
        exit "$on_deploy_exit"
    fi
    rm -f "$on_deploy_stderr"
    return 1
}

# Main installation flow
echo "Setting up ${service_name} systemd service..."

# 1. Verify source service file exists
if [[ ! -f "$source_service" ]]; then
    echo "ℹ️  No service template found at $source_service — this repo is not a systemd service. Skipping."
    exit 0
fi

# macOS has no systemd user units — skip install entirely (on-deploy may still run).
if [[ "$kernel_name" == "Darwin" ]]; then
    echo "ℹ️  macOS: skipping systemd user service installation (Linux hosts only)."
    mkdir -p "$log_dir"
    echo "✅ Log directory: $log_dir"
    desired_sha="$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || true)"
    if [[ -n "$desired_sha" ]]; then
        echo "   Desired commit: ${desired_sha}  (${repo_dir})"
    fi
    if run_on_deploy_hook; then
        echo "✅ on-deploy: completed (code may have changed)."
    else
        echo "⏭️  on-deploy: nothing changed."
    fi
    echo ""
    echo "✨ ${service_name}: systemd setup skipped on macOS."
    exit 0
fi

# 2. Ensure target directory exists
mkdir -p "$target_dir"

# Print current vs running commit before updating the unit (running = old process env).
deploy_refresh_needed=0
desired_sha="$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || true)"
desired_full="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
if [[ -n "$desired_sha" ]]; then
    echo "   Desired commit: ${desired_sha}  (${repo_dir})"
fi
print_running_commit

main_pid=""
if main_pid="$(service_main_pid)"; then
    running_full=""
    if running_full="$(read_deployed_commit_from_pid "$main_pid")"; then
        if [[ -n "$desired_full" && "$running_full" != "$desired_full" ]]; then
            deploy_refresh_needed=1
            echo "⚠️  Running commit (${running_full:0:7}) differs from desired (${desired_sha}) — will refresh."
        fi
    else
        deploy_refresh_needed=1
        echo "⚠️  Running service lacks ${deployed_commit_env_name}; treating as stale (will refresh)."
    fi
fi
if installed_unit_lacks_deployed_commit_env; then
    deploy_refresh_needed=1
    echo "⚠️  Installed unit lacks ${deployed_commit_env_name}; updating unit (conservative refresh)."
fi

# 3. Generate service file with repo path and DEPLOYED_COMMIT substituted
generated="$(generate_service_unit)"
service_changed=true

if [[ -L "$target_service" ]]; then
    echo "🔗 Removing old symlink..."
    rm "$target_service"
elif [[ -f "$target_service" ]]; then
    if diff --brief <(printf '%s' "$generated") "$target_service" > /dev/null 2>&1; then
        if [[ "$deploy_refresh_needed" == "1" ]]; then
            echo "🔄 Service file needs ${deployed_commit_env_name}; updating..."
        else
            echo "✅ Service file unchanged: $target_service"
            service_changed=false
        fi
    else
        echo "🔄 Service file changed. Updating..."
    fi
fi

if [[ "$service_changed" == "true" ]]; then
    printf '%s' "$generated" > "$target_service"
    echo "✅ Service file generated: $target_service (repo: $repo_dir)"
fi

# 4. Create log directory
mkdir -p "$log_dir"
echo "✅ Log directory: $log_dir"

# 5. Enable lingering for the current user
current_user="$(whoami)"
echo "👤 Enabling lingering for user: $current_user"
if [[ "$kernel_name" == "Darwin" ]]; then
    echo "ℹ️  Skipping loginctl enable-linger (Linux hosts only; not available on macOS)."
else
    loginctl enable-linger "$current_user"
fi

# 6. Run repo-specific deploy hook if present (see run_on_deploy_hook).
code_changed=false
if run_on_deploy_hook; then
    code_changed=true
fi
if [[ "$deploy_refresh_needed" == "1" ]]; then
    code_changed=true
fi

# 7. Reload daemon only if service file changed
if [[ "$service_changed" == "true" ]]; then
    echo "🔄 Reloading systemd user daemon..."
    systemctl --user daemon-reload
fi

# 8. Always ensure the service is enabled and running
systemctl --user enable "$service_filename"
if [[ "$service_changed" == "true" ]]; then
    echo "🔄 Restarting ${service_filename} (config changed)..."
    systemctl_user_or_fail restart "$service_filename" || exit 1
elif [[ "$code_changed" == "true" ]]; then
    if [[ "$deploy_refresh_needed" == "1" ]]; then
        echo "🔄 Restarting ${service_filename} (deploy refresh)..."
    else
        echo "🔄 Restarting ${service_filename} (code changed)..."
    fi
    systemctl_user_or_fail restart "$service_filename" || exit 1
elif ! systemctl --user is-active --quiet "$service_filename"; then
    echo "🚀 Starting ${service_filename} (was not running)..."
    systemctl_user_or_fail start "$service_filename" || exit 1
else
    echo "⏭️  Service file and code unchanged — no restart needed."
fi

echo ""
echo "✨ ${service_name} service successfully configured!"
check_status
