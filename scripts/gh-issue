#!/usr/bin/env bash
# scripts/gh-issue — agent-facing `gh issue create|edit` with Markdown pre-flight.
#
# Lints `--body-file` (or refuses multi-line inline `--body`) via
# scripts/lib/github-markdown before calling `gh issue` through the rate-limit
# waiter. Use this instead of bare `gh issue create` / `gh issue edit` so
# hand-wrapped paragraphs and other body mangling cannot ship (repository-helpers#653).
#
# Usage:
#   scripts/gh-issue create --title '…' --body-file /tmp/issue.md
#   scripts/gh-issue edit <n> --body-file /tmp/issue.md
#   scripts/gh-issue create --title '…' --body 'single-line body only'
#   scripts/gh-issue --help
#
# Other `gh issue` verbs pass through with rate-limit retry only (no body lint).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/github-api-rate-limit"
# shellcheck disable=SC1091
source "${script_dir}/lib/github-markdown"

usage() {
  printf '%s\n' \
    'Usage: scripts/gh-issue create|edit …' \
    '' \
    'Agent wrapper for gh issue. For create/edit with a body:' \
    '  - Prefer --body-file <path>; the file is linted before the API call.' \
    '  - Inline --body is only allowed for a single physical line (no newlines).' \
    '' \
    'Lint: scripts/lint-github-markdown (hand-wrap, blank lines, fences, …).' \
    'See .agents/rules/github-content-formatting.md and repository-helpers#653.'
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# gh_issue_resolve_body_arg <argv…>
# Sets gh_issue_body_kind to file|inline|empty and gh_issue_body_value.
# Last --body-file/-F / --body/-b wins (matches gh/pflag).
gh_issue_resolve_body_arg() {
  local arg next=''
  gh_issue_body_kind='empty'
  gh_issue_body_value=''

  while (( $# > 0 )); do
    arg="$1"
    shift
    case "$arg" in
      -F | --body-file)
        next="${1:-}"
        [[ -n "$next" ]] || die "${arg} requires a path"
        shift
        gh_issue_body_kind='file'
        gh_issue_body_value="$next"
        ;;
      -F=* | --body-file=*)
        gh_issue_body_kind='file'
        gh_issue_body_value="${arg#*=}"
        ;;
      -b | --body)
        next="${1:-}"
        [[ -n "$next" ]] || die "${arg} requires a value"
        shift
        gh_issue_body_kind='inline'
        gh_issue_body_value="$next"
        ;;
      -b=* | --body=*)
        gh_issue_body_kind='inline'
        gh_issue_body_value="${arg#*=}"
        ;;
    esac
  done
}

# gh_issue_preflight_body <verb> <argv…>
# Lint body-file or reject multi-line --body for create/edit.
gh_issue_preflight_body() {
  local -r verb="$1"
  shift

  case "$verb" in
    create | edit) ;;
    *) return 0 ;;
  esac

  gh_issue_resolve_body_arg "$@"

  case "$gh_issue_body_kind" in
    file)
      if [[ "$gh_issue_body_value" == '-' ]]; then
        die 'scripts/gh-issue: body-file - (stdin) is not supported; write a temp file and lint it'
      fi
      ghm_lint_file "$gh_issue_body_value" \
        || die "GITHUB_MARKDOWN_LINT failed for --body-file ${gh_issue_body_value}"
      ;;
    inline)
      if [[ "$gh_issue_body_value" == *$'\n'* ]]; then
        die 'inline --body must be a single line; write a temp file and use --body-file'
      fi
      if [[ "$gh_issue_body_value" == *'\n'* ]]; then
        die 'inline --body contains literal \\n escapes; use --body-file with real newlines'
      fi
      ghm_lint_text <<<"$gh_issue_body_value" >&2 \
        || die 'GITHUB_MARKDOWN_LINT failed for --body'
      ;;
  esac
}

main() {
  local verb label

  if [[ $# -eq 0 ]] || [[ "${1:-}" == '--help' ]] || [[ "${1:-}" == '-h' ]]; then
    usage
    if [[ $# -eq 0 ]]; then
      exit 1
    fi
    exit 0
  fi

  verb="$1"
  gh_issue_preflight_body "$@"
  label="gh-issue:${verb}"
  # Keep `gh` on this line (runner-adoption ratchet).
  github_api_exec_with_rate_limit_retry "$label" -- gh issue "$@"
}

main "$@"
