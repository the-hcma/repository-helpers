#!/usr/bin/env bash
# Run the org canonical secret scan locally (same logic as CI .github/ci/secret-scan).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="$(cd "${script_dir}/../.." && pwd)"
readonly rh_root

usage() {
  cat <<'EOF'
Usage:
  scripts/dev/secret-scan [repo_dir]
  scripts/dev/secret-scan --help

Run the org canonical gitleaks secret scan (scripts/lib/ci-secret-scan) against
repo_dir (default: this repository-helpers checkout). Installs gitleaks under
~/.cache/repository-helpers/bin when needed.

Environment:
  GITLEAKS_VERSION        Pin override
  GITLEAKS_BASE / GITLEAKS_HEAD    Optional PR-diff scan SHAs
  CI_SECRET_SCAN_BIN_DIR  Install directory (default: ~/.cache/.../bin locally)
EOF
}

if [[ "${1:-}" == '-h' || "${1:-}" == '--help' ]]; then
  usage
  exit 0
fi

# shellcheck disable=SC1091  # ci-secret-scan is copied to consumer .github/ci/; not adjacent for -x
source "${rh_root}/scripts/lib/ci-secret-scan"

repo_dir="${1:-$rh_root}"
repo_dir="$(cd "$repo_dir" && pwd)"

# Install the pinned gitleaks under ~/.cache when it is missing or the wrong
# version (ci_secret_scan_ensure verifies the tarball SHA-256 on install).
export CI_SECRET_SCAN_BIN_DIR="${HOME}/.cache/repository-helpers/bin"
export PATH="${CI_SECRET_SCAN_BIN_DIR}:${PATH}"
ci_secret_scan_ensure

ci_secret_scan_run "$repo_dir"
