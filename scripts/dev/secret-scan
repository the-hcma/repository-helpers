#!/usr/bin/env bash
# Run the org canonical secret scan locally (same logic as CI .github/ci/secret-scan).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
rh_root="$(cd "${script_dir}/../.." && pwd)"
readonly rh_root

# shellcheck source=scripts/lib/ci-secret-scan
source "${rh_root}/scripts/lib/ci-secret-scan"

repo_dir="${1:-$rh_root}"
repo_dir="$(cd "$repo_dir" && pwd)"

if ! command -v gitleaks >/dev/null 2>&1; then
  bin_dir="${HOME}/.cache/repository-helpers/bin"
  export CI_SECRET_SCAN_BIN_DIR="$bin_dir"
  export PATH="${bin_dir}:${PATH}"
  ci_secret_scan_install_gitleaks
fi

ci_secret_scan_run "$repo_dir"
