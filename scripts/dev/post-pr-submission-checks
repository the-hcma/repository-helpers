#!/usr/bin/env bash
# scripts/dev/post-pr-submission-checks — Verify PR exists and CI is green.
#
# Intended to run immediately after scripts/dev/submit-stack (or any PR creation).
# By default it discovers the PR for the current branch and waits for required
# checks to complete. Exits non-zero if CI is not green.
#
# The target repo is resolved from the current working directory, not from this
# script's own location, so invoking it via an absolute path (e.g.
# ~/work/ai/repository-helpers/scripts/dev/post-pr-submission-checks from a
# different repo's worktree) still operates on the caller's repo.
#
# Protected environments (github-repo-lint, dep-updater) stay WAITING until
# approved. Coding agents MUST approve on the operator's behalf (`gh` is the
# operator); this script calls scripts/dev/approve-pending-deployments while
# waiting. Do not wait for a human to click Approve in the Actions UI.
# If approval fails, prints ERROR: ENVIRONMENT_APPROVAL_FAILED and exits.
# Coding agents MUST raise that to the operator — do not keep waiting.
#
# Usage:
#   scripts/dev/post-pr-submission-checks
#   scripts/dev/post-pr-submission-checks --pr <number>
#   scripts/dev/post-pr-submission-checks --no-wait
#   scripts/dev/post-pr-submission-checks --help
#
# Environment:
#   POST_PR_CHECKS_TIMEOUT     Timeout for waiting on CI (default: 20m)
#   POST_PR_CHECKS_POLL_SECS   Poll interval in seconds (default: 10)
#   POST_PR_CHECKS_LOG_LINES   Max filtered log lines on failure (default: 80)
#
# On CI failure, prints filtered `gh run view --log-failed` excerpts under
# "CI failure details for coding agent" so agents can fix and re-push.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"

# shellcheck disable=SC1091  # dev-worktree-guard is a sibling lib, not a package
source "${script_dir}/../lib/dev-worktree-guard"

# shellcheck disable=SC1091
source "${script_dir}/../lib/ci-check-rollup"

repo_dir=""
pr_number=""
no_wait=0

usage() {
  runner_sh_stdout "post-pr-submission-checks usage" -- \
    "sed -n '2,32p' $(printf '%q' "${BASH_SOURCE[0]}") | sed 's/^# \{0,1\}//'"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

require_tools() {
  command -v gh >/dev/null 2>&1 || die "gh not found on PATH"
  command -v jq >/dev/null 2>&1 || die "jq not found on PATH"
  command -v git >/dev/null 2>&1 || die "git not found on PATH"
}

# resolve_repo_dir — target repo whose branch/PR we are checking, resolved from
# the caller's cwd, not this script's own BASH_SOURCE location, so invoking via
# an absolute path (e.g. ~/work/ai/repository-helpers/scripts/dev/post-pr-submission-checks
# from a different repo's worktree) still operates on the caller's repo (#590).
resolve_repo_dir() {
  repo_dir="$(dev_resolve_target_repo_dir 'post-pr-submission-checks')" || exit 1
  readonly repo_dir
}

parse_duration_seconds() {
  local -r raw="$1"
  local n

  if [[ "$raw" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$raw"
    return 0
  fi
  if [[ "$raw" =~ ^([0-9]+)s$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  if [[ "$raw" =~ ^([0-9]+)m$ ]]; then
    n="${BASH_REMATCH[1]}"
    printf '%s\n' "$(( n * 60 ))"
    return 0
  fi
  if [[ "$raw" =~ ^([0-9]+)h$ ]]; then
    n="${BASH_REMATCH[1]}"
    printf '%s\n' "$(( n * 3600 ))"
    return 0
  fi
  return 1
}

git_current_branch() {
  local branch exit_code

  exit_code=0
  branch="$(runner_exec_stdout "git branch show-current" -- git -C "$repo_dir" branch --show-current)" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    branch=""
  fi
  printf '%s\n' "$branch"
}

# ensure_branch_is_pushed — confirm origin has this branch at the current HEAD.
#
# Query origin directly rather than trusting `@{u}`: local upstream-tracking
# config only proves a tracking ref was once configured, not that HEAD was
# pushed, and `gh stack submit` / `git push` without `-u` never set it at all
# even though origin has an in-sync branch and an open PR (#596). One `ls-remote`
# is negligible next to the `gh` API calls that follow.
ensure_branch_is_pushed() {
  local -r branch="$1"
  local remote_ref remote_sha local_sha exit_code

  exit_code=0
  remote_ref="$(runner_exec_stdout "git ls-remote origin branch" --probe --timeout 20 -- git -C "$repo_dir" ls-remote --heads origin "$branch")" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    die "Could not query origin for branch ${branch} (network error?)"
  fi
  remote_sha="${remote_ref%%[[:space:]]*}"
  if [[ -z "$remote_sha" ]]; then
    die "Branch ${branch} is not on origin (push it or run scripts/dev/submit-stack)"
  fi

  exit_code=0
  local_sha="$(runner_exec_stdout "git rev-parse HEAD" --probe -- git -C "$repo_dir" rev-parse HEAD)" \
    || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "$local_sha" ]]; then
    die "Could not resolve local HEAD for branch ${branch}"
  fi

  if [[ "$remote_sha" != "$local_sha" ]]; then
    die "origin/${branch} (${remote_sha:0:12}) is out of sync with local HEAD (${local_sha:0:12}) — push again or run scripts/dev/submit-stack"
  fi
  log_step "Branch ${branch} is present on origin at HEAD"
}

discover_pr_number_for_branch() {
  local -r branch="$1"
  local out exit_code

  exit_code=0
  out="$(runner_exec_stdout "gh pr list for branch" -- gh pr list --head "$branch" --state open \
    --json number --jq '.[0].number // empty')" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "$out" ]]; then
    return 1
  fi
  printf '%s\n' "$out"
}

require_pr_open_and_ready() {
  local -r pr="$1"
  local state is_draft exit_code

  exit_code=0
  state="$(runner_exec_stdout "gh pr view state" -- gh pr view "$pr" --json state --jq '.state')" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    die "Could not read PR #${pr} state"
  fi
  exit_code=0
  is_draft="$(runner_exec_stdout "gh pr view isDraft" -- gh pr view "$pr" --json isDraft --jq '.isDraft')" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    die "Could not read PR #${pr} draft flag"
  fi
  if [[ "$state" != 'OPEN' ]]; then
    die "PR is not open (state: ${state})"
  fi
  if [[ "$is_draft" == 'true' ]]; then
    die "PR is draft (publish it before merge queue)"
  fi
}

require_pr_has_summary_and_test_plan() {
  local -r pr="$1"
  local body exit_code

  exit_code=0
  body="$(runner_exec_stdout "gh pr view body" -- gh pr view "$pr" --json body --jq '.body // ""')" \
    || exit_code=$?
  if (( exit_code != 0 )); then
    die "Could not read PR #${pr} body"
  fi
  if ! grep -qF '## Summary' <<<"$body"; then
    die "PR body is missing \"## Summary\""
  fi
  if ! grep -qF '## Test plan' <<<"$body"; then
    die "PR body is missing \"## Test plan\""
  fi
}

ci_repo_slug_for_pr() {
  local slug exit_code

  exit_code=0
  slug="$(ci_rollup_discover_repo_slug)" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "$slug" ]]; then
    slug=""
  fi
  printf '%s\n' "$slug"
}

require_ci_success() {
  local -r pr="$1"
  local rollup failures repo latest conclusion
  local fail_line fail_count

  repo="$(ci_repo_slug_for_pr)"
  if [[ -n "$repo" ]]; then
    rollup="$(ci_rollup_json_for_pr "$pr" "$repo")"
  else
    rollup="$(ci_rollup_json_for_pr "$pr")"
  fi
  # Newest row per check name supersedes stale CANCELLED/SKIPPED from prior runs.
  # Shared gating treats CANCELLED-only as pending (#454), not success or failure.
  # Exclude CodeRabbit / Bugbot: they start on push and are owned by agent-review.
  latest="$(ci_rollup_latest_by_name_json "$rollup")"
  latest="$(ci_rollup_without_agent_product_checks "$latest")"
  conclusion="$(ci_rollup_conclusion_for_gating "$latest" "")"
  case "$conclusion" in
    success)
      return 0
      ;;
    failure)
      failures=""
      fail_count=0
      while IFS= read -r fail_line; do
        [[ -z "$fail_line" ]] && continue
        failures+="${fail_line}"$'\n'
        fail_count=$(( fail_count + 1 ))
        if (( fail_count >= 20 )); then
          break
        fi
      done < <(ci_rollup_failed_lines "$latest" || true)
      printf '%s\n' "ERROR: CI failures for PR #${pr}:" >&2
      if [[ -n "$failures" ]]; then
        printf '%s' "$failures" >&2
      fi
      ci_agent_report_failed_logs_for_pr "$pr" "$repo" || true
      return 1
      ;;
    *)
      return 2
      ;;
  esac
}

wait_for_ci_success() {
  local -r pr="$1"
  local -r timeout_raw="${POST_PR_CHECKS_TIMEOUT:-20m}"
  local -r poll_raw="${POST_PR_CHECKS_POLL_SECS:-10}"
  local timeout_secs poll_secs start now elapsed rc exit_code state
  local rollup_to repo_to latest_to cancelled_to
  local cancel_line cancel_count
  local apd_rc

  timeout_secs=""
  if ! timeout_secs="$(parse_duration_seconds "$timeout_raw")"; then
    die "Invalid POST_PR_CHECKS_TIMEOUT (expected Ns/Nm/Nh): ${timeout_raw}"
  fi
  if ! poll_secs="$(parse_duration_seconds "${poll_raw}s")"; then
    die "Invalid POST_PR_CHECKS_POLL_SECS: ${poll_raw}"
  fi

  start="$(date +%s)"
  while true; do
    exit_code=0
    # Keep gh on the same line as runner_exec_stdout (runner-adoption ratchet).
    state="$(runner_exec_stdout "gh pr view state during CI wait" -- gh pr view "$pr" --json state --jq '.state')" \
      || exit_code=$?
    if (( exit_code == 0 )) && [[ "$state" == 'MERGED' ]]; then
      log_step "PR #${pr} merged during CI wait — treating as success"
      return 0
    fi
    rc=0
    require_ci_success "$pr" || rc=$?
    case "$rc" in
      0) return 0 ;;
      1) return 1 ;;
      2)
        log_step "Approving waiting environment deployments on operator behalf"
        apd_rc=0
        "${script_dir}/approve-pending-deployments" --pr "$pr" || apd_rc=$?
        if (( apd_rc != 0 )); then
          printf 'ERROR: ENVIRONMENT_APPROVAL_FAILED pr=%s\n' "$pr" >&2
          printf 'ERROR: raise this to the operator — do not keep waiting on WAITING jobs.\n' >&2
          printf 'ERROR: operator must approve the environment or grant this gh identity reviewer access.\n' >&2
          return 1
        fi
        ;;
      *) die "Internal error: unexpected CI status rc=${rc}" ;;
    esac

    now="$(date +%s)"
    elapsed="$(( now - start ))"
    if (( elapsed >= timeout_secs )); then
      printf 'ERROR: WAIT_TIMEOUT post-pr-submission-checks pr=%s waited=%ss timeout=%ss\n' \
        "$pr" "$elapsed" "$timeout_secs" >&2
      # Surface stuck CANCELLED rows so operators can tell cancel stalls from true pending (#454).
      repo_to="$(ci_repo_slug_for_pr 2>/dev/null || true)"
      if [[ -n "$repo_to" ]]; then
        rollup_to="$(ci_rollup_json_for_pr "$pr" "$repo_to" 2>/dev/null || true)"
      else
        rollup_to="$(ci_rollup_json_for_pr "$pr" 2>/dev/null || true)"
      fi
      latest_to="$(ci_rollup_latest_by_name_json "${rollup_to:-[]}")"
      latest_to="$(ci_rollup_without_agent_product_checks "$latest_to")"
      cancelled_to=""
      cancel_count=0
      while IFS= read -r cancel_line; do
        [[ -z "$cancel_line" ]] && continue
        cancelled_to+="${cancel_line}"$'\n'
        cancel_count=$(( cancel_count + 1 ))
        if (( cancel_count >= 20 )); then
          break
        fi
      done < <(ci_rollup_cancelled_lines "$latest_to" || true)
      if [[ -n "$cancelled_to" ]]; then
        printf 'NOTE: CANCELLED checks still present (waiting, not treated as CI failed):\n' >&2
        printf '%s' "$cancelled_to" >&2
      fi
      return 1
    fi
    sleep "$poll_secs"
  done
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --pr)
        [[ $# -ge 2 ]] || die "--pr requires a number"
        pr_number="$2"
        shift 2
        ;;
      --no-wait)
        no_wait=1
        shift
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

main() {
  parse_args "$@"
  require_tools
  resolve_repo_dir

  branch="$(git_current_branch)"
  [[ -n "$branch" ]] || die "Not on a branch (detached HEAD)"

  if [[ -z "$pr_number" ]]; then
    # Auto-discovery: the PR is found from the current branch, so it must be
    # pushed and at HEAD. With explicit --pr N the PR is identified by number and
    # the local checkout is irrelevant — don't gate on it (it may be a stale
    # `main`, or another repo's worktree via an absolute-path invocation, #590).
    ensure_branch_is_pushed "$branch"
    pr_number="$(discover_pr_number_for_branch "$branch" || true)"
    [[ -n "$pr_number" ]] || die "No open PR found for branch: ${branch}"
  fi

  log_step "PR: #${pr_number}"
  require_pr_open_and_ready "$pr_number"
  require_pr_has_summary_and_test_plan "$pr_number"

  if [[ "$no_wait" -eq 1 ]]; then
    log_step "Skipping CI wait (--no-wait)"
    return 0
  fi

  log_step "Waiting for CI to pass…"
  wait_for_ci_success "$pr_number"
  log_step "CI passed"
}

main "$@"

