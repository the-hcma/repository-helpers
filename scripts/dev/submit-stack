#!/usr/bin/env bash
# scripts/dev/submit-stack — Run pre-pr-checks, then gt submit (published).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/submit-stack [GT_SUBMIT_ARGS...]

Runs scripts/dev/pre-pr-checks, then scripts/dev/ensure-submit-clean-tree, then:
  gt submit --publish --no-interactive [GT_SUBMIT_ARGS...]

Then asserts the created PR is open, not draft, and has Summary/Test plan headings.

Run from the feature worktree branch you are submitting. All extra arguments are
passed through to gt submit.
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

main() {
  case "${1:-}" in
    --help|-h)
      usage
      exit 0
      ;;
  esac

  command -v gt >/dev/null 2>&1 || die "gt (Graphite CLI) not found on PATH"

  "${script_dir}/pre-pr-checks"
  "${script_dir}/ensure-submit-clean-tree"
  gt submit --publish --no-interactive "$@"
  exec "${script_dir}/post-pr-submission-checks" --no-wait
}

main "$@"
