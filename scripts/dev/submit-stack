#!/usr/bin/env bash
# scripts/dev/submit-stack — Run pre-pr-checks, then gt submit (published).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/submit-stack [--no-wait-ci] [GT_SUBMIT_ARGS...]

Runs scripts/dev/pre-pr-checks, then scripts/dev/ensure-submit-clean-tree, then
Graphite submit with --publish --no-interactive [GT_SUBMIT_ARGS...]

Then runs scripts/dev/post-pr-submission-checks (waits for CI by default and
prints agent-actionable failure log excerpts when checks fail).

Run from the feature worktree branch you are submitting. All extra arguments are
passed through to gt submit.
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

no_wait_ci=0

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --no-wait-ci)
        no_wait_ci=1
        shift
        ;;
      *)
        gt_args+=("$1")
        shift
        ;;
    esac
  done
}

main() {
  local -a gt_args=()
  local -a post_args=()

  parse_args "$@"

  command -v gt >/dev/null 2>&1 || die "gt (Graphite CLI) not found on PATH"

  "${script_dir}/pre-pr-checks"
  "${script_dir}/ensure-submit-clean-tree"
  runner_exec "submit-stack gt submit" -- gt submit --publish --no-interactive "${gt_args[@]}"

  if [[ "$no_wait_ci" -eq 1 ]]; then
    post_args+=(--no-wait)
  fi
  exec "${script_dir}/post-pr-submission-checks" "${post_args[@]}"
}

main "$@"
