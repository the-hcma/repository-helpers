#!/usr/bin/env bash
# scripts/dev/submit-stack — Run pre-pr-checks, then submit via stacking-tool marker.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "${script_dir}/../.." && pwd)"
readonly repo_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/../lib/stacking-tool"

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/submit-stack [--no-wait-ci] [SUBMIT_EXTRA_ARGS...]

Runs scripts/dev/pre-pr-checks, then scripts/dev/ensure-submit-clean-tree, then
submits the current stack using .github/stacking-tool:

  graphite  → gt submit --publish --no-interactive [SUBMIT_EXTRA_ARGS...]
  gh-stack  → gh stack submit --auto --open --remote origin

Then runs scripts/dev/post-pr-submission-checks (waits for CI by default and
prints agent-actionable failure log excerpts when checks fail).

Run from the feature worktree branch you are submitting. Extra arguments are
passed through to gt submit when the marker is graphite (ignored for gh-stack).
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

no_wait_ci=0

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --no-wait-ci)
        no_wait_ci=1
        shift
        ;;
      *)
        submit_args+=("$1")
        shift
        ;;
    esac
  done
}

main() {
  local -a submit_args=()
  local -a post_args=()
  local tool

  parse_args "$@"

  tool="$(stacking_tool_read "$repo_dir")"
  stacking_tool_require_cli "$tool"

  "${script_dir}/pre-pr-checks"
  "${script_dir}/ensure-submit-clean-tree"
  stacking_tool_submit "$repo_dir" "${submit_args[@]}"

  if [[ "$no_wait_ci" -eq 1 ]]; then
    post_args+=(--no-wait)
  fi
  exec "${script_dir}/post-pr-submission-checks" "${post_args[@]}"
}

main "$@"
