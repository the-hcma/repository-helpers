#!/usr/bin/env bash
# scripts/dev/start-development - Session initialization and worktree management
set -euo pipefail

# Use the caller's git root to identify the repo, not the script's own location —
# so the script works correctly when called from any repo or subdirectory.
# Resolve the worktree root first (handles being inside a subdirectory), then find
# the primary worktree from there.
this_worktree="$(git -C "$PWD" rev-parse --show-toplevel)"
readonly this_worktree
# Use the primary worktree path, not --show-toplevel which returns the *current*
# worktree root when invoked from inside a linked worktree.
main_repo="$(git -C "$this_worktree" worktree list --porcelain | awk 'NR==1{print $2}')"
readonly main_repo
readonly worktrees_dir="$main_repo/.worktrees"
# Derive repo slug (owner/name) and service name from git remote — no hardcoding.
gh_repo="$(git -C "$main_repo" remote get-url origin | sed 's|.*github.com[:/]||;s|\.git$||')"
readonly gh_repo
service_name="${gh_repo##*/}"
readonly service_name
service_unit="${HOME}/.config/systemd/user/${service_name}.service"
readonly service_unit

# Populated after CLI parsing, before any worktree or GitHub side effects.
timeout_cmd=""

# gh_pr_info <branch>
# Queries GitHub for the PR state/number of a branch, retrying up to 3 times on
# transient failures. Prints either:
#   NOT_FOUND
# or:
#   <STATE> <NUMBER>
# Where STATE is OPEN, MERGED, CLOSED.
# Warnings for retry attempts are written to stderr so callers can capture stdout cleanly.
gh_pr_info() {
  local -r branch="$1"
  local attempt
  local result
  for attempt in 1 2 3; do
    # Include mergedAt: the state field can lag behind (GitHub API cache),
    # but mergedAt is set atomically and never reverts. Promote to MERGED if set.
    if result=$("$timeout_cmd" 15 gh --repo "$gh_repo" pr list --head "$branch" --state all \
        --json number,state,mergedAt \
        --jq 'if length > 0 then (.[0] | if .mergedAt != "" and .mergedAt != null then "MERGED \(.number)" else "\(.state) \(.number)" end) else "NOT_FOUND" end' \
        2>/dev/null); then
      echo "$result"
      return 0
    fi
    if [[ "$attempt" -lt 3 ]]; then
      echo "   [~] gh API call failed (attempt $attempt/3); retrying..." >&2
    fi
  done
  echo "   [~] gh API call failed after 3 attempts; treating as NOT_FOUND." >&2
  echo "NOT_FOUND"
}

# resolve_pr_state_for_branch <branch>
# Prints the same format as gh_pr_info: NOT_FOUND | <STATE> <NUMBER>.
# Graphite is authoritative for merge/close: gt info --branch reflects merged stacks
# immediately, while GitHub's REST view can still list the PR as OPEN until caches catch up.
resolve_pr_state_for_branch() {
  local -r branch="$1"
  local gt_out first_line pr_from_gt gh_line gh_num

  if [[ "${START_DEV_SKIP_GRAPHITE:-0}" == '1' ]]; then
    gh_pr_info "$branch"
    return 0
  fi

  if ! command -v gt >/dev/null 2>&1; then
    gh_pr_info "$branch"
    return 0
  fi

  gt_out=""
  if gt_out="$(cd "$main_repo" && "$timeout_cmd" 25 gt info --branch "$branch" --no-interactive 2>/dev/null)"; then
    :
  else
    gt_out=""
  fi
  first_line="$(printf '%s\n' "$gt_out" | head -1)"

  if printf '%s' "$first_line" | grep -qiE ' \(merged\)$' \
    || printf '%s\n' "$gt_out" | head -25 | grep -qE 'PR #[0-9]+ \(Merged\)'; then
    pr_from_gt=""
    pr_from_gt="$(printf '%s\n' "$gt_out" | grep -oiE 'PR #[0-9]+' | head -1 | sed 's/^PR #//')"
    if [[ -z "$pr_from_gt" ]]; then
      gh_line="$(gh_pr_info "$branch")"
      if [[ "$gh_line" != "NOT_FOUND" ]]; then
        read -r _gh_state gh_num <<< "$gh_line"
        pr_from_gt="$gh_num"
      fi
    fi
    if [[ -n "$pr_from_gt" ]]; then
      printf 'MERGED %s\n' "$pr_from_gt"
    else
      printf 'MERGED\n'
    fi
    return 0
  fi

  if printf '%s\n' "$gt_out" | head -25 | grep -qE 'PR #[0-9]+ \(Closed\)'; then
    pr_from_gt=""
    pr_from_gt="$(printf '%s\n' "$gt_out" | grep -oiE 'PR #[0-9]+' | head -1 | sed 's/^PR #//')"
    if [[ -z "$pr_from_gt" ]]; then
      gh_line="$(gh_pr_info "$branch")"
      if [[ "$gh_line" != "NOT_FOUND" ]]; then
        read -r _gh_state gh_num <<< "$gh_line"
        pr_from_gt="$gh_num"
      fi
    fi
    if [[ -n "$pr_from_gt" ]]; then
      printf 'CLOSED %s\n' "$pr_from_gt"
    else
      printf 'CLOSED\n'
    fi
    return 0
  fi

  gh_pr_info "$branch"
}

# print_pr_urls_github_graphite <pr_number>
# Emits clickable GitHub + Graphite URLs for an open PR (same shape as the Graphite app).
print_pr_urls_github_graphite() {
  local -r num="$1"
  [[ -z "$num" ]] && return 0
  printf '   GitHub:   https://github.com/%s/pull/%s\n' "$gh_repo" "$num"
  printf '   Graphite: https://app.graphite.com/github/pr/%s/%s\n' "$gh_repo" "$num"
}

# secondary_worktree_head_epoch <worktree_path>
# Best-effort Unix time of HEAD in the worktree (fallback: directory mtime).
secondary_worktree_head_epoch() {
  local -r path="$1"
  local ts
  ts="$(git -C "$path" log -1 --format=%ct HEAD 2>/dev/null || true)"
  if [[ -n "$ts" ]]; then
    printf '%s' "$ts"
    return 0
  fi
  stat -c %Y "$path" 2>/dev/null || printf '0'
}

# worktree_has_dirty_tree <worktree_path>
# Exit 0 when there is any local change (tracked or untracked) — caller must not auto-delete.
worktree_has_dirty_tree() {
  local -r path="$1"
  local st
  st="$(git -C "$path" status --porcelain 2>/dev/null || true)"
  [[ -n "$st" ]]
}

# remove_secondary_worktree <main_repo> <path> <branch> <human_reason_one_line>
remove_secondary_worktree() {
  local -r repo="$1"
  local -r path="$2"
  local -r branch="$3"
  local -r reason="$4"
  printf '   [!] %s\n' "$reason"
  git -C "$repo" worktree remove --force "$path" 2>/dev/null || true
  rm -rf "$path" 2>/dev/null \
    || echo "   [~] Could not fully remove '$path' (files may be busy); continuing."
  git -C "$repo" worktree prune
  git -C "$repo" branch -D "$branch" 2>/dev/null || true
}

# handle_secondary_worktree <mode> <current_path> <current_branch>
# mode=full  — initial scan: merged/closed removal, stale no-PR removal, OPEN URLs, pending list.
# mode=post_sync_merged_only — after gt sync: remove merged/closed secondaries (Graphite-first).
handle_secondary_worktree() {
  local -r mode="$1"
  local -r current_path="$2"
  local -r current_branch="$3"

  local pr_info pr_state pr_number pr_label
  local head_epoch now age stale_threshold

  if [[ "$mode" != 'post_sync_merged_only' ]]; then
    printf ' - Checking worktree: %s (%s)...\n' "$current_branch" "$current_path"
    if command -v gt >/dev/null 2>&1; then
      printf '   Querying Graphite: gt info --branch '\''%s'\''\n' "$current_branch"
    fi
    printf '   Querying GitHub: gh pr list --head '\''%s'\'' --state all\n' "$current_branch"
  fi

  pr_info="$(resolve_pr_state_for_branch "$current_branch")"
  pr_state="$pr_info"
  pr_number=""
  if [[ "$pr_info" != "NOT_FOUND" ]]; then
    read -r pr_state pr_number <<< "$pr_info"
  fi
  pr_label="$pr_state"
  if [[ -n "$pr_number" ]]; then
    pr_label="${pr_label} (#${pr_number})"
  fi

  if [[ "$mode" == 'post_sync_merged_only' ]]; then
    if [[ "$pr_state" != "MERGED" && "$pr_state" != "CLOSED" ]]; then
      return 0
    fi
    printf ' - Post-sync: %s (%s) — PR %s (merged per Graphite); removing worktree…\n' \
      "$current_branch" "$current_path" "$pr_label"
    if [[ "$current_path" == "$this_worktree" ]]; then
      printf '   [~] This is the running worktree; skipping removal.\n'
      return 0
    fi
    remove_secondary_worktree "$main_repo" "$current_path" "$current_branch" \
      "PR is ${pr_label} (Graphite merged). Removing worktree after Graphite sync…"
    return 0
  fi

  if [[ "$pr_state" == "MERGED" || "$pr_state" == "CLOSED" ]]; then
    printf '   PR status: %s (Graphite gt info when available; else GitHub mergedAt)\n' "$pr_label"
    if [[ -n "$pr_number" ]]; then
      printf '   GitHub:   https://github.com/%s/pull/%s\n' "$gh_repo" "$pr_number"
    fi
    if [[ "$current_path" == "$this_worktree" ]]; then
      echo "   [~] This is the running worktree; skipping removal."
      pending_worktrees+=("$current_path|$current_branch")
      return 0
    fi
    remove_secondary_worktree "$main_repo" "$current_path" "$current_branch" \
      "PR is ${pr_label}. Removing worktree…"
    return 0
  fi

  if [[ "$pr_state" == "OPEN" ]]; then
    printf '   [+] PR is %s. Keeping worktree.\n' "$pr_label"
    print_pr_urls_github_graphite "$pr_number"
    pending_worktrees+=("$current_path|$current_branch")
    return 0
  fi

  # NOT_FOUND (or unexpected empty): optional stale cleanup, else keep.
  if [[ "$pr_state" == "NOT_FOUND" ]]; then
    if ! worktree_has_dirty_tree "$current_path"; then
      head_epoch="$(secondary_worktree_head_epoch "$current_path")"
      now="$(date +%s)"
      stale_threshold=$(( 12 * 60 * 60 ))
      if [[ "$head_epoch" =~ ^[0-9]+$ ]] && (( head_epoch > 0 )) \
        && (( now - head_epoch >= stale_threshold )); then
        if [[ "$current_path" == "$this_worktree" ]]; then
          printf '   [~] No PR and worktree is stale, but this is the running worktree; skipping removal.\n'
          pending_worktrees+=("$current_path|$current_branch")
          return 0
        fi
        age=$(( now - head_epoch ))
        remove_secondary_worktree "$main_repo" "$current_path" "$current_branch" \
          "No PR for branch; last HEAD activity was ${age}s ago (>= ${stale_threshold}s). Removing stale worktree…"
        return 0
      fi
    fi
  fi

  printf '   [+] PR is %s. Keeping worktree.\n' "$pr_label"
  pending_worktrees+=("$current_path|$current_branch")
}

# Parse arguments
resume=false
refresh=false
no_interactive=false
worktree_name=""

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --help)
            echo "Usage: scripts/dev/start-development [--help] [--refresh] [--resume] [--no-interactive] [--worktree <name>]"
            echo ""
            echo "Options:"
            echo "  --help           Show this help message"
            echo "  --no-interactive Fail instead of prompting for input"
            echo "  --refresh        Pull latest main; run setup-service (for on-deploy + restart), or start service if setup-service is absent"
            echo "  --resume         Resume an existing in-progress worktree (or create a new one)"
            echo "  --worktree <n>   Non-interactive: create/use stack name <n> (creates branch '<n>-wt' at '.worktrees/<n>-wt')"
            echo ""
            echo "Examples:"
            echo "  scripts/dev/start-development --worktree auth-bugfix --no-interactive"
            echo "  scripts/dev/start-development --refresh"
            exit 0
            ;;
        --refresh)
            refresh=true
            shift
            ;;
        --resume)
            resume=true
            shift
            ;;
        --no-interactive)
            no_interactive=true
            shift
            ;;
        --worktree|--name)
            if [[ "$#" -lt 2 ]]; then
                echo "Missing value for $1" >&2
                exit 2
            fi
            worktree_name="$2"
            shift 2
            ;;
        --worktree=*|--name=*)
            worktree_name="${1#*=}"
            shift
            ;;
        *)
            echo "Unknown argument: $1" >&2
            echo "Run 'scripts/dev/start-development --help' for usage." >&2
            exit 1
            ;;
    esac
done

# In --no-interactive mode, never prompt. If a new worktree name is required but
# missing, fail fast before running any networked / side-effectful operations.
if [[ "$no_interactive" == "true" && "$refresh" == "false" && -z "$worktree_name" ]]; then
    echo "No stack name provided (--worktree <name>). Exiting due to --no-interactive." >&2
    exit 2
fi

if command -v timeout >/dev/null 2>&1; then
    timeout_cmd="$(command -v timeout)"
elif command -v gtimeout >/dev/null 2>&1; then
    timeout_cmd="$(command -v gtimeout)"
else
    printf '%s\n' "ERROR: Missing prerequisite: neither timeout(1) nor gtimeout(1) on PATH (install GNU coreutils)." >&2
    exit 2
fi
readonly timeout_cmd

if ! command -v gh >/dev/null 2>&1; then
    printf '%s\n' "ERROR: Missing prerequisite: gh (GitHub CLI) is not on PATH." >&2
    printf '%s\n' "Install from https://cli.github.com/ and retry." >&2
    exit 2
fi

echo "=========================================="
echo "   $service_name Session Initialization   "
echo "=========================================="

# 1. Clean up stale worktree metadata
echo "Pruning stale worktree metadata..."
git -C "$main_repo" worktree prune

# 2. Check each worktree: remove merged/closed, collect pending ones
echo "Checking for Git worktrees..."

wt_info=$(git -C "$main_repo" worktree list --porcelain)
current_path=""
current_branch=""
pending_worktrees=()

while IFS= read -r line; do
    if [[ "$line" =~ ^worktree\ (.*) ]]; then
        current_path="${BASH_REMATCH[1]}"
        current_branch=""
    elif [[ "$line" =~ ^branch\ refs/heads/(.*) ]]; then
        current_branch="${BASH_REMATCH[1]}"

        if [[ "$current_path" == "$main_repo" ]]; then
            continue
        fi

        handle_secondary_worktree "full" "$current_path" "$current_branch"
    fi
done <<< "$wt_info"

# 3. Synchronize Graphite and prune merged branches
echo "Synchronizing Graphite (gt sync --force --quiet)..."

# Only stash *tracked* changes (ignore untracked files like .vscode/ or .worktrees/
# which cannot be stashed without --include-untracked and would cause stash pop to fail).
has_changes=$(git -C "$main_repo" status --porcelain | grep -v '^??' || true)
stashed=false
if [[ -n "$has_changes" ]]; then
    echo "Stashing local changes in main repo..."
    git -C "$main_repo" stash push --message "start-development: automatic stash before sync"
    stashed=true
fi

set +e
(cd "$main_repo" && gt sync --quiet --force)
gt_sync_exit=$?
set -e
if [[ "$gt_sync_exit" -ne 0 ]]; then
  printf '   [~] gt sync exited with code %s (often: Graphite deletes a branch that git already removed). Continuing with post-sync cleanup.\n' \
    "$gt_sync_exit" >&2
fi
echo "Graphite sync complete."

if [[ "$stashed" == "true" ]]; then
    echo "Restoring local changes in main repo..."
    git -C "$main_repo" stash pop
fi

# 3a. Re-check worktrees after Graphite sync (Graphite-first merged/closed cleanup).
echo "Re-checking worktrees after Graphite sync (merged or closed PRs)..."
wt_info_post=""
wt_info_post="$(git -C "$main_repo" worktree list --porcelain)"
current_path=""
current_branch=""
while IFS= read -r line; do
    if [[ "$line" =~ ^worktree\ (.*) ]]; then
        current_path="${BASH_REMATCH[1]}"
        current_branch=""
    elif [[ "$line" =~ ^branch\ refs/heads/(.*) ]]; then
        current_branch="${BASH_REMATCH[1]}"
        if [[ "$current_path" == "$main_repo" ]]; then
            continue
        fi
        handle_secondary_worktree "post_sync_merged_only" "$current_path" "$current_branch"
    fi
done <<< "$wt_info_post"

# Rebuild pending worktrees from the live worktree list (removals above shrink the set).
pending_worktrees=()
wt_info_pending=""
wt_info_pending="$(git -C "$main_repo" worktree list --porcelain)"
current_path=""
current_branch=""
while IFS= read -r line; do
    if [[ "$line" =~ ^worktree\ (.*) ]]; then
        current_path="${BASH_REMATCH[1]}"
        current_branch=""
    elif [[ "$line" =~ ^branch\ refs/heads/(.*) ]]; then
        current_branch="${BASH_REMATCH[1]}"
        if [[ "$current_path" == "$main_repo" ]]; then
            continue
        fi
        pending_worktrees+=("$current_path|$current_branch")
    fi
done <<< "$wt_info_pending"

# 3b. Prune orphaned local branches:
#   - PR is MERGED/CLOSED (remote branch still exists), OR
#   - No PR found but branch is fully merged into main (remote branch already deleted)
echo "Pruning orphaned local branches..."

active_branches=()
while IFS= read -r wt_line; do
    if [[ "$wt_line" =~ ^branch\ refs/heads/(.*) ]]; then
        active_branches+=("${BASH_REMATCH[1]}")
    fi
done <<< "$(git -C "$main_repo" worktree list --porcelain)"

while IFS= read -r branch; do
    [[ "$branch" == "main" ]] && continue
    in_worktree=false
    for ab in "${active_branches[@]}"; do
        [[ "$ab" == "$branch" ]] && in_worktree=true && break
    done
    [[ "$in_worktree" == "true" ]] && continue

    echo " - Checking branch: $branch..."
    if command -v gt >/dev/null 2>&1; then
      echo "   Querying Graphite: gt info --branch '$branch'"
    fi
    echo "   Querying GitHub: gh pr list --head '$branch' --state all"
    orphan_info="$(resolve_pr_state_for_branch "$branch")"
    orphan_state="$orphan_info"
    orphan_number=""
    if [[ "$orphan_info" != "NOT_FOUND" ]]; then
        read -r orphan_state orphan_number <<< "$orphan_info"
    fi
    orphan_label="$orphan_state"
    if [[ -n "$orphan_number" ]]; then
        orphan_label="${orphan_label} (#${orphan_number})"
    fi

    if [[ "$orphan_state" == "MERGED" || "$orphan_state" == "CLOSED" ]]; then
        echo "   [!] Deleting $branch (PR: $orphan_label)..."
        git -C "$main_repo" branch -D "$branch" 2>/dev/null || true
    elif [[ "$orphan_state" == "NOT_FOUND" ]]; then
        # dep-updates/* branches are always machine-generated and always paired with
        # a PR. If no PR exists, the branch is stale (e.g. an interrupted dep-updater
        # run). dep-updater creates a fresh timestamped branch on its next run, so
        # there is nothing here to preserve.
        if [[ "$branch" == dep-updates/* ]]; then
            echo "   [!] Deleting $branch (machine-generated dep-updates branch, no PR)..."
            git -C "$main_repo" branch -D "$branch" 2>/dev/null || true
        # Remote branch gone; check if it's fully merged into main locally
        elif git -C "$main_repo" branch --merged main | grep -qxF "  $branch"; then
            echo "   [!] Deleting $branch (merged into main, no remote PR)..."
            git -C "$main_repo" branch -D "$branch" 2>/dev/null || true
        else
            echo "   [+] Keeping $branch (unmerged, no remote PR)."
        fi
    else
        echo "   [+] Keeping $branch (PR: $orphan_state)."
    fi
done <<< "$(git -C "$main_repo" branch --format='%(refname:short)')"

# Update main if behind origin and restart service if updated
git -C "$main_repo" fetch origin main >/dev/null 2>&1 || true
local_main=$(git -C "$main_repo" rev-parse main)
remote_main=$(git -C "$main_repo" rev-parse origin/main)
if [[ "$local_main" != "$remote_main" ]]; then
    echo "Main is outdated. Pulling latest..."
    git -C "$main_repo" merge --ff-only origin/main
fi

echo "=========================================="

# --refresh mode: run setup-service (which runs on-deploy, handles build steps and restart),
# or fall back to a direct start if setup-service is not available.
# Cleanup (worktree/branch pruning, Graphite sync, main pull) has already run above.
#
# setup-service lives in the repository-helpers scripts/ directory (one level above this
# script), not in the target repo.  Resolve it via BASH_SOURCE[0] so the correct binary
# is used regardless of which repo start-development is called from.
if [[ "$refresh" == "true" ]]; then
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    readonly script_dir
    setup_service="${script_dir}/../setup-service"
    if [[ -x "$setup_service" ]]; then
        echo "Running setup-service to apply any updates..."
        "$setup_service"
    elif [[ ! -f "$service_unit" ]]; then
        echo "No service unit and no setup-service found; skipping service setup."
    else
        systemctl --user daemon-reload
        if ! systemctl --user is-active --quiet "$service_name"; then
            echo "Starting $service_name service..."
            systemctl --user start "$service_name"
        fi
    fi
    exit 0
fi

# 4. Determine which worktree to work in
num_pending=${#pending_worktrees[@]}
selected_path=""

if [[ "$resume" == "true" && "$num_pending" -gt 0 ]]; then
    if [[ "$num_pending" -eq 1 ]]; then
        wt_path="${pending_worktrees[0]%%|*}"
        wt_branch="${pending_worktrees[0]##*|}"
        echo "Found 1 pending worktree: $wt_branch"
        read -rp "Resume this worktree? [Y/n] " choice
        if [[ "${choice,,}" != "n" ]]; then
            selected_path="$wt_path"
        fi
    else
        echo "Found $num_pending pending worktrees:"
        for i in "${!pending_worktrees[@]}"; do
            echo "  $((i+1))) ${pending_worktrees[$i]##*|}  (${pending_worktrees[$i]%%|*})"
        done
        echo "  $((num_pending+1))) Start new work"
        echo ""
        read -rp "Choose [1-$((num_pending+1))]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le "$num_pending" ]]; then
            idx=$((choice - 1))
            selected_path="${pending_worktrees[$idx]%%|*}"
        fi
        # If user chose "new" or entered invalid input, fall through to creation below
    fi
elif [[ "$resume" == "true" && "$num_pending" -eq 0 ]]; then
    echo "No pending worktrees found. Creating a new one..."
fi

# Create a new worktree if nothing was selected (default mode, or user chose new work)
if [[ -z "$selected_path" ]]; then
    echo ""
    if [[ -n "$worktree_name" ]]; then
        stack_name="$worktree_name"
        echo "New stack name: $stack_name"
    elif [[ "$no_interactive" == "true" ]]; then
        # Should have been caught by the early --no-interactive guard above, but keep as a
        # defensive fallback in case future refactors change control flow.
        echo "No stack name provided (--worktree <name>). Exiting due to --no-interactive." >&2
        exit 2
    else
        read -rp "New stack name (e.g. 'auth-bugfix'): " stack_name
    fi

    if [[ -z "$stack_name" ]]; then
        echo "No stack name provided. Exiting." >&2
        exit 1
    fi

    if [[ "$stack_name" =~ [[:space:]] ]]; then
        echo "Invalid stack name '$stack_name': whitespace is not allowed." >&2
        exit 2
    fi
    if [[ "$stack_name" == *"/"* ]]; then
        echo "Invalid stack name '$stack_name': '/' is not allowed." >&2
        exit 2
    fi

    selected_path="$worktrees_dir/${stack_name}-wt"
    branch_name="${stack_name}-wt"

    echo ""
    echo "Creating worktree '$branch_name' at $selected_path..."
    # Validate against existing worktrees (even if the directory was deleted manually, Git may
    # still consider it registered until pruned/removed).
    existing_worktree_path="$(
        git -C "$main_repo" worktree list --porcelain \
            | awk -v b="refs/heads/$branch_name" '
                $1 == "worktree" { wt=$2 }
                $1 == "branch" && $2 == b { print wt; exit }
              '
    )"
    if [[ -n "$existing_worktree_path" ]]; then
        echo "Worktree branch already in use: $branch_name" >&2
        echo "Existing worktree path: $existing_worktree_path" >&2
        echo "Choose a different name, or remove the existing worktree first." >&2
        exit 2
    fi
    if git -C "$main_repo" worktree list --porcelain | awk -v p="$selected_path" '$1=="worktree" && $2==p { found=1 } END { exit found?0:1 }'; then
        echo "Worktree path already registered with git: $selected_path" >&2
        echo "Choose a different name, or remove/prune the existing worktree first." >&2
        exit 2
    fi
    if [[ -e "$selected_path" ]]; then
        echo "Worktree path already exists: $selected_path" >&2
        echo "Choose a different name, or remove the directory/worktree first." >&2
        exit 2
    fi
    if git -C "$main_repo" show-ref --verify --quiet "refs/heads/$branch_name"; then
        echo "Branch already exists: $branch_name" >&2
        echo "Choose a different name, or delete the branch/worktree first." >&2
        exit 2
    fi
    git -C "$main_repo" worktree add -b "$branch_name" "$selected_path" main
    (cd "$selected_path" && gt track --parent main)

    echo ""
    echo "Start your first branch with:"
    echo "  gt create $stack_name/<description> -m 'feat: ...'"
    echo "  gt track --parent main   # reparent directly to main (required for gt submit)"
fi

echo ""
echo "To work on this stack, run:"
echo "  cd $selected_path"
echo "=========================================="
echo "Tip: Use 'gt state' to debug Graphite metadata issues."
echo "    Initialization Complete               "
echo "=========================================="
