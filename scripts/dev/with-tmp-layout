#!/usr/bin/env bash
# with-tmp-layout — run a command with its temp files under $TMPDIR/<project>/<branch>/<tool> (#832).
#
# Test tools (the default) have their run directory removed after a passing run and kept after a failing one.
# Package-manager caches (uv, pnpm) use the same layout but are never removed on success, because that
# would throw the cache away; the 3-day stale sweep (TMP_LAYOUT_RETENTION_DAYS) reclaims them.
# Known tools get their environment set: pytest (PYTEST_ADDOPTS --basetemp), uv (UV_CACHE_DIR) and pnpm
# (npm_config_store_dir). Every tool sees TMP_LAYOUT_DIR.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck disable=SC1091  # runner-bootstrap is a sibling lib resolved at runtime
source "${script_dir}/../lib/runner-bootstrap"
# shellcheck disable=SC1091  # tmp-layout is a sibling lib resolved at runtime
source "${script_dir}/../lib/tmp-layout"

usage() {
  cat <<'USAGE'
Usage: scripts/dev/with-tmp-layout [--dir PATH] [--keep] <tool> -- <command> [args...]

Run <command> with its temp files under $TMPDIR/<project>/<branch>/<tool>.

  --dir PATH   Repository whose project and branch name the directory (default: current directory).
  --keep       Keep the run directory after a passing run too (uv and pnpm caches are always kept).
  -h, --help   Show this help.

Tools: pytest, uv, pnpm get their environment set; any other name is a test tool that only gets
TMP_LAYOUT_DIR and TMPDIR. Every tool's TMPDIR points at a scratch directory inside the run. For a test tool it
lives in the run directory: removed with it after a passing run, kept after a failing one or with --keep.
For uv and pnpm it is removed right after the run, pass or fail, even with --keep (the cache is kept).
A nonempty UV_CACHE_DIR or npm_config_store_dir is kept, not replaced;
an empty or unset one uses the layout.
The command's exit status is returned. A TERM or INT sent to the wrapper itself is forwarded to the command as TERM, which
is waited for before the run directory is cleaned up (kept after a non-zero exit).

Note: pnpm asks to purge an existing node_modules when its store changes (an error without a TTY), so
run a project's pnpm commands consistently through the layout, or delete node_modules once.
USAGE
}

die_usage() {
  printf 'ERROR: %s\n' "$1" >&2
  usage >&2
  exit 2
}

main() {
  local dir='.' keep=0 cache=0 tool target run quoted sq rc=0 layout_root scratch child got_signal

  while (( $# > 0 )); do
    case "$1" in
      --dir)
        [[ $# -ge 2 && -d "$2" ]] || die_usage '--dir needs an existing directory'
        dir="$2"
        shift 2
        ;;
      --keep) keep=1; shift ;;
      -h | --help) usage; exit 0 ;;
      --) break ;;
      -*) die_usage "unknown argument: $1" ;;
      *) break ;;
    esac
  done
  (( $# >= 1 )) || die_usage 'a tool name is required'
  tool="$1"
  shift
  [[ "${1:-}" == -- ]] || die_usage 'expected -- before the command'
  shift
  (( $# >= 1 )) || die_usage 'a command is required'

  case "$tool" in
    pnpm) cache=1 ;;
    uv) cache=1 ;;
    *) ;;
  esac
  target="$(tmp_layout_prepare "$tool" "$dir")"
  # A test tool's run gets its own subdirectory, so concurrent runs on one branch never collide, even with
  # --keep; a package-manager cache is the shared tool directory itself, stamped on every use.
  run="$target"
  if (( cache == 0 )); then
    run="$(tmp_layout_run_dir "$target")"
  else
    tmp_layout_mark "$target"
  fi
  export TMP_LAYOUT_DIR="$run"
  # Tools that ask the OS for a temp directory (pyright, mktemp, node) follow TMPDIR, so point it inside the run.
  # A nested layout call keeps the real root through TMP_LAYOUT_TMPDIR instead of nesting under this one.
  layout_root="$(tmp_layout_tmpdir)"
  if (( cache == 0 )); then
    scratch="${run}/tmp"
    mkdir -p "$scratch"
  else
    # Marked, so an orphan (a kill -9, a timeout kill) is swept with the other stale run directories instead of
    # piling up inside the kept cache.
    scratch="$(tmp_layout_run_dir "$target")"
  fi
  export TMP_LAYOUT_TMPDIR="$layout_root"
  export TMPDIR="$scratch"
  case "$tool" in
    pytest)
      # pytest splits PYTEST_ADDOPTS with shlex, which knows single quotes but not bash's $'...' form (what
      # %q emits for non-ASCII bytes under the C locale), so single-quote the option by hand.
      quoted="--basetemp=${run}/basetemp"
      sq="'"
      quoted="${sq}${quoted//"$sq"/${sq}\"${sq}\"${sq}}${sq}"
      export PYTEST_ADDOPTS="${PYTEST_ADDOPTS:+${PYTEST_ADDOPTS} }${quoted}"
      ;;
    pnpm) export npm_config_store_dir="${npm_config_store_dir:-${run}/store}" ;;
    uv) export UV_CACHE_DIR="${UV_CACHE_DIR:-${run}/cache}" ;;
    *) ;;
  esac

  # Run the command as a child we can signal: a TERM or INT that reaches only this wrapper (a timeout that does
  # not signal the whole process group, say) is forwarded to it, and we still wait for it and clean up below
  # (repository-helpers#837). The traps come first, and a signal that lands before the child exists is replayed
  # once it does. A background job of a non-interactive shell starts with INT ignored, so INT is forwarded as TERM.
  # stdin stays the caller's (a background job would otherwise read /dev/null).
  child=''
  got_signal=0
  on_signal() {
    got_signal=1
    if [[ -n "$child" ]]; then
      kill -s TERM "$child" 2>/dev/null || true
    fi
  }
  trap on_signal TERM INT
  "$@" <&0 &
  child=$!
  if (( got_signal == 1 )); then
    kill -s TERM "$child" 2>/dev/null || true
  fi
  wait "$child" || rc=$?
  # A trapped signal interrupts wait with a status above 128 while the child may still be running: wait again
  # and take the status of that final wait, which is the child's own.
  while kill -0 "$child" 2>/dev/null; do
    rc=0
    wait "$child" || rc=$?
  done
  trap - TERM INT
  if (( keep == 0 && cache == 0 )); then
    tmp_layout_finish "$run" "$rc" || true
  elif (( cache == 1 )); then
    # A cache is kept, but this run's scratch directory is not (even after a failing run).
    rm -rf -- "$scratch"
  fi
  return "$rc"
}

main "$@"
