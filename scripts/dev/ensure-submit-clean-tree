#!/usr/bin/env bash
# scripts/dev/ensure-submit-clean-tree — Block stack submit when the worktree is dirty.
#
# pre-pr-checks lints the working tree; CI runs committed HEAD. Uncommitted fixes can
# pass locally while the push omits them. Call this immediately before stacking-tool
# submit (gt or gh stack).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/ensure-submit-clean-tree [--dir PATH]

Exits 0 when the target git worktree has no uncommitted changes (porcelain empty).
Exits 1 with a concise error when tracked or untracked changes remain.

Default directory is the current repository root (git rev-parse --show-toplevel).
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

main() {
  local repo_dir="${PWD}"
  local status exit_code

  case "${1:-}" in
    --help|-h)
      usage
      exit 0
      ;;
    --dir)
      [[ $# -ge 2 ]] || die '--dir requires a path'
      repo_dir="$2"
      shift 2
      ;;
  esac

  if [[ $# -gt 0 ]]; then
    die "Unknown argument: $1 (see --help)"
  fi

  exit_code=0
  repo_dir="$(runner_exec_stdout "ensure-submit-clean-tree git rev-parse toplevel" \
    -- git -C "$repo_dir" rev-parse --show-toplevel)" || exit_code=$?
  if (( exit_code != 0 )); then
    die "Not inside a git repository"
  fi
  repo_dir="${repo_dir//$'\n'/}"

  exit_code=0
  status="$(runner_exec_stdout "ensure-submit-clean-tree git status porcelain" \
    -- git -C "$repo_dir" status --porcelain)" || exit_code=$?
  if (( exit_code != 0 )); then
    die "Unable to determine working tree status for: ${repo_dir}"
  fi
  if [[ -n "$status" ]]; then
    printf 'ERROR: Working tree has uncommitted changes; commit or stash before submit:\n' >&2
    printf '%s\n' "$status" >&2
    exit 1
  fi
}

main "$@"
