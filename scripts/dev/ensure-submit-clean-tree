#!/usr/bin/env bash
# scripts/dev/ensure-submit-clean-tree — Block gt submit when the worktree is dirty.
#
# pre-pr-checks lints the working tree; CI runs committed HEAD. Uncommitted fixes can
# pass locally while the push omits them. Call this immediately before gt submit.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/ensure-submit-clean-tree [--dir PATH]

Exits 0 when the target git worktree has no uncommitted changes (porcelain empty).
Exits 1 with a concise error when tracked or untracked changes remain.

Default directory is the current repository root (git rev-parse --show-toplevel).
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

main() {
  local repo_dir="${PWD}"
  local status

  case "${1:-}" in
    --help|-h)
      usage
      exit 0
      ;;
    --dir)
      [[ $# -ge 2 ]] || die '--dir requires a path'
      repo_dir="$2"
      shift 2
      ;;
  esac

  if [[ $# -gt 0 ]]; then
    die "Unknown argument: $1 (see --help)"
  fi

  if ! repo_dir="$(git -C "$repo_dir" rev-parse --show-toplevel 2>/dev/null)"; then
    die "Not inside a git repository"
  fi

  if ! status="$(git -C "$repo_dir" status --porcelain 2>/dev/null)"; then
    die "Unable to determine working tree status for: ${repo_dir}"
  fi
  if [[ -n "$status" ]]; then
    printf 'ERROR: Working tree has uncommitted changes; commit or stash before submit:\n' >&2
    printf '%s\n' "$status" >&2
    exit 1
  fi
}

main "$@"
