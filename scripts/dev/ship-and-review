#!/usr/bin/env bash
# scripts/dev/ship-and-review — Submit, wait for CI, run agent review loop (M2 dev glue).
#
# Usage:
#   scripts/dev/ship-and-review [--pr N] [--no-submit] [--no-agent-review] [--no-wait-ci] [GT_SUBMIT_ARGS...]
#
# Flow (unless skipped by flags):
#   1. scripts/dev/pre-pr-checks
#   2. scripts/dev/ensure-submit-clean-tree
#   3. gt submit --publish --no-interactive [GT_SUBMIT_ARGS...]
#   4. scripts/dev/post-pr-submission-checks [--pr N] [--no-wait]
#   5. scripts/wait-for-agent-review loop --pr N
#
# Use --no-submit when the PR already exists (CI + agent loop only).
# Use --no-agent-review for submit-stack-like behaviour with a CI wait.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "$script_dir/../.." && pwd)"
readonly repo_dir

pr_number=""
no_submit=0
no_agent_review=0
no_wait_ci=0
gt_args=()

usage() {
  sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

require_tools() {
  command -v gt >/dev/null 2>&1 || die 'gt (Graphite CLI) not found on PATH'
  command -v gh >/dev/null 2>&1 || die 'gh not found on PATH'
  command -v git >/dev/null 2>&1 || die 'git not found on PATH'
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --pr)
        [[ $# -ge 2 ]] || die '--pr requires a number'
        pr_number="$2"
        shift 2
        ;;
      --no-submit)
        no_submit=1
        shift
        ;;
      --no-agent-review)
        no_agent_review=1
        shift
        ;;
      --no-wait-ci)
        no_wait_ci=1
        shift
        ;;
      --)
        shift
        gt_args+=("$@")
        return 0
        ;;
      *)
        gt_args+=("$1")
        shift
        ;;
    esac
  done
}

discover_pr_number_for_branch() {
  local -r branch="$1"
  local out

  out="$(gh pr list --head "$branch" --state open --json number --jq '.[0].number // empty' 2>/dev/null || true)"
  if [[ -z "$out" ]]; then
    return 1
  fi
  printf '%s\n' "$out"
}

resolve_pr_number() {
  local branch

  if [[ -n "$pr_number" ]]; then
    return 0
  fi
  branch="$(git branch --show-current)"
  [[ -n "$branch" ]] || die 'Not on a branch (detached HEAD)'
  pr_number="$(discover_pr_number_for_branch "$branch" || true)"
  [[ -n "$pr_number" ]] || die "No open PR found for branch: ${branch} (pass --pr)"
}

main() {
  local post_args=()

  parse_args "$@"
  require_tools

  if [[ "$no_submit" -eq 0 ]]; then
    log_step 'Running pre-pr-checks'
    "${script_dir}/pre-pr-checks"
    log_step 'Ensuring clean worktree before submit'
    "${script_dir}/ensure-submit-clean-tree"
    log_step 'Submitting stack (gt submit --publish --no-interactive)'
    gt submit --publish --no-interactive "${gt_args[@]}"
  fi

  resolve_pr_number

  post_args=(--pr "$pr_number")
  if [[ "$no_wait_ci" -eq 1 ]]; then
    post_args+=(--no-wait)
  fi

  log_step "Post-submit checks for PR #${pr_number}"
  "${script_dir}/post-pr-submission-checks" "${post_args[@]}"

  if [[ "$no_agent_review" -eq 1 ]]; then
    log_step 'Skipping agent review loop (--no-agent-review)'
    return 0
  fi

  log_step "Agent review loop for PR #${pr_number}"
  "${repo_dir}/scripts/wait-for-agent-review" loop --pr "$pr_number"
}

main "$@"
