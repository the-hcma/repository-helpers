#!/usr/bin/env bash
# scripts/dev/ship-and-review — Submit, wait for CI, run agent review loop (M2 dev glue).
#
# Usage:
#   scripts/dev/ship-and-review [--pr N] [--no-submit] [--no-agent-review] [--no-wait-ci] [SUBMIT_EXTRA_ARGS...]
#
# Flow (unless skipped by flags):
#   1. scripts/dev/pre-pr-checks
#   2. scripts/dev/ensure-submit-clean-tree
#   3. stacking_tool_submit (gt or gh stack per .github/stacking-tool)
#   4. scripts/dev/post-pr-submission-checks [--pr N] [--no-wait]
#   5. scripts/wait-for-agent-review loop --pr N
#
# Use --no-submit when the PR already exists (CI + agent loop only).
# Use --no-agent-review for submit-stack-like behaviour with a CI wait.
#
# The target repo is resolved from the current working directory, not from this
# script's own location, so invoking it via an absolute path (e.g.
# ~/work/ai/repository-helpers/scripts/dev/ship-and-review from a different
# repo's worktree) still operates on the caller's repo.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# helpers_dir locates repository-helpers' own sibling scripts (e.g.
# scripts/wait-for-agent-review) — distinct from repo_dir, the target repo being
# shipped, which is resolved from the caller's cwd (see resolve_repo_dir, #590).
helpers_dir="$(cd "$script_dir/../.." && pwd)"
readonly helpers_dir
repo_dir=""

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"
# shellcheck disable=SC1091  # dev-worktree-guard is a sibling lib, not a package
source "${script_dir}/../lib/dev-worktree-guard"
# shellcheck disable=SC1091
source "${script_dir}/../lib/stacking-tool"

pr_number=""
no_submit=0
no_agent_review=0
no_wait_ci=0
submit_args=()

usage() {
  sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

on_exit() {
  if ! dev_assert_main_worktree_clean "$repo_dir"; then
    printf 'ERROR: Primary worktree must be clean at end of ship-and-review\n' >&2
    exit 1
  fi
}

# resolve_repo_dir — target repo being shipped, resolved from the caller's cwd,
# not this script's own BASH_SOURCE location, so invoking via an absolute path
# (e.g. ~/work/ai/repository-helpers/scripts/dev/ship-and-review from a different
# repo's worktree) still operates on the caller's repo (#590).
resolve_repo_dir() {
  repo_dir="$(dev_resolve_target_repo_dir 'ship-and-review')" || exit 1
  readonly repo_dir
}

require_tools() {
  local tool
  tool="$(stacking_tool_read "$repo_dir")"
  stacking_tool_require_cli "$tool"
  command -v gh >/dev/null 2>&1 || die 'gh not found on PATH'
  command -v git >/dev/null 2>&1 || die 'git not found on PATH'
}

assert_worktree_guards() {
  dev_assert_stack_worktree "$repo_dir" \
    || die 'ship-and-review must run from a stack worktree'
  dev_assert_main_worktree_clean "$repo_dir" \
    || die 'Primary worktree must be clean before ship-and-review'
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --pr)
        [[ $# -ge 2 ]] || die '--pr requires a number'
        pr_number="$2"
        shift 2
        ;;
      --no-submit)
        no_submit=1
        shift
        ;;
      --no-agent-review)
        no_agent_review=1
        shift
        ;;
      --no-wait-ci)
        no_wait_ci=1
        shift
        ;;
      --)
        shift
        submit_args+=("$@")
        return 0
        ;;
      *)
        submit_args+=("$1")
        shift
        ;;
    esac
  done
}

discover_pr_number_for_branch() {
  local -r branch="$1"
  local out exit_code

  exit_code=0
  out="$(runner_exec_stdout "ship-and-review gh pr list for branch" -- gh pr list --head "$branch" \
    --state open --json number --jq '.[0].number // empty')" || exit_code=$?
  if (( exit_code != 0 )) || [[ -z "$out" ]]; then
    return 1
  fi
  printf '%s\n' "$out"
}

resolve_pr_number() {
  local branch exit_code

  if [[ -n "$pr_number" ]]; then
    return 0
  fi
  exit_code=0
  branch="$(runner_exec_stdout "ship-and-review git branch show-current" \
    -- git -C "$repo_dir" branch --show-current)" || exit_code=$?
  if (( exit_code != 0 )); then
    branch=""
  fi
  [[ -n "$branch" ]] || die 'Not on a branch (detached HEAD)'
  pr_number="$(discover_pr_number_for_branch "$branch" || true)"
  [[ -n "$pr_number" ]] || die "No open PR found for branch: ${branch} (pass --pr)"
}

main() {
  local post_args=()
  local tool

  parse_args "$@"
  resolve_repo_dir
  require_tools
  trap on_exit EXIT
  assert_worktree_guards

  if [[ "$no_submit" -eq 0 ]]; then
    tool="$(stacking_tool_read "$repo_dir")"
    log_step 'Running pre-pr-checks'
    "${script_dir}/pre-pr-checks"
    log_step 'Ensuring clean worktree before submit'
    "${script_dir}/ensure-submit-clean-tree"
    log_step "Submitting stack via stacking-tool (${tool})"
    stacking_tool_submit "$repo_dir" "${submit_args[@]}"
  fi

  resolve_pr_number

  post_args=(--pr "$pr_number")
  if [[ "$no_wait_ci" -eq 1 ]]; then
    post_args+=(--no-wait)
  fi

  log_step "Post-submit checks for PR #${pr_number}"
  "${script_dir}/post-pr-submission-checks" "${post_args[@]}"

  if [[ "$no_agent_review" -eq 1 ]]; then
    log_step 'Skipping agent review loop (--no-agent-review)'
    return 0
  fi

  log_step "Agent review loop for PR #${pr_number}"
  "${helpers_dir}/scripts/wait-for-agent-review" loop --pr "$pr_number"
}

main "$@"
