#!/usr/bin/env bash
# scripts/dev/pre-pr-checks — Run local CI checks before opening/submitting a PR.
#
# Detects project ecosystems first (filesystem only), then requires tools and
# runs only the planned jobs in parallel. Prefer repo CI wrappers / package
# scripts when present (see scripts/lib/pre-pr-ecosystem, issue #423).
#
# Requires a stack worktree (not the primary clone) and a clean primary worktree.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"

# Prefer GNU userland (sed/grep/date/timeout) on macOS before any checks run.
# shellcheck disable=SC1091
source "${script_dir}/../lib/tooling-path"
tooling_path_ensure_gnu_userland \
  || die "GNU userland tools required on macOS (brew install coreutils gnu-sed grep util-linux)"

# shellcheck disable=SC1091  # dev-worktree-guard is a sibling lib, not a package
source "${script_dir}/../lib/dev-worktree-guard"

# shellcheck disable=SC1091
source "${script_dir}/../lib/pre-pr-ecosystem"

# Assigned by prec_detect_profile; initialize so shellcheck sees the assignment (SC2154).
prec_planned_jobs=()

main_repo=""
check_root=""
restore_done=0
prec_pr_jobs_dir=""
prec_pr_job_count=0
prec_pr_test_isolate_dir=""

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/pre-pr-checks

Run from a stack worktree (.worktrees/<stack>-wt) of the repository you are about
to submit. Exits non-zero if any check fails.

Detect-first: inspects the check-root for Python (pyproject.toml), TypeScript
(web/ or root pnpm), Rust (Cargo.toml), shell targets, workflows, and
tests/*.test — then requires tools and starts jobs only for detected ecosystems.

Jobs (parallel where independent; skip with PRE_PR_CHECKS_SKIP=job1,job2):
  - bash-n / shellcheck -S info — helpers-style (scripts/dev/pre-pr-checks) CI globs;
    or consumer `.github/ci/shellcheck` wrapper when present
  - actionlint — helpers-style, or when workflows already invoke actionlint
  - tests — bash tests/*.test when present (sequential, isolated TMPDIR)
  - python-static — .github/ci/python-static or uv ruff/pyright fallback
  - ts-web / ts-root — pnpm install + typecheck/build or check
  - cargo-fmt / cargo-clippy — rustfmt + clippy (-D warnings)

Also enforces:
  - Stack worktree (not the primary clone)
  - Primary worktree clean (empty git status --porcelain)

Before submit-stack / ship-and-review, run this script (or use scripts/dev/submit-stack).
Do not bypass a failing run unless using an explicit PRE_PR_CHECKS_SKIP escape hatch.
USAGE
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

resolve_repo_roots() {
  local start_dir="${1:-$PWD}"
  check_root="$(dwg_git_show_toplevel "$start_dir" || true)"
  check_root="${check_root//$'\n'/}"
  [[ -n "$check_root" ]] || die "Not inside a git repository (cwd: ${start_dir})"
  main_repo="$(dev_worktree_primary_path "$check_root")"
  [[ -n "$main_repo" ]] || die "Could not resolve primary worktree path"
}

on_exit() {
  verify_main_worktree_clean
  if [[ -n "$prec_pr_jobs_dir" && -d "$prec_pr_jobs_dir" ]]; then
    rm -rf "$prec_pr_jobs_dir"
  fi
}

verify_main_worktree_clean() {
  if [[ "$restore_done" == '1' ]]; then
    return 0
  fi
  restore_done=1

  if [[ -z "$main_repo" ]]; then
    return 0
  fi

  local after_checks exit_code

  exit_code=0
  runner_exec "git status porcelain primary after checks" -- git -C "$main_repo" status --porcelain \
    || exit_code=$?
  if (( exit_code != 0 )); then
    die "Could not verify primary worktree status for ${main_repo}"
  fi
  after_checks="$(dwg_runner_last_stdout)"
  if [[ -n "$after_checks" ]]; then
    die "Primary worktree ${main_repo} has unexpected changes after checks (scripts must not modify main)"
  fi
}

assert_worktree_guards() {
  dev_assert_stack_worktree "$check_root" \
    || die 'pre-pr-checks must run from a stack worktree (see --help)'
  dev_assert_main_worktree_clean "$check_root" \
    || die 'Primary worktree must be clean before pre-pr-checks'
  log_step "Check root: ${check_root} (primary: ${main_repo})"
  log_step 'Primary worktree is clean'
}

init_parallel_jobs() {
  prec_pr_jobs_dir="$(mktemp -d "${TMPDIR:-/tmp}/pre-pr-checks-jobs.XXXXXX")"
  prec_pr_test_isolate_dir="${prec_pr_jobs_dir}/test-isolate"
  mkdir -p "$prec_pr_test_isolate_dir"
}

# Run one check in the background; writes ${job_name}.log and ${job_name}.rc under prec_pr_jobs_dir.
start_parallel_job() {
  local job_name="$1"
  shift
  local log_file="${prec_pr_jobs_dir}/${job_name}.log"
  local rc_file="${prec_pr_jobs_dir}/${job_name}.rc"
  prec_pr_job_count=$(( prec_pr_job_count + 1 ))
  (
    set +e
    "$@" >"$log_file" 2>&1
    printf '%s\n' "$?" >"$rc_file"
  ) &
}

job_bash_n() {
  local -a files=()
  prec_collect_shell_files "$check_root" files
  [[ "${#files[@]}" -gt 0 ]] || return 0
  bash -n "${files[@]}"
}

job_shellcheck() {
  local -a files=()
  if [[ -f "${check_root}/.github/ci/shellcheck" ]]; then
    (
      cd "$check_root" || exit 1
      run_command "pre-pr shellcheck wrapper" bash .github/ci/shellcheck
    )
    return 0
  fi
  prec_collect_shell_files "$check_root" files
  [[ "${#files[@]}" -gt 0 ]] || return 0
  # Match .github/workflows/ci.yml severity (no suppressions) for helpers-style.
  shellcheck -S info "${files[@]}"
}

job_actionlint() {
  local -a files=()
  prec_collect_actionlint_files "$check_root" files
  if [[ "${#files[@]}" -eq 0 ]]; then
    return 0
  fi
  runner_exec "pre-pr-checks actionlint" -- actionlint "${files[@]}"
}

job_test_file() {
  local -r test_path="$1"
  local test_tmp rc

  test_tmp="$(mktemp -d "${prec_pr_test_isolate_dir}/job.XXXXXX")"
  rc=0
  (
    export TMPDIR="$test_tmp"
    unset RUNNER_SESSION_DIR RUNNER_SESSION_KEEP
    bash "$test_path"
  ) || rc=$?
  rm -rf "$test_tmp"
  return "$rc"
}

job_all_tests() {
  local t base rc

  shopt -s nullglob
  local -a tests=( "${check_root}"/tests/*.test )
  shopt -u nullglob
  if [[ "${#tests[@]}" -eq 0 ]]; then
    return 0
  fi
  for t in "${tests[@]}"; do
    base="$(basename "$t" .test)"
    rc=0
    job_test_file "$t" || rc=$?
    if (( rc != 0 )); then
      printf 'FAILED: test-%s (exit %s)\n' "$base" "$rc" >&2
      return "$rc"
    fi
  done
  return 0
}

start_planned_parallel_checks() {
  local job
  init_parallel_jobs

  for job in "${prec_planned_jobs[@]+"${prec_planned_jobs[@]}"}"; do
    case "$job" in
      bash-n) start_parallel_job 'bash-n' job_bash_n ;;
      shellcheck) start_parallel_job 'shellcheck' job_shellcheck ;;
      actionlint) start_parallel_job 'actionlint' job_actionlint ;;
      tests) start_parallel_job 'tests' job_all_tests ;;
      python-static) start_parallel_job 'python-static' prec_run_python_static "$check_root" ;;
      ts-web) start_parallel_job 'ts-web' prec_run_ts_web "$check_root" ;;
      ts-root) start_parallel_job 'ts-root' prec_run_ts_root "$check_root" ;;
      cargo-fmt) start_parallel_job 'cargo-fmt' prec_run_cargo_fmt "$check_root" ;;
      cargo-clippy) start_parallel_job 'cargo-clippy' prec_run_cargo_clippy "$check_root" ;;
      *)
        die "Unknown planned job: ${job}"
        ;;
    esac
  done

  if [[ "$prec_pr_job_count" -eq 0 ]]; then
    log_step 'No planned jobs (nothing to run)'
    return 0
  fi
  log_step "Running ${prec_pr_job_count} checks in parallel (tests sequential, isolated TMPDIR)…"
}

wait_parallel_checks() {
  local rc_file job_name rc failed=0 fail_count=0

  if [[ "$prec_pr_job_count" -eq 0 ]]; then
    return 0
  fi

  set +e
  wait
  set -e

  shopt -s nullglob
  for rc_file in "${prec_pr_jobs_dir}"/*.rc; do
    job_name="$(basename "$rc_file" .rc)"
    rc="$(<"$rc_file")"
    if [[ "$rc" -eq 0 ]]; then
      log_step "passed: ${job_name}"
    else
      failed=1
      fail_count=$(( fail_count + 1 ))
      log_step "FAILED: ${job_name} (exit ${rc})"
      cat "${prec_pr_jobs_dir}/${job_name}.log" >&2
    fi
  done
  shopt -u nullglob

  if [[ "$failed" == '1' ]]; then
    die "${fail_count} parallel check(s) failed (see logs above)"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

main() {
  parse_args "$@"
  trap on_exit EXIT

  resolve_repo_roots "$PWD"
  assert_worktree_guards

  prec_detect_profile "$check_root"
  log_step "detected: $(prec_format_detected) ; jobs: $(prec_format_planned_jobs)"

  prec_require_tools_for_planned
  start_planned_parallel_checks
  wait_parallel_checks

  log_step "pre-pr-checks passed"
}

main "$@"
