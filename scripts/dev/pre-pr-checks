#!/usr/bin/env bash
# scripts/dev/pre-pr-checks — Run local CI checks before opening/submitting a PR.
#
# Mirrors .github/workflows/ci.yml (bash -n, shellcheck -S info, all tests/*.test).
# Ensures the primary (main) worktree is unchanged when checks finish: stashes
# pre-existing dirt on main for the run, then restores it.
#
# Independent checks run in parallel to minimize wall-clock time.
set -euo pipefail

readonly STASH_MSG='pre-pr-checks: temporary stash (auto-restore)'

main_repo=""
check_root=""
main_status_before=""
did_stash=0
restore_done=0
prec_pr_jobs_dir=""
prec_pr_job_count=0

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/pre-pr-checks

Run from any directory inside a git worktree of the repository you are about to
submit. Exits non-zero if any check fails.

Checks (same as CI, run in parallel where independent):
  - Primary worktree cleanliness (stash/restore pre-existing local changes)
  - bash -n on scripts/*, scripts/dev/*, scripts/lib/*, tests/*, tests/lib/*
  - shellcheck -S info on the same paths
  - bash tests/*.test (every test harness must pass)

Before gt submit, run this script (or use scripts/dev/submit-stack).
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

resolve_repo_roots() {
  local start_dir="${1:-$PWD}"
  check_root="$(git -C "$start_dir" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$check_root" ]] || die "Not inside a git repository (cwd: ${start_dir})"
  main_repo="$(git -C "$check_root" worktree list --porcelain | awk 'NR==1{print $2}')"
  [[ -n "$main_repo" ]] || die "Could not resolve primary worktree path"
}

collect_check_files() {
  local repo_root="$1"
  local -n _out=$2
  local f
  _out=()
  for f in \
    "${repo_root}"/scripts/* \
    "${repo_root}"/scripts/dev/* \
    "${repo_root}"/scripts/lib/* \
    "${repo_root}"/tests/* \
    "${repo_root}"/tests/lib/*; do
    [[ -f "$f" ]] || continue
    _out+=("$f")
  done
  if [[ "${#_out[@]}" -eq 0 ]]; then
    die "No shell scripts found under ${repo_root}/scripts or tests"
  fi
}

on_exit() {
  restore_main_worktree
  if [[ -n "$prec_pr_jobs_dir" && -d "$prec_pr_jobs_dir" ]]; then
    rm -rf "$prec_pr_jobs_dir"
  fi
}

restore_main_worktree() {
  if [[ "$restore_done" == '1' ]]; then
    return 0
  fi
  restore_done=1

  if [[ -z "$main_repo" ]]; then
    return 0
  fi

  local after_checks
  after_checks="$(git -C "$main_repo" status --porcelain 2>/dev/null || true)"
  if [[ "$did_stash" != '1' && -n "$after_checks" ]]; then
    die "Primary worktree ${main_repo} has unexpected changes after checks (scripts must not modify main)"
  fi
  if [[ "$did_stash" == '1' && -n "$after_checks" ]]; then
    die "Primary worktree ${main_repo} is dirty after checks (expected clean while stash is active)"
  fi

  if [[ "$did_stash" == '1' ]]; then
    local top_msg
    top_msg="$(git -C "$main_repo" stash list -1 --format='%s' 2>/dev/null || true)"
    if [[ "$top_msg" != *"${STASH_MSG}"* ]]; then
      die "Top stash on primary worktree is not from pre-pr-checks; restore manually: ${main_repo}"
    fi
    if ! git -C "$main_repo" stash pop 2>/dev/null; then
      die "Failed to restore primary worktree stash in ${main_repo}"
    fi
  fi

  local final_status
  final_status="$(git -C "$main_repo" status --porcelain 2>/dev/null || true)"
  if [[ "$final_status" != "$main_status_before" ]]; then
    die "Primary worktree state changed during checks (before vs after mismatch)"
  fi
}

prepare_main_worktree() {
  main_status_before="$(git -C "$main_repo" status --porcelain 2>/dev/null || true)"
  if [[ -n "$main_status_before" ]]; then
    log_step "Primary worktree has local changes; stashing before checks"
    if ! git -C "$main_repo" stash push --include-untracked --message "$STASH_MSG" >/dev/null; then
      die "Failed to stash primary worktree in ${main_repo}"
    fi
    did_stash=1
    if [[ -n "$(git -C "$main_repo" status --porcelain 2>/dev/null || true)" ]]; then
      die "Primary worktree ${main_repo} is still dirty after stash"
    fi
  else
    log_step "Primary worktree is clean"
  fi
}

require_tools() {
  command -v shellcheck >/dev/null 2>&1 || die "shellcheck not found on PATH"
  command -v bash >/dev/null 2>&1 || die "bash not found on PATH"
  command -v rg >/dev/null 2>&1 || die "rg (ripgrep) not found on PATH (required by tests; see CI workflow)"
}

init_parallel_jobs() {
  prec_pr_jobs_dir="$(mktemp -d "${TMPDIR:-/tmp}/pre-pr-checks-jobs.XXXXXX")"
}

# Run one check in the background; writes ${job_name}.log and ${job_name}.rc under prec_pr_jobs_dir.
start_parallel_job() {
  local job_name="$1"
  shift
  local log_file="${prec_pr_jobs_dir}/${job_name}.log"
  local rc_file="${prec_pr_jobs_dir}/${job_name}.rc"
  prec_pr_job_count=$(( prec_pr_job_count + 1 ))
  (
    set +e
    "$@" >"$log_file" 2>&1
    printf '%s\n' "$?" >"$rc_file"
  ) &
}

job_bash_n() {
  local -a files=()
  collect_check_files "$check_root" files
  bash -n "${files[@]}"
}

job_shellcheck() {
  local -a files=()
  collect_check_files "$check_root" files
  # Match .github/workflows/ci.yml exactly (no suppressions).
  shellcheck -S info "${files[@]}"
}

job_test_file() {
  local -r test_path="$1"
  bash "$test_path"
}

start_parallel_checks() {
  local t base

  init_parallel_jobs
  start_parallel_job 'bash-n' job_bash_n
  start_parallel_job 'shellcheck' job_shellcheck

  shopt -s nullglob
  local -a tests=( "${check_root}"/tests/*.test )
  shopt -u nullglob
  if [[ "${#tests[@]}" -eq 0 ]]; then
    die "No tests/*.test files found under ${check_root}"
  fi
  for t in "${tests[@]}"; do
    base="$(basename "$t" .test)"
    start_parallel_job "test-${base}" job_test_file "$t"
  done

  log_step "Running ${prec_pr_job_count} checks in parallel…"
}

wait_parallel_checks() {
  local rc_file job_name rc failed=0 fail_count=0

  set +e
  wait
  set -e

  shopt -s nullglob
  for rc_file in "${prec_pr_jobs_dir}"/*.rc; do
    job_name="$(basename "$rc_file" .rc)"
    rc="$(<"$rc_file")"
    if [[ "$rc" -eq 0 ]]; then
      log_step "passed: ${job_name}"
    else
      failed=1
      fail_count=$(( fail_count + 1 ))
      log_step "FAILED: ${job_name} (exit ${rc})"
      cat "${prec_pr_jobs_dir}/${job_name}.log" >&2
    fi
  done
  shopt -u nullglob

  if [[ "$failed" == '1' ]]; then
    die "${fail_count} parallel check(s) failed (see logs above)"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

main() {
  parse_args "$@"
  trap on_exit EXIT

  require_tools
  resolve_repo_roots "$PWD"

  if [[ "$check_root" != "$main_repo" ]]; then
    log_step "Check root: ${check_root} (primary: ${main_repo})"
  else
    log_step "Check root: ${check_root} (primary worktree)"
  fi

  prepare_main_worktree
  start_parallel_checks
  wait_parallel_checks

  log_step "pre-pr-checks passed"
}

main "$@"
