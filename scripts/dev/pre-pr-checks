#!/usr/bin/env bash
# scripts/dev/pre-pr-checks — Run local CI checks before opening/submitting a PR.
#
# Mirrors .github/workflows/ci.yml (bash -n, shellcheck, actionlint, tests/*.test).
# Requires a stack worktree (not the primary clone) and a clean primary worktree.
#
# Independent checks run in parallel to minimize wall-clock time.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"

# shellcheck disable=SC1091  # dev-worktree-guard is a sibling lib, not a package
source "${script_dir}/../lib/dev-worktree-guard"

main_repo=""
check_root=""
restore_done=0
prec_pr_jobs_dir=""
prec_pr_job_count=0

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/dev/pre-pr-checks

Run from a stack worktree (.worktrees/<stack>-wt) of the repository you are about
to submit. Exits non-zero if any check fails.

Checks (same as CI, run in parallel where independent):
  - Stack worktree (not the primary clone)
  - Primary worktree clean (empty git status --porcelain)
  - bash -n on scripts/*, scripts/dev/*, scripts/lib/*, tests/*, tests/lib/*
  - shellcheck -S info on the same paths
  - actionlint on GitHub workflows and repository-practices workflow templates
  - bash tests/*.test (every test harness must pass)

Before gt submit, run this script (or use scripts/dev/submit-stack).
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

resolve_repo_roots() {
  local start_dir="${1:-$PWD}"
  check_root="$(dwg_git_show_toplevel "$start_dir" || true)"
  check_root="${check_root//$'\n'/}"
  [[ -n "$check_root" ]] || die "Not inside a git repository (cwd: ${start_dir})"
  main_repo="$(dev_worktree_primary_path "$check_root")"
  [[ -n "$main_repo" ]] || die "Could not resolve primary worktree path"
}

collect_check_files() {
  local repo_root="$1"
  local -n _out=$2
  local f
  _out=()
  for f in \
    "${repo_root}"/scripts/* \
    "${repo_root}"/scripts/dev/* \
    "${repo_root}"/scripts/lib/* \
    "${repo_root}"/tests/* \
    "${repo_root}"/tests/lib/*; do
    [[ -f "$f" ]] || continue
    _out+=("$f")
  done
  if [[ "${#_out[@]}" -eq 0 ]]; then
    die "No shell scripts found under ${repo_root}/scripts or tests"
  fi
}

collect_actionlint_files() {
  local repo_root="$1"
  local -n out_ref="$2"
  local f
  out_ref=()
  shopt -s nullglob
  for f in \
    "${repo_root}"/.github/workflows/*.yml \
    "${repo_root}"/scripts/lib/repo-practices-workflows/*.yml; do
    [[ -f "$f" ]] || continue
    out_ref+=("$f")
  done
  shopt -u nullglob
}

on_exit() {
  verify_main_worktree_clean
  if [[ -n "$prec_pr_jobs_dir" && -d "$prec_pr_jobs_dir" ]]; then
    rm -rf "$prec_pr_jobs_dir"
  fi
}

verify_main_worktree_clean() {
  if [[ "$restore_done" == '1' ]]; then
    return 0
  fi
  restore_done=1

  if [[ -z "$main_repo" ]]; then
    return 0
  fi

  local after_checks exit_code

  exit_code=0
  runner_exec "git status porcelain primary after checks" -- git -C "$main_repo" status --porcelain \
    || exit_code=$?
  if (( exit_code != 0 )); then
    die "Could not verify primary worktree status for ${main_repo}"
  fi
  after_checks="$(dwg_runner_last_stdout)"
  if [[ -n "$after_checks" ]]; then
    die "Primary worktree ${main_repo} has unexpected changes after checks (scripts must not modify main)"
  fi
}

assert_worktree_guards() {
  dev_assert_stack_worktree "$check_root" \
    || die 'pre-pr-checks must run from a stack worktree (see --help)'
  dev_assert_main_worktree_clean "$check_root" \
    || die 'Primary worktree must be clean before pre-pr-checks'
  log_step "Check root: ${check_root} (primary: ${main_repo})"
  log_step 'Primary worktree is clean'
}

require_tools() {
  command -v shellcheck >/dev/null 2>&1 || die "shellcheck not found on PATH"
  command -v actionlint >/dev/null 2>&1 || die "actionlint not found on PATH"
  command -v bash >/dev/null 2>&1 || die "bash not found on PATH"
  command -v rg >/dev/null 2>&1 || die "rg (ripgrep) not found on PATH (required by tests; see CI workflow)"
}

init_parallel_jobs() {
  prec_pr_jobs_dir="$(mktemp -d "${TMPDIR:-/tmp}/pre-pr-checks-jobs.XXXXXX")"
}

# Run one check in the background; writes ${job_name}.log and ${job_name}.rc under prec_pr_jobs_dir.
start_parallel_job() {
  local job_name="$1"
  shift
  local log_file="${prec_pr_jobs_dir}/${job_name}.log"
  local rc_file="${prec_pr_jobs_dir}/${job_name}.rc"
  prec_pr_job_count=$(( prec_pr_job_count + 1 ))
  (
    set +e
    "$@" >"$log_file" 2>&1
    printf '%s\n' "$?" >"$rc_file"
  ) &
}

job_bash_n() {
  local -a files=()
  collect_check_files "$check_root" files
  bash -n "${files[@]}"
}

job_shellcheck() {
  local -a files=()
  collect_check_files "$check_root" files
  # Match .github/workflows/ci.yml exactly (no suppressions).
  shellcheck -S info "${files[@]}"
}

job_actionlint() {
  local -a files=()
  collect_actionlint_files "$check_root" files
  if [[ "${#files[@]}" -eq 0 ]]; then
    return 0
  fi
  runner_exec "pre-pr-checks actionlint" -- actionlint "${files[@]}"
}

job_test_file() {
  local -r test_path="$1"
  bash "$test_path"
}

start_parallel_checks() {
  local t base

  init_parallel_jobs
  start_parallel_job 'bash-n' job_bash_n
  start_parallel_job 'shellcheck' job_shellcheck
  start_parallel_job 'actionlint' job_actionlint

  shopt -s nullglob
  local -a tests=( "${check_root}"/tests/*.test )
  shopt -u nullglob
  if [[ "${#tests[@]}" -eq 0 ]]; then
    die "No tests/*.test files found under ${check_root}"
  fi
  for t in "${tests[@]}"; do
    base="$(basename "$t" .test)"
    start_parallel_job "test-${base}" job_test_file "$t"
  done

  log_step "Running ${prec_pr_job_count} checks in parallel…"
}

wait_parallel_checks() {
  local rc_file job_name rc failed=0 fail_count=0

  set +e
  wait
  set -e

  shopt -s nullglob
  for rc_file in "${prec_pr_jobs_dir}"/*.rc; do
    job_name="$(basename "$rc_file" .rc)"
    rc="$(<"$rc_file")"
    if [[ "$rc" -eq 0 ]]; then
      log_step "passed: ${job_name}"
    else
      failed=1
      fail_count=$(( fail_count + 1 ))
      log_step "FAILED: ${job_name} (exit ${rc})"
      cat "${prec_pr_jobs_dir}/${job_name}.log" >&2
    fi
  done
  shopt -u nullglob

  if [[ "$failed" == '1' ]]; then
    die "${fail_count} parallel check(s) failed (see logs above)"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

main() {
  parse_args "$@"
  trap on_exit EXIT

  require_tools
  resolve_repo_roots "$PWD"
  assert_worktree_guards
  start_parallel_checks
  wait_parallel_checks

  log_step "pre-pr-checks passed"
}

main "$@"
