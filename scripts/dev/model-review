#!/usr/bin/env bash
# Pre-push review of the committed changes by a model other than the author (repository-helpers#761).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck disable=SC1091  # sibling lib resolved at runtime
source "${script_dir}/../lib/runner-bootstrap"

usage() {
  cat <<'EOF_USAGE'
Usage:
  scripts/dev/model-review [--dir DIR] [--base REF] [--max-runs N] [--timeout SECONDS] [--state-dir DIR]
  scripts/dev/model-review --decline REASON [--dir DIR] [--base REF] [--state-dir DIR]
  scripts/dev/model-review --detect
  scripts/dev/model-review --help

Send the committed changes of the current branch to a reviewer model that differs from the model that wrote
them, and gate on its findings before a push. Only the commits since the last reviewed head are sent (the whole
branch the first time, or when history was rewritten). Run it after committing: uncommitted changes are not
reviewed (a NOTE says so). It runs from scripts/dev/pre-pr-checks as the `model-review` job when a reviewer
command is available.

The reviewer is a command that reads the prompt on stdin and prints its review on stdout, split into words
(no shell is involved). Default: `claude --print --model <MODEL_REVIEW_MODEL> --settings <pin>`, where <pin> is
`{"availableModels":["<MODEL_REVIEW_MODEL>"]}`. The pin keeps a restrictive `availableModels` in your Claude
settings from making claude silently answer from another model (the author, on a native login; an id a gateway
refuses). Behind a gateway that maps aliases to its own ids, `opus` also needs `ANTHROPIC_DEFAULT_OPUS_MODEL`.
The review must end with a verdict:
`VERDICT: CLEAN`, or one `FINDING: <file>: <problem>` line per finding followed by `VERDICT: FINDINGS`. Anything
else is an error, never a clean pass.

Guard rails:
  - The reviewer must differ from the author: when MODEL_REVIEW_AUTHOR_MODEL (else ANTHROPIC_MODEL) is set and
    names the reviewer model, the review is skipped with a `SKIPPED:` line instead of a same-model pass. An
    unknown author model is reported in a NOTE and the review goes ahead.
  - The default command asks claude for its JSON result and checks which model answered (`modelUsage`). Every
    model that ran must be the expected one (modelUsage aggregates a session, so no single entry can be trusted to
    have written the verdict): otherwise `ERROR: MODEL_REVIEW_MODEL_MISMATCH requested=… expected=… answered=…`
    (exit 1). A listed model that is the author's is `ERROR: MODEL_REVIEW_SAME_MODEL`, whatever was expected (an alias
    author such as opus also counts as the id ANTHROPIC_DEFAULT_OPUS_MODEL maps it to), and
    an expected model that is the author's is skipped like a same-model reviewer. The expected model is
    MODEL_REVIEW_ANSWER_MODEL when set, else the requested one, matched on id boundaries (gateway-large-1 is not
    gateway-large-10; a version-specific id is not satisfied by a more specific version, a snapshot date is the
    same version). Set it when opus is mapped to a gateway id without "opus", or when a session also lists a
    helper model (a shared part such as "claude" accepts both; the author check still applies). A result that
    cannot be verified (not JSON, no modelUsage), a mismatch and a same-model answer record nothing: each fails
    every run, and calls the reviewer again, until the environment is fixed, so the once-per-head and --max-runs
    caps do not count them. A custom MODEL_REVIEW_CMD is trusted as it is, and ignores MODEL_REVIEW_ANSWER_MODEL.
  - The availableModels pin has limits: an organization-managed list cannot be overridden by --settings, and other
    lists merge instead of becoming a single-model list. The pin only makes the requested model available; the
    answering-model check above is what detects a substitution.
  - Each head+base is reviewed once; the recorded result, findings included, is replayed at no cost.
  - At most --max-runs (default 8) distinct heads are reviewed per repository branch.
  - Findings gate the push (exit 2). Fix them and commit, or record a decline with
    `model-review --decline "<reason>"`, which is logged and lets this head through.
  - A missing reviewer, an author that is the reviewer, no commits ahead, or the run cap are `SKIPPED:` lines
    (exit 3), never silent and never a failure. PRE_PR_CHECKS_SKIP=model-review skips the pre-pr-checks job.

Exit status:
  0  clean (or replayed clean, or a recorded decline)
  1  error (the review could not be completed)
  2  findings (printed; address them and commit, or --decline)
  3  skipped (reason on a `SKIPPED:` line)

Environment:
  MODEL_REVIEW_CMD                Reviewer command (default: claude --print --model <model> --settings <pin>)
  MODEL_REVIEW_MODEL              Reviewer model for the default command (default: opus)
  MODEL_REVIEW_ANSWER_MODEL       Id part that must answer when it is not MODEL_REVIEW_MODEL (default: that model)
  MODEL_REVIEW_AUTHOR_MODEL       The author's model (default: $ANTHROPIC_MODEL); used to refuse a same-model review
  MODEL_REVIEW_MAX_DIFF_BYTES     Largest diff sent; a bigger one is skipped, never cut (default: 200000)
  MODEL_REVIEW_STATE_DIR          State directory (default: ~/scratch/repository-helpers/model-review)
EOF_USAGE
}

skip() {
  printf 'SKIPPED: model-review: %s\n' "$*" >&2
  exit 3
}

fail() {
  printf 'ERROR: model-review: %s\n' "$*" >&2
  exit 1
}

# git_out <label> <repo> <git args…>: stdout of a git command; non-zero when it fails.
git_out() {
  local -r label="$1"
  local -r repo="$2"
  shift 2
  runner_exec_stdout "model-review ${label}" --probe -- git -C "$repo" "$@"
}

# reviewer_words — prints the reviewer command, one word per line.
reviewer_words() {
  local model words
  if [[ -n "${MODEL_REVIEW_CMD:-}" ]]; then
    read -r -a words <<<"$MODEL_REVIEW_CMD"
    printf '%s\n' "${words[@]}"
    return 0
  fi
  model="${MODEL_REVIEW_MODEL:-opus}"
  # --settings pins availableModels to the reviewer. The user settings may restrict it (for example to
  # sonnet and haiku, with enforcement); claude then swaps a model outside the list for its default and
  # answers from that model without an error. Behind a gateway the default id is refused (a 400 naming a
  # different model than the one requested); on a native login the review would silently run on the
  # author's own model. The JSON has no spaces, so it stays one word. --output-format json makes claude
  # report which model answered (modelUsage), which unwrap_default_review checks instead of trusting the pin.
  printf '%s\n' claude --print --model "$model" --settings "{\"availableModels\":[\"${model}\"]}" \
    --output-format json
}

# model_matches <requested> <answered> — true when the answering id contains the requested model on id
# boundaries, one way only: a shorter answering id (claude-opus-4) is a different model from a longer request
# (claude-opus-4-5). An alias (opus) is contained in any id of its family (claude-opus-5-5), but a
# version-specific request is not satisfied by a more specific version (claude-opus-4 is not claude-opus-4-5;
# a snapshot date such as claude-opus-4-20250514 is the same version). The requested id is normalized first: a
# context suffix ([1m]), a provider prefix (brk-commons/ on any id, us.anthropic. before claude) and a Bedrock
# version suffix (-v1:0) are dropped, because the answering id may omit them, and '@' and '.' read as '-' (a
# Vertex date, a gateway's dotted claude-opus-5.5).
model_matches() {
  local requested answered rest prefix before after left_ok right_ok versioned=0
  local -r version_tail_re='^-[0-9]{1,3}($|[^0-9])'
  requested="${1,,}"
  answered="${2,,}"
  requested="${requested%%\[*}"
  requested="${requested##*/}"
  requested="${requested//[@.]/-}"
  answered="${answered//[@.]/-}"
  if [[ "$requested" == *claude* ]]; then
    requested="claude${requested#*claude}"
  fi
  requested="${requested%:*}"
  requested="${requested%-v[0-9]*}"
  [[ -n "$requested" ]] || return 1
  [[ "$requested" =~ [0-9] ]] && versioned=1
  # The match must sit on id boundaries: gateway-large-1 is not gateway-large-10, and opus is not opusplan.
  rest="$answered"
  prefix=""
  while [[ "$rest" == *"$requested"* ]]; do
    before="${prefix}${rest%%"$requested"*}"
    after="${rest#*"$requested"}"
    left_ok=0
    right_ok=0
    [[ -z "$before" || ! "${before: -1}" =~ [[:alnum:]] ]] && left_ok=1
    [[ -z "$after" || ! "${after:0:1}" =~ [[:alnum:]] ]] && right_ok=1
    # A version-specific request is not satisfied by a more specific version: claude-opus-4 is not
    # claude-opus-4-5, while an eight digit snapshot date (claude-opus-4-20250514) is the same version.
    if (( versioned == 1 )) && [[ "$after" =~ $version_tail_re ]]; then
      right_ok=0
    fi
    if (( left_ok == 1 && right_ok == 1 )); then
      return 0
    fi
    prefix="${before}${requested}"
    rest="$after"
  done
  return 1
}

# unwrap_default_review <out_file> <model> <state_file> <head> <base> — the default command prints one JSON
# result. Replace out_file with its review text and fail (never a clean pass) when it is not a result, is an
# error, does not say which model answered, or lists a model other than the expected one: a restrictive
# availableModels can still swap a version-specific model, and claude does so without an error. EVERY model in
# modelUsage must match: it aggregates a whole session, so no single entry can be trusted to be the one that
# wrote the verdict, and failing closed is the only attribution that cannot accept a wrong author. A result that
# cannot be verified (no JSON, no modelUsage) or names the wrong model records nothing, so it keeps failing the
# push on every run instead of exhausting the two-failure cap and becoming a non-blocking SKIPPED. The
# expected model is MODEL_REVIEW_ANSWER_MODEL when set, else the requested one: an alias whose id does not
# contain its own name (opus mapped by ANTHROPIC_DEFAULT_OPUS_MODEL to a gateway id without "opus"), or a
# session that also lists a helper model, needs it (a shared part such as "claude"). A listed model that is the
# author's is refused whatever was expected. Sets answered_models (comma-separated) for the caller's log line.
answered_models=""
unwrap_default_review() {
  local -r out_file="$1" model="$2" state_file="$3" head="$4" base="$5"
  local -r expect="${MODEL_REVIEW_ANSWER_MODEL:-$model}"
  local -r object_jq='if type == "array" then .[-1] else . end'
  local -r shape_jq='type == "object" and (.result | type) == "string"'
  local -r first_line_jq='.result | split("\n")[0] | .[0:200]'
  local -r models_jq='(.modelUsage // {}) | keys[]'
  local unwrapped normalized key is_error error_text all_keys="" author_id mismatch=0
  local -a listed_keys=()
  local -r no_json='the reviewer did not print a JSON result, so its model cannot be verified'
  command -v jq >/dev/null 2>&1 || fail "jq is required to read the default reviewer's result"
  unwrapped="${out_file}.text"
  normalized="${out_file}.object"
  # A verbose view setting makes claude print an array of messages with the result object last.
  runner_exec_stdout 'model-review object' --probe -- jq --compact-output "$object_jq" "$out_file" \
    >"$normalized" || fail "${no_json}; an error, not a clean pass"
  mv -- "$normalized" "$out_file"
  if ! runner_exec_stdout 'model-review shape' --probe -- jq --exit-status "$shape_jq" "$out_file" >/dev/null; then
    fail "${no_json}; an error, not a clean pass"
  fi
  is_error="$(runner_exec_stdout 'model-review is_error' --probe -- jq --raw-output '.is_error // false' "$out_file")"
  if [[ "$is_error" == "true" ]]; then
    record_result "$state_file" "$head" "$base" error 0 reviewer-error
    error_text="$(runner_exec_stdout 'model-review error text' --probe -- jq --raw-output "$first_line_jq" "$out_file")"
    fail "the reviewer reported an error: ${error_text}"
  fi
  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    listed_keys+=("$key")
    all_keys="${all_keys:+${all_keys},}${key}"
    model_matches "$expect" "$key" || mismatch=1
  done < <(runner_exec_stdout 'model-review models' --probe -- jq --raw-output "$models_jq" "$out_file")
  if (( ${#listed_keys[@]} == 0 )); then
    fail "the reviewer did not report which model answered, so it cannot be verified; an error, not a clean pass"
  fi
  if (( mismatch == 1 )); then
    printf 'ERROR: MODEL_REVIEW_MODEL_MISMATCH requested=%s expected=%s answered=%s head=%s\n' \
      "$model" "$expect" "$all_keys" "${head:0:7}" >&2
    exit 1
  fi
  # Whatever the expected model was, a listed model that is the author's is not a different-model review.
  while IFS= read -r author_id; do
    for key in "${listed_keys[@]}"; do
      if model_matches "$author_id" "$key"; then
        printf 'ERROR: MODEL_REVIEW_SAME_MODEL author=%s answered=%s head=%s\n' \
          "$author_id" "$all_keys" "${head:0:7}" >&2
        exit 1
      fi
    done
  done < <(author_ids)
  runner_exec_stdout 'model-review result text' --probe -- jq --raw-output '.result' "$out_file" >"$unwrapped" \
    || fail "cannot read the reviewer's result text"
  mv -- "$unwrapped" "$out_file"
  answered_models="$all_keys"
}

# validate_reviewer_model — fail when the default reviewer model could break the --settings JSON it is
# embedded in. Real ids carry ':' (Bedrock), '@' (Vertex) or '[1m]' (context suffix), all safe in a JSON
# string, so only a quote, a backslash, whitespace or a control character is refused. A custom
# MODEL_REVIEW_CMD is not touched.
validate_reviewer_model() {
  local -r model="${MODEL_REVIEW_MODEL:-opus}"
  local -r safe_model_re='^[^[:space:][:cntrl:]"\\]+$'
  [[ -n "${MODEL_REVIEW_CMD:-}" ]] && return 0
  [[ "$model" =~ $safe_model_re ]] \
    || fail "MODEL_REVIEW_MODEL must not contain quotes, backslashes, whitespace or control characters"
}

# reviewer_resolvable — true when the first word of the reviewer command is an executable.
reviewer_resolvable() {
  local first
  first="$(reviewer_words | head --lines=1)"
  [[ -n "$first" ]] || return 1
  if [[ "$first" == */* ]]; then
    [[ -x "$first" ]]
  else
    command -v "$first" >/dev/null 2>&1
  fi
}

# author_ids — the author's model, one per line, and the id an alias author (opus, sonnet, haiku) really runs
# on when ANTHROPIC_DEFAULT_<ALIAS>_MODEL maps it: an author "opus" mapped to gateway-large-1 is gateway-large-1.
author_ids() {
  local author alias_name var
  author="${MODEL_REVIEW_AUTHOR_MODEL:-${ANTHROPIC_MODEL:-}}"
  [[ -n "$author" ]] || return 0
  printf '%s\n' "$author"
  alias_name="${author,,}"
  case "$alias_name" in
    opus | sonnet | haiku)
      var="ANTHROPIC_DEFAULT_${alias_name^^}_MODEL"
      if [[ -n "${!var:-}" ]]; then
        printf '%s\n' "${!var}"
      fi
      ;;
  esac
}

# same_model — true when the author model is known and the reviewer command (or the model the answer must come
# from) names it, on id boundaries, in either direction.
same_model() {
  local author_id candidate answer=""
  # The model the answer must come from is only verified for the default command, so a custom
  # MODEL_REVIEW_CMD ignores MODEL_REVIEW_ANSWER_MODEL here too.
  if [[ -z "${MODEL_REVIEW_CMD:-}" ]]; then
    answer="${MODEL_REVIEW_ANSWER_MODEL:-}"
  fi
  while IFS= read -r author_id; do
    for candidate in "${MODEL_REVIEW_CMD:-${MODEL_REVIEW_MODEL:-opus}}" "$answer"; do
      [[ -n "$candidate" ]] || continue
      if model_matches "$author_id" "$candidate" || model_matches "$candidate" "$author_id"; then
        return 0
      fi
    done
  done < <(author_ids)
  return 1
}

# encode_key <text>: reversible, collision-free file-name fragment ('%' and '/' escaped).
encode_key() {
  local text="$1"
  text="${text//%/%25}"
  text="${text//\//%2F}"
  printf '%s' "$text"
}

# state_lookup <state_file> <head> <base>: the last "<head> <base> <result> <count> <detail>" for this pair.
state_lookup() {
  local -r state_file="$1"
  [[ -f "$state_file" ]] || return 1
  awk -v head="$2" -v base="$3" \
    '$1 == head && $2 == base && $3 != "error" { line = $0 } END { if (line != "") print line; else exit 1 }' \
    "$state_file"
}

# state_run_count <state_file>: distinct head+base pairs already reviewed.
state_run_count() {
  local -r state_file="$1"
  [[ -f "$state_file" ]] || { printf '0\n'; return 0; }
  awk '$3 != "error" && !seen[$1 ":" $2]++ { n++ } END { print n + 0 }' "$state_file"
}

# state_error_count <state_file> <head> <base>: failed attempts (timeout, bad exit, no verdict) on this head.
state_error_count() {
  local -r state_file="$1"
  [[ -f "$state_file" ]] || { printf '0\n'; return 0; }
  awk -v head="$2" -v base="$3" '$1 == head && $2 == base && $3 == "error" { n++ } END { print n + 0 }' "$state_file"
}

# state_last_reviewed_head <state_file>: the newest head with a clean or declined result, for the incremental diff.
state_last_reviewed_head() {
  local -r state_file="$1"
  [[ -f "$state_file" ]] || return 1
  awk '$3 == "clean" || $3 == "declined" { line = $1 } END { if (line != "") print line; else exit 1 }' "$state_file"
}

# record_result <state_file> <head> <base> <result> <count> [detail…]
record_result() {
  local -r state_file="$1" head="$2" base="$3" result="$4" count="$5"
  shift 5
  if ! printf '%s %s %s %s %s\n' "$head" "$base" "$result" "$count" "$*" >>"$state_file" 2>/dev/null; then
    printf 'WARN: model-review: could not write %s; this result will not be replayed\n' "$state_file" >&2
  fi
}

main() {
  local dir="$PWD" base_ref="" max_runs=8 timeout_s=540 state_dir="" decline="" detect=0
  local top branch head base_commit range_from key key_hash state_file findings_file dirty recorded runs
  local diff_file prompt_file out_file max_bytes diff_bytes review_rc findings_count word author_note
  local result count detail last_line attempts
  local -a cmd=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="${2:?--dir needs a value}"; shift 2 ;;
      --base) base_ref="${2:?--base needs a value}"; shift 2 ;;
      --max-runs) max_runs="${2:?--max-runs needs a value}"; shift 2 ;;
      --timeout) timeout_s="${2:?--timeout needs a value}"; shift 2 ;;
      --state-dir) state_dir="${2:?--state-dir needs a value}"; shift 2 ;;
      --decline) decline="${2:?--decline needs a reason}"; shift 2 ;;
      --detect) detect=1; shift ;;
      -h | --help) usage; exit 0 ;;
      *) usage >&2; exit 1 ;;
    esac
  done

  if [[ "$detect" -eq 1 ]]; then
    reviewer_resolvable
    exit $?
  fi

  [[ "$max_runs" =~ ^[1-9][0-9]*$ ]] || fail "--max-runs must be a positive integer"
  [[ "$timeout_s" =~ ^[1-9][0-9]*$ ]] || fail "--timeout must be a positive integer"
  max_bytes="${MODEL_REVIEW_MAX_DIFF_BYTES:-200000}"
  [[ "$max_bytes" =~ ^[1-9][0-9]*$ ]] || fail "MODEL_REVIEW_MAX_DIFF_BYTES must be a positive integer"
  validate_reviewer_model

  top="$(git_out 'show-toplevel' "$dir" rev-parse --show-toplevel)" || fail "not a git repository: ${dir}"
  branch="$(git_out 'branch' "$top" rev-parse --abbrev-ref HEAD)" || skip "cannot read the current branch"
  head="$(git_out 'head' "$top" rev-parse HEAD)" || skip "cannot read HEAD (repository without commits?)"
  [[ "$branch" != "HEAD" ]] || skip "detached HEAD"

  if [[ -z "$base_ref" ]]; then
    if git_out 'origin/main' "$top" rev-parse --verify --quiet origin/main >/dev/null; then
      base_ref="origin/main"
    elif git_out 'main' "$top" rev-parse --verify --quiet main >/dev/null; then
      base_ref="main"
    else
      skip "no origin/main or main to compare against"
    fi
  fi
  base_commit="$(git_out 'merge-base' "$top" merge-base HEAD "$base_ref")" \
    || skip "cannot compute a merge-base with ${base_ref}"
  [[ "$base_commit" != "$head" ]] || skip "no commits ahead of ${base_ref}"

  state_dir="${state_dir:-${MODEL_REVIEW_STATE_DIR:-${HOME}/scratch/repository-helpers/model-review}}"
  mkdir -p "$state_dir" || fail "cannot create the state directory ${state_dir}"
  key="$(encode_key "$top")__$(encode_key "$branch")"
  if (( ${#key} > 180 )); then
    key_hash="$(printf '%s' "$key" | cksum | awk '{ print $1 "-" $2 }')"
    key="${key:0:120}__${key_hash}"
  fi
  state_file="${state_dir}/${key}.log"
  findings_file="${state_dir}/${key}.${head:0:12}.${base_commit:0:12}.findings"

  if [[ -n "$decline" ]]; then
    decline="${decline//$'\n'/ }"
    record_result "$state_file" "$head" "$base_commit" declined 0 "$decline"
    printf 'NOTE: MODEL_REVIEW_DECLINED head=%s reason=%s\n' "${head:0:7}" "$decline" >&2
    exit 0
  fi

  dirty="$(git_out 'status' "$top" status --porcelain --untracked-files=no || true)"
  if [[ -n "$dirty" ]]; then
    printf 'NOTE: model-review: uncommitted changes are not reviewed (committed diff only)\n' >&2
  fi

  # Replay: this exact head against this exact base was already reviewed or declined.
  if recorded="$(state_lookup "$state_file" "$head" "$base_commit")"; then
    read -r _ _ result count detail <<<"$recorded"
    printf 'model-review: head %s already reviewed (%s); replaying\n' "${head:0:7}" "$result" >&2
    case "$result" in
      findings)
        printf 'ERROR: MODEL_REVIEW_FINDINGS count=%s head=%s (replayed; fix and commit, or --decline "<reason>")\n' \
          "$count" "${head:0:7}" >&2
        [[ ! -f "$findings_file" ]] || cat -- "$findings_file" >&2
        exit 2
        ;;
      declined)
        printf 'NOTE: MODEL_REVIEW_DECLINED head=%s reason=%s\n' "${head:0:7}" "${detail:-}" >&2
        exit 0
        ;;
    esac
    exit 0
  fi

  reviewer_resolvable || skip "no reviewer command (set MODEL_REVIEW_CMD, or install claude for the default)"
  if same_model; then
    skip "the author model (${MODEL_REVIEW_AUTHOR_MODEL:-${ANTHROPIC_MODEL:-}}) is the reviewer model;" \
      "set MODEL_REVIEW_MODEL or MODEL_REVIEW_CMD to a different one"
  fi
  author_note=""
  if [[ -z "${MODEL_REVIEW_AUTHOR_MODEL:-${ANTHROPIC_MODEL:-}}" ]]; then
    author_note=" (author model unknown: set MODEL_REVIEW_AUTHOR_MODEL so a same-model review is refused)"
  fi

  attempts="$(state_error_count "$state_file" "$head" "$base_commit")"
  if (( attempts >= 2 )); then
    skip "the reviewer failed ${attempts} times on this head (see ${state_file}); fix the reviewer or review it by hand"
  fi
  runs="$(state_run_count "$state_file")"
  if (( runs >= max_runs )); then
    skip "run cap reached (${runs} of ${max_runs} heads already reviewed on ${branch}); the PR review is the next gate"
  fi

  # Incremental: only the commits since the last reviewed head, when it is still an ancestor of this one.
  range_from="$base_commit"
  if recorded="$(state_last_reviewed_head "$state_file")" \
    && git_out 'ancestor' "$top" merge-base --is-ancestor "$recorded" "$head" >/dev/null 2>&1; then
    range_from="$recorded"
  fi

  diff_file="${RUNNER_SESSION_DIR}/diff.patch"
  prompt_file="${RUNNER_SESSION_DIR}/prompt.txt"
  out_file="${RUNNER_SESSION_DIR}/review.txt"
  git_out 'diff' "$top" diff --no-color "${range_from}..${head}" >"$diff_file" \
    || fail "cannot read the diff ${range_from:0:7}..${head:0:7}"
  diff_bytes="$(wc --bytes <"$diff_file" | tr -d ' ')"
  if (( diff_bytes > max_bytes )); then
    skip "the diff is ${diff_bytes} bytes, over MODEL_REVIEW_MAX_DIFF_BYTES=${max_bytes}; a cut diff would leave code" \
      "unreviewed, so nothing is sent. Raise the limit or commit and review smaller steps"
  fi
  # shellcheck disable=SC2016  # the backticks are literal Markdown in the prompt text, not command substitution
  {
    printf 'You are reviewing commits written by a different model, before they are pushed.\n'
    printf 'Review only for correctness bugs, missing tests, unsafe shell, and wrong claims in comments or docs.\n'
    printf 'Do not edit anything. List each real problem on its own line as `FINDING: <file>: <problem>`.\n'
    printf 'End with exactly one line: `VERDICT: CLEAN` when there is nothing to fix, else `VERDICT: FINDINGS`.\n\n'
    printf 'Commits (%s..%s):\n' "${range_from:0:7}" "${head:0:7}"
    git_out 'log' "$top" log --format='- %h %s' "${range_from}..${head}" || true
    printf '\nDiff:\n'
    cat -- "$diff_file"
  } >"$prompt_file"

  while IFS= read -r word; do
    cmd+=("$word")
  done < <(reviewer_words)
  printf 'model-review: reviewing %s (%s..%s, %s bytes of diff) with %s%s\n' \
    "$branch" "${range_from:0:7}" "${head:0:7}" "$diff_bytes" "${cmd[*]}" "$author_note" >&2

  review_rc=0
  # The runner starts its command in the background, where a plain `<file` on this call would not reach it:
  # a fixed wrapper opens the prompt as the reviewer's stdin itself.
  # shellcheck disable=SC2016  # the wrapper's $1/$@ expand in the child shell, not here
  runner_exec 'model-review review' --probe --stream-stdout --timeout "$timeout_s" -- \
    bash -c 'prompt="$1"; shift; exec "$@" <"$prompt"' model-review-stdin "$prompt_file" "${cmd[@]}" \
    >"$out_file" || review_rc=$?
  if (( review_rc == 124 )); then
    record_result "$state_file" "$head" "$base_commit" error 0 timeout
    fail "the reviewer timed out after ${timeout_s}s"
  fi
  if (( review_rc != 0 )); then
    record_result "$state_file" "$head" "$base_commit" error 0 "exit-${review_rc}"
    fail "the reviewer command exited ${review_rc}"
  fi
  if [[ -z "${MODEL_REVIEW_CMD:-}" ]]; then
    unwrap_default_review "$out_file" "${MODEL_REVIEW_MODEL:-opus}" "$state_file" "$head" "$base_commit"
    printf 'model-review: answered by %s\n' "$answered_models" >&2
  fi

  findings_count="$(grep -c '^FINDING: ' "$out_file" || true)"
  last_line="$(awk 'NF { line = $0 } END { print line }' "$out_file")"
  if [[ "$last_line" =~ ^VERDICT:\ FINDINGS[[:space:]]*$ ]] || (( findings_count > 0 )); then
    (( findings_count > 0 )) || findings_count=1
    grep '^FINDING: ' "$out_file" >"$findings_file" 2>/dev/null || cp -- "$out_file" "$findings_file"
    record_result "$state_file" "$head" "$base_commit" findings "$findings_count"
    printf 'ERROR: MODEL_REVIEW_FINDINGS count=%s head=%s\n' "$findings_count" "${head:0:7}" >&2
    cat -- "$findings_file" >&2
    exit 2
  fi
  # The verdict is the last non-empty line: a quoted `VERDICT: CLEAN` earlier in the text decides nothing.
  last_line="$(awk 'NF { line = $0 } END { print line }' "$out_file")"
  if [[ ! "$last_line" =~ ^VERDICT:\ CLEAN[[:space:]]*$ ]]; then
    record_result "$state_file" "$head" "$base_commit" error 0 no-verdict
    fail "the reviewer did not end with 'VERDICT: CLEAN' or 'VERDICT: FINDINGS'; an error, not a clean pass"
  fi

  record_result "$state_file" "$head" "$base_commit" clean 0
  printf 'model-review: clean (0 findings) on %s\n' "${head:0:7}" >&2
  exit 0
}

main "$@"
