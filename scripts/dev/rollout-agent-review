#!/usr/bin/env bash
# scripts/dev/rollout-agent-review — M4 org rollout for agent review cursor rule.
#
# Wraps scripts/github-repo-lint to audit or apply the pr-ship-and-review.mdc bundle
# across the org. See agent-review.plan.md (M4).
#
# Usage:
#   scripts/dev/rollout-agent-review [--org ORG] [--suggest]
#   scripts/dev/rollout-agent-review [--org ORG] --apply-fix
#
# Default mode is --suggest (audit + remediation hints; no GitHub writes).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "$script_dir/../.." && pwd)"
readonly repo_dir

org=""
apply_fix=0

usage() {
  cat <<'EOF'
Usage: scripts/dev/rollout-agent-review [options]

Org-wide rollout helper for M3/M4 agent review cursor rule (pr-ship-and-review.mdc).

Options:
  --org ORG        GitHub org (default: the-hcma / rp_DEFAULT_ORG)
  --suggest        Audit all repos and print remediation lines (default)
  --apply-fix      Run github-repo-lint --apply-fix (opens candidate PR stacks)
  -h, --help       Show this help

Examples:
  scripts/dev/rollout-agent-review --suggest
  scripts/dev/rollout-agent-review --apply-fix

After --apply-fix, review and merge candidate PRs from .worktrees/repo-practices-candidate-fixes-wt
(or per-repo stacks), then re-run --suggest until pr-ship-and-review checks are clean.
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_step() {
  printf '==> %s\n' "$*" >&2
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --org)
        [[ $# -ge 2 ]] || die '--org requires a value'
        org="$2"
        shift 2
        ;;
      --suggest)
        apply_fix=0
        shift
        ;;
      --apply-fix|--apply)
        apply_fix=1
        shift
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

main() {
  local lint_cmd=()
  local lint_rc=0

  parse_args "$@"

  lint_cmd=("${repo_dir}/scripts/github-repo-lint" --all)
  if [[ -n "$org" ]]; then
    lint_cmd+=(--org "$org")
  fi
  if [[ "$apply_fix" -eq 1 ]]; then
    lint_cmd+=(--apply-fix)
    log_step 'Applying org lint fixes (includes pr-ship-and-review.mdc candidate PRs)'
  else
    lint_cmd+=(--suggest)
    log_step 'Auditing org repos for agent review rollout (pr-ship-and-review.mdc)'
  fi

  set +e
  "${lint_cmd[@]}"
  lint_rc=$?
  set -e

  if [[ "$apply_fix" -eq 1 ]]; then
    log_step 'Apply-fix finished — review candidate PRs and merge before re-auditing'
  else
    log_step 'Suggest audit finished — fix FAIL lines for pr-ship-and-review, then --apply-fix'
  fi

  return "$lint_rc"
}

main "$@"
