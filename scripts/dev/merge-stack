#!/usr/bin/env bash
# scripts/dev/merge-stack — Land a PR (and everything below it in its stack) through the merge queue.
#
# GitHub refuses auto-merge for a stacked pull request ("Auto-merge is not supported for stacked pull
# requests"), so `gh pr merge --auto --squash` fails for every gh-stack PR that belongs to a stack. This
# helper picks the right command:
#
#   PR is in a gh stack  → gh stack merge --yes --squash   (current stack, no argument; atomic, bottom-up, queue-aware)
#   PR is not in a stack → gh pr merge <pr> --auto --squash
#
# It never pipes the merge command through tail/head: the command's own exit status and output are shown,
# and it confirms the PR is merged or queued (autoMergeRequest / merge queue entry) before reporting
# success, so a failed enqueue cannot be mistaken for a pending merge. With --wait it then polls until the
# PR is MERGED and prints the follow-up (`gh stack rebase` restacks what is left onto main).
#
# A stacked PR is merged only from the top of its stack, with no argument: `gh stack merge <number>` reads a
# bare number as a stack number first, so naming a PR could merge another stack. Every open PR of the stack
# must be ready, because gh stack merge only checks that they are open and not drafts.
#
# Exit codes: 0 merged or queued, 1 usage/error, 2 PR not ready or the merge command failed,
# 3 queued but not merged within --timeout (ERROR: WAIT_TIMEOUT line).
#
# Usage:
#   scripts/dev/merge-stack --pr <number> [--repo OWNER/NAME] [--wait] [--timeout SECONDS]
#   scripts/dev/merge-stack --help
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"
# shellcheck disable=SC1091  # sibling lib: the stacking-tool marker decides whether stacks exist
source "${script_dir}/../lib/stacking-tool"
# shellcheck disable=SC1091  # sibling lib: OWNER/NAME from a remote URL
source "${script_dir}/../lib/github-repo-slug"
# shellcheck disable=SC1091  # sibling lib: throttled gh reads (primary/secondary rate-limit backoff)
source "${script_dir}/../lib/github-api-rate-limit"
# Referenced below; assigned readonly in scripts/lib/stacking-tool.
# shellcheck disable=SC2154
: "${stacking_tool_value_gh_stack}"

pr_number=""
repo_arg=""
wait_for_merge=0
wait_timeout_s=2400
# Seconds between --wait polls and between the bounded re-reads of GitHub's state (tests set them to 0).
poll_interval_s="${MERGE_STACK_POLL_INTERVAL_S:-15}"
retry_sleep_s="${MERGE_STACK_RETRY_SLEEP_S:-5}"

usage() {
  # The leading comment block (after the shebang) is the help text, so it cannot drift from a line count.
  runner_sh_stdout "merge-stack usage" -- \
    "awk 'NR == 1 { next } /^#/ { sub(/^# ?/, \"\"); print; next } { exit }' $(printf '%q' "${BASH_SOURCE[0]}")"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        usage
        exit 0
        ;;
      --pr)
        [[ $# -ge 2 ]] || die '--pr needs a number'
        pr_number="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || die '--repo needs OWNER/NAME'
        repo_arg="$2"
        shift 2
        ;;
      --wait)
        wait_for_merge=1
        shift
        ;;
      --timeout)
        [[ $# -ge 2 ]] || die '--timeout needs a number of seconds'
        wait_timeout_s="$2"
        shift 2
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
  [[ "$pr_number" =~ ^[0-9]+$ ]] || die '--pr <number> is required'
  [[ "$wait_timeout_s" =~ ^[0-9]+$ ]] || die '--timeout must be a non-negative integer'
}

# gh_read <label> [--probe] <gh args…> — a read-only gh call through the throttled wrapper (rate-limit and
# transient-network retries), bounded to 60 s per attempt. Merge mutations are not routed through it: they
# run once, with their own longer timeout, and are never retried.
gh_read() {
  local -r label="$1"
  shift
  local -a probe=()

  if [[ "${1:-}" == '--probe' ]]; then
    probe=(--probe)
    shift
  fi
  github_api_exec_with_rate_limit_retry "$label" "${probe[@]+"${probe[@]}"}" -- timeout 60 gh "$@"
}

# pr_field <jq-filter> — one `gh pr view` read, with --repo when given.
pr_field() {
  local -r jq_filter="$1"
  local -a repo_flags=()

  if [[ -n "$repo_arg" ]]; then
    repo_flags=(--repo "$repo_arg")
  fi
  gh_read "merge-stack gh pr view ${pr_number}" pr view "$pr_number" "${repo_flags[@]+"${repo_flags[@]}"}" --json state,mergeStateStatus,isDraft,autoMergeRequest,mergedAt --jq "$jq_filter"
}

# local_slug — OWNER/NAME of the current directory's origin (empty when it cannot be resolved).
local_slug() {
  local origin_url slug=""

  origin_url="$(runner_exec_stdout "merge-stack git remote origin" --probe --timeout 20 -- git remote get-url origin)" || return 0
  slug="$(gh_slug_from_origin_url "$origin_url")" || slug=""
  printf '%s' "$slug"
}

# in_merge_queue — true when the PR has an entry in the base branch's merge queue. Once GitHub moves a PR
# into the queue, autoMergeRequest is null, so queue membership is a landing signal of its own (gh pr view has
# no field for it, hence the GraphQL read). Returns 0 when queued, 1 when the read succeeded and the PR is not
# queued, and 2 when that is unknown (slug unresolved or the read failed), so a wait loop can poll again.
in_merge_queue() {
  local slug owner name queued

  slug="${repo_arg:-$(local_slug)}"
  [[ "$slug" == */* ]] || return 2
  owner="${slug%%/*}"
  name="${slug#*/}"
  # shellcheck disable=SC2016  # $o, $n and $p are GraphQL variables, not shell expansions
  queued="$(gh_read "merge-stack gh queue membership ${pr_number}" api graphql -f query='query($o: String!, $n: String!, $p: Int!) { repository(owner: $o, name: $n) { pullRequest(number: $p) { isInMergeQueue } } }' -f o="$owner" -f n="$name" -F p="$pr_number" --jq '.data.repository.pullRequest.isInMergeQueue')" || return 2
  case "$queued" in
    true) return 0 ;;
    false) return 1 ;;
    *) return 2 ;;
  esac
}

# stack_branch_state <jq-filter> — runs a jq filter over `gh stack view --json` of the current directory with
# $pr bound to the PR number. Fails when there is no stack.
stack_branch_state() {
  local -r jq_filter="$1"
  local view_json

  # Exit 2 means the stack could not be read (gh stack view failed or timed out, which includes "not part of a
  # stack"); exit 1 is a readable stack for which the predicate is false. A wait loop must tell them apart.
  view_json="$(gh_read "merge-stack gh stack view" --probe stack view --json)" || return 2
  runner_exec_stdout "merge-stack jq stack state" -- jq --null-input --exit-status --argjson stack "$view_json" --argjson pr "$pr_number" "$jq_filter" >/dev/null
}

# in_stack <tool> — true when the PR is one of the branches of the stack in the current directory. Only a
# gh-stack repository (.github/stacking-tool) has stacks, and `gh stack` reads the current directory's
# repository, so a --repo that is not this clone, a graphite marker, or no stack all fall through to the plain
# auto-merge. A stacked PR reached that way is reported by name when GitHub refuses the auto-merge (below).
in_stack() {
  local -r tool="$1"
  local slug

  [[ "$tool" == "$stacking_tool_value_gh_stack" ]] || return 1
  if [[ -n "$repo_arg" ]]; then
    slug="$(local_slug)"
    if [[ "$slug" != "$repo_arg" ]]; then
      printf 'merge-stack: NOTE: --repo %s is not the current directory'\''s repository (%s), so stack detection is skipped; run it from that clone to merge a stacked PR\n' \
        "$repo_arg" "${slug:-unknown}" >&2
      return 1
    fi
  fi
  # shellcheck disable=SC2016  # the jq program's $stack and $pr are bound by --argjson, not shell expansions
  stack_branch_state 'any($stack.branches[]?; (.pr.number // 0) == $pr)'
}

# stack_pr_landed — true when the stack lists the PR as merged or queued (gh stack view --json isMerged/isQueued).
stack_pr_landed() {
  # shellcheck disable=SC2016  # the jq program's $stack and $pr are bound by --argjson, not shell expansions
  stack_branch_state 'any($stack.branches[]?; (.pr.number // 0) == $pr and ((.isMerged // false) or (.isQueued // false)))'
}

# stack_is_top — true when the PR is the topmost branch of the stack (so `gh stack merge` with no argument,
# which merges the whole current stack, lands exactly this PR and everything below it).
stack_is_top() {
  # shellcheck disable=SC2016  # the jq program's $stack and $pr are bound by --argjson, not shell expansions
  stack_branch_state '($stack.branches | map(select(.isMerged != true)) | last | .pr.number // 0) == $pr'
}

# stack_open_pr_numbers — the PR numbers of the stack's branches that are not merged yet.
stack_open_pr_numbers() {
  local view_json

  view_json="$(gh_read "merge-stack gh stack view" --probe stack view --json)" || return 1
  # shellcheck disable=SC2016  # the jq program's $stack is bound by --argjson, not a shell expansion
  runner_exec_stdout "merge-stack jq stack open prs" -- jq --null-input --raw-output --argjson stack "$view_json" '$stack.branches[]? | select(.isMerged != true) | .pr.number // empty'
}

# ready_state <pr> — mergeStateStatus of a PR, re-read a few times while it is UNKNOWN (GitHub computes it
# lazily right after a push).
ready_state() {
  local -r target="$1"
  local state attempt

  for attempt in 1 2 3; do
    state="$(gh_read "merge-stack gh pr view ${target} state" pr view "$target" "${repo_flags[@]+"${repo_flags[@]}"}" --json mergeStateStatus --jq '.mergeStateStatus')" || state=''
    if [[ "$state" != 'UNKNOWN' && -n "$state" ]]; then
      break
    fi
    runner_exec "merge-stack ready_state sleep" -- sleep "$retry_sleep_s"
  done
  printf '%s' "${state:-UNKNOWN}"
}

# confirm_landed <stacked> — true once the PR shows as merged, auto-merge requested, or (stacked) merged or
# queued in the stack. GitHub's view can lag the merge command by a few seconds, so this re-reads a bounded
# number of times before it gives up.
confirm_landed() {
  local -r stacked_flag="$1"
  local attempt merged_at auto

  for attempt in 1 2 3 4 5 6; do
    merged_at="$(pr_field '.mergedAt // ""' || true)"
    auto="$(pr_field '(.autoMergeRequest != null) | tostring' || true)"
    if [[ -n "$merged_at" || "$auto" == 'true' ]]; then
      return 0
    fi
    if in_merge_queue; then
      return 0
    fi
    if (( stacked_flag == 1 )) && stack_pr_landed; then
      return 0
    fi
    if (( attempt < 6 )); then
      runner_exec "merge-stack confirm sleep" -- sleep "$retry_sleep_s"
    fi
  done
  return 1
}

main() {
  local state is_draft stacked=0 merge_rc=0 merge_out tool open_pr open_prs merge_state landed_rc queue_rc
  local -a repo_flags=()

  parse_args "$@"
  if [[ -n "$repo_arg" ]]; then
    repo_flags=(--repo "$repo_arg")
  fi

  # An invalid marker is a configuration error to surface, not something to read as "not in a stack".
  tool="$(stacking_tool_read_or_default "" "$stacking_tool_value_gh_stack" 'merge-stack')" || exit 1

  state="$(pr_field '.state')"
  if [[ "$state" == 'MERGED' ]]; then
    printf 'merge-stack: PR #%s is already merged\n' "$pr_number"
    exit 0
  fi
  [[ "$state" == 'OPEN' ]] || { printf 'ERROR: merge-stack: PR #%s is %s, not open\n' "$pr_number" "$state" >&2; exit 2; }
  is_draft="$(pr_field '.isDraft')"
  [[ "$is_draft" == 'false' ]] || { printf 'ERROR: merge-stack: PR #%s is a draft\n' "$pr_number" >&2; exit 2; }

  if in_stack "$tool"; then
    stacked=1
    # `gh stack merge <number>` reads a bare number as a stack number first and a PR number second, so a PR
    # number that is also some other stack's number would merge that stack. Merging the whole current stack
    # (no argument) is unambiguous, so only the top PR of the stack is merged here.
    if ! stack_is_top; then
      printf 'ERROR: merge-stack: PR #%s is not the top of its stack (a bare number is read as a stack number first, so naming it could merge another stack); merge from the top PR, everything below it is included, or run the stack merge yourself after checking the number\n' \
        "$pr_number" >&2
      exit 1
    fi
    # `gh stack merge` only checks that the PRs are open and not drafts, then asks GitHub to merge, so every
    # open PR of the stack has to be ready now. Auto-merge (below) is the opposite: it exists to wait for
    # pending checks or reviews, so the plain path takes no readiness gate.
    open_prs="$(stack_open_pr_numbers)" || die "could not read the stack's open PRs; nothing was merged"
    [[ -n "$open_prs" ]] || die "the stack lists no open PRs; nothing was merged"
    while IFS= read -r open_pr; do
      [[ -n "$open_pr" ]] || continue
      merge_state="$(ready_state "$open_pr")"
      case "$merge_state" in
        CLEAN | HAS_HOOKS | UNSTABLE) ;;
        *)
          printf 'ERROR: merge-stack: stacked PR #%s is not ready to merge (mergeStateStatus=%s); wait for checks or fix it first\n' \
            "$open_pr" "$merge_state" >&2
          exit 2
          ;;
      esac
    done <<<"$open_prs"
    printf 'merge-stack: PR #%s is the top of a gh stack: gh stack merge (auto-merge is not available for stacked PRs)\n' \
      "$pr_number"
    runner_exec "merge-stack gh stack merge" --timeout 180 -- gh stack merge --yes --squash || merge_rc=$?
  else
    printf 'merge-stack: PR #%s is not in a stack: gh pr merge --auto --squash\n' "$pr_number"
    merge_out="$(runner_sh_stdout "merge-stack gh pr merge ${pr_number}" --timeout 180 -- "exec gh pr merge $(printf '%q' "$pr_number") ${repo_arg:+--repo $(printf '%q' "$repo_arg")} --auto --squash 2>&1")" || merge_rc=$?
    printf '%s\n' "$merge_out"
    if (( merge_rc != 0 )) && [[ "$merge_out" == *'not supported for stacked pull requests'* ]]; then
      printf 'ERROR: merge-stack: PR #%s belongs to a gh stack, but it is not in the stack of the current directory (or the marker is not gh-stack); run merge-stack from that stack'\''s worktree (gh stack checkout %s)\n' \
        "$pr_number" "$pr_number" >&2
      exit 2
    fi
  fi
  if (( merge_rc != 0 )); then
    printf 'ERROR: merge-stack: the merge command failed (exit %s); read its output above, nothing was queued\n' \
      "$merge_rc" >&2
    exit 2
  fi

  # Confirm the enqueue instead of assuming it: a merge command that exits 0 without any of the signals in
  # confirm_landed (merged, auto-merge requested, a merge queue entry, or queued/merged in the stack) did not
  # queue anything.
  if ! confirm_landed "$stacked"; then
    printf 'ERROR: merge-stack: PR #%s shows no merge, no auto-merge request and no queue entry after the merge command; it was not queued\n' \
      "$pr_number" >&2
    exit 2
  fi

  if (( wait_for_merge == 0 )); then
    printf 'merge-stack: PR #%s queued; check with: gh pr view %s --json state,mergedAt\n' "$pr_number" "$pr_number"
    [[ "$stacked" -eq 0 ]] || printf 'merge-stack: after it merges, restack the rest: gh stack rebase\n'
    exit 0
  fi

  SECONDS=0
  while (( SECONDS < wait_timeout_s )); do
    state="$(pr_field '.state' || true)"
    if [[ "$state" == 'MERGED' ]]; then
      printf 'merge-stack: PR #%s merged\n' "$pr_number"
      [[ "$stacked" -eq 0 ]] || printf 'merge-stack: restack the rest onto main: gh stack rebase\n'
      exit 0
    fi
    if [[ "$state" == 'CLOSED' ]]; then
      printf 'ERROR: merge-stack: PR #%s was closed without merging\n' "$pr_number" >&2
      exit 2
    fi
    # Still OPEN with neither auto-merge nor a queue entry any more: the queue dropped it.
    queue_rc=0
    if [[ "$state" == 'OPEN' ]]; then in_merge_queue || queue_rc=$?; fi
    if [[ "$state" == 'OPEN' ]] && [[ "$(pr_field '(.autoMergeRequest != null) | tostring' || true)" == 'false' ]] \
      && (( queue_rc == 1 )); then
      landed_rc=1
      if (( stacked == 1 )); then
        landed_rc=0
        stack_pr_landed || landed_rc=$?
      fi
      # Exit 2 is an unreadable stack (a transient gh failure), not an answer: poll again instead of reporting a drop.
      if (( stacked == 0 || landed_rc == 1 )); then
        # The PR can leave the queue as MERGED between the reads above; check again before reporting a drop.
        if [[ "$(pr_field '.state' || true)" == 'MERGED' ]]; then
          printf 'merge-stack: PR #%s merged\n' "$pr_number"
          [[ "$stacked" -eq 0 ]] || printf 'merge-stack: restack the rest onto main: gh stack rebase\n'
          exit 0
        fi
        printf 'ERROR: merge-stack: PR #%s is no longer queued (dropped from the merge queue?); check its checks and run merge-stack again\n' \
          "$pr_number" >&2
        exit 2
      fi
    fi
    runner_exec "merge-stack poll sleep" -- sleep "$poll_interval_s"
  done
  printf 'ERROR: WAIT_TIMEOUT merge-stack pr=%s waited=%ss timeout=%ss (queued, not merged yet)\n' \
    "$pr_number" "$SECONDS" "$wait_timeout_s" >&2
  exit 3
}

main "$@"
