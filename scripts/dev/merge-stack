#!/usr/bin/env bash
# scripts/dev/merge-stack — Land a PR (and everything below it in its stack) through the merge queue.
#
# GitHub refuses auto-merge for a stacked pull request ("Auto-merge is not supported for stacked pull
# requests"), so `gh pr merge --auto --squash` fails for every gh-stack PR that belongs to a stack. This
# helper picks the right command:
#
#   PR is in a gh stack  → gh stack merge <pr> --yes --squash   (atomic, bottom-up, queue-aware)
#   PR is not in a stack → gh pr merge <pr> --auto --squash
#
# It never pipes the merge command through tail/head: the command's own exit status and output are shown,
# and it confirms the PR is merged or queued (autoMergeRequest / merge queue entry) before reporting
# success, so a failed enqueue cannot be mistaken for a pending merge. With --wait it then polls until the
# PR is MERGED and prints the follow-up (`gh stack rebase` restacks what is left onto main).
#
# Exit codes: 0 merged or queued, 1 usage/error, 2 PR not ready or the merge command failed,
# 3 queued but not merged within --timeout (ERROR: WAIT_TIMEOUT line).
#
# Usage:
#   scripts/dev/merge-stack --pr <number> [--repo OWNER/NAME] [--wait] [--timeout SECONDS]
#   scripts/dev/merge-stack --help
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/../lib/runner-bootstrap"
# shellcheck disable=SC1091  # sibling lib: the stacking-tool marker decides whether stacks exist
source "${script_dir}/../lib/stacking-tool"
# shellcheck disable=SC1091  # sibling lib: OWNER/NAME from a remote URL
source "${script_dir}/../lib/github-repo-slug"
# Referenced below; assigned readonly in scripts/lib/stacking-tool.
# shellcheck disable=SC2154
: "${stacking_tool_value_gh_stack}"

pr_number=""
repo_arg=""
wait_for_merge=0
wait_timeout_s=2400
poll_interval_s=15

usage() {
  runner_sh_stdout "merge-stack usage" -- \
    "sed -n '2,21p' $(printf '%q' "${BASH_SOURCE[0]}") | sed 's/^# \{0,1\}//'"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        usage
        exit 0
        ;;
      --pr)
        pr_number="${2:-}"
        shift 2
        ;;
      --repo)
        repo_arg="${2:-}"
        shift 2
        ;;
      --wait)
        wait_for_merge=1
        shift
        ;;
      --timeout)
        wait_timeout_s="${2:-}"
        shift 2
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
  [[ "$pr_number" =~ ^[0-9]+$ ]] || die '--pr <number> is required'
  [[ "$wait_timeout_s" =~ ^[0-9]+$ ]] || die '--timeout must be a positive integer'
}

# pr_field <jq-filter> — one `gh pr view` read, with --repo when given.
pr_field() {
  local -r jq_filter="$1"
  local -a repo_flags=()

  if [[ -n "$repo_arg" ]]; then
    repo_flags=(--repo "$repo_arg")
  fi
  runner_exec_stdout "merge-stack gh pr view ${pr_number}" --timeout 60 -- gh pr view "$pr_number" "${repo_flags[@]+"${repo_flags[@]}"}" --json state,mergeStateStatus,isDraft,autoMergeRequest,mergedAt --jq "$jq_filter"
}

# local_slug — OWNER/NAME of the current directory's origin (empty when it cannot be resolved).
local_slug() {
  local origin_url slug=""

  origin_url="$(runner_exec_stdout "merge-stack git remote origin" --probe --timeout 20 -- git remote get-url origin)" || return 0
  slug="$(gh_slug_from_origin_url "$origin_url")" || slug=""
  printf '%s' "$slug"
}

# stack_branch_state <jq-filter> — runs a jq filter over `gh stack view --json` of the current directory with
# $pr bound to the PR number. Fails when there is no stack.
stack_branch_state() {
  local -r jq_filter="$1"
  local view_json

  view_json="$(runner_exec_stdout "merge-stack gh stack view" --probe --timeout 60 -- gh stack view --json)" || return 1
  runner_exec_stdout "merge-stack jq stack state" -- jq --null-input --exit-status --argjson stack "$view_json" --argjson pr "$pr_number" "$jq_filter" >/dev/null
}

# in_stack — true when the PR is one of the branches of the stack in the current directory. Only a gh-stack
# repository (.github/stacking-tool) has stacks, and `gh stack` reads the current directory's repository, so a
# --repo that is not this clone, a graphite marker, or no stack all fall through to the plain auto-merge.
in_stack() {
  local tool slug

  tool="$(stacking_tool_read_or_default "" "$stacking_tool_value_gh_stack" 'merge-stack' 2>/dev/null)" || return 1
  [[ "$tool" == "$stacking_tool_value_gh_stack" ]] || return 1
  if [[ -n "$repo_arg" ]]; then
    slug="$(local_slug)"
    if [[ "$slug" != "$repo_arg" ]]; then
      printf 'merge-stack: NOTE: --repo %s is not the current directory'\''s repository (%s), so stack detection is skipped; run it from that clone to merge a stacked PR\n' \
        "$repo_arg" "${slug:-unknown}" >&2
      return 1
    fi
  fi
  # shellcheck disable=SC2016  # the jq program's $stack and $pr are bound by --argjson, not shell expansions
  stack_branch_state 'any($stack.branches[]?; (.pr.number // 0) == $pr)'
}

# stack_pr_landed — true when the stack lists the PR as merged or queued (gh stack view --json isMerged/isQueued).
stack_pr_landed() {
  # shellcheck disable=SC2016  # the jq program's $stack and $pr are bound by --argjson, not shell expansions
  stack_branch_state 'any($stack.branches[]?; (.pr.number // 0) == $pr and ((.isMerged // false) or (.isQueued // false)))'
}

main() {
  local state merge_state is_draft stacked=0 merge_rc=0 merged_at auto landed=0 elapsed=0
  local -a repo_flags=()

  parse_args "$@"
  if [[ -n "$repo_arg" ]]; then
    repo_flags=(--repo "$repo_arg")
  fi

  state="$(pr_field '.state')"
  if [[ "$state" == 'MERGED' ]]; then
    printf 'merge-stack: PR #%s is already merged\n' "$pr_number"
    exit 0
  fi
  [[ "$state" == 'OPEN' ]] || { printf 'ERROR: merge-stack: PR #%s is %s, not open\n' "$pr_number" "$state" >&2; exit 2; }
  is_draft="$(pr_field '.isDraft')"
  [[ "$is_draft" == 'false' ]] || { printf 'ERROR: merge-stack: PR #%s is a draft\n' "$pr_number" >&2; exit 2; }
  if in_stack; then
    stacked=1
    # `gh stack merge` only checks that the PR is open and not a draft, then asks GitHub to merge, so it
    # needs a PR that is ready now. Auto-merge (below) is the opposite: it exists to wait for pending checks
    # or reviews, so the plain path takes no readiness gate.
    merge_state="$(pr_field '.mergeStateStatus')"
    case "$merge_state" in
      CLEAN | HAS_HOOKS | UNSTABLE) ;;
      *)
        printf 'ERROR: merge-stack: stacked PR #%s is not ready to merge (mergeStateStatus=%s); wait for checks or fix it first\n' \
          "$pr_number" "$merge_state" >&2
        exit 2
        ;;
    esac
    printf 'merge-stack: PR #%s is part of a gh stack: gh stack merge (auto-merge is not available for stacked PRs)\n' \
      "$pr_number"
    runner_exec "merge-stack gh stack merge ${pr_number}" --timeout 180 -- gh stack merge "$pr_number" --yes --squash || merge_rc=$?
  else
    printf 'merge-stack: PR #%s is not in a stack: gh pr merge --auto --squash\n' "$pr_number"
    runner_exec "merge-stack gh pr merge ${pr_number}" --timeout 180 -- gh pr merge "$pr_number" "${repo_flags[@]+"${repo_flags[@]}"}" --auto --squash || merge_rc=$?
  fi
  if (( merge_rc != 0 )); then
    printf 'ERROR: merge-stack: the merge command failed (exit %s); read its output above, nothing was queued\n' \
      "$merge_rc" >&2
    exit 2
  fi

  # Confirm the enqueue instead of assuming it: merged, auto-merge requested, or (stacked) merged or queued
  # in the stack. A merge command that exits 0 without any of these did not queue anything.
  merged_at="$(pr_field '.mergedAt // ""')"
  auto="$(pr_field '(.autoMergeRequest != null) | tostring')"
  if [[ -n "$merged_at" || "$auto" == 'true' ]]; then
    landed=1
  elif (( stacked == 1 )) && stack_pr_landed; then
    landed=1
  fi
  if (( landed == 0 )); then
    printf 'ERROR: merge-stack: PR #%s shows no merge, no auto-merge request and no queue entry after the merge command; it was not queued\n' \
      "$pr_number" >&2
    exit 2
  fi

  if (( wait_for_merge == 0 )); then
    printf 'merge-stack: PR #%s queued; check with: gh pr view %s --json state,mergedAt\n' "$pr_number" "$pr_number"
    [[ "$stacked" -eq 0 ]] || printf 'merge-stack: after it merges, restack the rest: gh stack rebase\n'
    exit 0
  fi

  while (( elapsed < wait_timeout_s )); do
    state="$(pr_field '.state')"
    if [[ "$state" == 'MERGED' ]]; then
      printf 'merge-stack: PR #%s merged\n' "$pr_number"
      [[ "$stacked" -eq 0 ]] || printf 'merge-stack: restack the rest onto main: gh stack rebase\n'
      exit 0
    fi
    if [[ "$state" == 'CLOSED' ]]; then
      printf 'ERROR: merge-stack: PR #%s was closed without merging\n' "$pr_number" >&2
      exit 2
    fi
    runner_exec "merge-stack poll sleep" -- sleep "$poll_interval_s"
    elapsed=$(( elapsed + poll_interval_s ))
  done
  printf 'ERROR: WAIT_TIMEOUT merge-stack pr=%s waited=%ss timeout=%ss (queued, not merged yet)\n' \
    "$pr_number" "$elapsed" "$wait_timeout_s" >&2
  exit 3
}

main "$@"
