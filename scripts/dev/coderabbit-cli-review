#!/usr/bin/env bash
# Optional pre-push review with the CodeRabbit CLI (repository-helpers#730).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
# shellcheck disable=SC1091  # sibling lib resolved at runtime
source "${script_dir}/../lib/runner-bootstrap"

# Parse the CLI output line by line and keep only JSON objects: a stray plain-text line must not
# make jq reject the whole stream and silently drop the findings.
readonly jq_events='def evs: [inputs | fromjson? | objects];'

usage() {
  cat <<'EOF'
Usage:
  scripts/dev/coderabbit-cli-review [--dir DIR] [--base REF] [--max-runs N]
                                    [--timeout SECONDS] [--state-dir DIR]
  scripts/dev/coderabbit-cli-review --detect
  scripts/dev/coderabbit-cli-review --help

Review the committed changes of the current branch (merge-base with REF, default
origin/main, else main) with the CodeRabbit CLI (`coderabbit` / `cr`) before pushing.
This is a local pass that uses the CLI's own allowance, not the PR-review allowance;
the PR review on the pushed head is still the sign-off. Run it after committing
(uncommitted changes are not reviewed; a NOTE says so); it runs from
scripts/dev/pre-pr-checks as the `coderabbit-cli` job when the CLI is installed.

Guard rails:
  - Never passes --use-credits. A review that would need credits ends as a skip.
  - Each head+base is reviewed once; the recorded result, including the finding details,
    is replayed from the state file at no cost.
  - At most --max-runs (default 2) distinct heads are reviewed per repository branch.
    Concurrent runs on one branch are not serialised, so they can both spend allowance.
  - Skips (never fails) when the CLI, its flags, sign-in, allowance, a usable git history
    (shallow clone, no merge-base) or the run cap are missing.
  - Findings are always reported, even when the CLI also errors. A review with no findings
    and no `complete` event, an error event, or a nonzero CLI exit is an error, never a
    clean pass.

Exit status:
  0  clean (or replayed clean)
  1  error (the review could not be completed)
  2  findings (printed; address them, then commit and run again)
  3  skipped (reason on a `SKIPPED:` line)

--detect exits 0 when a CodeRabbit CLI binary is resolvable (no network, no allowance
used), 1 otherwise.

Environment:
  CODERABBIT_BIN                  Path to the CLI (default: coderabbit/cr on PATH, then ~/.local/bin)
  CODERABBIT_CLI_REVIEW_STATE_DIR State directory (default: ~/scratch/repository-helpers/coderabbit-cli-review)
EOF
}

# Resolve the CLI binary: explicit override, then PATH, then the vendor install dir.
# `coderabbit` is preferred over the short alias `cr`, which other tools also use.
resolve_cli() {
  local candidate
  if [[ -n "${CODERABBIT_BIN:-}" ]]; then
    [[ -x "$CODERABBIT_BIN" ]] || return 1
    printf '%s\n' "$CODERABBIT_BIN"
    return 0
  fi
  for candidate in \
    "$(command -v coderabbit 2>/dev/null || true)" \
    "${HOME}/.local/bin/coderabbit" \
    "$(command -v cr 2>/dev/null || true)" \
    "${HOME}/.local/bin/cr"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

skip() {
  printf 'SKIPPED: coderabbit-cli-review: %s\n' "$*" >&2
  exit 3
}

fail() {
  printf 'ERROR: coderabbit-cli-review: %s\n' "$*" >&2
  exit 1
}

# git_out <label> <repo> <git args…>: stdout of a git command; non-zero when it fails.
git_out() {
  local -r label="$1"
  local -r repo="$2"
  shift 2
  runner_exec_stdout "coderabbit-cli-review ${label}" --probe -- git -C "$repo" "$@"
}

# jq_out <label> <jq args…>: stdout of jq over files; non-zero when jq fails or is false.
jq_out() {
  local -r label="$1"
  shift
  runner_exec_stdout "coderabbit-cli-review ${label}" --probe -- jq "$@"
}

# ndjson_query <label> <ndjson file> <jq filter over evs> [extra jq flags…]
ndjson_query() {
  local -r label="$1"
  local -r file="$2"
  local -r filter="$3"
  shift 3
  jq_out "$label" "$@" --null-input --raw-input "${jq_events} ${filter}" "$file"
}

# Print the findings from an NDJSON review file.
print_findings() {
  local -r ndjson="$1"
  ndjson_query 'format findings' "$ndjson" '
    evs | map(select(.type == "finding")) | .[]
    | "  [\(.severity // "unknown")] \(.fileName // "?"): \(.title // "")\n      \((.comment // "") | gsub("\\s+"; " ") | .[0:400])"
  ' --raw-output
}

# Last lines of the CLI's own stderr for the run `uuid`, so a failure shows its real cause.
print_cli_stderr() {
  local -r uuid="$1"
  local text
  [[ -n "$uuid" ]] || return 0
  text="$(runner_read "$uuid" stderr 2> /dev/null | tail --lines=20 || true)"
  if [[ -n "$text" ]]; then
    printf 'coderabbit-cli-review: CLI stderr (last lines):\n%s\n' "$text" >&2
  fi
}

# Replay a recorded result for this head against this base:
# "<head> <base> <result> <findings>" per line. The base is part of the key because a
# different --base changes the reviewed diff.
state_lookup() {
  local -r state_file="$1"
  local -r head="$2"
  local -r base="$3"
  [[ -f "$state_file" ]] || return 1
  awk -v head="$head" -v base="$base" \
    '$1 == head && $2 == base { line = $0 } END { if (line != "") print line; else exit 1 }' "$state_file"
}

# Number of distinct head+base pairs already reviewed (portable: awk only).
state_run_count() {
  local -r state_file="$1"
  [[ -f "$state_file" ]] || { printf '0\n'; return 0; }
  awk '!seen[$1 ":" $2]++ { n++ } END { print n + 0 }' "$state_file"
}

# encode_key <text>: reversible, collision-free file-name fragment ('%' and '/' escaped).
encode_key() {
  local text="$1"
  text="${text//%/%25}"
  text="${text//\//%2F}"
  printf '%s' "$text"
}

# record_result <state_file> <head> <base> <result> <count>: a failed write warns instead of
# ending the run silently after the review has already spent allowance.
record_result() {
  local -r state_file="$1"
  if ! printf '%s %s %s %s\n' "$2" "$3" "$4" "$5" >> "$state_file" 2> /dev/null; then
    printf 'WARN: coderabbit-cli-review: could not write %s; this result will not be replayed\n' \
      "$state_file" >&2
  fi
}

main() {
  local dir="$PWD" base_ref="" max_runs=2 timeout_s=1200 state_dir=""
  local detect=0 flag
  local cli top branch head base_commit key key_hash state_file findings_file dirty
  local recorded recorded_result recorded_findings runs usage_file remaining
  local help_text ndjson findings_count review_rc review_id error_message cli_version
  local has_error has_complete complete_status

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="${2:?--dir needs a value}"; shift 2 ;;
      --base) base_ref="${2:?--base needs a value}"; shift 2 ;;
      --max-runs) max_runs="${2:?--max-runs needs a value}"; shift 2 ;;
      --timeout) timeout_s="${2:?--timeout needs a value}"; shift 2 ;;
      --state-dir) state_dir="${2:?--state-dir needs a value}"; shift 2 ;;
      --detect) detect=1; shift ;;
      -h | --help) usage; exit 0 ;;
      *) usage >&2; exit 1 ;;
    esac
  done

  if [[ "$detect" -eq 1 ]]; then
    resolve_cli > /dev/null
    exit $?
  fi

  [[ "$max_runs" =~ ^[0-9]+$ && "$max_runs" -ge 1 ]] || fail "--max-runs must be a positive integer"
  [[ "$timeout_s" =~ ^[0-9]+$ && "$timeout_s" -ge 1 ]] || fail "--timeout must be a positive integer"
  command -v jq > /dev/null 2>&1 || fail "jq not found"

  cli="$(resolve_cli)" || skip "CodeRabbit CLI not installed (coderabbit/cr not found)"

  top="$(git_out 'show-toplevel' "$dir" rev-parse --show-toplevel)" || fail "not a git repository: ${dir}"
  branch="$(git_out 'branch' "$top" rev-parse --abbrev-ref HEAD)" || skip "cannot read the current branch (repository without commits?)"
  head="$(git_out 'head' "$top" rev-parse HEAD)" || skip "cannot read HEAD (repository without commits?)"
  [[ "$branch" != "HEAD" ]] || skip "detached HEAD"

  if [[ -z "$base_ref" ]]; then
    if git_out 'origin/main' "$top" rev-parse --verify --quiet origin/main > /dev/null; then
      base_ref="origin/main"
    elif git_out 'main' "$top" rev-parse --verify --quiet main > /dev/null; then
      base_ref="main"
    else
      skip "no origin/main or main to compare against"
    fi
  fi
  base_commit="$(git_out 'merge-base' "$top" merge-base HEAD "$base_ref")" \
    || skip "cannot compute a merge-base with ${base_ref} (shallow clone or unrelated history?)"
  if [[ "$base_commit" == "$head" ]]; then
    skip "no commits ahead of ${base_ref}"
  fi

  dirty="$(git_out 'status' "$top" status --porcelain --untracked-files=no || true)"
  if [[ -n "$dirty" ]]; then
    printf 'NOTE: coderabbit-cli-review: uncommitted changes are not reviewed (committed diff only)\n' >&2
  fi

  state_dir="${state_dir:-${CODERABBIT_CLI_REVIEW_STATE_DIR:-${HOME}/scratch/repository-helpers/coderabbit-cli-review}}"
  mkdir -p "$state_dir" || fail "cannot create the state directory ${state_dir}"
  key="$(encode_key "$top")__$(encode_key "$branch")"
  if (( ${#key} > 180 )); then
    # Keep file names under the 255-byte limit: readable prefix plus a checksum of the full key.
    key_hash="$(printf '%s' "$key" | cksum | awk '{ print $1 "-" $2 }')"
    key="${key:0:120}__${key_hash}"
  fi
  state_file="${state_dir}/${key}.log"
  findings_file="${state_dir}/${key}.${head:0:12}.${base_commit:0:12}.findings"

  # Replay: this exact head against this exact base was already reviewed, so spend nothing.
  if recorded="$(state_lookup "$state_file" "$head" "$base_commit")"; then
    recorded_result="$(awk '{ print $3 }' <<<"$recorded")"
    recorded_findings="$(awk '{ print $4 }' <<<"$recorded")"
    printf 'coderabbit-cli-review: head %s already reviewed (%s findings); replaying\n' \
      "${head:0:7}" "$recorded_findings" >&2
    if [[ "$recorded_result" == "findings" ]]; then
      printf 'ERROR: CODERABBIT_CLI_FINDINGS count=%s head=%s (replayed; address them and commit to re-run)\n' \
        "$recorded_findings" "${head:0:7}" >&2
      if [[ -f "$findings_file" ]]; then
        cat "$findings_file" >&2
      fi
      exit 2
    fi
    exit 0
  fi

  runs="$(state_run_count "$state_file")"
  if (( runs >= max_runs )); then
    skip "run cap reached (${runs} of ${max_runs} reviews already used on ${branch}); the PR review is the next gate"
  fi

  # Every call into the CLI is bounded: it auto-updates and talks to the vendor backend.
  cli_version="$(runner_exec_stdout 'coderabbit-cli-review version' --probe --timeout 30 -- "$cli" --version 2> /dev/null || true)"
  cli_version="${cli_version:-unknown}"
  help_text="$(runner_exec_stdout 'coderabbit-cli-review review help' --probe --timeout 30 -- "$cli" review --help 2> /dev/null || true)"
  if [[ "${help_text,,}" != *coderabbit* ]]; then
    skip "${cli} does not look like the CodeRabbit CLI ('review --help' never mentions coderabbit)"
  fi
  for flag in '--agent' '--base-commit' '--committed' '--dir' '--fresh'; do
    if [[ "$help_text" != *"$flag"* ]]; then
      skip "installed CLI (${cli_version}) has no 'review ${flag}'; check 'cr review --help'"
    fi
  done

  # Artifacts live in the runner session, which is removed on exit (no EXIT trap of our own).
  usage_file="${RUNNER_SESSION_DIR}/usage.json"
  ndjson="${RUNNER_SESSION_DIR}/review.ndjson"
  runner_exec_stdout 'coderabbit-cli-review usage' --probe --timeout 60 -- "$cli" usage --agent \
    > "$usage_file" 2> /dev/null || true
  remaining="$(jq_out 'allowance' --raw-output '.includedReviews.remaining // empty' "$usage_file" 2> /dev/null || true)"
  if [[ -z "$remaining" ]]; then
    skip "could not read the CLI allowance (not signed in? run: cr auth login)"
  fi
  if [[ ! "$remaining" =~ ^[0-9]+$ ]]; then
    skip "unexpected allowance value '${remaining}' from 'usage --agent'; check 'cr usage --agent'"
  fi
  if (( remaining < 1 )); then
    skip "CLI allowance exhausted (0 remaining this hour); not using credits"
  fi

  printf 'coderabbit-cli-review: reviewing %s (%s..%s) with %s %s; %s allowance remaining\n' \
    "$branch" "${base_commit:0:7}" "${head:0:7}" "$(basename "$cli")" \
    "$cli_version" "$remaining" >&2

  review_rc=0
  runner_exec 'coderabbit-cli-review review' --probe --stream-stdout --timeout "$timeout_s" -- \
    "$cli" review --agent --fresh --committed --base-commit "$base_commit" --dir "$top" \
    > "$ndjson" || review_rc=$?
  review_id="$(runner_last_id)"

  if ndjson_query 'credits' "$ndjson" \
    'evs | any(.[]; .status == "awaiting_confirmation" or .type == "awaiting_confirmation")' \
    --exit-status > /dev/null 2>&1; then
    skip "review needs credits (awaiting_confirmation); --use-credits is never passed"
  fi

  findings_count="$(ndjson_query 'count findings' "$ndjson" \
    'evs | map(select(.type == "finding")) | length' 2> /dev/null || printf '0')"
  [[ "$findings_count" =~ ^[0-9]+$ ]] || findings_count=0

  # Findings are always reported, whatever else the CLI did: dropping them would waste the
  # allowance the review just spent.
  if (( findings_count > 0 )); then
    if (( review_rc == 124 )); then
      printf 'NOTE: coderabbit-cli-review: the review timed out after %ss; reporting the findings streamed so far\n' \
        "$timeout_s" >&2
    fi
    record_result "$state_file" "$head" "$base_commit" findings "$findings_count"
    printf 'ERROR: CODERABBIT_CLI_FINDINGS count=%s head=%s\n' "$findings_count" "${head:0:7}" >&2
    print_findings "$ndjson" > "$findings_file" 2> /dev/null || true
    print_findings "$ndjson" >&2
    exit 2
  fi

  # No findings and the review did not finish: nothing is recorded, so the next run can retry.
  if (( review_rc == 124 )); then
    fail "review timed out after ${timeout_s}s (no result recorded)"
  fi

  # No findings: a clean verdict needs a complete event, no error event and a clean exit.
  has_error=0
  if ndjson_query 'errors' "$ndjson" 'evs | any(.[]; .type == "error")' --exit-status > /dev/null 2>&1; then
    has_error=1
  fi
  has_complete=0
  if ndjson_query 'complete' "$ndjson" 'evs | any(.[]; .type == "complete")' --exit-status > /dev/null 2>&1; then
    has_complete=1
  fi
  if (( has_error == 1 )); then
    error_message="$(ndjson_query 'error message' "$ndjson" \
      'evs | map(select(.type == "error")) | .[0] | (.message // .error // "unknown")' \
      --raw-output 2> /dev/null || true)"
    print_cli_stderr "$review_id"
    fail "review reported an error: ${error_message%%$'\n'*}"
  fi
  if (( has_complete == 0 )); then
    print_cli_stderr "$review_id"
    fail "no 'complete' event from the CLI (exit ${review_rc}); treating as an error, not a clean pass"
  fi
  # A 'complete' event is not a review: the CLI also completes a run it skipped, and a skipped run
  # must not be recorded or replayed as a clean verdict for this head.
  complete_status="$(ndjson_query 'complete status' "$ndjson" \
    'evs | map(select(.type == "complete")) | .[0] | (.status // "")' --raw-output 2> /dev/null || true)"
  if [[ "$complete_status" == *skipped* ]]; then
    skip "the CLI skipped the review (${complete_status}); nothing recorded"
  fi
  if (( review_rc != 0 )); then
    print_cli_stderr "$review_id"
    fail "the CLI exited ${review_rc} after its 'complete' event with no findings; treating as an error, not a clean pass"
  fi

  record_result "$state_file" "$head" "$base_commit" clean 0
  printf 'coderabbit-cli-review: clean (0 findings) on %s\n' "${head:0:7}" >&2
  exit 0
}

main "$@"
