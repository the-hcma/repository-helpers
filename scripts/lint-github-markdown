#!/usr/bin/env bash
# scripts/lint-github-markdown — lint agent-authored GitHub Markdown bodies.
#
# Flags body mangling signatures before posting with
# gh issue/pr create|edit --body-file or reply helpers (repository-helpers#651/#653/#660).
# With --repo-files, lints Markdown committed to a repository for hard line
# breaks instead, and --fix unwraps them in place (repository-helpers#671).
#
# Usage:
#   scripts/lint-github-markdown <file> [<file>…]
#   scripts/lint-github-markdown --repo-files [--fix] <file> [<file>…]
#   scripts/lint-github-markdown --help
#
# Exit 0 when all files are clean; 1 when any finding (or usage error).
# See repository-helpers#651/#660/#671 and .agents/rules/github-content-formatting.md.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/github-markdown"

usage() {
  printf '%s\n' \
    'Usage: scripts/lint-github-markdown <file> [<file>…]' \
    '       scripts/lint-github-markdown --repo-files [--fix] <file> [<file>…]' \
    '' \
    'Lint Markdown files intended for GitHub issue/PR bodies or comments.' \
    'Flags mid-line list markers, headings without a preceding blank line,' \
    'fenced code blocks that are not on their own line / missing a blank line' \
    'before, hand-wrapped paragraphs (consecutive prose lines — GitHub' \
    'issue/PR UI hard-breaks on a lone newline), and a closing keyword' \
    '(fix/close/resolve, any tense) that sits near an issue reference but not' \
    'immediately next to it (GitHub only auto-closes on the adjacent form).' \
    '' \
    'Author multi-paragraph bodies with --body-file (one long line per' \
    'paragraph, or blank line between paragraphs). Prefer scripts/gh-issue for' \
    'issue create/edit so the lint runs before the API call.' \
    '' \
    '--repo-files lints Markdown committed to a repository instead: it flags' \
    'only hard line breaks inside a paragraph, list item or blockquote, and' \
    'skips front matter, code, tables, headings and HTML. Add --fix to join' \
    'each paragraph, list item or blockquote onto one line in place.' \
    'See .agents/rules/github-content-formatting.md.'
}

main() {
  local path any_fail=0 repo_files=0 fix=0

  if [[ $# -eq 0 ]] || [[ "${1:-}" == '--help' ]] || [[ "${1:-}" == '-h' ]]; then
    usage
    if [[ $# -eq 0 ]]; then
      exit 1
    fi
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo-files)
        repo_files=1
        shift
        ;;
      --fix)
        fix=1
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        printf 'ERROR: unknown option: %s (see --help)\n' "$1" >&2
        exit 1
        ;;
      *)
        break
        ;;
    esac
  done
  if (( fix && ! repo_files )); then
    printf 'ERROR: --fix requires --repo-files\n' >&2
    exit 1
  fi
  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi

  for path in "$@"; do
    if (( fix )); then
      ghm_unwrap_file "$path" || any_fail=1
    elif (( repo_files )); then
      ghm_lint_repo_file "$path" || any_fail=1
    elif ! ghm_lint_file "$path"; then
      any_fail=1
    fi
  done
  return "$any_fail"
}

main "$@"
