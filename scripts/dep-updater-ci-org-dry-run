#!/usr/bin/env bash
# dep-updater-ci-org-dry-run — Clone org repos and dry-run dep-updater --batch --all.
#
# Used by .github/workflows/dep-updater.yml after environment approval unlocks
# DEP_UPDATER_TOKEN (same access as local gh). Does not open PRs.
#
# Usage:
#   scripts/dep-updater-ci-org-dry-run [--org ORG] [--scan-root DIR]
#   scripts/dep-updater-ci-org-dry-run --help
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
helpers_dir="$(cd "${script_dir}/.." && pwd)"
readonly helpers_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091  # runtime path; shellcheck cannot follow sourced libs
source "${script_dir}/lib/github-api-rate-limit"
# shellcheck disable=SC1091  # runtime path; shellcheck cannot follow sourced libs
source "${script_dir}/lib/dep-updater-org-clone"
# shellcheck disable=SC1091  # runtime path; shellcheck cannot follow sourced libs
source "${script_dir}/lib/github-repo-slug"

readonly dep_updater="${script_dir}/dep-updater"
readonly this_repo_short_name='repository-helpers'
readonly default_org='the-hcma'

org=""
scan_root=""

usage() {
  # Keep sed on the runner_sh line for the adoption ratchet / capture.
  runner_sh_stdout "dep-updater-ci-org-dry-run usage" -- \
    "sed -n '2,11p' $(printf '%q' "${BASH_SOURCE[0]}") | sed 's/^# \{0,1\}//'"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '%s\n' "$*" >&2
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --org)
        [[ $# -ge 2 ]] || die '--org requires an organization name'
        org="$2"
        shift 2
        ;;
      --scan-root)
        [[ $# -ge 2 ]] || die '--scan-root requires a directory path'
        scan_root="$2"
        shift 2
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

resolve_org() {
  local from_repo

  if [[ -n "$org" ]]; then
    return 0
  fi
  if [[ -n "${GITHUB_REPOSITORY:-}" ]]; then
    org="${GITHUB_REPOSITORY%%/*}"
    [[ -n "$org" ]] || die 'GITHUB_REPOSITORY is set but has no owner prefix'
    return 0
  fi
  from_repo="$(gh_slug_from_repo_dir "$helpers_dir" || true)"
  if [[ -n "$from_repo" ]]; then
    org="${from_repo%%/*}"
    [[ -n "$org" ]] || die "Could not parse org from origin slug: ${from_repo}"
    return 0
  fi
  org="$default_org"
}

resolve_scan_root() {
  local temp_base resolved_base resolved exit_code=0

  temp_base="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"
  resolved_base=""
  set +e
  resolved_base="$(runner_exec_stdout "dep-updater-ci-org-dry-run realpath temp base" \
    -- realpath "$temp_base")"
  exit_code=$?
  set -e
  resolved_base="${resolved_base//$'\n'/}"
  if (( exit_code != 0 )) || [[ -z "$resolved_base" ]] || [[ ! -d "$resolved_base" ]]; then
    die "Could not resolve temp base for scan-root: ${temp_base}"
  fi

  if [[ -z "$scan_root" ]]; then
    scan_root="${resolved_base}/dep-updater-scan"
  fi

  # Resolve before mkdir/rm so a caller cannot point --scan-root at an arbitrary
  # existing tree. Require the canonical path under RUNNER_TEMP/TMPDIR.
  resolved=""
  set +e
  resolved="$(runner_exec_stdout "dep-updater-ci-org-dry-run realpath scan-root" \
    -- realpath --canonicalize-missing "$scan_root")"
  exit_code=$?
  set -e
  resolved="${resolved//$'\n'/}"
  if (( exit_code != 0 )) || [[ -z "$resolved" ]]; then
    die "Could not resolve --scan-root: ${scan_root}"
  fi
  case "$resolved" in
    "${resolved_base}"|"${resolved_base}"/*) ;;
    *)
      die "--scan-root must resolve under ${resolved_base} (got ${resolved})"
      ;;
  esac

  run_command "dep-updater-ci-org-dry-run mkdir scan-root" -- mkdir -p "$resolved"
  scan_root="$resolved"
}

# Print "name\tarchived" lines for every org repo (including private).
list_org_repos_tsv() {
  local -r owner="$1"
  local exit_code=0

  set +e
  # Keep gh on the same line as github_api_exec_with_rate_limit_retry (runner-adoption).
  github_api_exec_with_rate_limit_retry "dep-updater-ci-org-dry-run list org repos" -- gh api "orgs/${owner}/repos" --paginate --jq '.[] | [.name, (.archived|tostring)] | @tsv'
  exit_code=$?
  set -e
  return "$exit_code"
}

clone_org_repos() {
  local -r owner="$1"
  local -r root="$2"
  local name archived dest clone_exit=0 list_exit=0 listed=0 cloned=0 consumer=0
  local list_file fail_slug="" exit_code=0

  list_file=""
  set +e
  list_file="$(runner_exec_stdout "dep-updater-ci-org-dry-run mktemp repo list" -- mktemp)"
  exit_code=$?
  set -e
  list_file="${list_file//$'\n'/}"
  if (( exit_code != 0 )) || [[ -z "$list_file" ]]; then
    die 'Failed to create temporary org-repo list file'
  fi
  list_exit=0
  set +e
  list_org_repos_tsv "$owner" >"$list_file"
  list_exit=$?
  set -e
  if (( list_exit != 0 )); then
    run_command "dep-updater-ci-org-dry-run rm repo list" -- rm -f "$list_file"
    die "Failed to list repositories for org ${owner} (check DEP_UPDATER_TOKEN / GH_TOKEN access)"
  fi

  while IFS=$'\t' read -r name archived || [[ -n "${name:-}" ]]; do
    [[ -n "$name" ]] || continue
    listed=$(( listed + 1 ))
    if [[ "$archived" == 'true' ]]; then
      log "[ci-dry-run] Skipping archived repository: ${owner}/${name}"
      continue
    fi
    dest="${root}/${name}"
    case "$dest" in
      "${root}"/*) ;;
      *)
        fail_slug="${owner}/${name}"
        break
        ;;
    esac
    if [[ -e "${dest}/.git" ]]; then
      log "[ci-dry-run] Reusing existing clone: ${dest}"
    else
      run_command "dep-updater-ci-org-dry-run rm stale clone ${name}" -- rm -rf "$dest"
      clone_exit=0
      dep_updater_org_clone_shallow "${owner}/${name}" "$dest" || clone_exit=$?
      if (( clone_exit != 0 )); then
        fail_slug="${owner}/${name}"
        break
      fi
    fi
    cloned=$(( cloned + 1 ))
    if [[ "$name" != "$this_repo_short_name" ]]; then
      consumer=$(( consumer + 1 ))
    fi
  done <"$list_file"
  run_command "dep-updater-ci-org-dry-run rm repo list" -- rm -f "$list_file"

  if [[ -n "$fail_slug" ]]; then
    die "Failed to clone ${fail_slug} into ${root}/${fail_slug##*/}"
  fi
  if (( listed == 0 )); then
    die "No repositories returned for org ${owner} (check DEP_UPDATER_TOKEN / GH_TOKEN access)"
  fi
  if (( cloned == 0 )); then
    die "No non-archived clones under ${root}"
  fi
  if (( consumer == 0 )); then
    die "Only ${this_repo_short_name} was cloned; refusing to greenwash a token that cannot see consumer repos"
  fi
  log "[ci-dry-run] Cloned ${cloned} repositories (${consumer} consumers) under ${root}"
}

run_dry_run() {
  local -r root="$1"
  local exit_code=0

  set +e
  run_command "dep-updater batch-all dry-run" \
    -- env DEP_UPDATER_ORG="$org" "$dep_updater" --batch --all --dry-run --include-private --scan-root "$root"
  exit_code=$?
  set -e
  return "$exit_code"
}

main() {
  local exit_code=0

  parse_args "$@"
  [[ -x "$dep_updater" || -f "$dep_updater" ]] || die "Missing dep-updater at ${dep_updater}"
  command -v gh >/dev/null || die 'gh is required'
  command -v realpath >/dev/null || die 'realpath is required'

  if [[ -z "${GH_TOKEN:-${GITHUB_TOKEN:-}}" ]]; then
    die 'GH_TOKEN (or GITHUB_TOKEN) is required for org discovery and clone'
  fi

  resolve_org
  resolve_scan_root
  log "[ci-dry-run] org=${org} scan-root=${scan_root}"
  clone_org_repos "$org" "$scan_root"
  run_dry_run "$scan_root" || exit_code=$?
  exit "$exit_code"
}

main "$@"
