#!/usr/bin/env bash
# dep-updater-batch-run — git fetch, dep-updater --batch --all, SMTP report.
#
# Entry point for the Dependency Updater systemd service. Requires
# ~/.config/dep-updater.env (see etc/dep-updater.env.example).
#
# Usage:
#   dep-updater-batch-run [--print]
#   dep-updater-batch-run --help
#
# Options:
#   --print   Build the report and write the email to stdout (no SMTP, no batch).
#   --help    Show usage.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "$script_dir/.." && pwd)"
readonly repo_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/tooling-path"
tooling_path_bootstrap_cron_minimal

# shellcheck disable=SC1091
source "${script_dir}/lib/smtp-mail"

# shellcheck disable=SC1091
source "${script_dir}/lib/email-multipart"

# shellcheck disable=SC1091
source "${script_dir}/lib/time-log"

# shellcheck disable=SC1091
source "${script_dir}/lib/run-context"

readonly dep_updater="${script_dir}/dep-updater"
readonly subject_prefix="${DEP_UPDATER_REPORT_SUBJECT_PREFIX:-[dep-updater-batch]}"
readonly report_separator='────────────────────────────────────────────────────────────────'
readonly batch_timeout_default='4h'
readonly batch_timeout_kill_after_sec=30

env_file="${DEP_UPDATER_ENV_FILE:-${HOME}/.config/dep-updater.env}"

print_only=0

log_file="${DEP_UPDATER_BATCH_LOG:-${HOME}/scratch/repository-helpers/dep-updater-batch.log}"
lock_file="${DEP_UPDATER_BATCH_LOCK_FILE:-${HOME}/scratch/repository-helpers/dep-updater-batch.lock}"
scan_root="${DEP_UPDATER_BATCH_SCAN_ROOT:-${repo_dir}/..}"
run_log=""
clean_log=""
updates_report=""
_batch_run_stream_dir=""
batch_inner_cmd=""
batch_wrapper_cmd=""

# shellcheck disable=SC2317,SC2329  # invoked by EXIT trap
batch_run_cleanup_temp_files() {
  rm -f "${run_log:-}" "${clean_log:-}" "${updates_report:-}" 2>/dev/null || true
  if [[ -n "${_batch_run_stream_dir:-}" ]]; then
    rm -rf "$_batch_run_stream_dir" 2>/dev/null || true
  fi
}
trap batch_run_cleanup_temp_files EXIT

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"

# shellcheck disable=SC1091
source "${script_dir}/lib/timer-singleton-lock"

usage() {
  sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}

# batch_load_required_env_file
# Sources the mandatory dep-updater.env file (systemd EnvironmentFile uses the same path).
batch_load_required_env_file() {
  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' && "${DEP_UPDATER_BATCH_SKIP_ENV_FILE:-0}" == '1' ]]; then
    return 0
  fi
  if [[ ! -f "$env_file" ]]; then
    die "Missing required env file: ${env_file} (copy etc/dep-updater.env.example and configure SMTP)."
  fi
  if [[ ! -r "$env_file" ]]; then
    die "Env file is not readable: ${env_file}"
  fi
  set -a
  # shellcheck source=/dev/null
  source "$env_file"
  set +a
}

# batch_timeout_to_sec <spec>
# Plain seconds or a suffix: 90s, 30m, 4h (case-insensitive).
batch_timeout_to_sec() {
  local -r raw="$1"
  local value unit

  if [[ "$raw" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$raw"
    return 0
  fi

  if [[ "$raw" =~ ^([0-9]+)([smh])$ ]]; then
    value="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
      s) printf '%s\n' "$value"; return 0 ;;
      m) printf '%s\n' $(( value * 60 )); return 0 ;;
      h) printf '%s\n' $(( value * 3600 )); return 0 ;;
    esac
  fi

  die "Invalid DEP_UPDATER_BATCH_TIMEOUT: ${raw} (use seconds or Ns/Nm/Nh)"
}

# batch_format_duration <seconds>
# Formats elapsed seconds for WAIT_TIMEOUT lines (e.g. 20m 0s, 4h 5m 3s).
batch_format_duration() {
  local -r sec="$1"
  local hours mins

  if (( sec < 60 )); then
    printf '%ss' "$sec"
    return 0
  fi
  if (( sec < 3600 )); then
    printf '%dm %ss' $(( sec / 60 )) $(( sec % 60 ))
    return 0
  fi
  hours=$(( sec / 3600 ))
  mins=$(( (sec % 3600) / 60 ))
  printf '%dh %dm %ss' "$hours" "$mins" $(( sec % 60 ))
}

# batch_format_timeout_label <seconds>
# Compact timeout label for WAIT_TIMEOUT (e.g. 4h, 90m).
batch_format_timeout_label() {
  local -r sec="$1"

  if (( sec >= 3600 && sec % 3600 == 0 )); then
    printf '%dh' $(( sec / 3600 ))
    return 0
  fi
  if (( sec >= 60 && sec % 60 == 0 )); then
    printf '%dm' $(( sec / 60 ))
    return 0
  fi
  printf '%ss' "$sec"
}

# batch_emit_wait_timeout <elapsed_sec> <limit_sec> [run_log]
# Logs a machine-parseable WAIT_TIMEOUT line to stderr, the batch log, and run_log.
batch_emit_wait_timeout() {
  local -r elapsed_sec="$1"
  local -r limit_sec="$2"
  local -r run_log="${3:-}"
  local elapsed_fmt limit_fmt line

  elapsed_fmt="$(batch_format_duration "$elapsed_sec")"
  limit_fmt="$(batch_format_timeout_label "$limit_sec")"
  line="ERROR: WAIT_TIMEOUT batch-run waited=${elapsed_fmt} timeout=${limit_fmt}"
  printf '%s\n' "$line" >&2
  printf '%s\n' "$line" >>"$log_file"
  if [[ -n "$run_log" ]]; then
    printf '%s\n' "$line" >>"$run_log"
  fi
}

# batch_run_dep_updater_with_deadline <run_log> <updates_report>
# Runs dep-updater under timeout(1); returns exit code (124 = deadline exceeded).
batch_run_dep_updater_with_deadline() {
  local -r run_log="$1"
  local -r updates_report="$2"
  local timeout_sec timeout_spec batch_start batch_end elapsed_sec dep_exit
  local stream_dir
  local stream_fifo stream_tee_pid

  if ! command -v timeout >/dev/null 2>&1; then
    die "timeout(1) is required for batch deadline enforcement but was not found in PATH."
  fi
  if ! command -v mkfifo >/dev/null 2>&1; then
    die "mkfifo(1) is required for streaming batch output but was not found in PATH."
  fi

  timeout_spec="${DEP_UPDATER_BATCH_TIMEOUT:-$batch_timeout_default}"
  timeout_sec="$(batch_timeout_to_sec "$timeout_spec")"
  if (( timeout_sec < 1 )); then
    die "DEP_UPDATER_BATCH_TIMEOUT must be at least 1 second (got: ${timeout_spec})"
  fi

  batch_inner_cmd="timeout --foreground --kill-after=${batch_timeout_kill_after_sec} ${timeout_sec}s ${dep_updater} --batch --all --scan-root ${scan_root}"

  batch_start="$(time_log_now_utc_epoch)"
  stream_dir="$(mktemp -d)"
  _batch_run_stream_dir="$stream_dir"
  stream_fifo="${stream_dir}/dep-updater-output"
  mkfifo "$stream_fifo"
  tee -a "$run_log" "$log_file" <"$stream_fifo" >/dev/null &
  stream_tee_pid=$!

  dep_exit=0
  # Do not put timeout(1) in a pipeline: that hides the timeout exit status and
  # can delay SIGTERM. A FIFO lets tee stream output while timeout remains direct.
  runner_sh "dep-updater batch-all with deadline" \
    "DEP_UPDATER_UPDATES_REPORT=$(printf '%q' "$updates_report") timeout --foreground --kill-after=${batch_timeout_kill_after_sec} ${timeout_sec}s $(printf '%q' "$dep_updater") --batch --all --scan-root $(printf '%q' "$scan_root") >$(printf '%q' "$stream_fifo") 2>&1" \
    || dep_exit=$?
  wait "$stream_tee_pid"
  rm -rf "$stream_dir"
  _batch_run_stream_dir=""

  if [[ "$dep_exit" -eq 124 ]]; then
    batch_end="$(time_log_now_utc_epoch)"
    elapsed_sec=$(( batch_end - batch_start ))
    batch_emit_wait_timeout "$elapsed_sec" "$timeout_sec" "$run_log"
    return 124
  fi

  return "$dep_exit"
}

# batch_apply_config_defaults
# Fills report addresses and local-MTA settings after dep-updater.env is loaded.
batch_apply_config_defaults() {
  if [[ -z "${DEP_UPDATER_REPORT_TO:-}" ]]; then
    DEP_UPDATER_REPORT_TO="johndoe@example.com"
  fi
  if [[ -z "${DEP_UPDATER_REPORT_FROM:-}" ]]; then
    DEP_UPDATER_REPORT_FROM="dep-updater-batch@example.com"
  fi
  if [[ -z "${DEP_UPDATER_REPORT_REPLY_TO:-}" ]]; then
    DEP_UPDATER_REPORT_REPLY_TO="${DEP_UPDATER_REPORT_FROM}"
  fi
  if repo_helpers_smtp_use_sendmail; then
    DEP_UPDATER_USE_SENDMAIL=1
    DEP_UPDATER_SMTP_PORT="${DEP_UPDATER_SMTP_PORT:-25}"
    DEP_UPDATER_SMTP_TLS="${DEP_UPDATER_SMTP_TLS:-plain}"
  fi
  export DEP_UPDATER_REPORT_TO DEP_UPDATER_REPORT_FROM DEP_UPDATER_REPORT_REPLY_TO
  export DEP_UPDATER_USE_SENDMAIL DEP_UPDATER_SMTP_PORT DEP_UPDATER_SMTP_TLS
}

# batch_require_smtp_config
# Verifies mail config after the env file is loaded and defaults are applied.
batch_require_smtp_config() {
  if ! repo_helpers_smtp_configured; then
    die "Incomplete mail config in ${env_file} — set DEP_UPDATER_SMTP_HOST (e.g. localhost)."
  fi
  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' ]]; then
    return 0
  fi
  if repo_helpers_smtp_use_sendmail; then
    if ! command -v sendmail >/dev/null 2>&1; then
      die "sendmail is required for local delivery (DEP_UPDATER_SMTP_HOST=localhost) but was not found in PATH."
    fi
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    die "curl is required for remote SMTP (DEP_UPDATER_SMTP_HOST) but was not found in PATH."
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --print) print_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
done

[[ -x "$dep_updater" ]] || die "dep-updater not found: ${dep_updater}"

batch_load_required_env_file
batch_apply_config_defaults
batch_require_smtp_config

readonly mail_smtp_host_var="DEP_UPDATER_SMTP_HOST"
mail_smtp_host="${!mail_smtp_host_var}"
readonly mail_smtp_host

# batch_run_git_fetch <repo_path>
batch_run_git_fetch() {
  local -r git_dir="$1"
  local name fetch_exit fetch_uuid fetch_stderr rev_exit

  rev_exit=0
  runner_exec "git rev-parse work-tree check" -- git -C "$git_dir" rev-parse --is-inside-work-tree \
    >/dev/null || rev_exit=$?
  if (( rev_exit != 0 )); then
    return 0
  fi

  name="$(basename "$git_dir")"
  printf '[batch-run] git fetch origin (%s)…\n' "$name" >&2
  fetch_exit=0
  run_command "git fetch: ${name}" git -C "$git_dir" fetch --prune origin || fetch_exit=$?
  if [[ "$fetch_exit" -ne 0 ]]; then
    printf 'WARNING: git fetch failed for %s (exit %d)\n' "$name" "$fetch_exit" >&2
    fetch_uuid="$(runner_last_id)"
    if [[ -n "$fetch_uuid" ]]; then
      fetch_stderr="$(runner_read "$fetch_uuid" stderr 2>/dev/null || true)"
      if [[ -n "$fetch_stderr" ]]; then
        printf '%s\n' "$fetch_stderr" >&2
      fi
    fi
    return 1
  fi
  return 0
}

# batch_run_git_fetch_all
batch_run_git_fetch_all() {
  local child fetch_failures

  fetch_failures=0
  batch_run_git_fetch "$repo_dir" || fetch_failures=$(( fetch_failures + 1 ))

  if [[ ! -d "$scan_root" ]]; then
    printf 'WARNING: scan root not found: %s\n' "$scan_root" >&2
    return "$fetch_failures"
  fi

  for child in "$scan_root"/*; do
    [[ -d "$child" ]] || continue
    [[ -e "$child/.git" ]] || continue
    [[ "$child" -ef "$repo_dir" ]] && continue
    batch_run_git_fetch "$child" || fetch_failures=$(( fetch_failures + 1 ))
  done

  return "$fetch_failures"
}

# batch_report_strip_ansi <file>
batch_report_strip_ansi() {
  local -r in_file="$1"
  sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' "$in_file" 2>/dev/null || cat "$in_file"
}

# batch_report_repo_name_from_parens <parens_content>
# Extracts a display name from "(path)" or "(name (12s))" log fragments.
batch_report_repo_name_from_parens() {
  local -r raw="$1"
  local inner
  inner="${raw#(}"
  inner="${inner%%)*}"
  basename "$inner"
}

# batch_report_join_slugs <slug> ...
# Comma-joins repository short names for compact Passed/OK lines.
batch_report_join_slugs() {
  local first=1 slug
  for slug in "$@"; do
    if (( first )); then
      printf '%s' "$slug"
      first=0
    else
      printf ', %s' "$slug"
    fi
  done
}

# batch_report_update_lines <updates_report>
# Reads dep-updater's structured update JSON as tab-separated rows:
# repo_name ecosystem package from to cve_flag cves pr
batch_report_update_lines() {
  local -r updates_report="$1"
  [[ -s "$updates_report" ]] || return 0

  runner_exec "jq batch report updates" --stream-stdout -- jq -r '
    .[]?
    | select(.package != null and .ecosystem != null)
    | [
        (.repo_name // (.repo | split("/") | last) // "-"),
        (.ecosystem // "-"),
        (.package // "-"),
        (.from // "-"),
        (.to // "-"),
        (.cve // "no"),
        (.cves // "-"),
        (if (.pr // "" | tostring | length) == 0 then "-"
         elif (.pr | tostring | startswith("#")) then (.pr | tostring)
         else "#" + (.pr | tostring)
         end)
      ]
    | @tsv
  ' "$updates_report" 2>/dev/null || true
}

# batch_report_collect_final_run_summary_lines <clean_log>
# Prints the last Finished-with-failures (or success) block including summary/details.
batch_report_collect_final_run_summary_lines() {
  local -r clean_log="$1"

  awk '
    function flush() {
      if (finished == "") {
        return
      }
      print finished
      if (summary_hdr != "") {
        print summary_hdr
      }
      for (i = 1; i <= n_summary; i++) {
        print summary[i]
      }
      if (details_hdr != "") {
        print details_hdr
      }
      for (i = 1; i <= n_details; i++) {
        print details[i]
      }
    }
    /\[batch-all\] Finished with failures/ {
      flush()
      finished = $0
      summary_hdr = ""
      details_hdr = ""
      n_summary = 0
      n_details = 0
      in_summary = 0
      in_details = 0
      next
    }
    /\[batch-all\] All repos completed successfully/ {
      flush()
      finished = $0
      summary_hdr = ""
      details_hdr = ""
      n_summary = 0
      n_details = 0
      in_summary = 0
      in_details = 0
      next
    }
    /\[batch-all\] Failure summary:/ {
      if (finished != "") {
        summary_hdr = $0
      }
      in_summary = 1
      in_details = 0
      next
    }
    /\[batch-all\] Failure details:/ {
      if (finished != "") {
        details_hdr = $0
      }
      in_details = 1
      in_summary = 0
      next
    }
    in_summary && /\[batch-all\]   / {
      summary[++n_summary] = $0
      next
    }
    in_details && /\[batch-all\]   / {
      details[++n_details] = $0
      next
    }
    END {
      flush()
    }
  ' "$clean_log"
}

# batch_report_append_repo_failure_details <repo_name> <clean_log> <log_file> <body_lines_array_name> [indent]
# Surfaces CI failures, wait timeouts, and per-command runner failures logged by batch-all.
batch_report_append_repo_failure_details() {
  local -r repo_name="$1"
  local -r clean_log="$2"
  local -r log_file="$3"
  local -n out_lines="$4"
  local -r indent="${5:-    }"
  # Initialize expansions used under set -u before optional assignment (issue #401).
  local ci_line='' pr_url='' check_url='' cause_line='' cmd_line='' detail_text=''
  local parsed_pr_url='' parsed_check_url='' timeout_detail='' summary_cause=''
  local ci_detail_re ci_pr_re
  local detail_indent="${indent}  "
  local -a cmd_lines=() detail_lines=()
  ci_detail_re='^pr=#([0-9]+) (.+) \(([^)]+)\)$'
  ci_pr_re='^pr=#([0-9]+)'

  while IFS= read -r detail_text; do
    [[ -n "$detail_text" ]] || continue
    detail_lines+=("$detail_text")
  done < <(rg "\[batch-all\]   ${repo_name}:" "$clean_log" 2>/dev/null \
    | sed "s/^.*\\[batch-all\\]   ${repo_name}: //" || true)

  for detail_text in "${detail_lines[@]}"; do
    [[ "$detail_text" == *WAIT_TIMEOUT* ]] || continue
    timeout_detail="$detail_text"
    break
  done
  if [[ -z "${timeout_detail:-}" ]]; then
    timeout_detail="$(rg -m1 "\[batch-all\]   ${repo_name}: exit [0-9]+ — .*WAIT_TIMEOUT" "$clean_log" 2>/dev/null \
      | sed "s/^.*\\[batch-all\\]   ${repo_name}: exit [0-9]* — //" || true)"
  fi
  if [[ -n "${timeout_detail:-}" ]]; then
    if [[ "$timeout_detail" =~ pr=#([0-9]+) ]]; then
      cause_line="CI wait timed out on PR #${BASH_REMATCH[1]}"
    else
      cause_line="Wait timed out — ${timeout_detail}"
    fi
    out_lines+=("${indent}Cause: ${cause_line}")
    for detail_text in "${detail_lines[@]}"; do
      [[ -z "$pr_url" ]] && parsed_pr_url="$(sed -n 's/.* pr_url=\([^ ]*\).*/\1/p' <<<"$detail_text")"
      [[ -n "$parsed_pr_url" ]] && pr_url="$parsed_pr_url"
    done
    if [[ -z "$pr_url" ]]; then
      pr_url="$(rg -m1 "^\[batch-all\] CI failure-link \\(${repo_name}\\) pr: " "$clean_log" 2>/dev/null \
        | sed "s/^\\[batch-all\\] CI failure-link (${repo_name}) pr: //" || true)"
    fi
    if [[ -n "$pr_url" ]]; then
      out_lines+=("${indent}PR: ${pr_url}")
    fi
    return 0
  fi

  ci_line="$(rg -m1 "^\[batch-all\] CI failure \\(${repo_name}\\): " "$clean_log" 2>/dev/null \
    | sed "s/^\\[batch-all\\] CI failure (${repo_name}): //" || true)"
  if [[ -z "$ci_line" && ${#detail_lines[@]} -gt 0 ]]; then
    for detail_text in "${detail_lines[@]}"; do
      [[ "$detail_text" == *'CI failed'* || "$detail_text" == *'pr=#'* ]] || continue
      if [[ "$detail_text" == *' — '* ]]; then
        ci_line="${detail_text#* — }"
      else
        ci_line="$detail_text"
      fi
      ci_line="${ci_line#CI failed: }"
      break
    done
  fi
  if [[ -n "$ci_line" ]]; then
    pr_url="$(rg -m1 "^\[batch-all\] CI failure-link \\(${repo_name}\\) pr: " "$clean_log" 2>/dev/null \
      | sed "s/^\\[batch-all\\] CI failure-link (${repo_name}) pr: //" || true)"
    check_url="$(rg -m1 "^\[batch-all\] CI failure-link \\(${repo_name}\\) check: " "$clean_log" 2>/dev/null \
      | sed "s/^\\[batch-all\\] CI failure-link (${repo_name}) check: //" || true)"
    if [[ -z "$pr_url" || -z "$check_url" ]]; then
      for detail_text in "${detail_lines[@]}"; do
        [[ -z "$pr_url" ]] && parsed_pr_url="$(sed -n 's/.* pr_url=\([^ ]*\).*/\1/p' <<<"$detail_text")"
        [[ -n "$parsed_pr_url" ]] && pr_url="$parsed_pr_url"
        [[ -z "$check_url" ]] && parsed_check_url="$(sed -n 's/.* url=\([^ ]*\).*/\1/p' <<<"$detail_text")"
        [[ -n "$parsed_check_url" ]] && check_url="$parsed_check_url"
      done
    fi
    if [[ "$ci_line" =~ $ci_detail_re ]]; then
      cause_line="CI failed on PR #${BASH_REMATCH[1]} — ${BASH_REMATCH[2]} (${BASH_REMATCH[3]})"
    elif [[ "$ci_line" =~ $ci_pr_re ]]; then
      cause_line="CI failed on PR #${BASH_REMATCH[1]}"
    elif [[ "$ci_line" =~ check=([^[:space:]]+)[[:space:]]+conclusion=([^[:space:]]+) ]]; then
      cause_line="CI failed — ${BASH_REMATCH[1]} (${BASH_REMATCH[2]})"
    else
      cause_line="CI failed — ${ci_line}"
    fi
    out_lines+=("${indent}Cause: ${cause_line}")
    if [[ -n "$pr_url" ]]; then
      out_lines+=("${indent}PR: ${pr_url}")
    fi
    if [[ -n "$check_url" ]]; then
      out_lines+=("${indent}Check run: ${check_url}")
    fi
    if [[ -z "$pr_url" && -z "$check_url" ]]; then
      out_lines+=("${indent}See log file for full output:")
      out_lines+=("${detail_indent}${log_file}")
    fi
    return 0
  fi

  if [[ ${#detail_lines[@]} -gt 0 ]]; then
    out_lines+=("${indent}Cause: ${detail_lines[0]}")
    if [[ ${#detail_lines[@]} -gt 1 ]]; then
      out_lines+=("${indent}Details:")
      for detail_text in "${detail_lines[@]:1}"; do
        out_lines+=("${detail_indent}- ${detail_text}")
      done
    fi
    return 0
  fi

  while IFS= read -r cmd_line; do
    [[ -n "$cmd_line" ]] || continue
    cmd_lines+=("$cmd_line")
  done < <(rg "^\[batch-all\] Command failure \\(${repo_name}\\): " "$clean_log" 2>/dev/null \
    | sed "s/^\\[batch-all\\] Command failure (${repo_name}): //" || true)

  if [[ ${#cmd_lines[@]} -gt 0 ]]; then
    out_lines+=("${indent}Failed commands:")
    for cmd_line in "${cmd_lines[@]}"; do
      out_lines+=("${detail_indent}- ${cmd_line}")
    done
    return 0
  fi

  summary_cause="$(rg -m1 "\[batch-all\]   ${repo_name}: exit " "$clean_log" 2>/dev/null \
    | sed "s/^.*\\[batch-all\\]   ${repo_name}: //" || true)"
  if [[ -n "$summary_cause" ]]; then
    out_lines+=("${indent}Cause: ${summary_cause}")
    return 0
  fi

  out_lines+=("${indent}See log file for full output:")
  out_lines+=("${detail_indent}${log_file}")
}

# batch_report_build <clean_log> <exit_code> <started_at> <finished_at> [updates_report]
# Builds a notifier-style plain-text report body.
batch_report_build() {
  local -r clean_log="$1"
  local -r run_exit="$2"
  local -r started_at="$3"
  local -r finished_at="$4"
  local -r updates_report="${5:-}"
  local ok_count fail_count update_count entry sline repo_name joined_slugs
  local update_repo update_eco update_pkg update_from update_to update_cve update_cves update_pr u_repo
  local run_cmd has_structured_failures=0 miss_slug
  local -a ok_lines fail_lines update_lines summary_lines body_lines
  local -a archived_org_slugs=() missing_clone_slugs=() not_in_org_slugs=()
  local -a ok_no_update=() private_org_slugs=() update_repo_order=()
  declare -A repos_with_updates=()

  ok_lines=()
  fail_lines=()
  update_lines=()
  while IFS= read -r repo_line; do
    [[ -n "$repo_line" ]] || continue
    ok_lines+=("$repo_line")
  done < <(rg -o '\[batch-all\] OK \([^)]+\)' "$clean_log" 2>/dev/null \
    | sed 's/^\[batch-all\] OK //' || true)
  while IFS= read -r repo_line; do
    [[ -n "$repo_line" ]] || continue
    fail_lines+=("$repo_line")
  done < <(rg -o '\[batch-all\] FAILED \([^)]+\) exit [0-9]+' "$clean_log" 2>/dev/null \
    | sed 's/^\[batch-all\] FAILED //' || true)
  if [[ -n "$updates_report" ]]; then
    while IFS= read -r repo_line; do
      [[ -n "$repo_line" ]] || continue
      update_lines+=("$repo_line")
    done < <(batch_report_update_lines "$updates_report")
  fi

  ok_count=${#ok_lines[@]}
  fail_count=${#fail_lines[@]}
  update_count=${#update_lines[@]}

  body_lines=()
  if rg -qF 'ERROR: WAIT_TIMEOUT batch-run' "$clean_log" 2>/dev/null; then
    body_lines+=("The Dependency Updater batch run exceeded its deadline and was stopped.")
    body_lines+=("Child processes were terminated; no batch job should remain running.")
  elif (( run_exit == 0 && fail_count == 0 )); then
    body_lines+=("The Dependency Updater batch run completed successfully (${ok_count} repositories).")
  elif (( fail_count > 0 )); then
    body_lines+=("The Dependency Updater batch run finished with failures.")
    body_lines+=("See the Failed section below for details.")
  else
    body_lines+=("The Dependency Updater batch run exited with an error.")
    body_lines+=("See the log excerpt below.")
  fi
  body_lines+=("")
  body_lines+=("$report_separator")
  body_lines+=("")

  for entry in "${update_lines[@]}"; do
    IFS=$'\t' read -r update_repo update_eco update_pkg update_from update_to \
      update_cve update_cves update_pr <<<"$entry"
    if [[ -z "${repos_with_updates[$update_repo]:-}" ]]; then
      repos_with_updates["$update_repo"]=1
      update_repo_order+=("$update_repo")
    fi
  done

  for entry in "${ok_lines[@]}"; do
    repo_name="$(batch_report_repo_name_from_parens "$entry")"
    if [[ -z "${repos_with_updates[$repo_name]:-}" ]]; then
      ok_no_update+=("$repo_name")
    fi
  done

  body_lines+=("OK (no updates):")
  if [[ ${#ok_no_update[@]} -gt 0 ]]; then
    joined_slugs="$(batch_report_join_slugs "${ok_no_update[@]}")"
    body_lines+=("  ${joined_slugs}")
  else
    body_lines+=("  none")
  fi
  body_lines+=("")

  missing_clone_slugs=()
  while IFS= read -r miss_slug; do
    [[ -n "$miss_slug" ]] || continue
    missing_clone_slugs+=("$miss_slug")
  done < <(
    rg -o '\[batch-all\] Skipping [^:]+: no local clone under scan roots' "$clean_log" 2>/dev/null \
      | sed -E 's/^\[batch-all\] Skipping ([^:]+): no local clone under scan roots$/\1/' \
      | sort -u || true
  )
  body_lines+=("Skipped (no local clone):")
  if [[ ${#missing_clone_slugs[@]} -gt 0 ]]; then
    joined_slugs="$(batch_report_join_slugs "${missing_clone_slugs[@]}")"
    body_lines+=("  ${joined_slugs}")
  else
    body_lines+=("  none")
  fi
  body_lines+=("")

  not_in_org_slugs=()
  while IFS= read -r miss_slug; do
    [[ -n "$miss_slug" ]] || continue
    not_in_org_slugs+=("$miss_slug")
  done < <(
    rg -o '\[batch-all\] Skipping [^:]+: local clone not in org membership' "$clean_log" 2>/dev/null \
      | sed -E 's/^\[batch-all\] Skipping ([^:]+): local clone not in org membership$/\1/' \
      | sort -u || true
  )
  body_lines+=("Skipped (clone not in org):")
  if [[ ${#not_in_org_slugs[@]} -gt 0 ]]; then
    joined_slugs="$(batch_report_join_slugs "${not_in_org_slugs[@]}")"
    body_lines+=("  ${joined_slugs}")
  else
    body_lines+=("  none")
  fi
  body_lines+=("")

  private_org_slugs=()
  while IFS= read -r miss_slug; do
    [[ -n "$miss_slug" ]] || continue
    private_org_slugs+=("$miss_slug")
  done < <(
    rg -o '\[batch-all\] Skipping [^:]+: private org repository \(use --include-private\)' \
      "$clean_log" 2>/dev/null \
      | sed -E \
        's/^\[batch-all\] Skipping ([^:]+): private org repository \(use --include-private\)$/\1/' \
      | sort -u || true
  )
  body_lines+=("Skipped (private org repo):")
  if [[ ${#private_org_slugs[@]} -gt 0 ]]; then
    joined_slugs="$(batch_report_join_slugs "${private_org_slugs[@]}")"
    body_lines+=("  ${joined_slugs}")
  else
    body_lines+=("  none")
  fi
  body_lines+=("")

  archived_org_slugs=()
  while IFS= read -r miss_slug; do
    [[ -n "$miss_slug" ]] || continue
    archived_org_slugs+=("$miss_slug")
  done < <(
    rg -o '\[batch-all\] Skipping [^:]+: archived org repository' "$clean_log" 2>/dev/null \
      | sed -E 's/^\[batch-all\] Skipping ([^:]+): archived org repository$/\1/' \
      | sort -u || true
  )
  body_lines+=("Skipped (archived org repo):")
  if [[ ${#archived_org_slugs[@]} -gt 0 ]]; then
    joined_slugs="$(batch_report_join_slugs "${archived_org_slugs[@]}")"
    body_lines+=("  ${joined_slugs}")
  else
    body_lines+=("  none")
  fi
  body_lines+=("")

  if (( update_count > 0 )); then
    body_lines+=("Updated:")
    for update_repo in "${update_repo_order[@]}"; do
      body_lines+=("  ${update_repo}:")
      for entry in "${update_lines[@]}"; do
        IFS=$'\t' read -r u_repo update_eco update_pkg update_from update_to \
          update_cve update_cves update_pr <<<"$entry"
        [[ "$u_repo" == "$update_repo" ]] || continue
        sline="    - ${update_eco} ${update_pkg} ${update_from} → ${update_to}"
        if [[ "$update_cve" == "yes" ]]; then
          sline="${sline} (CVE: ${update_cves})"
        fi
        if [[ -n "$update_pr" && "$update_pr" != "#-" ]]; then
          sline="${sline} (${update_pr})"
        fi
        body_lines+=("$sline")
      done
    done
    body_lines+=("")
  fi

  if (( fail_count > 0 )); then
    body_lines+=("Failed:")
    for entry in "${fail_lines[@]}"; do
      repo_name="$(batch_report_repo_name_from_parens "$entry")"
      body_lines+=("  ${repo_name}:")
      batch_report_append_repo_failure_details "$repo_name" "$clean_log" "$log_file" body_lines
      if rg -qF "[batch-all] CI failure (${repo_name}):" "$clean_log" 2>/dev/null; then
        has_structured_failures=1
      fi
      body_lines+=("")
    done
    body_lines+=("")
  fi

  summary_lines=()
  while IFS= read -r repo_line; do
    [[ -n "$repo_line" ]] || continue
    summary_lines+=("$repo_line")
  done < <(batch_report_collect_final_run_summary_lines "$clean_log" 2>/dev/null || true)

  if [[ ${#summary_lines[@]} -gt 0 ]]; then
    body_lines+=("Run summary:")
    body_lines+=("")
    for sline in "${summary_lines[@]}"; do
      if [[ "$sline" =~ \[batch-all\][[:space:]]+(.*)$ ]]; then
        body_lines+=("  ${BASH_REMATCH[1]}")
      else
        body_lines+=("  ${sline}")
      fi
    done
    body_lines+=("")
  fi

  if (( run_exit != 0 )) && [[ "$has_structured_failures" -eq 0 ]]; then
    body_lines+=("--- last 80 lines of log ---")
    body_lines+=("")
    while IFS= read -r sline || [[ -n "$sline" ]]; do
      body_lines+=("  ${sline}")
    done < <(tail -n 80 "$clean_log" 2>/dev/null || true)
    body_lines+=("")
  fi

  body_lines+=("$report_separator")
  body_lines+=("")

  run_cmd="${batch_wrapper_cmd}"
  if [[ -n "$batch_inner_cmd" ]]; then
    run_cmd="${run_cmd} (runs: ${batch_inner_cmd})"
  fi
  body_lines+=("$(
    repo_helpers_run_context_footer_full \
      "$run_cmd" "$repo_dir" "$started_at" "$finished_at" "$log_file" "$report_separator"
  )")

  printf '%s\n' "${body_lines[@]}"
}

# batch_report_send_email <subject> <body>
batch_report_send_email() {
  local -r subject="$1"
  local -r body="$2"
  local from_addr to_addr reply_to

  from_addr="${DEP_UPDATER_REPORT_FROM}"
  to_addr="${DEP_UPDATER_REPORT_TO}"
  reply_to="${DEP_UPDATER_REPORT_REPLY_TO:-$from_addr}"

  repo_helpers_email_write_multipart "$to_addr" "$from_addr" "$reply_to" "$subject" "$body" \
    'dep-updater-batch' \
    | repo_helpers_smtp_send "$from_addr" "$to_addr"
}

run_exit=0
started_at=""
finished_at=""
body=""
subject=""
clean_log=""

started_at="$(date '+%Y-%m-%d %H:%M %z %Z')"
batch_wrapper_cmd="${BASH_SOURCE[0]}"
if (( print_only == 1 )); then
  batch_wrapper_cmd+=" --print"
fi

if (( print_only == 1 )); then
  clean_log="$(mktemp)"
  # shellcheck disable=SC2016
  printf '[batch-all] OK (demo-repo) (12s)\n[batch-all] All repos completed successfully.\n' >"$clean_log"
  run_exit=0
  finished_at="$(date '+%Y-%m-%d %H:%M %z %Z')"
  body="$(batch_report_build "$clean_log" "$run_exit" "$started_at" "$finished_at")"
  subject="${subject_prefix} success (demo)"
  rm -f "$clean_log"
  repo_helpers_email_write_multipart "${DEP_UPDATER_REPORT_TO}" "${DEP_UPDATER_REPORT_FROM}" \
    "${DEP_UPDATER_REPORT_REPLY_TO:-${DEP_UPDATER_REPORT_FROM}}" "$subject" "$body" \
    'dep-updater-batch'
  exit 0
fi

mkdir -p "$(dirname "$log_file")"

timer_singleton_acquire_lock "$lock_file" "$log_file" 'dep-updater batch'

batch_run_git_fetch_all || true

run_log="$(mktemp)"
clean_log="$(mktemp)"
updates_report="$(mktemp)"

run_exit=0
batch_run_dep_updater_with_deadline "$run_log" "$updates_report" || run_exit=$?

batch_report_strip_ansi "$run_log" >"$clean_log"
rm -f "$run_log"
run_log=""

finished_at="$(date '+%Y-%m-%d %H:%M %z %Z')"
body="$(batch_report_build "$clean_log" "$run_exit" "$started_at" "$finished_at" "$updates_report")"
rm -f "$clean_log" "$updates_report"
clean_log=""
updates_report=""

if (( run_exit == 0 )); then
  subject="${subject_prefix} batch completed successfully"
elif (( run_exit == 124 )); then
  subject="${subject_prefix} batch TIMEOUT (deadline exceeded)"
else
  subject="${subject_prefix} batch FAILED (exit ${run_exit})"
fi

if batch_report_send_email "$subject" "$body"; then
  if repo_helpers_smtp_use_sendmail; then
    printf 'Sent batch report to %s via sendmail (localhost)\n' \
      "${DEP_UPDATER_REPORT_TO}" >&2
  else
    printf 'Sent batch report to %s via %s\n' \
      "${DEP_UPDATER_REPORT_TO}" "$mail_smtp_host" >&2
  fi
else
  if repo_helpers_smtp_use_sendmail; then
    die "sendmail delivery failed (localhost)"
  else
    die "SMTP send failed (host=${mail_smtp_host})"
  fi
fi

exit "$run_exit"
