#!/usr/bin/env bash
# scripts/ensure-pr-conventional-title — validate/fix PR title for release-please.
#
# When the repo squash-merges with squash_merge_commit_title=PR_TITLE and
# squash_merge_commit_message=BLANK, the PR title is the entire squash commit
# message. This tool ensures the title is a Conventional Commits header
# (feat|fix|chore|…), deriving from PR commits when possible.
#
# Usage:
#   scripts/ensure-pr-conventional-title --pr <n> [--repo OWNER/NAME] [--dry-run]
#   scripts/ensure-pr-conventional-title --help
#
# See repository-helpers#651.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/pr-conventional-title"
# shellcheck disable=SC1091
source "${script_dir}/lib/github-repo-slug"

pr_number=''
repo_slug=''
dry_run=0

usage() {
  cat <<'EOF'
Usage: scripts/ensure-pr-conventional-title --pr <n> [--repo OWNER/NAME] [--dry-run]

When the repo uses squash merge with PR_TITLE + BLANK, ensure the PR title is a
Conventional Commits header. Non-compliant titles are derived from the most
releasable commit subject (feat > fix > other) and applied via gh pr edit
(unless --dry-run).

Skips when squash settings do not make the PR title the release-please signal.

Options:
  --pr N              Pull request number (required)
  --repo OWNER/NAME   Repository slug (default: origin of cwd)
  --dry-run           Report what would change; do not edit
  --help              Show this help
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --pr)
        [[ $# -ge 2 ]] || die '--pr requires a number'
        pr_number="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || die '--repo requires OWNER/NAME'
        repo_slug="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done
}

main() {
  local root ensure_args

  parse_args "$@"
  [[ -n "$pr_number" ]] || die '--pr is required'
  [[ "$pr_number" =~ ^[0-9]+$ ]] || die "--pr must be a positive integer (got ${pr_number})"

  if [[ -z "$repo_slug" ]]; then
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || die 'not in a git repo; pass --repo OWNER/NAME'
    repo_slug="$(gh_slug_from_origin_url "$(git -C "$root" remote get-url origin)")" \
      || die 'could not resolve origin OWNER/NAME; pass --repo'
  fi

  ensure_args=("$repo_slug" "$pr_number")
  if (( dry_run )); then
    ensure_args+=(--dry-run)
  fi
  pr_cc_ensure_pr_title "${ensure_args[@]}"
}

main "$@"
