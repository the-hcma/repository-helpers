#!/usr/bin/env bash
# check-repo-practices — deprecated wrapper for github-repo-lint.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

printf 'WARN: scripts/check-repo-practices is renamed to scripts/github-repo-lint\n' >&2
exec "${script_dir}/github-repo-lint" "$@"
