#!/usr/bin/env bash
# check-repo-practices — Audit and suggest org GitHub conventions for repositories.
#
# Covers merge settings, Graphite merge-queue wiring, and branch cleanup workflows.
# Use --new-repo when onboarding a repository into the org standards.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/repo-practices"

rp_main 'check-repo-practices' "$@"
