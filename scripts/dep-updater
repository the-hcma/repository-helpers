# Populated by detect_ci_workflows(); empty means "all runs" (fallback).
ci_workflow_names=""
# Newline-separated required status contexts from ci.yml (job name or display name).
ci_required_contexts=""

# Set after detect_ecosystem
has_npm=0
npm_tool=""
# When set, npm manifests live under "${dir}/${npm_project_prefix}/" (single
# nested project, e.g. web/package.json with Python at repo root).
npm_project_prefix=""
