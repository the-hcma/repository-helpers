# ---------------------------------------------------------------------------
# Utility functions
# ---------------------------------------------------------------------------

is_interactive() {
  # Returns 0 (true) if stdin is a TTY and we're not in a non-interactive flag mode
  [[ -t 0 ]] && [[ "$dry_run" == '0' ]]
}

init_prompt_style() {
  if [[ -n "${NO_COLOR:-}" ]]; then
    return 0
  fi

  local term_value
  term_value="${TERM:-}"
  if [[ "$term_value" == "dumb" || -z "$term_value" ]]; then
    return 0
  fi

  # Only check for a TTY — colour is useful in dry-run too; we just skip
  # the interactive prompt colours when stdin is not a TTY.
  if [[ ! -t 2 ]]; then
    return 0
  fi

  # Cyan log lines so our output is visually distinct from tool output.
  log_color='\033[0;36m'
  log_reset='\033[0m'

  # Blue prompt text for interactive questions — only when truly interactive.
  if is_interactive; then
    prompt_color='\033[1;34m'
    prompt_color_reset='\033[0m'
  fi
}

prompt_yes_no() {
  local -r question="$1"
  local -r default="${2:-n}"

  if ! is_interactive; then
    return 1  # Non-interactive; assume "no"
  fi

  local prompt_text="$question"
  case "$default" in
    y) prompt_text="${prompt_text} [Y/n] " ;;
    n) prompt_text="${prompt_text} [y/N] " ;;
    *) prompt_text="${prompt_text} [y/n] " ;;
  esac

  if [[ -n "$prompt_color" ]]; then
    printf '%b%s%b' "$prompt_color" "$prompt_text" "$prompt_color_reset" >&2
  else
    printf '%s' "$prompt_text" >&2
  fi
  read -r -s -n 1 response
  printf '\n' >&2

  case "$response" in
    Y|y) return 0 ;;
    N|n) return 1 ;;
    '') [[ "$default" == "y" ]] ;;
    *)   return 1 ;;
  esac
}

# Checks if the Graphite stack needs rebasing on main
# Returns 0 (true) if stack needs restack, 1 (false) if up-to-date
stack_needs_rebase() {
  local branches_csv gt_state_json
  branches_csv="$(state_get "branches")"
  [[ -z "$branches_csv" ]] && return 1

  # Strict signal: gt state JSON (stable and branch-specific).
  gt_state_json="$(run_in_worktree gt state 2>/dev/null || true)"
  if [[ -z "$gt_state_json" ]]; then
    die "Could not read Graphite state (empty output from 'gt state')."
  fi

  if ! dep_runner_jq_with_args "dep-updater gt state validate" "$gt_state_json" -e . >/dev/null 2>&1; then
    die "Could not parse Graphite state JSON from 'gt state'."
  fi

  # shellcheck disable=SC2016  # jq filter uses $csv variable, not shell expansion
  if dep_runner_jq_with_args "dep-updater gt state needs restack" "$gt_state_json" -e --arg csv "$branches_csv" '
        ($csv | split(",") | map(select(length > 0))) as $branches
        | any($branches[]; (. [.]?.needs_restack // false) == true)
      ' >/dev/null; then
    return 0
  fi
  return 1
}

log_stack_rebase_context() {
  local branches_csv current_branch gt_state_json needs_restack_lines

  branches_csv="$(state_get "branches")"
  current_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current 2>/dev/null || true)"

  if dep_stacking_is_gh_stack; then
    log "Stack may be behind origin/main."
    log "  worktree: $worktree_path"
    if [[ -n "$current_branch" ]]; then
      log "  current branch: $current_branch"
    fi
    if [[ -n "$branches_csv" ]]; then
      log "  tracked stack branches: $branches_csv"
    fi
    return 0
  fi

  gt_state_json="$(run_in_worktree gt state 2>/dev/null || true)"

  if [[ -z "$gt_state_json" ]]; then
    die "Could not read Graphite state for rebase diagnostics (empty output from 'gt state')."
  fi

  if ! dep_runner_jq_with_args "dep-updater gt state validate rebase ctx" "$gt_state_json" -e . >/dev/null 2>&1; then
    die "Could not parse Graphite state JSON for rebase diagnostics."
  fi

  # shellcheck disable=SC2016  # jq filter uses $csv variable, not shell expansion
  needs_restack_lines="$(dep_runner_jq_with_args "dep-updater gt state restack lines" "$gt_state_json" -r --arg csv "$branches_csv" '
        ($csv | split(",") | map(select(length > 0))) as $branches
        | [
            $branches[] as $b
            | select((.[ $b ]?.needs_restack // false) == true)
            | "\($b) (needs_restack=true)"
          ]
        | .[]?
      ' 2>/dev/null || true)"

  log "Stack needs rebase on main."
  log "  worktree: $worktree_path"
  if [[ -n "$current_branch" ]]; then
    log "  current branch: $current_branch"
  fi
  if [[ -n "$branches_csv" ]]; then
    log "  tracked stack branches: $branches_csv"
  fi

  if [[ -n "$needs_restack_lines" ]]; then
    log "  reason (Graphite):"
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      log "    - ${line}"
    done <<< "$needs_restack_lines"
  fi

  if [[ -n "$branches_csv" ]]; then
    local first_branch left_only right_only
    first_branch="$(cut -d',' -f1 <<< "$branches_csv")"
    if [[ -n "$first_branch" ]] \
      && run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${first_branch}" \
      && run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet "refs/remotes/origin/main"; then
      left_only="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-list --left-only --count "${first_branch}...origin/main" 2>/dev/null || echo 0)"
      right_only="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-list --right-only --count "${first_branch}...origin/main" 2>/dev/null || echo 0)"
      log "  reason (commit delta):"
      log "    - commits on stack base not on origin/main: ${left_only}"
      log "    - commits on origin/main not on stack base: ${right_only}"
      if [[ "$right_only" != '0' ]]; then
        log "    - origin/main has moved ahead of the stack base."
      fi
    fi
  fi
}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

die() {
  record_first_failure "$*"
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# dep_updater_early_init
# Runner session + first-failure file before PATH bootstrap or parse_args so
# batch-all children can emit DEP_UPDATER_RUN_REPORT when startup fails early.
dep_updater_early_init() {
  RUNNER_FIRST_FAILURE_FILE="$(mktemp)"
  export RUNNER_FIRST_FAILURE_FILE
  # Each dep-updater process owns its own runner session. Parent wrappers
  # (batch-run, batch-all) export RUNNER_SESSION_DIR; sharing would aggregate
  # expected probe failures from every repo into one email dump.
  unset RUNNER_SESSION_DIR
  runner_session_begin
}

# dep_updater_bootstrap_path
# Interactive / cron PATH: local bin, GNU userland, pnpm, fnm, Node alignment.
dep_updater_bootstrap_path() {
  if ! tooling_path_bootstrap_node_ecosystem; then
    die "PATH bootstrap failed: install GNU userland and Node/pnpm tooling, then retry."
  fi
}

# Tooling / prerequisite lines must reach stderr even when TIME_LOG_ENABLED=0
# (--quiet / --report-json).  Otherwise dep-updater-notifier and cron only see
# the final die() line with no missing-tool context.
# shellcheck disable=SC2317,SC2329  # invoked indirectly via tooling_prereq_emit in lib/tooling-prereqs
log_prereq() {
  printf '%s\n' "$*" >&2
}

# shellcheck disable=SC1091
source "${dep_script_dir}/lib/tooling-prereqs"
# shellcheck disable=SC1091
source "${dep_script_dir}/lib/gnu-sed"

wait_timeout_error() {
  # Emit a single concise line suitable for batch-all postprocessing.
  # Example: "ERROR: WAIT_TIMEOUT ci pr=#123 branch=foo waited=20m0s timeout=20m status=pending"
  record_first_failure "WAIT_TIMEOUT $*"
  log "ERROR: WAIT_TIMEOUT $*"
}

# Commit in the worktree, inheriting the signing config (gpg/ssh) from the
# source repo's effective config.  Without this, commits made in the worktree
# may be unsigned even when the user has commit.gpgsign=true in their repo or
# global git config, because git -C <worktree> can resolve the config but the
# GPG/SSH agent environment may differ from the calling shell's context.
_worktree_commit() {
  local -r msg="$1"
  local -a sign_flags=()
  local gpg_sign gpg_format sign_key
  gpg_sign="$(dep_runner_git_c_stdout "git repo" "$dir" -- config --bool commit.gpgsign 2>/dev/null || echo 'false')"
  if [[ "$gpg_sign" == 'true' ]]; then
    sign_flags+=('-c' 'commit.gpgsign=true')
    gpg_format="$(dep_runner_git_c_stdout "git repo" "$dir" -- config gpg.format 2>/dev/null || true)"
    [[ -n "$gpg_format" ]] && sign_flags+=('-c' "gpg.format=${gpg_format}")
    sign_key="$(dep_runner_git_c_stdout "git repo" "$dir" -- config commit.signingkey 2>/dev/null || true)"
    [[ -n "$sign_key" ]] && sign_flags+=('-c' "commit.signingkey=${sign_key}")
    log "[commit] GPG signing enabled (format: ${gpg_format:-default}, key: ${sign_key:-(from agent)})"
  else
    log "[commit] GPG signing disabled"
  fi
  run_command "git worktree" git -C "$worktree_path" "${sign_flags[@]}" commit -m "$msg"
}

# ---------------------------------------------------------------------------
# Exit / signal traps — clean up the worktree on unexpected death
# (Registered in main(); defined here so they can reference cleanup_on_error.)
# ---------------------------------------------------------------------------

# shellcheck disable=SC2317,SC2329  # invoked via EXIT trap, not directly
_on_exit() {
  local exit_code=$?
  local first_fail_for_report reason
  first_fail_for_report=""
  # Reset the EXIT trap immediately so cleanup_on_error can't re-trigger it.
  trap - EXIT
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" && -s "${RUNNER_FIRST_FAILURE_FILE}" ]]; then
    first_fail_for_report="$(cat "${RUNNER_FIRST_FAILURE_FILE}")"
  fi
  # Write the batch-all child report before any cleanup that deletes eco-failure state.
  if [[ -n "${DEP_UPDATER_RUN_REPORT:-}" ]]; then
    dep_updater_write_batch_child_report_json "$exit_code" "$first_fail_for_report"
  fi
  rm -f "${DEP_UPDATER_ECO_FAIL_FILE:-}"
  # Only run cleanup if the worktree phase was reached and the exit is non-zero.
  if [[ "$_cleanup_trap_active" == '1' && $exit_code -ne 0 ]]; then
    # Use the first recorded failure reason if available — it contains the real
    # error (e.g. "pnpm: no matching version") rather than a generic wrapper.
    reason="script exited unexpectedly (exit code ${exit_code})"
    if [[ -n "$first_fail_for_report" ]]; then
      reason="$first_fail_for_report"
    fi
    cleanup_on_error "$reason"
  elif [[ "$_primary_preserve_active" == '1' ]]; then
    primary_repo_recover || true
  fi
  rm -f "${RUNNER_FIRST_FAILURE_FILE:-}"
}

# shellcheck disable=SC2317,SC2329  # invoked via INT/TERM traps, not directly
_on_signal() {
  local sig="$1"
  # Reset all traps before re-raising so we don't loop back into this handler.
  trap - EXIT INT TERM
  if [[ "$_cleanup_trap_active" == '1' ]]; then
    log ""
    log "Interrupted (SIG${sig}) — cleaning up…"
    cleanup_on_error "interrupted by SIG${sig}"
  elif [[ "$_primary_preserve_active" == '1' ]]; then
    primary_repo_recover || true
  fi
  # Re-raise with the conventional signal exit code so the caller's $? is right.
  kill -s "$sig" "$$"
}

# ---------------------------------------------------------------------------
# Stacking-tool dispatch (Graphite vs gh-stack)
# ---------------------------------------------------------------------------

dep_init_stacking_tool() {
  # Missing marker → gh-stack (logged); invalid → die via stacking-tool.
  # Distinct from stacking_tool_org_default (graphite) used by apply-fix.
  dep_stacking_tool="$(stacking_tool_read_or_default \
    "$dir" "$stacking_tool_value_gh_stack" "dep-updater")"
}

dep_stacking_is_graphite() {
  [[ "$dep_stacking_tool" == "$stacking_tool_value_graphite" ]]
}

dep_stacking_is_gh_stack() {
  [[ "$dep_stacking_tool" == "$stacking_tool_value_gh_stack" ]]
}

# Rebuild local gh-stack tracking for prior state branches + the current branch
# (created via git checkout -b). Uses ``unstack --local`` so already-submitted
# GitHub stacks are not torn down. Trunk is ``main`` (same as Graphite
# ``gt track -p main`` when the parent is the throwaway wt base branch).
dep_stack_gh_stack_adopt_current() {
  local current_branch branches_csv quoted_wt quoted_branches bottom_branch
  local view_ok=0
  local -a ordered=()
  local branch

  current_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" \
    -- branch --show-current)"
  if [[ -z "$current_branch" ]]; then
    die "gh-stack adopt: could not determine current branch in ${worktree_path}"
  fi

  branches_csv="$(state_get "branches")"
  if [[ -n "$branches_csv" ]]; then
    IFS=',' read -r -a ordered <<< "$branches_csv"
  fi
  if ! csv_contains "${branches_csv:-}" "$current_branch"; then
    ordered+=("$current_branch")
  fi
  if (( ${#ordered[@]} == 0 )); then
    die "gh-stack adopt: no branches to register"
  fi

  bottom_branch="${ordered[0]}"
  quoted_wt="$(printf '%q' "$worktree_path")"
  quoted_branches=''
  for branch in "${ordered[@]}"; do
    quoted_branches+=" $(printf '%q' "$branch")"
  done

  # Clear local tracking only when a stack already exists (multi-layer rebuild).
  # Keep runner_sh label+script on one line for the runner-adoption ratchet.
  if run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet \
    "refs/heads/${bottom_branch}"; then
    view_ok=0
    if runner_sh "dep-updater probe gh stack view" --probe -- "cd ${quoted_wt} && git checkout $(printf '%q' "$bottom_branch") >/dev/null && gh stack view --json >/dev/null 2>&1"; then
      view_ok=1
    fi
    if (( view_ok == 1 )); then
      dep_runner_sh "dep-updater gh stack unstack local" -- "cd ${quoted_wt} && git checkout $(printf '%q' "$bottom_branch") >/dev/null && gh stack unstack --local" \
        || die "gh-stack: could not clear local stack tracking before re-init"
    fi
  fi

  dep_runner_sh "dep-updater gh stack init" -- "cd ${quoted_wt} && gh stack init --base main${quoted_branches}" \
    || die "gh-stack: failed to init/adopt stack for:${quoted_branches}"

  # init checks out the top (last) branch; ensure we stay on the new layer.
  run_command "git worktree" git -C "$worktree_path" checkout "$current_branch"
}

dep_stack_register_branch() {
  local -r parent_branch="$1"
  local -a track_args=()

  if dep_stacking_is_gh_stack; then
    dep_stack_gh_stack_adopt_current
    return
  fi

  dep_stacking_is_graphite || return 0
  if [[ "$parent_branch" == "$wt_base_branch" ]]; then
    # Same main-present probe as ensure_gt_tracked: keep Graphite auto-detection
    # when the local trunk is not named main.
    if dep_stack_graphite_local_main_present; then
      track_args+=(-p main)
    fi
    dep_stack_graphite_track "${track_args[@]}"
  else
    dep_stack_graphite_track -p "$parent_branch"
  fi
}

dep_stack_register_branch_optional() {
  if dep_stacking_is_gh_stack; then
    if ! dep_stack_branch_info_ok; then
      log "Warning: current branch is not in a gh-stack; adopting before submit."
      dep_stack_gh_stack_adopt_current
    fi
    return
  fi
  dep_stacking_is_graphite || return 0
  dep_stack_graphite_track --runner-probe -p main 2>/dev/null || true
}

# dep_stack_submit_gh_pr_fallback
# Used when the repo marker is gh-stack but GitHub Stacked PRs are not enabled
# for the repository yet (public preview rollout). Push HEAD and open a normal PR.
dep_stack_submit_gh_pr_fallback() {
  local branch title body_file quoted_wt base_ref existing_pr push_rc=0

  branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"
  [[ -n "$branch" ]] || die "gh pr fallback: could not determine current branch"
  title="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- log -1 --format=%s)"
  [[ -n "$title" ]] || title="chore(deps): dependency updates"
  base_ref="$(state_get "base_branch")"
  [[ -n "$base_ref" ]] || base_ref='main'
  quoted_wt="$(printf '%q' "$worktree_path")"

  # Fresh dep-updater branches are unique. If push -u fails, recover when a
  # PR already exists for this head (prior partial success) — goal already met.
  dep_runner_sh "dep-updater git push fallback" -- "cd ${quoted_wt} && git push --set-upstream origin HEAD" \
    && push_rc=0 || push_rc=$?
  if (( push_rc != 0 )); then
    # Positional branch selector matches gh_pr_number_for_new_branch (not --head).
    existing_pr="$(dep_runner_gh_stdout "dep-updater gh pr view fallback" -- \
      pr view "$branch" --repo "${repo_owner}/${repo_name}" \
      --json number,state --jq 'if .state == "OPEN" then .number else empty end' 2>/dev/null || true)"
    if [[ -n "$existing_pr" ]]; then
      log "[gh-stack] Branch ${branch} already has open PR #${existing_pr}; skipping push and create."
      return 0
    fi
    die "gh pr fallback: failed to push ${branch}"
  fi

  body_file="$(mktemp)"
  cat >"$body_file" <<'EOF'
Automated dependency update via dep-updater.

Opened with gh pr create because Stacked PRs are not enabled for this repository.
EOF
  if ! dep_runner_gh "dep-updater gh pr create fallback" -- pr create \
    --repo "${repo_owner}/${repo_name}" \
    --base "$base_ref" \
    --head "$branch" \
    --title "$title" \
    --body-file "$body_file"
  then
    existing_pr="$(dep_runner_gh_stdout "dep-updater gh pr view after create" -- \
      pr view "$branch" --repo "${repo_owner}/${repo_name}" \
      --json number --jq '.number' 2>/dev/null || true)"
    rm -f "$body_file"
    if [[ -n "$existing_pr" ]]; then
      log "[gh-stack] PR #${existing_pr} already exists for ${branch}; treating create as success."
      return 0
    fi
    die "gh pr fallback: failed to create PR for ${branch}"
  fi
  rm -f "$body_file"
  # Label may be missing on some repos; do not fail the submit over cosmetics.
  existing_pr="$(dep_runner_gh_stdout "dep-updater gh pr view for label" -- \
    pr view "$branch" --repo "${repo_owner}/${repo_name}" \
    --json number --jq '.number' 2>/dev/null || true)"
  if [[ -n "$existing_pr" ]]; then
    dep_runner_gh "dep-updater gh pr label fallback" -- pr edit "$existing_pr" \
      --repo "${repo_owner}/${repo_name}" \
      --add-label "dep-updater" || true
  fi
}

dep_stack_submit_current() {
  local submit_out submit_rc=0
  local quoted_wt

  if dep_stacking_is_gh_stack; then
    quoted_wt="$(printf '%q' "$worktree_path")"
    # Keep runner helper on the same line as the shell script so the
    # runner-adoption ratchet does not treat the inner `gh` as bare.
    submit_out="$(dep_runner_sh_stdout "dep-updater gh stack submit" -- "cd ${quoted_wt} && gh stack submit --auto --open --remote origin 2>&1")" \
      && submit_rc=0 || submit_rc=$?
    if (( submit_rc == 0 )); then
      [[ -n "$submit_out" ]] && printf '%s\n' "$submit_out"
      return 0
    fi
    if grep -qiF 'Stacked PRs are not enabled for this repository' <<<"$submit_out"; then
      log "Warning: Stacked PRs are not enabled for ${repo_owner}/${repo_name}; falling back to gh pr create."
      [[ -n "$submit_out" ]] && log "$submit_out"
      dep_stack_submit_gh_pr_fallback
      return 0
    fi
    [[ -n "$submit_out" ]] && log "$submit_out"
    die "gh stack submit failed (exit ${submit_rc})"
  fi

  run_in_worktree gt submit --no-interactive --publish --no-stack
}

dep_stack_track_force() {
  dep_stacking_is_graphite || return 0
  dep_stack_graphite_track --runner-probe --force \
    || log "Warning: could not track branch with Graphite."
}

dep_stack_ensure_tracked() {
  dep_stacking_is_graphite || return 0
  ensure_gt_tracked
}

dep_stack_branch_info_ok() {
  if dep_stacking_is_gh_stack; then
    run_in_worktree gh stack view --json >/dev/null 2>&1
    return $?
  fi
  dep_stack_graphite_branch_info_ok
}

dep_stack_graphite_branch_info_ok() {
  local quoted_wt
  quoted_wt="$(printf '%q' "$worktree_path")"
  runner_sh "gt branch info" --probe --timeout "$dep_graphite_command_timeout_seconds" -- \
    "cd ${quoted_wt} && exec gt branch info >/dev/null 2>&1"
}

dep_stack_graphite_local_main_present() {
  # Keep runner_exec and git on one line for the runner-adoption ratchet.
  runner_exec "git main branch probe" --probe -- git -C "$worktree_path" \
    show-ref --verify --quiet refs/heads/main
}

dep_stack_graphite_track() {
  local probe quoted_args quoted_wt arg
  local track_status=0
  local -a runner_opts=() track_args=()

  probe=0
  if [[ "${1:-}" == '--runner-probe' ]]; then
    probe=1
    shift
  fi
  track_args=("$@")
  runner_opts=(--timeout "$dep_graphite_command_timeout_seconds")
  if (( probe == 1 )); then
    runner_opts=(--probe "${runner_opts[@]}")
  fi

  quoted_args=""
  for arg in "${track_args[@]}"; do
    quoted_args+=" $(printf '%q' "$arg")"
  done
  quoted_wt="$(printf '%q' "$worktree_path")"
  runner_sh "gt track" "${runner_opts[@]}" -- \
    "cd ${quoted_wt} && exec gt track${quoted_args}" || track_status=$?
  if (( track_status == 124 )); then
    if (( probe == 1 )); then
      return 124
    fi
    # Match the read-path timeout contract: do not fall through to generic
    # cleanup that deletes a healthy worktree after a merely slow gt track.
    die "WAIT_TIMEOUT Graphite track timed out; preserving existing worktree: ${worktree_path}"
  fi
  return "$track_status"
}

dep_stack_needs_rebase() {
  local branches_csv first_branch main_sha base_sha

  if dep_stacking_is_graphite; then
    stack_needs_rebase
    return $?
  fi

  branches_csv="$(state_get "branches")"
  [[ -z "$branches_csv" ]] && return 1

  first_branch="$(cut -d',' -f1 <<<"$branches_csv")"
  [[ -z "$first_branch" ]] && return 1

  if ! run_command "git worktree" git -C "$worktree_path" fetch origin main >/dev/null 2>&1; then
    log "WARNING: could not fetch origin/main while checking rebase need; treating stack as not needing rebase"
    return 1
  fi
  if ! run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${first_branch}"; then
    return 1
  fi

  main_sha="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse origin/main 2>/dev/null || true)"
  base_sha="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- merge-base origin/main "$first_branch" 2>/dev/null || true)"
  [[ -n "$main_sha" && -n "$base_sha" && "$main_sha" != "$base_sha" ]]
}

dep_rebase_stack_on_main() {
  if dep_stacking_is_gh_stack; then
    stacking_tool_restack_as "$dep_stacking_tool" "$worktree_path" \
      || die "Rebase failed. Resolve conflicts manually and re-run."
    log "Rebase complete."
    return 0
  fi
  rebase_stack_on_main
}

init_repo_api_context() {
  local remote_url
  remote_url="$(dep_runner_git_c_stdout "git repo" "$dir" -- remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote_url" ]]; then
    die "Could not resolve git remote 'origin' from: $dir"
  fi

  local slug
  slug="$(printf '%s' "$remote_url" \
    | sed -E 's#^git@github.com:##; s#^https://github.com/##; s#\.git$##')"

  if [[ "$slug" != */* ]]; then
    die "Could not parse GitHub owner/repo from origin URL: $remote_url"
  fi

  repo_owner="${slug%%/*}"
  repo_name="${slug##*/}"
}

gh_pr_number_for_branch() {
  local -r branch="$1"
  # Filter by state=open and the dep-updater label so closed/merged PRs from
  # previous runs are never confused with the current run's PR.
  dep_runner_gh_stdout "gh api" -- api "repos/${repo_owner}/${repo_name}/pulls" \
    --method GET \
    -f state=open \
    -f head="${repo_owner}:${branch}" \
    -f per_page=5 \
    --jq 'map(select(any(.labels[]; .name == "dep-updater"))) | .[0].number // empty' \
    2>/dev/null || true
}

# Used immediately after gt submit, before the dep-updater label has been applied.
# Must not filter by label — the PR was just created and has no labels yet.
gh_pr_number_for_new_branch() {
  local -r branch="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$branch" --repo "${repo_owner}/${repo_name}" \
    --json number --jq '.number' 2>/dev/null || true
}

wait_for_pr_number_for_new_branch() {
  local -r branch="$1"
  local -r timeout_sec=60
  local -r poll_sec=2
  local elapsed=0
  local pr_num=""

  while (( elapsed < timeout_sec )); do
    pr_num="$(gh_pr_number_for_new_branch "$branch")"
    if [[ -n "$pr_num" ]]; then
      printf '%s' "$pr_num"
      return 0
    fi
    sleep "$poll_sec"
    elapsed=$(( elapsed + poll_sec ))
  done

  return 1
}

gh_pr_head_ref_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$pr_number" --repo "${repo_owner}/${repo_name}" \
    --json headRefName --jq '.headRefName // empty' 2>/dev/null || true
}

gh_pr_head_sha_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$pr_number" --repo "${repo_owner}/${repo_name}" \
    --json headRefOid --jq '.headRefOid // empty' 2>/dev/null || true
}

gh_pr_base_ref_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$pr_number" --repo "${repo_owner}/${repo_name}" \
    --json baseRefName --jq '.baseRefName // empty' 2>/dev/null || true
}

# When GitHub leaves mergeable=UNKNOWN, compare base...head: ahead with behind_by=0
# means the PR head is a direct extension of the base branch (no missing main commits,
# no divergence). Safe to treat as conflict-free for batch gating.
gh_pr_compare_ff_mergeable_for_number() {
  local -r pr_num="$1"
  local base_ref head_sha raw cmp_status behind_by

  base_ref="$(gh_pr_base_ref_for_number "$pr_num")"
  [[ -n "$base_ref" ]] || return 1

  head_sha="$(gh_pr_head_sha_for_number "$pr_num")"
  [[ -n "$head_sha" ]] || return 1

  if ! raw="$(dep_runner_gh_api_jq "gh pr compare ff check" --probe \
    "repos/${repo_owner}/${repo_name}/compare/${base_ref}...${head_sha}" \
    '{status: (.status // ""), behind_by: (.behind_by // -1)}')"; then
    return 1
  fi
  [[ -n "$raw" ]] || return 1

  cmp_status="$(dep_runner_jq_string "gh pr compare ff status" "$raw" '.status')"
  behind_by="$(dep_runner_jq_string "gh pr compare ff behind_by" "$raw" '.behind_by')"
  [[ "$cmp_status" == 'ahead' && "$behind_by" == '0' ]]
}

# Best-effort audit trail when compare fallback bypasses mergeable=UNKNOWN.
# GitHub/API failures must not block batch gating.
gh_pr_post_mergeable_compare_fallback_comment_optional() {
  local -r pr_num="$1"
  local -r waited_sec="$2"
  local base_ref head_sha comment_body waited_fmt exit_code

  base_ref="$(gh_pr_base_ref_for_number "$pr_num")"
  head_sha="$(gh_pr_head_sha_for_number "$pr_num")"
  if (( waited_sec < 60 )); then
    waited_fmt="${waited_sec}s"
  else
    waited_fmt="$(( waited_sec / 60 ))m $(( waited_sec % 60 ))s"
  fi

  comment_body="dep-updater: GitHub \`mergeable\` stayed \`UNKNOWN\` for ${waited_fmt}; "
  comment_body+="used compare fallback (\`${base_ref}...${head_sha}\`: ahead, "
  comment_body+="\`behind_by=0\`) and continuing."

  exit_code=0
  runner_exec "gh pr compare fallback comment" --probe -- gh pr comment "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --body "$comment_body" || exit_code=$?
  if (( exit_code != 0 )); then
    log "PR #${pr_num}: optional compare-fallback comment not posted (waited ${waited_fmt})."
  fi
}

gh_pr_number_resolve_for_gate() {
  local -r branch="$1"
  local pr

  pr="$(gh_pr_number_for_branch "$branch")"
  if [[ -n "$pr" ]]; then
    printf '%s' "$pr"
    return 0
  fi
  pr="$(gh_pr_number_for_new_branch "$branch")"
  if [[ -n "$pr" ]]; then
    printf '%s' "$pr"
    return 0
  fi
  return 1
}

gh_pr_state_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh api" -- api "repos/${repo_owner}/${repo_name}/pulls/${pr_number}" \
    --jq '.state // empty' 2>/dev/null || true
}

gh_pr_merged_for_number() {
  local -r pr_number="$1"
  local raw

  raw="$(dep_runner_gh_api_jq "gh pr merged check" --probe \
    "repos/${repo_owner}/${repo_name}/pulls/${pr_number}" '(.merged_at != null)' || true)"
  printf '%s' "${raw:-}"
}

dep_enqueue_pr_for_merge_queue() {
  local -r pr_number="$1"
  local merge_out merge_exit=0

  merge_out="$(dep_runner_gh_stdout "dep-updater gh pr merge auto" -- pr merge "$pr_number" \
    --repo "${repo_owner}/${repo_name}" \
    --auto --squash 2>&1)" || merge_exit=$?
  if (( merge_exit != 0 )); then
    die "Could not enable auto-merge on PR #${pr_number}: ${merge_out}"
  fi
  if [[ -n "$merge_out" ]]; then
    log "$merge_out"
  fi
}

# Prints exactly one of: true, false, unknown (never guess on API failure).
pr_has_merge_enqueue_pending() {
  local -r pr_number="$1"
  local raw

  raw="$(dep_runner_gh_stdout "dep-updater gh pr autoMergeRequest" -- pr view "$pr_number" \
    --repo "${repo_owner}/${repo_name}" \
    --json autoMergeRequest --jq '.autoMergeRequest != null' 2>/dev/null || true)"
  case "$raw" in
    true|false) printf '%s' "$raw" ;;
    *) printf 'unknown' ;;
  esac
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'USAGE'
Usage:
  dep-updater [OPTIONS]
  dep-updater --cleanup [--dir <path>]
  dep-updater --rebase [--dir <path>]

Modes:
  (no flags)        Update: create worktree, stack PRs, wait for merge, cleanup
  --cleanup         Read saved state and clean up after stack is merged
  --dry-run         Preview exact per-PR plan and scope; no git or worktree changes
  --rebase          Rebase existing stack on top of newest main

Options:
  --all             With --batch: run batch updates for every git repo discovered
                    under the top-level scan directories (see --scan-root). Prints
                    each resolved top-level directory before running. Always skips
                    archived GitHub repositories. Skips private GitHub repositories
                    unless --include-private is set. For quick runs, combine with
                    both --no-wait-ci and --no-wait-merge.
  --batch           Combine all updates into a single PR instead of one per package
  --dir <path>      Project root (default: current directory)
  --ecosystem <e>   Force: npm | python | rust | gha | auto  (default: auto)
  --include-private Include private GitHub repositories in --batch --all discovery
                    (default: skip private repos; explicit --dir is always processed).
                    Override via DEP_UPDATER_INCLUDE_PRIVATE=1.
  --merge-timeout <min>  Minutes to wait for all PRs to merge (default: 15)
  --merge-via <mode>  How to land PRs after CI passes: gh | merge-queue
                    (default: gh — GitHub MQ via --auto --squash; override via
                    DEP_UPDATER_MERGE_VIA). merge-queue is an alias for the same
                    enqueue helper (also --auto --squash; leftover merge-it is ignored).
  --no-wait-ci      Skip CI polling between PRs
  --no-wait-merge   Exit after stack is submitted; print cleanup command
  --quiet           Suppress non-error log lines
  --report-json     Emit JSON scan report on stdout (implies --dry-run --quiet)
  --scan-root <path>  Parent directory whose immediate child folders are git clones
                    (--batch --all only; repeat). If omitted, defaults to $HOME/work/ai
                    or $DEP_UPDATER_BATCH_ALL_ROOTS (colon-separated; legacy:
                    $DEP_UPDATER_FAST_BATCH_ROOTS still honored when BATCH_ALL unset).
  --security-only   Only create CVE-fix PRs; skip regular version bumps
  --semver-only     npm: respect existing semver range (omit --latest)
  --tmpdir <path>   Directory under which to create the dep-updater worktree
                    (default: $TMPDIR or /tmp)
  --tz <tz>         Timezone for logs (sets $TZ). Examples: America/New_York, EST5EDT
  -h, --help        Print this help and exit

Primary clone (--dir):
  Stack work (stacking-tool sync/submit) runs only in the dep-updater worktree
  under --tmpdir — not from the primary clone. Uncommitted primary-clone changes are
  stashed at the start of a run and restored when the run finishes (including on error).
  The primary checkout branch and refs are not modified.

Supported ecosystems:
  [npm]         package.json present  → pnpm outdated + pnpm update
  [uv]          uv.lock present       → uv pip list --outdated + uv add
  [poetry]      poetry.lock present   → poetry show --outdated + poetry add
  [pipenv]      Pipfile.lock present  → pipenv run pip list + pipenv install
  [pip]         requirements.txt or pyproject.toml → pip list + pip freeze
  rust          Cargo.toml present  → cargo outdated + cargo add
  [gha]         .github/workflows/*.yml present  → gh api releases/latest + sed patch
USAGE
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        batch_all=1
        ;;
      --batch)
        batch=1
        ;;
      --cleanup)
        cleanup_mode=1
        ;;
      --dir)
        shift
        [[ $# -eq 0 ]] && die "--dir requires a path argument."
        dir_explicit=1
        dir="$1"
        ;;
      --dry-run)
        dry_run=1
        ;;
      --ecosystem)
        shift
        [[ $# -eq 0 ]] && die "--ecosystem requires a value: npm | python | rust | gha | auto"
        ecosystem="$1"
        ;;
      --include-private)
        include_private=1
        ;;
      --merge-timeout)
        shift
        [[ $# -eq 0 ]] && die "--merge-timeout requires a number of minutes."
        merge_timeout_min="$1"
        ;;
      --merge-via)
        shift
        [[ $# -eq 0 ]] && die "--merge-via requires a value: gh | merge-queue"
        merge_via="$1"
        ;;
      --no-wait-ci)
        no_wait_ci=1
        ;;
      --no-wait-merge)
        no_wait_merge=1
        ;;
      --quiet)
        quiet=1
        ;;
      --rebase)
        rebase_mode=1
        ;;
      --report-json)
        report_json=1
        dry_run=1
        quiet=1
        ;;
      --scan-root)
        shift
        [[ $# -eq 0 ]] && die "--scan-root requires a path argument."
        if [[ -z "$scan_roots_csv" ]]; then
          scan_roots_csv="$1"
        else
          scan_roots_csv="${scan_roots_csv}:$1"
        fi
        ;;
      --security-only)
        security_only=1
        ;;
      --semver-only)
        semver_only=1
        ;;
      --tmpdir)
        shift
        [[ $# -eq 0 ]] && die "--tmpdir requires a path argument."
        wt_tmpdir="$1"
        ;;
      --tz)
        shift
        [[ $# -eq 0 ]] && die "--tz requires a timezone value (e.g. America/New_York)."
        log_tz="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option: '$1'. Use -h for help."
        ;;
    esac
    shift
  done

  case "$ecosystem" in
    npm|python|rust|gha|auto) : ;;
    *) die "Invalid --ecosystem: '$ecosystem'. Valid values: npm | python | rust | gha | auto" ;;
  esac

  [[ "$batch_all" == '1' && "$batch" != '1' ]] \
    && die "--all requires --batch."

  [[ -n "$scan_roots_csv" && ( "$batch_all" != '1' || "$batch" != '1' ) ]] \
    && die "--scan-root requires --batch --all."

  if [[ "$batch_all" == '1' ]]; then
    [[ "$dir_explicit" == '1' ]] \
      && die "--batch --all cannot be combined with --dir; use --scan-root instead."
    [[ "$cleanup_mode" == '1' ]] \
      && die "--batch --all cannot be used with --cleanup."
    [[ "$rebase_mode" == '1' ]] \
      && die "--batch --all cannot be used with --rebase."
    [[ "$report_json" == '1' ]] \
      && die "--batch --all cannot be used with --report-json."
    if [[ -z "$scan_roots_csv" ]]; then
      scan_roots_csv="${DEP_UPDATER_BATCH_ALL_ROOTS:-${DEP_UPDATER_FAST_BATCH_ROOTS:-${HOME}/work/ai}}"
    fi
    dir=""
  else
    local resolved_dir
    if [[ -n "$dir" ]]; then
      resolved_dir="$(cd "$dir" && pwd)"
    else
      resolved_dir="$(dep_runner_git_stdout "git rev-parse" -- rev-parse --show-toplevel 2>/dev/null)" \
        || die "Not inside a git repository and --dir was not specified."
    fi
    dir="$resolved_dir"
  fi

  if [[ -n "$wt_tmpdir" ]]; then
    if [[ ! -d "$wt_tmpdir" ]]; then
      mkdir -p "$wt_tmpdir" \
        || die "Could not create --tmpdir directory: $wt_tmpdir"
    fi
    wt_tmpdir="$(cd "$wt_tmpdir" && pwd)"
  fi

  # Ensure logs use the user's local timezone even when TZ isn't exported (common in
  # minimal environments). `--tz` / $TZ still take precedence.
  if [[ -n "$log_tz" ]]; then
    export TZ="$log_tz"
  elif [[ -z "${TZ:-}" ]]; then
    local detected_tz
    detected_tz="$(time_log_detect_system_tz)"
    if [[ -n "$detected_tz" ]]; then
      export TZ="$detected_tz"
      log_tz="$detected_tz"
    fi
  fi

  export TIME_LOG_WARN_TZ=1
  export TIME_LOG_WARN_PREFIX="WARNING:"
  export TIME_LOG_ENABLED=1
  if [[ "$quiet" == '1' ]]; then
    export TIME_LOG_ENABLED=0
  fi
  export TIME_LOG_COLOR_START="$log_color"
  export TIME_LOG_COLOR_RESET="$log_reset"

  if [[ -z "$merge_via" && -n "${DEP_UPDATER_MERGE_VIA:-}" ]]; then
    merge_via="${DEP_UPDATER_MERGE_VIA}"
  fi
  if [[ -z "$merge_via" ]]; then
    # Org default is GitHub MQ via gh --auto (issue #466); both batch and
    # interactive runs use the same enqueue path.
    merge_via='gh'
  fi
  case "$merge_via" in
    gh|merge-queue) ;;
    *) die "Invalid --merge-via: '${merge_via}'. Valid values: gh | merge-queue" ;;
  esac

  if [[ "${DEP_UPDATER_INCLUDE_PRIVATE:-0}" == '1' ]]; then
    include_private=1
  fi

  # shellcheck disable=SC2034  # cleanup_mode, rebase_mode, merge_timeout_min used in main() dispatch
  readonly dry_run cleanup_mode rebase_mode dir ecosystem semver_only no_wait_ci no_wait_merge security_only batch batch_all include_private merge_timeout_min merge_via wt_tmpdir quiet report_json scan_roots_csv log_tz
}

# ---------------------------------------------------------------------------
# Prerequisite checks — Phase 1: core tools (always required)
# ---------------------------------------------------------------------------

check_core_prereqs() {
  local missing=0

  tooling_prereq_check_tools "[tooling]" git gh jq rg || missing=$?

  # --batch --all parent only orchestrates child --dir runs; each child resolves
  # its own .github/stacking-tool. Do not infer Graphite from an empty $dir.
  if [[ "$batch_all" == '1' ]]; then
    if (( missing > 0 )); then
      die "Install the missing tool(s) above and retry."
    fi
    return 0
  fi

  dep_init_stacking_tool
  if dep_stacking_is_graphite; then
    tooling_prereq_check_tools "[tooling]" gt || missing=$?
  elif ! dep_runner_sh "dep-updater probe gh stack" -- \
    "gh stack --help >/dev/null 2>&1"; then
    log "ERROR: gh stack extension not available (install: gh extension install github/gh-stack)"
    missing=1
  fi

  if (( missing > 0 )); then
    die "Install the missing tool(s) above and retry."
  fi
}

# Detect pnpm's "ignored builds" safety gate in output.
pnpm_output_has_ignored_builds() {
  local -r output_file="$1"
  local p_pm_tool p_approve ignored_builds_pat
  p_pm_tool='pnpm'
  p_approve='approve-builds'
  ignored_builds_pat="ERR_PNPM_IGNORED_BUILDS|${p_pm_tool} ${p_approve}|${p_approve}"
  [[ -f "$output_file" ]] || return 1
  dep_runner_rg --probe "pnpm ignored builds marker" -- --quiet \
    "$ignored_builds_pat" "$output_file"
}

pnpm_record_ignored_build_pkgs() {
  local -r output_file="$1"
  [[ -f "$output_file" ]] || return 0

  # Example:
  #   [ERR_PNPM_IGNORED_BUILDS] Ignored build scripts: esbuild@0.27.7, esbuild@0.28.0
  local ignored_line
  ignored_line="$(dep_runner_sh_stdout "rg ignored builds line" -- \
    "rg -m 1 -o 'Ignored build scripts:.*' $(printf '%q' "$output_file") 2>/dev/null || true")"
  [[ -z "$ignored_line" ]] && return 0
  ignored_line="${ignored_line#Ignored build scripts: }"

  local pkg_item pkg_name
  while IFS= read -r pkg_item; do
    pkg_item="$(printf '%s' "$pkg_item" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -z "$pkg_item" ]] && continue
    pkg_name="${pkg_item%%@*}"
    [[ -z "$pkg_name" ]] && continue
    if [[ -z "$pnpm_ignored_build_pkgs" ]]; then
      pnpm_ignored_build_pkgs="$pkg_name"
    else
      local list_tmp
      list_tmp="$(mktemp)"
      printf '%s\n' "$pnpm_ignored_build_pkgs" >"$list_tmp"
      if dep_runner_rg "pnpm ignored pkg dedupe" -- -qxF "$pkg_name" "$list_tmp"; then
        :
      else
        pnpm_ignored_build_pkgs="${pnpm_ignored_build_pkgs}
${pkg_name}"
      fi
      rm -f "$list_tmp"
    fi
  done < <(tr ',' '\n' <<<"$ignored_line")
}

pnpm_pkg_is_ignored_build() {
  local -r pkg="$1"
  local list_tmp rc
  [[ -z "$pnpm_ignored_build_pkgs" ]] && return 1
  list_tmp="$(mktemp)"
  printf '%s\n' "$pnpm_ignored_build_pkgs" >"$list_tmp"
  dep_runner_rg "pnpm ignored pkg lookup" -- -qxF "$pkg" "$list_tmp"
  rc=$?
  rm -f "$list_tmp"
  return "$rc"
}

# npm_version_prefetch <pkg> <version>
# Confirms an exact package version is actually published in the registry by
# querying the registry HTTP API directly (no pnpm metadata cache), then
# pre-populating the pnpm content-addressable store.
# Retries up to 3 times with 15 s backoff.
# Returns 0 when the version is confirmed available and prefetched.
# Returns 1 when it cannot be confirmed after all retries (caller should skip).
npm_version_prefetch() {
  local -r pkg="$1"
  local -r version="$2"
  local attempt registry http_status encoded_pkg store_exit

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"

  for attempt in 1 2 3; do
    http_status="$(dep_runner_curl_http_code \
      "npm registry version check ${pkg}@${version}" \
      "${registry}${encoded_pkg}/${version}")"
    if [[ "$http_status" == "200" ]]; then
      store_exit=0
      runner_exec "pnpm store add ${pkg}@${version}" -- pnpm store add "${pkg}@${version}" \
        >/dev/null || store_exit=$?
      if (( store_exit == 0 )); then
        return 0
      fi
    fi
    if [[ "$attempt" -lt 3 ]]; then
      log "[pnpm] WARNING: ${pkg}@${version} not yet available in registry (HTTP ${http_status}); attempt ${attempt}/2, retrying in 15s…"
      sleep 15
    fi
  done

  log "[pnpm] WARNING: ${pkg}@${version} could not be confirmed in registry after 3 attempts; skipping."
  return 1
}

# npm_registry_dist_tag_latest <pkg>
# Prints dist-tags.latest from the npm packument (HTTPS), using the same registry
# base URL as npm_version_prefetch. Prefer this over `pnpm view`, which can
# return stale cached metadata that disagrees with install-time resolution.
# Returns 1 when latest is missing or the packument cannot be fetched.
npm_registry_dist_tag_latest() {
  local -r pkg="$1"
  local registry encoded_pkg body latest

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  body=""
  body="$(dep_runner_curl_body "npm packument ${pkg}" "${registry}${encoded_pkg}" || true)"
  latest=""
  latest="$(dep_runner_jq_string "npm dist-tags.latest ${pkg}" "$body" '.["dist-tags"].latest // empty' \
    || true)"
  if [[ -z "$latest" || "$latest" == 'null' ]]; then
    return 1
  fi
  printf '%s' "$latest"
  return 0
}

# npm_parse_iso8601_to_epoch <iso8601>
# Prints Unix epoch seconds for a registry "time" field, or empty on failure.
npm_parse_iso8601_to_epoch() {
  time_log_iso8601_utc_to_epoch "$1"
}

# _npm_version_is_stable_release <version>
# Returns 0 for release versions without a prerelease suffix (no '-' in the version).
_npm_version_is_stable_release() {
  local -r version="$1"
  [[ "$version" != *-* ]]
}

# npm_semver_major <version>
# Prints the leading major integer from a semver-ish string (strips a leading v).
# Non-numeric majors print empty so callers fall through instead of skipping.
npm_semver_major() {
  local ver="$1"
  ver="${ver#v}"
  ver="${ver%%-*}"
  ver="${ver%%+*}"
  ver="${ver%%.*}"
  if [[ "$ver" =~ ^[0-9]+$ ]]; then
    printf '%s' "$ver"
  else
    printf ''
  fi
}

# npm_should_skip_typescript_major <current> <candidate>
# Returns 0 when candidate is a TypeScript major bump that should not be proposed.
# typescript-eslint (and similar tooling) does not support TypeScript 7+ programmatic
# APIs yet; auto-bumping the major breaks ESLint CI (#401). CVE-driven majors still land.
npm_should_skip_typescript_major() {
  local -r current="$1"
  local -r candidate="$2"
  local cur_maj cand_maj

  cur_maj="$(npm_semver_major "$current")"
  cand_maj="$(npm_semver_major "$candidate")"
  [[ -n "$cur_maj" && -n "$cand_maj" ]] || return 1
  [[ "$cur_maj" != "$cand_maj" ]] || return 1
  if npm_pkg_has_cve_fix_in_audit 'typescript'; then
    return 1
  fi
  return 0
}

# _npm_registry_stable_versions_desc <pkg>
# Prints stable published versions newest-first from the npm packument.
_npm_registry_stable_versions_desc() {
  local -r pkg="$1"
  local registry encoded_pkg body

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  body="$(dep_runner_curl_body "npm packument ${pkg}" "${registry}${encoded_pkg}" || true)"
  if [[ -z "$body" ]]; then
    return 1
  fi
  dep_runner_jq_string "npm stable versions ${pkg}" "$body" '.versions | keys[]' 2>/dev/null \
    | while IFS= read -r ver; do
        [[ -z "$ver" ]] && continue
        if _npm_version_is_stable_release "$ver"; then
          printf '%s\n' "$ver"
        fi
      done \
    | sort -V -r
}

# npm_pick_eligible_new_version <pkg> <current> [scan_root]
# Prints the newest registry version newer than current that passes release-age and
# closure checks. When dist-tags.latest is too new, walks back to the newest
# eligible stable version (same behaviour as Dependabot cooldown + _gha_pick_eligible_new_ref).
npm_pick_eligible_new_version() {
  local -r pkg="$1"
  local -r current="$2"
  local -r scan_root="${3:-$dir}"
  local ver latest_tag picked skipped_ts_major

  skipped_ts_major=0

  # Integration tests stub pnpm only (DEP_UPDATER_SKIP_NPM_REGISTRY=1): walk the
  # registry packument is unavailable, so use pnpm view like the pre-walk path.
  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    latest_tag="$(dep_runner_pnpm_view_version "pnpm view ${pkg}" "$pkg" "$scan_root" || true)"
    if [[ -z "$latest_tag" || "$latest_tag" == "$current" ]]; then
      return 1
    fi
    if [[ "$(printf '%s\n%s\n' "$current" "$latest_tag" | sort -V | tail -1)" != "$latest_tag" ]]; then
      return 1
    fi
    if [[ "$pkg" == 'typescript' ]] && npm_should_skip_typescript_major "$current" "$latest_tag"; then
      log "[pnpm] typescript: holding at major $(npm_semver_major "$current") (skipping ${latest_tag}; typescript-eslint lacks TS major support)."
      return 1
    fi
    if npm_version_meets_minimum_release_age "$pkg" "$latest_tag" "$scan_root" \
      && npm_version_prefetch "$pkg" "$latest_tag"; then
      printf '%s' "$latest_tag"
      return 0
    fi
    return 1
  fi

  latest_tag="$(npm_registry_dist_tag_latest "$pkg" 2>/dev/null || true)"
  picked=""
  while IFS= read -r ver; do
    [[ -z "$ver" ]] && continue
    if [[ "$ver" == "$current" ]]; then
      continue
    fi
    if [[ "$(printf '%s\n%s\n' "$current" "$ver" | sort -V | tail -1)" != "$ver" ]]; then
      continue
    fi
    if [[ "$pkg" == 'typescript' ]] && npm_should_skip_typescript_major "$current" "$ver"; then
      if (( skipped_ts_major == 0 )); then
        log "[pnpm] typescript: holding at major $(npm_semver_major "$current") (skipping ${ver}; typescript-eslint lacks TS major support)."
        skipped_ts_major=1
      fi
      continue
    fi
    # Age-gate the candidate and confirm the top-level tarball exists. Exact-semver
    # sibling closure is deferred to npm_pnpm_filter_outdated_lines (lockfile dry-run),
    # which matches Dependabot and avoids false negatives on monorepo publishes.
    if npm_version_meets_minimum_release_age "$pkg" "$ver" "$scan_root" \
      && npm_version_prefetch "$pkg" "$ver"; then
      picked="$ver"
      break
    fi
    if [[ "$(printf '%s\n%s\n' "$ver" "$current" | sort -V | tail -1)" == "$current" && "$ver" != "$current" ]]; then
      break
    fi
  done < <(_npm_registry_stable_versions_desc "$pkg")

  if [[ -z "$picked" ]]; then
    return 1
  fi
  if [[ -n "$latest_tag" && "$picked" != "$latest_tag" ]]; then
    log "[pnpm] ${pkg}: proposing ${picked} (newest eligible; dist-tags.latest ${latest_tag} is too new)."
  fi
  printf '%s' "$picked"
  return 0
}

# npm_minimum_release_age_minutes [scan_root]
# Effective minimumReleaseAge for bump proposals: max(project pnpm config, dep-updater floor).
npm_minimum_release_age_minutes() {
  local -r scan_root="${1:-$dir}"
  local cfg project_minutes

  project_minutes=0
  if [[ -n "$scan_root" ]] && [[ -d "$scan_root" ]]; then
    cfg="$(pnpm_in_project "$scan_root" config get minimumReleaseAge 2>/dev/null \
      | tr -d '[:space:]' || true)"
    if [[ -n "$cfg" && "$cfg" != 'undefined' && "$cfg" =~ ^[0-9]+$ ]]; then
      project_minutes="$cfg"
    fi
  fi
  if (( project_minutes > dep_updater_minimum_release_age_minutes )); then
    printf '%s' "$project_minutes"
  else
    printf '%s' "$dep_updater_minimum_release_age_minutes"
  fi
}

# npm_registry_version_published_epoch <pkg> <version>
# Prints publish-time epoch from the packument, or empty when unknown.
npm_registry_version_published_epoch() {
  local -r pkg="$1"
  local -r version="$2"
  local registry encoded_pkg body published_iso published_epoch

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  body="$(dep_runner_curl_body "npm packument ${pkg}" "${registry}${encoded_pkg}" || true)"
  published_iso="$(dep_runner_jq_string "npm publish time ${pkg}@${version}" "$body" \
    ".time[\"${version}\"] // empty" || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

# npm_pkg_has_cve_fix_in_audit <pkg>
# True when npm audit reported CVEs with an available fix for this package.
npm_pkg_has_cve_fix_in_audit() {
  local -r pkg="$1"
  local ap _ac _af cves

  [[ -z "$npm_cve_fix_audit_lines" ]] && return 1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    read -r ap _ac _af cves <<< "$line"
    [[ -z "$ap" ]] && continue
    if [[ "${ap,,}" == "${pkg,,}" && -n "$cves" ]]; then
      return 0
    fi
  done <<< "$npm_cve_fix_audit_lines"
  return 1
}

# npm_version_meets_minimum_release_age <pkg> <version> [scan_root]
# Returns 0 when the version is old enough to install under minimumReleaseAge policy.
# When publish time is unknown, allow (matches pnpm minimumReleaseAgeIgnoreMissingTime).
# CVE-marked packages (npm audit with fix + CVE ids) bypass the age gate in dep-updater.
npm_version_meets_minimum_release_age() {
  local -r pkg="$1"
  local -r version="$2"
  local -r scan_root="${3:-$dir}"
  local min_minutes published_epoch now_epoch age_minutes

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  if npm_pkg_has_cve_fix_in_audit "$pkg"; then
    return 0
  fi

  min_minutes="$(npm_minimum_release_age_minutes "$scan_root")"
  published_epoch="$(npm_registry_version_published_epoch "$pkg" "$version" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 0
  fi
  now_epoch="$(time_log_now_utc_epoch)"
  age_minutes=$(( (now_epoch - published_epoch) / 60 ))
  if (( age_minutes < min_minutes )); then
    log "[pnpm] Skipping ${pkg}@${version}: published ${age_minutes}m ago; minimumReleaseAge is ${min_minutes}m."
    return 1
  fi
  return 0
}

# _py_version_is_stable_release <version>
# Returns 0 for PEP 440 release/post-release versions (excludes a/b/rc/dev pre-releases).
_py_version_is_stable_release() {
  local -r version="$1"

  if [[ "$version" =~ [0-9](a|b|rc)[0-9] ]]; then
    return 1
  fi
  if [[ "$version" =~ [0-9]\.(dev|a|b|rc)[0-9] ]]; then
    return 1
  fi
  return 0
}

# _pypi_fetch_project_json <pkg>
# Prints the PyPI project JSON document, or nothing on failure.
_pypi_fetch_project_json() {
  local -r pkg="$1"
  local encoded_pkg

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  encoded_pkg="${pkg//+/%2B}"
  dep_runner_curl_body "pypi project json ${pkg}" \
    "https://pypi.org/pypi/${encoded_pkg}/json" || true
}

# _pypi_stable_versions_desc_from_body <json_body>
# Prints stable published versions newest-first from a cached project JSON body.
_pypi_stable_versions_desc_from_body() {
  local -r body="$1"

  if [[ -z "$body" ]]; then
    return 1
  fi
  dep_runner_jq_string "pypi stable versions from body" "$body" '.releases | keys[]' 2>/dev/null \
    | while IFS= read -r ver; do
        [[ -z "$ver" ]] && continue
        if _py_version_is_stable_release "$ver"; then
          printf '%s\n' "$ver"
        fi
      done \
    | sort -V -r
}

# _pypi_version_upload_epoch_from_project_json <json_body> <version>
# Prints publish-time epoch from a cached project JSON body, or empty when unknown.
_pypi_version_upload_epoch_from_project_json() {
  local -r body="$1"
  local -r version="$2"
  local published_iso published_epoch

  if [[ -z "$body" ]]; then
    return 1
  fi
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
  published_iso="$(dep_runner_jq_with_args "pypi upload time from project json" "$body" -r --arg v "$version" \
    '.releases[$v][0].upload_time // empty' 2>/dev/null || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

# _py_version_meets_minimum_release_age_from_json <json_body> <pkg> <version>
# Like py_version_meets_minimum_release_age but reads upload times from cached project JSON.
_py_version_meets_minimum_release_age_from_json() {
  local -r body="$1"
  local -r pkg="$2"
  local -r version="$3"
  local published_epoch now_epoch age_minutes

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  if py_pkg_has_cve_fix_in_audit "$pkg"; then
    return 0
  fi

  published_epoch="$(_pypi_version_upload_epoch_from_project_json "$body" "$version" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 0
  fi
  now_epoch="$(time_log_now_utc_epoch)"
  age_minutes=$(( (now_epoch - published_epoch) / 60 ))
  if (( age_minutes < dep_updater_minimum_release_age_minutes )); then
    log "[python] Skipping ${pkg}==${version}: published ${age_minutes}m ago; minimum release age is ${dep_updater_minimum_release_age_minutes}m."
    return 1
  fi
  return 0
}

# py_pick_eligible_new_version <pkg> <current>
# Prints the newest PyPI version newer than current that passes release-age policy.
# When the registry latest is too new, walks back to the newest eligible stable
# version (same behaviour as npm_pick_eligible_new_version / Dependabot cooldown).
py_pick_eligible_new_version() {
  local -r pkg="$1"
  local -r current="$2"
  local body registry_latest ver picked

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  if py_pkg_has_cve_fix_in_audit "$pkg"; then
    return 1
  fi

  body="$(_pypi_fetch_project_json "$pkg")"
  if [[ -z "$body" ]]; then
    return 1
  fi

  registry_latest="$(dep_runner_jq_string "pypi info version ${pkg}" "$body" '.info.version // empty' || true)"
  picked=""
  while IFS= read -r ver; do
    [[ -z "$ver" ]] && continue
    if [[ "$ver" == "$current" ]]; then
      continue
    fi
    if [[ "$(printf '%s\n%s\n' "$current" "$ver" | sort -V | tail -1)" != "$ver" ]]; then
      continue
    fi
    if _py_version_meets_minimum_release_age_from_json "$body" "$pkg" "$ver"; then
      picked="$ver"
      break
    fi
    if [[ "$(printf '%s\n%s\n' "$ver" "$current" | sort -V | tail -1)" == "$current" && "$ver" != "$current" ]]; then
      break
    fi
  done < <(_pypi_stable_versions_desc_from_body "$body")

  if [[ -z "$picked" ]]; then
    return 1
  fi
  if [[ -n "$registry_latest" && "$picked" != "$registry_latest" ]]; then
    log "[python] ${pkg}: proposing ${picked} (newest eligible; latest ${registry_latest} is too new)."
  fi
  printf '%s' "$picked"
  return 0
}

# pypi_version_published_epoch <pkg> <version>
# Prints publish-time epoch from PyPI, or empty when unknown.
pypi_version_published_epoch() {
  local -r pkg="$1"
  local -r version="$2"
  local encoded_pkg body published_iso published_epoch

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  encoded_pkg="${pkg//+/%2B}"
  body="$(dep_runner_curl_body "pypi version json ${pkg}@${version}" \
    "https://pypi.org/pypi/${encoded_pkg}/${version}/json" || true)"
  published_iso="$(dep_runner_jq_string "pypi upload time ${pkg}@${version}" "$body" \
    '.urls[0].upload_time // empty' || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

