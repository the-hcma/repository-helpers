    return 1
  fi
  return 0
}

# gha_release_published_epoch <action> <ref>
# Prints publish-time epoch for a GitHub Actions release tag, or empty when unknown.
gha_release_published_epoch() {
  local -r action="$1"
  local -r ref="$2"
  local published_iso published_epoch commit_sha

  if [[ "${DEP_UPDATER_SKIP_GHA_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  published_iso="$(dep_runner_gh_api_jq "gha release time ${action}@${ref}" --probe \
    "repos/${action}/releases/tags/${ref}" '.published_at // empty' || true)"
  if [[ -n "$published_iso" && "$published_iso" != 'null' ]]; then
    published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
    if [[ -n "$published_epoch" ]]; then
      printf '%s' "$published_epoch"
      return 0
    fi
  fi

  commit_sha="$(dep_runner_gh_api_jq "gha tag ref ${action}@${ref}" --probe \
    "repos/${action}/git/ref/tags/${ref}" '.object.sha // empty' || true)"
  if [[ -z "$commit_sha" || "$commit_sha" == 'null' ]]; then
    return 1
  fi
  published_iso="$(dep_runner_gh_api_jq "gha commit time ${action}@${commit_sha}" --probe \
    "repos/${action}/git/commits/${commit_sha}" '.committer.date // .author.date // empty' || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

# gha_version_meets_minimum_release_age <action> <ref>
# Returns 0 when the action release is old enough under dep-updater release-age policy.
gha_version_meets_minimum_release_age() {
  local -r action="$1"
  local -r ref="$2"
  local published_epoch now_epoch age_minutes

  if [[ "${DEP_UPDATER_SKIP_GHA_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  published_epoch="$(gha_release_published_epoch "$action" "$ref" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 0
  fi
  now_epoch="$(time_log_now_utc_epoch)"
  age_minutes=$(( (now_epoch - published_epoch) / 60 ))
  if (( age_minutes < dep_updater_minimum_release_age_minutes )); then
    log "[github-actions] Skipping ${action}@${ref}: published ${age_minutes}m ago; minimum release age is ${dep_updater_minimum_release_age_minutes}m."
    return 1
  fi
  return 0
}

# npm_registry_fetch_version_json <pkg> <version>
# Prints the version document from the registry (empty on failure).
npm_registry_fetch_version_json() {
  local -r pkg="$1"
  local -r version="$2"
  local registry encoded_pkg

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  dep_runner_curl_body "npm version manifest ${pkg}@${version}" \
    "${registry}${encoded_pkg}/${version}" || true
}

# npm_version_prefetch_closure <pkg> <version> [scan_root]
# Like npm_version_prefetch, but also requires exact-semver dependencies and peers
# from the version manifest to be published (catches partial monorepo publishes).
npm_version_prefetch_closure() {
  local -r pkg="$1"
  local -r version="$2"
  local -r scan_root="${3:-$dir}"
  local manifest dep depver

  if ! npm_version_meets_minimum_release_age "$pkg" "$version" "$scan_root"; then
    return 1
  fi

  if ! npm_version_prefetch "$pkg" "$version"; then
    return 1
  fi

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  manifest="$(npm_registry_fetch_version_json "$pkg" "$version")"
  if [[ -z "$manifest" ]]; then
    return 0
  fi

  while IFS= read -r dep depver; do
    [[ -z "$dep" ]] && continue
    if ! npm_version_meets_minimum_release_age "$dep" "$depver" "$scan_root"; then
      log "[pnpm] Filtering ${pkg} → ${version}: dependency ${dep}@${depver} is below minimumReleaseAge."
      return 1
    fi
    if ! npm_version_prefetch "$dep" "$depver"; then
      log "[pnpm] Filtering ${pkg} → ${version}: dependency ${dep}@${depver} is not published."
      return 1
    fi
  done < <(dep_runner_jq_string "npm manifest deps ${pkg}@${version}" "$manifest" '
    (.dependencies // {}), (.peerDependencies // {})
    | to_entries[]
    | select(.value | test("^[0-9]"))
    | "\(.key) \(.value)"
  ' 2>/dev/null || true)

  return 0
}

# npm_pnpm_parse_blame_direct_dep <logfile>
# Prints the direct dependency whose install pulled in a missing version (empty if unknown).
npm_pnpm_parse_blame_direct_dep() {
  local -r log_file="$1"
  local line blame

  line="$(grep -E 'installing the dependencies of ' "$log_file" 2>/dev/null | head -n 1 || true)"
  if [[ -z "$line" ]]; then
    return 1
  fi
  blame="$(printf '%s' "$line" | sed -n 's/.*installing the dependencies of \([^ ]*\)@.*/\1/p')"
  if [[ -z "$blame" ]]; then
    return 1
  fi
  printf '%s' "$blame"
  return 0
}

# npm_pnpm_try_lockfile_with_updates <scan_root> <updates_json> <logfile>
# Patches package.json, runs pnpm install --lockfile-only, restores originals.
# Returns 0 when the lockfile resolves.
npm_pnpm_try_lockfile_with_updates() {
  local -r scan_root="$1"
  local -r updates_json="$2"
  local -r log_file="$3"
  local pkg_json lockfile bak_pkg bak_lock tmp_pkg

  if [[ "$updates_json" == '{}' ]]; then
    return 0
  fi

  pkg_json="${scan_root}/package.json"
  lockfile="${scan_root}/pnpm-lock.yaml"
  if [[ ! -f "$pkg_json" ]]; then
    return 1
  fi

  bak_pkg="$(mktemp)"
  cp "$pkg_json" "$bak_pkg"
  bak_lock=""
  if [[ -f "$lockfile" ]]; then
    bak_lock="$(mktemp)"
    cp "$lockfile" "$bak_lock"
  fi

  tmp_pkg="$(mktemp)"
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
  if ! dep_runner_jq_file_args "jq patch package.json prefetch" "$pkg_json" --argjson updates "$updates_json" '
    to_entries | map(
      if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
         and (.value != null) then
        .value |= with_entries(
          (.key) as $k |
          if $updates | has($k) then .value = $updates[$k] else . end
        )
      else . end
    ) | from_entries
  ' >"$tmp_pkg"; then
    cp "$bak_pkg" "$pkg_json"
    rm -f "$bak_pkg" "$tmp_pkg" "$bak_lock"
    return 1
  fi
  mv "$tmp_pkg" "$pkg_json"

  local rc
  set +e
  pnpm_in_project "$scan_root" install --lockfile-only --no-frozen-lockfile >"$log_file" 2>&1
  rc=$?
  set -e

  cp "$bak_pkg" "$pkg_json"
  rm -f "$bak_pkg"
  if [[ -n "$bak_lock" ]]; then
    cp "$bak_lock" "$lockfile"
    rm -f "$bak_lock"
  fi

  return "$rc"
}

# npm_lines_to_updates_json <line>...
# Builds a JSON object { "pkg": "version", ... } from "pkg current latest" lines.
npm_lines_to_updates_json() {
  local line pkg _cur latest updates='{}'
  for line in "$@"; do
    [[ -z "$line" ]] && continue
    read -r pkg _cur latest <<<"$line"
    [[ -z "$pkg" || -z "$latest" ]] && continue
    # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
    updates="$(dep_runner_jq_with_args "npm lines to updates json" "$updates" \
      --arg k "$pkg" --arg v "$latest" '. + {($k): $v}')"
  done
  printf '%s' "$updates"
}

# npm_pnpm_filter_outdated_lines <scan_root> <line>...
# Drops proposed updates that cannot be resolved together (batch lockfile dry-run).
npm_pnpm_filter_outdated_lines() {
  local -r scan_root="$1"
  shift
  local -a pending_outdated=("$@")
  local -a next_outdated filtered_lines
  local log_file updates_json all_lines blame_pkg removed_ver gk
  local line pkg _cur lat

  if [[ ${#pending_outdated[@]} -eq 0 ]]; then
    return 0
  fi

  # Integration tests stub the registry; lockfile dry-run needs a real resolution graph.
  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    printf '%s\n' "${pending_outdated[@]}"
    return 0
  fi

  log_file="$(mktemp)"
  all_lines="$(printf '%s\n' "${pending_outdated[@]}")"

  while [[ ${#pending_outdated[@]} -gt 0 ]]; do
    updates_json="$(npm_lines_to_updates_json "${pending_outdated[@]}")"
    if npm_pnpm_try_lockfile_with_updates "$scan_root" "$updates_json" "$log_file"; then
      filtered_lines=("${pending_outdated[@]}")
      rm -f "$log_file"
      printf '%s\n' "${filtered_lines[@]}"
      return 0
    fi

    if ! grep -qF 'ERR_PNPM_NO_MATCHING_VERSION' "$log_file"; then
      log "[pnpm] WARNING: could not verify proposed updates against lockfile; skipping npm updates for this scan."
      rm -f "$log_file"
      return 0
    fi

    blame_pkg="$(npm_pnpm_parse_blame_direct_dep "$log_file" 2>/dev/null || true)"
    if [[ -z "$blame_pkg" ]]; then
      log "[pnpm] WARNING: lockfile verification failed (unparsed ERR_PNPM_NO_MATCHING_VERSION); skipping npm updates."
      rm -f "$log_file"
      return 0
    fi

    next_outdated=()
    removed_ver=""
    for line in "${pending_outdated[@]}"; do
      read -r pkg _cur lat <<<"$line"
      if [[ "$pkg" == "$blame_pkg" ]]; then
        removed_ver="$lat"
        log "[pnpm] Filtering ${pkg} → ${lat}: install resolution failed (missing transitive version)."
        continue
      fi
      next_outdated+=("$line")
    done

    if [[ -n "$removed_ver" ]]; then
      gk="$(npm_group_key "$blame_pkg" "$all_lines")"
      pending_outdated=()
      for line in "${next_outdated[@]}"; do
        read -r pkg _cur lat <<<"$line"
        if [[ "$(npm_group_key "$pkg" "$all_lines")" == "$gk" && "$lat" == "$removed_ver" ]]; then
          log "[pnpm] Filtering ${pkg} → ${lat}: same update group as ${blame_pkg} (unresolvable together)."
          continue
        fi
        pending_outdated+=("$line")
      done
    else
      pending_outdated=("${next_outdated[@]}")
    fi

    if [[ ${#pending_outdated[@]} -eq 0 ]]; then
      rm -f "$log_file"
      return 0
    fi
  done

  rm -f "$log_file"
  return 0
}

# Optional: DEP_UPDATER_ECO_FAIL_FILE is a temp file listing non-fatal ecosystem
# errors (one line each) so the run can continue and still exit non-zero.
dep_updater_append_ecosystem_failure() {
  if [[ -n "${DEP_UPDATER_ECO_FAIL_FILE:-}" ]]; then
    printf '%s\n' "$*" >> "${DEP_UPDATER_ECO_FAIL_FILE}"
  fi
}

dep_updater_ecosystem_failures_present() {
  [[ -n "${DEP_UPDATER_ECO_FAIL_FILE:-}" && -s "${DEP_UPDATER_ECO_FAIL_FILE}" ]]
}

dep_updater_print_ecosystem_failure_banner() {
  if ! dep_updater_ecosystem_failures_present; then
    return 0
  fi
  log ""
  log "[ecosystem-failures] One or more ecosystem update steps failed (other work continued):"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    log "  - ${line}"
  done < "${DEP_UPDATER_ECO_FAIL_FILE}"
}

dep_updater_ensure_eco_fail_file() {
  if [[ -z "${DEP_UPDATER_ECO_FAIL_FILE:-}" ]]; then
    DEP_UPDATER_ECO_FAIL_FILE="$(mktemp)"
    export DEP_UPDATER_ECO_FAIL_FILE
  fi
}

# When the parent sets DEP_UPDATER_RUN_REPORT to a temp path (batch-all child
# invocations only), write one JSON object the parent reads with jq — no log
# scraping. Keys: exit_code, dir, primary, details (array of strings).
# shellcheck disable=SC2317  # invoked indirectly from _on_exit
dep_updater_handle_ci_failure() {
  local -r pr_num="$1"
  local -r branch="${2:-}"
  local summary comment

  _last_ci_failure_json="$(ci_failure_details_json_for_pr "$pr_num" "${repo_owner}/${repo_name}" "$branch")"
  summary="$(ci_failure_summary_from_details_json "$_last_ci_failure_json")"

  log "PR #${pr_num} failed CI: ${summary}"
  comment="Closed by dep-updater: CI failed (${summary}). Re-run to create a fresh update."
  dep_runner_gh_stdout "gh pr" -- pr close "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --comment "$comment" \
    2>/dev/null || true

  record_first_failure "CI failed: pr=#${pr_num} ${summary}"
  die "CI failed: pr=#${pr_num} ${summary}. PR closed; re-run to create a fresh update."
}

# dep_updater_primary_is_generic <primary> <exit_code>
dep_updater_primary_is_generic() {
  runner_primary_is_generic_exit "$1" "dep-updater" "$2"
}

# dep_updater_actionable_primary_from_report <report_file> <exit_code>
# Prefer structured runner failures over generic exit-code placeholders.
dep_updater_actionable_primary_from_report() {
  runner_actionable_primary_from_report "$1" "$2" "dep-updater"
}

dep_updater_write_batch_child_report_json() {
  local -r exit_code="${1:?}"
  local -r first_failure="${2:-}"
  local out_file primary details_json ci_failure_json command_failures_json
  local capture_stderr capture_stdout resolved_primary tmp_report

  out_file="${DEP_UPDATER_RUN_REPORT:?}"
  primary="$first_failure"
  details_json='[]'
  ci_failure_json='null'
  command_failures_json='[]'
  capture_stderr=""
  capture_stdout=""

  if [[ -n "${RUNNER_SESSION_DIR:-}" ]] \
    && declare -F runner_failures_to_json >/dev/null 2>&1; then
    command_failures_json="$(runner_failures_to_json)"
  fi

  if [[ -n "${RUNNER_SESSION_DIR:-}" ]] \
    && declare -F runner_last_failure_capture_stderr >/dev/null 2>&1; then
    capture_stderr="$(runner_last_failure_capture_stderr 40)"
    capture_stdout="$(runner_last_failure_capture_stdout 40)"
  fi

  if [[ -n "${DEP_UPDATER_ECO_FAIL_FILE:-}" && -s "${DEP_UPDATER_ECO_FAIL_FILE}" ]]; then
    details_json="$(dep_runner_jq_file_args "dep-updater batch child report details" \
      "${DEP_UPDATER_ECO_FAIL_FILE}" -Rs 'split("\n") | map(select(length > 0))' 2>/dev/null || true)"
    [[ -z "$details_json" ]] && details_json='[]'
    if [[ -z "$primary" ]]; then
      primary="$(head -n 1 "${DEP_UPDATER_ECO_FAIL_FILE}" 2>/dev/null || true)"
    fi
  fi

  if [[ -z "$primary" ]]; then
    primary="dep-updater exited with code ${exit_code}"
  elif dep_updater_primary_is_generic "$primary" "$exit_code" \
    && [[ "$details_json" != '[]' ]]; then
    primary="$(dep_runner_jq_with_args "dep-updater batch child report primary" "$details_json" -r '.[0] // empty' 2>/dev/null || true)"
    [[ -z "$primary" ]] && primary="dep-updater exited with code ${exit_code}"
  fi

  if [[ -n "${_last_ci_failure_json:-}" && "$_last_ci_failure_json" != "null" ]]; then
    ci_failure_json="$_last_ci_failure_json"
  fi

  tmp_report="$(mktemp)"
  # shellcheck disable=SC2016  # jq -n object template uses jq variables, not shell expansion
  dep_runner_jq_n "dep-updater batch child report emit draft" \
    --argjson exit_code "$exit_code" \
    --arg dir "$dir" \
    --arg primary "$primary" \
    --argjson details "${details_json}" \
    --argjson ci_failure "${ci_failure_json}" \
    --argjson command_failures "${command_failures_json}" \
    --arg capture_stderr "$capture_stderr" \
    --arg capture_stdout "$capture_stdout" \
    '{exit_code: $exit_code, dir: $dir, primary: $primary, details: $details, ci_failure: $ci_failure, command_failures: $command_failures, capture_stderr: $capture_stderr, capture_stdout: $capture_stdout}' \
    >"$tmp_report" 2>/dev/null || true

  if [[ -s "$tmp_report" ]]; then
    resolved_primary="$(dep_updater_actionable_primary_from_report "$tmp_report" "$exit_code")"
    if [[ -n "$resolved_primary" ]]; then
      primary="$resolved_primary"
    fi
  fi
  rm -f "$tmp_report"

  # shellcheck disable=SC2016  # jq -n object template uses jq variables, not shell expansion
  if ! dep_runner_jq_n "dep-updater batch child report emit" \
    --argjson exit_code "$exit_code" \
    --arg dir "$dir" \
    --arg primary "$primary" \
    --argjson details "${details_json}" \
    --argjson ci_failure "${ci_failure_json}" \
    --argjson command_failures "${command_failures_json}" \
    --arg capture_stderr "$capture_stderr" \
    --arg capture_stdout "$capture_stdout" \
    '{exit_code: $exit_code, dir: $dir, primary: $primary, details: $details, ci_failure: $ci_failure, command_failures: $command_failures, capture_stderr: $capture_stderr, capture_stdout: $capture_stdout}' \
    >"$out_file" 2>/dev/null; then
    # shellcheck disable=SC2016  # jq -n fallback object uses jq variables, not shell expansion
    dep_runner_jq_n "dep-updater batch child report emit fallback" \
      --argjson exit_code "$exit_code" --arg primary "$primary" \
      --argjson ci_failure "${ci_failure_json}" \
      --argjson command_failures "${command_failures_json}" \
      --arg capture_stderr "$capture_stderr" \
      --arg capture_stdout "$capture_stdout" \
      '{exit_code: $exit_code, dir: "", primary: $primary, details: [], ci_failure: $ci_failure, command_failures: $command_failures, capture_stderr: $capture_stderr, capture_stdout: $capture_stdout}' \
      >"$out_file" 2>/dev/null || true
  fi
}

# When batch-all sets DEP_UPDATER_RUN_REPORT, emit structured failure JSON before
# cleanup() removes DEP_UPDATER_ECO_FAIL_FILE (success-path exits use this).
dep_updater_emit_batch_child_report() {
  local -r exit_code="${1:?}"
  local first_fail=""

  if [[ -z "${DEP_UPDATER_RUN_REPORT:-}" ]]; then
    return 0
  fi
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" && -s "${RUNNER_FIRST_FAILURE_FILE}" ]]; then
    first_fail="$(cat "${RUNNER_FIRST_FAILURE_FILE}")"
  fi
  dep_updater_write_batch_child_report_json "$exit_code" "$first_fail"
}

# dep_updater_runner_realpath <path>
# realpath via runner when available; falls back to bare realpath.
dep_updater_runner_realpath() {
  local -r path="$1"
  local result exit_code

  if declare -F runner_exec_stdout >/dev/null 2>&1; then
    exit_code=0
    result="$(runner_exec_stdout "realpath" -- realpath "$path")" || exit_code=$?
    if [[ "$exit_code" -eq 0 && -n "$result" ]]; then
      printf '%s\n' "$result"
      return 0
    fi
    return 1
  fi
  return 1
}

# dep_runner_git_rev_parse <label> <git-dir> <ref>
# Prints the resolved object name on success; returns non-zero when git fails.
dep_runner_git_rev_parse() {
  local -r label="$1"
  local -r git_dir="$2"
  local -r ref="$3"
  local exit_code uuid out

  exit_code=0
  runner_exec "$label" -- git -C "$git_dir" rev-parse "$ref" 2>/dev/null || exit_code=$?
  if (( exit_code != 0 )); then
    return "$exit_code"
  fi
  uuid="$(runner_last_id)"
  out="$(runner_read "$uuid" stdout 2>/dev/null || true)"
  printf '%s' "$out"
  return 0
}

# dep_runner_git_c_stdout <label> <git-dir> -- <git-args…>
# Line-oriented callers (while read over git ls-tree, etc.) must receive a trailing
# newline on the final line — git often omits it and bash read drops that entry.
# See detect_ecosystem nested npm discovery and issue #330.
dep_runner_git_c_stdout() {
  local -r label="$1"
  local -r git_dir="$2"
  shift 2
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local exit_code out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- git -C "$git_dir" "$@")" || exit_code=$?
  if [[ -n "$out" && "$out" != *$'\n' ]]; then
    out+=$'\n'
  fi
  printf '%s' "$out"
  return "$exit_code"
}

# dep_runner_gh_stdout <label> -- <gh-args…>
dep_runner_gh_stdout() {
  local -r label="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local exit_code out

  exit_code=0
  if [[ "${1:-}" == api ]]; then
    out="$(github_api_exec_with_rate_limit_retry "$label" -- gh "$@")" || exit_code=$?
  else
    out="$(runner_exec_stdout "$label" -- gh "$@")" || exit_code=$?
  fi
  printf '%s' "$out"
  return "$exit_code"
}

# dep_runner_gh <label> [--probe] -- <gh-args…>
# Also accepts --probe before <label> (audit/label call sites).
dep_runner_gh() {
  local probe=0 label exit_code

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  [[ -n "$label" ]] || return 2
  [[ "${1:-}" == '--' ]] || return 2
  shift
  exit_code=0
  if [[ "${1:-}" == api ]]; then
    if (( probe )); then
      github_api_exec_with_rate_limit_retry "$label" --probe -- gh "$@" >/dev/null || exit_code=$?
    else
      github_api_exec_with_rate_limit_retry "$label" -- gh "$@" >/dev/null || exit_code=$?
    fi
  elif (( probe )); then
    runner_exec "$label" --probe -- gh "$@" || exit_code=$?
  else
    runner_exec "$label" -- gh "$@" || exit_code=$?
  fi
  return "$exit_code"
}

# dep_runner_git_stdout <label> -- <git-args…>
dep_runner_git_stdout() {
  local -r label="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local exit_code out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- git "$@")" || exit_code=$?
  printf '%s' "$out"
  return "$exit_code"
}

# dep_runner_rg <label> [--probe] -- <rg-args…>
# Also accepts --probe before <label> (audit call sites).
dep_runner_rg() {
  local probe=0 label exit_code

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  [[ -n "$label" ]] || return 2
  [[ "${1:-}" == '--' ]] || return 2
  shift
  exit_code=0
  if (( probe )); then
    runner_exec "$label" --probe -- rg "$@" || exit_code=$?
  else
    runner_exec "$label" -- rg "$@" || exit_code=$?
  fi
  return "$exit_code"
}

# dep_runner_last_stdout
# Prints stdout from the most recent runner invocation in this session.
dep_runner_last_stdout() {
  local uuid

  uuid="$(runner_last_id)"
  [[ -n "$uuid" ]] || return 0
  runner_read "$uuid" stdout 2>/dev/null || true
}

# dep_updater_npm_registry_base
# Prints the npm registry URL with trailing slash.
dep_updater_npm_registry_base() {
  local registry exit_code uuid

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    printf '%s' 'https://registry.npmjs.org/'
    return 0
  fi

  exit_code=0
  runner_exec "pnpm config get registry" -- pnpm config get registry || exit_code=$?
  uuid="$(runner_last_id)"
  registry=""
  if [[ -n "$uuid" ]]; then
    registry="$(runner_read "$uuid" stdout | tr -d '[:space:]' || true)"
  fi
  if [[ -z "$registry" ]]; then
    registry='https://registry.npmjs.org'
  fi
  [[ "$registry" != */ ]] && registry="${registry}/"
  printf '%s' "$registry"
}

# dep_updater_npm_encode_pkg <pkg>
dep_updater_npm_encode_pkg() {
  local -r pkg="$1"
  local encoded

  encoded="${pkg//@/%40}"
  encoded="${encoded//\//%2F}"
  printf '%s' "$encoded"
}

# dep_runner_curl_http_code <label> <url>
dep_runner_curl_http_code() {
  local -r label="$1"
  local -r url="$2"
  local exit_code code

  exit_code=0
  runner_exec "$label" -- curl --silent --output /dev/null --write-out '%{http_code}' \
    --max-time 10 "$url" || exit_code=$?
  code="$(dep_runner_last_stdout | tr -d '[:space:]')"
  if [[ -z "$code" ]]; then
    code='000'
  fi
  printf '%s' "$code"
  return "$exit_code"
}

# dep_runner_curl_body <label> <url>
# Prints response body; returns curl exit code.
dep_runner_curl_body() {
  local -r label="$1"
  local -r url="$2"
  local exit_code

  exit_code=0
  runner_exec "$label" -- curl --silent --max-time 15 "$url" || exit_code=$?
  dep_runner_last_stdout
  return "$exit_code"
}

# dep_runner_jq_string <label> <json> <filter>
# Prints jq -r output; returns jq exit code.
dep_runner_jq_string() {
  local -r label="$1"
  local -r json="$2"
  local -r filter="$3"
  local tmp_json exit_code

  tmp_json="$(mktemp)"
  printf '%s' "$json" >"$tmp_json"
  exit_code=0
  runner_exec "$label" --stream-stdout -- jq -r "$filter" "$tmp_json" || exit_code=$?
  rm -f "$tmp_json"
  return "$exit_code"
}

# dep_runner_jq_with_args <label> [--probe] <json> [jq-args…]
# Also accepts --probe before <label> (audit call sites).
# Runs jq on a JSON string; prints jq stdout; returns jq exit code.
dep_runner_jq_with_args() {
  local probe=0 label json tmp_json exit_code out

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  json="$1"
  shift

  tmp_json="$(mktemp)"
  printf '%s' "$json" >"$tmp_json"
  exit_code=0
  if (( probe )); then
    out="$(runner_exec_stdout "$label" --probe -- jq "$@" "$tmp_json")" || exit_code=$?
  else
    out="$(runner_exec_stdout "$label" -- jq "$@" "$tmp_json")" || exit_code=$?
  fi
  rm -f "$tmp_json"
  if [[ -n "$out" && "${out: -1}" != $'\n' ]]; then
    printf '%s\n' "$out"
  else
    printf '%s' "$out"
  fi
  return "$exit_code"
}

# dep_runner_jq_file_args <label> [--probe] <file> [jq-args…]
# Also accepts --probe before <label>.
dep_runner_jq_file_args() {
  local probe=0 label file exit_code out

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  file="$1"
  shift

  exit_code=0
  if (( probe )); then
    out="$(runner_exec_stdout "$label" --probe -- jq "$@" "$file")" || exit_code=$?
  else
    out="$(runner_exec_stdout "$label" -- jq "$@" "$file")" || exit_code=$?
  fi
  if [[ -n "$out" && "${out: -1}" != $'\n' ]]; then
    printf '%s\n' "$out"
  else
    printf '%s' "$out"
  fi
  return "$exit_code"
}

# dep_runner_jq_n <label> [jq -n args…]
dep_runner_jq_n() {
  local -r label="$1"
  shift
  local exit_code out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- jq -n "$@")" || exit_code=$?
  if [[ -n "$out" && "${out: -1}" != $'\n' ]]; then
    printf '%s\n' "$out"
  else
    printf '%s' "$out"
  fi
  return "$exit_code"
}

# dep_runner_gh_api_jq <label> [--probe] <endpoint> <jq-filter>
# Also accepts --probe before <label>.
# Prints gh api --jq output; returns gh exit code.
# With --probe, non-zero exits are omitted from email failure reports.
dep_runner_gh_api_jq() {
  local probe=0 label endpoint jq_filter exit_code

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  endpoint="$1"
  jq_filter="$2"

  exit_code=0
  if (( probe )); then
    github_api_exec_with_rate_limit_retry "$label" --probe -- gh api "$endpoint" --jq "$jq_filter" \
      >/dev/null || exit_code=$?
  else
    github_api_exec_with_rate_limit_retry "$label" -- gh api "$endpoint" --jq "$jq_filter" \
      >/dev/null || exit_code=$?
  fi
  dep_runner_last_stdout
  return "$exit_code"
}

# dep_runner_gh_pr_jq <label> <pr-num> <json-fields> <jq-filter>
dep_runner_gh_pr_jq() {
  local -r label="$1"
  local -r pr_num="$2"
  local -r json_fields="$3"
  local -r jq_filter="$4"
  local exit_code

  exit_code=0
  runner_exec "$label" -- gh pr view "$pr_num" \
    --repo "${repo_owner}/${repo_name}" --json "$json_fields" --jq "$jq_filter" || exit_code=$?
  dep_runner_last_stdout
  return "$exit_code"
}

# dep_runner_pnpm_view_version <label> <pkg> [project-root]
dep_runner_pnpm_view_version() {
  local -r label="$1"
  local -r pkg="$2"
  local -r project_root="${3:-$dir}"
  local cmd_quoted exit_code

  cmd_quoted="$(runner_quote_cmdline pnpm view "$pkg" version)"
  exit_code=0
  runner_sh "$label" --stream-stdout \
    "cd $(printf '%q' "$project_root") && ${cmd_quoted}" || exit_code=$?
  return "$exit_code"
}

# dep_runner_sh_stdout <label> -- <shell-command>
dep_runner_sh_stdout() {
  local -r label="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local -r cmd="$*"
  local exit_code out

  exit_code=0
  out="$(runner_sh_stdout "$label" -- "$cmd")" || exit_code=$?
  printf '%s' "$out"
  return "$exit_code"
}

# dep_runner_sh <label> -- <shell-command>
dep_runner_sh() {
  local -r label="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local -r cmd="$*"
  local exit_code

  exit_code=0
  runner_sh "$label" -- "$cmd" || exit_code=$?
  return "$exit_code"
}

