#!/usr/bin/env bash
# dep-updater — discover and bump outdated dependencies via a Graphite PR stack.
#
# Creates one stacked PR per outdated package inside a dedicated git worktree,
# waits for CI on each PR, then cleans up the worktree once the stack is merged.
#
# See scripts/dep-updater.plan.md for full design documentation.
set -euo pipefail

# uv's cache sits on the home filesystem while worktrees live in /tmp (a
# separate filesystem).  Hardlinks can't cross filesystems, so uv falls back
# to copying and emits a warning unless we tell it copy mode is expected.
export UV_LINK_MODE=copy

# Note: we intentionally do NOT use set -E (errtrace) because it causes the
# ERR trap to be inherited by command substitution subshells.  That would fire
# cleanup_on_error from inside a $(cmd) subshell, deleting the real worktree
# while the parent shell continues executing — the root cause of worktree leaks.
# The EXIT trap below is sufficient: set -e causes the main process to exit on
# any unhandled failure, which fires the EXIT trap exactly once.
trap '_on_exit'          EXIT
trap '_on_signal INT'    INT
trap '_on_signal TERM'   TERM

# Prefer user-local installs (e.g. gh, gt installed via their official installers
# under ~/.local/bin) over system-wide ones that may be stale or absent.
if [[ -d "${HOME}/.local/bin" ]]; then
  PATH="${HOME}/.local/bin:${PATH}"
fi

# ---------------------------------------------------------------------------
# Script-level constants
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Mutable globals — set during startup; frozen to readonly after parsing
# ---------------------------------------------------------------------------

dry_run=0
cleanup_mode=0
rebase_mode=0
dir=""
ecosystem="auto"
semver_only=0
no_wait_ci=0
no_wait_merge=0
security_only=0
batch=0
merge_timeout_min=15
wt_tmpdir=""
quiet=0
report_json=0

# Newline-separated list of workflow names that trigger on pull_request events.
# Populated by detect_ci_workflows(); empty means "all runs" (fallback).
ci_workflow_names=""

# Set after detect_ecosystem
has_npm=0
npm_tool=""
py_tool=""

# Set after create_worktree / init_state_file
worktree_path=""
wt_base_branch=""
state_file=""

summary_lines=""

# Set to 1 once the worktree is live so the EXIT trap knows cleanup is needed.
_cleanup_trap_active=0

prompt_color=""
prompt_color_reset=""

# Cyan for our own log lines — distinguishes dep-updater output from tool stdout.
log_color=""
log_reset=""

repo_owner=""
repo_name=""

# ---------------------------------------------------------------------------
# Utility functions
# ---------------------------------------------------------------------------

is_interactive() {
  # Returns 0 (true) if stdin is a TTY and we're not in a non-interactive flag mode
  [[ -t 0 ]] && [[ "$dry_run" == '0' ]]
}

init_prompt_style() {
  if [[ -n "${NO_COLOR:-}" ]]; then
    return 0
  fi

  local term_value
  term_value="${TERM:-}"
  if [[ "$term_value" == "dumb" || -z "$term_value" ]]; then
    return 0
  fi

  # Only check for a TTY — colour is useful in dry-run too; we just skip
  # the interactive prompt colours when stdin is not a TTY.
  if [[ ! -t 2 ]]; then
    return 0
  fi

  # Cyan log lines so our output is visually distinct from tool output.
  log_color='\033[0;36m'
  log_reset='\033[0m'

  # Blue prompt text for interactive questions — only when truly interactive.
  if is_interactive; then
    prompt_color='\033[1;34m'
    prompt_color_reset='\033[0m'
  fi
}

prompt_yes_no() {
  local -r question="$1"
  local -r default="${2:-n}"

  if ! is_interactive; then
    return 1  # Non-interactive; assume "no"
  fi

  local prompt_text="$question"
  case "$default" in
    y) prompt_text="${prompt_text} [Y/n] " ;;
    n) prompt_text="${prompt_text} [y/N] " ;;
    *) prompt_text="${prompt_text} [y/n] " ;;
  esac

  if [[ -n "$prompt_color" ]]; then
    printf '%b%s%b' "$prompt_color" "$prompt_text" "$prompt_color_reset" >&2
  else
    printf '%s' "$prompt_text" >&2
  fi
  read -r -s -n 1 response
  printf '\n' >&2

  case "$response" in
    Y|y) return 0 ;;
    N|n) return 1 ;;
    '') [[ "$default" == "y" ]] ;;
    *)   return 1 ;;
  esac
}

# Checks if the Graphite stack needs rebasing on main
# Returns 0 (true) if stack needs restack, 1 (false) if up-to-date
stack_needs_rebase() {
  local branches_csv gt_state_json
  branches_csv="$(state_get "branches")"
  [[ -z "$branches_csv" ]] && return 1

  # Strict signal: gt state JSON (stable and branch-specific).
  gt_state_json="$(run_in_worktree gt state 2>/dev/null || true)"
  if [[ -z "$gt_state_json" ]]; then
    die "Could not read Graphite state (empty output from 'gt state')."
  fi

  if ! printf '%s' "$gt_state_json" | jq -e . >/dev/null 2>&1; then
    die "Could not parse Graphite state JSON from 'gt state'."
  fi

  if printf '%s' "$gt_state_json" \
    | jq -e --arg csv "$branches_csv" '
        ($csv | split(",") | map(select(length > 0))) as $branches
        | any($branches[]; (. [.]?.needs_restack // false) == true)
      ' >/dev/null; then
    return 0
  fi
  return 1
}

log_stack_rebase_context() {
  local branches_csv current_branch gt_state_json needs_restack_lines
  branches_csv="$(state_get "branches")"
  current_branch="$(git -C "$worktree_path" branch --show-current 2>/dev/null || true)"
  gt_state_json="$(run_in_worktree gt state 2>/dev/null || true)"

  if [[ -z "$gt_state_json" ]]; then
    die "Could not read Graphite state for rebase diagnostics (empty output from 'gt state')."
  fi

  if ! printf '%s' "$gt_state_json" | jq -e . >/dev/null 2>&1; then
    die "Could not parse Graphite state JSON for rebase diagnostics."
  fi

  needs_restack_lines="$(printf '%s' "$gt_state_json" \
    | jq -r --arg csv "$branches_csv" '
        ($csv | split(",") | map(select(length > 0))) as $branches
        | [
            $branches[] as $b
            | select((.[ $b ]?.needs_restack // false) == true)
            | "\($b) (needs_restack=true)"
          ]
        | .[]?
      ' 2>/dev/null || true)"

  log "Stack needs rebase on main."
  log "  worktree: $worktree_path"
  if [[ -n "$current_branch" ]]; then
    log "  current branch: $current_branch"
  fi
  if [[ -n "$branches_csv" ]]; then
    log "  tracked stack branches: $branches_csv"
  fi

  if [[ -n "$needs_restack_lines" ]]; then
    log "  reason (Graphite):"
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      log "    - ${line}"
    done <<< "$needs_restack_lines"
  fi

  if [[ -n "$branches_csv" ]]; then
    local first_branch left_only right_only
    first_branch="$(cut -d',' -f1 <<< "$branches_csv")"
    if [[ -n "$first_branch" ]] \
      && git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${first_branch}" \
      && git -C "$worktree_path" show-ref --verify --quiet "refs/remotes/origin/main"; then
      left_only="$(git -C "$worktree_path" rev-list --left-only --count "${first_branch}...origin/main" 2>/dev/null || echo 0)"
      right_only="$(git -C "$worktree_path" rev-list --right-only --count "${first_branch}...origin/main" 2>/dev/null || echo 0)"
      log "  reason (commit delta):"
      log "    - commits on stack base not on origin/main: ${left_only}"
      log "    - commits on origin/main not on stack base: ${right_only}"
      if [[ "$right_only" != '0' ]]; then
        log "    - origin/main has moved ahead of the stack base."
      fi
    fi
  fi
}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log() {
  [[ "$quiet" == '1' ]] && return 0
  local ts
  ts="$(date '+%H:%M:%S.%3N')"
  if [[ -n "$log_color" ]]; then
    printf '%b%s  %s%b\n' "$log_color" "$ts" "$*" "$log_reset" >&2
  else
    printf '%s  %s\n' "$ts" "$*" >&2
  fi
}

die() {
  log "ERROR: $*"
  exit 1
}

# Commit in the worktree, inheriting the signing config (gpg/ssh) from the
# source repo's effective config.  Without this, commits made in the worktree
# may be unsigned even when the user has commit.gpgsign=true in their repo or
# global git config, because git -C <worktree> can resolve the config but the
# GPG/SSH agent environment may differ from the calling shell's context.
_worktree_commit() {
  local -r msg="$1"
  local -a sign_flags=()
  local gpg_sign gpg_format sign_key
  gpg_sign="$(git -C "$dir" config --bool commit.gpgsign 2>/dev/null || echo 'false')"
  if [[ "$gpg_sign" == 'true' ]]; then
    sign_flags+=('-c' 'commit.gpgsign=true')
    gpg_format="$(git -C "$dir" config gpg.format 2>/dev/null || true)"
    [[ -n "$gpg_format" ]] && sign_flags+=('-c' "gpg.format=${gpg_format}")
    sign_key="$(git -C "$dir" config commit.signingkey 2>/dev/null || true)"
    [[ -n "$sign_key" ]] && sign_flags+=('-c' "commit.signingkey=${sign_key}")
    log "[commit] GPG signing enabled (format: ${gpg_format:-default}, key: ${sign_key:-(from agent)})"
  else
    log "[commit] GPG signing disabled"
  fi
  git -C "$worktree_path" "${sign_flags[@]}" commit -m "$msg"
}

# ---------------------------------------------------------------------------
# Exit / signal traps — clean up the worktree on unexpected death
# (Registered in main(); defined here so they can reference cleanup_on_error.)
# ---------------------------------------------------------------------------

# shellcheck disable=SC2317  # invoked via EXIT trap, not directly
_on_exit() {
  local exit_code=$?
  # Reset the EXIT trap immediately so cleanup_on_error can't re-trigger it.
  trap - EXIT
  # Only run cleanup if the worktree phase was reached and the exit is non-zero.
  if [[ "$_cleanup_trap_active" == '1' && $exit_code -ne 0 ]]; then
    cleanup_on_error "script exited unexpectedly (exit code ${exit_code})"
  fi
}

# shellcheck disable=SC2317  # invoked via INT/TERM traps, not directly
_on_signal() {
  local sig="$1"
  # Reset all traps before re-raising so we don't loop back into this handler.
  trap - EXIT INT TERM
  if [[ "$_cleanup_trap_active" == '1' ]]; then
    log ""
    log "Interrupted (SIG${sig}) — cleaning up…"
    cleanup_on_error "interrupted by SIG${sig}"
  fi
  # Re-raise with the conventional signal exit code so the caller's $? is right.
  kill -s "$sig" "$$"
}

init_repo_api_context() {
  local remote_url
  remote_url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote_url" ]]; then
    die "Could not resolve git remote 'origin' from: $dir"
  fi

  local slug
  slug="$(printf '%s' "$remote_url" \
    | sed -E 's#^git@github.com:##; s#^https://github.com/##; s#\.git$##')"

  if [[ "$slug" != */* ]]; then
    die "Could not parse GitHub owner/repo from origin URL: $remote_url"
  fi

  repo_owner="${slug%%/*}"
  repo_name="${slug##*/}"
}

gh_pr_number_for_branch() {
  local -r branch="$1"
  # Filter by state=open and the dep-updater label so closed/merged PRs from
  # previous runs are never confused with the current run's PR.
  gh api "repos/${repo_owner}/${repo_name}/pulls" \
    --method GET \
    -f state=open \
    -f head="${repo_owner}:${branch}" \
    -f per_page=5 \
    --jq 'map(select(any(.labels[]; .name == "dep-updater"))) | .[0].number // empty' \
    2>/dev/null || true
}

# Used immediately after gt submit, before the dep-updater label has been applied.
# Must not filter by label — the PR was just created and has no labels yet.
gh_pr_number_for_new_branch() {
  local -r branch="$1"
  gh pr view "$branch" --repo "${repo_owner}/${repo_name}" \
    --json number --jq '.number' 2>/dev/null || true
}

gh_pr_state_for_number() {
  local -r pr_number="$1"
  gh api "repos/${repo_owner}/${repo_name}/pulls/${pr_number}" \
    --jq '.state // empty' 2>/dev/null || true
}

gh_pr_merged_for_number() {
  local -r pr_number="$1"
  gh api "repos/${repo_owner}/${repo_name}/pulls/${pr_number}" \
    --jq '(.merged_at != null)' 2>/dev/null || true
}

add_merge_it_label() {
  local -r pr_number="$1"
  gh api "repos/${repo_owner}/${repo_name}/issues/${pr_number}/labels" \
    --method POST \
    -f labels[]=merge-it >/dev/null
  # my-tracks uses Graphite's multi-partition merge queue, which requires the
  # 'merge-mq' label (in addition to 'merge-it') to enqueue a PR.
  # my-tracks uses Graphite's multi-partition merge queue, which requires the
  # 'merge-mq' label (in addition to 'merge-it') to enqueue a PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh api "repos/${repo_owner}/${repo_name}/issues/${pr_number}/labels" \
      --method POST \
      -f labels[]=merge-mq >/dev/null 2>/dev/null || true
  fi
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'USAGE'
Usage:
  dep-updater [OPTIONS]
  dep-updater --cleanup [--dir <path>]
  dep-updater --rebase [--dir <path>]

Modes:
  (no flags)        Update: create worktree, stack PRs, wait for merge, cleanup
  --dry-run         Preview exact per-PR plan and scope; no git or worktree changes
  --cleanup         Read saved state and clean up after stack is merged
  --rebase          Rebase existing stack on top of newest main

Options:
  --dir <path>      Project root (default: current directory)
  --ecosystem <e>   Force: npm | python | auto  (default: auto)
  --semver-only     npm: respect existing semver range (omit --latest)
  --no-wait-ci      Skip CI polling between PRs
  --no-wait-merge   Exit after stack is submitted; print cleanup command
  --security-only   Only create CVE-fix PRs; skip regular version bumps
  --batch           Combine all updates into a single PR instead of one per package
  --merge-timeout <min>  Minutes to wait for all PRs to merge (default: 15)
  --tmpdir <path>   Directory under which to create the dep-updater worktree
                    (default: \$TMPDIR or /tmp)
  -h, --help        Print this help and exit

Supported ecosystems:
  npm      package.json present  → pnpm outdated + pnpm update
  uv       uv.lock present       → uv pip list --outdated + uv add
  poetry   poetry.lock present   → poetry show --outdated + poetry add
  pipenv   Pipfile.lock present  → pipenv run pip list + pipenv install
  pip      requirements.txt or pyproject.toml → pip list + pip freeze
USAGE
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        ;;
      --cleanup)
        cleanup_mode=1
        ;;
      --rebase)
        rebase_mode=1
        ;;
      --dir)
        shift
        [[ $# -eq 0 ]] && die "--dir requires a path argument."
        dir="$1"
        ;;
      --ecosystem)
        shift
        [[ $# -eq 0 ]] && die "--ecosystem requires a value: npm | python | auto"
        ecosystem="$1"
        ;;
      --semver-only)
        semver_only=1
        ;;
      --no-wait-ci)
        no_wait_ci=1
        ;;
      --no-wait-merge)
        no_wait_merge=1
        ;;
      --security-only)
        security_only=1
        ;;
      --batch)
        batch=1
        ;;
      --merge-timeout)
        shift
        [[ $# -eq 0 ]] && die "--merge-timeout requires a number of minutes."
        merge_timeout_min="$1"
        ;;
      --tmpdir)
        shift
        [[ $# -eq 0 ]] && die "--tmpdir requires a path argument."
        wt_tmpdir="$1"
        ;;
      --quiet)
        quiet=1
        ;;
      --report-json)
        report_json=1
        dry_run=1
        quiet=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option: '$1'. Use -h for help."
        ;;
    esac
    shift
  done

  case "$ecosystem" in
    npm|python|auto) : ;;
    *) die "Invalid --ecosystem: '$ecosystem'. Valid values: npm | python | auto" ;;
  esac

  local resolved_dir
  if [[ -n "$dir" ]]; then
    resolved_dir="$(cd "$dir" && pwd)"
  else
    resolved_dir="$(git rev-parse --show-toplevel 2>/dev/null)" \
      || die "Not inside a git repository and --dir was not specified."
  fi
  dir="$resolved_dir"

  if [[ -n "$wt_tmpdir" ]]; then
    if [[ ! -d "$wt_tmpdir" ]]; then
      mkdir -p "$wt_tmpdir" \
        || die "Could not create --tmpdir directory: $wt_tmpdir"
    fi
    wt_tmpdir="$(cd "$wt_tmpdir" && pwd)"
  fi

  # shellcheck disable=SC2034  # cleanup_mode, rebase_mode, merge_timeout_min used in main() dispatch
  readonly dry_run cleanup_mode rebase_mode dir ecosystem semver_only no_wait_ci no_wait_merge security_only batch merge_timeout_min wt_tmpdir quiet report_json
}

# ---------------------------------------------------------------------------
# Prerequisite checks — Phase 1: core tools (always required)
# ---------------------------------------------------------------------------

check_core_prereqs() {
  local missing=0

  log "[tooling]"
  for tool in git gt gh jq rg; do
    local tool_path
    tool_path="$(command -v "$tool" 2>/dev/null || true)"
    if [[ -z "$tool_path" ]]; then
      case "$tool" in
        gt)  log "  ERROR: 'gt' (Graphite CLI) not found. Install: https://graphite.dev/docs/install" ;;
        gh)  log "  ERROR: 'gh' (GitHub CLI) not found.    Install: https://cli.github.com" ;;
        jq)  log "  ERROR: 'jq' not found.                 Install: https://jqlang.github.io/jq/download/" ;;
        rg)  log "  ERROR: 'rg' (ripgrep) not found.       Install: https://github.com/BurntSushi/ripgrep#installation" ;;
        *)   log "  ERROR: '${tool}' is required but not found in PATH." ;;
      esac
      missing=$(( missing + 1 ))
    else
      local version
      version="$("$tool" --version 2>/dev/null | head -1 || echo '?')"
      log "  ${tool}: ${tool_path} (${version})"
    fi
  done

  if (( missing > 0 )); then
    die "Install the missing tool(s) above and retry."
  fi
}

# ---------------------------------------------------------------------------
# Prerequisite checks — auth (skipped in dry-run)
# ---------------------------------------------------------------------------

check_auth_prereqs() {
  log "[auth]"

  local gh_user
  if ! gh_user="$(gh auth status 2>&1 | grep -oP '(?<=account )\S+' | head -1)"; then
    die "'gh' is not authenticated. Run: gh auth login"
  fi
  if [[ -z "$gh_user" ]]; then
    die "'gh' is not authenticated. Run: gh auth login"
  fi
  log "  gh: logged in as ${gh_user}"

  local gt_out
  if ! gt_out="$(gt auth 2>&1)"; then
    die "'gt' is not authenticated. Run: gt auth"
  fi
  local gt_user
  gt_user="$(printf '%s' "$gt_out" | grep -oP '(?<=Authenticated as: )\S+' | head -1 || true)"
  if [[ -n "$gt_user" ]]; then
    log "  gt: authenticated as ${gt_user}"
  else
    log "  gt: authenticated"
  fi

  # Reconfigure git's credential helper to point at the gh binary currently in
  # PATH (idempotent). This fixes stale absolute paths like /usr/bin/gh that
  # were written when gh was first installed at a different location.
  gh auth setup-git
  log "  git credential helper: updated to current gh path"
}

# ---------------------------------------------------------------------------
# Prerequisite checks — Phase 2: ecosystem tools (checked after detection)
# ---------------------------------------------------------------------------

check_ecosystem_prereqs() {
  local -r chk_npm="$1"
  local -r chk_py="$2"
  local missing=0

  if [[ "$chk_npm" == '1' ]]; then
    local tool_to_check="$npm_tool"
    [[ -z "$tool_to_check" ]] && tool_to_check="pnpm"
    if ! command -v "$tool_to_check" &>/dev/null; then
      log "ERROR: '${tool_to_check}' is required for npm projects."
      case "$tool_to_check" in
        pnpm) log "       Install: npm install -g pnpm" ;;
        yarn) log "       Install: npm install -g yarn" ;;
        npm)  log "       'npm' should be installed with Node.js: https://nodejs.org" ;;
      esac
      missing=$(( missing + 1 ))
    fi
  fi

  if [[ -n "$chk_py" ]]; then
    if [[ "$chk_py" == 'pip' ]]; then
      if ! command -v pip &>/dev/null && ! command -v pip3 &>/dev/null; then
        log "ERROR: 'pip' (or 'pip3') is required for Python projects."
        missing=$(( missing + 1 ))
      elif ! command -v pip &>/dev/null && command -v pip3 &>/dev/null; then
        py_tool="pip3"  # promote pip3 globally
      fi
    elif ! command -v "$chk_py" &>/dev/null; then
      case "$chk_py" in
        uv)     log "ERROR: 'uv' not found.     Install: https://docs.astral.sh/uv/" ;;
        poetry) log "ERROR: 'poetry' not found. Install: https://python-poetry.org/docs/" ;;
        pipenv) log "ERROR: 'pipenv' not found. Run: pip install pipenv" ;;
        *)      log "ERROR: '${chk_py}' is required but not found." ;;
      esac
      missing=$(( missing + 1 ))
    fi
  fi

  if (( missing > 0 )); then
    die "Install the missing tool(s) above and retry."
  fi
}

# ---------------------------------------------------------------------------
# Ecosystem detection
# ---------------------------------------------------------------------------

detect_ecosystem() {
  if [[ "$ecosystem" == 'npm' || "$ecosystem" == 'auto' ]]; then
    if [[ -f "$dir/package.json" ]]; then
      has_npm=1
      # Detect the package manager from the lockfile.  Check both the current
      # working tree AND origin/main (the worktree base), because a feature branch
      # may predate the project's adoption of pnpm/yarn and therefore lack the
      # lockfile that exists on main.  Checking origin/main avoids committing
      # a wrong-tool lockfile (e.g. package-lock.json on a pnpm project).
      _lockfile_in_main() {
        local f="$1"
        [[ -f "$dir/$f" ]] \
          || git -C "$dir" ls-tree --name-only origin/main -- "$f" 2>/dev/null | grep -q .
      }
      if _lockfile_in_main "pnpm-lock.yaml"; then
        npm_tool="pnpm"
      elif _lockfile_in_main "yarn.lock"; then
        npm_tool="yarn"
      else
        # package-lock.json or no lockfile at all — default to npm.
        npm_tool="npm"
      fi
      unset -f _lockfile_in_main
    fi
  fi

  if [[ "$ecosystem" == 'python' || "$ecosystem" == 'auto' ]]; then
    if [[ -f "$dir/uv.lock" ]]; then
      py_tool="uv"
    elif [[ -f "$dir/poetry.lock" ]]; then
      py_tool="poetry"
    elif [[ -f "$dir/Pipfile.lock" ]]; then
      py_tool="pipenv"
    elif [[ -f "$dir/requirements.txt" || -f "$dir/pyproject.toml" ]]; then
      py_tool="pip"
    fi
  fi

  if [[ "$has_npm" == '0' && -z "$py_tool" ]]; then
    if [[ "$dry_run" == '1' ]]; then
      log "No supported ecosystem detected in: $dir"
    else
      die "No supported ecosystem detected in: $dir"
    fi
  fi

  readonly has_npm npm_tool py_tool

  local eco_msg=""
  if [[ "$has_npm" == '1' ]]; then
    eco_msg="npm (${npm_tool})"
  fi
  if [[ -n "$py_tool" ]]; then
    if [[ -n "$eco_msg" ]]; then
      eco_msg="${eco_msg}, python/${py_tool}"
    else
      eco_msg="python/${py_tool}"
    fi
  fi
  log "Detected: ${eco_msg}"

  # Log ecosystem tool paths and versions alongside core tooling.
  log "[ecosystem tooling]"
  local eco_tools=()
  if [[ "$has_npm" == '1' ]]; then
    eco_tools+=("$npm_tool")
  fi
  if [[ -n "$py_tool" ]]; then
    eco_tools+=("$py_tool")
    if [[ "$py_tool" == 'uv' ]]; then
      # pip-audit runs via uv; log it too if present.
      if command -v pip-audit &>/dev/null || uv run --no-project --with pip-audit pip-audit --version &>/dev/null 2>&1; then
        eco_tools+=("pip-audit")
      fi
    else
      if command -v pip-audit &>/dev/null; then
        eco_tools+=("pip-audit")
      fi
    fi
  fi
  local et
  for et in "${eco_tools[@]}"; do
    local et_path et_version
    if [[ "$et" == 'pip-audit' && "$py_tool" == 'uv' ]]; then
      et_path="(via uv run)"
      et_version="$(uv run --no-project --with pip-audit pip-audit --version 2>/dev/null | head -1 || echo '?')"
    else
      et_path="$(command -v "$et" 2>/dev/null || echo '(not found)')"
      et_version="$("$et" --version 2>/dev/null | head -1 || echo '?')"
    fi
    log "  ${et}: ${et_path} (${et_version})"
  done
}

# Discover which workflows in .github/workflows/ are triggered on pull_request
# events, and store their names in the global ci_workflow_names (newline-
# separated).  Used by wait_for_ci and friends so they match the real CI
# workflow name(s) instead of relying on a hardcoded string.
detect_ci_workflows() {
  local workflows_dir="${dir}/.github/workflows"
  if [[ ! -d "$workflows_dir" ]]; then
    log "[ci] No .github/workflows/ directory found; will monitor all workflow runs."
    return
  fi

  local names=() f name
  for f in "${workflows_dir}"/*.yml "${workflows_dir}"/*.yaml; do
    [[ -f "$f" ]] || continue
    # Skip workflows without a pull_request trigger.
    # Match YAML trigger keys: `  pull_request:` or `  pull_request_target:`
    # or inline array form: `on: [pull_request, ...]`
    grep -qE '^[[:space:]]*(pull_request|pull_request_target)[[:space:]]*[:$]' "$f" 2>/dev/null \
      || grep -qE '^on:[[:space:]]*\[.*pull_request' "$f" 2>/dev/null \
      || continue
    # Skip workflows whose pull_request trigger is restricted to types that
    # never fire on a PR push (e.g. types: [closed]).  Only include workflows
    # that can run when a PR is opened or updated.
    # If there is any explicit types: list, require at least one push-relevant
    # type (opened / synchronize / reopened / ready_for_review).
    if grep -qE '^\s+types\s*:' "$f" 2>/dev/null; then
      grep -qE '\b(opened|synchronize|reopened|ready_for_review)\b' "$f" 2>/dev/null \
        || continue
    fi
    name="$(grep -m1 '^name:' "$f" | sed 's/^name:[[:space:]]*//' | tr -d "\"'")"
    [[ -n "$name" ]] && names+=("$name")
  done

  if [[ ${#names[@]} -gt 0 ]]; then
    ci_workflow_names="$(printf '%s\n' "${names[@]}")"
    log "[ci] PR workflows: $(printf '%s, ' "${names[@]}" | sed 's/, $//')"
  else
    log "[ci] No PR-triggered workflows found; will monitor all workflow runs."
  fi
}

# ---------------------------------------------------------------------------
# Working directory state note
# ---------------------------------------------------------------------------

warn_if_dirty_workdir() {
  if ! git -C "$dir" diff --quiet 2>/dev/null \
    || ! git -C "$dir" diff --cached --quiet 2>/dev/null; then
    log "Working directory has local changes."
    log "dep-updater runs in a clean dep-updater worktree from 'main' (created or reused); uncommitted local changes are not included."
  fi
}

# ---------------------------------------------------------------------------
# Branch name sanitization
# ---------------------------------------------------------------------------

sanitize_branch_name() {
  local -r input="$1"
  printf '%s' "$input" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's|[@/._]|-|g; s|-\+|-|g; s|^-||; s|-$||'
}

# ---------------------------------------------------------------------------
# Run a command inside the worktree (subshell with cd)
# ---------------------------------------------------------------------------

run_in_worktree() {
  (cd "$worktree_path" && "$@")
}

# ---------------------------------------------------------------------------
# State file helpers
# ---------------------------------------------------------------------------

init_state_file() {
  local repo_hash
  repo_hash="$(printf '%s' "$dir" | md5sum | cut -c1-8)"
  state_file="${wt_tmpdir:-${TMPDIR:-/tmp}}/.dep-updater-state-${repo_hash}"
  readonly state_file
}

state_get() {
  local -r key="$1"
  rg -m1 "^${key}=" "$state_file" 2>/dev/null | cut -d= -f2- || true
}

state_set() {
  local -r key="$1"
  local -r value="$2"
  if rg -q "^${key}=" "$state_file" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$state_file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$state_file"
  fi
}

state_append() {
  local -r key="$1"
  local -r value="$2"
  local current
  current="$(state_get "$key")"
  if [[ -z "$current" ]]; then
    state_set "$key" "$value"
  else
    state_set "$key" "${current},${value}"
  fi
}

is_valid_pr_number() {
  local -r value="$1"
  [[ "$value" =~ ^[0-9]+$ ]]
}

state_append_pr() {
  local -r pr_number="$1"
  if ! is_valid_pr_number "$pr_number"; then
    log "Warning: skipping invalid PR number in state append: '${pr_number}'"
    return 0
  fi
  state_append "prs" "$pr_number"
}

sanitize_state_prs() {
  [[ ! -f "$state_file" ]] && return 0

  local prs_csv
  prs_csv="$(state_get "prs")"
  [[ -z "$prs_csv" ]] && return 0

  local cleaned="" removed_any=0 token
  IFS=',' read -ra pr_list <<< "$prs_csv"
  for token in "${pr_list[@]}"; do
    [[ -z "$token" ]] && continue
    if is_valid_pr_number "$token"; then
      if [[ -z "$cleaned" ]]; then
        cleaned="$token"
      else
        cleaned="${cleaned},${token}"
      fi
    else
      removed_any=1
      log "Warning: removing invalid PR token from state: '${token}'"
    fi
  done

  if [[ "$removed_any" == '1' ]]; then
    state_set "prs" "$cleaned"
  fi
}

csv_contains() {
  local -r csv="$1"
  local -r needle="$2"
  [[ ",${csv}," == *",${needle},"* ]]
}

csv_last() {
  local -r csv="$1"
  if [[ -z "$csv" ]]; then
    printf ''
  else
    awk -F',' '{print $NF}' <<< "$csv"
  fi
}

csv_pretty() {
  local -r csv="$1"
  if [[ -z "$csv" ]]; then
    printf ''
  else
    printf '%s' "$csv" | sed 's/,/, /g'
  fi
}

collect_tracked_prs_csv() {
  local branches_csv prs_csv collected=""
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"

  if [[ -n "$branches_csv" ]]; then
    local b pr
    IFS=',' read -ra b_list <<< "$branches_csv"
    for b in "${b_list[@]}"; do
      [[ -z "$b" ]] && continue
      pr="$(gh_pr_number_for_branch "$b")"
      if [[ -n "$pr" ]] && is_valid_pr_number "$pr" && ! csv_contains "$collected" "$pr"; then
        if [[ -z "$collected" ]]; then
          collected="$pr"
        else
          collected="${collected},${pr}"
        fi
      fi
    done
  fi

  if [[ -n "$prs_csv" ]]; then
    local p
    IFS=',' read -ra p_list <<< "$prs_csv"
    for p in "${p_list[@]}"; do
      [[ -z "$p" ]] && continue
      if is_valid_pr_number "$p" && ! csv_contains "$collected" "$p"; then
        if [[ -z "$collected" ]]; then
          collected="$p"
        else
          collected="${collected},${p}"
        fi
      fi
    done
  fi

  printf '%s' "$collected"
}

write_initial_state() {
  local -r wt="$1"
  local timestamp
  timestamp="$(date --utc +%Y-%m-%dT%H:%M:%SZ)"
  printf 'worktree=%s\nbase_branch=main\nwt_branch=%s\ncreated_at=%s\nbranches=\nprs=\n' \
    "$wt" "$wt_base_branch" "$timestamp" > "$state_file"
}

# ---------------------------------------------------------------------------
# Worktree management
# ---------------------------------------------------------------------------

create_worktree() {
  local timestamp
  timestamp="$(date --utc +%Y%m%dT%H%M%S)"
  local base_path
  base_path="${wt_tmpdir:-${TMPDIR:-/tmp}}/dep-updater-wt-${timestamp}-$$"
  worktree_path="$base_path"
  local suffix=0
  while [[ -e "$worktree_path" ]]; do
    suffix=$(( suffix + 1 ))
    worktree_path="${base_path}-${suffix}"
  done

  log "[worktree] Creating worktree at: $worktree_path"
  # Fetch origin/main first so the worktree starts from exactly what GitHub sees.
  # Using a stale local 'main' that diverges from origin/main causes the first
  # PR to show as conflicting immediately.
  log "Fetching origin/main…"
  git -C "$dir" fetch origin main 2>/dev/null || true

  # Create a uniquely-named local branch at origin/main's commit. Using 'main'
  # directly fails with "fatal: 'main' is already used by worktree at …" when
  # main is already checked out in the primary clone. A named branch is also
  # required by gt, which refuses to operate on a detached HEAD.
  local main_sha
  if ! main_sha="$(git -C "$dir" rev-parse origin/main 2>/dev/null)"; then
    # No remote or fetch failed — fall back to local HEAD (e.g. during dry-run
    # against a repo that has no origin configured).
    main_sha="$(git -C "$dir" rev-parse HEAD)" \
      || die "Could not resolve origin/main or HEAD in: $dir"
    log "[worktree] origin/main not available; using local HEAD as base"
  else
    # Fast-forward local main to origin/main so that `gt submit` doesn't abort
    # with "trunk branch is out of date". git update-ref is used instead of
    # `git branch -f` because `main` is typically checked out in the primary
    # clone and `git branch -f` refuses to move a checked-out branch.
    git -C "$dir" update-ref refs/heads/main "$main_sha"
    # Also update the working tree when main is checked out and clean.
    # Without this, update-ref fast-forwards the branch pointer but leaves the
    # working tree at the old commit, making it appear dirty relative to HEAD.
    local checked_out_branch
    checked_out_branch="$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null || true)"
    if [[ "$checked_out_branch" == 'main' ]] \
        && git -C "$dir" diff --quiet 2>/dev/null \
        && git -C "$dir" diff --cached --quiet 2>/dev/null; then
      if git -C "$dir" reset --hard "$main_sha" >/dev/null 2>&1; then
        log "[worktree] Fast-forwarded working tree at ${dir} to origin/main"
      else
        log "[worktree] Warning: could not fast-forward working tree at ${dir}"
      fi
    fi
  fi
  wt_base_branch="dep-updater-wt-${timestamp}-$$"
  git -C "$dir" worktree add -b "$wt_base_branch" "$worktree_path" "$main_sha" >&2
  readonly worktree_path
  log "[worktree] Worktree created: $worktree_path"

  # Install only the dependencies for the targeted ecosystem(s).
  # Gated on has_npm / py_tool (set by detect_ecosystem) to avoid running
  # a full pnpm install when the user passed --ecosystem python, for example.
  if [[ "$has_npm" == '1' ]]; then
    if [[ -f "$worktree_path/pnpm-lock.yaml" ]]; then
      log "[worktree] Installing dependencies (pnpm)…"
      (cd "$worktree_path" && pnpm install --prefer-offline --frozen-lockfile) >&2
    elif [[ -f "$worktree_path/package-lock.json" ]]; then
      log "[worktree] Installing dependencies (npm)…"
      (cd "$worktree_path" && npm ci --prefer-offline --no-audit --no-fund) >&2
    elif [[ -f "$worktree_path/yarn.lock" ]]; then
      log "[worktree] Installing dependencies (yarn)…"
      (cd "$worktree_path" && yarn install --frozen-lockfile) >&2
    fi
  fi
  if [[ -n "$py_tool" ]]; then
    case "$py_tool" in
      uv)
        if [[ -f "$worktree_path/uv.lock" || -f "$worktree_path/requirements.txt" ]]; then
          log "[worktree] Installing dependencies (uv)…"
          if [[ ! -d "$worktree_path/.venv" ]]; then
            (cd "$worktree_path" && uv venv) >&2
          fi
          if [[ -f "$worktree_path/uv.lock" ]]; then
            (cd "$worktree_path" && uv sync --frozen) >&2
          else
            (cd "$worktree_path" && uv pip install -r requirements.txt) >&2
          fi
        fi
        ;;
      poetry)
        [[ -f "$worktree_path/poetry.lock" ]] \
          && log "[worktree] Installing dependencies (poetry)…" \
          && (cd "$worktree_path" && poetry install --no-root) >&2
        ;;
      pipenv)
        [[ -f "$worktree_path/Pipfile.lock" ]] \
          && log "[worktree] Installing dependencies (pipenv)…" \
          && (cd "$worktree_path" && pipenv install) >&2
        ;;
      *)
        : # pip/pip3: no lockfile install needed; packages resolved per-update
        ;;
    esac
  fi
  log "[worktree] Ready: $worktree_path"
}

# ---------------------------------------------------------------------------
# Worktree reset helper — delete a broken worktree and start fresh
# ---------------------------------------------------------------------------

offer_worktree_reset() {
  local current_branch
  current_branch="$(git -C "$worktree_path" branch --show-current 2>/dev/null || echo '(detached)')"

  local branches_csv
  branches_csv="$(state_get "branches")"

  log "Worktree is unusable: branch '${current_branch}' is not tracked by Graphite."
  log "  Worktree: ${worktree_path}"
  if [[ -n "$branches_csv" ]]; then
    log "  Note: existing stack branches will NOT be deleted ($(csv_pretty "$branches_csv"))."
    log "  To clean up those PRs and branches later, run: $0 --cleanup --dir ${dir}"
  fi

  if ! prompt_yes_no "Delete this worktree and start fresh?" "y"; then
    die "Cannot proceed with unusable worktree. To clean up manually, run: $0 --cleanup --dir ${dir}"
  fi

  # Remove the broken worktree
  log "[worktree] Removing worktree: $worktree_path"
  git -C "$dir" worktree remove --force "$worktree_path" 2>/dev/null \
    || log "Note: worktree directory already removed."

  # Delete the throwaway wt_base_branch (it has no PRs stacked on it)
  local wt_branch
  wt_branch="$(state_get "wt_branch")"
  if [[ -n "$wt_branch" ]]; then
    log "[worktree] Deleting branch: $wt_branch"
    git -C "$dir" branch -D "$wt_branch" 2>/dev/null \
      || log "Note: wt_branch '${wt_branch}' not found; skipping deletion."
  fi

  # Clear state so create_worktree starts from scratch
  rm -f "$state_file"
  log "Broken worktree deleted. Creating a new worktree…"

  # worktree_path is not yet readonly at this call site; reset before create_worktree assigns it.
  worktree_path=""
  create_worktree
  write_initial_state "$worktree_path"
}

prepare_worktree() {
  local existing_wt=""
  if [[ -f "$state_file" ]]; then
    existing_wt="$(state_get "worktree")"
    if [[ -n "$existing_wt" && -d "$existing_wt" ]]; then
      worktree_path="$existing_wt"
      log "Reusing dep-updater worktree: $worktree_path"

      # Restore the wt_base_branch from state (may be absent for worktrees
      # created before this field was introduced).
      wt_base_branch="$(state_get "wt_branch")"

      # If the worktree has a detached HEAD (legacy worktree or stale state),
      # create a named branch so gt can operate — it refuses detached HEAD.
      local wt_current_branch
      wt_current_branch="$(git -C "$worktree_path" branch --show-current)"
      if [[ -z "$wt_current_branch" ]]; then
        local wt_ts wt_pid
        wt_ts="$(date --utc +%Y%m%dT%H%M%S)"
        wt_pid="$$"
        wt_base_branch="dep-updater-wt-${wt_ts}-${wt_pid}"
        git -C "$worktree_path" checkout -b "$wt_base_branch"
        state_set "wt_branch" "$wt_base_branch"
        log "Attached detached HEAD to new branch: $wt_base_branch"
        # Register the new branch with Graphite so gt create can stack on top of it.
        # Use --force so Graphite auto-detects the trunk parent without us hardcoding 'main'.
        run_in_worktree gt track --force \
          || log "Warning: could not track '${wt_base_branch}' with Graphite."
      fi

      # Sanity check: verify Graphite can operate on the current branch.
      # If not (e.g. gt track failed or state is corrupted), offer to delete
      # this worktree and start fresh.
      if ! run_in_worktree gt branch info &>/dev/null 2>&1; then
        offer_worktree_reset
        # offer_worktree_reset either dies or recreates the worktree via
        # create_worktree, which marks worktree_path readonly.
        return 0
      fi

      readonly worktree_path

      # Fetch latest main in case upstream has moved
      git -C "$worktree_path" fetch origin main >/dev/null 2>&1 \
        || log "Note: could not fetch latest main; stack may be behind."
      
      # Check if stack needs rebase using Graphite's status
      if stack_needs_rebase; then
        log_stack_rebase_context
        if prompt_yes_no "Rebase stack on main now?" "y"; then
          log "Rebasing stack..."
          rebase_stack_on_main
        else
          log "Skipped rebase. Stack will use current base."
        fi
      fi
      
      return 0
    fi
    log "State file exists but worktree is missing; starting a new dep-updater worktree."
  fi

  create_worktree
  write_initial_state "$worktree_path"
}

ensure_gt_tracked() {
  local current_branch
  current_branch="$(git -C "$worktree_path" branch --show-current)"
  # On main — always known to Graphite; nothing to track.
  if [[ "$current_branch" == 'main' ]]; then
    return 0
  fi
  # For any other branch (including the throwaway wt_base_branch) — ensure
  # Graphite tracks it so gt create can stack child branches on top of it.
  # Use --force so Graphite auto-detects the trunk parent.
  if ! run_in_worktree gt branch info &>/dev/null 2>&1; then
    run_in_worktree gt track --force \
      || die "Could not register '${current_branch}' with Graphite. Cannot create stack.\n  Try manually: (cd ${worktree_path} && gt track --parent main)"
  fi
}

branch_exists_in_worktree() {
  local -r branch="$1"
  git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${branch}"
}

register_existing_branch_state() {
  local -r branch="$1"

  local branches_csv prs_csv
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"

  if ! csv_contains "$branches_csv" "$branch"; then
    state_append "branches" "$branch"
  fi

  local pr_num
  pr_num="$(gh_pr_number_for_branch "$branch")"
  if [[ -n "$pr_num" ]] && ! csv_contains "$prs_csv" "$pr_num"; then
    state_append_pr "$pr_num"
  fi
}

# ---------------------------------------------------------------------------
# npm helpers
# ---------------------------------------------------------------------------

# Prints one "name current latest" line per outdated package.
npm_outdated() {
  local -r tool="$npm_tool"

  if [[ ! -d "$dir/node_modules" ]]; then
    log "node_modules not found at git root — running install…"
    case "$tool" in
      pnpm) pnpm --dir "$dir" install --frozen-lockfile >&2 ;;
      yarn) yarn --cwd "$dir" install --frozen-lockfile >&2 ;;
      npm)  npm install --prefix "$dir" --prefer-offline >&2 ;;
    esac
  fi

  local tmp_json exit_code
  tmp_json="$(mktemp)"
  set +e
  case "$tool" in
    pnpm) pnpm --dir "$dir" outdated --json > "$tmp_json" 2>/dev/null ;;
    yarn) yarn --cwd "$dir" outdated --json > "$tmp_json" 2>/dev/null ;;
    npm)  npm outdated --prefix "$dir" --json > "$tmp_json" 2>/dev/null ;;
  esac
  exit_code=$?
  set -e

  # Both pnpm and npm outdated exit 1 when outdated packages are found; >1 is an error.
  if (( exit_code > 1 )); then
    rm -f "$tmp_json"
    die "'${tool} outdated' exited with unexpected code ${exit_code}"
  fi

  if [[ ! -s "$tmp_json" ]] || grep -qE '^\s*\{\s*\}\s*$' "$tmp_json" || grep -qE '^\s*null\s*$' "$tmp_json"; then
    rm -f "$tmp_json"
    return 0
  fi

  # Read direct-dependency specifiers from package.json for local/git reference checks.
  # Local/git references (workspace:, file:, link:, git) are excluded from the update
  # list regardless of what `outdated` reports.  Exact-pinned packages (e.g. "3.0.0",
  # "=3.0.0") are NOT excluded: dep-updater updates them in place, preserving the exact
  # style (no promotion to ^), matching Dependabot behaviour.
  local pkg_json_specs
  if [[ -f "$dir/package.json" ]]; then
    pkg_json_specs="$(jq -c \
      '[.dependencies, .devDependencies, .peerDependencies, .optionalDependencies]
       | map(select(. != null)) | add // {}' \
      "$dir/package.json" 2>/dev/null || echo '{}')"
  else
    pkg_json_specs='{}'
  fi

  if [[ "$tool" == 'yarn' ]]; then
    jq -r 'select(.type == "table")
      | .data.body[]
      | "\(.[0]) \(.[1]) \(.[3])"' "$tmp_json" 2>/dev/null \
      | awk '{if(NF==3 && $1!="" && $2!="" && $3!="") print $0}'
  else
    jq -r --argjson specs "$pkg_json_specs" --arg semver_only "$semver_only" '
      to_entries[]
      | select(
          .key | test("^(latest|wanted|isDeprecated|name|type|homepage|description|author|license|repository|bugs|engines|_.*)$") | not
        )
      | select(.value.current != null)
      # Skip packages whose specifier is a local/git reference; those are never
      # version-bumped.  Exact-pinned packages ("3.0.0", "=3.0.0") are kept:
      # dep-updater updates them in place (preserving the exact style), matching
      # Dependabot behaviour.  Packages absent from package.json (transitive deps)
      # are kept so they remain visible.
      | select(
          ($specs[.key] == null)
          or ($specs[.key] | test("^(workspace:|file:|link:|git)") | not)
        )
      # semver-only: only propose updates within the existing range (current → wanted).
      # Default: propose updates to the latest published version.
      | if $semver_only == "1" then
          select(.value.wanted != null and .value.current != .value.wanted)
          | "\(.key) \(.value.current) \(.value.wanted)"
        else
          select(.value.current != .value.latest)
          | "\(.key) \(.value.current) \(.value.latest)"
        end' "$tmp_json" 2>/dev/null \
      | awk '{if(NF==3 && $1!="" && $2!="" && $3!="") print $0}'
  fi
  rm -f "$tmp_json"
}

# Derives the grouping key for an npm package.
# Scoped packages (@scope/name) group by @scope.
# Unscoped 'pkg' groups with @pkg if any @pkg/* sibling exists in all_lines.
npm_group_key() {
  local -r pkg="$1"
  local -r all_lines="$2"
  if [[ "$pkg" == @*/* ]]; then
    printf '%s' "${pkg%%/*}"
  elif printf '%s\n' "$all_lines" | rg -q --fixed-strings "@${pkg}/"; then
    printf '%s' "@${pkg}"
  else
    printf '%s' "$pkg"
  fi
}

# Prints one group key per line, preserving first-seen order.
list_npm_group_keys() {
  local -r all_lines="$1"
  local keys=""

  while IFS=' ' read -r pkg _old _new; do
    [[ -z "$pkg" ]] && continue
    local key
    key="$(npm_group_key "$pkg" "$all_lines")"
    if ! printf '%s\n' "$keys" | rg -qx --fixed-strings "$key"; then
      if [[ -z "$keys" ]]; then
        keys="$key"
      else
        keys="${keys}
${key}"
      fi
    fi
  done <<< "$all_lines"

  printf '%s' "$keys"
}

# Prints one "pkg old_ver new_ver" line per package in group_key.
npm_entries_for_group() {
  local -r group_key="$1"
  local -r all_lines="$2"

  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    local key
    key="$(npm_group_key "$pkg" "$all_lines")"
    if [[ "$key" == "$group_key" ]]; then
      printf '%s %s %s\n' "$pkg" "$old_ver" "$new_ver"
    fi
  done <<< "$all_lines"
}

# entries: newline-separated "pkg old_ver new_ver" for one group.
npm_update_group() {
  local -r group_key="$1"
  local -r entries="$2"
  local -r npm_audit_lines="${3:-}"  # optional: full audit lines to cross-reference CVEs

  local safe_key
  safe_key="$(sanitize_branch_name "${group_key#@}")"
  local -r branch="dep-updates/npm-${safe_key}"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing branch: ${branch}"
    register_existing_branch_state "$branch"
    # A previous run may have created the branch but died before submitting the PR
    # (e.g. killed by gh pr edit's non-zero exit). Submit it now if needed.
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      git -C "$worktree_path" checkout "$branch"
      run_in_worktree gt track -p main 2>/dev/null || true
      run_in_worktree gt submit --no-interactive --publish --no-stack
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then
        state_append_pr "$existing_pr"
      fi
    fi
    # Position worktree on this branch so the next update stacks on top of it.
    git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  local pkg_count=0 first_pkg="" first_old="" first_new=""
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    pkg_count=$(( pkg_count + 1 ))
    if [[ "$pkg_count" -eq 1 ]]; then
      first_pkg="$pkg"; first_old="$old_ver"; first_new="$new_ver"
    fi
  done <<< "$entries"

  local commit_msg
  if [[ "$pkg_count" -eq 1 ]]; then
    commit_msg="chore(deps): bump ${first_pkg} from ${first_old} to ${first_new}"
    log "[${npm_tool}] ${first_pkg}: ${first_old} -> ${first_new}"
  else
    commit_msg="chore(deps): bump ${group_key} from ${first_old} to ${first_new}"
    log "[${npm_tool}] ${group_key} (${pkg_count} packages): ${first_old} -> ${first_new}"
  fi

  # Restore manifest + lockfile to HEAD so a previous failed run cannot leave
  # them in a half-updated state that causes peer-dependency conflicts.
  # Restore each file independently: if the lockfile is not committed (common
  # for npm projects that .gitignore package-lock.json), a combined checkout
  # would fail silently via || true and leave package.json unrestored.
  local lockfile
  case "$npm_tool" in
    pnpm) lockfile="pnpm-lock.yaml" ;;
    yarn) lockfile="yarn.lock" ;;
    npm)  lockfile="package-lock.json" ;;
  esac
  git -C "$worktree_path" checkout -- package.json 2>/dev/null || true
  if [[ "$npm_tool" == 'npm' ]]; then
    # For npm, delete the lockfile rather than restoring it.  The committed
    # lockfile pins old versions; restoring it causes npm to read those pins
    # and conflict them against the newly-patched package.json versions.
    # With no lockfile, npm builds a fresh resolution tree from package.json.
    rm -f "${worktree_path}/package-lock.json"
  else
    git -C "$worktree_path" checkout -- "$lockfile" 2>/dev/null || true
  fi

  # Remove any stale node_modules left by a previous failed npm run.
  if [[ "$npm_tool" == 'npm' && -d "${worktree_path}/node_modules" ]]; then
    log "[${npm_tool}] Removing stale node_modules in worktree before update…"
    rm -rf "${worktree_path}/node_modules"
  fi

  # For pnpm/yarn (semver-only) and yarn (latest): pass package names to the
  # update command.  For npm and pnpm (latest): patch package.json via jq and
  # run install — avoids specifier/lockfile mismatches caused by `update --latest`.
  local -a pkg_args=()
  if [[ "$npm_tool" != 'npm' ]]; then
    while IFS=' ' read -r pkg _old _new; do
      [[ -z "$pkg" ]] && continue
      pkg_args+=("$pkg")
    done <<< "$entries"
  fi

  case "$npm_tool" in
    pnpm)
      if [[ "$semver_only" == '1' ]]; then
        # semver-only: stay within the existing range; pnpm resolves the latest
        # version within that range without touching package.json specifiers.
        pnpm --dir "$worktree_path" update "${pkg_args[@]}"
      else
        # pnpm update --latest writes exact versions (e.g. 8.58.2) to
        # package.json but leaves pnpm-lock.yaml specifiers at the old range
        # (e.g. ^8.58.1), causing a "specifiers don't match" error in CI.
        # Instead, patch package.json directly (same strategy as npm) then
        # let pnpm install regenerate the lockfile from the updated manifest.
        local updates_json
        updates_json='{}'
        while IFS=' ' read -r pkg _old new_ver; do
          [[ -z "$pkg" ]] && continue
          updates_json="$(printf '%s' "$updates_json" \
            | jq --arg k "$pkg" --arg v "$new_ver" '. + {($k): $v}')"
        done <<< "$entries"

        local tmp_pkg
        tmp_pkg="$(mktemp)"
        if ! jq --argjson updates "$updates_json" '
          to_entries | map(
            if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
               and (.value != null) then
              .value |= with_entries(
                (.key) as $k |
                if $updates | has($k) then
                  # Find the semver range prefix (e.g. ^, ~, >=) by locating
                  # the first ASCII digit (48="0" .. 57="9") in the value.
                  (.value | explode | map(. >= 48 and . <= 57) | index(true) // 0) as $di |
                  (.value[0:$di]) as $prefix |
                  .value = ($prefix + $updates[$k])
                else . end
              )
            else . end
          ) | from_entries
        ' "${worktree_path}/package.json" > "$tmp_pkg"; then
          rm -f "$tmp_pkg"
          die "jq failed to update package.json versions."
        fi
        mv "$tmp_pkg" "${worktree_path}/package.json"

        # --no-frozen-lockfile lets pnpm rebuild pnpm-lock.yaml from the
        # freshly patched package.json so specifiers are consistent.
        pnpm --dir "$worktree_path" install --no-frozen-lockfile
      fi
      ;;
    yarn)
      yarn --cwd "$worktree_path" upgrade "${pkg_args[@]}" --latest
      ;;
    npm)
      # Patch exact target versions into package.json using jq, then do a
      # clean install.  npm install pkg@v rewrites package.json and builds an
      # ideal tree that first resolves the old semver range as the baseline,
      # causing ERESOLVE when interdependent grouped packages are updated.
      local updates_json
      updates_json='{}'
      while IFS=' ' read -r pkg _old new_ver; do
        [[ -z "$pkg" ]] && continue
        updates_json="$(printf '%s' "$updates_json" \
          | jq --arg k "$pkg" --arg v "$new_ver" '. + {($k): $v}')"
      done <<< "$entries"

      local tmp_pkg
      tmp_pkg="$(mktemp)"
      if ! jq --argjson updates "$updates_json" '
        to_entries | map(
          if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
             and (.value != null) then
            .value |= with_entries(
              (.key) as $k |
              if $updates | has($k) then
                # Find the semver range prefix (e.g. ^, ~, >=) by locating
                # the first ASCII digit (48="0" .. 57="9") in the value.
                (.value | explode | map(. >= 48 and . <= 57) | index(true) // 0) as $di |
                (.value[0:$di]) as $prefix |
                .value = ($prefix + $updates[$k])
              else . end
            )
          else . end
        ) | from_entries
      ' "${worktree_path}/package.json" > "$tmp_pkg"; then
        rm -f "$tmp_pkg"
        die "jq failed to update package.json versions."
      fi
      mv "$tmp_pkg" "${worktree_path}/package.json"

      npm install --prefix "$worktree_path"
      ;;
  esac

  git -C "$worktree_path" add package.json
  # Only stage the lockfile if the project tracks it (not gitignored).
  if ! git -C "$worktree_path" check-ignore -q "$lockfile" 2>/dev/null; then
    git -C "$worktree_path" add "$lockfile" 2>/dev/null || true
  fi

  # If the update made no changes, there is nothing to commit.
  # Bail out to avoid creating an empty branch that gt submit will reject.
  if git -C "$worktree_path" diff --cached --quiet; then
    log "[${npm_tool}] ${group_key}: no file changes after update — already at latest. Skipping PR."
    return 0
  fi

  # Record the current branch so we know whether to reparent in Graphite.
  local parent_branch
  parent_branch="$(git -C "$worktree_path" branch --show-current)"

  # Create branch and commit with git directly so commit.gpgsign/user.signingkey
  # from the global git config are respected. gt create -m bypasses GPG signing.
  git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  # Tell Graphite about the branch parentage.
  if [[ "$parent_branch" == "$wt_base_branch" ]]; then
    run_in_worktree gt track -p main
  else
    run_in_worktree gt track -p "$parent_branch"
  fi
  log "[gate] Submitting PR for '${branch}'…"
  run_in_worktree gt submit --no-interactive --publish --no-stack

  # Stay on $branch — the next dep-updater branch will stack on top of it.

  local pr_num
  pr_num="$(gh_pr_number_for_new_branch "$branch")"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  local npm_body_file
  npm_body_file="$(mktemp)"
  write_npm_pr_body "$group_key" "$safe_key" "$entries" "$npm_audit_lines" "$npm_body_file"
  # gh pr edit exits 1 due to a non-actionable GitHub GraphQL deprecation warning;
  # the PR title and body are cosmetic — the PR itself was already created above.
  gh pr edit "$pr_num" \
    --title "$commit_msg" \
    --body-file "$npm_body_file" \
    --add-label "dep-updater" || true
  rm -f "$npm_body_file"
  # my-tracks uses Graphite's multi-partition merge queue: merge-mq enqueues the PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh pr edit "$pr_num" --add-label "merge-mq" 2>/dev/null || true
  fi

  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "npm" "$group_key" "$first_old" "$first_new" "$branch" "$pr_num"
}

write_npm_pr_body() {
  local -r group_key="$1"
  local -r safe_key="$2"
  local -r entries="$3"
  local -r npm_audit_lines="${4:-}"  # optional: full audit lines to cross-reference CVEs
  local -r body_file="$5"           # caller-provided path (use mktemp)

  {
    printf '%s\n\n' '## Stack Context'
    printf "Automated dependency updates via \`dep-updater\`.\n"
    printf '%s\n\n' 'Each PR bumps exactly one dependency group. Merge the full stack to update all.'
    printf '%s\n\n' '## Updates'
    printf '| Package | From | To |\n'
    printf '|---|---|---|\n'
    while IFS=' ' read -r entry_pkg entry_old entry_new; do
      [[ -z "$entry_pkg" ]] && continue
      printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$entry_pkg" "$entry_old" "$entry_new"
    done <<< "$entries"
    printf '\n- **Ecosystem:** npm (%s)\n' "$npm_tool"
    # Render CVE table for any packages in this group that have known vulnerabilities.
    if [[ -n "$npm_audit_lines" ]]; then
      local cve_section=""
      while IFS=' ' read -r entry_pkg _entry_old _entry_new; do
        [[ -z "$entry_pkg" ]] && continue
        local matched_cves=""
        while IFS=' ' read -r ap _ac _af cves; do
          [[ -z "$ap" ]] && continue
          if [[ "${ap,,}" == "${entry_pkg,,}" && -n "$cves" ]]; then
            matched_cves="$cves"
            break
          fi
        done <<< "$npm_audit_lines"
        if [[ -n "$matched_cves" ]]; then
          local cve
          for cve in ${matched_cves//,/ }; do
            cve_section="${cve_section}| \`${entry_pkg}\` | ${cve} |"$'\n'
          done
        fi
      done <<< "$entries"
      if [[ -n "$cve_section" ]]; then
        printf '\n## CVEs addressed\n\n'
        printf '| Package | CVE |\n'
        printf '|---|---|\n'
        printf '%s' "$cve_section"
      fi
    fi
  } > "$body_file"
}

# ---------------------------------------------------------------------------
# Security audit helpers
# ---------------------------------------------------------------------------

# Emits one "pkg current fix_version cve1,cve2,..." line per vulnerable Python
# package that has a known fix version available. Packages with no fix are
# silently skipped (nothing we can do in a dep-updater PR).

# py_audit(tool, dir): run pip-audit in the specified directory
py_audit() {
  local -r tool="$1"
  local audit_dir="${2:-$dir}"
  local raw exit_code

  set +e
  case "$tool" in
    uv)
      # --frozen prevents uv from syncing the project environment (which can
      # write uv.lock) before running pip-audit.  The audit is read-only: we
      # only need to inspect already-installed packages, not update them.
      raw="$(cd "$audit_dir" && uv run --frozen --with pip-audit pip-audit --format=json 2>/dev/null)"
      exit_code=$?
      ;;
    *)
      if ! command -v pip-audit &>/dev/null; then
        return 0  # pip-audit not installed — skip audit silently
      fi
      raw="$(cd "$audit_dir" && pip-audit --format=json 2>/dev/null)"
      exit_code=$?
      ;;
  esac
  set -e

  [[ -z "$raw" || "$raw" == 'null' ]] && return 0
  if ! printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then return 0; fi

  printf '%s' "$raw" | jq -r '
    .dependencies[]
    | select(.vulns | length > 0)
    | . as $dep
    | .vulns
      | map(select(.fix_versions | length > 0))
      | select(length > 0)
      | {
          name: $dep.name,
          version: $dep.version,
          fix: (map(.fix_versions[]) | sort | last),
          cves: (map(.id) | join(", "))
        }
    | "\(.name) \(.version) \(.fix) \(.cves)"
  ' 2>/dev/null || true
}

# Emits one "pkg current fix_version cve1,cve2,..." line per vulnerable npm
# package where a direct-dep fix is available. Transitive-only vulns are
# skipped (package.json cannot address them without introducing breaking changes).
npm_audit() {
  local raw exit_code

  set +e
  case "$npm_tool" in
    pnpm) raw="$(pnpm --dir "$dir" audit --json 2>/dev/null)" ;;
    yarn) raw="$(yarn --cwd "$dir" audit --json 2>/dev/null)" ;;
    npm)  raw="$(npm audit --prefix "$dir" --json 2>/dev/null)" ;;
  esac
  exit_code=$?
  set -e

  [[ -z "$raw" || "$raw" == '{}' || "$raw" == 'null' ]] && return 0
  if ! printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then return 0; fi

  # npm/pnpm JSON: .vulnerabilities.<name>.{ isDirect, fixAvailable: bool | {name,version} }
  # yarn emits newline-delimited JSON events; filter to advisories.
  if [[ "$npm_tool" == 'yarn' ]]; then
    # yarn audit --json emits one JSON object per line; skip non-advisory lines.
    printf '%s' "$raw" | jq -r '
      select(.type == "auditAdvisory")
      | .data.advisory
      | select(.findings | any(.paths[]; . == "." or (test("^[^/]+$"))))
      | select(.patched_versions != "<0.0.0")
      | "\(.module_name) \(.findings[0].version) \(.patched_versions | ltrimstr(">=") | ltrimstr(">") | split(" ")[0]) \(.cves | if length > 0 then join(", ") else .id end)"
    ' 2>/dev/null | sort -u || true
  else
    # npm and pnpm share the same audit JSON format.
    printf '%s' "$raw" | jq -r '
      .vulnerabilities
      | to_entries[]
      | select(.value.isDirect == true)
      | select(.value.fixAvailable | type == "object")
      | {
          name: .key,
          current: (.value.via | map(select(type == "object")) | .[0].range // "unknown"),
          fix: .value.fixAvailable.version,
          cves: (.value.via
            | map(select(type == "object") | .url | split("/") | last)
            | map(select(startswith("GHSA-") or (test("CVE-"))))
            | unique | join(", "))
        }
      | "\(.name) \(.current) \(.fix) \(.cves)"
    ' 2>/dev/null || true
  fi
}

# Write the PR body for a combined security update PR.
# Args: ecosystem  audit_lines  body_file
write_security_pr_body() {
  local -r eco="$1"
  local -r audit_lines="$2"
  local -r body_file="$3"
  {
    printf '## Security: CVE fixes\n\n'
    printf "Automated security updates via \`dep-updater\`.\n\n"
    printf 'Patching all packages with known vulnerabilities that have a fix available.\n\n'
    printf '## Vulnerabilities addressed\n\n'
    printf '| Package | Current | Fixed | CVEs |\n'
    printf '|---|---|---|---|\n'
    while IFS=' ' read -r pkg current fix cves; do
      [[ -z "$pkg" ]] && continue
      printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" \
        "$pkg" "$current" "$fix" "${cves/,/, }"
    done <<< "$audit_lines"
    printf '\n- **Ecosystem:** %s\n' "$eco"
  } > "$body_file"
}

# Creates exactly ONE PR that bumps all npm packages with CVE fixes.
npm_security_update() {
  local -r audit_lines="$1"
  [[ -z "$audit_lines" ]] && return 0

  local -r branch="dep-updates/npm-security"
  local body_file
  body_file="$(mktemp)"

  local pkg_list=""
  while IFS=' ' read -r pkg _current _fix _cves; do
    [[ -z "$pkg" ]] && continue
    pkg_list="${pkg_list} ${pkg}"
  done <<< "$audit_lines"
  pkg_list="${pkg_list# }"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing security branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      git -C "$worktree_path" checkout "$branch"
      run_in_worktree gt track -p main 2>/dev/null || true
      run_in_worktree gt submit --no-interactive --publish --no-stack
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then state_append_pr "$existing_pr"; fi
    fi
    git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[${npm_tool}] Security: patching CVE vulnerabilities in ${pkg_list}…"

  # Restore manifest + lockfile to a clean state.
  local lockfile
  case "$npm_tool" in
    pnpm) lockfile="pnpm-lock.yaml" ;;
    yarn) lockfile="yarn.lock" ;;
    npm)  lockfile="package-lock.json" ;;
  esac
  git -C "$worktree_path" checkout -- package.json 2>/dev/null || true
  git -C "$worktree_path" checkout -- "$lockfile" 2>/dev/null || true

  # Apply audit fixes. npm/pnpm patch manifests + lockfiles in one step.
  case "$npm_tool" in
    pnpm)
      pnpm --dir "$worktree_path" audit --fix 2>/dev/null \
        || pnpm --dir "$worktree_path" install --no-frozen-lockfile
      ;;
    yarn)
      # yarn has no native audit --fix; upgrade the vulnerable packages directly.
      local -a yarn_args=()
      while IFS=' ' read -r pkg _current fix _cves; do
        [[ -z "$pkg" ]] && continue
        yarn_args+=("${pkg}@${fix}")
      done <<< "$audit_lines"
      yarn --cwd "$worktree_path" upgrade "${yarn_args[@]}"
      ;;
    npm)
      npm audit fix --prefix "$worktree_path" 2>/dev/null || true
      ;;
  esac

  git -C "$worktree_path" add package.json
  # Only stage the lockfile if the project tracks it (not gitignored).
  if ! git -C "$worktree_path" check-ignore -q "$lockfile" 2>/dev/null; then
    git -C "$worktree_path" add "$lockfile" 2>/dev/null || true
  fi

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[${npm_tool}] Security: no file changes after audit fix — already patched or indirect only. Skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(git -C "$worktree_path" branch --show-current)"

  local commit_msg="fix(deps): patch CVE vulnerabilities in npm dependencies"
  git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"

  if [[ "$parent_branch" == "$wt_base_branch" ]]; then
    run_in_worktree gt track -p main
  else
    run_in_worktree gt track -p "$parent_branch"
  fi
  log "[gate] Submitting security PR for '${branch}'…"
  run_in_worktree gt submit --no-interactive --publish --no-stack

  local submitted_head
  submitted_head="$(git -C "$worktree_path" rev-parse "$branch")"

  local pr_num
  pr_num="$(gh_pr_number_for_new_branch "$branch")"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  write_security_pr_body "${npm_tool}" "$audit_lines" "$body_file"
  gh pr edit "$pr_num" \
    --title "$commit_msg" \
    --body-file "$body_file" \
    --add-label "dep-updater" \
    --add-label "security" || true
  rm -f "$body_file"
  # my-tracks uses Graphite's multi-partition merge queue: merge-mq enqueues the PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh pr edit "$pr_num" --add-label "merge-mq" 2>/dev/null || true
  fi

  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "npm" "npm-security (CVEs)" "-" "-" "$branch" "$pr_num"

  if [[ "$no_wait_ci" == '0' ]]; then
    log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
    wait_for_mergeable_quick "$pr_num"
    log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
    wait_for_ci "$branch" "$submitted_head" "$pr_num"
    if [[ "$(gh_pr_merged_for_number "$pr_num")" != 'true' ]]; then
      log "[gate] CI passed. Final merge conflict check…"
      wait_for_mergeable "$pr_num"
      log "[gate] PR #${pr_num} is mergeable. Proceeding to next update."
    fi
  fi
}

# Creates exactly ONE PR that bumps all Python packages with CVE fixes.
py_security_update() {
  local -r audit_lines="$1"
  local -r tool="$2"
  [[ -z "$audit_lines" ]] && return 0

  local -r branch="dep-updates/py-security"
  local body_file
  body_file="$(mktemp)"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing Python security branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      git -C "$worktree_path" checkout "$branch"
      run_in_worktree gt track -p main 2>/dev/null || true
      run_in_worktree gt submit --no-interactive --publish --no-stack
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then state_append_pr "$existing_pr"; fi
    fi
    git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[python/${tool}] Security: patching CVE vulnerabilities…"

  local files_changed=""
  while IFS=' ' read -r pkg _current fix _cves; do
    [[ -z "$pkg" ]] && continue
    log "[python/${tool}] Security: bumping ${pkg} to ${fix}…"
    case "$tool" in
      uv)
        uv --directory "$worktree_path" add "${pkg}==${fix}"
        files_changed="pyproject.toml + uv.lock"
        ;;
      poetry)
        run_in_worktree poetry add "${pkg}@${fix}"
        files_changed="pyproject.toml + poetry.lock"
        ;;
      pipenv)
        run_in_worktree pipenv install "${pkg}==${fix}"
        files_changed="Pipfile + Pipfile.lock"
        ;;
      pip|pip3)
        "$tool" install "${pkg}==${fix}"
        "$tool" freeze > "${worktree_path}/requirements.txt"
        files_changed="requirements.txt"
        ;;
      *)
        die "Unknown Python tool: '$tool'"
        ;;
    esac
  done <<< "$audit_lines"

  case "$tool" in
    uv)      git -C "$worktree_path" add pyproject.toml uv.lock ;;
    poetry)  git -C "$worktree_path" add pyproject.toml poetry.lock ;;
    pipenv)  git -C "$worktree_path" add Pipfile Pipfile.lock ;;
    pip|pip3) git -C "$worktree_path" add requirements.txt ;;
  esac

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[python/${tool}] Security: no file changes after patching — already fixed. Skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(git -C "$worktree_path" branch --show-current)"

  local commit_msg="fix(deps): patch CVE vulnerabilities in Python dependencies"
  git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"

  if [[ "$parent_branch" == "$wt_base_branch" ]]; then
    run_in_worktree gt track -p main
  else
    run_in_worktree gt track -p "$parent_branch"
  fi
  log "[gate] Submitting Python security PR for '${branch}'…"
  run_in_worktree gt submit --no-interactive --publish --no-stack

  local submitted_head
  submitted_head="$(git -C "$worktree_path" rev-parse "$branch")"

  local pr_num
  pr_num="$(gh_pr_number_for_new_branch "$branch")"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  write_security_pr_body "python/${tool}" "$audit_lines" "$body_file"
  gh pr edit "$pr_num" \
    --title "$commit_msg" \
    --body-file "$body_file" \
    --add-label "dep-updater" \
    --add-label "security" || true
  rm -f "$body_file"
  # my-tracks uses Graphite's multi-partition merge queue: merge-mq enqueues the PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh pr edit "$pr_num" --add-label "merge-mq" 2>/dev/null || true
  fi

  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "python" "py-security (CVEs)" "-" "-" "$branch" "$pr_num"

  if [[ "$no_wait_ci" == '0' ]]; then
    log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
    wait_for_mergeable_quick "$pr_num"
    log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
    wait_for_ci "$branch" "$submitted_head" "$pr_num"
    if [[ "$(gh_pr_merged_for_number "$pr_num")" != 'true' ]]; then
      log "[gate] CI passed. Final merge conflict check…"
      wait_for_mergeable "$pr_num"
      log "[gate] PR #${pr_num} is mergeable. Proceeding to next update."
    fi
  fi
}

# ---------------------------------------------------------------------------
# Python helpers
# ---------------------------------------------------------------------------

# Prints one "name current latest" line per outdated package.
# Returns 0 if the package is exactly-pinned in the project's dependency files.
# Returns the constraint operator (>=, ==, ~=) used for a package in
# pyproject.toml.  Used by py_update_one to preserve the original operator
# when bumping a dependency (e.g. keep >= instead of collapsing to ==).
py_constraint_op() {
  local -r pkg="$1"
  local -r pyproject="${2:-${dir}/pyproject.toml}"
  local norm_hyp norm_und
  norm_hyp="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  norm_und="$(printf '%s' "$norm_hyp" | tr '-' '_')"
  # Find the first line in pyproject.toml that mentions the package and
  # extract the constraint operator that follows (>=, ==, ~=).
  grep -iE "\"(${norm_hyp}|${norm_und})(\[[^]]*\])?\s*(>=|==|~=)" "$pyproject" 2>/dev/null \
    | grep -oE '>=|==|~=' \
    | head -1 || true
}

# Invariant: dep-updater never introduces == pins; it only bumps >= floors.
# However, it respects existing pins for ecosystems where == signals an
# intentional user decision to lock a specific version:
#   pip/pip3/pipenv : requirements.txt — line matching `pkg==version`
#   poetry          : pyproject.toml [tool.poetry.dependencies] —
#                     `pkg = "version"` (bare = exact) or `pkg = "==version"`
#
# uv is intentionally excluded: == in pyproject.toml project.dependencies does
# not represent a deliberate freeze. dep-updater updates those packages and
# promotes the constraint to >= on bump (see py_update_one). The transitive
# constraint check (uv pip install --dry-run) still gates upgrades that would
# violate real transitive constraints.
py_is_pinned() {
  local -r pkg="$1"
  local -r tool="$2"

  # Normalize: lowercase; treat hyphens and underscores as equivalent (PEP 508)
  local norm_pkg us_pkg name_pat
  norm_pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  us_pkg="$(printf '%s' "$norm_pkg" | tr '-' '_')"
  name_pat="(${norm_pkg}|${us_pkg})"

  case "$tool" in
    pip|pip3|pipenv)
      local req_file
      for req_file in \
          "$dir/requirements.txt" \
          "$dir/requirements/base.txt" \
          "$dir/requirements/common.txt" \
          "$dir/requirements/main.txt"; do
        [[ -f "$req_file" ]] || continue
        if rg -qiP "^${name_pat}\s*==" "$req_file" 2>/dev/null; then
          return 0
        fi
      done
      ;;
    poetry)
      # [tool.poetry.dependencies]: `pkg = "2.0.0"` (bare version = exact in poetry)
      # or `pkg = "==2.0.0"` (explicit equality)
      if [[ -f "$dir/pyproject.toml" ]]; then
        if rg -qiP "^\s*${name_pat}\s*=\s*['\"](?:==)?\d" "$dir/pyproject.toml" 2>/dev/null; then
          return 0
        fi
      fi
      ;;
  esac
  return 1
}

py_outdated() {
  local -r tool="$1"
  local -r target_dir="${2:-$dir}"
  local raw_lines pyproject installed_json ge_dep ge_pkg ge_floor ge_installed ge_lower
  local installed_new
  installed_json=""
  installed_new=""
  case "$tool" in
    uv)
      raw_lines="$(cd "$target_dir" && uv pip list --outdated --format=json 2>/dev/null \
        | jq -r '.[] | "\(.name) \(.version) \(.latest_version)"')"
      ;;
    poetry)
      # poetry show --outdated has no stable JSON output; parse the table instead
      raw_lines="$(poetry --directory "$target_dir" show --outdated 2>/dev/null \
        | awk '/^[a-zA-Z]/ { print $1, $2, $3 }')"
      ;;
    pipenv)
      raw_lines="$(cd "$target_dir" && pipenv run pip list --outdated --format=json 2>/dev/null \
        | jq -r '.[] | "\(.name) \(.version) \(.latest_version)"')"
      ;;
    pip|pip3)
      raw_lines="$(cd "$target_dir" && "$tool" list --outdated --format=json 2>/dev/null \
        | jq -r '.[] | "\(.name) \(.version) \(.latest_version)"')"
      ;;
    *)
      die "Unknown Python tool: '$tool'"
      ;;
  esac

  # For uv projects: also detect stale >= constraint floors in pyproject.toml.
  # uv pip list --outdated only flags packages where installed < latest on PyPI;
  # it silently ignores the case where the declared floor is lower than the
  # installed version (e.g. "django>=6.0" installed at 6.0.4 — the floor should
  # be bumped to >=6.0.4 so the project always requires the patched minimum).
  if [[ "$tool" == "uv" ]]; then
    pyproject="${target_dir}/pyproject.toml"
    if [[ -f "$pyproject" ]]; then
      installed_json="$(cd "$target_dir" && uv pip list --format=json 2>/dev/null)"
      while IFS= read -r ge_dep; do
        [[ -z "$ge_dep" ]] && continue
        # Strip extras ([...]) then >= and version to get the package name.
        ge_pkg="$(printf '%s' "$ge_dep" \
          | sed 's/[[:space:]]*>=[[:space:]]*.*//' \
          | sed 's/\[.*//')"
        # Extract just the floor version, stopping at any trailing specifier.
        ge_floor="$(printf '%s' "$ge_dep" \
          | sed 's/.*>=[[:space:]]*//' \
          | sed 's/[,;[:space:]].*//')"
        [[ -z "$ge_floor" || -z "$ge_pkg" ]] && continue
        # Validate PEP 508 package name — drop any mangled strings.
        [[ "$ge_pkg" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        ge_installed="$(printf '%s' "$installed_json" \
          | jq -r --arg n "$ge_pkg" \
              '.[] | select(.name | ascii_downcase == ($n | ascii_downcase)) | .version')"
        # Skip if not installed or floor already matches installed.
        [[ -z "$ge_installed" || "$ge_floor" == "$ge_installed" ]] && continue
        # Use sort -V: if the smaller of the two is the floor, the floor is stale.
        ge_lower="$(printf '%s\n%s\n' "$ge_floor" "$ge_installed" | sort -V | head -1)"
        if [[ "$ge_lower" == "$ge_floor" ]]; then
          # Only add if not already present in raw_lines (e.g. from uv pip list).
          if ! printf '%s\n' "$raw_lines" | grep -qi "^${ge_pkg} "; then
            if [[ -n "$raw_lines" ]]; then
              raw_lines="${raw_lines}
${ge_pkg} ${ge_floor} ${ge_installed}"
            else
              raw_lines="${ge_pkg} ${ge_floor} ${ge_installed}"
            fi
          fi
        fi
      done < <(awk '
        BEGIN { in_direct = 0 }
        /^\[[[:space:]]*(project|project\.[^]]*)[[:space:]]*\]/ { in_direct = 1; next }
        /^\[/ { in_direct = 0; next }
        !in_direct { next }
        /constraint-dependencies/ { next }
        {
          s = $0
          while (1) {
            if (match(s, /"[A-Za-z0-9][A-Za-z0-9._-]*[^"=<>!~,]*>=[^"]*"/)) {
              print substr(s, RSTART+1, RLENGTH-2)
              s = substr(s, RSTART+RLENGTH)
            } else break
          }
        }
      ' "$pyproject" 2>/dev/null)
    fi
  fi

  while IFS=' ' read -r pkg cur new; do
    [[ -z "$pkg" ]] && continue
    # Validate PEP 508 package name — drop any mangled strings from raw_lines.
    [[ "$pkg" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
    if py_is_pinned "$pkg" "$tool"; then
      log "[python/${tool}] Skipping exactly-pinned package: ${pkg} (${cur})"
      continue
    fi
    # For uv projects, probe whether the upgrade is actually resolvable before
    # reporting it.  'uv pip list --outdated' reports PyPI availability only and
    # does not check transitive constraints from other installed packages (e.g.
    # amqtt pins typer==0.15.4 which requires click<8.2, so click 8.3.2 would
    # show up as "outdated" even though the upgrade is impossible).
    # Strategy: write all currently-installed packages at their current pinned
    # versions (substituting pkg -> new_ver) as a requirements list and pass it
    # to 'uv pip install --dry-run'.  The resolver sees typer==0.15.4 and knows
    # its Requires-Dist includes click<8.2, so it rejects click==8.3.2 with
    # exit 1.  Editable installs are excluded (local packages not on PyPI).
    # Skip the probe for >= floor bumps (new == already-installed version).
    if [[ "$tool" == "uv" && -n "$installed_json" ]]; then
      installed_new="$(printf '%s' "$installed_json" \
        | jq -r --arg n "$pkg" \
            '.[] | select(.name | ascii_downcase == ($n | ascii_downcase)) | .version' \
          2>/dev/null || true)"
      if [[ "$new" != "$installed_new" ]]; then
        if ! printf '%s' "$installed_json" \
            | jq -r --arg p "$pkg" --arg v "$new" \
                '.[] | select(has("editable_project_location") | not)
                     | if (.name | ascii_downcase) == ($p | ascii_downcase)
                       then "\(.name)==" + $v
                       else "\(.name)==\(.version)"
                       end' \
            | (cd "$target_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
          log "[python/uv] Filtering ${pkg} ${new}: transitive constraint blocks this upgrade."
          continue
        fi
      fi
    fi
    printf '%s %s %s\n' "$pkg" "$cur" "$new"
  done <<< "$raw_lines"
}

py_update_one() {
  local -r pkg="$1"
  local -r old_ver="$2"
  local -r new_ver="$3"
  local -r tool="$4"
  local -r py_audit_lines="${5:-}"  # optional: full audit lines to cross-reference CVEs
  local safe_name
  safe_name="$(sanitize_branch_name "$pkg")"
  local -r branch="dep-updates/py-${safe_name}"
  local -r commit_msg="chore(deps): bump ${pkg} from ${old_ver} to ${new_ver}"
  local files_changed=""

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing branch: ${branch}"
    register_existing_branch_state "$branch"
    # A previous run may have created the branch but died before submitting the PR.
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      git -C "$worktree_path" checkout "$branch"
      run_in_worktree gt track -p main 2>/dev/null || true
      run_in_worktree gt submit --no-interactive --publish --no-stack
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then
        state_append_pr "$existing_pr"
      fi
    fi
    # Position worktree on this branch so the next update stacks on top of it.
    git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[python/${tool}] ${pkg}: ${old_ver} → ${new_ver}"

  case "$tool" in
    uv)
      local uv_out uv_exit uv_constraint_op uv_spec sed_pkg
      uv_constraint_op="$(py_constraint_op "$pkg" "${dir}/pyproject.toml")"
      # Invariant: always write >= (never ==) — dep-updater must not re-pin.
      if [[ "$uv_constraint_op" == ">=" || "$uv_constraint_op" == "==" ]]; then
        # uv add pkg>=new_ver is a no-op when the lock already satisfies the
        # existing >= constraint (uv sees 8.0.1 already satisfies >=7.0.0 and
        # leaves pyproject.toml unchanged). Patch the floor with sed instead.
        # For == constraints, convert to >= so dep-updater never introduces pins.
        sed_pkg="$(printf '%s' "$pkg" | sed 's/[.]/\\./g')"
        sed -i -E \
          "s/(\"${sed_pkg}([^\"=<>!~,]|\\[[^]]+\\])*[[:space:]]*)(?:>=|==)[[:space:]]*[0-9][0-9a-zA-Z.]*/\\1>=${new_ver}/" \
          "${worktree_path}/pyproject.toml"
        uv_out="$(uv --directory "$worktree_path" lock 2>&1)" && uv_exit=0 || uv_exit=$?
      else
        uv_spec="${pkg}==${new_ver}"
        uv_out="$(uv --directory "$worktree_path" add "$uv_spec" 2>&1)" && uv_exit=0 || uv_exit=$?
      fi
      if (( uv_exit != 0 )); then
        # Revert pyproject.toml: sed already modified it for >= or == constraints
        # but the lock failed, so the change must not accumulate into a future commit.
        if [[ "$uv_constraint_op" == ">=" || "$uv_constraint_op" == "==" ]]; then
          git -C "$worktree_path" checkout -- pyproject.toml 2>/dev/null || true
        fi
        log "[python/uv] Skipping ${pkg} ${new_ver}: dependency resolution failed."
        log "$uv_out"
        return 0
      fi
      git -C "$worktree_path" add pyproject.toml uv.lock
      files_changed="pyproject.toml + uv.lock"
      ;;
    poetry)
      local poetry_out poetry_exit
      poetry_out="$(run_in_worktree poetry add "${pkg}@${new_ver}" 2>&1)" && poetry_exit=0 || poetry_exit=$?
      if (( poetry_exit != 0 )); then
        log "[python/poetry] Skipping ${pkg} ${new_ver}: dependency resolution failed."
        log "$poetry_out"
        return 0
      fi
      git -C "$worktree_path" add pyproject.toml poetry.lock
      files_changed="pyproject.toml + poetry.lock"
      ;;
    pipenv)
      run_in_worktree pipenv install "${pkg}==${new_ver}"
      git -C "$worktree_path" add Pipfile Pipfile.lock
      files_changed="Pipfile + Pipfile.lock"
      ;;
    pip|pip3)
      "$tool" install "${pkg}==${new_ver}"
      "$tool" freeze > "${worktree_path}/requirements.txt"
      git -C "$worktree_path" add requirements.txt
      files_changed="requirements.txt"
      ;;
    *)
      die "Unknown Python tool: '$tool'"
      ;;
  esac

  # If the update tool made no changes, there is nothing to commit.
  # Bail out to avoid creating an empty branch that gt submit will reject.
  if git -C "$worktree_path" diff --cached --quiet; then
    log "[python/${tool}] ${pkg}: no file changes after update — already at latest. Skipping PR."
    return 0
  fi

  # Record the current branch to determine whether reparenting is needed.
  local parent_branch
  parent_branch="$(git -C "$worktree_path" branch --show-current)"

  # Create branch and commit with git directly so commit.gpgsign/user.signingkey
  # from the global git config are respected. gt create -m bypasses GPG signing.
  git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  # Tell Graphite about the branch parentage.
  if [[ "$parent_branch" == "$wt_base_branch" ]]; then
    run_in_worktree gt track -p main
  else
    run_in_worktree gt track -p "$parent_branch"
  fi
  log "[gate] Submitting PR for '${branch}'…"
  run_in_worktree gt submit --no-interactive --publish --no-stack

  # Stay on $branch — the next dep-updater branch will stack on top of it.

  local pr_num
  pr_num="$(gh_pr_number_for_new_branch "$branch")"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  local py_body_file
  py_body_file="$(mktemp)"
  write_pr_body "$pkg" "$old_ver" "$new_ver" "python/${tool}" "$files_changed" \
    "$(printf '%s\n' "$py_audit_lines" \
       | grep -i "^${pkg} " || true)" \
    "$py_body_file"
  # gh pr edit exits 1 due to a non-actionable GitHub GraphQL deprecation warning;
  # the PR title and body are cosmetic — the PR itself was already created above.
  gh pr edit "$pr_num" \
    --title "$commit_msg" \
    --body-file "$py_body_file" \
    --add-label "dep-updater" || true
  rm -f "$py_body_file"
  # my-tracks uses Graphite's multi-partition merge queue: merge-mq enqueues the PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh pr edit "$pr_num" --add-label "merge-mq" 2>/dev/null || true
  fi

  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "python/${tool}" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num"
}

# ---------------------------------------------------------------------------
# Batch update — one branch + one PR for all changes
# ---------------------------------------------------------------------------

# Applies all npm + Python updates (security and/or regular) onto a single
# branch and creates a single PR.  Called instead of the per-group/per-package
# loops when --batch is set.
#
# Args:
#   $1  npm_audit_lines  (may be empty)
#   $2  py_audit_lines   (may be empty)
#   $3  npm_lines        (may be empty; ignored when security_only=1)
#   $4  py_lines         (may be empty; ignored when security_only=1)
batch_update_all() {
  local -r npm_audit_lines_arg="$1"
  local -r py_audit_lines_arg="$2"
  local -r npm_lines_arg="$3"
  local -r py_lines_arg="$4"

  # Use a timestamped branch name so each run gets a fresh Graphite identity.
  # A fixed name like 'dep-updates/batch' caused repeated submit failures: Graphite
  # persists the PR association and refuses to create a new PR for the same name
  # even after the old PR is closed, and no combination of 'gt sync' / 'gt branch
  # untrack' reliably clears this metadata without a checkout of the stale branch.
  local batch_ts
  batch_ts="$(date --utc +%Y%m%dT%H%M%S)"
  local -r branch="dep-updates/batch-${batch_ts}"
  local any_npm=0 any_py=0
  local py_out py_exit b_constraint_op b_spec actual_py_lines sed_pkg

  # If a previous batch branch from this same worktree session exists and its PR
  # is still open, reuse it rather than creating a duplicate.
  local existing_batch_branch=""
  local b
  while IFS= read -r b; do
    [[ "$b" == dep-updates/batch-* ]] || continue
    local bpr bstate bmerged
    bpr="$(gh_pr_number_for_branch "$b")"
    [[ -z "$bpr" ]] && continue
    bstate="$(gh_pr_state_for_number "$bpr")"
    bmerged="$(gh_pr_merged_for_number "$bpr")"
    if [[ "$bmerged" != 'true' && "$bstate" != 'closed' ]]; then
      existing_batch_branch="$b"
      break
    fi
  done < <({
    git -C "$worktree_path" branch --format='%(refname:short)' 2>/dev/null
    # Also include remote tracking refs so an interrupted run whose worktree was
    # cleaned up can still find a batch branch that was pushed to origin.
    git -C "$worktree_path" for-each-ref --format='%(refname:lstrip=3)' \
      'refs/remotes/origin/dep-updates/batch-*' 2>/dev/null
  } | sort -u)

  if [[ -n "$existing_batch_branch" ]]; then
    log "Reusing existing open batch branch: ${existing_batch_branch}"
    register_existing_branch_state "$existing_batch_branch"
    git -C "$worktree_path" checkout "$existing_batch_branch"
    return 0
  fi

  # ── npm ──────────────────────────────────────────────────────────────────
  # Capture the old package.json text so we can later diff against the
  # installed result to determine which packages actually changed.
  local old_pkg_json=""
  if [[ "$has_npm" == '1' ]]; then
    old_pkg_json="$(cat "${worktree_path}/package.json" 2>/dev/null || true)"
  fi

  if [[ "$has_npm" == '1' ]]; then
    local lockfile
    case "$npm_tool" in
      pnpm) lockfile="pnpm-lock.yaml" ;;
      yarn) lockfile="yarn.lock" ;;
      npm)  lockfile="package-lock.json" ;;
    esac

    git -C "$worktree_path" checkout -- package.json 2>/dev/null || true
    if [[ "$npm_tool" == 'npm' ]]; then
      rm -f "${worktree_path}/package-lock.json"
      if [[ -d "${worktree_path}/node_modules" ]]; then
        rm -rf "${worktree_path}/node_modules"
      fi
    else
      git -C "$worktree_path" checkout -- "$lockfile" 2>/dev/null || true
    fi

    if [[ "$npm_tool" == 'yarn' ]]; then
      # yarn has no patch-manifest path; build a combined upgrade arg list.
      local -a yarn_args=()
      if [[ -n "$npm_audit_lines_arg" ]]; then
        while IFS=' ' read -r pkg _current fix _cves; do
          [[ -z "$pkg" ]] && continue
          yarn_args+=("${pkg}@${fix}")
          log "[${npm_tool}] Security: ${pkg} → ${fix}"
        done <<< "$npm_audit_lines_arg"
        any_npm=1
      fi
      if [[ -n "$npm_lines_arg" && "$security_only" == '0' ]]; then
        while IFS=' ' read -r pkg _old new_ver; do
          [[ -z "$pkg" ]] && continue
          yarn_args+=("${pkg}@${new_ver}")
          log "[${npm_tool}] Update: ${pkg} → ${new_ver}"
        done <<< "$npm_lines_arg"
        any_npm=1
      fi
      if [[ "${#yarn_args[@]}" -gt 0 ]]; then
        yarn --cwd "$worktree_path" upgrade "${yarn_args[@]}"
      fi
    else
      # npm / pnpm: patch package.json once with all target versions, then install.
      local updates_json='{}'
      if [[ -n "$npm_audit_lines_arg" ]]; then
        while IFS=' ' read -r pkg _current fix _cves; do
          [[ -z "$pkg" ]] && continue
          updates_json="$(printf '%s' "$updates_json" \
            | jq --arg k "$pkg" --arg v "$fix" '. + {($k): $v}')"
          log "[${npm_tool}] Security: ${pkg} → ${fix}"
        done <<< "$npm_audit_lines_arg"
        any_npm=1
      fi
      if [[ -n "$npm_lines_arg" && "$security_only" == '0' ]]; then
        while IFS=' ' read -r pkg _old new_ver; do
          [[ -z "$pkg" ]] && continue
          updates_json="$(printf '%s' "$updates_json" \
            | jq --arg k "$pkg" --arg v "$new_ver" '. + {($k): $v}')"
          log "[${npm_tool}] Update: ${pkg} → ${new_ver}"
        done <<< "$npm_lines_arg"
        any_npm=1
      fi
      if [[ "$updates_json" != '{}' ]]; then
        local tmp_pkg
        tmp_pkg="$(mktemp)"
        if ! jq --argjson updates "$updates_json" '
          to_entries | map(
            if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
               and (.value != null) then
              .value |= with_entries(
                (.key) as $k |
                if $updates | has($k) then .value = $updates[$k] else . end
              )
            else . end
          ) | from_entries
        ' "${worktree_path}/package.json" > "$tmp_pkg"; then
          rm -f "$tmp_pkg"
          die "jq failed to update package.json versions."
        fi
        mv "$tmp_pkg" "${worktree_path}/package.json"
        case "$npm_tool" in
          pnpm) pnpm --dir "$worktree_path" install --no-frozen-lockfile ;;
          npm)  npm install --prefix "$worktree_path" ;;
        esac
      fi
    fi

    if [[ "$any_npm" == '1' ]]; then
      git -C "$worktree_path" add package.json
      if ! git -C "$worktree_path" check-ignore -q "$lockfile" 2>/dev/null; then
        git -C "$worktree_path" add "$lockfile" 2>/dev/null || true
      fi
    fi
  fi

  # ── Python ───────────────────────────────────────────────────────────────
  if [[ -n "$py_tool" ]]; then
    if [[ -n "$py_audit_lines_arg" ]]; then
      while IFS=' ' read -r pkg _current fix _cves; do
        [[ -z "$pkg" ]] && continue
        log "[python/${py_tool}] Security: ${pkg} → ${fix}"
        case "$py_tool" in
          uv)      uv --directory "$worktree_path" add "${pkg}==${fix}" ;;
          poetry)  run_in_worktree poetry add "${pkg}@${fix}" ;;
          pipenv)  run_in_worktree pipenv install "${pkg}==${fix}" ;;
          pip|pip3) "$py_tool" install "${pkg}==${fix}" ;;
        esac
      done <<< "$py_audit_lines_arg"
      any_py=1
    fi
    if [[ -n "$py_lines_arg" && "$security_only" == '0' ]]; then
      while IFS=' ' read -r pkg _old new_ver; do
        [[ -z "$pkg" ]] && continue
        log "[python/${py_tool}] Update: ${pkg} → ${new_ver}"
        case "$py_tool" in
          uv)
            b_constraint_op="$(py_constraint_op "$pkg" "${dir}/pyproject.toml")"
            if [[ "$b_constraint_op" == ">=" ]]; then
              # Direct floor bump: uv add pkg>=new_ver is a no-op when the lock
              # already satisfies the constraint. Patch pyproject.toml with sed.
              sed_pkg="$(printf '%s' "$pkg" | sed 's/[.]/\\./g')"
              sed -i -E \
                "s/(\"${sed_pkg}([^\"=<>!~,]|\\[[^]]+\\])*[[:space:]]*)>=[[:space:]]*[0-9][0-9a-zA-Z.]*/\\1>=${new_ver}/" \
                "${worktree_path}/pyproject.toml"
              py_out="$(uv --directory "$worktree_path" lock 2>&1)" && py_exit=0 || py_exit=$?
            else
              b_spec="${pkg}==${new_ver}"
              py_out="$(uv --directory "$worktree_path" add "$b_spec" 2>&1)" && py_exit=0 || py_exit=$?
            fi
            if (( py_exit != 0 )); then
              # Revert: sed patched pyproject.toml before the lock attempt for >=
              # constraints. Restore the file so failed bumps don't accumulate
              # and cause all subsequent packages to fail with phantom conflicts.
              if [[ "$b_constraint_op" == ">=" ]]; then
                git -C "$worktree_path" checkout -- pyproject.toml 2>/dev/null || true
              fi
              log "[python/uv] Skipping ${pkg} ${new_ver}: dependency resolution failed."
              log "$py_out"
              continue
            fi
            ;;
          poetry)
            py_out="$(run_in_worktree poetry add "${pkg}@${new_ver}" 2>&1)" && py_exit=0 || py_exit=$?
            if (( py_exit != 0 )); then
              log "[python/poetry] Skipping ${pkg} ${new_ver}: dependency resolution failed."
              log "$py_out"
              continue
            fi
            ;;
          pipenv)  run_in_worktree pipenv install "${pkg}==${new_ver}" ;;
          pip|pip3) "$py_tool" install "${pkg}==${new_ver}" ;;
        esac
      done <<< "$py_lines_arg"
      any_py=1
    fi
    if [[ "$any_py" == '1' ]]; then
      case "$py_tool" in
        uv)       git -C "$worktree_path" add pyproject.toml uv.lock ;;
        poetry)   git -C "$worktree_path" add pyproject.toml poetry.lock ;;
        pipenv)   git -C "$worktree_path" add Pipfile Pipfile.lock ;;
        pip|pip3)
          # pip freeze must be run from the project dir to produce correct output.
          "$py_tool" freeze > "${worktree_path}/requirements.txt"
          git -C "$worktree_path" add requirements.txt
          ;;
      esac
    fi

    # Compute actual_py_lines by parsing the staged pyproject.toml diff.
    # py_lines_arg comes from py_outdated and includes transitive packages that are
    # only updated in uv.lock — not direct constraint changes.  Diffing the staged
    # file gives the ground truth: only entries whose specifier was actually modified.
    actual_py_lines=""
    if [[ "$any_py" == '1' ]]; then
      actual_py_lines="$(
        {
          git -C "$worktree_path" diff --cached -- pyproject.toml 2>/dev/null || true
          printf '%s\n' '__LISTED__'
          printf '%s\n' "$py_lines_arg"
          printf '%s\n' "$py_audit_lines_arg"
        } | awk '
          /^__LISTED__$/ { in_listed = 1; next }
          in_listed {
            split($0, f, " ")
            if (f[1] == "") next
            p = tolower(f[1])
            fallback_old[p] = f[2]
            fallback_name[p] = f[1]
            next
          }
          /^---/ || /^[+][+][+]/ { next }
          {
            sign = substr($0, 1, 1)
            if (sign != "+" && sign != "-") next
            line = substr($0, 2)
            gsub(/^[[:space:]"]+/, "", line)
            gsub(/\\[[^]]*\\]/, "", line)
            op = ""
            i = index(line, ">=")
            if (i > 0) { op = ">="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) }
            if (op == "") { i = index(line, "=="); if (i > 0) { op = "=="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) } }
            if (op == "") { i = index(line, "~="); if (i > 0) { op = "~="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) } }
            if (op == "") next
            gsub(/[[:space:]]/, "", pkg)
            # Validate: package names only contain letters, digits, hyphens, underscores, dots.
            # Mangled names (e.g. constraint-dependencies=["pyyaml) are dropped.
            if (pkg !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) next
            gsub(/[",:[:space:]].*/, "", ver)
            if (pkg == "" || ver == "") next
            pk = tolower(pkg)
            if (sign == "-") { d_old[pk] = ver; d_old_name[pk] = pkg }
            else              { d_new[pk] = ver; d_new_name[pk] = pkg }
          }
          END {
            for (pk in d_new) {
              nv = d_new[pk]
              if (pk in d_old) {
                if (d_old[pk] == nv) continue
                ov = d_old[pk]
                nm = d_old_name[pk]
              } else if (pk in fallback_old) {
                ov = fallback_old[pk]
                nm = fallback_name[pk]
              } else { continue }
              print nm " " ov " " nv
            }
          }
        ' 2>/dev/null || true
      )"
    fi
  fi

  # Determine which npm packages actually changed after install.
  # pnpm outdated can report packages whose lockfile already resolves them to
  # the latest version (node_modules was stale).  Using the pre/post package.json
  # diff gives the ground truth: only packages whose specifier actually changed.
  local actual_npm_lines=""
  if [[ "$any_npm" == '1' && -n "$old_pkg_json" ]]; then
    actual_npm_lines="$(jq -r --argjson old "$old_pkg_json" '
        ([$old.dependencies, $old.devDependencies, $old.peerDependencies]
          | map(select(. != null)) | add // {}) as $old_deps |
        [.dependencies, .devDependencies, .peerDependencies]
          | map(select(. != null)) | add // {}
          | to_entries[]
          | select($old_deps[.key] != .value)
          | "\(.key) \($old_deps[.key] // "-") \(.value)"
      ' "${worktree_path}/package.json" 2>/dev/null || true)"
  fi

  if git -C "$worktree_path" diff --cached --quiet; then
    log "Batch: no file changes — all dependencies already up to date. Skipping PR."
    return 0
  fi

  local has_cves=0
  [[ -n "$npm_audit_lines_arg" || -n "$py_audit_lines_arg" ]] && has_cves=1

  local commit_msg
  if [[ "$security_only" == '1' ]]; then
    commit_msg="fix(deps): patch all CVE vulnerabilities"
  elif [[ "$has_cves" == '1' ]]; then
    commit_msg="fix(deps): batch updates including CVE fixes"
  else
    commit_msg="chore(deps): batch dependency updates"
  fi

  git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  run_in_worktree gt track -p main
  log "[gate] Submitting batch PR for '${branch}'…"
  run_in_worktree gt submit --no-interactive --publish --no-stack

  local pr_num
  pr_num="$(gh_pr_number_for_new_branch "$branch")"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for batch branch '${branch}'"

  # Build PR body
  local body_file
  body_file="$(mktemp)"
  {
    if [[ "$security_only" == '1' ]]; then
      printf '## Security: CVE fixes\n\n'
      printf "Automated security updates via \`dep-updater --batch --security-only\`.\n\n"
      printf 'Patching all packages with known vulnerabilities that have a fix available.\n\n'
    else
      printf '## Batch dependency updates\n\n'
      printf "Automated dependency updates via \`dep-updater --batch\`.\n\n"
      printf 'All outdated packages and CVE fixes combined into a single PR.\n\n'
    fi
    if [[ -n "$npm_audit_lines_arg" ]]; then
      printf '## npm CVEs addressed\n\n'
      printf '| Package | Current | Fixed | CVEs |\n'
      printf '|---|---|---|---|\n'
      while IFS=' ' read -r pkg current fix cves; do
        [[ -z "$pkg" ]] && continue
        printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" "$pkg" "$current" "$fix" "${cves/,/, }"
      done <<< "$npm_audit_lines_arg"
      printf '\n'
    fi
    if [[ -n "$py_audit_lines_arg" ]]; then
      printf '## Python CVEs addressed\n\n'
      printf '| Package | Current | Fixed | CVEs |\n'
      printf '|---|---|---|---|\n'
      while IFS=' ' read -r pkg current fix cves; do
        [[ -z "$pkg" ]] && continue
        printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" "$pkg" "$current" "$fix" "${cves/,/, }"
      done <<< "$py_audit_lines_arg"
      printf '\n'
    fi
    if [[ "$security_only" == '0' ]]; then
      if [[ -n "$actual_npm_lines" ]]; then
        printf '## npm updates\n\n'
        printf '| Package | From | To |\n'
        printf '|---|---|---|\n'
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$pkg" "$old_ver" "$new_ver"
        done <<< "$actual_npm_lines"
        printf '\n'
      fi
      if [[ -n "${actual_py_lines:-${py_lines_arg}}" ]]; then
        printf '## Python updates\n\n'
        printf '| Package | From | To |\n'
        printf '|---|---|---|\n'
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$pkg" "$old_ver" "$new_ver"
        done <<< "${actual_py_lines:-${py_lines_arg}}"
      fi
    fi
  } > "$body_file"

  if [[ "$has_cves" == '1' ]]; then
    gh pr edit "$pr_num" \
      --title "$commit_msg" \
      --body-file "$body_file" \
      --add-label "dep-updater" \
      --add-label "security" || true
  else
    gh pr edit "$pr_num" \
      --title "$commit_msg" \
      --body-file "$body_file" \
      --add-label "dep-updater" || true
  fi
  rm -f "$body_file"
  # my-tracks uses Graphite's multi-partition merge queue: merge-mq enqueues the PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    gh pr edit "$pr_num" --add-label "merge-mq" 2>/dev/null || true
  fi

  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "npm" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num"
  done <<< "${actual_npm_lines:-}"
  while IFS=' ' read -r pkg _current fix _cves; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "npm (CVE)" "$pkg" "$_current" "$fix" "$branch" "$pr_num"
  done <<< "${npm_audit_lines_arg:-}"
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "python/${py_tool}" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num"
  done <<< "${actual_py_lines:-${py_lines_arg:-}}"
  while IFS=' ' read -r pkg _current fix _cves; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "python/${py_tool} (CVE)" "$pkg" "$_current" "$fix" "$branch" "$pr_num"
  done <<< "${py_audit_lines_arg:-}"
  if [[ -z "$actual_npm_lines" && -z "$npm_audit_lines_arg" && \
        -z "${actual_py_lines:-${py_lines_arg:-}}" && -z "$py_audit_lines_arg" ]]; then
    add_summary_line "batch" "$branch" "-" "-" "$branch" "$pr_num"
  fi
}

# ---------------------------------------------------------------------------
# CI polling
# ---------------------------------------------------------------------------

wait_for_ci() {
  local -r branch="$1"
  local -r target_sha="${2:-}"
  local -r pr_num="${3:-}"
  local -r timeout_min=20
  local -r poll_sec=15
  local elapsed_sec=0
  local elapsed_fmt wait_suffix
  # Check for merge conflicts every 4 cycles (~2 min) while CI runs.
  local -r mergeable_check_interval=4
  local cycles_since_mergeable_check=0
  local status raw merge_state already_merged

  if [[ -n "$target_sha" ]]; then
    log "Waiting for CI on '${branch}' (head ${target_sha:0:8})…"
  else
    log "Waiting for CI on '${branch}'…"
  fi

  while true; do
    # Short-circuit: if the PR is already merged, CI obviously passed.
    if [[ -n "$pr_num" ]]; then
      already_merged="$(gh_pr_merged_for_number "$pr_num")"
      if [[ "$already_merged" == 'true' ]]; then
        log "PR #${pr_num} already merged — CI gate passed."
        return 0
      fi
    fi

    raw="$(gh run list --repo "${repo_owner}/${repo_name}" --branch "$branch" --limit 30 --json name,headSha,status,conclusion,createdAt 2>/dev/null || echo '[]')"

    if [[ -n "$target_sha" ]]; then
      status="$(printf '%s' "$raw" \
        | jq -r --arg sha "$target_sha" --arg names "$ci_workflow_names" '
            map(select(
              .headSha == $sha and
              ($names == "" or (.name as $n | $names | split("\n") | index($n) != null))
            )) as $filtered
            | if ($filtered | length) == 0 then "missing"
              elif ($names != "" and
                    (($names | split("\n")) | any(.[]; . as $n |
                      ($filtered | map(.name) | index($n)) == null))) then "pending"
              elif any($filtered[]; .conclusion == "failure" or .conclusion == "cancelled"
                           or .conclusion == "timed_out" or .conclusion == "startup_failure") then "failure"
              elif all($filtered[]; .conclusion != null) then "success"
              else "pending"
              end
          ')"
    else
      status="$(printf '%s' "$raw" \
        | jq -r --arg names "$ci_workflow_names" '
            map(select($names == "" or (.name as $n | $names | split("\n") | index($n) != null)))
            | if length == 0 then "missing"
              elif any(.[]; .conclusion == "failure" or .conclusion == "cancelled"
                         or .conclusion == "timed_out" or .conclusion == "startup_failure") then "failure"
              elif all(.[]; .conclusion != null) then "success"
              else "pending"
              end
          ')"
    fi

    # Format elapsed time for display.
    if (( elapsed_sec < 60 )); then
      elapsed_fmt="${elapsed_sec}s"
    else
      elapsed_fmt="$(( elapsed_sec / 60 ))m $(( elapsed_sec % 60 ))s"
    fi
    wait_suffix="[waited ${elapsed_fmt} / ${timeout_min}m, next check in ${poll_sec}s]"

    case "$status" in
      success)
        log "CI passed on '${branch}'."
        return 0
        ;;
      failure)
        die "CI failed on '${branch}'. Fix the failure and re-run."
        ;;
      missing)
        # GitHub hasn't scheduled CI yet — this is normal right after a push.
        # Keep polling; the 20-minute timeout guards against CI never being scheduled.
        log "Waiting for CI to be scheduled on '${branch}'… ${wait_suffix}"
        ;;
      *)
        # CI is running — log progress and break down per-workflow status.
        local run_summary
        run_summary="$(printf '%s' "$raw" \
          | jq -r --arg sha "$target_sha" --arg names "$ci_workflow_names" '
              map(select(
                .headSha == $sha and
                ($names == "" or (.name as $n | $names | split("\n") | index($n) != null))
              ))
              | map(
                  if .conclusion == "success" then "\u2713 " + .name
                  elif .conclusion != null then "\u2717 " + .name + " (" + .conclusion + ")"
                  elif .status == "in_progress" then "\u23f3 " + .name
                  else "\u23f3 " + .name + " (" + .status + ")"
                  end
                )
              | join(", ")
            ' 2>/dev/null || true)"
        if [[ -n "$run_summary" ]]; then
          log "CI running on '${branch}': ${run_summary} ${wait_suffix}"
        else
          log "CI running on '${branch}'… ${wait_suffix}"
        fi
        ;;
    esac

    # Periodically re-check for merge conflicts so a conflict that appears
    # after the initial push (e.g. concurrent merge to main) is caught quickly.
    cycles_since_mergeable_check=$(( cycles_since_mergeable_check + 1 ))
    if [[ -n "$pr_num" && $cycles_since_mergeable_check -ge $mergeable_check_interval ]]; then
      cycles_since_mergeable_check=0
      merge_state="$(gh pr view "$pr_num" --json mergeable --jq '.mergeable' 2>/dev/null || echo 'UNKNOWN')"
      if [[ "$merge_state" == 'CONFLICTING' ]]; then
        die "PR #${pr_num} developed merge conflicts during CI wait. Rebase the stack and re-run."
      fi
    fi

    sleep "$poll_sec"
    elapsed_sec=$(( elapsed_sec + poll_sec ))
    if (( elapsed_sec >= timeout_min * 60 )); then
      die "CI timed out after ${timeout_min} min on '${branch}'."
    fi
  done
}

ci_run_exists_for_head() {
  local -r branch="$1"
  local -r target_sha="$2"

  gh run list --repo "${repo_owner}/${repo_name}" --branch "$branch" --limit 30 --json name,headSha 2>/dev/null \
    | jq -e --arg sha "$target_sha" --arg names "$ci_workflow_names" \
        'any(.[]; .headSha == $sha and ($names == "" or (.name as $n | $names | split("\n") | index($n) != null)))' >/dev/null
}

ci_conclusion_for_head() {
  local -r branch="$1"
  local -r target_sha="$2"

  gh run list --repo "${repo_owner}/${repo_name}" --branch "$branch" --limit 30 --json name,headSha,status,conclusion,createdAt 2>/dev/null \
    | jq -r --arg sha "$target_sha" --arg names "$ci_workflow_names" '
        map(select(
          .headSha == $sha and
          ($names == "" or (.name as $n | $names | split("\n") | index($n) != null))
        ))
        # When we know the expected workflows, require all of them to have a run
        # before declaring success — avoids "all done" on a partial set.
        | . as $runs
        | if length == 0 then "missing"
          elif any(.[]; .conclusion == "failure" or .conclusion == "cancelled"
                       or .conclusion == "timed_out" or .conclusion == "startup_failure") then "failure"
          elif ($names != "" and ([$names | split("\n") | .[]] | length) > ($runs | length)) then "pending"
          elif all(.[]; .conclusion != null) then "success"
          else "pending"
          end
      '
}

wait_for_mergeable() {
  local -r pr_num="$1"
  local -r timeout_min=5
  local elapsed=0
  local state already_merged

  # Skip the conflict check if the PR is already merged (GitHub sets mergeable
  # to UNKNOWN on merged PRs, which would cause us to poll until timeout).
  already_merged="$(gh_pr_merged_for_number "$pr_num")"
  if [[ "$already_merged" == 'true' ]]; then
    log "PR #${pr_num} already merged — skipping conflict check."
    return 0
  fi

  log "Checking merge conflict status for PR #${pr_num}…"
  while true; do
    state="$(gh pr view "$pr_num" --json mergeable --jq '.mergeable' 2>/dev/null || echo 'UNKNOWN')"
    case "$state" in
      MERGEABLE)
        log "PR #${pr_num} is mergeable."
        return 0
        ;;
      CONFLICTING)
        cleanup_on_error "PR #${pr_num} has merge conflicts"
        die "PR #${pr_num} has merge conflicts. Rebase the stack and re-run."
        ;;
      UNKNOWN|'')
        : # GitHub is still computing — keep polling
        ;;
    esac
    sleep 10
    elapsed=$(( elapsed + 1 ))
    if (( elapsed * 10 >= timeout_min * 60 )); then
      die "Timed out waiting for PR #${pr_num} mergeable state after ${timeout_min} min."
    fi
  done
}

# Quick mergeable pre-check: called right after gt submit, before initiating CI
# wait. Polls for up to 60 s. Dies immediately on CONFLICTING (no point waiting
# for CI that will never schedule). On MERGEABLE confirms early. On UNKNOWN
# after timeout, proceeds — the final wait_for_mergeable after CI will catch it.
wait_for_mergeable_quick() {
  local -r pr_num="$1"
  local -r timeout_sec=60
  local elapsed=0
  local state

  while true; do
    state="$(gh pr view "$pr_num" --json mergeable --jq '.mergeable' 2>/dev/null || echo 'UNKNOWN')"
    case "$state" in
      MERGEABLE)
        log "PR #${pr_num}: no merge conflicts detected."
        return 0
        ;;
      CONFLICTING)
        cleanup_on_error "PR #${pr_num} has merge conflicts"
        die "PR #${pr_num} has merge conflicts. Check that the worktree base matches origin/main and re-run."
        ;;
      UNKNOWN|'')
        : # GitHub still computing
        ;;
    esac
    sleep 5
    elapsed=$(( elapsed + 5 ))
    if (( elapsed >= timeout_sec )); then
      log "PR #${pr_num}: merge conflict status still UNKNOWN after ${timeout_sec}s — proceeding to CI wait."
      return 0
    fi
  done
}

ensure_dep_updater_label() {
  # Create the 'dep-updater' label on the repo if it doesn't already exist.
  # Idempotent: gh label create exits non-zero if the label exists; we ignore that.
  gh label create 'dep-updater' \
    --repo "${repo_owner}/${repo_name}" \
    --color '0075ca' \
    --description 'Automated dependency update via dep-updater' \
    2>/dev/null || true
}

require_resume_ci_gate() {
  local -r branches_csv="$1"
  local -r prs_csv="$2"

  [[ "$no_wait_ci" == '1' ]] && return 0
  [[ -z "$branches_csv" ]] && return 0

  local last_branch last_pr
  last_branch="$(csv_last "$branches_csv")"
  [[ -z "$last_branch" ]] && return 0

  # Resolve PR from branch directly; do not rely on parallel CSV position.
  last_pr="$(gh_pr_number_for_branch "$last_branch")"
  if [[ -z "$last_pr" && -n "$prs_csv" ]]; then
    # Backward-compat fallback for older state files.
    last_pr="$(csv_last "$prs_csv")"
  fi
  if [[ -n "$last_pr" ]] && ! is_valid_pr_number "$last_pr"; then
    last_pr=""
  fi
  [[ -z "$last_pr" ]] && return 0

  local pr_state pr_merged
  pr_state="$(gh_pr_state_for_number "$last_pr")"
  pr_merged="$(gh_pr_merged_for_number "$last_pr")"
  if [[ "$pr_merged" == 'true' || "$pr_state" == 'closed' ]]; then
    return 0
  fi

  if ! git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${last_branch}"; then
    # Branch may have been wiped by a prior cleanup interrupt. Try the remote.
    if git -C "$worktree_path" show-ref --verify --quiet "refs/remotes/origin/${last_branch}" 2>/dev/null; then
      if git -C "$worktree_path" checkout --track "origin/${last_branch}" --quiet 2>/dev/null; then
        log "Checked out '${last_branch}' from origin for resume CI gate."
      else
        log "Resume CI gate skipped: could not check out '${last_branch}' from origin."
        return 0
      fi
    else
      log "Resume CI gate skipped: branch '${last_branch}' not found locally or on origin."
      return 0
    fi
  fi

  local current_head
  current_head="$(git -C "$worktree_path" rev-parse "$last_branch" 2>/dev/null || true)"
  if [[ -z "$current_head" ]]; then
    log "Resume CI gate skipped: could not resolve head SHA for '${last_branch}'."
    return 0
  fi

  if ! ci_run_exists_for_head "$last_branch" "$current_head"; then
    log "Resuming after existing PR #${last_pr} (${last_branch}); no CI run exists for current head ${current_head:0:8}."
    log "Skipping CI wait; rebase/push this branch to trigger fresh CI, then re-run dep-updater."
    return 0
  fi

  # Check current CI conclusion before deciding what to do.
  local ci_status
  ci_status="$(ci_conclusion_for_head "$last_branch" "$current_head")"

  case "$ci_status" in
    failure)
      # CI has already failed on the interrupted PR — close it automatically
      # and clean up so the next run starts fresh.
      log "PR #${last_pr} (${last_branch}) failed CI. Closing it automatically."
      gh pr close "$last_pr" \
        --comment "Closed by dep-updater: CI failed on branch '${last_branch}'. Re-run to create a fresh update." \
        2>/dev/null || true
      cleanup
      _cleanup_trap_active=0
      die "PR #${last_pr} was closed. Re-run dep-updater to create a fresh update."
      ;;
    success|skipped|neutral)
      # CI already passed — nothing to wait for.
      log "Resuming after existing PR #${last_pr} (${last_branch}); CI already passed."
      return 0
      ;;
    *)
      # CI is still pending (or conclusion unknown).
      log "PR #${last_pr} (${last_branch}) is still waiting on CI (status: ${ci_status})."
      if is_interactive; then
        if prompt_yes_no "Wait for CI on PR #${last_pr}?" "y"; then
          log "Waiting for CI on PR #${last_pr} (${last_branch})…"
          wait_for_ci "$last_branch" "$current_head" "$last_pr"
        elif prompt_yes_no "Close PR #${last_pr} and start fresh?" "n"; then
          log "Closing PR #${last_pr}…"
          gh pr close "$last_pr" \
            --comment "Closed by dep-updater: run was interrupted while CI was pending." \
            2>/dev/null || true
          cleanup
          _cleanup_trap_active=0
          die "PR #${last_pr} has been closed. Re-run dep-updater to create a fresh update."
        else
          log "Leaving PR #${last_pr} open. Re-run dep-updater when ready to continue."
          exit 0
        fi
      else
        # Non-interactive (e.g. CI): resume waiting as before.
        log "Resuming after existing PR #${last_pr} (${last_branch}); waiting for CI before creating new PRs..."
        wait_for_ci "$last_branch" "$current_head" "$last_pr"
      fi
      ;;
  esac
}

# Gates on CI and mergeability for every branch that has been created so far
# in this run.  Called once after all PRs are created so that no individual
# PR is visible as "CI-passed + labelled" before the full stack is assembled.
# Security PRs gate themselves before regular PRs are stacked; this function
# handles the regular (and batch) PRs, and is a fast no-op for branches whose
# CI already passed (wait_for_ci returns success on the first poll).
gate_all_created_prs() {
  local branches_csv branch pr_num head_sha already_merged
  local -a gate_list

  [[ "$no_wait_ci" == '0' ]] || return 0

  branches_csv="$(state_get "branches")"
  [[ -z "$branches_csv" ]] && return 0

  IFS=',' read -ra gate_list <<< "$branches_csv"
  for branch in "${gate_list[@]}"; do
    [[ -z "$branch" ]] && continue
    pr_num="$(gh_pr_number_for_branch "$branch")"
    [[ -z "$pr_num" ]] && continue
    already_merged="$(gh_pr_merged_for_number "$pr_num" 2>/dev/null || true)"
    [[ "$already_merged" == 'true' ]] && continue
    head_sha="$(git -C "$worktree_path" rev-parse "$branch" 2>/dev/null || true)"
    [[ -z "$head_sha" ]] && continue
    log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
    wait_for_mergeable_quick "$pr_num"
    log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
    wait_for_ci "$branch" "$head_sha" "$pr_num"
    if [[ "$(gh_pr_merged_for_number "$pr_num")" != 'true' ]]; then
      log "[gate] CI passed. Final merge conflict check…"
      wait_for_mergeable "$pr_num"
      log "[gate] PR #${pr_num} is mergeable."
    fi
  done
}

maybe_label_top_pr_for_merge() {
  local branches_csv prs_csv top_branch top_pr
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"
  [[ -z "$branches_csv" ]] && return 0

  top_branch="$(csv_last "$branches_csv")"
  [[ -z "$top_branch" ]] && return 0

  top_pr="$(gh_pr_number_for_branch "$top_branch")"
  if [[ -z "$top_pr" && -n "$prs_csv" ]]; then
    top_pr="$(csv_last "$prs_csv")"
  fi
  if [[ -n "$top_pr" ]] && ! is_valid_pr_number "$top_pr"; then
    top_pr=""
  fi
  [[ -z "$top_pr" ]] && return 0

  local pr_state pr_merged
  pr_state="$(gh_pr_state_for_number "$top_pr")"
  pr_merged="$(gh_pr_merged_for_number "$top_pr")"
  if [[ "$pr_merged" == 'true' || "$pr_state" == 'closed' ]]; then
    return 0
  fi

  if ! git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${top_branch}"; then
    log "Top stack branch '${top_branch}' not found locally; skipping merge-it prompt."
    return 0
  fi

  local top_head ci_status
  top_head="$(git -C "$worktree_path" rev-parse "$top_branch" 2>/dev/null || true)"
  [[ -z "$top_head" ]] && return 0

  ci_status="$(ci_conclusion_for_head "$top_branch" "$top_head")"
  case "$ci_status" in
    success|skipped|neutral)
      ;;
    *)
      log "Top PR #${top_pr} (${top_branch}) is not merge-ready yet (CI status: ${ci_status})."
      return 0
      ;;
  esac

  local has_label
  has_label="$(gh api "repos/${repo_owner}/${repo_name}/issues/${top_pr}" --jq 'any(.labels[]?; .name == "merge-it")' 2>/dev/null || echo 'false')"
  if [[ "$has_label" == 'true' ]]; then
    log "Top PR #${top_pr} already has merge-it label."
    return 0
  fi

  # Always add the merge-it label automatically when CI is clean
  add_merge_it_label "$top_pr"
  log "Added merge-it label to top PR #${top_pr}."
}

# ---------------------------------------------------------------------------
# PR body writer
# ---------------------------------------------------------------------------

write_pr_body() {
  local -r pkg="$1"
  local -r from_ver="$2"
  local -r to_ver="$3"
  local -r eco="$4"
  local -r files="$5"
  local -r cve_lines="${6:-}"  # optional: "pkg current fix cve1,cve2" lines for this package
  local -r body_file="$7"       # caller-provided path (use mktemp)

  # Write to a file and use --body-file to avoid heredoc escaping issues
  {
    printf '%s\n\n' '## Stack Context'
    printf "Automated dependency updates via \`dep-updater\`.\n"
    printf '%s\n\n' 'Each PR bumps exactly one dependency. Merge the full stack to update all.'
    printf '%s\n\n' '## Why?'
    if [[ -n "$cve_lines" ]]; then
      printf "\`%s\` has known CVE(s) and a newer version is available.\n\n" "$pkg"
    else
      printf "\`%s\` has a newer version available.\n\n" "$pkg"
    fi
    printf -- "- **From:** \`%s\`\n" "$from_ver"
    printf -- "- **To:** \`%s\`\n" "$to_ver"
    printf -- '- **Ecosystem:** %s\n' "$eco"
    printf -- '- **Files changed:** %s\n' "$files"
    if [[ -n "$cve_lines" ]]; then
      printf '\n## CVEs addressed\n\n'
      printf '| CVE | Fixed in |\n'
      printf '|---|---|\n'
      while IFS=' ' read -r _p _cur fix cves; do
        [[ -z "$cves" ]] && continue
        local cve
        for cve in ${cves//,/ }; do
          printf "| %s | \`%s\` |\n" "$cve" "$fix"
        done
      done <<< "$cve_lines"
    fi
  } > "$body_file"
}

# ---------------------------------------------------------------------------
# Summary table
# ---------------------------------------------------------------------------

add_summary_line() {
  # Args: ecosystem pkg from to branch pr
  local -r entry="$*"
  if [[ -z "$summary_lines" ]]; then
    summary_lines="$entry"
  else
    summary_lines="${summary_lines}
${entry}"
  fi
}

print_stack_urls() {
  local -r prs_csv="$1"
  [[ -z "$prs_csv" ]] && return 0

  local first_pr
  first_pr="${prs_csv%%,*}"
  [[ -z "$first_pr" ]] && return 0

  log ""
  log "Stack URLs:"
  log "  Graphite: https://app.graphite.com/github/pr/${repo_owner}/${repo_name}/${first_pr}"
  local remaining="$prs_csv"
  local pr
  while [[ -n "$remaining" ]]; do
    pr="${remaining%%,*}"
    [[ -n "$pr" ]] && log "  GitHub:   https://github.com/${repo_owner}/${repo_name}/pull/${pr}"
    if [[ "$remaining" == *,* ]]; then
      remaining="${remaining#*,}"
    else
      break
    fi
  done
}

print_summary() {
  if [[ -z "$summary_lines" ]]; then
    log ""
    log "Dependency update summary:"
    log "  No new dependency PRs were created in this run."
    return 0
  fi

  log ""
  log "Dependency update summary:"

  # summary_lines entries: ecosystem pkg from to branch pr
  # Put the header inside the column pipeline so all widths align.
  # Use '-' for empty from/to (batch and security-only PRs have no version range).
  {
    printf 'ECOSYSTEM|PACKAGE|FROM|TO|PR\n'
    while IFS=' ' read -r eco pkg from to _branch pr; do
      [[ -z "$pkg" ]] && continue
      printf '%s|%s|%s|%s|#%s\n' \
        "$eco" "$pkg" "${from:--}" "${to:--}" "$pr"
    done <<< "$summary_lines"
  } | column -t -s '|' >&2
}

# ---------------------------------------------------------------------------
# Worktree cleanup helpers
# ---------------------------------------------------------------------------

cleanup_on_error() {
  local -r reason="$1"
  log "Cleaning up after error: ${reason}"
  # Close any open PRs created in this session so a subsequent run starts fresh.
  if [[ -n "$state_file" && -f "$state_file" ]]; then
    local saved_prs=""
    saved_prs="$(state_get "prs" 2>/dev/null || true)"
    if [[ -n "$saved_prs" ]]; then
      local saved_p saved_merged saved_state
      IFS=',' read -ra saved_prs_list <<< "$saved_prs"
      for saved_p in "${saved_prs_list[@]}"; do
        [[ -z "$saved_p" ]] && continue
        saved_merged="$(gh_pr_merged_for_number "$saved_p" 2>/dev/null || true)"
        saved_state="$(gh_pr_state_for_number "$saved_p" 2>/dev/null || true)"
        if [[ "$saved_merged" != 'true' && "$saved_state" == 'open' ]]; then
          log "Closing PR #${saved_p} (cleanup on error — re-run to submit a fresh PR)."
          gh pr close "$saved_p" --repo "${repo_owner}/${repo_name}" 2>/dev/null || true
        fi
      done
    fi
  fi
  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    log "[worktree] Removing worktree: $worktree_path"
    git -C "$dir" worktree remove --force "$worktree_path" 2>/dev/null \
      || log "Note: worktree directory already removed."
    if [[ -n "$wt_base_branch" ]]; then
      log "[worktree] Deleting branch: $wt_base_branch"
      git -C "$dir" branch -D "$wt_base_branch" 2>/dev/null \
        || log "Note: wt_base_branch '${wt_base_branch}' not found; skipping deletion."
    fi
  fi
  # Preserve the state file so a subsequent run can detect open PRs via
  # require_resume_ci_gate and handle them (wait, prompt, or auto-close).
  # cleanup() (the success path) is responsible for the final deletion.
}

cleanup() {
  log "Cleaning up worktree…"
  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    log "[worktree] Removing worktree: $worktree_path"
    git -C "$dir" worktree remove --force "$worktree_path" 2>/dev/null \
      || log "Note: worktree directory already removed."
    log "[worktree] Worktree removed."
  fi
  if [[ -n "$wt_base_branch" ]]; then
    log "[worktree] Deleting branch: $wt_base_branch"
    git -C "$dir" branch -D "$wt_base_branch" 2>/dev/null \
      || log "Note: wt_base_branch '${wt_base_branch}' not found."
  fi
  rm -f "$state_file"
  log "Cleanup complete."
}

poll_until_merged() {
  local -r prs_csv="$1"
  local -r timeout_min="${merge_timeout_min}"
  local -r poll_sec=30
  local elapsed=0
  local elapsed_fmt wait_suffix remaining_sec remaining_fmt

  log "Waiting for all PRs to merge (timeout: ${timeout_min} min)…"
  log "PRs: $(csv_pretty "$prs_csv")"

  local all_merged p merged pending_list check_rollup failed_check
  while true; do
    all_merged=1
    pending_list=""
    IFS=',' read -ra pr_list <<< "$prs_csv"
    for p in "${pr_list[@]}"; do
      [[ -z "$p" ]] && continue
      merged="$(gh_pr_merged_for_number "$p")"
      if [[ "$merged" != 'true' ]]; then
        all_merged=0
        pending_list="${pending_list:+${pending_list}, }#${p}"

        # Check statusCheckRollup: GitHub associates merge-queue CI runs back to
        # the original PR's head commit, so failures from the merge queue appear
        # here even though wait_for_ci only saw the initial push CI.
        check_rollup="$(gh pr view "$p" \
          --repo "${repo_owner}/${repo_name}" \
          --json statusCheckRollup \
          --jq '.statusCheckRollup // []' 2>/dev/null || echo '[]')"
        failed_check="$(printf '%s' "$check_rollup" \
          | jq -r '
              map(select(
                .conclusion == "FAILURE" or .conclusion == "ERROR" or
                .conclusion == "CANCELLED" or .conclusion == "TIMED_OUT" or
                .conclusion == "STARTUP_FAILURE" or .conclusion == "ACTION_REQUIRED"
              )) | if length > 0 then .[0].name else "" end
            ' 2>/dev/null || true)"
        if [[ -n "$failed_check" ]]; then
          cleanup_on_error "PR #${p}: CI check '${failed_check}' failed in the merge queue"
          die "PR #${p}: CI check '${failed_check}' failed in the merge queue. Fix the failure and re-run."
        fi
      fi
    done

    if [[ "$all_merged" == '1' ]]; then
      log "All PRs merged."
      return 0
    fi

    if (( elapsed >= timeout_min * 60 )); then
      log "Timed out after ${timeout_min} min waiting for PRs to merge."
      log "Re-run with --cleanup once all PRs are merged."
      return 1
    fi

    # Format elapsed and remaining for progress display.
    if (( elapsed < 60 )); then
      elapsed_fmt="${elapsed}s"
    else
      elapsed_fmt="$(( elapsed / 60 ))m $(( elapsed % 60 ))s"
    fi
    remaining_sec=$(( timeout_min * 60 - elapsed ))
    if (( remaining_sec < 60 )); then
      remaining_fmt="${remaining_sec}s"
    else
      remaining_fmt="$(( remaining_sec / 60 ))m $(( remaining_sec % 60 ))s"
    fi
    wait_suffix="[waited ${elapsed_fmt} / ${timeout_min}m, ~${remaining_fmt} remaining, next check in ${poll_sec}s]"
    log "Still waiting for: ${pending_list} ${wait_suffix}"

    sleep "$poll_sec"
    elapsed=$(( elapsed + poll_sec ))
  done
}

# ---------------------------------------------------------------------------
# Dry-run output helpers
# ---------------------------------------------------------------------------

# Emit a JSON report to stdout for --report-json mode.
# Args: npm_audit_lines  py_audit_lines  npm_lines  py_lines
# All args may be empty strings.
_emit_report_json() {
  local npm_audit_lines="$1"
  local py_audit_lines="$2"
  local npm_lines="$3"
  local py_lines="$4"

  local cves_json="[]"
  local updates_json="[]"

  # Build CVE array.
  if [[ -n "$npm_audit_lines" ]]; then
    while IFS=' ' read -r pkg current fix cve_ids; do
      [[ -z "$pkg" ]] && continue
      cves_json="$(printf '%s' "$cves_json" \
        | jq --arg p "$pkg" --arg c "$current" --arg f "$fix" --arg ids "$cve_ids" \
            '. + [{"ecosystem":"npm","package":$p,"current":$c,"fix":$f,"cves":$ids}]')"
    done <<< "$npm_audit_lines"
  fi
  if [[ -n "$py_audit_lines" ]]; then
    while IFS=' ' read -r pkg current fix cve_ids; do
      [[ -z "$pkg" ]] && continue
      cves_json="$(printf '%s' "$cves_json" \
        | jq --arg e "python/${py_tool}" --arg p "$pkg" --arg c "$current" --arg f "$fix" --arg ids "$cve_ids" \
            '. + [{"ecosystem":$e,"package":$p,"current":$c,"fix":$f,"cves":$ids}]')"
    done <<< "$py_audit_lines"
  fi

  # Build updates array.
  if [[ -n "$npm_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      updates_json="$(printf '%s' "$updates_json" \
        | jq --arg p "$pkg" --arg o "$old_ver" --arg n "$new_ver" \
            '. + [{"ecosystem":"npm","package":$p,"from":$o,"to":$n}]')"
    done <<< "$npm_lines"
  fi
  if [[ -n "$py_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      updates_json="$(printf '%s' "$updates_json" \
        | jq --arg e "python/${py_tool}" --arg p "$pkg" --arg o "$old_ver" --arg n "$new_ver" \
            '. + [{"ecosystem":$e,"package":$p,"from":$o,"to":$n}]')"
    done <<< "$py_lines"
  fi

  jq -n \
    --arg repo "$dir" \
    --argjson cves "$cves_json" \
    --argjson updates "$updates_json" \
    '{
      repo: $repo,
      has_updates: (($updates | length) > 0),
      has_cves: (($cves | length) > 0),
      cves: $cves,
      updates: $updates
    }'
}

# Print a columnar table of ecosystem|package|from|to rows.
# The header row is included in the column pipeline so widths align.
print_update_table() {
  local -a rows=("$@")
  if [[ ${#rows[@]} -eq 0 ]]; then
    return 0
  fi
  {
    printf 'ECOSYSTEM|PACKAGE|FROM|TO\n'
    printf '%s\n' "${rows[@]}"
  } | column -t -s '|'
}

# Print a per-PR plan entry for dry-run mode.
# Args: index scope branch commit files entries cmd
print_dry_run_pr_plan() {
  local -r idx="$1"
  local -r scope="$2"
  local -r branch="$3"
  local -r commit="$4"
  local -r files="$5"
  local -r entries="$6"
  local -r cmd="$7"
  printf '\n── PR #%s: %s\n' "$idx" "$scope"
  printf '   Branch  : %s\n' "$branch"
  printf '   Commit  : %s\n' "$commit"
  printf '   Files   : %s\n' "$files"
  printf '   Command : %s\n' "$cmd"
  if [[ -n "$entries" ]]; then
    printf '   Updates :\n'
    while IFS=' ' read -r u_pkg u_old u_new; do
      [[ -z "$u_pkg" ]] && continue
      printf '     %s  %s → %s\n' "$u_pkg" "$u_old" "$u_new"
    done <<< "$entries"
  fi
}

# ---------------------------------------------------------------------------
# Rebase helper
# ---------------------------------------------------------------------------

rebase_stack_on_main() {
  local branches_csv
  branches_csv="$(state_get "branches")"
  if [[ -z "$branches_csv" ]]; then
    log "No stack branches found; nothing to rebase."
    return 0
  fi

  git -C "$worktree_path" fetch origin main >/dev/null 2>&1 \
    || log "Note: could not fetch latest main."

  run_in_worktree gt sync --force 2>/dev/null \
    || run_in_worktree gt restack \
    || die "Rebase failed. Resolve conflicts manually and re-run."

  run_in_worktree gt submit --no-interactive --publish --no-stack \
    || log "Note: gt submit after restack returned non-zero (may be a no-op)."

  log "Rebase complete."
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
  parse_args "$@"
  init_prompt_style
  check_core_prereqs
  if [[ "$dry_run" == '0' ]]; then
    init_repo_api_context
  fi
  detect_ecosystem
  check_ecosystem_prereqs "$has_npm" "$py_tool"
  if [[ "$dry_run" == '0' ]]; then
    check_auth_prereqs
    detect_ci_workflows
  fi

  # ── --cleanup mode ──────────────────────────────────────────────────────
  if [[ "$cleanup_mode" == '1' ]]; then
    init_state_file
    if [[ ! -f "$state_file" ]]; then
      log "No state file found at: ${state_file}"
      log "Nothing to clean up."
      exit 0
    fi
    sanitize_state_prs
    local wt
    wt="$(state_get "worktree")"
    worktree_path="$wt"
    wt_base_branch="$(state_get "wt_branch")"
    log "Running cleanup for worktree: ${worktree_path}"
    cleanup
    exit 0
  fi

  # ── --rebase mode ───────────────────────────────────────────────────────
  if [[ "$rebase_mode" == '1' ]]; then
    init_state_file
    if [[ ! -f "$state_file" ]]; then
      die "No state file found at: ${state_file}. Nothing to rebase."
    fi
    sanitize_state_prs
    local wt
    wt="$(state_get "worktree")"
    if [[ -z "$wt" || ! -d "$wt" ]]; then
      die "Worktree not found: ${wt}. Run without --rebase to create a new stack."
    fi
    worktree_path="$wt"
    readonly worktree_path
    wt_base_branch="$(state_get "wt_branch")"
    log "Rebasing stack in worktree: ${worktree_path}"
    rebase_stack_on_main
    exit 0
  fi

  warn_if_dirty_workdir

# ---------------------------------------------------------------------------
# Dry-run mode: temporary worktree → scan → plan → destroy
# ---------------------------------------------------------------------------
# Helper: destroy the dry-run worktree and its tracking branch cleanly.
_dry_run_teardown() {
  local -r wt="$1"
  _cleanup_trap_active=0
  log "[worktree] Removing: $wt"
  cd - >/dev/null 2>&1 || true
  git -C "$dir" worktree remove --force "$wt" 2>/dev/null || true
  git -C "$dir" branch -D "$wt_base_branch" >/dev/null 2>&1 || true
  log "[worktree] Removed: $wt"
}

if [[ "$dry_run" == '1' ]]; then
  # Always create (and destroy) the worktree so lifecycle is exercised even
  # when no ecosystem is present — this is the main testable invariant.
  create_worktree
  _cleanup_trap_active=1
  local audit_dir="$worktree_path"
  cd "$audit_dir" || die "Failed to cd to dry-run worktree: $audit_dir"

  # ── No ecosystem detected ────────────────────────────────────────────
  if [[ "$has_npm" == '0' && -z "$py_tool" ]]; then
    log "No supported ecosystem detected — nothing to update."
    if [[ "$report_json" == '1' ]]; then
      _emit_report_json "" "" "" ""
    fi
    _dry_run_teardown "$audit_dir"
    exit 0
  fi

  # ── Security audit ───────────────────────────────────────────────────
  local npm_audit_lines="" py_audit_lines=""
  if [[ "$has_npm" == '1' ]]; then
    npm_audit_lines="$(npm_audit)"
  fi
  if [[ -n "$py_tool" ]]; then
    py_audit_lines="$(py_audit "$py_tool" "$audit_dir")"
  fi

  if [[ -n "$npm_audit_lines" ]]; then
    printf '\n[npm] CVEs with available fixes:\n'
    {
      printf 'PACKAGE|CURRENT|FIX|CVEs\n'
      while IFS=' ' read -r cve_pkg cve_cur cve_fix cve_ids; do
        [[ -z "$cve_pkg" ]] && continue
        printf '%s|%s|%s|%s\n' "$cve_pkg" "$cve_cur" "$cve_fix" "$cve_ids"
      done <<< "$npm_audit_lines"
    } | column -t -s '|'
  fi
  if [[ -n "$py_audit_lines" ]]; then
    printf '\n[python/%s] CVEs with available fixes:\n' "$py_tool"
    {
      printf 'PACKAGE|CURRENT|FIX|CVEs\n'
      while IFS=' ' read -r cve_pkg cve_cur cve_fix cve_ids; do
        [[ -z "$cve_pkg" ]] && continue
        printf '%s|%s|%s|%s\n' "$cve_pkg" "$cve_cur" "$cve_fix" "$cve_ids"
      done <<< "$py_audit_lines"
    } | column -t -s '|'
  fi
  if [[ -z "$npm_audit_lines" && -z "$py_audit_lines" ]]; then
    log "No CVEs with direct fixes found."
  fi

  if [[ "$security_only" == '1' ]]; then
    if [[ "$report_json" == '1' ]]; then
      _emit_report_json "$npm_audit_lines" "$py_audit_lines" "" ""
    fi
    _dry_run_teardown "$audit_dir"
    exit 0
  fi

  # ── Outdated packages ────────────────────────────────────────────────
  local npm_lines="" py_lines=""
  if [[ "$has_npm" == '1' ]]; then
    npm_lines="$(npm_outdated)"
  fi
  if [[ -n "$py_tool" ]]; then
    py_lines="$(py_outdated "$py_tool" "$audit_dir")"
  fi

  # Normalize empty/null/'{}'
  [[ "$npm_lines" == '{}' || "$npm_lines" == 'null' ]] && npm_lines=""
  [[ "$py_lines"  == '{}' || "$py_lines"  == 'null' ]] && py_lines=""

  if [[ -z "$npm_lines" && -z "$py_lines" ]]; then
    log "All dependencies are up to date."
    if [[ "$report_json" == '1' ]]; then
      _emit_report_json "$npm_audit_lines" "$py_audit_lines" "" ""
    fi
    _dry_run_teardown "$audit_dir"
    exit 0
  fi

  # ── Summary table + per-PR plan (human-readable; skipped in --report-json) ──
  if [[ "$report_json" == '0' ]]; then
  printf '\n'
  local -a all_rows=()
  if [[ -n "$npm_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      all_rows+=("npm|$pkg|$old_ver|$new_ver")
    done <<< "$npm_lines"
  fi
  if [[ -n "$py_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      all_rows+=("python/${py_tool}|$pkg|$old_ver|$new_ver")
    done <<< "$py_lines"
  fi
  print_update_table "${all_rows[@]}"

  # ── Per-PR plan ───────────────────────────────────────────────────────
  printf '\n'
  if [[ "$batch" == '1' ]]; then
    printf '── Batch PR plan ──────────────────────────────────────────────\n'
    printf '   Branch  : dep-updates/batch\n'
    printf '   Commit  : chore(deps): batch dependency updates\n'
    printf '   (All updates above combined into a single PR)\n'
  else
    local pr_index=0

    if [[ -n "$npm_lines" ]]; then
      local group_keys
      group_keys="$(list_npm_group_keys "$npm_lines")"
      while IFS= read -r group_key; do
        [[ -z "$group_key" ]] && continue
        local entries
        entries="$(npm_entries_for_group "$group_key" "$npm_lines")"
        [[ -z "$entries" ]] && continue

        local safe_group scope_label commit_msg lockfile cmd_prefix
        safe_group="$(sanitize_branch_name "${group_key#@}")"
        local branch="dep-updates/npm-${safe_group}"

        local pkg_count=0 first_pkg="" first_old="" first_new=""
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          pkg_count=$(( pkg_count + 1 ))
          if [[ "$pkg_count" -eq 1 ]]; then
            first_pkg="$pkg"; first_old="$old_ver"; first_new="$new_ver"
          fi
        done <<< "$entries"

        if [[ "$pkg_count" -eq 1 ]]; then
          commit_msg="chore(deps): bump ${first_pkg} from ${first_old} to ${first_new}"
          scope_label="npm/${first_pkg}"
        else
          commit_msg="chore(deps): bump ${group_key} from ${first_old} to ${first_new}"
          scope_label="npm/${group_key} (${pkg_count} packages)"
        fi

        case "$npm_tool" in
          pnpm) lockfile="pnpm-lock.yaml" ;;
          yarn) lockfile="yarn.lock" ;;
          *)    lockfile="package-lock.json" ;;
        esac

        case "$npm_tool" in
          pnpm)
            if [[ "$semver_only" == '1' ]]; then
              cmd_prefix="pnpm --dir <worktree> update"
            else
              cmd_prefix="pnpm --dir <worktree> update --latest"
            fi
            ;;
          yarn) cmd_prefix="yarn --cwd <worktree> upgrade --latest" ;;
          *)
            if [[ "$semver_only" == '1' ]]; then
              cmd_prefix="npm update --prefix <worktree>"
            else
              cmd_prefix="npm install --prefix <worktree> __PKG__@latest"
            fi
            ;;
        esac

        pr_index=$(( pr_index + 1 ))
        print_dry_run_pr_plan \
          "$pr_index" \
          "$scope_label" \
          "$branch" \
          "$commit_msg" \
          "package.json + ${lockfile}" \
          "$entries" \
          "$cmd_prefix"
      done <<< "$group_keys"
    fi

    if [[ -n "$py_lines" ]]; then
      while IFS=' ' read -r pkg old_ver new_ver; do
        [[ -z "$pkg" ]] && continue
        local safe_name py_branch py_commit py_files py_cmd
        safe_name="$(sanitize_branch_name "$pkg")"
        py_branch="dep-updates/py-${safe_name}"
        py_commit="chore(deps): bump ${pkg} from ${old_ver} to ${new_ver}"
        case "$py_tool" in
          uv)     py_files="pyproject.toml + uv.lock" ;   py_cmd="uv --directory <worktree> add ${pkg}==${new_ver}" ;;
          poetry) py_files="pyproject.toml + poetry.lock"; py_cmd="poetry add ${pkg}@${new_ver}" ;;
          pipenv) py_files="Pipfile + Pipfile.lock" ;      py_cmd="pipenv install ${pkg}==${new_ver}" ;;
          *)      py_files="requirements.txt" ;            py_cmd="${py_tool} install ${pkg}==${new_ver}" ;;
        esac
        pr_index=$(( pr_index + 1 ))
        print_dry_run_pr_plan \
          "$pr_index" \
          "python/${py_tool}/${pkg}" \
          "$py_branch" \
          "$py_commit" \
          "$py_files" \
          "${pkg} ${old_ver} ${new_ver}" \
          "$py_cmd"
      done <<< "$py_lines"
    fi
  fi
  fi  # end: report_json == 0

  if [[ "$report_json" == '1' ]]; then
    _emit_report_json "$npm_audit_lines" "$py_audit_lines" "$npm_lines" "$py_lines"
  fi

  _dry_run_teardown "$audit_dir"
  exit 0
fi

# ---------------------------------------------------------------------------
# Update mode
# ---------------------------------------------------------------------------
local npm_lines="" py_lines=""
if [[ "$has_npm" == '1' ]]; then
  npm_lines="$(npm_outdated)"
fi
if [[ -n "$py_tool" ]]; then
  py_lines="$(py_outdated "$py_tool" "$dir")"
fi

if [[ -z "$npm_lines" && -z "$py_lines" ]]; then
  log "All dependencies are up to date."
  init_state_file
  sanitize_state_prs
  if [[ -f "$state_file" ]]; then
    prepare_worktree
    ensure_gt_tracked
    _cleanup_trap_active=1
    # Fetch remote refs without touching the primary repo's working tree.
    # (gt sync --force fails when the primary repo has local uncommitted changes.)
    git -C "$worktree_path" fetch origin --prune 2>/dev/null || true
    log "Working in: $worktree_path"

    local existing_branches existing_prs
    existing_branches="$(state_get "branches")"
    existing_prs="$(state_get "prs")"
    require_resume_ci_gate "$existing_branches" "$existing_prs"
    gate_all_created_prs
    maybe_label_top_pr_for_merge

    if [[ "$no_wait_merge" == '1' ]]; then
      log ""
      log "Stack submitted. To clean up after all PRs are merged, run:"
      log "  dep-updater --cleanup --dir ${dir}"
      exit 0
    fi

    local final_prs
    final_prs="$(collect_tracked_prs_csv)"
    if [[ -n "$final_prs" ]]; then
      poll_until_merged "$final_prs"
    else
      log "No tracked PRs found; nothing to monitor."
    fi
    # Always clean up the worktree when re-entering with no new deps — even
    # if final_prs was empty (e.g. state file exists but worktree was gone
    # and was just recreated, or all PRs already merged outside our tracking).
    cleanup
    exit 0
  fi
  exit 0
fi

# Create/reuse worktree, initialize state
init_state_file
sanitize_state_prs
# Read any open-PR state from a prior interrupted run BEFORE prepare_worktree
# can overwrite the state file.  cleanup_on_error intentionally preserves the
# state file so these values survive a SIGINT.
local existing_branches existing_prs
existing_branches="$(state_get "branches")"
existing_prs="$(state_get "prs")"
prepare_worktree
ensure_gt_tracked

# Worktree is live — any unexpected exit from here should trigger cleanup.
_cleanup_trap_active=1
  
# Fetch remote refs without touching the primary repo's working tree.
git -C "$worktree_path" fetch origin --prune 2>/dev/null || true

log "Working in: $worktree_path"

require_resume_ci_gate "$existing_branches" "$existing_prs"
ensure_dep_updater_label

# ── Security PRs go first (bottom of the stack) ───────────────────────────
# Run audits now, before any regular updates, so CVE fixes are baseline PRs.
local npm_audit_lines="" py_audit_lines=""
if [[ "$has_npm" == '1' ]]; then
  log "Running npm security audit…"
  npm_audit_lines="$(npm_audit)"
  if [[ -n "$npm_audit_lines" ]]; then
    local vuln_count
    vuln_count="$(printf '%s\n' "$npm_audit_lines" | grep -c .)"
    log "Found ${vuln_count} npm package(s) with CVEs that have fixes available."
    if [[ "$batch" == '0' ]]; then
      npm_security_update "$npm_audit_lines"
    fi
  else
    log "No npm CVEs with direct fixes found."
  fi
fi
if [[ -n "$py_tool" ]]; then
  log "Running Python security audit…"
  py_audit_lines="$(py_audit "$py_tool")"
  if [[ -n "$py_audit_lines" ]]; then
    local py_vuln_count
    py_vuln_count="$(printf '%s\n' "$py_audit_lines" | grep -c .)"
    log "Found ${py_vuln_count} Python package(s) with CVEs that have fixes available."
    if [[ "$batch" == '0' ]]; then
      py_security_update "$py_audit_lines" "$py_tool"
    fi
  else
    log "No Python CVEs with direct fixes found."
  fi
fi

# ── Regular updates follow (stacked on top of security PRs) ──────────────
if [[ "$batch" == '1' ]]; then
  # Batch mode: one branch + one PR for everything.
  batch_update_all "$npm_audit_lines" "$py_audit_lines" "$npm_lines" "$py_lines"
elif [[ "$security_only" == '1' ]]; then
  log "--security-only: skipping regular version bumps."
else
  if [[ -n "$npm_lines" ]]; then
    local group_keys
    group_keys="$(list_npm_group_keys "$npm_lines")"
    while IFS= read -r group_key; do
      [[ -z "$group_key" ]] && continue
      local entries
      entries="$(npm_entries_for_group "$group_key" "$npm_lines")"
      [[ -z "$entries" ]] && continue
      npm_update_group "$group_key" "$entries" "$npm_audit_lines"
    done <<< "$group_keys"
  fi

  # Process Python packages
  if [[ -n "$py_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      py_update_one "$pkg" "$old_ver" "$new_ver" "$py_tool" "$py_audit_lines"
    done <<< "$py_lines"
  fi
fi

print_summary
local all_prs_csv
all_prs_csv="$(collect_tracked_prs_csv)"
print_stack_urls "$all_prs_csv"
gate_all_created_prs
maybe_label_top_pr_for_merge

if [[ "$no_wait_merge" == '1' ]]; then
  log ""
  log "Stack submitted. To clean up after all PRs are merged, run:"
  log "  $0 --cleanup --dir ${dir}"
  _cleanup_trap_active=0
  exit 0
fi

if [[ -z "$all_prs_csv" ]]; then
  # Nothing was created this run — skip merge polling and go straight to cleanup.
  _cleanup_trap_active=0
  cleanup
  exit 0
fi

# Wait for merge and clean up automatically
poll_until_merged "$all_prs_csv"
_cleanup_trap_active=0
cleanup
exit 0
}

main "$@"
