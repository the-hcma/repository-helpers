#!/usr/bin/env bash
# dep-updater — discover and bump outdated dependencies via a Graphite PR stack.
#
# Creates one stacked PR per outdated package inside a dedicated git worktree,
# waits for CI on each PR, then cleans up the worktree once the stack is merged.
#
# See scripts/dep-updater.plan.md for full design documentation.
set -euo pipefail

# uv's cache sits on the home filesystem while worktrees live in /tmp (a
# separate filesystem).  Hardlinks can't cross filesystems, so uv falls back
# to copying and emits a warning unless we tell it copy mode is expected.
export UV_LINK_MODE=copy

# Note: we intentionally do NOT use set -E (errtrace) because it causes the
# ERR trap to be inherited by command substitution subshells.  That would fire
# cleanup_on_error from inside a $(cmd) subshell, deleting the real worktree
# while the parent shell continues executing — the root cause of worktree leaks.
# The EXIT trap below is sufficient: set -e causes the main process to exit on
# any unhandled failure, which fires the EXIT trap exactly once.
trap '_on_exit'          EXIT
trap '_on_signal INT'    INT
trap '_on_signal TERM'   TERM

dep_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly dep_script_dir

# Minimum age (minutes) before proposing a version bump. One day shorter than
# Dependabot cooldown so dep-updater lands updates first (see release-age-defaults).
#
# shellcheck source=scripts/lib/release-age-defaults
source "${dep_script_dir}/lib/release-age-defaults"

# shellcheck disable=SC1091  # shared helper sourced at runtime; CI shellcheck doesn't use -x
source "${dep_script_dir}/lib/time-log"
# shellcheck disable=SC1091
source "${dep_script_dir}/lib/runner"
# shellcheck source=scripts/lib/github-repo-slug
source "${dep_script_dir}/lib/github-repo-slug"

dep_updater_minimum_release_age_minutes="$release_age_dep_updater_minutes"
readonly dep_updater_minimum_release_age_minutes
# shellcheck disable=SC1091
source "${dep_script_dir}/lib/ci-check-rollup"
# shellcheck disable=SC1091
source "${dep_script_dir}/lib/tooling-path"
tooling_path_bootstrap_node_ecosystem

# ---------------------------------------------------------------------------
# Script-level constants
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Mutable globals — set during startup; frozen to readonly after parsing
# ---------------------------------------------------------------------------

dry_run=0
cleanup_mode=0
rebase_mode=0
dir=""
ecosystem="auto"
semver_only=0
no_wait_ci=0
no_wait_merge=0
security_only=0
batch=0
batch_all=0
include_private=0
scan_roots_csv=""
dir_explicit=0
merge_timeout_min=15
merge_via=""
wt_tmpdir=""
quiet=0
report_json=0
log_tz="${TZ:-}"

# Newline-separated list of workflow names that trigger on pull_request events.
# Populated by detect_ci_workflows(); empty means "all runs" (fallback).
ci_workflow_names=""
# Newline-separated required status contexts from ci.yml (job name or display name).
ci_required_contexts=""

# Set after detect_ecosystem
has_npm=0
npm_tool=""
# When set, npm manifests live under "${dir}/${npm_project_prefix}/" (single
# nested project, e.g. web/package.json with Python at repo root).
npm_project_prefix=""
py_tool=""
has_rust=0
has_gha=0

# Set after create_worktree / init_state_file
worktree_path=""
wt_base_branch=""
state_file=""

summary_lines=""

# Set to 1 once the worktree is live so the EXIT trap knows cleanup is needed.
_cleanup_trap_active=0

# Primary clone ($dir) snapshot — create_worktree may fast-forward refs/heads/main.
_primary_snapshot_taken=0
_pri_main_sha=""
_pri_head_sha=""
_pri_head_symref=""
_pri_reset_hard=0

prompt_color=""
prompt_color_reset=""

# Cyan for our own log lines — distinguishes dep-updater output from tool stdout.
log_color=""
log_reset=""

repo_owner=""
repo_name=""

pnpm_ignored_build_pkgs=""

# Last merge-it observation from poll_until_merged (used to explain re-applies).
_merge_it_poll_pr=""
_merge_it_poll_had_label=""

# Set when CI fails and the PR is closed (batch child report enrichment).
_last_ci_failure_summary=""

# Populated before npm_outdated (format: pkg current fix cve1,cve2,...).
npm_cve_fix_audit_lines=""
# Populated before py_outdated (format: pkg current fix cve1,cve2,...).
py_cve_fix_audit_lines=""

# ---------------------------------------------------------------------------
# Utility functions
# ---------------------------------------------------------------------------

is_interactive() {
  # Returns 0 (true) if stdin is a TTY and we're not in a non-interactive flag mode
  [[ -t 0 ]] && [[ "$dry_run" == '0' ]]
}

init_prompt_style() {
  if [[ -n "${NO_COLOR:-}" ]]; then
    return 0
  fi

  local term_value
  term_value="${TERM:-}"
  if [[ "$term_value" == "dumb" || -z "$term_value" ]]; then
    return 0
  fi

  # Only check for a TTY — colour is useful in dry-run too; we just skip
  # the interactive prompt colours when stdin is not a TTY.
  if [[ ! -t 2 ]]; then
    return 0
  fi

  # Cyan log lines so our output is visually distinct from tool output.
  log_color='\033[0;36m'
  log_reset='\033[0m'

  # Blue prompt text for interactive questions — only when truly interactive.
  if is_interactive; then
    prompt_color='\033[1;34m'
    prompt_color_reset='\033[0m'
  fi
}

prompt_yes_no() {
  local -r question="$1"
  local -r default="${2:-n}"

  if ! is_interactive; then
    return 1  # Non-interactive; assume "no"
  fi

  local prompt_text="$question"
  case "$default" in
    y) prompt_text="${prompt_text} [Y/n] " ;;
    n) prompt_text="${prompt_text} [y/N] " ;;
    *) prompt_text="${prompt_text} [y/n] " ;;
  esac

  if [[ -n "$prompt_color" ]]; then
    printf '%b%s%b' "$prompt_color" "$prompt_text" "$prompt_color_reset" >&2
  else
    printf '%s' "$prompt_text" >&2
  fi
  read -r -s -n 1 response
  printf '\n' >&2

  case "$response" in
    Y|y) return 0 ;;
    N|n) return 1 ;;
    '') [[ "$default" == "y" ]] ;;
    *)   return 1 ;;
  esac
}

# Checks if the Graphite stack needs rebasing on main
# Returns 0 (true) if stack needs restack, 1 (false) if up-to-date
stack_needs_rebase() {
  local branches_csv gt_state_json
  branches_csv="$(state_get "branches")"
  [[ -z "$branches_csv" ]] && return 1

  # Strict signal: gt state JSON (stable and branch-specific).
  gt_state_json="$(run_in_worktree gt state 2>/dev/null || true)"
  if [[ -z "$gt_state_json" ]]; then
    die "Could not read Graphite state (empty output from 'gt state')."
  fi

  if ! dep_runner_jq_with_args "dep-updater gt state validate" "$gt_state_json" -e . >/dev/null 2>&1; then
    die "Could not parse Graphite state JSON from 'gt state'."
  fi

  # shellcheck disable=SC2016  # jq filter uses $csv variable, not shell expansion
  if dep_runner_jq_with_args "dep-updater gt state needs restack" "$gt_state_json" -e --arg csv "$branches_csv" '
        ($csv | split(",") | map(select(length > 0))) as $branches
        | any($branches[]; (. [.]?.needs_restack // false) == true)
      ' >/dev/null; then
    return 0
  fi
  return 1
}

log_stack_rebase_context() {
  local branches_csv current_branch gt_state_json needs_restack_lines
  branches_csv="$(state_get "branches")"
  current_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current 2>/dev/null || true)"
  gt_state_json="$(run_in_worktree gt state 2>/dev/null || true)"

  if [[ -z "$gt_state_json" ]]; then
    die "Could not read Graphite state for rebase diagnostics (empty output from 'gt state')."
  fi

  if ! dep_runner_jq_with_args "dep-updater gt state validate rebase ctx" "$gt_state_json" -e . >/dev/null 2>&1; then
    die "Could not parse Graphite state JSON for rebase diagnostics."
  fi

  # shellcheck disable=SC2016  # jq filter uses $csv variable, not shell expansion
  needs_restack_lines="$(dep_runner_jq_with_args "dep-updater gt state restack lines" "$gt_state_json" -r --arg csv "$branches_csv" '
        ($csv | split(",") | map(select(length > 0))) as $branches
        | [
            $branches[] as $b
            | select((.[ $b ]?.needs_restack // false) == true)
            | "\($b) (needs_restack=true)"
          ]
        | .[]?
      ' 2>/dev/null || true)"

  log "Stack needs rebase on main."
  log "  worktree: $worktree_path"
  if [[ -n "$current_branch" ]]; then
    log "  current branch: $current_branch"
  fi
  if [[ -n "$branches_csv" ]]; then
    log "  tracked stack branches: $branches_csv"
  fi

  if [[ -n "$needs_restack_lines" ]]; then
    log "  reason (Graphite):"
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      log "    - ${line}"
    done <<< "$needs_restack_lines"
  fi

  if [[ -n "$branches_csv" ]]; then
    local first_branch left_only right_only
    first_branch="$(cut -d',' -f1 <<< "$branches_csv")"
    if [[ -n "$first_branch" ]] \
      && run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${first_branch}" \
      && run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet "refs/remotes/origin/main"; then
      left_only="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-list --left-only --count "${first_branch}...origin/main" 2>/dev/null || echo 0)"
      right_only="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-list --right-only --count "${first_branch}...origin/main" 2>/dev/null || echo 0)"
      log "  reason (commit delta):"
      log "    - commits on stack base not on origin/main: ${left_only}"
      log "    - commits on origin/main not on stack base: ${right_only}"
      if [[ "$right_only" != '0' ]]; then
        log "    - origin/main has moved ahead of the stack base."
      fi
    fi
  fi
}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

die() {
  record_first_failure "$*"
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Tooling / prerequisite lines must reach stderr even when TIME_LOG_ENABLED=0
# (--quiet / --report-json).  Otherwise dep-updater-notifier and cron only see
# the final die() line with no missing-tool context.
# shellcheck disable=SC2317  # invoked indirectly via tooling_prereq_emit in lib/tooling-prereqs
log_prereq() {
  printf '%s\n' "$*" >&2
}

# shellcheck disable=SC1091
source "${dep_script_dir}/lib/tooling-prereqs"

wait_timeout_error() {
  # Emit a single concise line suitable for batch-all postprocessing.
  # Example: "ERROR: WAIT_TIMEOUT ci pr=#123 branch=foo waited=20m0s timeout=20m status=pending"
  record_first_failure "WAIT_TIMEOUT $*"
  log "ERROR: WAIT_TIMEOUT $*"
}

# Commit in the worktree, inheriting the signing config (gpg/ssh) from the
# source repo's effective config.  Without this, commits made in the worktree
# may be unsigned even when the user has commit.gpgsign=true in their repo or
# global git config, because git -C <worktree> can resolve the config but the
# GPG/SSH agent environment may differ from the calling shell's context.
_worktree_commit() {
  local -r msg="$1"
  local -a sign_flags=()
  local gpg_sign gpg_format sign_key
  gpg_sign="$(dep_runner_git_c_stdout "git repo" "$dir" -- config --bool commit.gpgsign 2>/dev/null || echo 'false')"
  if [[ "$gpg_sign" == 'true' ]]; then
    sign_flags+=('-c' 'commit.gpgsign=true')
    gpg_format="$(dep_runner_git_c_stdout "git repo" "$dir" -- config gpg.format 2>/dev/null || true)"
    [[ -n "$gpg_format" ]] && sign_flags+=('-c' "gpg.format=${gpg_format}")
    sign_key="$(dep_runner_git_c_stdout "git repo" "$dir" -- config commit.signingkey 2>/dev/null || true)"
    [[ -n "$sign_key" ]] && sign_flags+=('-c' "commit.signingkey=${sign_key}")
    log "[commit] GPG signing enabled (format: ${gpg_format:-default}, key: ${sign_key:-(from agent)})"
  else
    log "[commit] GPG signing disabled"
  fi
  run_command "git worktree" git -C "$worktree_path" "${sign_flags[@]}" commit -m "$msg"
}

# ---------------------------------------------------------------------------
# Exit / signal traps — clean up the worktree on unexpected death
# (Registered in main(); defined here so they can reference cleanup_on_error.)
# ---------------------------------------------------------------------------

# shellcheck disable=SC2317  # invoked via EXIT trap, not directly
_on_exit() {
  local exit_code=$?
  local first_fail_for_report reason
  first_fail_for_report=""
  # Reset the EXIT trap immediately so cleanup_on_error can't re-trigger it.
  trap - EXIT
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" && -s "${RUNNER_FIRST_FAILURE_FILE}" ]]; then
    first_fail_for_report="$(cat "${RUNNER_FIRST_FAILURE_FILE}")"
  fi
  # Write the batch-all child report before any cleanup that deletes eco-failure state.
  if [[ -n "${DEP_UPDATER_RUN_REPORT:-}" ]]; then
    dep_updater_write_batch_child_report_json "$exit_code" "$first_fail_for_report"
  fi
  rm -f "${DEP_UPDATER_ECO_FAIL_FILE:-}"
  # Only run cleanup if the worktree phase was reached and the exit is non-zero.
  if [[ "$_cleanup_trap_active" == '1' && $exit_code -ne 0 ]]; then
    # Use the first recorded failure reason if available — it contains the real
    # error (e.g. "pnpm: no matching version") rather than a generic wrapper.
    reason="script exited unexpectedly (exit code ${exit_code})"
    if [[ -n "$first_fail_for_report" ]]; then
      reason="$first_fail_for_report"
    fi
    cleanup_on_error "$reason"
  fi
  rm -f "${RUNNER_FIRST_FAILURE_FILE:-}"
}

# shellcheck disable=SC2317  # invoked via INT/TERM traps, not directly
_on_signal() {
  local sig="$1"
  # Reset all traps before re-raising so we don't loop back into this handler.
  trap - EXIT INT TERM
  if [[ "$_cleanup_trap_active" == '1' ]]; then
    log ""
    log "Interrupted (SIG${sig}) — cleaning up…"
    cleanup_on_error "interrupted by SIG${sig}"
  fi
  # Re-raise with the conventional signal exit code so the caller's $? is right.
  kill -s "$sig" "$$"
}

init_repo_api_context() {
  local remote_url
  remote_url="$(dep_runner_git_c_stdout "git repo" "$dir" -- remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote_url" ]]; then
    die "Could not resolve git remote 'origin' from: $dir"
  fi

  local slug
  slug="$(printf '%s' "$remote_url" \
    | sed -E 's#^git@github.com:##; s#^https://github.com/##; s#\.git$##')"

  if [[ "$slug" != */* ]]; then
    die "Could not parse GitHub owner/repo from origin URL: $remote_url"
  fi

  repo_owner="${slug%%/*}"
  repo_name="${slug##*/}"
}

gh_pr_number_for_branch() {
  local -r branch="$1"
  # Filter by state=open and the dep-updater label so closed/merged PRs from
  # previous runs are never confused with the current run's PR.
  dep_runner_gh_stdout "gh api" -- api "repos/${repo_owner}/${repo_name}/pulls" \
    --method GET \
    -f state=open \
    -f head="${repo_owner}:${branch}" \
    -f per_page=5 \
    --jq 'map(select(any(.labels[]; .name == "dep-updater"))) | .[0].number // empty' \
    2>/dev/null || true
}

# Used immediately after gt submit, before the dep-updater label has been applied.
# Must not filter by label — the PR was just created and has no labels yet.
gh_pr_number_for_new_branch() {
  local -r branch="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$branch" --repo "${repo_owner}/${repo_name}" \
    --json number --jq '.number' 2>/dev/null || true
}

wait_for_pr_number_for_new_branch() {
  local -r branch="$1"
  local -r timeout_sec=60
  local -r poll_sec=2
  local elapsed=0
  local pr_num=""

  while (( elapsed < timeout_sec )); do
    pr_num="$(gh_pr_number_for_new_branch "$branch")"
    if [[ -n "$pr_num" ]]; then
      printf '%s' "$pr_num"
      return 0
    fi
    sleep "$poll_sec"
    elapsed=$(( elapsed + poll_sec ))
  done

  return 1
}

gh_pr_head_ref_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$pr_number" --repo "${repo_owner}/${repo_name}" \
    --json headRefName --jq '.headRefName // empty' 2>/dev/null || true
}

gh_pr_head_sha_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh pr" -- pr view "$pr_number" --repo "${repo_owner}/${repo_name}" \
    --json headRefOid --jq '.headRefOid // empty' 2>/dev/null || true
}

gh_pr_number_resolve_for_gate() {
  local -r branch="$1"
  local pr

  pr="$(gh_pr_number_for_branch "$branch")"
  if [[ -n "$pr" ]]; then
    printf '%s' "$pr"
    return 0
  fi
  pr="$(gh_pr_number_for_new_branch "$branch")"
  if [[ -n "$pr" ]]; then
    printf '%s' "$pr"
    return 0
  fi
  return 1
}

gh_pr_state_for_number() {
  local -r pr_number="$1"
  dep_runner_gh_stdout "gh api" -- api "repos/${repo_owner}/${repo_name}/pulls/${pr_number}" \
    --jq '.state // empty' 2>/dev/null || true
}

gh_pr_merged_for_number() {
  local -r pr_number="$1"
  local raw

  raw="$(dep_runner_gh_api_jq "gh pr merged check" \
    "repos/${repo_owner}/${repo_name}/pulls/${pr_number}" '(.merged_at != null)' || true)"
  printf '%s' "${raw:-}"
}

add_merge_it_label() {
  local -r pr_number="$1"
  dep_runner_gh "gh api merge-it label" -- api "repos/${repo_owner}/${repo_name}/issues/${pr_number}/labels" \
    --method POST \
    -f labels[]=merge-it >/dev/null
  # my-tracks uses Graphite's multi-partition merge queue, which requires the
  # 'merge-mq' label (in addition to 'merge-it') to enqueue a PR.
  if [[ "$repo_name" == 'my-tracks' ]]; then
    dep_runner_gh "gh api merge-mq label" -- api "repos/${repo_owner}/${repo_name}/issues/${pr_number}/labels" \
      --method POST \
      -f labels[]=merge-mq >/dev/null 2>/dev/null || true
  fi
}

# Prints exactly one of: true, false, unknown (never guess on API failure).
pr_has_merge_it_label() {
  local -r pr_number="$1"
  local raw
  raw="$(dep_runner_gh_stdout "gh api" -- api "repos/${repo_owner}/${repo_name}/issues/${pr_number}" \
    --jq 'any(.labels[]?; .name == "merge-it")' 2>/dev/null || true)"
  case "$raw" in
    true|false) printf '%s' "$raw" ;;
    *) printf 'unknown' ;;
  esac
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'USAGE'
Usage:
  dep-updater [OPTIONS]
  dep-updater --cleanup [--dir <path>]
  dep-updater --rebase [--dir <path>]

Modes:
  (no flags)        Update: create worktree, stack PRs, wait for merge, cleanup
  --cleanup         Read saved state and clean up after stack is merged
  --dry-run         Preview exact per-PR plan and scope; no git or worktree changes
  --rebase          Rebase existing stack on top of newest main

Options:
  --all             With --batch: run batch updates for every git repo discovered
                    under the top-level scan directories (see --scan-root). Prints
                    each resolved top-level directory before running. Skips private
                    GitHub repositories unless --include-private is set. For quick runs,
                    combine with --no-wait-ci --no-wait-merge.
  --batch           Combine all updates into a single PR instead of one per package
  --dir <path>      Project root (default: current directory)
  --ecosystem <e>   Force: npm | python | rust | gha | auto  (default: auto)
  --include-private Include private GitHub repositories in --batch --all discovery
                    (default: skip private repos; explicit --dir is always processed).
                    Override via DEP_UPDATER_INCLUDE_PRIVATE=1.
  --merge-timeout <min>  Minutes to wait for all PRs to merge (default: 15)
  --merge-via <mode>  How to land PRs after CI passes: gh | merge-queue
                    (default: gh for --batch, merge-queue otherwise; override via
                    DEP_UPDATER_MERGE_VIA)
  --no-wait-ci      Skip CI polling between PRs
  --no-wait-merge   Exit after stack is submitted; print cleanup command
  --quiet           Suppress non-error log lines
  --report-json     Emit JSON scan report on stdout (implies --dry-run --quiet)
  --scan-root <path>  Parent directory whose immediate child folders are git clones
                    (--batch --all only; repeat). If omitted, defaults to $HOME/work/ai
                    or $DEP_UPDATER_BATCH_ALL_ROOTS (colon-separated; legacy:
                    $DEP_UPDATER_FAST_BATCH_ROOTS still honored when BATCH_ALL unset).
  --security-only   Only create CVE-fix PRs; skip regular version bumps
  --semver-only     npm: respect existing semver range (omit --latest)
  --tmpdir <path>   Directory under which to create the dep-updater worktree
                    (default: $TMPDIR or /tmp)
  --tz <tz>         Timezone for logs (sets $TZ). Examples: America/New_York, EST5EDT
  -h, --help        Print this help and exit

Primary clone (--dir):
  Keep the project checkout on main. Stack work (gt sync, gt checkout, gt submit)
  runs only in the dep-updater worktree under --tmpdir — not from the primary clone.
  When a run finishes, a clean primary clone is switched back to main automatically.

Supported ecosystems:
  [npm]         package.json present  → pnpm outdated + pnpm update
  [uv]          uv.lock present       → uv pip list --outdated + uv add
  [poetry]      poetry.lock present   → poetry show --outdated + poetry add
  [pipenv]      Pipfile.lock present  → pipenv run pip list + pipenv install
  [pip]         requirements.txt or pyproject.toml → pip list + pip freeze
  rust          Cargo.toml present  → cargo outdated + cargo add
  [gha]         .github/workflows/*.yml present  → gh api releases/latest + sed patch
USAGE
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        batch_all=1
        ;;
      --batch)
        batch=1
        ;;
      --cleanup)
        cleanup_mode=1
        ;;
      --dir)
        shift
        [[ $# -eq 0 ]] && die "--dir requires a path argument."
        dir_explicit=1
        dir="$1"
        ;;
      --dry-run)
        dry_run=1
        ;;
      --ecosystem)
        shift
        [[ $# -eq 0 ]] && die "--ecosystem requires a value: npm | python | rust | gha | auto"
        ecosystem="$1"
        ;;
      --include-private)
        include_private=1
        ;;
      --merge-timeout)
        shift
        [[ $# -eq 0 ]] && die "--merge-timeout requires a number of minutes."
        merge_timeout_min="$1"
        ;;
      --merge-via)
        shift
        [[ $# -eq 0 ]] && die "--merge-via requires a value: gh | merge-queue"
        merge_via="$1"
        ;;
      --no-wait-ci)
        no_wait_ci=1
        ;;
      --no-wait-merge)
        no_wait_merge=1
        ;;
      --quiet)
        quiet=1
        ;;
      --rebase)
        rebase_mode=1
        ;;
      --report-json)
        report_json=1
        dry_run=1
        quiet=1
        ;;
      --scan-root)
        shift
        [[ $# -eq 0 ]] && die "--scan-root requires a path argument."
        if [[ -z "$scan_roots_csv" ]]; then
          scan_roots_csv="$1"
        else
          scan_roots_csv="${scan_roots_csv}:$1"
        fi
        ;;
      --security-only)
        security_only=1
        ;;
      --semver-only)
        semver_only=1
        ;;
      --tmpdir)
        shift
        [[ $# -eq 0 ]] && die "--tmpdir requires a path argument."
        wt_tmpdir="$1"
        ;;
      --tz)
        shift
        [[ $# -eq 0 ]] && die "--tz requires a timezone value (e.g. America/New_York)."
        log_tz="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option: '$1'. Use -h for help."
        ;;
    esac
    shift
  done

  case "$ecosystem" in
    npm|python|rust|gha|auto) : ;;
    *) die "Invalid --ecosystem: '$ecosystem'. Valid values: npm | python | rust | gha | auto" ;;
  esac

  [[ "$batch_all" == '1' && "$batch" != '1' ]] \
    && die "--all requires --batch."

  [[ -n "$scan_roots_csv" && ( "$batch_all" != '1' || "$batch" != '1' ) ]] \
    && die "--scan-root requires --batch --all."

  if [[ "$batch_all" == '1' ]]; then
    [[ "$dir_explicit" == '1' ]] \
      && die "--batch --all cannot be combined with --dir; use --scan-root instead."
    [[ "$cleanup_mode" == '1' ]] \
      && die "--batch --all cannot be used with --cleanup."
    [[ "$rebase_mode" == '1' ]] \
      && die "--batch --all cannot be used with --rebase."
    [[ "$report_json" == '1' ]] \
      && die "--batch --all cannot be used with --report-json."
    if [[ -z "$scan_roots_csv" ]]; then
      scan_roots_csv="${DEP_UPDATER_BATCH_ALL_ROOTS:-${DEP_UPDATER_FAST_BATCH_ROOTS:-${HOME}/work/ai}}"
    fi
    dir=""
  else
    local resolved_dir
    if [[ -n "$dir" ]]; then
      resolved_dir="$(cd "$dir" && pwd)"
    else
      resolved_dir="$(dep_runner_git_stdout "git rev-parse" -- rev-parse --show-toplevel 2>/dev/null)" \
        || die "Not inside a git repository and --dir was not specified."
    fi
    dir="$resolved_dir"
  fi

  if [[ -n "$wt_tmpdir" ]]; then
    if [[ ! -d "$wt_tmpdir" ]]; then
      mkdir -p "$wt_tmpdir" \
        || die "Could not create --tmpdir directory: $wt_tmpdir"
    fi
    wt_tmpdir="$(cd "$wt_tmpdir" && pwd)"
  fi

  # Ensure logs use the user's local timezone even when TZ isn't exported (common in
  # minimal environments). `--tz` / $TZ still take precedence.
  if [[ -n "$log_tz" ]]; then
    export TZ="$log_tz"
  elif [[ -z "${TZ:-}" ]]; then
    local detected_tz
    detected_tz="$(time_log_detect_system_tz)"
    if [[ -n "$detected_tz" ]]; then
      export TZ="$detected_tz"
      log_tz="$detected_tz"
    fi
  fi

  export TIME_LOG_WARN_TZ=1
  export TIME_LOG_WARN_PREFIX="WARNING:"
  export TIME_LOG_ENABLED=1
  if [[ "$quiet" == '1' ]]; then
    export TIME_LOG_ENABLED=0
  fi
  export TIME_LOG_COLOR_START="$log_color"
  export TIME_LOG_COLOR_RESET="$log_reset"

  if [[ -z "$merge_via" && -n "${DEP_UPDATER_MERGE_VIA:-}" ]]; then
    merge_via="${DEP_UPDATER_MERGE_VIA}"
  fi
  if [[ -z "$merge_via" ]]; then
    if [[ "$batch" == '1' ]]; then
      merge_via='gh'
    else
      merge_via='merge-queue'
    fi
  fi
  case "$merge_via" in
    gh|merge-queue) ;;
    *) die "Invalid --merge-via: '${merge_via}'. Valid values: gh | merge-queue" ;;
  esac

  if [[ "${DEP_UPDATER_INCLUDE_PRIVATE:-0}" == '1' ]]; then
    include_private=1
  fi

  # shellcheck disable=SC2034  # cleanup_mode, rebase_mode, merge_timeout_min used in main() dispatch
  readonly dry_run cleanup_mode rebase_mode dir ecosystem semver_only no_wait_ci no_wait_merge security_only batch batch_all include_private merge_timeout_min merge_via wt_tmpdir quiet report_json scan_roots_csv log_tz
}

# ---------------------------------------------------------------------------
# Prerequisite checks — Phase 1: core tools (always required)
# ---------------------------------------------------------------------------

check_core_prereqs() {
  local missing=0

  tooling_prereq_check_tools "[tooling]" git gt gh jq rg || missing=$?

  if (( missing > 0 )); then
    die "Install the missing tool(s) above and retry."
  fi
}

# Detect pnpm's "ignored builds" safety gate in output.
pnpm_output_has_ignored_builds() {
  local -r output_file="$1"
  local p_pm_tool p_approve ignored_builds_pat
  p_pm_tool='pnpm'
  p_approve='approve-builds'
  ignored_builds_pat="ERR_PNPM_IGNORED_BUILDS|${p_pm_tool} ${p_approve}|${p_approve}"
  [[ -f "$output_file" ]] || return 1
  dep_runner_rg "pnpm ignored builds marker" -- --quiet \
    "$ignored_builds_pat" "$output_file"
}

pnpm_record_ignored_build_pkgs() {
  local -r output_file="$1"
  [[ -f "$output_file" ]] || return 0

  # Example:
  #   [ERR_PNPM_IGNORED_BUILDS] Ignored build scripts: esbuild@0.27.7, esbuild@0.28.0
  local ignored_line
  ignored_line="$(dep_runner_sh_stdout "rg ignored builds line" -- \
    "rg -m 1 -o 'Ignored build scripts:.*' $(printf '%q' "$output_file") 2>/dev/null || true")"
  [[ -z "$ignored_line" ]] && return 0
  ignored_line="${ignored_line#Ignored build scripts: }"

  local pkg_item pkg_name
  while IFS= read -r pkg_item; do
    pkg_item="$(printf '%s' "$pkg_item" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -z "$pkg_item" ]] && continue
    pkg_name="${pkg_item%%@*}"
    [[ -z "$pkg_name" ]] && continue
    if [[ -z "$pnpm_ignored_build_pkgs" ]]; then
      pnpm_ignored_build_pkgs="$pkg_name"
    else
      local list_tmp
      list_tmp="$(mktemp)"
      printf '%s\n' "$pnpm_ignored_build_pkgs" >"$list_tmp"
      if dep_runner_rg "pnpm ignored pkg dedupe" -- -qxF "$pkg_name" "$list_tmp"; then
        :
      else
        pnpm_ignored_build_pkgs="${pnpm_ignored_build_pkgs}
${pkg_name}"
      fi
      rm -f "$list_tmp"
    fi
  done < <(tr ',' '\n' <<<"$ignored_line")
}

pnpm_pkg_is_ignored_build() {
  local -r pkg="$1"
  local list_tmp rc
  [[ -z "$pnpm_ignored_build_pkgs" ]] && return 1
  list_tmp="$(mktemp)"
  printf '%s\n' "$pnpm_ignored_build_pkgs" >"$list_tmp"
  dep_runner_rg "pnpm ignored pkg lookup" -- -qxF "$pkg" "$list_tmp"
  rc=$?
  rm -f "$list_tmp"
  return "$rc"
}

# npm_version_prefetch <pkg> <version>
# Confirms an exact package version is actually published in the registry by
# querying the registry HTTP API directly (no pnpm metadata cache), then
# pre-populating the pnpm content-addressable store.
# Retries up to 3 times with 15 s backoff.
# Returns 0 when the version is confirmed available and prefetched.
# Returns 1 when it cannot be confirmed after all retries (caller should skip).
npm_version_prefetch() {
  local -r pkg="$1"
  local -r version="$2"
  local attempt registry http_status encoded_pkg store_exit

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"

  for attempt in 1 2 3; do
    http_status="$(dep_runner_curl_http_code \
      "npm registry version check ${pkg}@${version}" \
      "${registry}${encoded_pkg}/${version}")"
    if [[ "$http_status" == "200" ]]; then
      store_exit=0
      runner_exec "pnpm store add ${pkg}@${version}" -- pnpm store add "${pkg}@${version}" \
        >/dev/null || store_exit=$?
      if (( store_exit == 0 )); then
        return 0
      fi
    fi
    if [[ "$attempt" -lt 3 ]]; then
      log "[pnpm] WARNING: ${pkg}@${version} not yet available in registry (HTTP ${http_status}); attempt ${attempt}/2, retrying in 15s…"
      sleep 15
    fi
  done

  log "[pnpm] WARNING: ${pkg}@${version} could not be confirmed in registry after 3 attempts; skipping."
  return 1
}

# npm_registry_dist_tag_latest <pkg>
# Prints dist-tags.latest from the npm packument (HTTPS), using the same registry
# base URL as npm_version_prefetch. Prefer this over `pnpm view`, which can
# return stale cached metadata that disagrees with install-time resolution.
# Returns 1 when latest is missing or the packument cannot be fetched.
npm_registry_dist_tag_latest() {
  local -r pkg="$1"
  local registry encoded_pkg body latest

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  body=""
  body="$(dep_runner_curl_body "npm packument ${pkg}" "${registry}${encoded_pkg}" || true)"
  latest=""
  latest="$(dep_runner_jq_string "npm dist-tags.latest ${pkg}" "$body" '.["dist-tags"].latest // empty' \
    || true)"
  if [[ -z "$latest" || "$latest" == 'null' ]]; then
    return 1
  fi
  printf '%s' "$latest"
  return 0
}

# npm_parse_iso8601_to_epoch <iso8601>
# Prints Unix epoch seconds for a registry "time" field, or empty on failure.
npm_parse_iso8601_to_epoch() {
  time_log_iso8601_utc_to_epoch "$1"
}

# _npm_version_is_stable_release <version>
# Returns 0 for release versions without a prerelease suffix (no '-' in the version).
_npm_version_is_stable_release() {
  local -r version="$1"
  [[ "$version" != *-* ]]
}

# _npm_registry_stable_versions_desc <pkg>
# Prints stable published versions newest-first from the npm packument.
_npm_registry_stable_versions_desc() {
  local -r pkg="$1"
  local registry encoded_pkg body

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  body="$(dep_runner_curl_body "npm packument ${pkg}" "${registry}${encoded_pkg}" || true)"
  if [[ -z "$body" ]]; then
    return 1
  fi
  dep_runner_jq_string "npm stable versions ${pkg}" "$body" '.versions | keys[]' 2>/dev/null \
    | while IFS= read -r ver; do
        [[ -z "$ver" ]] && continue
        if _npm_version_is_stable_release "$ver"; then
          printf '%s\n' "$ver"
        fi
      done \
    | sort -V -r
}

# npm_pick_eligible_new_version <pkg> <current> [scan_root]
# Prints the newest registry version newer than current that passes release-age and
# closure checks. When dist-tags.latest is too new, walks back to the newest
# eligible stable version (same behaviour as Dependabot cooldown + _gha_pick_eligible_new_ref).
npm_pick_eligible_new_version() {
  local -r pkg="$1"
  local -r current="$2"
  local -r scan_root="${3:-$dir}"
  local ver latest_tag picked

  # Integration tests stub pnpm only (DEP_UPDATER_SKIP_NPM_REGISTRY=1): walk the
  # registry packument is unavailable, so use pnpm view like the pre-walk path.
  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    latest_tag="$(dep_runner_pnpm_view_version "pnpm view ${pkg}" "$pkg" "$scan_root" || true)"
    if [[ -z "$latest_tag" || "$latest_tag" == "$current" ]]; then
      return 1
    fi
    if [[ "$(printf '%s\n%s\n' "$current" "$latest_tag" | sort -V | tail -1)" != "$latest_tag" ]]; then
      return 1
    fi
    if npm_version_meets_minimum_release_age "$pkg" "$latest_tag" "$scan_root" \
      && npm_version_prefetch "$pkg" "$latest_tag"; then
      printf '%s' "$latest_tag"
      return 0
    fi
    return 1
  fi

  latest_tag="$(npm_registry_dist_tag_latest "$pkg" 2>/dev/null || true)"
  picked=""
  while IFS= read -r ver; do
    [[ -z "$ver" ]] && continue
    if [[ "$ver" == "$current" ]]; then
      continue
    fi
    if [[ "$(printf '%s\n%s\n' "$current" "$ver" | sort -V | tail -1)" != "$ver" ]]; then
      continue
    fi
    # Age-gate the candidate and confirm the top-level tarball exists. Exact-semver
    # sibling closure is deferred to npm_pnpm_filter_outdated_lines (lockfile dry-run),
    # which matches Dependabot and avoids false negatives on monorepo publishes.
    if npm_version_meets_minimum_release_age "$pkg" "$ver" "$scan_root" \
      && npm_version_prefetch "$pkg" "$ver"; then
      picked="$ver"
      break
    fi
    if [[ "$(printf '%s\n%s\n' "$ver" "$current" | sort -V | tail -1)" == "$current" && "$ver" != "$current" ]]; then
      break
    fi
  done < <(_npm_registry_stable_versions_desc "$pkg")

  if [[ -z "$picked" ]]; then
    return 1
  fi
  if [[ -n "$latest_tag" && "$picked" != "$latest_tag" ]]; then
    log "[pnpm] ${pkg}: proposing ${picked} (newest eligible; dist-tags.latest ${latest_tag} is too new)."
  fi
  printf '%s' "$picked"
  return 0
}

# npm_minimum_release_age_minutes [scan_root]
# Effective minimumReleaseAge for bump proposals: max(project pnpm config, dep-updater floor).
npm_minimum_release_age_minutes() {
  local -r scan_root="${1:-$dir}"
  local cfg project_minutes

  project_minutes=0
  if [[ -n "$scan_root" ]] && [[ -d "$scan_root" ]]; then
    cfg="$(pnpm_in_project "$scan_root" config get minimumReleaseAge 2>/dev/null \
      | tr -d '[:space:]' || true)"
    if [[ -n "$cfg" && "$cfg" != 'undefined' && "$cfg" =~ ^[0-9]+$ ]]; then
      project_minutes="$cfg"
    fi
  fi
  if (( project_minutes > dep_updater_minimum_release_age_minutes )); then
    printf '%s' "$project_minutes"
  else
    printf '%s' "$dep_updater_minimum_release_age_minutes"
  fi
}

# npm_registry_version_published_epoch <pkg> <version>
# Prints publish-time epoch from the packument, or empty when unknown.
npm_registry_version_published_epoch() {
  local -r pkg="$1"
  local -r version="$2"
  local registry encoded_pkg body published_iso published_epoch

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  body="$(dep_runner_curl_body "npm packument ${pkg}" "${registry}${encoded_pkg}" || true)"
  published_iso="$(dep_runner_jq_string "npm publish time ${pkg}@${version}" "$body" \
    ".time[\"${version}\"] // empty" || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

# npm_pkg_has_cve_fix_in_audit <pkg>
# True when npm audit reported CVEs with an available fix for this package.
npm_pkg_has_cve_fix_in_audit() {
  local -r pkg="$1"
  local ap _ac _af cves

  [[ -z "$npm_cve_fix_audit_lines" ]] && return 1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    read -r ap _ac _af cves <<< "$line"
    [[ -z "$ap" ]] && continue
    if [[ "${ap,,}" == "${pkg,,}" && -n "$cves" ]]; then
      return 0
    fi
  done <<< "$npm_cve_fix_audit_lines"
  return 1
}

# npm_version_meets_minimum_release_age <pkg> <version> [scan_root]
# Returns 0 when the version is old enough to install under minimumReleaseAge policy.
# When publish time is unknown, allow (matches pnpm minimumReleaseAgeIgnoreMissingTime).
# CVE-marked packages (npm audit with fix + CVE ids) bypass the age gate in dep-updater.
npm_version_meets_minimum_release_age() {
  local -r pkg="$1"
  local -r version="$2"
  local -r scan_root="${3:-$dir}"
  local min_minutes published_epoch now_epoch age_minutes

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  if npm_pkg_has_cve_fix_in_audit "$pkg"; then
    return 0
  fi

  min_minutes="$(npm_minimum_release_age_minutes "$scan_root")"
  published_epoch="$(npm_registry_version_published_epoch "$pkg" "$version" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 0
  fi
  now_epoch="$(time_log_now_utc_epoch)"
  age_minutes=$(( (now_epoch - published_epoch) / 60 ))
  if (( age_minutes < min_minutes )); then
    log "[pnpm] Skipping ${pkg}@${version}: published ${age_minutes}m ago; minimumReleaseAge is ${min_minutes}m."
    return 1
  fi
  return 0
}

# pypi_version_published_epoch <pkg> <version>
# Prints publish-time epoch from PyPI, or empty when unknown.
pypi_version_published_epoch() {
  local -r pkg="$1"
  local -r version="$2"
  local encoded_pkg body published_iso published_epoch

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  encoded_pkg="${pkg//+/%2B}"
  body="$(dep_runner_curl_body "pypi version json ${pkg}@${version}" \
    "https://pypi.org/pypi/${encoded_pkg}/${version}/json" || true)"
  published_iso="$(dep_runner_jq_string "pypi upload time ${pkg}@${version}" "$body" \
    '.urls[0].upload_time // empty' || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

# py_pkg_has_cve_fix_in_audit <pkg>
# True when pip-audit reported CVEs with an available fix for this package.
py_pkg_has_cve_fix_in_audit() {
  local -r pkg="$1"
  local ap _ac _af cves

  [[ -z "$py_cve_fix_audit_lines" ]] && return 1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    read -r ap _ac _af cves <<< "$line"
    [[ -z "$ap" ]] && continue
    if [[ "${ap,,}" == "${pkg,,}" && -n "$cves" ]]; then
      return 0
    fi
  done <<< "$py_cve_fix_audit_lines"
  return 1
}

# py_version_meets_minimum_release_age <pkg> <version>
# Returns 0 when the version is old enough under dep-updater release-age policy.
# When publish time is unknown, allow. CVE-marked packages bypass the age gate.
py_version_meets_minimum_release_age() {
  local -r pkg="$1"
  local -r version="$2"
  local published_epoch now_epoch age_minutes

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  if py_pkg_has_cve_fix_in_audit "$pkg"; then
    return 0
  fi

  published_epoch="$(pypi_version_published_epoch "$pkg" "$version" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 0
  fi
  now_epoch="$(time_log_now_utc_epoch)"
  age_minutes=$(( (now_epoch - published_epoch) / 60 ))
  if (( age_minutes < dep_updater_minimum_release_age_minutes )); then
    log "[python] Skipping ${pkg}==${version}: published ${age_minutes}m ago; minimum release age is ${dep_updater_minimum_release_age_minutes}m."
    return 1
  fi
  return 0
}

# gha_release_published_epoch <action> <ref>
# Prints publish-time epoch for a GitHub Actions release tag, or empty when unknown.
gha_release_published_epoch() {
  local -r action="$1"
  local -r ref="$2"
  local published_iso published_epoch commit_sha

  if [[ "${DEP_UPDATER_SKIP_GHA_REGISTRY:-0}" == '1' ]]; then
    return 1
  fi

  published_iso="$(dep_runner_gh_api_jq "gha release time ${action}@${ref}" \
    "repos/${action}/releases/tags/${ref}" '.published_at // empty' || true)"
  if [[ -n "$published_iso" && "$published_iso" != 'null' ]]; then
    published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
    if [[ -n "$published_epoch" ]]; then
      printf '%s' "$published_epoch"
      return 0
    fi
  fi

  commit_sha="$(dep_runner_gh_api_jq "gha tag ref ${action}@${ref}" \
    "repos/${action}/git/ref/tags/${ref}" '.object.sha // empty' || true)"
  if [[ -z "$commit_sha" || "$commit_sha" == 'null' ]]; then
    return 1
  fi
  published_iso="$(dep_runner_gh_api_jq "gha commit time ${action}@${commit_sha}" \
    "repos/${action}/git/commits/${commit_sha}" '.committer.date // .author.date // empty' || true)"
  if [[ -z "$published_iso" || "$published_iso" == 'null' ]]; then
    return 1
  fi
  published_epoch="$(npm_parse_iso8601_to_epoch "$published_iso" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 1
  fi
  printf '%s' "$published_epoch"
  return 0
}

# gha_version_meets_minimum_release_age <action> <ref>
# Returns 0 when the action release is old enough under dep-updater release-age policy.
gha_version_meets_minimum_release_age() {
  local -r action="$1"
  local -r ref="$2"
  local published_epoch now_epoch age_minutes

  if [[ "${DEP_UPDATER_SKIP_GHA_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  published_epoch="$(gha_release_published_epoch "$action" "$ref" 2>/dev/null || true)"
  if [[ -z "$published_epoch" ]]; then
    return 0
  fi
  now_epoch="$(time_log_now_utc_epoch)"
  age_minutes=$(( (now_epoch - published_epoch) / 60 ))
  if (( age_minutes < dep_updater_minimum_release_age_minutes )); then
    log "[github-actions] Skipping ${action}@${ref}: published ${age_minutes}m ago; minimum release age is ${dep_updater_minimum_release_age_minutes}m."
    return 1
  fi
  return 0
}

# npm_registry_fetch_version_json <pkg> <version>
# Prints the version document from the registry (empty on failure).
npm_registry_fetch_version_json() {
  local -r pkg="$1"
  local -r version="$2"
  local registry encoded_pkg

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  registry="$(dep_updater_npm_registry_base)"
  encoded_pkg="$(dep_updater_npm_encode_pkg "$pkg")"
  dep_runner_curl_body "npm version manifest ${pkg}@${version}" \
    "${registry}${encoded_pkg}/${version}" || true
}

# npm_version_prefetch_closure <pkg> <version> [scan_root]
# Like npm_version_prefetch, but also requires exact-semver dependencies and peers
# from the version manifest to be published (catches partial monorepo publishes).
npm_version_prefetch_closure() {
  local -r pkg="$1"
  local -r version="$2"
  local -r scan_root="${3:-$dir}"
  local manifest dep depver

  if ! npm_version_meets_minimum_release_age "$pkg" "$version" "$scan_root"; then
    return 1
  fi

  if ! npm_version_prefetch "$pkg" "$version"; then
    return 1
  fi

  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    return 0
  fi

  manifest="$(npm_registry_fetch_version_json "$pkg" "$version")"
  if [[ -z "$manifest" ]]; then
    return 0
  fi

  while IFS= read -r dep depver; do
    [[ -z "$dep" ]] && continue
    if ! npm_version_meets_minimum_release_age "$dep" "$depver" "$scan_root"; then
      log "[pnpm] Filtering ${pkg} → ${version}: dependency ${dep}@${depver} is below minimumReleaseAge."
      return 1
    fi
    if ! npm_version_prefetch "$dep" "$depver"; then
      log "[pnpm] Filtering ${pkg} → ${version}: dependency ${dep}@${depver} is not published."
      return 1
    fi
  done < <(dep_runner_jq_string "npm manifest deps ${pkg}@${version}" "$manifest" '
    (.dependencies // {}), (.peerDependencies // {})
    | to_entries[]
    | select(.value | test("^[0-9]"))
    | "\(.key) \(.value)"
  ' 2>/dev/null || true)

  return 0
}

# npm_pnpm_parse_blame_direct_dep <logfile>
# Prints the direct dependency whose install pulled in a missing version (empty if unknown).
npm_pnpm_parse_blame_direct_dep() {
  local -r log_file="$1"
  local line blame

  line="$(grep -E 'installing the dependencies of ' "$log_file" 2>/dev/null | head -n 1 || true)"
  if [[ -z "$line" ]]; then
    return 1
  fi
  blame="$(printf '%s' "$line" | sed -n 's/.*installing the dependencies of \([^ ]*\)@.*/\1/p')"
  if [[ -z "$blame" ]]; then
    return 1
  fi
  printf '%s' "$blame"
  return 0
}

# npm_pnpm_try_lockfile_with_updates <scan_root> <updates_json> <logfile>
# Patches package.json, runs pnpm install --lockfile-only, restores originals.
# Returns 0 when the lockfile resolves.
npm_pnpm_try_lockfile_with_updates() {
  local -r scan_root="$1"
  local -r updates_json="$2"
  local -r log_file="$3"
  local pkg_json lockfile bak_pkg bak_lock tmp_pkg

  if [[ "$updates_json" == '{}' ]]; then
    return 0
  fi

  pkg_json="${scan_root}/package.json"
  lockfile="${scan_root}/pnpm-lock.yaml"
  if [[ ! -f "$pkg_json" ]]; then
    return 1
  fi

  bak_pkg="$(mktemp)"
  cp "$pkg_json" "$bak_pkg"
  bak_lock=""
  if [[ -f "$lockfile" ]]; then
    bak_lock="$(mktemp)"
    cp "$lockfile" "$bak_lock"
  fi

  tmp_pkg="$(mktemp)"
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
  if ! dep_runner_jq_file_args "jq patch package.json prefetch" "$pkg_json" --argjson updates "$updates_json" '
    to_entries | map(
      if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
         and (.value != null) then
        .value |= with_entries(
          (.key) as $k |
          if $updates | has($k) then .value = $updates[$k] else . end
        )
      else . end
    ) | from_entries
  ' >"$tmp_pkg"; then
    cp "$bak_pkg" "$pkg_json"
    rm -f "$bak_pkg" "$tmp_pkg" "$bak_lock"
    return 1
  fi
  mv "$tmp_pkg" "$pkg_json"

  local rc
  set +e
  pnpm_in_project "$scan_root" install --lockfile-only --no-frozen-lockfile >"$log_file" 2>&1
  rc=$?
  set -e

  cp "$bak_pkg" "$pkg_json"
  rm -f "$bak_pkg"
  if [[ -n "$bak_lock" ]]; then
    cp "$bak_lock" "$lockfile"
    rm -f "$bak_lock"
  fi

  return "$rc"
}

# npm_lines_to_updates_json <line>...
# Builds a JSON object { "pkg": "version", ... } from "pkg current latest" lines.
npm_lines_to_updates_json() {
  local line pkg _cur latest updates='{}'
  for line in "$@"; do
    [[ -z "$line" ]] && continue
    read -r pkg _cur latest <<<"$line"
    [[ -z "$pkg" || -z "$latest" ]] && continue
    # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
    updates="$(dep_runner_jq_with_args "npm lines to updates json" "$updates" \
      --arg k "$pkg" --arg v "$latest" '. + {($k): $v}')"
  done
  printf '%s' "$updates"
}

# npm_pnpm_filter_outdated_lines <scan_root> <line>...
# Drops proposed updates that cannot be resolved together (batch lockfile dry-run).
npm_pnpm_filter_outdated_lines() {
  local -r scan_root="$1"
  shift
  local -a pending_outdated=("$@")
  local -a next_outdated filtered_lines
  local log_file updates_json all_lines blame_pkg removed_ver gk
  local line pkg _cur lat

  if [[ ${#pending_outdated[@]} -eq 0 ]]; then
    return 0
  fi

  # Integration tests stub the registry; lockfile dry-run needs a real resolution graph.
  if [[ "${DEP_UPDATER_SKIP_NPM_REGISTRY:-0}" == '1' ]]; then
    printf '%s\n' "${pending_outdated[@]}"
    return 0
  fi

  log_file="$(mktemp)"
  all_lines="$(printf '%s\n' "${pending_outdated[@]}")"

  while [[ ${#pending_outdated[@]} -gt 0 ]]; do
    updates_json="$(npm_lines_to_updates_json "${pending_outdated[@]}")"
    if npm_pnpm_try_lockfile_with_updates "$scan_root" "$updates_json" "$log_file"; then
      filtered_lines=("${pending_outdated[@]}")
      rm -f "$log_file"
      printf '%s\n' "${filtered_lines[@]}"
      return 0
    fi

    if ! grep -qF 'ERR_PNPM_NO_MATCHING_VERSION' "$log_file"; then
      log "[pnpm] WARNING: could not verify proposed updates against lockfile; skipping npm updates for this scan."
      rm -f "$log_file"
      return 0
    fi

    blame_pkg="$(npm_pnpm_parse_blame_direct_dep "$log_file" 2>/dev/null || true)"
    if [[ -z "$blame_pkg" ]]; then
      log "[pnpm] WARNING: lockfile verification failed (unparsed ERR_PNPM_NO_MATCHING_VERSION); skipping npm updates."
      rm -f "$log_file"
      return 0
    fi

    next_outdated=()
    removed_ver=""
    for line in "${pending_outdated[@]}"; do
      read -r pkg _cur lat <<<"$line"
      if [[ "$pkg" == "$blame_pkg" ]]; then
        removed_ver="$lat"
        log "[pnpm] Filtering ${pkg} → ${lat}: install resolution failed (missing transitive version)."
        continue
      fi
      next_outdated+=("$line")
    done

    if [[ -n "$removed_ver" ]]; then
      gk="$(npm_group_key "$blame_pkg" "$all_lines")"
      pending_outdated=()
      for line in "${next_outdated[@]}"; do
        read -r pkg _cur lat <<<"$line"
        if [[ "$(npm_group_key "$pkg" "$all_lines")" == "$gk" && "$lat" == "$removed_ver" ]]; then
          log "[pnpm] Filtering ${pkg} → ${lat}: same update group as ${blame_pkg} (unresolvable together)."
          continue
        fi
        pending_outdated+=("$line")
      done
    else
      pending_outdated=("${next_outdated[@]}")
    fi

    if [[ ${#pending_outdated[@]} -eq 0 ]]; then
      rm -f "$log_file"
      return 0
    fi
  done

  rm -f "$log_file"
  return 0
}

# Optional: DEP_UPDATER_ECO_FAIL_FILE is a temp file listing non-fatal ecosystem
# errors (one line each) so the run can continue and still exit non-zero.
dep_updater_append_ecosystem_failure() {
  if [[ -n "${DEP_UPDATER_ECO_FAIL_FILE:-}" ]]; then
    printf '%s\n' "$*" >> "${DEP_UPDATER_ECO_FAIL_FILE}"
  fi
}

dep_updater_ecosystem_failures_present() {
  [[ -n "${DEP_UPDATER_ECO_FAIL_FILE:-}" && -s "${DEP_UPDATER_ECO_FAIL_FILE}" ]]
}

dep_updater_print_ecosystem_failure_banner() {
  if ! dep_updater_ecosystem_failures_present; then
    return 0
  fi
  log ""
  log "[ecosystem-failures] One or more ecosystem update steps failed (other work continued):"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    log "  - ${line}"
  done < "${DEP_UPDATER_ECO_FAIL_FILE}"
}

dep_updater_ensure_eco_fail_file() {
  if [[ -z "${DEP_UPDATER_ECO_FAIL_FILE:-}" ]]; then
    DEP_UPDATER_ECO_FAIL_FILE="$(mktemp)"
    export DEP_UPDATER_ECO_FAIL_FILE
  fi
}

# When the parent sets DEP_UPDATER_RUN_REPORT to a temp path (batch-all child
# invocations only), write one JSON object the parent reads with jq — no log
# scraping. Keys: exit_code, dir, primary, details (array of strings).
# shellcheck disable=SC2317  # invoked indirectly from _on_exit
dep_updater_handle_ci_failure() {
  local -r pr_num="$1"
  local -r branch="${2:-}"
  local summary comment

  summary="$(ci_failure_summary_for_pr "$pr_num" "${repo_owner}/${repo_name}" "$branch")"
  _last_ci_failure_summary="$summary"

  log "PR #${pr_num} failed CI: ${summary}"
  comment="Closed by dep-updater: CI failed (${summary}). Re-run to create a fresh update."
  dep_runner_gh_stdout "gh pr" -- pr close "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --comment "$comment" \
    2>/dev/null || true

  record_first_failure "CI failed: pr=#${pr_num} ${summary}"
  die "CI failed: pr=#${pr_num} ${summary}. PR closed; re-run to create a fresh update."
}

dep_updater_write_batch_child_report_json() {
  local -r exit_code="${1:?}"
  local -r first_failure="${2:-}"
  local out_file primary details_json ci_failure_json capture_stderr capture_stdout

  out_file="${DEP_UPDATER_RUN_REPORT:?}"
  primary="$first_failure"
  details_json='[]'
  ci_failure_json='null'
  capture_stderr=""
  capture_stdout=""

  if [[ -n "${RUNNER_SESSION_DIR:-}" ]] \
    && declare -F runner_last_failure_capture_stderr >/dev/null 2>&1; then
    capture_stderr="$(runner_last_failure_capture_stderr 40)"
    capture_stdout="$(runner_last_failure_capture_stdout 40)"
  fi

  if [[ -n "${DEP_UPDATER_ECO_FAIL_FILE:-}" && -s "${DEP_UPDATER_ECO_FAIL_FILE}" ]]; then
    details_json="$(dep_runner_jq_file_args "dep-updater batch child report details" \
      "${DEP_UPDATER_ECO_FAIL_FILE}" -Rs 'split("\n") | map(select(length > 0))' 2>/dev/null || true)"
    [[ -z "$details_json" ]] && details_json='[]'
    if [[ -z "$primary" ]]; then
      primary="$(head -n 1 "${DEP_UPDATER_ECO_FAIL_FILE}" 2>/dev/null || true)"
    fi
  fi

  if [[ -z "$primary" ]]; then
    primary="dep-updater exited with code ${exit_code}"
  elif [[ "$primary" == "dep-updater exited with code ${exit_code}" ]] \
    && [[ "$details_json" != '[]' ]]; then
    primary="$(dep_runner_jq_with_args "dep-updater batch child report primary" "$details_json" -r '.[0] // empty' 2>/dev/null || true)"
    [[ -z "$primary" ]] && primary="dep-updater exited with code ${exit_code}"
  fi

  if [[ -n "${_last_ci_failure_summary:-}" ]]; then
    # shellcheck disable=SC2016  # jq -n filter uses $s variable, not shell expansion
    ci_failure_json="$(dep_runner_jq_n "dep-updater batch child ci failure" --arg s "$_last_ci_failure_summary" '$s')"
  fi

  # shellcheck disable=SC2016  # jq -n object template uses jq variables, not shell expansion
  if ! dep_runner_jq_n "dep-updater batch child report emit" \
    --argjson exit_code "$exit_code" \
    --arg dir "$dir" \
    --arg primary "$primary" \
    --argjson details "${details_json}" \
    --argjson ci_failure "${ci_failure_json}" \
    --arg capture_stderr "$capture_stderr" \
    --arg capture_stdout "$capture_stdout" \
    '{exit_code: $exit_code, dir: $dir, primary: $primary, details: $details, ci_failure: $ci_failure, capture_stderr: $capture_stderr, capture_stdout: $capture_stdout}' \
    >"$out_file" 2>/dev/null; then
    # shellcheck disable=SC2016  # jq -n fallback object uses jq variables, not shell expansion
    dep_runner_jq_n "dep-updater batch child report emit fallback" \
      --argjson exit_code "$exit_code" --arg primary "$primary" \
      --argjson ci_failure "${ci_failure_json}" \
      --arg capture_stderr "$capture_stderr" \
      --arg capture_stdout "$capture_stdout" \
      '{exit_code: $exit_code, dir: "", primary: $primary, details: [], ci_failure: $ci_failure, capture_stderr: $capture_stderr, capture_stdout: $capture_stdout}' \
      >"$out_file" 2>/dev/null || true
  fi
}

# When batch-all sets DEP_UPDATER_RUN_REPORT, emit structured failure JSON before
# cleanup() removes DEP_UPDATER_ECO_FAIL_FILE (success-path exits use this).
dep_updater_emit_batch_child_report() {
  local -r exit_code="${1:?}"
  local first_fail=""

  if [[ -z "${DEP_UPDATER_RUN_REPORT:-}" ]]; then
    return 0
  fi
  if [[ -n "${RUNNER_FIRST_FAILURE_FILE:-}" && -s "${RUNNER_FIRST_FAILURE_FILE}" ]]; then
    first_fail="$(cat "${RUNNER_FIRST_FAILURE_FILE}")"
  fi
  dep_updater_write_batch_child_report_json "$exit_code" "$first_fail"
}

# dep_updater_runner_realpath <path>
# realpath via runner when available; falls back to bare realpath.
dep_updater_runner_realpath() {
  local -r path="$1"
  local result exit_code

  if declare -F runner_exec_stdout >/dev/null 2>&1; then
    exit_code=0
    result="$(runner_exec_stdout "realpath" -- realpath "$path")" || exit_code=$?
    if [[ "$exit_code" -eq 0 && -n "$result" ]]; then
      printf '%s\n' "$result"
      return 0
    fi
    return 1
  fi
  return 1
}

# dep_runner_git_rev_parse <label> <git-dir> <ref>
# Prints the resolved object name on success; returns non-zero when git fails.
dep_runner_git_rev_parse() {
  local -r label="$1"
  local -r git_dir="$2"
  local -r ref="$3"
  local exit_code uuid out

  exit_code=0
  runner_exec "$label" -- git -C "$git_dir" rev-parse "$ref" 2>/dev/null || exit_code=$?
  if (( exit_code != 0 )); then
    return "$exit_code"
  fi
  uuid="$(runner_last_id)"
  out="$(runner_read "$uuid" stdout 2>/dev/null || true)"
  printf '%s' "$out"
  return 0
}

# dep_runner_git_c_stdout <label> <git-dir> -- <git-args…>
dep_runner_git_c_stdout() {
  local -r label="$1"
  local -r git_dir="$2"
  shift 2
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local exit_code out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- git -C "$git_dir" "$@")" || exit_code=$?
  printf '%s' "$out"
  return "$exit_code"
}

