# dep_runner_uv_dir <label> [--probe] <dir> -- <uv-args…>
# Also accepts --probe before <label> (dry-run probe call sites).
dep_runner_uv_dir() {
  local probe=0 label uv_dir cmd_quoted exit_code

  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  label="$1"
  shift
  if [[ "${1:-}" == '--probe' ]]; then
    probe=1
    shift
  fi
  uv_dir="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift

  cmd_quoted="$(runner_quote_cmdline uv "$@")"
  exit_code=0
  if (( probe )); then
    runner_sh "$label" --probe -- "cd $(printf '%q' "$uv_dir") && ${cmd_quoted}" || exit_code=$?
  else
    runner_sh "$label" -- "cd $(printf '%q' "$uv_dir") && ${cmd_quoted}" || exit_code=$?
  fi
  return "$exit_code"
}

