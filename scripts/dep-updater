# install_with_net_retry <label> <workdir> <cmd> [args…]
# Runs <cmd> in <workdir> up to 4 times (30 / 60 / 90 s linear backoff) when
# the output suggests a transient network error.  On success or a non-transient
# failure, returns immediately.  Captures all output; prints the tail on error.
install_with_net_retry() {
  local -r label="$1"
  local -r workdir="$2"
  shift 2

  local attempt delay exit_code uuid cmd_quoted install_log

  cmd_quoted="$(runner_quote_cmdline "$@")"

  for attempt in 1 2 3 4; do
    exit_code=0
    runner_sh "${label} attempt ${attempt}" \
      "cd $(printf '%q' "$workdir") && ${cmd_quoted}" || exit_code=$?

    if (( exit_code == 0 )); then
      return 0
    fi

    uuid="$(runner_last_id)"
    install_log=""
    if [[ -n "$uuid" ]]; then
      install_log="$(mktemp)"
      runner_read "$uuid" stderr >"$install_log" 2>/dev/null || true
    fi

    if [[ -n "$install_log" && -s "$install_log" ]] \
      && grep -qiE \
         'ECONNRESET|ETIMEDOUT|ENOTFOUND|network error|fetch failed|connection reset|connection refused|Read timed out|ConnectTimeout|connection error' \
         "$install_log" \
       && [[ "$attempt" -lt 4 ]]; then
      delay=$(( attempt * 30 ))
      log "[${label}] WARNING: transient network error; attempt ${attempt}/3, retrying in ${delay}s…"
      rm -f "$install_log"
      sleep "$delay"
      continue
    fi

    break
  done

  printf '%s\n' "${label} install failed (exit ${exit_code}). Last output:" >&2
  if [[ -n "$install_log" && -s "$install_log" ]]; then
    tail -n 80 "$install_log" | sed 's/^/  /' >&2
  elif [[ -n "$uuid" ]]; then
    runner_format_failure "$uuid" >&2
  fi
  record_first_failure "${label} install failed (exit ${exit_code})"
  rm -f "${install_log:-}"
  return "$exit_code"
}

pnpm_install_worktree() {
  local -r mode="$1" # frozen | no-frozen
  local -r workdir="$2"

  local -a args=()
  args+=(install --prefer-offline)
  if [[ "$mode" == 'frozen' ]]; then
    args+=(--frozen-lockfile)
  else
    args+=(--no-frozen-lockfile)
  fi

  local pnpm_log pnpm_exit attempt delay p retryable uuid
  pnpm_log="$(mktemp)"

  for attempt in 1 2 3 4; do
    pnpm_exit=0
    runner_sh "pnpm install attempt ${attempt}" \
      "cd $(printf '%q' "$workdir") && $(runner_quote_cmdline pnpm "${args[@]}")" \
      || pnpm_exit=$?
    uuid="$(runner_last_id)"
    : >"$pnpm_log"
    if [[ -n "$uuid" ]]; then
      {
        runner_read "$uuid" stdout 2>/dev/null || true
        runner_read "$uuid" stderr 2>/dev/null || true
      } >"$pnpm_log"
    fi

    if (( pnpm_exit == 0 )); then
      rm -f "$pnpm_log"
      return 0
    fi

    # If pnpm is blocking builds, record the package(s) and continue.
    if pnpm_output_has_ignored_builds "$pnpm_log"; then
      pnpm_record_ignored_build_pkgs "$pnpm_log"
      log "[pnpm] WARNING: pnpm refused to run build scripts (ERR_PNPM_IGNORED_BUILDS)."
      log "[pnpm] WARNING: This is a supply-chain safety gate. To resolve permanently, run:"
      log "[pnpm] WARNING:   pnpm approve-builds"
      log "[pnpm] WARNING: Or one-shot non-interactive:"
      log "[pnpm] WARNING:   pnpm approve-builds --all"
      if [[ -n "$pnpm_ignored_build_pkgs" ]]; then
        log "[pnpm] WARNING: Skipping updates for packages requiring build approval:"
        while IFS= read -r p; do
          [[ -z "$p" ]] && continue
          log "[pnpm] WARNING:   ${p}"
        done <<< "$pnpm_ignored_build_pkgs"
      fi
      rm -f "$pnpm_log"
      return 0
    fi

    # Retry only on transient network errors.  A "no matching version" error is
    # not transient — the version genuinely does not exist on the registry and
    # retrying will not fix it.  npm_version_prefetch gates the outdated list
    # to only downloadable versions; if a non-existent version still reaches
    # this point, fail fast rather than waste minutes retrying.
    retryable=0
    if grep -qiE 'ECONNRESET|ETIMEDOUT|ENOTFOUND|network error|fetch failed' "$pnpm_log"; then
      retryable=1
    fi
    if (( retryable )) && [[ "$attempt" -lt 4 ]]; then
      delay=$(( attempt * 30 ))
      log "[pnpm] WARNING: transient install error; attempt ${attempt}/3, retrying in ${delay}s…"
      sleep "$delay"
      continue
    fi

    break
  done

  # A "no matching version" error means the registry doesn't have this exact
  # version — possibly a race where the version was briefly published then yanked,
  # or pnpm view returned a stale cached result.  Signal the caller (exit 2) so
  # it can skip this group and continue with other packages, rather than aborting
  # the entire run.
  if grep -qF 'ERR_PNPM_NO_MATCHING_VERSION' "$pnpm_log"; then
    log "[pnpm] WARNING: a requested version was not found in the registry; signalling caller to skip this group."
    tail -n 20 "$pnpm_log" | sed 's/^/  /' >&2
    rm -f "$pnpm_log"
    return 2
  fi

  # Stale lockfile metadata (e.g. overrides dropped from package.json but still in
  # pnpm-lock.yaml) breaks --frozen-lockfile. Retry once without frozen in the
  # throwaway worktree so --report-json scans can proceed.
  if [[ "$mode" == 'frozen' ]] \
      && grep -qF 'ERR_PNPM_LOCKFILE_CONFIG_MISMATCH' "$pnpm_log"; then
    log "[pnpm] WARNING: lockfile config mismatch; retrying install with --no-frozen-lockfile…"
    rm -f "$pnpm_log"
    pnpm_install_worktree no-frozen "$workdir"
    return $?
  fi

  printf '%s\n' "pnpm install failed (exit ${pnpm_exit}). Last output:" >&2
  tail -n 80 "$pnpm_log" | sed 's/^/  /' >&2
  record_first_failure "pnpm install failed (exit ${pnpm_exit})"
  rm -f "$pnpm_log"
  return "$pnpm_exit"
}

# ---------------------------------------------------------------------------
# Prerequisite checks — report-only mode (no PR creation)
# ---------------------------------------------------------------------------

check_report_prereqs() {
  local missing=0

  tooling_prereq_check_tools --no-versions "[tooling]" git jq rg || missing=$?

  if (( missing > 0 )); then
    die "Install the missing tool(s) above and retry."
  fi
}

# ---------------------------------------------------------------------------
# Prerequisite checks — auth (skipped in dry-run)
# ---------------------------------------------------------------------------

check_auth_prereqs() {
  log "[auth]"

  local gh_user gt_out gt_user line
  gh_user="$(dep_runner_gh_stdout "gh api user login" -- api user --jq .login 2>/dev/null || true)"
  if [[ -z "$gh_user" ]]; then
    die "'gh' is not authenticated. Run: gh auth login"
  fi
  log "  gh: logged in as ${gh_user}"

  # Graphite only — gh-stack targets do not need `gt auth` (marker from
  # dep_init_stacking_tool in check_core_prereqs for non–batch-all runs).
  if dep_stacking_is_graphite; then
    if ! gt_out="$(runner_sh_stdout "gt auth status" --timeout 20 -- 'gt auth 2>&1')"; then
      die "'gt' is not authenticated. Run: gt auth"
    fi
    gt_user=''
    while IFS= read -r line || [[ -n "${line}" ]]; do
      if [[ "${line}" =~ ^Authenticated[[:space:]]as:[[:space:]]([^[:space:]]+) ]]; then
        gt_user="${BASH_REMATCH[1]}"
        break
      fi
    done <<<"${gt_out}"
    if [[ -n "$gt_user" ]]; then
      log "  gt: authenticated as ${gt_user}"
    else
      log "  gt: authenticated"
    fi
  fi

  # Reconfigure git's credential helper to point at the gh binary currently in
  # PATH (idempotent). This fixes stale absolute paths like /usr/bin/gh that
  # were written when gh was first installed at a different location.
  dep_runner_gh "gh auth" -- auth setup-git
  log "  git credential helper: updated to current gh path"
}

# ---------------------------------------------------------------------------
# Prerequisite checks — Phase 2: ecosystem tools (checked after detection)
# ---------------------------------------------------------------------------

check_ecosystem_prereqs() {
  local -r chk_npm="$1"
  local -r chk_py="$2"
  local -r chk_rust="${3:-0}"
  local missing=0

  tooling_prereq_check_ecosystem_tools "$chk_npm" "$npm_tool" "$chk_py" || missing=$?

  if [[ "$chk_rust" == '1' ]]; then
    if ! command -v cargo &>/dev/null; then
      log "ERROR: 'cargo' is required for Rust projects."
      log "       Install: https://www.rust-lang.org/tools/install"
      missing=$(( missing + 1 ))
    elif ! cargo outdated --version &>/dev/null 2>&1; then
      log "ERROR: 'cargo outdated' is required for Rust projects."
      log "       Install: cargo install cargo-outdated"
      missing=$(( missing + 1 ))
    fi
  fi

  if [[ "$chk_py" == 'pip' ]] \
    && ! command -v pip &>/dev/null \
    && command -v pip3 &>/dev/null; then
    py_tool="pip3"  # promote pip3 globally
  fi

  if (( missing > 0 )); then
    die "Install the missing tool(s) above and retry."
  fi
}

# Prerequisite: GNU sed for in-place edits (state file, uv floors, GHA workflow patches).
check_gnu_sed_prereqs() {
  if ! tooling_prereq_check_gnu_sed; then
    die "Install GNU sed and retry (see above)."
  fi
}

# ---------------------------------------------------------------------------
# npm project directory helpers (root or nested, e.g. web/)
# ---------------------------------------------------------------------------

npm_project_root() {
  local -r base="$1"
  if [[ -z "${npm_project_prefix:-}" ]]; then
    printf '%s' "$base"
  else
    printf '%s/%s' "$base" "$npm_project_prefix"
  fi
}

npm_repo_rel_path() {
  local -r file="$1"
  if [[ -z "${npm_project_prefix:-}" ]]; then
    printf '%s' "$file"
  else
    printf '%s/%s' "$npm_project_prefix" "$file"
  fi
}

# Run pnpm with cwd in the npm project root. "pnpm --dir" fails when
# package.json declares packageManager (corepack needs the project cwd).
pnpm_in_project() {
  local -r project_root="$1"
  shift
  local cmd_quoted exit_code

  cmd_quoted="$(runner_quote_cmdline pnpm "$@")"
  exit_code=0
  runner_sh "pnpm in ${project_root}" --stream-stdout \
    "cd $(printf '%q' "$project_root") && ${cmd_quoted}" || exit_code=$?
  return "$exit_code"
}

# ---------------------------------------------------------------------------
# Ecosystem detection
# ---------------------------------------------------------------------------

detect_ecosystem() {
  has_npm=0
  npm_tool=""
  npm_project_prefix=""
  py_tool=""
  has_rust=0
  has_gha=0

  # Prefer origin/main manifests when available so detection matches what we scan
  # and bump (feature branches may lack lockfiles or workflows that exist on main).
  local detect_ref="worktree"
  run_command "git repo" git -C "$dir" fetch origin main 2>/dev/null || true
  if git -C "$dir" rev-parse origin/main >/dev/null 2>&1; then
    detect_ref="origin/main"
  fi

  _repo_file_exists() {
    local rel="$1"
    local probe_exit=0
    if [[ "$detect_ref" == "origin/main" ]]; then
      runner_exec "git repo probe ${rel}" --probe \
        -- git -C "$dir" cat-file -e "origin/main:${rel}" 2>/dev/null || probe_exit=$?
      (( probe_exit == 0 ))
    else
      [[ -f "$dir/${rel}" ]]
    fi
  }

  _lockfile_present() {
    local f="$1"
    local prefixed="$f"
    if [[ -n "$npm_project_prefix" ]]; then
      prefixed="${npm_project_prefix}/${f}"
    fi
    if [[ "$detect_ref" == "origin/main" ]]; then
      local probe_exit=0
      runner_exec "git cat-file lockfile ${prefixed}" --probe \
        -- git -C "$dir" cat-file -e "origin/main:${prefixed}" 2>/dev/null || probe_exit=$?
      if (( probe_exit == 0 )); then
        return 0
      fi
      dep_runner_git_c_stdout "git ls-tree lockfile" "$dir" -- ls-tree --name-only origin/main -- "$prefixed" 2>/dev/null \
        | grep -q .
    else
      [[ -f "$dir/${prefixed}" ]]
    fi
  }

  if [[ "$ecosystem" == 'npm' || "$ecosystem" == 'auto' ]]; then
    if _repo_file_exists "package.json"; then
      has_npm=1
    elif [[ "$ecosystem" == 'auto' || "$ecosystem" == 'npm' ]]; then
      # Python-first repos often ship the browser bundle under a single child
      # directory (e.g. web/package.json). Enable only when there is exactly one
      # immediate */package.json — multiple matches are ambiguous.
      # Must keep working when that directory is the last git ls-tree entry (issue #330).
      local nested_count nested_parent child_pkg parent_dir base_name top_entry
      nested_count=0
      nested_parent=""
      if [[ "$detect_ref" == "origin/main" ]]; then
        while IFS= read -r top_entry; do
          [[ -z "$top_entry" ]] && continue
          case "$top_entry" in
            node_modules|vendor|dist|build|coverage|tmp|out)
              continue ;;
          esac
          if _repo_file_exists "${top_entry}/package.json"; then
            nested_count=$((nested_count + 1))
            nested_parent="$top_entry"
          fi
        done < <(dep_runner_git_c_stdout "git ls-tree root entries" "$dir" -- ls-tree --name-only origin/main 2>/dev/null || true)
      else
        shopt -s nullglob
        for child_pkg in "$dir"/*/package.json; do
          [[ -f "$child_pkg" ]] || continue
          parent_dir="$(dirname "$child_pkg")"
          base_name="$(basename "$parent_dir")"
          case "$base_name" in
            node_modules|vendor|dist|build|coverage|tmp|out)
              continue ;;
          esac
          nested_count=$((nested_count + 1))
          nested_parent="$parent_dir"
        done
        shopt -u nullglob
      fi
      if [[ "$nested_count" -eq 1 ]]; then
        has_npm=1
        npm_project_prefix="$(basename "$nested_parent")"
        log "[npm] Using nested package.json at: ${npm_project_prefix}/package.json"
      elif [[ "$nested_count" -gt 1 ]]; then
        log "[npm] Skipping nested npm scan: multiple */package.json candidates (ambiguous)."
      fi
    fi

    if [[ "$has_npm" == '1' ]]; then
      if _lockfile_present "pnpm-lock.yaml"; then
        npm_tool="pnpm"
      elif _lockfile_present "yarn.lock"; then
        npm_tool="yarn"
      else
        # package-lock.json or no lockfile at all — default to npm.
        npm_tool="npm"
      fi
    fi
  fi

  if [[ "$ecosystem" == 'python' || "$ecosystem" == 'auto' ]]; then
    if _repo_file_exists "uv.lock"; then
      py_tool="uv"
    elif _repo_file_exists "poetry.lock"; then
      py_tool="poetry"
    elif _repo_file_exists "Pipfile.lock"; then
      py_tool="pipenv"
    elif _repo_file_exists "requirements.txt" || _repo_file_exists "pyproject.toml"; then
      py_tool="pip"
    fi
  fi

  if [[ "$ecosystem" == 'rust' || "$ecosystem" == 'auto' ]]; then
    if _repo_file_exists "Cargo.toml"; then
      has_rust=1
    fi
  fi

  if [[ "$ecosystem" == 'gha' || "$ecosystem" == 'auto' ]]; then
    if [[ "$detect_ref" == "origin/main" ]]; then
      if git -C "$dir" grep -q 'uses:' origin/main -- .github/workflows/ 2>/dev/null; then
        has_gha=1
      fi
    elif grep -rql --include='*.yml' --include='*.yaml' 'uses:' \
        "${dir}/.github/workflows/" 2>/dev/null; then
      has_gha=1
    fi
  fi

  unset -f _repo_file_exists _lockfile_present

  if [[ "$has_npm" == '0' && -z "$py_tool" && "$has_rust" == '0' && "$has_gha" == '0' ]]; then
    if [[ "$dry_run" == '1' ]]; then
      log "No supported ecosystem detected in: $dir"
    else
      die "No supported ecosystem detected in: $dir"
    fi
  fi

  readonly has_npm npm_tool py_tool has_rust has_gha npm_project_prefix

  local eco_msg=""
  if [[ "$has_npm" == '1' ]]; then
    eco_msg="npm (${npm_tool})"
  fi
  if [[ -n "$py_tool" ]]; then
    if [[ -n "$eco_msg" ]]; then
      eco_msg="${eco_msg}, python/${py_tool}"
    else
      eco_msg="python/${py_tool}"
    fi
  fi
  if [[ "$has_rust" == '1' ]]; then
    if [[ -n "$eco_msg" ]]; then
      eco_msg="${eco_msg}, rust/cargo"
    else
      eco_msg="rust/cargo"
    fi
  fi
  if [[ "$has_gha" == '1' ]]; then
    if [[ -n "$eco_msg" ]]; then
      eco_msg="${eco_msg}, github-actions"
    else
      eco_msg="github-actions"
    fi
  fi
  log "Detected: ${eco_msg}"

  # Log ecosystem tool paths and versions alongside core tooling.
  log "[ecosystem tooling]"
  local eco_tools=()
  if [[ "$has_npm" == '1' ]]; then
    eco_tools+=("$npm_tool")
  fi
  if [[ -n "$py_tool" ]]; then
    eco_tools+=("$py_tool")
    if tooling_prereq_pip_audit_usable "$py_tool"; then
      eco_tools+=("pip-audit")
    fi
  fi
  if [[ "$has_rust" == '1' ]]; then
    eco_tools+=("cargo")
    if cargo outdated --version &>/dev/null 2>&1; then
      eco_tools+=("cargo-outdated")
    fi
  fi
  local et et_line
  for et in "${eco_tools[@]}"; do
    et_line="$(tooling_prereq_describe_tool_line "$et" "$py_tool")"
    log "$et_line"
  done
}

# Discover which workflows in .github/workflows/ are triggered on pull_request
# events, and store their names in the global ci_workflow_names (newline-
# separated).  Used by wait_for_ci and friends so they match the real CI
# workflow name(s) instead of relying on a hardcoded string.
detect_ci_workflows() {
  local workflows_dir="${dir}/.github/workflows"
  if [[ ! -d "$workflows_dir" ]]; then
    log "[ci] No .github/workflows/ directory found; will monitor all workflow runs."
    return
  fi

  local names=() f name
  for f in "${workflows_dir}"/*.yml "${workflows_dir}"/*.yaml; do
    [[ -f "$f" ]] || continue
    # Skip workflows without a pull_request trigger.
    # Match YAML trigger keys: `  pull_request:` or `  pull_request_target:`
    # or inline array form: `on: [pull_request, ...]`
    grep -qE '^[[:space:]]*(pull_request|pull_request_target)[[:space:]]*[:$]' "$f" 2>/dev/null \
      || grep -qE '^on:[[:space:]]*\[.*pull_request' "$f" 2>/dev/null \
      || continue
    # Skip workflows whose pull_request trigger is restricted to types that
    # never fire on a PR push (e.g. types: [closed]).  Only include workflows
    # that can run when a PR is opened or updated.
    # If there is any explicit types: list, require at least one push-relevant
    # type (opened / synchronize / reopened / ready_for_review).
    if grep -qE '^\s+types\s*:' "$f" 2>/dev/null; then
      grep -qE '\b(opened|synchronize|reopened|ready_for_review)\b' "$f" 2>/dev/null \
        || continue
    fi
    name="$(grep -m1 '^name:' "$f" | sed 's/^name:[[:space:]]*//' | tr -d "\"'")"
    [[ -n "$name" ]] && names+=("$name")
  done

  if [[ ${#names[@]} -gt 0 ]]; then
    ci_workflow_names="$(printf '%s\n' "${names[@]}")"
    log "[ci] PR workflows: $(printf '%s, ' "${names[@]}" | sed 's/, $//')"
  else
    log "[ci] No PR-triggered workflows found; will monitor all workflow runs."
  fi

  detect_ci_required_contexts
}

detect_ci_required_contexts() {
  local ci_yml="${dir}/.github/workflows/ci.yml"
  local contexts

  ci_required_contexts=""
  if [[ ! -f "$ci_yml" ]]; then
    return 0
  fi

  contexts="$(ci_discover_required_contexts_from_ci_yml_text "$(<"$ci_yml")")"
  if [[ -n "$contexts" ]]; then
    ci_required_contexts="$contexts"
    log "[ci] Required check contexts: $(printf '%s\n' "$contexts" | paste -sd ', ' -)"
  fi
}

# ---------------------------------------------------------------------------
# Working directory state note
# ---------------------------------------------------------------------------

primary_repo_has_local_changes() {
  if ! runner_exec "git diff clean check" --probe -- git -C "$dir" diff --quiet 2>/dev/null; then
    return 0
  fi
  if ! runner_exec "git diff --cached clean check" --probe -- git -C "$dir" diff --cached --quiet 2>/dev/null; then
    return 0
  fi
  local untracked
  untracked=""
  untracked="$(dep_runner_git_c_stdout "git ls-files untracked" "$dir" -- \
    ls-files --others --exclude-standard 2>/dev/null | head -n 1 || true)"
  if [[ -n "$untracked" ]]; then
    return 0
  fi
  return 1
}

warn_if_dirty_workdir() {
  if primary_repo_has_local_changes; then
    log "Working directory has local changes."
    if [[ "$report_json" == '1' ]]; then
      log "Report-json mode does not stash primary-clone changes; scans use a temporary worktree only."
    else
      log "dep-updater stashes primary-clone changes for this run and restores them when finished."
    fi
    log "Update scans and stack work run in a separate worktree under --tmpdir."
  fi
}

primary_repo_current_branch() {
  run_command "git repo" git -C "$dir" symbolic-ref --short HEAD 2>/dev/null || true
}

primary_repo_warn_if_not_main() {
  local branch
  branch="$(primary_repo_current_branch)"
  if [[ -z "$branch" || "$branch" == 'main' ]]; then
    return 0
  fi

  log "[worktree] Warning: primary clone is checked out on '${branch}', not main."
  log "[worktree] dep-updater runs stacks in a separate worktree under --tmpdir."
  log "[worktree] Do not run stacking sync/submit from the primary clone."
  log "[worktree] The primary checkout branch is not changed by dep-updater."
}

# ---------------------------------------------------------------------------
# Branch name sanitization
# ---------------------------------------------------------------------------

sanitize_branch_name() {
  local -r input="$1"
  printf '%s' "$input" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's|[@/._]|-|g; s|-\+|-|g; s|^-||; s|-$||'
}

# ---------------------------------------------------------------------------
# Run a command inside the worktree (subshell with cd)
# ---------------------------------------------------------------------------

run_in_worktree() {
  (cd "$worktree_path" && "$@")
}

# ---------------------------------------------------------------------------
# State file helpers
# ---------------------------------------------------------------------------

init_state_file() {
  local repo_hash
  repo_hash="$(printf '%s' "$dir" | md5sum | cut -c1-8)"
  state_file="${wt_tmpdir:-${TMPDIR:-/tmp}}/.dep-updater-state-${repo_hash}"
  readonly state_file
  state_prune_if_worktree_missing
}

state_prune_if_worktree_missing() {
  local existing_wt
  [[ -f "$state_file" ]] || return 0
  existing_wt="$(state_get "worktree")"
  if [[ -z "$existing_wt" ]]; then
    log "[state] Removing stale state (no worktree path recorded)."
    rm -f "$state_file"
    return 0
  fi
  if [[ ! -d "$existing_wt" ]]; then
    log "[state] Removing stale state (worktree directory missing: ${existing_wt})."
    rm -f "$state_file"
    return 0
  fi
  if ! git -C "$existing_wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log "[state] Removing stale state (not a git worktree: ${existing_wt})."
    rm -f "$state_file"
  fi
}

state_get() {
  local -r key="$1"
  rg -m1 "^${key}=" "$state_file" 2>/dev/null | cut -d= -f2- || true
}

state_set() {
  local -r key="$1"
  local -r value="$2"
  if rg -q "^${key}=" "$state_file" 2>/dev/null; then
    gnu_sed_inplace "$state_file" -e "s|^${key}=.*|${key}=${value}|"
  else
    printf '%s=%s\n' "$key" "$value" >> "$state_file"
  fi
}

state_append() {
  local -r key="$1"
  local -r value="$2"
  local current
  current="$(state_get "$key")"
  if [[ -z "$current" ]]; then
    state_set "$key" "$value"
  else
    state_set "$key" "${current},${value}"
  fi
}

is_valid_pr_number() {
  local -r value="$1"
  [[ "$value" =~ ^[0-9]+$ ]]
}

state_append_pr() {
  local -r pr_number="$1"
  if ! is_valid_pr_number "$pr_number"; then
    log "Warning: skipping invalid PR number in state append: '${pr_number}'"
    return 0
  fi
  state_append "prs" "$pr_number"
}

sanitize_state_prs() {
  [[ ! -f "$state_file" ]] && return 0

  local prs_csv
  prs_csv="$(state_get "prs")"
  [[ -z "$prs_csv" ]] && return 0

  local cleaned="" removed_any=0 token
  IFS=',' read -ra pr_list <<< "$prs_csv"
  for token in "${pr_list[@]}"; do
    [[ -z "$token" ]] && continue
    if is_valid_pr_number "$token"; then
      if [[ -z "$cleaned" ]]; then
        cleaned="$token"
      else
        cleaned="${cleaned},${token}"
      fi
    else
      removed_any=1
      log "Warning: removing invalid PR token from state: '${token}'"
    fi
  done

  if [[ "$removed_any" == '1' ]]; then
    state_set "prs" "$cleaned"
  fi
}

csv_contains() {
  local -r csv="$1"
  local -r needle="$2"
  [[ ",${csv}," == *",${needle},"* ]]
}

csv_last() {
  local -r csv="$1"
  if [[ -z "$csv" ]]; then
    printf ''
  else
    awk -F',' '{print $NF}' <<< "$csv"
  fi
}

csv_pretty() {
  local -r csv="$1"
  if [[ -z "$csv" ]]; then
    printf ''
  else
    printf '%s' "$csv" | sed 's/,/, /g'
  fi
}

collect_tracked_prs_csv() {
  local branches_csv prs_csv collected=""
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"

  if [[ -n "$branches_csv" ]]; then
    local b pr
    IFS=',' read -ra b_list <<< "$branches_csv"
    for b in "${b_list[@]}"; do
      [[ -z "$b" ]] && continue
      pr="$(gh_pr_number_for_branch "$b")"
      if [[ -n "$pr" ]] && is_valid_pr_number "$pr" && ! csv_contains "$collected" "$pr"; then
        if [[ -z "$collected" ]]; then
          collected="$pr"
        else
          collected="${collected},${pr}"
        fi
      fi
    done
  fi

  if [[ -n "$prs_csv" ]]; then
    local p
    IFS=',' read -ra p_list <<< "$prs_csv"
    for p in "${p_list[@]}"; do
      [[ -z "$p" ]] && continue
      if is_valid_pr_number "$p" && ! csv_contains "$collected" "$p"; then
        if [[ -z "$collected" ]]; then
          collected="$p"
        else
          collected="${collected},${p}"
        fi
      fi
    done
  fi

  printf '%s' "$collected"
}

write_initial_state() {
  local -r wt="$1"
  local timestamp
  timestamp="$(time_log_date_utc '%Y-%m-%dT%H:%M:%SZ')"
  printf 'worktree=%s\nbase_branch=main\nwt_branch=%s\ncreated_at=%s\nbranches=\nprs=\n' \
    "$wt" "$wt_base_branch" "$timestamp" > "$state_file"
}

# ---------------------------------------------------------------------------
# Primary clone ($dir) — stash before worktree work, pop on teardown
# ---------------------------------------------------------------------------

primary_repo_preserve() {
  local stash_msg stash_exit

  if [[ "$_primary_preserve_active" == '1' ]]; then
    return 0
  fi
  if [[ "$report_json" == '1' ]]; then
    return 0
  fi
  if ! primary_repo_has_local_changes; then
    return 0
  fi

  _primary_preserve_active=1
  stash_msg="${_primary_stash_msg_prefix} ($$)"
  log "[worktree] Stashing primary-clone local changes before dep-updater worktree run…"
  stash_exit=0
  run_command "git stash" git -C "$dir" stash push -u -m "$stash_msg" >/dev/null 2>&1 || stash_exit=$?
  if (( stash_exit != 0 )); then
    _primary_preserve_active=0
    die "Could not stash primary-clone local changes in: ${dir}"
  fi
  _primary_stash_ref=""
  _primary_stash_ref="$(dep_runner_git_c_stdout "git stash list" "$dir" -- stash list 2>/dev/null \
    | awk -F: -v msg="$stash_msg" 'index($0, msg) { print $1; exit }' || true)"
  if [[ -z "$_primary_stash_ref" ]]; then
    _primary_preserve_active=0
    die "Could not locate dep-updater preservation stash after git stash push"
  fi
  log "[worktree] Primary-clone changes stashed as ${_primary_stash_ref}."
}

primary_repo_recover() {
  local pop_exit

  if [[ "$report_json" == '1' ]]; then
    return 0
  fi
  if [[ "$_primary_preserve_active" != '1' || -z "$_primary_stash_ref" ]]; then
    _primary_preserve_active=0
    _primary_stash_ref=""
    return 0
  fi

  log "[worktree] Restoring stashed primary-clone local changes (${_primary_stash_ref})…"
  pop_exit=0
  run_command "git stash pop" git -C "$dir" stash pop "$_primary_stash_ref" >/dev/null 2>&1 || pop_exit=$?
  _primary_stash_ref=""
  _primary_preserve_active=0
  if (( pop_exit != 0 )); then
    log "[worktree] ERROR: git stash pop failed (exit ${pop_exit}); preservation stash may remain."
    record_first_failure "primary clone stash pop failed (exit ${pop_exit})"
    return "$pop_exit"
  fi
  return 0
}

# Before scanning for outdated packages, align the dep-updater worktree with
# origin/main when no stack branches exist yet (fresh or idle worktree).
sync_worktree_to_origin_main_for_scan() {
  local -r branches_csv="${1:-}"
  if [[ -n "$branches_csv" ]]; then
    return 0
  fi
  local main_sha cur
  runner_exec "git fetch origin main (scan sync)" -- git -C "$worktree_path" fetch origin main 2>/dev/null || true
  main_sha=""
  main_sha="$(dep_runner_git_rev_parse "git rev-parse origin/main" "$worktree_path" "origin/main" || true)"
  if [[ -z "$main_sha" ]]; then
    return 0
  fi
  cur="$(dep_runner_git_rev_parse "git rev-parse HEAD" "$worktree_path" "HEAD" || true)"
  if [[ "$cur" == "$main_sha" ]]; then
    return 0
  fi
  log "[worktree] Syncing scan tree to origin/main (${main_sha:0:8})…"
  if [[ -n "$wt_base_branch" ]]; then
    run_command "git checkout base branch" git -C "$worktree_path" checkout "$wt_base_branch" 2>/dev/null \
      || run_command "git checkout -B base branch" git -C "$worktree_path" checkout -B "$wt_base_branch" "$main_sha"
  fi
  runner_exec "git reset --hard origin/main" -- git -C "$worktree_path" reset --hard "$main_sha" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Worktree management
# ---------------------------------------------------------------------------

dep_updater_worktree_repo_slug() {
  local -r repo_path="$1"
  basename "$repo_path" | sed 's/[^a-zA-Z0-9._-]/-/g'
}

create_worktree() {
  local timestamp repo_slug
  timestamp="$(time_log_date_utc '%Y%m%dT%H%M%S')"
  repo_slug="$(dep_updater_worktree_repo_slug "$dir")"
  local base_path
  base_path="${wt_tmpdir:-${TMPDIR:-/tmp}}/dep-updater-wt-${timestamp}-${repo_slug}-$$"
  worktree_path="$base_path"
  local suffix=0
  while [[ -e "$worktree_path" ]]; do
    suffix=$(( suffix + 1 ))
    worktree_path="${base_path}-${suffix}"
  done

  log "[worktree] Creating worktree at: $worktree_path"
  # Fetch origin/main first so the worktree starts from exactly what GitHub sees.
  # Using a stale local 'main' that diverges from origin/main causes the first
  # PR to show as conflicting immediately.
  log "Fetching origin/main…"
  runner_exec "git fetch origin main" -- git -C "$dir" fetch origin main 2>/dev/null || true

  # Create a uniquely-named local branch at origin/main's commit. Using 'main'
  # directly fails with "fatal: 'main' is already used by worktree at …" when
  # main is already checked out in the primary clone. A named branch is also
  # required by gt, which refuses to operate on a detached HEAD.
  local main_sha
  main_sha=""
  main_sha="$(dep_runner_git_rev_parse "git rev-parse origin/main" "$dir" "origin/main" || true)"
  if [[ -z "$main_sha" ]]; then
    # No remote or fetch failed — fall back to local HEAD (e.g. during dry-run
    # against a repo that has no origin configured).
    main_sha="$(dep_runner_git_rev_parse "git rev-parse HEAD" "$dir" "HEAD" || true)" \
      || die "Could not resolve origin/main or HEAD in: $dir"
    log "[worktree] origin/main not available; using local HEAD as base"
  fi
  wt_base_branch="dep-updater-wt-${timestamp}-$$"
  run_command "git worktree add" git -C "$dir" worktree add -b "$wt_base_branch" "$worktree_path" "$main_sha" >&2
  readonly worktree_path
  log "[worktree] Worktree created: $worktree_path"

  # Install only the dependencies for the targeted ecosystem(s).
  # Gated on has_npm / py_tool (set by detect_ecosystem) to avoid running
  # a full pnpm install when the user passed --ecosystem python, for example.
  if [[ "$has_npm" == '1' ]]; then
    local npm_wt
    npm_wt="$(npm_project_root "$worktree_path")"
    if [[ -f "${npm_wt}/pnpm-lock.yaml" ]]; then
      log "[worktree] Installing dependencies (pnpm)…"
      pnpm_install_worktree frozen "$npm_wt" \
        || die "pnpm install failed."
    elif [[ -f "${npm_wt}/package-lock.json" ]]; then
      log "[worktree] Installing dependencies (npm)…"
      install_with_net_retry npm "$npm_wt" npm ci --prefer-offline --no-audit --no-fund
    elif [[ -f "${npm_wt}/yarn.lock" ]]; then
      log "[worktree] Installing dependencies (yarn)…"
      install_with_net_retry yarn "$npm_wt" yarn install --frozen-lockfile
    fi
  fi
  if [[ -n "$py_tool" ]]; then
    case "$py_tool" in
      uv)
        if [[ -f "$worktree_path/uv.lock" || -f "$worktree_path/requirements.txt" ]]; then
          log "[worktree] Installing dependencies (uv)…"
          if [[ ! -d "$worktree_path/.venv" ]]; then
            dep_runner_sh "uv venv" -- "cd $(printf '%q' "$worktree_path") && uv venv" >&2
          fi
          if [[ -f "$worktree_path/uv.lock" ]]; then
            install_with_net_retry uv "$worktree_path" uv sync --frozen
          else
            install_with_net_retry uv "$worktree_path" uv pip install -r requirements.txt
          fi
        fi
        ;;
      poetry)
        [[ -f "$worktree_path/poetry.lock" ]] \
          && log "[worktree] Installing dependencies (poetry)…" \
          && install_with_net_retry poetry "$worktree_path" poetry install --no-root
        ;;
      pipenv)
        [[ -f "$worktree_path/Pipfile.lock" ]] \
          && log "[worktree] Installing dependencies (pipenv)…" \
          && install_with_net_retry pipenv "$worktree_path" \
               pipenv install
        ;;
      *)
        : # pip/pip3: no lockfile install needed; packages resolved per-update
        ;;
    esac
  fi
  if [[ "$has_rust" == '1' && -f "$worktree_path/Cargo.lock" ]]; then
    log "[worktree] Fetching Rust dependencies (cargo fetch)…"
    install_with_net_retry cargo "$worktree_path" cargo fetch --locked
  fi
  log "[worktree] Ready: $worktree_path"
}

# ---------------------------------------------------------------------------
# Worktree reset helper — delete a broken worktree and start fresh
# ---------------------------------------------------------------------------

offer_worktree_reset() {
  local auto_reset branches_csv current_branch prs_csv
  current_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current 2>/dev/null || echo '(detached)')"
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"
  auto_reset=0

  log "Worktree is unusable: branch '${current_branch}' is not tracked by Graphite."
  log "  Worktree: ${worktree_path}"
  if [[ -n "$branches_csv" ]]; then
    log "  Note: existing stack branches will NOT be deleted ($(csv_pretty "$branches_csv"))."
    log "  To clean up those PRs and branches later, run: $0 --cleanup --dir ${dir}"
  fi

  if ! is_interactive && [[ -z "$branches_csv" && -z "$prs_csv" ]] \
    && [[ "$current_branch" == "$wt_base_branch" ]]; then
    auto_reset=1
    log "[worktree] Auto-recovering abandoned untracked worktree (no stack branches or PRs)."
  elif ! prompt_yes_no "Delete this worktree and start fresh?" "y"; then
    die "Cannot proceed with unusable worktree. To clean up manually, run: $0 --cleanup --dir ${dir}"
  fi

  # Remove the broken worktree
  log "[worktree] Removing worktree: $worktree_path"
  run_command "git repo" git -C "$dir" worktree remove --force "$worktree_path" 2>/dev/null \
    || log "Note: worktree directory already removed."

  # Delete the throwaway wt_base_branch (it has no PRs stacked on it)
  local wt_branch
  wt_branch="$(state_get "wt_branch")"
  if [[ -n "$wt_branch" ]]; then
    log "[worktree] Deleting branch: $wt_branch"
    run_command "git repo" git -C "$dir" branch -D "$wt_branch" 2>/dev/null \
      || log "Note: wt_branch '${wt_branch}' not found; skipping deletion."
  fi

  # Clear state so create_worktree starts from scratch
  rm -f "$state_file"
  if (( auto_reset == 1 )); then
    log "[worktree] Abandoned worktree removed. Creating a fresh worktree…"
  else
    log "Broken worktree deleted. Creating a new worktree…"
  fi

  # worktree_path is not yet readonly at this call site; reset before create_worktree assigns it.
  worktree_path=""
  create_worktree
  write_initial_state "$worktree_path"
}

prepare_worktree() {
  # Best-effort cleanup: if the repo has stale worktree metadata, prune it so
  # subsequent worktree operations don’t fail.
  run_command "git repo" git -C "$dir" worktree prune >/dev/null 2>&1 || true

  local branch_info_status existing_wt
  existing_wt=""
  if [[ -f "$state_file" ]]; then
    existing_wt="$(state_get "worktree")"
    if [[ -n "$existing_wt" && -d "$existing_wt" ]]; then
      worktree_path="$existing_wt"
      # The directory can exist even when the worktree is no longer valid (e.g.
      # parent .git/worktrees/* metadata pruned). Verify before reuse.
      if ! git -C "$worktree_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        log "[worktree] Stale dep-updater worktree (not a git worktree): ${worktree_path}"
        log "[worktree] Recreating worktree…"
        rm -rf "$worktree_path" 2>/dev/null || true
        rm -f "$state_file" 2>/dev/null || true
        worktree_path=""
        create_worktree
        write_initial_state "$worktree_path"
        return 0
      fi

      log "Reusing dep-updater worktree: $worktree_path"

      # Restore the wt_base_branch from state (may be absent for worktrees
      # created before this field was introduced).
      wt_base_branch="$(state_get "wt_branch")"

      # If the worktree has a detached HEAD (legacy worktree or stale state),
      # create a named branch so gt can operate — it refuses detached HEAD.
      local wt_current_branch
      wt_current_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"
      if [[ -z "$wt_current_branch" ]]; then
        local wt_ts wt_pid
        wt_ts="$(time_log_date_utc '%Y%m%dT%H%M%S')"
        wt_pid="$$"
        wt_base_branch="dep-updater-wt-${wt_ts}-${wt_pid}"
        run_command "git worktree" git -C "$worktree_path" checkout -b "$wt_base_branch"
        state_set "wt_branch" "$wt_base_branch"
        log "Attached detached HEAD to new branch: $wt_base_branch"
        dep_stack_track_force
      fi

      # Sanity check: verify the stacking backend can operate on the current branch.
      branch_info_status=0
      dep_stack_branch_info_ok || branch_info_status=$?
      if (( branch_info_status == 124 )); then
        die "Graphite branch inspection timed out; preserving existing worktree: ${worktree_path}"
      fi
      if (( branch_info_status != 0 )); then
        offer_worktree_reset
        # offer_worktree_reset either dies or recreates the worktree via
        # create_worktree, which marks worktree_path readonly.
        return 0
      fi

      readonly worktree_path

      # Fetch latest main in case upstream has moved
      run_command "git worktree" git -C "$worktree_path" fetch origin main >/dev/null 2>&1 \
        || log "Note: could not fetch latest main; stack may be behind."
      
      # Check if stack needs rebase.
      if dep_stack_needs_rebase; then
        log_stack_rebase_context
        if prompt_yes_no "Rebase stack on main now?" "y"; then
          log "Rebasing stack..."
          dep_rebase_stack_on_main
        else
          log "Skipped rebase. Stack will use current base."
        fi
      fi
      
      return 0
    fi
    log "State file exists but worktree is missing; starting a new dep-updater worktree."
  fi

  create_worktree
  write_initial_state "$worktree_path"
}

ensure_gt_tracked() {
  local branch_info_status current_branch
  local -a track_args=(--force)

  current_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"
  # On main — always known to Graphite; nothing to track.
  if [[ "$current_branch" == 'main' ]]; then
    return 0
  fi
  # For any other branch (including the throwaway wt_base_branch) — ensure
  # Graphite tracks it so gt create can stack child branches on top of it.
  branch_info_status=0
  dep_stack_graphite_branch_info_ok || branch_info_status=$?
  if (( branch_info_status == 124 )); then
    die "Graphite branch inspection timed out for '${current_branch}'. Cannot create stack."
  fi
  if (( branch_info_status != 0 )); then
    # Prefer an explicit parent in the normal layout, but retain Graphite's
    # auto-detection for supported repositories whose local trunk is not main.
    if dep_stack_graphite_local_main_present; then
      track_args+=(-p main)
    fi
    dep_stack_graphite_track "${track_args[@]}" \
      || die "Could not register '${current_branch}' with Graphite. Cannot create stack."
  fi
}

branch_exists_in_worktree() {
  local -r branch="$1"
  run_command "git worktree" git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${branch}"
}

register_existing_branch_state() {
  local -r branch="$1"

  local branches_csv prs_csv
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"

  if ! csv_contains "$branches_csv" "$branch"; then
    state_append "branches" "$branch"
  fi

  local pr_num
  pr_num="$(gh_pr_number_for_branch "$branch")"
  if [[ -n "$pr_num" ]] && ! csv_contains "$prs_csv" "$pr_num"; then
    state_append_pr "$pr_num"
  fi
}

# ---------------------------------------------------------------------------
# npm helpers
# ---------------------------------------------------------------------------

# Prints one "name current latest" line per outdated package.
# Optional $1: project root to scan (defaults to $dir). Update and dry-run modes
# always pass the dep-updater worktree (synced to origin/main before scanning).
npm_outdated() {
  local -r tool="$npm_tool"
  local -r scan_root="${1:-$dir}"

  if [[ ! -d "${scan_root}/node_modules" ]]; then
    log "node_modules not found in npm project root — running install…"
    case "$tool" in
      pnpm) pnpm_in_project "$scan_root" install --frozen-lockfile >&2 ;;
      yarn) yarn --cwd "$scan_root" install --frozen-lockfile >&2 ;;
      npm)  npm install --prefix "$scan_root" --prefer-offline >&2 ;;
    esac
  fi

  # pnpm outdated can miss updates that are allowed by package.json ranges but
  # not yet captured in pnpm-lock.yaml (e.g. react ^19.2.5 when 19.2.6 exists).
  # In "latest" mode, compute direct-dependency updates by comparing the
  # installed version (pnpm list) to pnpm view, clamping with the npm packument
  # dist-tags.latest when pnpm metadata is stale-high.
  if [[ "$tool" == 'pnpm' && "$semver_only" == '0' ]]; then
    local pkg_json_specs
    if [[ -f "${scan_root}/package.json" ]]; then
      pkg_json_specs="$(dep_runner_jq_file_args "jq package.json direct deps" "${scan_root}/package.json" -c \
        '[.dependencies, .devDependencies, .peerDependencies, .optionalDependencies]
         | map(select(. != null)) | add // {}' 2>/dev/null || echo '{}')"
    else
      pkg_json_specs='{}'
    fi

    local tmp_list tmp_list_err
    tmp_list="$(mktemp)"
    tmp_list_err="$(mktemp)"
    if ! pnpm_in_project "$scan_root" list --depth 0 --json >"$tmp_list" 2>"$tmp_list_err"; then
      if [[ -s "$tmp_list_err" ]]; then
        printf '%s\n' 'pnpm list failed (needed for outdated detection). Last output:' >&2
        tail -n 15 "$tmp_list_err" | sed 's/^/  /' >&2
      fi
      rm -f "$tmp_list" "$tmp_list_err"
      die "pnpm list failed (needed for outdated detection)."
    fi
    rm -f "$tmp_list_err"

    local pkgs_json
    pkgs_json="$(dep_runner_jq_with_args "jq package keys" "$pkg_json_specs" -c 'keys' 2>/dev/null || echo '[]')"

    local -a candidate_lines=()
    local pkg spec current eligible pv reg higher latest
    while IFS= read -r pkg; do
      [[ -z "$pkg" ]] && continue
      if pnpm_pkg_is_ignored_build "$pkg"; then
        continue
      fi
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
      spec="$(dep_runner_jq_with_args "jq package spec" "$pkg_json_specs" -r --arg p "$pkg" '.[$p] // ""' 2>/dev/null || echo "")"
      # Skip packages whose specifier is a local/git reference; those are never version-bumped.
      if [[ -n "$spec" ]] && [[ "$spec" =~ ^(workspace:|file:|link:|git) ]]; then
        continue
      fi
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
      current="$(dep_runner_jq_file_args "jq pnpm list current" "$tmp_list" -r --arg p "$pkg" '
        .[0] as $root
        | ($root.dependencies[$p].version // $root.devDependencies[$p].version // $root.optionalDependencies[$p].version // $root.peerDependencies[$p].version // "")
      ' 2>/dev/null || echo "")"
      [[ -z "$current" ]] && continue

      # Combine pnpm metadata with the npm packument dist-tags.latest (same HTTPS
      # source as npm_version_prefetch). When pnpm's cached view claims a version
      # strictly above registry latest, clamp to registry — otherwise take the
      # higher of the two so we still advance when pnpm is merely behind.
      pv="$(dep_runner_pnpm_view_version "pnpm view ${pkg}" "$pkg" "$scan_root" || true)"
      reg="$(npm_registry_dist_tag_latest "$pkg" 2>/dev/null || true)"
      if [[ -n "$reg" && -n "$pv" ]]; then
        higher="$(printf '%s\n%s\n' "$reg" "$pv" | sort -V | tail -1)"
        if [[ "$higher" == "$pv" && "$pv" != "$reg" ]]; then
          latest="$reg"
        else
          latest="$higher"
        fi
      elif [[ -n "$reg" ]]; then
        latest="$reg"
      elif [[ -n "$pv" ]]; then
        latest="$pv"
      else
        continue
      fi
      [[ -z "$latest" ]] && continue
      [[ "$current" == "$latest" ]] && continue

      eligible="$(npm_pick_eligible_new_version "$pkg" "$current" "$scan_root" 2>/dev/null || true)"
      if [[ -n "$eligible" && "$eligible" != "$current" ]]; then
        candidate_lines+=("$pkg $current $eligible")
      fi
    done < <(dep_runner_jq_with_args "jq package names" "$pkgs_json" -r '.[]' 2>/dev/null || true)

    if [[ ${#candidate_lines[@]} -gt 0 ]]; then
      mapfile -t candidate_lines < <(npm_pnpm_filter_outdated_lines "$scan_root" "${candidate_lines[@]}")
    fi
    if [[ ${#candidate_lines[@]} -gt 0 ]]; then
      printf '%s\n' "${candidate_lines[@]}"
    fi

    rm -f "$tmp_list"
    return 0
  fi

  local tmp_json exit_code
  tmp_json="$(mktemp)"
  set +e
  case "$tool" in
    pnpm) pnpm_in_project "$scan_root" outdated --json > "$tmp_json" 2>/dev/null ;;
    yarn) yarn --cwd "$scan_root" outdated --json > "$tmp_json" 2>/dev/null ;;
    npm)  npm outdated --prefix "$scan_root" --json > "$tmp_json" 2>/dev/null ;;
  esac
  exit_code=$?
  set -e

  # Both pnpm and npm outdated exit 1 when outdated packages are found; >1 is an error.
  if (( exit_code > 1 )); then
    rm -f "$tmp_json"
    die "'${tool} outdated' exited with unexpected code ${exit_code}"
  fi

  if [[ ! -s "$tmp_json" ]] || grep -qE '^\s*\{\s*\}\s*$' "$tmp_json" || grep -qE '^\s*null\s*$' "$tmp_json"; then
    rm -f "$tmp_json"
    return 0
  fi

  # Read direct-dependency specifiers from package.json for local/git reference checks.
  # Local/git references (workspace:, file:, link:, git) are excluded from the update
  # list regardless of what `outdated` reports.  Exact-pinned packages (e.g. "3.0.0",
  # "=3.0.0") are NOT excluded: dep-updater updates them in place, preserving the exact
  # style (no promotion to ^), matching Dependabot behaviour.
  local pkg_json_specs
  if [[ -f "${scan_root}/package.json" ]]; then
    pkg_json_specs="$(dep_runner_jq_file_args "jq package.json direct deps" "${scan_root}/package.json" -c \
      '[.dependencies, .devDependencies, .peerDependencies, .optionalDependencies]
       | map(select(. != null)) | add // {}' 2>/dev/null || echo '{}')"
  else
    pkg_json_specs='{}'
  fi

  if [[ "$tool" == 'yarn' ]]; then
    dep_runner_jq_file_args "yarn outdated table" "$tmp_json" -r 'select(.type == "table")
      | .data.body[]
      | "\(.[0]) \(.[1]) \(.[3])"' 2>/dev/null \
      | awk '{if(NF==3 && $1!="" && $2!="" && $3!="") print $0}' \
      | while IFS=' ' read -r _ypkg _ycur _ynew; do
          local _yeligible
          _yeligible="$(npm_pick_eligible_new_version "$_ypkg" "$_ycur" "$scan_root" 2>/dev/null || true)"
          if [[ -n "$_yeligible" ]]; then
            printf '%s %s %s\n' "$_ypkg" "$_ycur" "$_yeligible"
          fi
        done
  else
    local -a candidate_lines=()
    # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
    while IFS= read -r _npkg _ncur _nnew; do
      [[ -z "$_npkg" ]] && continue
      if [[ "$semver_only" == '1' ]]; then
        # Only gate here when we take `_nnew` as-is. The --latest path below
        # calls npm_pick_eligible_new_version, which walks same-major candidates.
        if [[ "$_npkg" == 'typescript' ]] && npm_should_skip_typescript_major "$_ncur" "$_nnew"; then
          log "[pnpm] typescript: holding at major $(npm_semver_major "$_ncur") (skipping ${_nnew}; typescript-eslint lacks TS major support)."
          continue
        fi
        if [[ "$tool" == 'pnpm' ]]; then
          if npm_version_meets_minimum_release_age "$_npkg" "$_nnew" "$scan_root" \
            && npm_version_prefetch_closure "$_npkg" "$_nnew" "$scan_root"; then
            candidate_lines+=("$_npkg $_ncur $_nnew")
          fi
        elif npm_version_meets_minimum_release_age "$_npkg" "$_nnew" "$scan_root" \
          && npm_version_prefetch "$_npkg" "$_nnew"; then
          candidate_lines+=("$_npkg $_ncur $_nnew")
        fi
      else
        local _neligible
        _neligible="$(npm_pick_eligible_new_version "$_npkg" "$_ncur" "$scan_root" 2>/dev/null || true)"
        if [[ -n "$_neligible" ]]; then
          candidate_lines+=("$_npkg $_ncur $_neligible")
        fi
      fi
    done < <(dep_runner_jq_file_args "npm outdated candidates" "$tmp_json" -r \
      --argjson specs "$pkg_json_specs" --arg semver_only "$semver_only" '
      to_entries[]
      | select(
          .key | test("^(latest|wanted|isDeprecated|name|type|homepage|description|author|license|repository|bugs|engines|_.*)$") | not
        )
      | select(.value.current != null)
      # Skip packages whose specifier is a local/git reference; those are never
      # version-bumped.  Exact-pinned packages ("3.0.0", "=3.0.0") are kept:
      # dep-updater updates them in place (preserving the exact style), matching
      # Dependabot behaviour.  Packages absent from package.json (transitive deps)
      # are kept so they remain visible.
      | select(
          ($specs[.key] == null)
          or ($specs[.key] | test("^(workspace:|file:|link:|git)") | not)
        )
      # semver-only: only propose updates within the existing range (current → wanted).
      # Default: propose updates to the latest published version.
      | if $semver_only == "1" then
          select(.value.wanted != null and .value.current != .value.wanted)
          | "\(.key) \(.value.current) \(.value.wanted)"
        else
          # Skip packages that are already effectively at latest:
          # 1. Exact pin already at latest: spec (after stripping leading "=") equals
          #    latest.  Covers "4.1.5" and "=4.1.5".  Ranges (^, ~, >=) survive
          #    ltrimstr and never equal a bare version, so they are always kept.
          # 2. Lockfile already resolves range to latest: wanted == latest means
          #    pnpm install --frozen-lockfile is a no-op; the only way to get a newer
          #    version would be if npm publishes something beyond latest (impossible).
          # Packages absent from package.json (transitive) are always kept.
          select(
              $specs[.key] == null
              or (
                (($specs[.key] | ltrimstr("=")) != .value.latest)
                and (.value.wanted == null or .value.wanted != .value.latest)
              )
            )
          | "\(.key) \(.value.current) \(.value.latest)"
        end' 2>/dev/null \
      | awk '{if(NF==3 && $1!="" && $2!="" && $3!="") print $0}')

    if [[ ${#candidate_lines[@]} -gt 0 ]]; then
      if [[ "$tool" == 'pnpm' ]]; then
        mapfile -t candidate_lines < <(npm_pnpm_filter_outdated_lines "$scan_root" "${candidate_lines[@]}")
      fi
      printf '%s\n' "${candidate_lines[@]}"
    fi
  fi
  rm -f "$tmp_json"
}

# Derives the grouping key for an npm package.
# Scoped packages (@scope/name) group by @scope.
# Unscoped 'pkg' groups with @pkg if any @pkg/* sibling exists in all_lines.
npm_group_key() {
  local -r pkg="$1"
  local -r all_lines="$2"
  if [[ "$pkg" == @*/* ]]; then
    printf '%s' "${pkg%%/*}"
  elif printf '%s\n' "$all_lines" | rg -q --fixed-strings "@${pkg}/"; then
    printf '%s' "@${pkg}"
  else
    printf '%s' "$pkg"
  fi
}

# Prints one group key per line, preserving first-seen order.
list_npm_group_keys() {
  local -r all_lines="$1"
  local keys=""

  while IFS=' ' read -r pkg _old _new; do
    [[ -z "$pkg" ]] && continue
    local key
    key="$(npm_group_key "$pkg" "$all_lines")"
    if ! printf '%s\n' "$keys" | rg -qx --fixed-strings "$key"; then
      if [[ -z "$keys" ]]; then
        keys="$key"
      else
        keys="${keys}
${key}"
      fi
    fi
  done <<< "$all_lines"

  printf '%s' "$keys"
}

# Prints one "pkg old_ver new_ver" line per package in group_key.
npm_entries_for_group() {
  local -r group_key="$1"
  local -r all_lines="$2"

  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    local key
    key="$(npm_group_key "$pkg" "$all_lines")"
    if [[ "$key" == "$group_key" ]]; then
      printf '%s %s %s\n' "$pkg" "$old_ver" "$new_ver"
    fi
  done <<< "$all_lines"
}

# entries: newline-separated "pkg old_ver new_ver" for one group.
npm_update_group() {
  local -r group_key="$1"
  local -r entries="$2"
  local -r npm_audit_lines="${3:-}"  # optional: full audit lines to cross-reference CVEs

  local safe_key
  safe_key="$(sanitize_branch_name "${group_key#@}")"
  local -r branch="dep-updates/npm-${safe_key}"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing branch: ${branch}"
    register_existing_branch_state "$branch"
    # A previous run may have created the branch but died before submitting the PR
    # (e.g. killed by gh pr edit's non-zero exit). Submit it now if needed.
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      run_command "git worktree" git -C "$worktree_path" checkout "$branch"
  dep_stack_register_branch_optional
      dep_stack_submit_current
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then
        state_append_pr "$existing_pr"
      fi
    fi
    # Position worktree on this branch so the next update stacks on top of it.
    run_command "git worktree" git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  local pkg_count=0 first_pkg="" first_old="" first_new=""
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    pkg_count=$(( pkg_count + 1 ))
    if [[ "$pkg_count" -eq 1 ]]; then
      first_pkg="$pkg"; first_old="$old_ver"; first_new="$new_ver"
    fi
  done <<< "$entries"

  local commit_msg
  if [[ "$pkg_count" -eq 1 ]]; then
    commit_msg="chore(deps): bump ${first_pkg} from ${first_old} to ${first_new}"
    log "[${npm_tool}] ${first_pkg}: ${first_old} -> ${first_new}"
  else
    commit_msg="chore(deps): bump ${group_key} from ${first_old} to ${first_new}"
    log "[${npm_tool}] ${group_key} (${pkg_count} packages): ${first_old} -> ${first_new}"
  fi

  local npm_root
  npm_root="$(npm_project_root "$worktree_path")"

  # Restore manifest + lockfile to HEAD so a previous failed run cannot leave
  # them in a half-updated state that causes peer-dependency conflicts.
  # Restore each file independently: if the lockfile is not committed (common
  # for npm projects that .gitignore package-lock.json), a combined checkout
  # would fail silently via || true and leave package.json unrestored.
  local lockfile
  case "$npm_tool" in
    pnpm) lockfile="pnpm-lock.yaml" ;;
    yarn) lockfile="yarn.lock" ;;
    npm)  lockfile="package-lock.json" ;;
  esac
  run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
  if [[ "$npm_tool" == 'npm' ]]; then
    # For npm, delete the lockfile rather than restoring it.  The committed
    # lockfile pins old versions; restoring it causes npm to read those pins
    # and conflict them against the newly-patched package.json versions.
    # With no lockfile, npm builds a fresh resolution tree from package.json.
    rm -f "${npm_root}/package-lock.json"
  else
    run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path "$lockfile")" 2>/dev/null || true
  fi

  # Remove any stale node_modules left by a previous failed npm run.
  if [[ "$npm_tool" == 'npm' && -d "${npm_root}/node_modules" ]]; then
    log "[${npm_tool}] Removing stale node_modules in worktree before update…"
    rm -rf "${npm_root}/node_modules"
  fi

  # For pnpm/yarn (semver-only) and yarn (latest): pass package names to the
  # update command.  For npm and pnpm (latest): patch package.json via jq and
  # run install — avoids specifier/lockfile mismatches caused by `update --latest`.
  local -a pkg_args=()
  if [[ "$npm_tool" != 'npm' ]]; then
    while IFS=' ' read -r pkg _old _new; do
      [[ -z "$pkg" ]] && continue
      pkg_args+=("$pkg")
    done <<< "$entries"
  fi

  case "$npm_tool" in
    pnpm)
      if [[ "$semver_only" == '1' ]]; then
        # semver-only: stay within the existing range; pnpm resolves the latest
        # version within that range without touching package.json specifiers.
        pnpm_in_project "$npm_root" update "${pkg_args[@]}"
      else
        # pnpm update --latest writes exact versions (e.g. 8.58.2) to
        # package.json but leaves pnpm-lock.yaml specifiers at the old range
        # (e.g. ^8.58.1), causing a "specifiers don't match" error in CI.
        # Instead, patch package.json directly (same strategy as npm) then
        # let pnpm install regenerate the lockfile from the updated manifest.
        local updates_json
        updates_json='{}'
        while IFS=' ' read -r pkg _old new_ver; do
          [[ -z "$pkg" ]] && continue
          # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
          updates_json="$(dep_runner_jq_with_args "jq merge pkg version" "$updates_json" \
            --arg k "$pkg" --arg v "$new_ver" '. + {($k): $v}')"
        done <<< "$entries"

        local tmp_pkg
        tmp_pkg="$(mktemp)"
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
        if ! dep_runner_jq_file_args "jq patch package.json" "${npm_root}/package.json" --argjson updates "$updates_json" '
          to_entries | map(
            if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
               and (.value != null) then
              .value |= with_entries(
                (.key) as $k |
                if $updates | has($k) then
                  # Find the semver range prefix (e.g. ^, ~, >=) by locating
                  # the first ASCII digit (48="0" .. 57="9") in the value.
                  (.value | explode | map(. >= 48 and . <= 57) | index(true) // 0) as $di |
                  (.value[0:$di]) as $prefix |
                  .value = ($prefix + $updates[$k])
                else . end
              )
            else . end
          ) | from_entries
        ' >"$tmp_pkg"; then
          rm -f "$tmp_pkg"
          dep_updater_append_ecosystem_failure "npm|manifest JSON patch failed for group ${group_key} (${npm_tool})"
          log "[${npm_tool}] ERROR: jq failed to patch package.json for '${group_key}' — skipping group."
          return 0
        fi
        mv "$tmp_pkg" "${npm_root}/package.json"

        # --no-frozen-lockfile lets pnpm rebuild pnpm-lock.yaml from the
        # freshly patched package.json so specifiers are consistent.
        local pnpm_rc=0
        pnpm_install_worktree no-frozen "$npm_root" || pnpm_rc=$?
        if [[ "$pnpm_rc" -eq 2 ]]; then
          # A version in this group is not available on the registry — restore
          # manifests and skip the group so other packages can still update.
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path pnpm-lock.yaml)" 2>/dev/null || true
          log "[${npm_tool}] WARNING: ${group_key}: skipping — one or more versions not available in registry."
          dep_updater_append_ecosystem_failure "npm|${group_key}: version not in registry (pnpm ERR_PNPM_NO_MATCHING_VERSION)"
          return 0
        elif [[ "$pnpm_rc" -ne 0 ]]; then
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path pnpm-lock.yaml)" 2>/dev/null || true
          dep_updater_append_ecosystem_failure "npm|lockfile install failed for ${group_key} (exit ${pnpm_rc})"
          log "[${npm_tool}] ERROR: pnpm install failed for '${group_key}' (exit ${pnpm_rc}) — skipping group."
          return 0
        fi
      fi
      ;;
    yarn)
      local yarn_rc=0
      dep_runner_yarn_cwd "yarn upgrade group" "$npm_root" upgrade "${pkg_args[@]}" --latest || yarn_rc=$?
      if [[ "$yarn_rc" -ne 0 ]]; then
        run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
        run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path yarn.lock)" 2>/dev/null || true
        dep_updater_append_ecosystem_failure "npm|package-manager upgrade failed for ${group_key} (exit ${yarn_rc})"
        log "[${npm_tool}] ERROR: yarn upgrade failed for '${group_key}' (exit ${yarn_rc}) — skipping group."
        return 0
      fi
      ;;
    npm)
      # Patch exact target versions into package.json using jq, then do a
      # clean install.  npm install pkg@v rewrites package.json and builds an
      # ideal tree that first resolves the old semver range as the baseline,
      # causing ERESOLVE when interdependent grouped packages are updated.
      local updates_json
      updates_json='{}'
      while IFS=' ' read -r pkg _old new_ver; do
        [[ -z "$pkg" ]] && continue
        # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
        updates_json="$(dep_runner_jq_with_args "jq merge pkg version" "$updates_json" \
          --arg k "$pkg" --arg v "$new_ver" '. + {($k): $v}')"
      done <<< "$entries"

      local tmp_pkg
      tmp_pkg="$(mktemp)"
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
      if ! dep_runner_jq_file_args "jq patch package.json" "${npm_root}/package.json" --argjson updates "$updates_json" '
        to_entries | map(
          if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
             and (.value != null) then
            .value |= with_entries(
              (.key) as $k |
              if $updates | has($k) then
                # Find the semver range prefix (e.g. ^, ~, >=) by locating
                # the first ASCII digit (48="0" .. 57="9") in the value.
                (.value | explode | map(. >= 48 and . <= 57) | index(true) // 0) as $di |
                (.value[0:$di]) as $prefix |
                .value = ($prefix + $updates[$k])
              else . end
            )
          else . end
        ) | from_entries
      ' >"$tmp_pkg"; then
        rm -f "$tmp_pkg"
        dep_updater_append_ecosystem_failure "npm|manifest JSON patch failed for group ${group_key} (${npm_tool})"
        log "[${npm_tool}] ERROR: manifest JSON patch failed for '${group_key}' — skipping group."
        return 0
      fi
      mv "$tmp_pkg" "${npm_root}/package.json"

      local npm_inst_rc=0
      dep_runner_npm_prefix "npm install group" "$npm_root" install || npm_inst_rc=$?
      if [[ "$npm_inst_rc" -ne 0 ]]; then
        run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
        dep_updater_append_ecosystem_failure "npm|lockfile install failed for ${group_key} (exit ${npm_inst_rc})"
        log "[${npm_tool}] ERROR: lockfile install failed for '${group_key}' (exit ${npm_inst_rc}) — skipping group."
        return 0
      fi
  esac

  run_command "git worktree" git -C "$worktree_path" add "$(npm_repo_rel_path package.json)"
  # Only stage the lockfile if the project tracks it (not gitignored).
  if ! git -C "$worktree_path" check-ignore -q "$(npm_repo_rel_path "$lockfile")" 2>/dev/null; then
    run_command "git worktree" git -C "$worktree_path" add "$(npm_repo_rel_path "$lockfile")" 2>/dev/null || true
  fi

  # If the update made no changes, there is nothing to commit.
  # Bail out to avoid creating an empty branch that gt submit will reject.
  if git -C "$worktree_path" diff --cached --quiet; then
    log "[${npm_tool}] ${group_key}: no file changes after update — already at latest. Skipping PR."
    return 0
  fi

  # Record the current branch so we know whether to reparent in Graphite.
  local parent_branch
  parent_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"

  # Create branch and commit with git directly so commit.gpgsign/user.signingkey
  # from the global git config are respected. gt create -m bypasses GPG signing.
  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  # Tell Graphite about the branch parentage.
  dep_stack_register_branch "$parent_branch"
  log "[gate] Submitting PR for '${branch}'…"
  dep_stack_submit_current

  # Stay on $branch — the next dep-updater branch will stack on top of it.

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  local npm_body_file
  npm_body_file="$(mktemp)"
  write_npm_pr_body "$group_key" "$safe_key" "$entries" "$npm_audit_lines" "$npm_body_file"
  # gh pr edit exits 1 due to a non-actionable GitHub GraphQL deprecation warning;
  # the PR title and body are cosmetic — the PR itself was already created above.
  dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --title "$commit_msg" \
    --body-file "$npm_body_file" \
    --add-label "dep-updater" || true
  rm -f "$npm_body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "npm" "$group_key" "$first_old" "$first_new" "$branch" "$pr_num" "no" "-"
}

write_npm_pr_body() {
  local -r group_key="$1"
  local -r safe_key="$2"
  local -r entries="$3"
  local -r npm_audit_lines="${4:-}"  # optional: full audit lines to cross-reference CVEs
  local -r body_file="$5"           # caller-provided path (use mktemp)

  {
    printf '%s\n\n' '## Stack Context'
    printf "Automated dependency updates via \`dep-updater\`.\n"
    printf '%s\n\n' 'Each PR bumps exactly one dependency group. Merge the full stack to update all.'
    if [[ -n "$pnpm_ignored_build_pkgs" ]]; then
      printf '\n## Skipped packages\n\n'
      printf "%s\n\n" "pnpm refused to run dependency build scripts (\`ERR_PNPM_IGNORED_BUILDS\`). The following package(s) were skipped in this run:"
      while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        printf -- "- \`%s\`\n" "$p"
      done <<< "$pnpm_ignored_build_pkgs"
      printf "\n%s\n" "To resolve permanently, run \`pnpm approve-builds\` (or \`pnpm approve-builds --all\`)."
    fi
    printf '%s\n\n' '## Updates'
    printf '| Package | From | To |\n'
    printf '|---|---|---|\n'
    while IFS=' ' read -r entry_pkg entry_old entry_new; do
      [[ -z "$entry_pkg" ]] && continue
      printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$entry_pkg" "$entry_old" "$entry_new"
    done <<< "$entries"
    printf '\n- **Ecosystem:** npm (%s)\n' "$npm_tool"
    # Render CVE table for any packages in this group that have known vulnerabilities.
    if [[ -n "$npm_audit_lines" ]]; then
      local cve_section=""
      while IFS=' ' read -r entry_pkg _entry_old _entry_new; do
        [[ -z "$entry_pkg" ]] && continue
        local matched_cves=""
        while IFS=' ' read -r ap _ac _af cves; do
          [[ -z "$ap" ]] && continue
          if [[ "${ap,,}" == "${entry_pkg,,}" && -n "$cves" ]]; then
            matched_cves="$cves"
            break
          fi
        done <<< "$npm_audit_lines"
        if [[ -n "$matched_cves" ]]; then
          local cve
          for cve in ${matched_cves//,/ }; do
            cve_section="${cve_section}| \`${entry_pkg}\` | ${cve} |"$'\n'
          done
        fi
      done <<< "$entries"
      if [[ -n "$cve_section" ]]; then
        printf '\n## CVEs addressed\n\n'
        printf '| Package | CVE |\n'
        printf '|---|---|\n'
        printf '%s' "$cve_section"
      fi
    fi
  } > "$body_file"
}

# ---------------------------------------------------------------------------
# Security audit helpers
# ---------------------------------------------------------------------------

# Emits one "pkg current fix_version cve1,cve2,..." line per vulnerable Python
# package that has a known fix version available. Packages with no fix are
# silently skipped (nothing we can do in a dep-updater PR).

# py_audit_json_payload_from_stdout(raw): strip uv progress noise; emit JSON payload.
py_audit_json_payload_from_stdout() {
  local raw="${1:-}"
  local prefix

  [[ -z "$raw" || "$raw" == 'null' ]] && return 0
  case "$raw" in
    '{'* | '['*) printf '%s' "$raw"; return 0 ;;
  esac
  if [[ "$raw" != *'{'* ]]; then
    return 0
  fi
  prefix="${raw%%\{*}"
  printf '%s' "${raw#"$prefix"}"
}

# py_audit(tool, dir): run pip-audit in the specified directory
py_audit() {
  local -r tool="$1"
  local audit_dir="${2:-$dir}"
  local raw exit_code

  set +e
  case "$tool" in
    uv)
      # --frozen prevents uv from syncing the project environment (which can
      # write uv.lock) before running pip-audit.  The audit is read-only: we
      # only need to inspect already-installed packages, not update them.
      # --no-progress: uv run writes spinners to stdout before pip-audit JSON.
      raw="$(dep_runner_uv_dir_stdout "pip-audit uv" "$audit_dir" -- run --frozen --no-progress --with pip-audit pip-audit --format=json)"
      exit_code=$?
      ;;
    *)
      if ! command -v pip-audit &>/dev/null; then
        return 0  # pip-audit not installed — skip audit silently
      fi
      raw="$(cd "$audit_dir" && pip-audit --format=json 2>/dev/null)"
      exit_code=$?
      ;;
  esac
  set -e

  raw="$(py_audit_json_payload_from_stdout "$raw")"
  [[ -z "$raw" ]] && return 0
  if ! dep_runner_jq_with_args --probe "dep-updater py audit validate" "$raw" -e . >/dev/null 2>&1; then
    return 0
  fi

  # shellcheck disable=SC2016  # jq filter uses $dep variable, not shell expansion
  dep_runner_jq_with_args --probe "dep-updater py audit rows" "$raw" -r '
    .dependencies[]
    | select(.vulns | length > 0)
    | . as $dep
    | .vulns
      | map(select(.fix_versions | length > 0))
      | select(length > 0)
      | {
          name: $dep.name,
          version: $dep.version,
          fix: (map(.fix_versions[]) | sort | last),
          cves: (map(.id) | join(", "))
        }
    | "\(.name) \(.version) \(.fix) \(.cves)"
  ' 2>/dev/null || true
}

# Emits one "pkg current fix_version cve1,cve2,..." line per vulnerable npm
# package where a direct-dep fix is available. Transitive-only vulns are
# skipped (package.json cannot address them without introducing breaking changes).
# Optional $1: project root (defaults to $dir). Pass $worktree_path or dry-run
# audit dir so results align with the tree batch updates apply to.
npm_audit() {
  local raw exit_code
  local -r scan_root="${1:-$dir}"

  set +e
  case "$npm_tool" in
    pnpm) raw="$(pnpm_in_project "$scan_root" audit --json 2>/dev/null)" ;;
    yarn) raw="$(dep_runner_sh_stdout "yarn audit json" -- \
      "yarn --cwd $(printf '%q' "$scan_root") audit --json 2>/dev/null")" ;;
    npm)  raw="$(dep_runner_sh_stdout "npm audit json" -- \
      "npm audit --prefix $(printf '%q' "$scan_root") --json 2>/dev/null")" ;;
  esac
  exit_code=$?
  set -e

  [[ -z "$raw" || "$raw" == '{}' || "$raw" == 'null' ]] && return 0
  case "$raw" in
    '{'* | '['*) ;;
    *) return 0 ;;
  esac
  if ! dep_runner_jq_with_args --probe "dep-updater npm audit validate" "$raw" -e . >/dev/null 2>&1; then
    return 0
  fi

  # npm/pnpm JSON: .vulnerabilities.<name>.{ isDirect, fixAvailable: bool | {name,version} }
  # yarn emits newline-delimited JSON events; filter to advisories.
  if [[ "$npm_tool" == 'yarn' ]]; then
    # yarn audit --json emits one JSON object per line; skip non-advisory lines.
    dep_runner_jq_with_args --probe "dep-updater npm audit yarn rows" "$raw" -r '
      select(.type == "auditAdvisory")
      | .data.advisory
      | select(.findings | any(.paths[]; . == "." or (test("^[^/]+$"))))
      | select(.patched_versions != "<0.0.0")
      | "\(.module_name) \(.findings[0].version) \(.patched_versions | ltrimstr(">=") | ltrimstr(">") | split(" ")[0]) \(.cves | if length > 0 then join(", ") else .id end)"
    ' 2>/dev/null | sort -u || true
  else
    # npm and pnpm share the same audit JSON format.
    dep_runner_jq_with_args --probe "dep-updater npm audit rows" "$raw" -r '
      .vulnerabilities
      | to_entries[]
      | select(.value.isDirect == true)
      | select(.value.fixAvailable | type == "object")
      | {
          name: .key,
          current: (.value.via | map(select(type == "object")) | .[0].range // "unknown"),
          fix: .value.fixAvailable.version,
          cves: (.value.via
            | map(select(type == "object") | .url | split("/") | last)
            | map(select(startswith("GHSA-") or (test("CVE-"))))
            | unique | join(", "))
        }
      | "\(.name) \(.current) \(.fix) \(.cves)"
    ' 2>/dev/null || true
  fi
}

# Write the PR body for a combined security update PR.
# Args: ecosystem  audit_lines  body_file
write_security_pr_body() {
  local -r eco="$1"
  local -r audit_lines="$2"
  local -r body_file="$3"
  {
    printf '## Security: CVE fixes\n\n'
    printf "Automated security updates via \`dep-updater\`.\n\n"
    printf 'Patching all packages with known vulnerabilities that have a fix available.\n\n'
    printf '## Vulnerabilities addressed\n\n'
    printf '| Package | Current | Fixed | CVEs |\n'
    printf '|---|---|---|---|\n'
    while IFS=' ' read -r pkg current fix cves; do
      [[ -z "$pkg" ]] && continue
      printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" \
        "$pkg" "$current" "$fix" "${cves/,/, }"
    done <<< "$audit_lines"
    printf '\n- **Ecosystem:** %s\n' "$eco"
  } > "$body_file"
}

# Creates exactly ONE PR that bumps all npm packages with CVE fixes.
npm_security_update() {
  local -r audit_lines="$1"
  [[ -z "$audit_lines" ]] && return 0

  local -r branch="dep-updates/npm-security"
  local body_file
  body_file="$(mktemp)"

  local pkg_list=""
  while IFS=' ' read -r pkg _current _fix _cves; do
    [[ -z "$pkg" ]] && continue
    pkg_list="${pkg_list} ${pkg}"
  done <<< "$audit_lines"
  pkg_list="${pkg_list# }"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing security branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      run_command "git worktree" git -C "$worktree_path" checkout "$branch"
  dep_stack_register_branch_optional
      dep_stack_submit_current
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then state_append_pr "$existing_pr"; fi
    fi
    run_command "git worktree" git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[${npm_tool}] Security: patching CVE vulnerabilities in ${pkg_list}…"

  local npm_root
  npm_root="$(npm_project_root "$worktree_path")"

  # Restore manifest + lockfile to a clean state.
  local lockfile
  case "$npm_tool" in
    pnpm) lockfile="pnpm-lock.yaml" ;;
    yarn) lockfile="yarn.lock" ;;
    npm)  lockfile="package-lock.json" ;;
  esac
  run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
  run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path "$lockfile")" 2>/dev/null || true

  # Apply audit fixes. npm/pnpm patch manifests + lockfiles in one step.
  case "$npm_tool" in
    pnpm)
      pnpm_in_project "$npm_root" audit --fix 2>/dev/null \
        || pnpm_install_worktree no-frozen "$npm_root"
      ;;
    yarn)
      # yarn has no native audit --fix; upgrade the vulnerable packages directly.
      local -a yarn_args=()
      while IFS=' ' read -r pkg _current fix _cves; do
        [[ -z "$pkg" ]] && continue
        yarn_args+=("${pkg}@${fix}")
      done <<< "$audit_lines"
      dep_runner_yarn_cwd "yarn upgrade" "$npm_root" upgrade "${yarn_args[@]}"
      ;;
    npm)
      dep_runner_sh "npm audit fix" -- \
        "npm audit fix --prefix $(printf '%q' "$npm_root") 2>/dev/null || true"
      ;;
  esac

  run_command "git worktree" git -C "$worktree_path" add "$(npm_repo_rel_path package.json)"
  # Only stage the lockfile if the project tracks it (not gitignored).
  if ! git -C "$worktree_path" check-ignore -q "$(npm_repo_rel_path "$lockfile")" 2>/dev/null; then
    run_command "git worktree" git -C "$worktree_path" add "$(npm_repo_rel_path "$lockfile")" 2>/dev/null || true
  fi

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[${npm_tool}] Security: no file changes after audit fix — already patched or indirect only. Skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"

  local commit_msg="fix(deps): patch CVE vulnerabilities in npm dependencies"
  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"

  dep_stack_register_branch "$parent_branch"
  log "[gate] Submitting security PR for '${branch}'…"
  dep_stack_submit_current

  local submitted_head
  submitted_head="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse "$branch")"

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  write_security_pr_body "${npm_tool}" "$audit_lines" "$body_file"
  dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --title "$commit_msg" \
    --body-file "$body_file" \
    --add-label "dep-updater" \
    --add-label "security" || true
  rm -f "$body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "npm" "npm-security" "-" "-" "$branch" "$pr_num" "yes" "multiple"

  if [[ "$no_wait_ci" == '0' ]]; then
    log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
    wait_for_mergeable_quick "$pr_num"
    log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
    wait_for_ci "$branch" "$submitted_head" "$pr_num"
    if [[ "$(gh_pr_merged_for_number "$pr_num")" != 'true' ]]; then
      log "[gate] CI passed. Final merge conflict check…"
      wait_for_mergeable "$pr_num"
      log "[gate] PR #${pr_num} is mergeable. Proceeding to next update."
    fi
  fi
}

# Creates exactly ONE PR that bumps all Python packages with CVE fixes.
py_security_update() {
  local -r audit_lines="$1"
  local -r tool="$2"
  [[ -z "$audit_lines" ]] && return 0

  local -r branch="dep-updates/py-security"
  local body_file
  body_file="$(mktemp)"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing Python security branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      run_command "git worktree" git -C "$worktree_path" checkout "$branch"
  dep_stack_register_branch_optional
      dep_stack_submit_current
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then state_append_pr "$existing_pr"; fi
    fi
    run_command "git worktree" git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[python/${tool}] Security: patching CVE vulnerabilities…"

  local files_changed=""
  local sec_lock_bak="" sec_pyproject_bak=""
  if [[ "$tool" == "uv" ]]; then
    if [[ -f "${worktree_path}/pyproject.toml" ]]; then
      sec_pyproject_bak="$(mktemp)"
      cp "${worktree_path}/pyproject.toml" "$sec_pyproject_bak"
    fi
    if [[ -f "${worktree_path}/uv.lock" ]]; then
      sec_lock_bak="$(mktemp)"
      cp "${worktree_path}/uv.lock" "$sec_lock_bak"
    fi
  fi
  while IFS=' ' read -r pkg _current fix _cves; do
    [[ -z "$pkg" ]] && continue
    log "[python/${tool}] Security: bumping ${pkg} to ${fix}…"
    case "$tool" in
      uv)
        dep_runner_uv_dir "uv security add" "$worktree_path" -- add "${pkg}==${fix}"
        files_changed="pyproject.toml + uv.lock"
        ;;
      poetry)
        run_in_worktree poetry add "${pkg}@${fix}"
        files_changed="pyproject.toml + poetry.lock"
        ;;
      pipenv)
        run_in_worktree pipenv install "${pkg}==${fix}"
        files_changed="Pipfile + Pipfile.lock"
        ;;
      pip|pip3)
        "$tool" install "${pkg}==${fix}"
        "$tool" freeze > "${worktree_path}/requirements.txt"
        files_changed="requirements.txt"
        ;;
      *)
        die "Unknown Python tool: '$tool'"
        ;;
    esac
  done <<< "$audit_lines"

  if [[ "$tool" == "uv" ]]; then
    local norm_out norm_exit
    norm_out="$(py_uv_normalize_lock "uv security lock normalize" "$worktree_path")" && norm_exit=0 || norm_exit=$?
    if (( norm_exit != 0 )); then
      log "[python/uv] Security: lock normalization failed."
      [[ -n "$norm_out" ]] && log "$norm_out"
      py_uv_restore_after_failed_floor_lock \
        "$worktree_path" "$sec_lock_bak" "$sec_pyproject_bak"
      rm -f "$sec_pyproject_bak" "$sec_lock_bak"
      dep_updater_append_ecosystem_failure "python|security lock normalization failed"
      return 0
    fi
    if ! py_uv_lock_check "uv security lock --check" "$worktree_path"; then
      log "[python/uv] Security: uv lock --check failed after normalize."
      py_uv_restore_after_failed_floor_lock \
        "$worktree_path" "$sec_lock_bak" "$sec_pyproject_bak"
      rm -f "$sec_pyproject_bak" "$sec_lock_bak"
      dep_updater_append_ecosystem_failure "python|security uv lock --check failed after normalize"
      return 0
    fi
    rm -f "$sec_pyproject_bak" "$sec_lock_bak"
  fi

  case "$tool" in
    uv)      git -C "$worktree_path" add pyproject.toml uv.lock ;;
    poetry)  git -C "$worktree_path" add pyproject.toml poetry.lock ;;
    pipenv)  git -C "$worktree_path" add Pipfile Pipfile.lock ;;
    pip|pip3) git -C "$worktree_path" add requirements.txt ;;
  esac

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[python/${tool}] Security: no file changes after patching — already fixed. Skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"

  local commit_msg="fix(deps): patch CVE vulnerabilities in Python dependencies"
  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"

  dep_stack_register_branch "$parent_branch"
  log "[gate] Submitting Python security PR for '${branch}'…"
  dep_stack_submit_current

  local submitted_head
  submitted_head="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse "$branch")"

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  write_security_pr_body "python/${tool}" "$audit_lines" "$body_file"
  dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --title "$commit_msg" \
    --body-file "$body_file" \
    --add-label "dep-updater" \
    --add-label "security" || true
  rm -f "$body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "python" "py-security" "-" "-" "$branch" "$pr_num" "yes" "multiple"

  if [[ "$no_wait_ci" == '0' ]]; then
    log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
    wait_for_mergeable_quick "$pr_num"
    log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
    wait_for_ci "$branch" "$submitted_head" "$pr_num"
    if [[ "$(gh_pr_merged_for_number "$pr_num")" != 'true' ]]; then
      log "[gate] CI passed. Final merge conflict check…"
      wait_for_mergeable "$pr_num"
      log "[gate] PR #${pr_num} is mergeable. Proceeding to next update."
    fi
  fi
}

# ---------------------------------------------------------------------------
# Python helpers
# ---------------------------------------------------------------------------

# Prints one "name current latest" line per outdated package.
# Returns 0 if the package is exactly-pinned in the project's dependency files.
# Returns the constraint operator (>=, ==, ~=) used for a package in
# pyproject.toml.  Used by py_update_one to preserve the original operator
# when bumping a dependency (e.g. keep >= instead of collapsing to ==).
py_constraint_op() {
  local -r pkg="$1"
  local -r pyproject="${2:-${dir}/pyproject.toml}"
  local norm_hyp norm_und op
  norm_hyp="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  norm_und="$(printf '%s' "$norm_hyp" | tr '-' '_')"
  # Direct tables: [project], [project.*] (incl. optional-dependencies), and
  # PEP 735 [dependency-groups]. Not [tool.uv] constraint-dependencies.
  op="$(awk '
    BEGIN { in_direct = 0 }
    /^\[[[:space:]]*(project|project\.[^]]*|dependency-groups)[[:space:]]*\]/ {
      in_direct = 1
      next
    }
    /^\[/ { in_direct = 0; next }
    !in_direct { next }
    /constraint-dependencies/ { next }
    { print }
  ' "$pyproject" 2>/dev/null \
    | grep -iE "\"(${norm_hyp}|${norm_und})(\[[^]]*\])?(>=|==|~=)" 2>/dev/null \
    | grep -oE '>=|==|~=' \
    | head -1 || true)"
  printf '%s' "$op"
}

# Invariant: dep-updater never introduces == pins; it only bumps >= floors.
# However, it respects existing pins for ecosystems where == signals an
# intentional user decision to lock a specific version:
#   pip/pip3/pipenv : requirements.txt — line matching `pkg==version`
#   poetry          : pyproject.toml [tool.poetry.dependencies] —
#                     `pkg = "version"` (bare = exact) or `pkg = "==version"`
#
# uv is intentionally excluded: == in pyproject.toml project.dependencies does
# not represent a deliberate freeze. dep-updater updates those packages and
# promotes the constraint to >= on bump (see py_update_one). The transitive
# constraint check (uv pip install --dry-run) still gates upgrades that would
# violate real transitive constraints.
py_is_pinned() {
  local -r pkg="$1"
  local -r tool="$2"

  # Normalize: lowercase; treat hyphens and underscores as equivalent (PEP 508)
  local norm_pkg us_pkg name_pat
  norm_pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  us_pkg="$(printf '%s' "$norm_pkg" | tr '-' '_')"
  name_pat="(${norm_pkg}|${us_pkg})"

  case "$tool" in
    pip|pip3|pipenv)
      local req_file
      for req_file in \
          "$dir/requirements.txt" \
          "$dir/requirements/base.txt" \
          "$dir/requirements/common.txt" \
          "$dir/requirements/main.txt"; do
        [[ -f "$req_file" ]] || continue
        if rg -qiP "^${name_pat}\s*==" "$req_file" 2>/dev/null; then
          return 0
        fi
      done
      ;;
    poetry)
      # [tool.poetry.dependencies]: `pkg = "2.0.0"` (bare version = exact in poetry)
      # or `pkg = "==2.0.0"` (explicit equality)
      if [[ -f "$dir/pyproject.toml" ]]; then
        if rg -qiP "^\s*${name_pat}\s*=\s*['\"](?:==)?\d" "$dir/pyproject.toml" 2>/dev/null; then
          return 0
        fi
      fi
      ;;
  esac
  return 1
}

# _py_outdated_collapse_lowest_cur_lines <array_name>
# Collapse duplicate package rows before the PyPI eligibility walk, keeping the
# lowest current version (stale floor over installed). Walking from the floor
# still finds newer age-eligible releases; walking only from installed drops
# floor-sync when registry latest is too new (bunnify ruff #285).
_py_outdated_collapse_lowest_cur_lines() {
  local -n lowest_cur_ref=$1
  local -A best_cur_by_pkg=()
  local -A best_line_by_pkg=()
  local line pkg cur _new existing_cur norm_pkg
  local -a collapsed=()
  local pkg_key

  if [[ ${#lowest_cur_ref[@]} -eq 0 ]]; then
    return 0
  fi

  for line in "${lowest_cur_ref[@]}"; do
    [[ -z "$line" ]] && continue
    read -r pkg cur _new <<<"$line"
    [[ -z "$pkg" || -z "$cur" ]] && continue
    norm_pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
    existing_cur="${best_cur_by_pkg[$norm_pkg]:-}"
    if [[ -z "$existing_cur" ]]; then
      best_cur_by_pkg[$norm_pkg]="$cur"
      best_line_by_pkg[$norm_pkg]="$line"
      continue
    fi
    if [[ "$(printf '%s\n%s\n' "$existing_cur" "$cur" | sort -V | head -1)" == "$cur" \
      && "$cur" != "$existing_cur" ]]; then
      best_cur_by_pkg[$norm_pkg]="$cur"
      best_line_by_pkg[$norm_pkg]="$line"
    fi
  done

  collapsed=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && collapsed+=("$line")
  done < <(
    for pkg_key in "${!best_line_by_pkg[@]}"; do
      printf '%s\n' "${best_line_by_pkg[$pkg_key]}"
    done | sort
  )
  lowest_cur_ref=("${collapsed[@]}")
}

# _py_outdated_dedupe_candidate_lines <array_name>
# Collapse duplicate package rows, keeping the highest proposed version.
_py_outdated_dedupe_candidate_lines() {
  local -n lines_ref=$1
  local -A best_new_by_pkg=()
  local -A best_line_by_pkg=()
  local line pkg _cur new existing_new norm_pkg
  local -a deduped=()
  local pkg_key

  if [[ ${#lines_ref[@]} -eq 0 ]]; then
    return 0
  fi

  for line in "${lines_ref[@]}"; do
    [[ -z "$line" ]] && continue
    read -r pkg _cur new <<<"$line"
    [[ -z "$pkg" || -z "$new" ]] && continue
    norm_pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
    existing_new="${best_new_by_pkg[$norm_pkg]:-}"
    if [[ -z "$existing_new" ]]; then
      best_new_by_pkg[$norm_pkg]="$new"
      best_line_by_pkg[$norm_pkg]="$line"
      continue
    fi
    if [[ "$(printf '%s\n%s\n' "$existing_new" "$new" | sort -V | tail -1)" == "$new" \
      && "$new" != "$existing_new" ]]; then
      best_new_by_pkg[$norm_pkg]="$new"
      best_line_by_pkg[$norm_pkg]="$line"
    fi
  done

  deduped=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && deduped+=("$line")
  done < <(
    for pkg_key in "${!best_line_by_pkg[@]}"; do
      printf '%s\n' "${best_line_by_pkg[$pkg_key]}"
    done | sort
  )
  lines_ref=("${deduped[@]}")
}

py_outdated() {
  local -r tool="$1"
  local -r target_dir="${2:-$dir}"
  local raw_lines pyproject installed_json ge_dep ge_pkg ge_floor ge_installed ge_lower
  local eligible
  local -a raw_line_arr=()
  installed_json=""
  case "$tool" in
    uv)
      raw_lines="$(dep_runner_jq_with_args "dep-updater uv outdated rows" \
        "$(dep_runner_uv_dir_stdout "uv pip list outdated" "$target_dir" -- pip list --outdated --format=json 2>/dev/null)" \
        -r '.[] | "\(.name) \(.version) \(.latest_version)"')"
      ;;
    poetry)
      # poetry show --outdated has no stable JSON output; parse the table instead
      raw_lines="$(dep_runner_poetry_dir_stdout "poetry show outdated" "$target_dir" show --outdated 2>/dev/null \
        | awk '/^[a-zA-Z]/ { print $1, $2, $3 }')"
      ;;
    pipenv)
      raw_lines="$(dep_runner_jq_with_args "dep-updater pipenv outdated rows" \
        "$(cd "$target_dir" && pipenv run pip list --outdated --format=json 2>/dev/null)" \
        -r '.[] | "\(.name) \(.version) \(.latest_version)"')"
      ;;
    pip|pip3)
      raw_lines="$(dep_runner_jq_with_args "dep-updater pip outdated rows" \
        "$(cd "$target_dir" && "$tool" list --outdated --format=json 2>/dev/null)" \
        -r '.[] | "\(.name) \(.version) \(.latest_version)"')"
      ;;
    *)
      die "Unknown Python tool: '$tool'"
      ;;
  esac

  # For uv projects: also detect stale >= constraint floors in pyproject.toml.
  # uv pip list --outdated only flags packages where installed < latest on PyPI;
  # it silently ignores the case where the declared floor is lower than the
  # installed version (e.g. "django>=6.0" installed at 6.0.4 — the floor should
  # be bumped to >=6.0.4 so the project always requires the patched minimum).
  if [[ "$tool" == "uv" ]]; then
    pyproject="${target_dir}/pyproject.toml"
    if [[ -f "$pyproject" ]]; then
      installed_json="$(dep_runner_uv_dir_stdout "uv pip list installed" "$target_dir" -- pip list --format=json 2>/dev/null)"
      while IFS= read -r ge_dep; do
        [[ -z "$ge_dep" ]] && continue
        # Strip extras ([...]) then >= and version to get the package name.
        ge_pkg="$(printf '%s' "$ge_dep" \
          | sed 's/[[:space:]]*>=[[:space:]]*.*//' \
          | sed 's/\[.*//')"
        # Extract just the floor version, stopping at any trailing specifier.
        ge_floor="$(printf '%s' "$ge_dep" \
          | sed 's/.*>=[[:space:]]*//' \
          | sed 's/[,;[:space:]].*//')"
        [[ -z "$ge_floor" || -z "$ge_pkg" ]] && continue
        # Validate PEP 508 package name — drop any mangled strings.
        [[ "$ge_pkg" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
        ge_installed="$(dep_runner_jq_with_args "jq ge installed version" "$installed_json" -r --arg n "$ge_pkg" \
              '.[] | select(.name | ascii_downcase == ($n | ascii_downcase)) | .version')"
        # Skip if not installed or floor already matches installed.
        [[ -z "$ge_installed" || "$ge_floor" == "$ge_installed" ]] && continue
        # Use sort -V: if the smaller of the two is the floor, the floor is stale.
        ge_lower="$(printf '%s\n%s\n' "$ge_floor" "$ge_installed" | sort -V | head -1)"
        if [[ "$ge_lower" == "$ge_floor" ]]; then
          # Always merge a stale-floor row (cur=floor, new=installed). uv-outdated
          # may already list installed→registry-latest; that row can be dropped when
          # latest is too new, which must not suppress floor sync (bunnify ruff #285).
          if [[ -n "$raw_lines" ]]; then
            raw_lines="${raw_lines}
${ge_pkg} ${ge_floor} ${ge_installed}"
          else
            raw_lines="${ge_pkg} ${ge_floor} ${ge_installed}"
          fi
        fi
      done < <(awk '
        BEGIN { in_direct = 0 }
        /^\[[[:space:]]*(project|project\.[^]]*|dependency-groups)[[:space:]]*\]/ {
          in_direct = 1
          next
        }
        /^\[/ { in_direct = 0; next }
        !in_direct { next }
        /constraint-dependencies/ { next }
        {
          s = $0
          while (1) {
            if (match(s, /"[A-Za-z0-9][A-Za-z0-9._-]*[^"=<>!~,]*>=[^"]*"/)) {
              print substr(s, RSTART+1, RLENGTH-2)
              s = substr(s, RSTART+RLENGTH)
            } else break
          }
        }
      ' "$pyproject" 2>/dev/null)
    fi
  fi

  local -a candidate_lines=()
  local -a direct_candidates=()
  local -a transitive_candidates=()
  local -a direct_passing=()
  local -a direct_failing=()
  local -a union_direct=()
  local constraint_op pkg cur new line
  local filter_out filter_rc filter_unverifiable=0
  local line_item

  while IFS= read -r line; do
    [[ -n "$line" ]] && raw_line_arr+=("$line")
  done <<< "$raw_lines"
  if [[ ${#raw_line_arr[@]} -gt 0 ]]; then
    # One PyPI walk per package: keep the stale-floor cur when both a uv-outdated
    # row and a floor row exist (do not drop the floor row — that reintroduces #285).
    _py_outdated_collapse_lowest_cur_lines raw_line_arr
  fi

  for line in "${raw_line_arr[@]}"; do
    [[ -z "$line" ]] && continue
    read -r pkg cur new <<<"$line"
    [[ -z "$pkg" ]] && continue
    # Validate PEP 508 package name — drop any mangled strings from raw_lines.
    [[ "$pkg" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
    if py_is_pinned "$pkg" "$tool"; then
      log "[python/${tool}] Skipping exactly-pinned package: ${pkg} (${cur})"
      continue
    fi
    # Walk PyPI for the newest release-age-eligible version newer than cur.
    # Covers outdated (latest too new) and floor-only bumps where new==installed
    # but that installed version is still inside the age window (e.g. bunnify
    # ruff floor >=0.15.17, lock 0.15.22 <9d → propose >=0.15.21).
    eligible="$(py_pick_eligible_new_version "$pkg" "$cur" 2>/dev/null || true)"
    if [[ -n "$eligible" ]]; then
      new="$eligible"
    elif ! py_version_meets_minimum_release_age "$pkg" "$new"; then
      continue
    fi
    candidate_lines+=("$pkg $cur $new")
  done

  if [[ ${#candidate_lines[@]} -gt 0 ]]; then
    _py_outdated_dedupe_candidate_lines candidate_lines
  fi

  if [[ "$tool" != "uv" ]]; then
    for line in "${candidate_lines[@]}"; do
      printf '%s\n' "$line"
    done
    return 0
  fi

  for line in "${candidate_lines[@]}"; do
    read -r pkg _cur _new <<<"$line"
    constraint_op="$(py_constraint_op "$pkg" "${target_dir}/pyproject.toml")"
    if [[ "$constraint_op" == ">=" || "$constraint_op" == "==" || "$constraint_op" == "~=" ]]; then
      direct_candidates+=("$line")
    else
      transitive_candidates+=("$line")
    fi
  done

  # Dry-run probe is current-platform only; packages that pass can still fail
  # multi-environment `uv lock` (darwin/win32/PyPy markers). Always batch-filter
  # the surviving direct set with py_uv_filter_outdated_lines before emitting.
  for line in "${direct_candidates[@]}"; do
    read -r pkg cur new <<<"$line"
    if py_uv_probe_transitive_upgrade "$target_dir" "$installed_json" "$pkg" "$cur" "$new"; then
      direct_passing+=("$line")
    else
      direct_failing+=("$line")
    fi
  done

  if [[ ${#direct_passing[@]} -gt 0 ]]; then
    filter_rc=0
    filter_out="$(py_uv_filter_outdated_lines "$target_dir" "${direct_passing[@]}")" \
      && filter_rc=0 || filter_rc=$?
    if (( filter_rc != 0 )); then
      # Unverifiable lock (network/tool) must not silently drop dry-run-passing
      # directs — fall back to pre-filter emit and surface in the batch report.
      log "[python/uv] WARNING: lockfile filter unverifiable; falling back to dry-run-passing direct updates."
      dep_updater_append_ecosystem_failure \
        "python|lock verify unverifiable; emitted dry-run-passing directs without lockfile filter"
      filter_unverifiable=1
      union_direct+=("${direct_passing[@]}")
    elif [[ -n "$filter_out" ]]; then
      while IFS= read -r line_item; do
        [[ -n "$line_item" ]] && union_direct+=("$line_item")
      done <<<"$filter_out"
    fi
  fi

  if [[ ${#direct_failing[@]} -gt 0 ]]; then
    filter_rc=0
    filter_out="$(py_uv_filter_outdated_lines "$target_dir" "${direct_failing[@]}")" \
      && filter_rc=0 || filter_rc=$?
    if (( filter_rc != 0 )); then
      log "[python/uv] WARNING: lockfile filter unverifiable for dry-run-failing directs; skipping those candidates."
      dep_updater_append_ecosystem_failure \
        "python|lock verify unverifiable; skipped dry-run-failing directs"
      filter_unverifiable=1
    elif [[ -n "$filter_out" ]]; then
      while IFS= read -r line_item; do
        [[ -n "$line_item" ]] && union_direct+=("$line_item")
      done <<<"$filter_out"
    fi
  fi

  # Joint lock check: survivors from separate group filters can still conflict
  # when applied together in batch_update_all.
  if [[ ${#union_direct[@]} -gt 0 ]]; then
    if (( filter_unverifiable == 0 )) && [[ ${#union_direct[@]} -gt 1 ]]; then
      filter_rc=0
      filter_out="$(py_uv_filter_outdated_lines "$target_dir" "${union_direct[@]}")" \
        && filter_rc=0 || filter_rc=$?
      if (( filter_rc != 0 )); then
        log "[python/uv] WARNING: joint lockfile filter unverifiable; emitting per-group survivors."
        dep_updater_append_ecosystem_failure \
          "python|joint lock verify unverifiable; emitted per-group survivors"
        printf '%s\n' "${union_direct[@]}"
      elif [[ -n "$filter_out" ]]; then
        printf '%s\n' "$filter_out"
      fi
    else
      printf '%s\n' "${union_direct[@]}"
    fi
  fi

  for line in "${transitive_candidates[@]}"; do
    read -r pkg cur new <<<"$line"
    if py_uv_probe_transitive_upgrade "$target_dir" "$installed_json" "$pkg" "$cur" "$new"; then
      printf '%s\n' "$line"
    fi
  done
}

# py_uv_rewrite_version_floor <pyproject_path> <pkg> <new_ver>
# Rewrites a PEP 508 dependency floor in [project].dependencies-style entries:
#   "pkg>=1.0.0" / "pkg[extra]>=1.0.0" (bundled) or "pkg[extra]" >= 1.0.0 / "pkg" >= 1.0.0
# Compound caps such as "pkg>=1.0.0,<2" are rewritten to "pkg>=2.0.0" (drops the upper
# bound — not an intentional freeze). A trailing PEP 508 environment marker is kept.
# Two sed passes (bundled before split). Converts
# == and ~= to >=. Returns 1 when sed fails or the constraint line did not change.
py_uv_rewrite_version_floor() {
  local -r path="$1"
  local -r pkg="$2"
  local -r new_ver="$3"
  local sed_pkg sed_new_ver before

  before="$(mktemp)"
  cp "$path" "$before"
  sed_pkg="$(printf '%s' "$pkg" | sed 's/[.]/\\./g')"
  sed_new_ver="$(printf '%s' "$new_ver" | sed 's/[\\&#]/\\&/g')"
  # Bundled: version + optional ,<cap; keep a trailing ;environment-marker.
  gnu_sed_inplace -E "$path" \
    -e "s#(\\\"${sed_pkg}(\\[[a-zA-Z0-9,_=.-]+\\])?)(~=|>=|==)[0-9][0-9a-zA-Z.]*(,[[:space:]]*<[0-9][0-9a-zA-Z.]*)?(;[^\\\"]*)?\\\"#\\1>=${sed_new_ver}\\5\\\"#" \
    -e "s#(\\\"${sed_pkg}(\\[[a-zA-Z0-9,_=.-]+\\])?\")[[:space:]]*(~=|>=|==)[[:space:]]*[0-9][0-9a-zA-Z.]*([[:space:]]*,[[:space:]]*<[0-9][0-9a-zA-Z.]*)?#\\1 >= ${sed_new_ver}#" \
    || {
      cp "$before" "$path"
      rm -f "$before"
      return 1
    }
  if cmp -s "$path" "$before"; then
    cp "$before" "$path"
    rm -f "$before"
    return 1
  fi
  rm -f "$before"
  return 0
}

# py_uv_parse_verify_filter_pkg <logfile>
# Prints a direct dependency to drop from py_uv_filter_outdated_lines pending set.
py_uv_parse_verify_filter_pkg() {
  local -r log_file="$1"
  local line pkg

  line="$(grep -E 'lock did not land ' "$log_file" 2>/dev/null \
    | head -n 1 || true)"
  if [[ -z "$line" ]]; then
    return 1
  fi
  pkg="$(printf '%s' "$line" \
    | sed -nE 's/.*lock did not land ([A-Za-z0-9][A-Za-z0-9._-]*).*/\1/p' \
    | head -n 1)"
  if [[ -z "$pkg" ]]; then
    return 1
  fi
  pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  printf '%s' "$pkg"
  return 0
}

# py_uv_parse_blame_direct_dep <logfile>
# Prints a pyproject.toml direct dependency name blocking resolution (empty if unknown).
py_uv_parse_blame_direct_dep() {
  local -r log_file="$1"
  local line blame

  line="$(grep -E 'you require |your project depends on ' "$log_file" 2>/dev/null | head -n 1 || true)"
  if [[ -z "$line" ]]; then
    return 1
  fi
  blame="$(printf '%s' "$line" \
    | sed -nE 's/.*(you require|your project depends on) ([A-Za-z0-9][A-Za-z0-9._-]*).*/\2/p' \
    | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  if [[ -z "$blame" ]]; then
    return 1
  fi
  printf '%s' "$blame"
  return 0
}

# py_uv_try_lockfile_with_updates <scan_root> <logfile> <line>...
# Patches pyproject.toml floors for direct deps, runs uv lock, restores originals.
# Returns 0 when the lockfile resolves.
py_uv_try_lockfile_with_updates() {
  local -r scan_root="$1"
  local -r log_file="$2"
  shift 2
  local -a lines=("$@")
  local -a floor_pkgs=()
  local pyproject lockfile bak_proj bak_lock line pkg _cur new_ver op rc

  if [[ ${#lines[@]} -eq 0 ]]; then
    return 0
  fi

  pyproject="${scan_root}/pyproject.toml"
  lockfile="${scan_root}/uv.lock"
  if [[ ! -f "$pyproject" ]]; then
    return 1
  fi

  bak_proj="$(mktemp)"
  cp "$pyproject" "$bak_proj"
  bak_lock=""
  if [[ -f "$lockfile" ]]; then
    bak_lock="$(mktemp)"
    cp "$lockfile" "$bak_lock"
  fi

  for line in "${lines[@]}"; do
    [[ -z "$line" ]] && continue
    read -r pkg _cur new_ver <<<"$line"
    [[ -z "$pkg" || -z "$new_ver" ]] && continue
    op="$(py_constraint_op "$pkg" "$pyproject")"
    if [[ "$op" == ">=" || "$op" == "==" || "$op" == "~=" ]]; then
      # No-op rewrite still proceeds to lock (stale uv.lock with an already-raised
      # floor must not be dropped from the plan).
      py_uv_rewrite_version_floor "$pyproject" "$pkg" "$new_ver" || true
      floor_pkgs+=("$pkg")
    fi
  done

  set +e
  py_uv_floor_lock "uv lock verify" "$scan_root" "${floor_pkgs[@]}" >>"$log_file" 2>&1
  rc=$?
  set -e

  if (( rc == 0 )); then
    for line in "${lines[@]}"; do
      [[ -z "$line" ]] && continue
      read -r pkg _cur new_ver <<<"$line"
      [[ -z "$pkg" || -z "$new_ver" ]] && continue
      op="$(py_constraint_op "$pkg" "$bak_proj")"
      if [[ "$op" != ">=" && "$op" != "==" && "$op" != "~=" ]]; then
        continue
      fi
      highest="$(py_uv_lock_highest_version "$lockfile" "$pkg" 2>/dev/null || true)"
      if ! py_uv_version_at_least "$highest" "$new_ver"; then
        printf 'lock did not land %s at %s (highest %s)\n' \
          "$pkg" "$new_ver" "${highest:-?}" >>"$log_file"
        rc=1
        break
      fi
    done
  fi

  cp "$bak_proj" "$pyproject"
  rm -f "$bak_proj"
  if [[ -n "$bak_lock" ]]; then
    cp "$bak_lock" "$lockfile"
    rm -f "$bak_lock"
  else
    rm -f "$lockfile"
  fi

  return "$rc"
}

# py_uv_filter_outdated_lines <scan_root> <line>...
# Drops direct pyproject.toml updates that cannot resolve together (batch uv lock).
# Returns 0 with surviving lines on stdout. Returns 1 (no stdout) when uv lock
# fails for a non-resolution reason (network/tool) or an unparsed resolver error
# so callers can fall back / report instead of silently dropping the set.
py_uv_filter_outdated_lines() {
  local -r scan_root="$1"
  shift
  local -a pending_outdated=("$@")
  local -a next_outdated filtered_lines
  local log_file blame_pkg line pkg _cur lat norm_blame norm_pkg
  local found_blame_in_pending=0 found_conflict_in_pending=0

  if [[ ${#pending_outdated[@]} -eq 0 ]]; then
    return 0
  fi

  if [[ "${DEP_UPDATER_SKIP_PYPI_REGISTRY:-0}" == '1' ]]; then
    printf '%s\n' "${pending_outdated[@]}"
    return 0
  fi

  log_file="$(mktemp)"

  while [[ ${#pending_outdated[@]} -gt 0 ]]; do
    : >"$log_file"
    if py_uv_try_lockfile_with_updates "$scan_root" "$log_file" "${pending_outdated[@]}"; then
      filtered_lines=("${pending_outdated[@]}")
      rm -f "$log_file"
      printf '%s\n' "${filtered_lines[@]}"
      return 0
    fi

    if ! grep -qF 'No solution found when resolving dependencies' "$log_file"; then
      blame_pkg="$(py_uv_parse_verify_filter_pkg "$log_file" 2>/dev/null || true)"
      if [[ -n "$blame_pkg" ]]; then
        next_outdated=()
        found_blame_in_pending=0
        for line in "${pending_outdated[@]}"; do
          read -r pkg _cur lat <<<"$line"
          norm_pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
          norm_blame="$(printf '%s' "$blame_pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
          if [[ "$norm_pkg" == "$norm_blame" ]]; then
            log "[python/uv] Filtering ${pkg} → ${lat}: lock did not land ${lat}."
            found_blame_in_pending=1
            continue
          fi
          next_outdated+=("$line")
        done
        if [[ "$found_blame_in_pending" -eq 1 ]]; then
          pending_outdated=("${next_outdated[@]}")
          if [[ ${#pending_outdated[@]} -eq 0 ]]; then
            rm -f "$log_file"
            return 0
          fi
          continue
        fi
      fi
      log "[python/uv] WARNING: could not verify proposed updates against lockfile (non-resolution uv lock failure)."
      rm -f "$log_file"
      return 1
    fi

    blame_pkg="$(py_uv_parse_blame_direct_dep "$log_file" 2>/dev/null || true)"
    if [[ -z "$blame_pkg" ]]; then
      log "[python/uv] WARNING: lockfile verification failed (unparsed uv resolver error)."
      rm -f "$log_file"
      return 1
    fi

    next_outdated=()
    found_blame_in_pending=0
    for line in "${pending_outdated[@]}"; do
      read -r pkg _cur lat <<<"$line"
      norm_pkg="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
      norm_blame="$(printf '%s' "$blame_pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
      if [[ "$norm_pkg" == "$norm_blame" ]]; then
        log "[python/uv] Filtering ${pkg} → ${lat}: lockfile resolution failed (coupled or incompatible upgrade)."
        found_blame_in_pending=1
        continue
      fi
      next_outdated+=("$line")
    done

    if [[ "$found_blame_in_pending" -eq 1 ]]; then
      pending_outdated=("${next_outdated[@]}")
      continue
    fi

    next_outdated=()
    found_conflict_in_pending=0
    for line in "${pending_outdated[@]}"; do
      read -r pkg _cur lat <<<"$line"
      if grep -qiF "${pkg}" "$log_file" && grep -qiF "${lat}" "$log_file"; then
        log "[python/uv] Filtering ${pkg} → ${lat}: lockfile resolution failed (blocked by ${blame_pkg})."
        found_conflict_in_pending=1
        continue
      fi
      next_outdated+=("$line")
    done

    if [[ "$found_conflict_in_pending" -eq 1 ]]; then
      pending_outdated=("${next_outdated[@]}")
      continue
    fi

    read -r pkg _cur lat <<<"${pending_outdated[0]}"
    log "[python/uv] Filtering ${pkg} → ${lat}: lockfile resolution failed (blocked by ${blame_pkg})."
    pending_outdated=("${pending_outdated[@]:1}")

    if [[ ${#pending_outdated[@]} -eq 0 ]]; then
      rm -f "$log_file"
      return 0
    fi
  done

  rm -f "$log_file"
  return 0
}

# py_uv_restore_after_failed_floor_lock <worktree> [lock_bak] [pyproject_bak]
# After a failed batch floor `uv lock`: restore pyproject.toml from pyproject_bak
# when provided (preserves earlier-in-batch security `uv add` edits), else revert
# it with checkout. Restore uv.lock from the pre-lock snapshot when present.
# Never `git clean` the lock (that deletes a pre-existing untracked lock). With
# no lock snapshot, checkout tracked lock or remove a lock that the failed
# command newly created.
py_uv_restore_after_failed_floor_lock() {
  local -r worktree="$1"
  local -r lock_bak="${2:-}"
  local -r pyproject_bak="${3:-}"

  if [[ -n "$pyproject_bak" ]]; then
    cp "$pyproject_bak" "${worktree}/pyproject.toml"
  else
    run_command "git worktree" git -C "$worktree" checkout -- pyproject.toml 2>/dev/null || true
  fi
  if [[ -n "$lock_bak" ]]; then
    cp "$lock_bak" "${worktree}/uv.lock"
    rm -f "$lock_bak"
    return 0
  fi
  run_command "git worktree" git -C "$worktree" checkout -- uv.lock 2>/dev/null || true
  if [[ -f "${worktree}/uv.lock" ]] \
    && ! git -C "$worktree" ls-files --error-unmatch -- uv.lock >/dev/null 2>&1; then
    rm -f "${worktree}/uv.lock"
  fi
}

# py_uv_exclude_newer_cutoff_iso
# UTC timestamp for uv --exclude-newer-package (release-age gate).
# dep_updater_minimum_release_age_minutes is a script-level readonly set at load.
py_uv_exclude_newer_cutoff_iso() {
  local now_epoch cutoff_epoch
  now_epoch="$(time_log_now_utc_epoch)" || return 1
  cutoff_epoch=$(( now_epoch - dep_updater_minimum_release_age_minutes * 60 ))
  time_log_epoch_to_iso8601_utc "$cutoff_epoch"
}

# py_uv_floor_lock <label> <dir> [pkg...]
# uv lock with --exclude-newer-package for each pkg so a raised >= floor cannot
# resolve a release still inside the 9-day window.
py_uv_floor_lock() {
  local -r label="$1"
  local -r uv_dir="$2"
  shift 2
  local cutoff pkg
  local -a lock_args=()

  cutoff="$(py_uv_exclude_newer_cutoff_iso)" || return 1
  lock_args=(lock)
  for pkg in "$@"; do
    [[ -z "$pkg" ]] && continue
    lock_args+=(--exclude-newer-package "${pkg}=${cutoff}")
  done
  dep_runner_uv_dir_capture "$label" "$uv_dir" -- "${lock_args[@]}"
}

# py_uv_lock_check <label> <dir>
# Returns 0 when uv.lock matches pyproject.toml (plain uv lock --check).
py_uv_lock_check() {
  local -r label="$1"
  local -r uv_dir="$2"
  local rc

  rc=0
  dep_runner_uv_dir --probe "$label" "$uv_dir" -- lock --check >/dev/null 2>&1 || rc=$?
  return "$rc"
}

# py_uv_normalize_lock <label> <dir>
# Age-gated `uv lock` calls write [options.exclude-newer-package] into uv.lock.
# Strip that metadata in-place so consumers' `uv lock --check` passes without
# re-resolving (plain `uv lock` would drop the release-age cutoff).
py_uv_normalize_lock() {
  local -r _label="$1"
  local -r uv_dir="$2"
  local lockfile="${uv_dir}/uv.lock"

  if ! py_uv_strip_exclude_newer_from_lock "$lockfile"; then
    printf '%s\n' "failed to strip exclude-newer metadata from uv.lock"
    return 1
  fi
  return 0
}

# py_uv_strip_exclude_newer_from_lock <lockfile>
# Remove [options.exclude-newer-package] without changing resolved packages.
py_uv_strip_exclude_newer_from_lock() {
  local -r lockfile="$1"
  local tmp rc quoted_lock quoted_tmp

  [[ -f "$lockfile" ]] || return 1
  rc=0
  runner_sh "uv lock strip probe" --probe -- \
    grep -qF '[options.exclude-newer-package]' "$lockfile" >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    return 0
  fi
  tmp="$(runner_sh_stdout "uv lock strip tempfile" -- mktemp)"
  quoted_lock="$(printf '%q' "$lockfile")"
  quoted_tmp="$(printf '%q' "$tmp")"
  if ! dep_runner_sh "uv lock strip exclude-newer" -- \
    "awk '/^\\[options\\.exclude-newer-package\\]/ { skip=1; next } skip && /^\\[/ { skip=0 } skip { next } { print }' ${quoted_lock} >${quoted_tmp}"; then
    runner_sh "uv lock strip cleanup" -- rm -f "$tmp"
    return 1
  fi
  dep_runner_sh "uv lock strip install" -- "mv -f ${quoted_tmp} ${quoted_lock}"
}

# py_uv_version_at_least <ver> <minimum>
# Returns 0 when ver is semantically >= minimum (sort -V).
py_uv_version_at_least() {
  local -r ver="$1"
  local -r minimum="$2"

  [[ -n "$ver" && -n "$minimum" ]] || return 1
  [[ "$(printf '%s\n' "$minimum" "$ver" | sort -V | head -1)" == "$minimum" ]]
}

# py_uv_lock_highest_version <lockfile> <pkg>
# Prints the highest version of pkg in a uv.lock (marker splits may list several).
py_uv_lock_highest_version() {
  local -r lockfile="$1"
  local -r pkg="$2"
  local pkg_lc versions
  [[ -f "$lockfile" ]] || return 1
  pkg_lc="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '._' '-')"
  versions="$(awk -v want="$pkg_lc" '
    /^name = "/ {
      name = $0
      sub(/^name = "/, "", name)
      sub(/"$/, "", name)
      gsub(/[._]/, "-", name)
      tracking = (tolower(name) == want)
      next
    }
    tracking && /^version = "/ {
      ver = $0
      sub(/^version = "/, "", ver)
      sub(/"$/, "", ver)
      print ver
      tracking = 0
    }
  ' "$lockfile")"
  [[ -n "$versions" ]] || return 1
  printf '%s\n' "$versions" | sort -V | tail -n 1
}

# py_uv_lock_upgrade_package <worktree> <pkg> <new_ver>
# Upgrades a transitive (or unconstrained) package via
# `uv lock --upgrade-package` so marker-split resolution can keep an older
# pin on exotic environments (e.g. PyPy+win32) while landing the new version
# elsewhere. `uv add pkg==ver` forces a universal pin and fails in those cases.
# Returns 0 when the lock's highest version for pkg equals new_ver.
py_uv_lock_upgrade_package() {
  local -r worktree="$1"
  local -r pkg="$2"
  local -r new_ver="$3"
  local cutoff lockfile before after out exit_code

  lockfile="${worktree}/uv.lock"
  [[ -f "$lockfile" ]] || return 1
  cutoff="$(py_uv_exclude_newer_cutoff_iso)" || return 1
  before="$(py_uv_lock_highest_version "$lockfile" "$pkg" 2>/dev/null || true)"
  # Gate only the target package's age. A global --exclude-newer would also
  # reject same-run CVE pins (and any other lock entries newer than the cutoff),
  # so uv fails resolution and every transitive upgrade in that batch is skipped.
  # Note: uv requires PACKAGE=DATE (not @ or ==) for --exclude-newer-package.
  out="$(dep_runner_uv_dir_capture "uv lock --upgrade-package ${pkg}" "$worktree" -- \
    lock --upgrade-package "$pkg" \
    --exclude-newer-package "${pkg}=${cutoff}")" \
    && exit_code=0 || exit_code=$?
  if (( exit_code != 0 )); then
    printf '%s' "$out"
    return "$exit_code"
  fi
  after="$(py_uv_lock_highest_version "$lockfile" "$pkg" 2>/dev/null || true)"
  if [[ "$after" != "$new_ver" ]]; then
    log "[python/uv] ${pkg}: lock upgrade left version at '${after:-?}' (wanted ${new_ver}; was ${before:-?})."
    return 1
  fi
  return 0
}

# py_uv_actual_lines_from_lock <worktree> <planned_lines>
# Emits planned "pkg old new" rows whose staged uv.lock highest version equals
# new and differs from HEAD (so pre-existing lock matches are not reported as
# landings after a reverted floor bump).
py_uv_actual_lines_from_lock() {
  local -r worktree="$1"
  local -r planned_lines="$2"
  local lockfile pkg old_ver new_ver highest head_lock head_highest
  lockfile="${worktree}/uv.lock"
  [[ -f "$lockfile" && -n "$planned_lines" ]] || return 0
  # No staged lock change ⇒ nothing transitive landed this run.
  if git -C "$worktree" diff --cached --quiet -- uv.lock 2>/dev/null; then
    return 0
  fi
  head_lock="$(mktemp)"
  # Missing HEAD lock (first-ever / untracked) ⇒ empty baseline so staged
  # landings still report instead of silently dropping every transitive row.
  if ! git -C "$worktree" show HEAD:uv.lock >"$head_lock" 2>/dev/null; then
    : >"$head_lock"
  fi
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" || -z "$new_ver" ]] && continue
    highest="$(py_uv_lock_highest_version "$lockfile" "$pkg" 2>/dev/null || true)"
    head_highest="$(py_uv_lock_highest_version "$head_lock" "$pkg" 2>/dev/null || true)"
    if [[ "$highest" == "$new_ver" && "$highest" != "$head_highest" ]]; then
      printf '%s %s %s\n' "$pkg" "${old_ver:--}" "$new_ver"
    fi
  done <<< "$planned_lines"
  rm -f "$head_lock"
}

# py_uv_probe_transitive_upgrade <scan_root> <installed_json> <pkg> <cur> <new>
# Per-package dry-run for outdated packages not declared in pyproject.toml.
py_uv_probe_transitive_upgrade() {
  local -r scan_root="$1"
  local -r installed_json="$2"
  local -r pkg="$3"
  local -r cur="$4"
  local -r new="$5"
  local installed_new dry_req_tmp dry_req_rc

  [[ -n "$installed_json" ]] || return 0

  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
  installed_new="$(dep_runner_jq_with_args "jq installed pkg version" "$installed_json" -r --arg n "$pkg" \
        '.[] | select(.name | ascii_downcase == ($n | ascii_downcase)) | .version' \
      2>/dev/null || true)"
  if [[ "$new" == "$installed_new" ]]; then
    return 0
  fi

  dry_req_tmp="$(mktemp)"
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
  dep_runner_jq_with_args "jq uv dry-run requirements" "$installed_json" -r --arg p "$pkg" --arg v "$new" \
          '.[] | select(has("editable_project_location") | not)
               | if (.name | ascii_downcase) == ($p | ascii_downcase)
                 then "\(.name)==" + $v
                 else "\(.name)==\(.version)"
                 end' >"$dry_req_tmp"
  dry_req_rc=0
  dep_runner_uv_dir --probe "uv pip install dry-run" "$scan_root" -- pip install --dry-run -r "$dry_req_tmp" \
    >/dev/null 2>&1 || dry_req_rc=$?
  rm -f "$dry_req_tmp"
  if [[ "$dry_req_rc" -ne 0 ]]; then
    log "[python/uv] Filtering ${pkg} ${new}: transitive constraint blocks this upgrade."
    return 1
  fi
  return 0
}

py_update_one() {
  local -r pkg="$1"
  local -r old_ver="$2"
  local -r new_ver="$3"
  local -r tool="$4"
  local -r py_audit_lines="${5:-}"  # optional: full audit lines to cross-reference CVEs
  local safe_name
  safe_name="$(sanitize_branch_name "$pkg")"
  local -r branch="dep-updates/py-${safe_name}"
  local -r commit_msg="chore(deps): bump ${pkg} from ${old_ver} to ${new_ver}"
  local files_changed=""

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing branch: ${branch}"
    register_existing_branch_state "$branch"
    # A previous run may have created the branch but died before submitting the PR.
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      run_command "git worktree" git -C "$worktree_path" checkout "$branch"
  dep_stack_register_branch_optional
      dep_stack_submit_current
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then
        state_append_pr "$existing_pr"
      fi
    fi
    # Position worktree on this branch so the next update stacks on top of it.
    run_command "git worktree" git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  case "$tool" in
    uv)
      local uv_out uv_exit uv_constraint_op uv_lock_bak pyproject_bak floor_highest
      uv_constraint_op="$(py_constraint_op "$pkg" "${dir}/pyproject.toml")"
      # Invariant: always write >= (never ==) — dep-updater must not re-pin.
      if [[ "$uv_constraint_op" == ">=" || "$uv_constraint_op" == "==" || "$uv_constraint_op" == "~=" ]]; then
        # uv add pkg>=new_ver is a no-op when the lock already satisfies the
        # existing >= constraint (uv sees 8.0.1 already satisfies >=7.0.0 and
        # leaves pyproject.toml unchanged). Patch the floor with sed instead.
        # For == / ~= constraints, convert to >= so dep-updater never introduces pins.
        # Snapshot before rewrite/lock so normalize/--check failures can restore
        # untracked uv.lock (bare checkout is a no-op for untracked files).
        uv_lock_bak=""
        pyproject_bak=""
        if [[ -f "${worktree_path}/pyproject.toml" ]]; then
          pyproject_bak="$(mktemp)"
          cp "${worktree_path}/pyproject.toml" "$pyproject_bak"
        fi
        if [[ -f "${worktree_path}/uv.lock" ]]; then
          uv_lock_bak="$(mktemp)"
          cp "${worktree_path}/uv.lock" "$uv_lock_bak"
        fi
        if ! py_uv_rewrite_version_floor "${worktree_path}/pyproject.toml" "$pkg" "$new_ver"; then
          : # Floor already at target; still lock to repair a stale uv.lock.
        fi
        uv_out="$(py_uv_floor_lock "uv lock" "$worktree_path" "$pkg")" && uv_exit=0 || uv_exit=$?
        if (( uv_exit != 0 )); then
          py_uv_restore_after_failed_floor_lock \
            "$worktree_path" "$uv_lock_bak" "$pyproject_bak"
          rm -f "$pyproject_bak" "$uv_lock_bak"
          log "[python/uv] Skipping ${pkg} ${new_ver}: dependency resolution failed."
          log "$uv_out"
          return 0
        fi
        floor_highest="$(py_uv_lock_highest_version "${worktree_path}/uv.lock" "$pkg" \
          2>/dev/null || true)"
        if ! py_uv_version_at_least "$floor_highest" "$new_ver"; then
          py_uv_restore_after_failed_floor_lock \
            "$worktree_path" "$uv_lock_bak" "$pyproject_bak"
          rm -f "$pyproject_bak" "$uv_lock_bak"
          log "[python/uv] Skipping ${pkg} ${new_ver}: lock stayed at ${floor_highest:-?}."
          return 0
        fi
        uv_out="$(py_uv_normalize_lock "uv lock normalize" "$worktree_path")" && uv_exit=0 || uv_exit=$?
        if (( uv_exit != 0 )); then
          py_uv_restore_after_failed_floor_lock \
            "$worktree_path" "$uv_lock_bak" "$pyproject_bak"
          rm -f "$pyproject_bak" "$uv_lock_bak"
          log "[python/uv] Skipping ${pkg} ${new_ver}: lock normalization failed."
          [[ -n "$uv_out" ]] && log "$uv_out"
          dep_updater_append_ecosystem_failure "python|lock normalization failed"
          return 0
        fi
        if ! py_uv_lock_check "uv lock --check" "$worktree_path"; then
          py_uv_restore_after_failed_floor_lock \
            "$worktree_path" "$uv_lock_bak" "$pyproject_bak"
          rm -f "$pyproject_bak" "$uv_lock_bak"
          log "[python/uv] Skipping ${pkg} ${new_ver}: uv lock --check failed after normalize."
          dep_updater_append_ecosystem_failure "python|lock --check failed after normalize"
          return 0
        fi
        rm -f "$pyproject_bak" "$uv_lock_bak"
        log "[python/${tool}] ${pkg}: ${old_ver} → ${new_ver}"
        run_command "git worktree" git -C "$worktree_path" add pyproject.toml uv.lock
        files_changed="pyproject.toml + uv.lock"
      else
        log "[python/${tool}] ${pkg}: ${old_ver} → ${new_ver}"
        # Transitive / unconstrained: prefer marker-aware lock upgrade over
        # `uv add pkg==ver` (universal pin breaks PyPy+win32 marker splits).
        # Snapshot uv.lock so a failed upgrade cannot delete an untracked lock
        # via `git clean` (checkout alone is a no-op for untracked files).
        uv_lock_bak=""
        if [[ -f "${worktree_path}/uv.lock" ]]; then
          uv_lock_bak="$(mktemp)"
          cp "${worktree_path}/uv.lock" "$uv_lock_bak"
        fi
        uv_out="$(py_uv_lock_upgrade_package "$worktree_path" "$pkg" "$new_ver" 2>&1)" \
          && uv_exit=0 || uv_exit=$?
        if (( uv_exit != 0 )); then
          if [[ -n "$uv_lock_bak" ]]; then
            cp "$uv_lock_bak" "${worktree_path}/uv.lock"
            rm -f "$uv_lock_bak"
          else
            run_command "git worktree" git -C "$worktree_path" checkout -- uv.lock 2>/dev/null || true
          fi
          log "[python/uv] Skipping ${pkg} ${new_ver}: dependency resolution failed."
          [[ -n "$uv_out" ]] && log "$uv_out"
          return 0
        fi
        uv_out="$(py_uv_normalize_lock "uv lock normalize" "$worktree_path")" && uv_exit=0 || uv_exit=$?
        if (( uv_exit != 0 )); then
          if [[ -n "$uv_lock_bak" ]]; then
            cp "$uv_lock_bak" "${worktree_path}/uv.lock"
            rm -f "$uv_lock_bak"
          else
            run_command "git worktree" git -C "$worktree_path" checkout -- uv.lock 2>/dev/null || true
          fi
          log "[python/uv] Skipping ${pkg} ${new_ver}: lock normalization failed."
          [[ -n "$uv_out" ]] && log "$uv_out"
          dep_updater_append_ecosystem_failure "python|lock normalization failed"
          return 0
        fi
        if ! py_uv_lock_check "uv lock --check" "$worktree_path"; then
          if [[ -n "$uv_lock_bak" ]]; then
            cp "$uv_lock_bak" "${worktree_path}/uv.lock"
            rm -f "$uv_lock_bak"
          else
            run_command "git worktree" git -C "$worktree_path" checkout -- uv.lock 2>/dev/null || true
          fi
          log "[python/uv] Skipping ${pkg} ${new_ver}: uv lock --check failed after normalize."
          dep_updater_append_ecosystem_failure "python|lock --check failed after normalize"
          return 0
        fi
        rm -f "$uv_lock_bak"
        run_command "git worktree" git -C "$worktree_path" add uv.lock
        files_changed="uv.lock"
      fi
      ;;
    poetry)
      log "[python/${tool}] ${pkg}: ${old_ver} → ${new_ver}"
      local poetry_out poetry_exit
      poetry_out="$(run_in_worktree poetry add "${pkg}@${new_ver}" 2>&1)" && poetry_exit=0 || poetry_exit=$?
      if (( poetry_exit != 0 )); then
        log "[python/poetry] Skipping ${pkg} ${new_ver}: dependency resolution failed."
        log "$poetry_out"
        return 0
      fi
      run_command "git worktree" git -C "$worktree_path" add pyproject.toml poetry.lock
      files_changed="pyproject.toml + poetry.lock"
      ;;
    pipenv)
      log "[python/${tool}] ${pkg}: ${old_ver} → ${new_ver}"
      run_in_worktree pipenv install "${pkg}==${new_ver}"
      run_command "git worktree" git -C "$worktree_path" add Pipfile Pipfile.lock
      files_changed="Pipfile + Pipfile.lock"
      ;;
    pip|pip3)
      log "[python/${tool}] ${pkg}: ${old_ver} → ${new_ver}"
      "$tool" install "${pkg}==${new_ver}"
      "$tool" freeze > "${worktree_path}/requirements.txt"
      run_command "git worktree" git -C "$worktree_path" add requirements.txt
      files_changed="requirements.txt"
      ;;
    *)
      die "Unknown Python tool: '$tool'"
      ;;
  esac

  # If the update tool made no changes, there is nothing to commit.
  # Bail out to avoid creating an empty branch that gt submit will reject.
  if git -C "$worktree_path" diff --cached --quiet; then
    log "[python/${tool}] ${pkg}: no file changes after update — already at latest. Skipping PR."
    return 0
  fi

  # Record the current branch to determine whether reparenting is needed.
  local parent_branch
  parent_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"

  # Create branch and commit with git directly so commit.gpgsign/user.signingkey
  # from the global git config are respected. gt create -m bypasses GPG signing.
  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  # Tell Graphite about the branch parentage.
  dep_stack_register_branch "$parent_branch"
  log "[gate] Submitting PR for '${branch}'…"
  dep_stack_submit_current

  # Stay on $branch — the next dep-updater branch will stack on top of it.

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  local py_body_file
  py_body_file="$(mktemp)"
  write_pr_body "$pkg" "$old_ver" "$new_ver" "python/${tool}" "$files_changed" \
    "$(printf '%s\n' "$py_audit_lines" \
       | grep -i "^${pkg} " || true)" \
    "$py_body_file"
  # gh pr edit exits 1 due to a non-actionable GitHub GraphQL deprecation warning;
  # the PR title and body are cosmetic — the PR itself was already created above.
  dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --title "$commit_msg" \
    --body-file "$py_body_file" \
    --add-label "dep-updater" || true
  rm -f "$py_body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "python/${tool}" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num" "no" "-"
}

# ---------------------------------------------------------------------------
# Rust / Cargo ecosystem
# ---------------------------------------------------------------------------

# True when Cargo.toml declares a [workspace] table (scan root only).
rust_workspace_enabled() {
  local -r scan_root="${1:-$dir}"
  [[ -f "${scan_root}/Cargo.toml" ]] \
    && grep -qE '^\[workspace\]' "${scan_root}/Cargo.toml"
}

# True when the crate has an intentional exact (=) version pin in Cargo.toml.
rust_is_pinned() {
  local -r pkg="$1"
  local -r scan_root="${2:-$dir}"
  local manifest
  for manifest in "${scan_root}/Cargo.toml" "${scan_root}"/*/Cargo.toml; do
    [[ -f "$manifest" ]] || continue
    if awk -v pkg="$pkg" '
      BEGIN {
        dep_table = "^[[:space:]]*\\[(dependencies|dev-dependencies|build-dependencies)\\." pkg "\\][[:space:]]*$"
      }
      /^[[:space:]]*\[/ {
        in_dep_table = ($0 ~ dep_table)
      }
      {
        line = $0
        sub(/[[:space:]]*#.*/, "", line)
        if (line ~ "^[[:space:]]*" pkg "[[:space:]]*=[[:space:]]*\"=") pinned = 1
        if (line ~ "^[[:space:]]*" pkg "[[:space:]]*=[[:space:]]*\\{[^}]*version[[:space:]]*=[[:space:]]*\"=") pinned = 1
        if (in_dep_table && line ~ "^[[:space:]]*version[[:space:]]*=[[:space:]]*\"=") pinned = 1
      }
      END { exit pinned ? 0 : 1 }
    ' "$manifest" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

# List direct outdated crates as TSV:
#   name<TAB>current<TAB>target<TAB>kind<TAB>package<TAB>platform
# platform is cargo-outdated's target cfg/triple (e.g. cfg(target_os = "macos")),
# or "-" when the dep is not platform-specific. Tabs keep spaces in platform intact.
# Uses cargo-outdated JSON (--root-deps-only; --workspace when applicable).
# Optional $1: directory to scan (defaults to $dir).
rust_outdated() {
  local -r target_dir="${1:-$dir}"
  local -a outdated_args=(--root-deps-only --format json)
  local json_out dep_name cur target dep_kind dep_package dep_platform

  if rust_workspace_enabled "$target_dir"; then
    outdated_args+=(--workspace)
  fi

  json_out="$(dep_runner_cargo_dir_stdout "cargo outdated" "$target_dir" -- outdated "${outdated_args[@]}" 2>/dev/null)" || json_out=""
  [[ -z "$json_out" ]] && return 0

  # Prefer compat (in-range) when cargo-outdated reports one. When compat is the
  # sentinel "---" (no newer version within the caret/range), fall through to
  # latest — otherwise out-of-range bumps like tungstenite 0.29→0.30 are dropped
  # because jq's // only treats null/false/empty as missing, not "---".
  # Use join("\t") rather than @tsv: platform cfg strings contain double quotes
  # (cfg(target_os = "macos")), and @tsv may quote/escape those fields so cargo
  # add --target would receive a corrupted value.
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
  dep_runner_jq_with_args "cargo outdated rows" "$json_out" -r '
        (if type == "array" then .[] else . end)
        | .crate_name as $crate
        | .dependencies[]?
        | select(.name != null and .project != null)
        | select(.latest != null and .latest != "---")
        | . as $d
        | (if ($d.compat != null and $d.compat != "---")
           then $d.compat
           else $d.latest
           end) as $target
        | select($target != "---" and $d.project != $target)
        | [
            ($d.name | split(" -> ") | last),
            $d.project,
            $target,
            ($d.kind // "Normal"),
            ($crate // "-"),
            (if ($d.platform == null or $d.platform == "") then "-" else $d.platform end)
          ]
        | join("\t")
      ' 2>/dev/null \
    | while IFS=$'\t' read -r dep_name cur target dep_kind dep_package dep_platform; do
        [[ -z "$dep_name" ]] && continue
        [[ "$dep_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        if rust_is_pinned "$dep_name" "$target_dir"; then
          log "[rust] Skipping exactly-pinned crate: ${dep_name} (${cur})"
          continue
        fi
        [[ -z "$dep_kind" ]] && dep_kind="Normal"
        [[ -z "$dep_package" ]] && dep_package="-"
        [[ -z "$dep_platform" ]] && dep_platform="-"
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$dep_name" "$cur" "$target" "$dep_kind" "$dep_package" "$dep_platform"
      done
}

# rust_revert_post_bump_workdir <worktree_dir>
# Drop Cargo.toml / Cargo.lock / *.rs changes from a failed bump+clippy attempt
# (including workspace-member manifests) so other ecosystems can continue.
# Leaves package.json / lockfiles for other ecosystems alone.
# dep-updater Rust bumps always run in a fresh worktree (clean HEAD), so
# reverting these paths does not discard unrelated WIP.
rust_revert_post_bump_workdir() {
  local -r cargo_dir="$1"
  local f

  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    case "$f" in
      *.rs|Cargo.toml|*/Cargo.toml|Cargo.lock|*/Cargo.lock) ;;
      *) continue ;;
    esac
    run_command "git worktree" git -C "$cargo_dir" restore --source=HEAD --staged --worktree -- "$f" \
      2>/dev/null || true
  done < <({
    dep_runner_git_c_stdout "git worktree" "$cargo_dir" -- diff --name-only HEAD 2>/dev/null || true
    dep_runner_git_c_stdout "git worktree" "$cargo_dir" -- diff --cached --name-only 2>/dev/null || true
  } | sort -u)
}

# _rust_log_output_tail <text> <n>
# Log the last n lines of text without calling external tail (runner adoption).
_rust_log_output_tail() {
  local -r text="$1"
  local -r n="$2"
  local -a lines=()
  local line i start

  [[ -z "$text" ]] && return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    lines+=("$line")
  done <<< "$text"
  start=$(( ${#lines[@]} - n ))
  if (( start < 0 )); then
    start=0
  fi
  for (( i = start; i < ${#lines[@]}; i++ )); do
    log "${lines[i]}"
  done
}

# rust_clippy_failure_is_host_incompatible <clippy_output>
# True when clippy/build failed because a dependency requires another OS
# (e.g. coreaudio-sys on Linux for a macOS-only crate). Local clippy cannot
# validate those bumps; allow them and rely on target-platform CI.
# Keep patterns precise — do not match generic host linker/toolchain gaps.
rust_clippy_failure_is_host_incompatible() {
  local -r text="$1"
  [[ -z "$text" ]] && return 1
  if grep -qiE \
    'requires macos or ios|only (available|supported) on (macos|ios|windows|android)|cannot find .* for .*apple-darwin|linking with .*-apple-darwin' \
    <<<"$text"
  then
    return 0
  fi
  return 1
}

# rust_recover_post_bump_clippy <worktree_dir>
# After cargo add bumps, run the same clippy bar as consumer CI (-D warnings).
# On failure, apply mechanical suggestions via `cargo clippy --fix`, then
# re-check. Returns 0 when clean, recovered, or skipped as host-incompatible;
# 1 when still failing (caller should skip/revert the Rust bump — issue #433).
# Logs ERROR: RUST_CLIPPY_RECOVER_FAILED on unrecovered failure.
rust_recover_post_bump_clippy() {
  local -r cargo_dir="$1"
  local clippy_out clippy_rc fix_out fix_rc
  local -r clippy_tail_lines=40

  log "[rust] Running post-bump clippy (--all-targets -D warnings)…"
  clippy_rc=0
  clippy_out="$(dep_runner_cargo_dir_capture "cargo clippy post-bump" "$cargo_dir" -- \
    clippy --all-targets -- -D warnings)" || clippy_rc=$?
  if (( clippy_rc == 0 )); then
    log "[rust] Post-bump clippy clean."
    return 0
  fi

  if rust_clippy_failure_is_host_incompatible "$clippy_out"; then
    log "[rust] Post-bump clippy skipped: host cannot build this crate (platform-specific deps); relying on target CI."
    _rust_log_output_tail "$clippy_out" "$clippy_tail_lines"
    return 0
  fi

  log "[rust] Post-bump clippy failed (exit ${clippy_rc}); attempting cargo clippy --fix…"
  fix_rc=0
  fix_out="$(dep_runner_cargo_dir_capture "cargo clippy --fix" "$cargo_dir" -- \
    clippy --fix --allow-dirty --allow-staged)" || fix_rc=$?
  if (( fix_rc != 0 )); then
    log "[rust] cargo clippy --fix exited ${fix_rc} (continuing to re-check)."
    _rust_log_output_tail "$fix_out" "$clippy_tail_lines"
  fi

  clippy_rc=0
  clippy_out="$(dep_runner_cargo_dir_capture "cargo clippy post-fix" "$cargo_dir" -- \
    clippy --all-targets -- -D warnings)" || clippy_rc=$?
  if (( clippy_rc == 0 )); then
    log "[rust] Post-bump clippy recovered after --fix."
    return 0
  fi

  if rust_clippy_failure_is_host_incompatible "$clippy_out"; then
    log "[rust] Post-bump clippy skipped after --fix: host cannot build this crate; relying on target CI."
    _rust_log_output_tail "$clippy_out" "$clippy_tail_lines"
    return 0
  fi

  log "ERROR: RUST_CLIPPY_RECOVER_FAILED dir=${cargo_dir} exit=${clippy_rc}"
  _rust_log_output_tail "$clippy_out" "$clippy_tail_lines"
  dep_updater_append_ecosystem_failure \
    "rust|post-bump clippy still failing after --fix (exit ${clippy_rc})"
  return 1
}

# Bump one direct dependency and open a stacked PR.
# Args: $1=crate, $2=current version, $3=target version, $4=dependency kind,
#       $5=workspace package, $6=platform (cargo --target cfg/triple, or "-")
rust_update_one() {
  local -r pkg="$1"
  local -r old_ver="$2"
  local -r new_ver="$3"
  local -r dep_kind="${4:-Normal}"
  local -r dep_package="${5:--}"
  local -r dep_platform="${6:--}"
  local safe_name
  safe_name="$(sanitize_branch_name "$pkg")"
  local -r branch="dep-updates/rust-${safe_name}"
  local -r commit_msg="chore(deps): bump ${pkg} from ${old_ver} to ${new_ver}"
  local -r files_changed="Cargo.toml + Cargo.lock"
  local cargo_out cargo_exit
  local -a cargo_add_args=("${pkg}@${new_ver}")

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      run_command "git worktree" git -C "$worktree_path" checkout "$branch"
  dep_stack_register_branch_optional
      dep_stack_submit_current
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then
        state_append_pr "$existing_pr"
      fi
    fi
    run_command "git worktree" git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[rust] ${pkg}: ${old_ver} → ${new_ver}"

  case "$dep_kind" in
    Development) cargo_add_args=(--dev "${cargo_add_args[@]}") ;;
    Build)       cargo_add_args=(--build "${cargo_add_args[@]}") ;;
    *)           : ;;
  esac
  # Platform-specific deps must use --target so cargo updates the existing
  # [target.'cfg(…)'.dependencies] pin instead of adding a second root entry.
  if [[ -n "$dep_platform" && "$dep_platform" != "-" ]]; then
    cargo_add_args=(--target "$dep_platform" "${cargo_add_args[@]}")
  fi
  if rust_workspace_enabled "$worktree_path" && [[ "$dep_package" != "-" ]]; then
    cargo_add_args=(--package "$dep_package" "${cargo_add_args[@]}")
  fi

  cargo_out="$(dep_runner_cargo_dir_capture "cargo add" "$worktree_path" -- add "${cargo_add_args[@]}")" && cargo_exit=0 || cargo_exit=$?
  if (( cargo_exit != 0 )); then
    log "[rust] Skipping ${pkg} ${new_ver}: cargo add failed."
    log "$cargo_out"
    dep_updater_append_ecosystem_failure "rust|crate add failed for ${pkg} (exit ${cargo_exit})"
    return 0
  fi

  run_command "git worktree" git -C "$worktree_path" add -u

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[rust] ${pkg}: no file changes after update — already at latest. Skipping PR."
    return 0
  fi

  if ! rust_recover_post_bump_clippy "$worktree_path"; then
    log "[rust] Skipping ${pkg} ${old_ver}→${new_ver}: unrecovered clippy after bump."
    rust_revert_post_bump_workdir "$worktree_path"
    return 0
  fi
  run_command "git worktree" git -C "$worktree_path" add -u

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[rust] ${pkg}: no file changes after clippy recover — skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"

  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  dep_stack_register_branch "$parent_branch"
  log "[gate] Submitting PR for '${branch}'…"
  dep_stack_submit_current

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  local rust_body_file
  rust_body_file="$(mktemp)"
  write_pr_body "$pkg" "$old_ver" "$new_ver" "rust/cargo" "$files_changed" "" "$rust_body_file"
  dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --title "$commit_msg" \
    --body-file "$rust_body_file" \
    --add-label "dep-updater" || true
  rm -f "$rust_body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "rust/cargo" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num" "no" "-"
}

# ---------------------------------------------------------------------------
# GitHub Actions ecosystem
# ---------------------------------------------------------------------------

# _gha_ref_sortable_version <ref>
# Normalizes @v6 to 6.0.0 and @v1.7.12 to 1.7.12 for sort -V comparisons.
_gha_ref_sortable_version() {
  local -r ref="$1"
  local ver="${ref#v}"
  if [[ "$ver" =~ ^[0-9]+$ ]]; then
    printf '%s.0.0' "$ver"
  else
    printf '%s' "$ver"
  fi
}

# _gha_semver_release_tags_desc <action>
# Prints semver release/tag names newest-first (v-prefix preserved when present).
_gha_semver_release_tags_desc() {
  local -r action="$1"
  local releases tags

  releases="$(dep_runner_gh_stdout "gh api" -- api "repos/${action}/releases?per_page=100" \
    --jq '.[].tag_name' 2>/dev/null || true)"
  tags="$(dep_runner_gh_stdout "gh api" -- api "repos/${action}/tags?per_page=100" \
    --jq '.[].name' 2>/dev/null || true)"
  printf '%s\n%s\n' "$releases" "$tags" \
    | awk '/^v?[0-9]+([.][0-9]+){0,3}([-.].*)?$/ {print}' \
    | sed -E 's/^v//' \
    | sort -Vu -r \
    | sed -E 's/^/v/'
}

# _gha_pick_eligible_new_ref <action> <current_ref>
# Picks the newest release ref newer than current_ref that passes release-age policy.
_gha_pick_eligible_new_ref() {
  local -r action="$1"
  local -r ref="$2"
  local current_cmp tag candidate_cmp new_ref

  current_cmp="$(_gha_ref_sortable_version "$ref")"
  while IFS= read -r tag; do
    [[ -z "$tag" ]] && continue
    candidate_cmp="$(_gha_ref_sortable_version "$tag")"
    if [[ "$candidate_cmp" == "$current_cmp" ]]; then
      continue
    fi
    if [[ "$(printf '%s\n%s\n' "$current_cmp" "$candidate_cmp" | sort -V | tail -1)" != "$candidate_cmp" ]]; then
      continue
    fi
    if ! gha_version_meets_minimum_release_age "$action" "$tag"; then
      continue
    fi
    if [[ "$ref" == v* ]]; then
      new_ref="$tag"
    else
      new_ref="${tag#v}"
    fi
    printf '%s' "$new_ref"
    return 0
  done < <(_gha_semver_release_tags_desc "$action")
  return 1
}

# Query GitHub Actions pins and compare to eligible releases. Returns lines of:
#   owner/repo  current_ref  new_ref
#
# Pin-style semantics:
#   Major-only  (@v6)         — bump to newest eligible release semver (v6.0.2, v8.1.0, …)
#   Full semver (@v1.7.12)    — bump to newest eligible newer release
#   Commit SHA  (@abc123...)  — skipped (not managed here)
#
# Optional $1: repository root containing .github/workflows (defaults to $dir).
#
# When the same action is pinned at multiple versions (e.g. checkout@v7 and
# checkout@v6.0.3), use the oldest pin for eligibility — not the first grep hit.
# Otherwise a newer pin listed first hides stale pins (see #360).
gha_outdated() {
  local -r scan_root="${1:-$dir}"
  local -a action_order=()
  local -A oldest_ref_by_action=()
  local line action ref new_ref oldest_ref sortable_ref sortable_oldest

  while IFS= read -r line; do
    # Extract the value after `uses:`, strip surrounding quotes/whitespace.
    action="$(printf '%s' "$line" \
      | sed -E 's/^[[:space:]]*-?[[:space:]]*uses:[[:space:]]*//' \
      | tr -d '"'"'")"
    # Skip local actions (relative paths like ./path/to/action).
    [[ "$action" == ./* ]] && continue
    # Skip entries without an @ ref.
    [[ "$action" != *@* ]] && continue
    ref="${action##*@}"
    action="${action%%@*}"
    # Skip commit-SHA pins (exactly 40 hex chars).
    if [[ "$ref" =~ ^[0-9a-fA-F]{40}$ ]]; then
      continue
    fi

    if [[ -z "${oldest_ref_by_action[$action]+x}" ]]; then
      action_order+=("$action")
      oldest_ref_by_action[$action]="$ref"
      continue
    fi

    oldest_ref="${oldest_ref_by_action[$action]}"
    sortable_ref="$(_gha_ref_sortable_version "$ref")"
    sortable_oldest="$(_gha_ref_sortable_version "$oldest_ref")"
    if [[ "$sortable_ref" != "$sortable_oldest" \
      && "$(printf '%s\n%s\n' "$sortable_ref" "$sortable_oldest" | sort -V | head -1)" \
        == "$sortable_ref" ]]; then
      oldest_ref_by_action[$action]="$ref"
    fi
  done < <(grep -rh --include='*.yml' --include='*.yaml' \
    'uses:' "${scan_root}/.github/workflows/" 2>/dev/null)

  for action in "${action_order[@]}"; do
    oldest_ref="${oldest_ref_by_action[$action]}"
    new_ref="$(_gha_pick_eligible_new_ref "$action" "$oldest_ref" 2>/dev/null || true)"
    if [[ -z "$new_ref" ]]; then
      if [[ -z "$(_gha_semver_release_tags_desc "$action" | head -1 || true)" ]]; then
        log "[github-actions] No release or semver tag found for ${action} — skipping."
      fi
      continue
    fi
    printf '%s %s %s\n' "$action" "$oldest_ref" "$new_ref"
  done
}

# Update a single GitHub Actions action across all workflow files in the
# .github/workflows/ directory, then create a stacked PR.
# Args: $1=action (owner/repo), $2=current_ref, $3=new_ref
gha_update_one() {
  local -r action="$1"
  local -r current_ref="$2"
  local -r new_ref="$3"
  local safe_name
  safe_name="$(sanitize_branch_name "${action}")"
  local -r branch="dep-updates/gha-${safe_name}"
  local -r commit_msg="chore(deps): bump ${action} from ${current_ref} to ${new_ref}"

  if branch_exists_in_worktree "$branch"; then
    log "Skipping existing branch: ${branch}"
    register_existing_branch_state "$branch"
    local existing_pr
    existing_pr="$(gh_pr_number_for_branch "$branch")"
    if [[ -z "$existing_pr" ]]; then
      log "Branch ${branch} has no PR — submitting now."
      run_command "git worktree" git -C "$worktree_path" checkout "$branch"
  dep_stack_register_branch_optional
      dep_stack_submit_current
      existing_pr="$(gh_pr_number_for_branch "$branch")"
      if [[ -n "$existing_pr" ]]; then
        state_append_pr "$existing_pr"
      fi
    fi
    run_command "git worktree" git -C "$worktree_path" checkout "$branch"
    return 0
  fi

  log "[github-actions] ${action}: ${current_ref} → ${new_ref}"

  # Patch all workflow files: replace `uses: action@current_ref` with
  # `uses: action@new_ref`.  The sed delimiter is | to avoid escaping /.
  local gnu_sed_bin
  gnu_sed_bin="$(tooling_prereq_gnu_sed_path)"
  find "${worktree_path}/.github/workflows" -maxdepth 1 \
    \( -name '*.yml' -o -name '*.yaml' \) \
    -exec "$gnu_sed_bin" -i \
      -e "s|uses: ${action}@${current_ref}|uses: ${action}@${new_ref}|g" \
      {} +

  run_command "git worktree" git -C "$worktree_path" add .github/workflows/

  if git -C "$worktree_path" diff --cached --quiet; then
    log "[github-actions] ${action}: no file changes — already at latest. Skipping PR."
    return 0
  fi

  local parent_branch
  parent_branch="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- branch --show-current)"

  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  dep_stack_register_branch "$parent_branch"
  log "[gate] Submitting PR for '${branch}'…"
  dep_stack_submit_current

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for branch '${branch}'"

  local gha_body_file
  gha_body_file="$(mktemp)"
  write_pr_body "$action" "$current_ref" "$new_ref" \
    "github-actions" ".github/workflows/" "" "$gha_body_file"
  dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --title "$commit_msg" \
    --body-file "$gha_body_file" \
    --add-label "dep-updater" || true
  rm -f "$gha_body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  add_summary_line "github-actions" "$action" "$current_ref" "$new_ref" "$branch" "$pr_num" "no" "-"
}

# ---------------------------------------------------------------------------
# Batch update — one branch + one PR for all changes
# ---------------------------------------------------------------------------

# Applies all npm + Python + GitHub Actions updates (security and/or regular)
# onto a single branch and creates a single PR.  Called instead of the
# per-group/per-package loops when --batch is set.
#
# Args:
#   $1  npm_audit_lines  (may be empty)
#   $2  py_audit_lines   (may be empty)
#   $3  npm_lines        (may be empty; ignored when security_only=1)
#   $4  py_lines         (may be empty; ignored when security_only=1)
#   $5  gha_lines        (may be empty; ignored when security_only=1)
#   $6  rust_lines       (may be empty; ignored when security_only=1)
batch_update_all() {
  local -r npm_audit_lines_arg="$1"
  local -r py_audit_lines_arg="$2"
  local -r npm_lines_arg="$3"
  local -r py_lines_arg="$4"
  local -r gha_lines_arg="${5:-}"
  local -r rust_lines_arg="${6:-}"

  # Use a timestamped branch name so each run gets a fresh Graphite identity.
  # A fixed name like 'dep-updates/batch' caused repeated submit failures: Graphite
  # persists the PR association and refuses to create a new PR for the same name
  # even after the old PR is closed, and no combination of 'gt sync' / 'gt branch
  # untrack' reliably clears this metadata without a checkout of the stale branch.
  local batch_ts
  batch_ts="$(time_log_date_utc '%Y%m%dT%H%M%S')"
  local -r branch="dep-updates/batch-${batch_ts}"
  local any_npm=0 any_py=0
  local py_out py_exit b_constraint_op b_spec actual_py_lines='' dep_kind dep_package dep_platform
  local uv_floor_batch uv_upgrade_success report_py_lines
  local pyproject_bak verified_floor_lines floor_line floor_pkg _floor_old floor_new floor_highest
  local -a uv_floor_lines=()
  local -a floor_pkgs=()
  local -a orig_floor_pkgs=()
  local -a verified_floor_lines=()
  local -a uv_upgrade_specs=()
  local -a cargo_add_args=()
  local lock_actual_lines seen_py_pkgs pkg_norm lock_bak
  local pkg old_ver new_ver

  dep_updater_ensure_eco_fail_file

  # If a previous batch branch from this same worktree session exists and its PR
  # is still open, reuse it rather than creating a duplicate.
  local existing_batch_branch=""
  local b
  while IFS= read -r b; do
    [[ "$b" == dep-updates/batch-* ]] || continue
    local bpr bstate bmerged
    bpr="$(gh_pr_number_for_branch "$b")"
    [[ -z "$bpr" ]] && continue
    bstate="$(gh_pr_state_for_number "$bpr")"
    bmerged="$(gh_pr_merged_for_number "$bpr")"
    if [[ "$bmerged" != 'true' && "$bstate" != 'closed' ]]; then
      existing_batch_branch="$b"
      break
    fi
  done < <({
    run_command "git worktree" git -C "$worktree_path" branch --format='%(refname:short)' 2>/dev/null
    # Also include remote tracking refs so an interrupted run whose worktree was
    # cleaned up can still find a batch branch that was pushed to origin.
    run_command "git worktree" git -C "$worktree_path" for-each-ref --format='%(refname:lstrip=3)' \
      'refs/remotes/origin/dep-updates/batch-*' 2>/dev/null
  } | sort -u)

  if [[ -n "$existing_batch_branch" ]]; then
    log "Reusing existing open batch branch: ${existing_batch_branch}"
    register_existing_branch_state "$existing_batch_branch"
    run_command "git worktree" git -C "$worktree_path" checkout "$existing_batch_branch"
    return 0
  fi

  # ── npm ──────────────────────────────────────────────────────────────────
  # Capture the old package.json text so we can later diff against the
  # installed result to determine which packages actually changed.
  local old_pkg_json=""
  local npm_root=""
  if [[ "$has_npm" == '1' ]]; then
    npm_root="$(npm_project_root "$worktree_path")"
    old_pkg_json="$(cat "${npm_root}/package.json" 2>/dev/null || true)"
  fi

  if [[ "$has_npm" == '1' ]]; then
    local lockfile
    case "$npm_tool" in
      pnpm) lockfile="pnpm-lock.yaml" ;;
      yarn) lockfile="yarn.lock" ;;
      npm)  lockfile="package-lock.json" ;;
    esac

    run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
    if [[ "$npm_tool" == 'npm' ]]; then
      rm -f "${npm_root}/package-lock.json"
      if [[ -d "${npm_root}/node_modules" ]]; then
        rm -rf "${npm_root}/node_modules"
      fi
    else
      run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path "$lockfile")" 2>/dev/null || true
    fi

    if [[ "$npm_tool" == 'yarn' ]]; then
      # yarn has no patch-manifest path; build a combined upgrade arg list.
      local -a yarn_args=()
      if [[ -n "$npm_audit_lines_arg" ]]; then
        while IFS=' ' read -r pkg _current fix _cves; do
          [[ -z "$pkg" ]] && continue
          yarn_args+=("${pkg}@${fix}")
          log "[${npm_tool}] Security: ${pkg} → ${fix}"
        done <<< "$npm_audit_lines_arg"
        any_npm=1
      fi
      if [[ -n "$npm_lines_arg" && "$security_only" == '0' ]]; then
        while IFS=' ' read -r pkg _old new_ver; do
          [[ -z "$pkg" ]] && continue
          yarn_args+=("${pkg}@${new_ver}")
          log "[${npm_tool}] Update: ${pkg} → ${new_ver}"
        done <<< "$npm_lines_arg"
        any_npm=1
      fi
      if [[ "${#yarn_args[@]}" -gt 0 ]]; then
        local yarn_batch_rc=0
        dep_runner_yarn_cwd "yarn batch upgrade" "$npm_root" upgrade "${yarn_args[@]}" || yarn_batch_rc=$?
        if [[ "$yarn_batch_rc" -ne 0 ]]; then
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path yarn.lock)" 2>/dev/null || true
          dep_updater_append_ecosystem_failure "npm|batch package-manager upgrade failed (exit ${yarn_batch_rc})"
          log "[${npm_tool}] WARNING: batch package-manager upgrade failed (exit ${yarn_batch_rc}); continuing."
        fi
      fi
    else
      # npm / pnpm: patch package.json once with all target versions, then install.
      local updates_json='{}'
      if [[ -n "$npm_audit_lines_arg" ]]; then
        while IFS=' ' read -r pkg _current fix _cves; do
          [[ -z "$pkg" ]] && continue
          # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
          updates_json="$(dep_runner_jq_with_args "jq merge pkg fix" "$updates_json" \
            --arg k "$pkg" --arg v "$fix" '. + {($k): $v}')"
          log "[${npm_tool}] Security: ${pkg} → ${fix}"
        done <<< "$npm_audit_lines_arg"
        any_npm=1
      fi
      if [[ -n "$npm_lines_arg" && "$security_only" == '0' ]]; then
        while IFS=' ' read -r pkg _old new_ver; do
          [[ -z "$pkg" ]] && continue
          # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
          updates_json="$(dep_runner_jq_with_args "jq merge pkg version" "$updates_json" \
            --arg k "$pkg" --arg v "$new_ver" '. + {($k): $v}')"
          log "[${npm_tool}] Update: ${pkg} → ${new_ver}"
        done <<< "$npm_lines_arg"
        any_npm=1
      fi
      if [[ "$updates_json" != '{}' ]]; then
        local tmp_pkg
        tmp_pkg="$(mktemp)"
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
        if ! dep_runner_jq_file_args "jq batch patch package.json" "${npm_root}/package.json" --argjson updates "$updates_json" '
          to_entries | map(
            if (.key == "dependencies" or .key == "devDependencies" or .key == "peerDependencies")
               and (.value != null) then
              .value |= with_entries(
                (.key) as $k |
                if $updates | has($k) then .value = $updates[$k] else . end
              )
            else . end
          ) | from_entries
        ' >"$tmp_pkg"; then
          rm -f "$tmp_pkg"
          run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
          dep_updater_append_ecosystem_failure "npm|batch manifest JSON patch failed"
          log "[batch] ERROR: manifest JSON patch failed — npm batch section skipped."
        else
          mv "$tmp_pkg" "${npm_root}/package.json"
          case "$npm_tool" in
            pnpm)
              local pnpm_batch_rc=0
              pnpm_install_worktree no-frozen "$npm_root" || pnpm_batch_rc=$?
              if [[ "$pnpm_batch_rc" -ne 0 ]]; then
                run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
                run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path pnpm-lock.yaml)" 2>/dev/null || true
                dep_updater_append_ecosystem_failure "npm|batch lockfile install failed (exit ${pnpm_batch_rc})"
                log "[${npm_tool}] WARNING: batch pnpm install failed (exit ${pnpm_batch_rc}); continuing."
              fi
              ;;
            npm)
              local npm_batch_rc=0
              dep_runner_npm_prefix "npm batch install" "$npm_root" install || npm_batch_rc=$?
              if [[ "$npm_batch_rc" -ne 0 ]]; then
                run_command "git worktree" git -C "$worktree_path" checkout -- "$(npm_repo_rel_path package.json)" 2>/dev/null || true
                dep_updater_append_ecosystem_failure "npm|batch lockfile install failed (exit ${npm_batch_rc})"
                log "[${npm_tool}] WARNING: batch npm install failed (exit ${npm_batch_rc}); continuing."
              fi
              ;;
          esac
        fi
      fi
    fi

    if [[ "$any_npm" == '1' ]]; then
      run_command "git worktree" git -C "$worktree_path" add "$(npm_repo_rel_path package.json)"
      if ! git -C "$worktree_path" check-ignore -q "$(npm_repo_rel_path "$lockfile")" 2>/dev/null; then
        run_command "git worktree" git -C "$worktree_path" add "$(npm_repo_rel_path "$lockfile")" 2>/dev/null || true
      fi
    fi
  fi

  # ── Python ───────────────────────────────────────────────────────────────
  if [[ -n "$py_tool" ]]; then
    if [[ -n "$py_audit_lines_arg" ]]; then
      while IFS=' ' read -r pkg _current fix _cves; do
        [[ -z "$pkg" ]] && continue
        log "[python/${py_tool}] Security: ${pkg} → ${fix}"
        case "$py_tool" in
          uv)      dep_runner_uv_dir "uv batch security add" "$worktree_path" -- add "${pkg}==${fix}" ;;
          poetry)  run_in_worktree poetry add "${pkg}@${fix}" ;;
          pipenv)  run_in_worktree pipenv install "${pkg}==${fix}" ;;
          pip|pip3) "$py_tool" install "${pkg}==${fix}" ;;
        esac
      done <<< "$py_audit_lines_arg"
      any_py=1
    fi
    if [[ -n "$py_lines_arg" && "$security_only" == '0' ]]; then
      uv_floor_batch=0
      uv_upgrade_success=0
      uv_upgrade_specs=()
      uv_floor_lines=()
      pyproject_bak=""
      if [[ "$py_tool" == "uv" ]]; then
        pyproject_bak="$(mktemp)"
        cp "${worktree_path}/pyproject.toml" "$pyproject_bak"
      fi
      while IFS=' ' read -r pkg _old new_ver; do
        [[ -z "$pkg" ]] && continue
        case "$py_tool" in
          uv)
            b_constraint_op="$(py_constraint_op "$pkg" "${worktree_path}/pyproject.toml")"
            if [[ "$b_constraint_op" == ">=" || "$b_constraint_op" == "==" || "$b_constraint_op" == "~=" ]]; then
              py_uv_rewrite_version_floor "${worktree_path}/pyproject.toml" "$pkg" "$new_ver" || true
              uv_floor_lines+=("${pkg} ${_old} ${new_ver}")
              uv_floor_batch=1
            else
              # Transitive / unconstrained — upgrade via lock (not uv add).
              uv_upgrade_specs+=("${pkg} ${new_ver}")
            fi
            ;;
          poetry)
            log "[python/${py_tool}] Update: ${pkg} → ${new_ver}"
            py_out="$(run_in_worktree poetry add "${pkg}@${new_ver}" 2>&1)" && py_exit=0 || py_exit=$?
            if (( py_exit != 0 )); then
              log "[python/poetry] Skipping ${pkg} ${new_ver}: dependency resolution failed."
              log "$py_out"
              continue
            fi
            ;;
          pipenv)
            log "[python/${py_tool}] Update: ${pkg} → ${new_ver}"
            run_in_worktree pipenv install "${pkg}==${new_ver}"
            ;;
          pip|pip3)
            log "[python/${py_tool}] Update: ${pkg} → ${new_ver}"
            "$py_tool" install "${pkg}==${new_ver}"
            ;;
        esac
      done <<< "$py_lines_arg"
      if [[ "$py_tool" == "uv" ]]; then
        if [[ "$uv_floor_batch" == '1' ]]; then
          # pyproject_bak is the pre-rewrite snapshot. Snapshot uv.lock before
          # floor lock so a failure can restore the pre-lock lockfile.
          lock_bak=""
          if [[ -f "${worktree_path}/uv.lock" ]]; then
            lock_bak="$(mktemp)"
            cp "${worktree_path}/uv.lock" "$lock_bak"
          fi
          floor_pkgs=()
          for floor_line in "${uv_floor_lines[@]}"; do
            read -r floor_pkg _floor_old floor_new <<<"$floor_line"
            [[ -z "$floor_pkg" ]] && continue
            floor_pkgs+=("$floor_pkg")
          done
          py_out="$(py_uv_floor_lock "uv batch lock" "$worktree_path" "${floor_pkgs[@]}")" && py_exit=0 || py_exit=$?
          if (( py_exit != 0 )); then
            py_uv_restore_after_failed_floor_lock "$worktree_path" "$lock_bak" "$pyproject_bak"
            rm -f "$pyproject_bak" "$lock_bak"
            lock_bak=""
            pyproject_bak=""
            if grep -qF 'No solution found when resolving dependencies' <<<"$py_out"; then
              log "[python/uv] Skipping python batch floor bumps: dependency resolution failed."
              log "$py_out"
              # Handled resolution conflict — floors reverted; do not mark ecosystem failure.
            else
              log "[python/uv] ERROR: uv batch lock failed (non-resolution); floors reverted."
              log "$py_out"
              dep_updater_append_ecosystem_failure \
                "python|batch uv lock failed (non-resolution; floors reverted)"
            fi
            uv_floor_batch=0
            uv_floor_lines=()
          else
            orig_floor_pkgs=("${floor_pkgs[@]}")
            verified_floor_lines=()
            for floor_line in "${uv_floor_lines[@]}"; do
              read -r floor_pkg _floor_old floor_new <<<"$floor_line"
              [[ -z "$floor_pkg" || -z "$floor_new" ]] && continue
              floor_highest="$(py_uv_lock_highest_version "${worktree_path}/uv.lock" "$floor_pkg" \
                2>/dev/null || true)"
              if py_uv_version_at_least "$floor_highest" "$floor_new"; then
                verified_floor_lines+=("$floor_line")
              else
                log "[python/uv] Skipping ${floor_pkg} ${floor_new}: lock stayed at ${floor_highest:-?}."
              fi
            done
            if [[ ${#verified_floor_lines[@]} -lt ${#uv_floor_lines[@]} ]]; then
              cp "$pyproject_bak" "${worktree_path}/pyproject.toml"
              uv_floor_lines=()
              for floor_line in "${verified_floor_lines[@]}"; do
                read -r floor_pkg _floor_old floor_new <<<"$floor_line"
                [[ -z "$floor_pkg" || -z "$floor_new" ]] && continue
                # No-op is expected when pyproject_bak already has the verified floor
                # (lock-only repair). Keep the verified line either way.
                py_uv_rewrite_version_floor "${worktree_path}/pyproject.toml" "$floor_pkg" "$floor_new" \
                  || true
                uv_floor_lines+=("$floor_line")
              done
              if [[ "$uv_floor_batch" == '1' && ${#uv_floor_lines[@]} -gt 0 ]]; then
                # Age-gate every original floor pkg, including dropped ones whose
                # constraints were restored — otherwise the re-lock can pick a
                # too-young version for a dropped package.
                py_out="$(py_uv_floor_lock "uv batch lock verify" "$worktree_path" \
                  "${orig_floor_pkgs[@]}")" && py_exit=0 || py_exit=$?
                if (( py_exit != 0 )); then
                  py_uv_restore_after_failed_floor_lock "$worktree_path" "$lock_bak" "$pyproject_bak"
                  log "[python/uv] Skipping verified floor bumps: dependency resolution failed on re-lock."
                  log "$py_out"
                  uv_floor_batch=0
                  uv_floor_lines=()
                fi
              elif [[ ${#uv_floor_lines[@]} -eq 0 ]]; then
                if [[ -n "$lock_bak" ]]; then
                  cp "$lock_bak" "${worktree_path}/uv.lock"
                fi
                uv_floor_batch=0
              fi
            else
              uv_floor_lines=("${verified_floor_lines[@]}")
            fi
            if [[ "$uv_floor_batch" == '1' ]]; then
              for floor_line in "${uv_floor_lines[@]}"; do
                read -r floor_pkg _floor_old floor_new <<<"$floor_line"
                [[ -z "$floor_pkg" || -z "$floor_new" ]] && continue
                log "[python/${py_tool}] Update: ${floor_pkg} → ${floor_new}"
              done
            fi
            rm -f "$pyproject_bak" "$lock_bak"
            lock_bak=""
            pyproject_bak=""
          fi
        else
          rm -f "$pyproject_bak"
          pyproject_bak=""
        fi
        for b_spec in "${uv_upgrade_specs[@]}"; do
          read -r pkg new_ver <<<"$b_spec"
          [[ -z "$pkg" || -z "$new_ver" ]] && continue
          if [[ ! -f "${worktree_path}/uv.lock" ]]; then
            log "[python/uv] Skipping ${pkg}==${new_ver}: uv.lock missing."
            continue
          fi
          lock_bak="$(mktemp)"
          cp "${worktree_path}/uv.lock" "$lock_bak"
          py_out="$(py_uv_lock_upgrade_package "$worktree_path" "$pkg" "$new_ver" 2>&1)" \
            && py_exit=0 || py_exit=$?
          if (( py_exit != 0 )); then
            cp "$lock_bak" "${worktree_path}/uv.lock"
            rm -f "$lock_bak"
            log "[python/uv] Skipping ${pkg}==${new_ver}: dependency resolution failed."
            [[ -n "$py_out" ]] && log "$py_out"
            continue
          fi
          rm -f "$lock_bak"
          uv_upgrade_success=1
          log "[python/${py_tool}] Update: ${pkg} → ${new_ver}"
        done
        if [[ "$uv_floor_batch" == '1' || "$uv_upgrade_success" == '1' ]]; then
          any_py=1
        fi
      else
        any_py=1
      fi
    fi
    if [[ "$any_py" == '1' ]]; then
      case "$py_tool" in
        uv)
          py_out="$(py_uv_normalize_lock "uv batch lock normalize" "$worktree_path")" && py_exit=0 || py_exit=$?
          if (( py_exit != 0 )); then
            log "[python/uv] ERROR: batch lock normalization failed."
            [[ -n "$py_out" ]] && log "$py_out"
            # Reset to HEAD (not pre-normalize bak): restored CVE/floor edits must not
            # remain dirty for later `git add -u` from other ecosystems (e.g. rust).
            py_uv_restore_after_failed_floor_lock "$worktree_path" "" ""
            dep_updater_append_ecosystem_failure "python|batch lock normalization failed"
            any_py=0
          elif ! py_uv_lock_check "uv batch lock --check" "$worktree_path"; then
            log "[python/uv] ERROR: uv lock --check failed after batch normalize."
            py_uv_restore_after_failed_floor_lock "$worktree_path" "" ""
            dep_updater_append_ecosystem_failure "python|batch uv lock --check failed after normalize"
            any_py=0
          else
            run_command "git worktree" git -C "$worktree_path" add pyproject.toml uv.lock
          fi
          ;;
        poetry)   run_command "git worktree" git -C "$worktree_path" add pyproject.toml poetry.lock ;;
        pipenv)   run_command "git worktree" git -C "$worktree_path" add Pipfile Pipfile.lock ;;
        pip|pip3)
          # pip freeze must be run from the project dir to produce correct output.
          "$py_tool" freeze > "${worktree_path}/requirements.txt"
          run_command "git worktree" git -C "$worktree_path" add requirements.txt
          ;;
      esac
    fi

    # Compute actual_py_lines from staged changes only (never fall back to the
    # planned py_lines_arg — failed/skipped packages must not appear in the
    # PR body or batch email summary).
    # 1) Direct constraint edits in pyproject.toml
    # 2) Transitive lock upgrades whose uv.lock highest version equals the plan
    actual_py_lines=""
    if [[ "$any_py" == '1' ]]; then
      actual_py_lines="$(
        {
          run_command "git worktree" git -C "$worktree_path" diff --cached -- pyproject.toml 2>/dev/null || true
          printf '%s\n' '__LISTED__'
          printf '%s\n' "$py_lines_arg"
          printf '%s\n' "$py_audit_lines_arg"
        } | awk '
          /^__LISTED__$/ { in_listed = 1; next }
          in_listed {
            split($0, f, " ")
            if (f[1] == "") next
            p = tolower(f[1])
            fallback_old[p] = f[2]
            fallback_name[p] = f[1]
            next
          }
          /^---/ || /^[+][+][+]/ { next }
          {
            sign = substr($0, 1, 1)
            if (sign != "+" && sign != "-") next
            line = substr($0, 2)
            gsub(/^[[:space:]"]+/, "", line)
            gsub(/\[[^]]*\]/, "", line)
            op = ""
            i = index(line, ">=")
            if (i > 0) { op = ">="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) }
            if (op == "") { i = index(line, "=="); if (i > 0) { op = "=="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) } }
            if (op == "") { i = index(line, "~="); if (i > 0) { op = "~="; pkg = substr(line, 1, i-1); ver = substr(line, i+2) } }
            if (op == "") next
            gsub(/[[:space:]]/, "", pkg)
            # Validate: package names only contain letters, digits, hyphens, underscores, dots.
            # Mangled names (e.g. constraint-dependencies=["pyyaml) are dropped.
            if (pkg !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) next
            gsub(/[",:[:space:]].*/, "", ver)
            if (pkg == "" || ver == "") next
            pk = tolower(pkg)
            if (sign == "-") { d_old[pk] = ver; d_old_name[pk] = pkg }
            else              { d_new[pk] = ver; d_new_name[pk] = pkg }
          }
          END {
            for (pk in d_new) {
              nv = d_new[pk]
              if (pk in d_old) {
                if (d_old[pk] == nv) continue
                ov = d_old[pk]
                nm = d_old_name[pk]
              } else if (pk in fallback_old) {
                ov = fallback_old[pk]
                nm = fallback_name[pk]
              } else { continue }
              print nm " " ov " " nv
            }
          }
        ' 2>/dev/null || true
      )"
      # Merge lockfile-only landings (transitive upgrade-package path).
      seen_py_pkgs=""
      while IFS=' ' read -r pkg _o _n; do
        [[ -z "$pkg" ]] && continue
        seen_py_pkgs="${seen_py_pkgs}"$'\n'"$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
      done <<< "${actual_py_lines}"
      lock_actual_lines="$(py_uv_actual_lines_from_lock "$worktree_path" "$py_lines_arg")"
      while IFS=' ' read -r pkg old_ver new_ver; do
        [[ -z "$pkg" ]] && continue
        pkg_norm="$(printf '%s' "$pkg" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
        if printf '%s\n' "$seen_py_pkgs" | grep -qxF "$pkg_norm"; then
          continue
        fi
        if [[ -n "$actual_py_lines" ]]; then
          actual_py_lines="${actual_py_lines}"$'\n'"${pkg} ${old_ver} ${new_ver}"
        else
          actual_py_lines="${pkg} ${old_ver} ${new_ver}"
        fi
      done <<< "${lock_actual_lines}"
    fi
  fi

  # ── Rust / Cargo ─────────────────────────────────────────────────────────
  local any_rust=0
  if [[ "$has_rust" == '1' && -n "$rust_lines_arg" && "$security_only" == '0' ]]; then
    while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
      [[ -z "$pkg" ]] && continue
      log "[rust] Batch update: ${pkg} ${old_ver} → ${new_ver}"
      cargo_add_args=("${pkg}@${new_ver}")
      case "${dep_kind:-Normal}" in
        Development) cargo_add_args=(--dev "${cargo_add_args[@]}") ;;
        Build)       cargo_add_args=(--build "${cargo_add_args[@]}") ;;
        *)           : ;;
      esac
      if [[ -n "${dep_platform:-}" && "${dep_platform}" != "-" ]]; then
        cargo_add_args=(--target "$dep_platform" "${cargo_add_args[@]}")
      fi
      if rust_workspace_enabled "$worktree_path" && [[ "${dep_package:-"-"}" != "-" ]]; then
        cargo_add_args=(--package "$dep_package" "${cargo_add_args[@]}")
      fi
      if ! dep_runner_cargo_dir "cargo batch add" "$worktree_path" -- add "${cargo_add_args[@]}"; then
        dep_updater_append_ecosystem_failure "rust|batch crate add failed for ${pkg}"
      fi
    done <<< "$rust_lines_arg"
    run_command "git worktree" git -C "$worktree_path" add -u
    if ! git -C "$worktree_path" diff --cached --quiet; then
      any_rust=1
      if ! rust_recover_post_bump_clippy "$worktree_path"; then
        log "[rust] Reverting Rust batch bumps after unrecovered clippy; continuing other ecosystems."
        rust_revert_post_bump_workdir "$worktree_path"
        any_rust=0
      else
        run_command "git worktree" git -C "$worktree_path" add -u
      fi
    fi
  fi

  # ── GitHub Actions ───────────────────────────────────────────────────────
  local any_gha=0
  if [[ "$has_gha" == '1' && -n "$gha_lines_arg" && "$security_only" == '0' ]]; then
    local gnu_sed_bin
    gnu_sed_bin="$(tooling_prereq_gnu_sed_path)"
    while IFS=' ' read -r action cur_ref new_ref; do
      [[ -z "$action" ]] && continue
      log "[github-actions] Batch update: ${action} ${cur_ref} → ${new_ref}"
      find "${worktree_path}/.github/workflows" -maxdepth 1 \
        \( -name '*.yml' -o -name '*.yaml' \) \
        -exec "$gnu_sed_bin" -i \
          -e "s|uses: ${action}@${cur_ref}|uses: ${action}@${new_ref}|g" \
          {} +
    done <<< "$gha_lines_arg"
    run_command "git worktree" git -C "$worktree_path" add .github/workflows/ 2>/dev/null || true
    if ! git -C "$worktree_path" diff --cached --quiet -- .github/; then
      any_gha=1
    fi
  fi

  # Determine which npm packages actually changed after install.
  # pnpm outdated can report packages whose lockfile already resolves them to
  # the latest version (node_modules was stale).  Using the pre/post package.json
  # diff gives the ground truth: only packages whose specifier actually changed.
  local actual_npm_lines=""
  if [[ "$any_npm" == '1' && -n "$old_pkg_json" ]]; then
  # shellcheck disable=SC2016  # jq filter uses jq variables, not shell expansion
    actual_npm_lines="$(dep_runner_jq_file_args "jq actual npm lines" "${npm_root}/package.json" -r --argjson old "$old_pkg_json" '
        ([$old.dependencies, $old.devDependencies, $old.peerDependencies]
          | map(select(. != null)) | add // {}) as $old_deps |
        [.dependencies, .devDependencies, .peerDependencies]
          | map(select(. != null)) | add // {}
          | to_entries[]
          | select($old_deps[.key] != .value)
          | "\(.key) \($old_deps[.key] // "-") \(.value)"
      ' 2>/dev/null || true)"
  fi

  # Report lines: uv uses lock/pyproject ground truth only (never planned lines —
  # that re-reported failed applies). Non-uv tools do not yet parse
  # Pipfile/requirements diffs, so when apply succeeded fall back to the planned
  # list for those ecosystems only.
  report_py_lines="$actual_py_lines"
  if [[ -z "$report_py_lines" && "$any_py" == '1' && -n "${py_tool:-}" && "$py_tool" != 'uv' ]]; then
    report_py_lines="$py_lines_arg"
  fi

  if git -C "$worktree_path" diff --cached --quiet; then
    log "Batch: no file changes — all dependencies already up to date. Skipping PR."
    return 0
  fi

  local has_cves=0
  [[ -n "$npm_audit_lines_arg" || ( -n "$py_audit_lines_arg" && "$any_py" == '1' ) ]] && has_cves=1

  local commit_msg
  if [[ "$security_only" == '1' ]]; then
    commit_msg="fix(deps): patch all CVE vulnerabilities"
  elif [[ "$has_cves" == '1' ]]; then
    commit_msg="fix(deps): batch updates including CVE fixes"
  else
    commit_msg="chore(deps): batch dependency updates"
  fi

  run_command "git worktree" git -C "$worktree_path" checkout -b "$branch"
  _worktree_commit "$commit_msg"
  dep_stack_register_branch_optional
  log "[gate] Submitting batch PR for '${branch}'…"
  dep_stack_submit_current

  local pr_num
  pr_num="$(wait_for_pr_number_for_new_branch "$branch" || true)"
  [[ -z "$pr_num" ]] && die "Could not determine PR number for batch branch '${branch}'"

  # Build PR body
  local body_file
  body_file="$(mktemp)"
  {
    if [[ "$security_only" == '1' ]]; then
      printf '## Security: CVE fixes\n\n'
      printf "Automated security updates via \`dep-updater --batch --security-only\`.\n\n"
      printf 'Patching all packages with known vulnerabilities that have a fix available.\n\n'
    else
      printf '## Batch dependency updates\n\n'
      printf "Automated dependency updates via \`dep-updater --batch\`.\n\n"
      printf 'All outdated packages and CVE fixes combined into a single PR.\n\n'
    fi
    if [[ -n "$npm_audit_lines_arg" ]]; then
      printf '## npm CVEs addressed\n\n'
      printf '| Package | Current | Fixed | CVEs |\n'
      printf '|---|---|---|---|\n'
      while IFS=' ' read -r pkg current fix cves; do
        [[ -z "$pkg" ]] && continue
        printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" "$pkg" "$current" "$fix" "${cves/,/, }"
      done <<< "$npm_audit_lines_arg"
      printf '\n'
    fi
    if [[ -n "$py_audit_lines_arg" && "$any_py" == '1' ]]; then
      printf '## Python CVEs addressed\n\n'
      printf '| Package | Current | Fixed | CVEs |\n'
      printf '|---|---|---|---|\n'
      while IFS=' ' read -r pkg current fix cves; do
        [[ -z "$pkg" ]] && continue
        printf "| \`%s\` | \`%s\` | \`%s\` | %s |\n" "$pkg" "$current" "$fix" "${cves/,/, }"
      done <<< "$py_audit_lines_arg"
      printf '\n'
    fi
    if [[ "$security_only" == '0' ]]; then
      printf '## Dependency update summary\n\n'
      printf '| Ecosystem | Package | From | To | CVE? | CVEs |\n'
      printf '|---|---|---|---|---|---|\n'
      if [[ -n "$actual_npm_lines" ]]; then
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          printf "| %s | \`%s\` | \`%s\` | \`%s\` | no | - |\n" "npm" "$pkg" "$old_ver" "$new_ver"
        done <<< "$actual_npm_lines"
      fi
      if [[ -n "$report_py_lines" ]]; then
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          printf "| python/%s | \`%s\` | \`%s\` | \`%s\` | no | - |\n" "$py_tool" "$pkg" "$old_ver" "$new_ver"
        done <<< "$report_py_lines"
      fi
      if [[ "$any_rust" == '1' && -n "$rust_lines_arg" ]]; then
        while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
          [[ -z "$pkg" ]] && continue
          printf "| rust/cargo | \`%s\` | \`%s\` | \`%s\` | no | - |\n" "$pkg" "$old_ver" "$new_ver"
        done <<< "$rust_lines_arg"
      fi
      if [[ "$any_gha" == '1' && -n "$gha_lines_arg" ]]; then
        while IFS=' ' read -r action cur_ref new_ref; do
          [[ -z "$action" ]] && continue
          printf "| github-actions | \`%s\` | \`%s\` | \`%s\` | no | - |\n" "$action" "$cur_ref" "$new_ref"
        done <<< "$gha_lines_arg"
      fi
      if [[ -n "$npm_audit_lines_arg" ]]; then
        while IFS=' ' read -r pkg current fix cves; do
          [[ -z "$pkg" ]] && continue
          printf "| %s | \`%s\` | \`%s\` | \`%s\` | yes | %s |\n" "npm" \
            "$pkg" "$current" "$fix" "${cves/,/, }"
        done <<< "$npm_audit_lines_arg"
      fi
      if [[ -n "$py_audit_lines_arg" && "$any_py" == '1' ]]; then
        while IFS=' ' read -r pkg current fix cves; do
          [[ -z "$pkg" ]] && continue
          printf "| python/%s | \`%s\` | \`%s\` | \`%s\` | yes | %s |\n" \
            "$py_tool" "$pkg" "$current" "$fix" "${cves/,/, }"
        done <<< "$py_audit_lines_arg"
      fi
      printf '\n'

      if [[ -n "$pnpm_ignored_build_pkgs" ]]; then
        printf '## Skipped packages\n\n'
        printf "%s\n\n" "pnpm refused to run dependency build scripts (\`ERR_PNPM_IGNORED_BUILDS\`). The following package(s) were skipped in this run:"
        while IFS= read -r p; do
          [[ -z "$p" ]] && continue
          printf -- "- \`%s\`\n" "$p"
        done <<< "$pnpm_ignored_build_pkgs"
        printf "\n%s\n\n" "To resolve permanently, run \`pnpm approve-builds\` (or \`pnpm approve-builds --all\`)."
      fi

      if [[ -n "$actual_npm_lines" ]]; then
        printf '## npm updates\n\n'
        printf '| Package | From | To |\n'
        printf '|---|---|---|\n'
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$pkg" "$old_ver" "$new_ver"
        done <<< "$actual_npm_lines"
        printf '\n'
      fi
      if [[ -n "$report_py_lines" ]]; then
        printf '## Python updates\n\n'
        printf '| Package | From | To |\n'
        printf '|---|---|---|\n'
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$pkg" "$old_ver" "$new_ver"
        done <<< "$report_py_lines"
      fi
      if [[ "$any_rust" == '1' && -n "$rust_lines_arg" ]]; then
        printf '## Rust updates\n\n'
        printf '| Crate | From | To |\n'
        printf '|---|---|---|\n'
        while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
          [[ -z "$pkg" ]] && continue
          printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$pkg" "$old_ver" "$new_ver"
        done <<< "$rust_lines_arg"
        printf '\n'
      fi
      if [[ "$any_gha" == '1' && -n "$gha_lines_arg" ]]; then
        printf '## GitHub Actions updates\n\n'
        printf '| Action | From | To |\n'
        printf '|---|---|---|\n'
        while IFS=' ' read -r action cur_ref new_ref; do
          [[ -z "$action" ]] && continue
          printf "| \`%s\` | \`%s\` | \`%s\` |\n" "$action" "$cur_ref" "$new_ref"
        done <<< "$gha_lines_arg"
      fi
    fi
  } > "$body_file"

  if [[ "$has_cves" == '1' ]]; then
    dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
      --repo "${repo_owner}/${repo_name}" \
      --title "$commit_msg" \
      --body-file "$body_file" \
      --add-label "dep-updater" \
      --add-label "security" || true
  else
    dep_runner_gh_stdout "gh pr" -- pr edit "$pr_num" \
      --repo "${repo_owner}/${repo_name}" \
      --title "$commit_msg" \
      --body-file "$body_file" \
      --add-label "dep-updater" || true
  fi
  rm -f "$body_file"
  state_append "branches" "$branch"
  state_append_pr "$pr_num"
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "npm" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num" "no" "-"
  done <<< "${actual_npm_lines:-}"
  while IFS=' ' read -r pkg _current fix _cves; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "npm" "$pkg" "$_current" "$fix" "$branch" "$pr_num" "yes" "${_cves:--}"
  done <<< "${npm_audit_lines_arg:-}"
  while IFS=' ' read -r pkg old_ver new_ver; do
    [[ -z "$pkg" ]] && continue
    add_summary_line "python/${py_tool}" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num" "no" "-"
  done <<< "${report_py_lines:-}"
  if [[ "$any_py" == '1' ]]; then
    while IFS=' ' read -r pkg _current fix _cves; do
      [[ -z "$pkg" ]] && continue
      add_summary_line "python/${py_tool}" "$pkg" "$_current" "$fix" "$branch" "$pr_num" "yes" "${_cves:--}"
    done <<< "${py_audit_lines_arg:-}"
  fi
  if [[ "$any_rust" == '1' ]]; then
    while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
      [[ -z "$pkg" ]] && continue
      add_summary_line "rust/cargo" "$pkg" "$old_ver" "$new_ver" "$branch" "$pr_num" "no" "-"
    done <<< "${rust_lines_arg:-}"
  fi
  if [[ "$any_gha" == '1' ]]; then
    while IFS=' ' read -r action cur_ref new_ref; do
      [[ -z "$action" ]] && continue
      add_summary_line "github-actions" "$action" "$cur_ref" "$new_ref" "$branch" "$pr_num" "no" "-"
    done <<< "${gha_lines_arg:-}"
  fi
  if [[ -z "$actual_npm_lines" && -z "$npm_audit_lines_arg" && \
        -z "$report_py_lines" && ( -z "$py_audit_lines_arg" || "$any_py" != '1' ) && \
        "$any_rust" == '0' && "$any_gha" == '0' ]]; then
    add_summary_line "batch" "$branch" "-" "-" "$branch" "$pr_num" "no" "-"
  fi
}

# ---------------------------------------------------------------------------
# CI polling
# ---------------------------------------------------------------------------

wait_for_ci() {
  local -r branch="$1"
  local -r target_sha="${2:-}"
  local -r pr_num="${3:-}"
  local -r timeout_min=20
  local -r poll_sec=15
  local elapsed_sec=0
  local elapsed_fmt wait_suffix
  # Check for merge conflicts every 4 cycles (~2 min) while CI runs.
  local -r mergeable_check_interval=4
  local cycles_since_mergeable_check=0
  local status raw merge_state already_merged
  local cancelled_diag rollup_diag latest_diag

  if [[ -n "$target_sha" ]]; then
    log "Waiting for CI: pr=#${pr_num} branch='${branch}' head=${target_sha:0:8}"
  else
    log "Waiting for CI: pr=#${pr_num} branch='${branch}'"
  fi

  [[ -n "$pr_num" ]] || die "CI gate requires a PR number for '${branch}'. Expected PR to exist after gt submit."

  while true; do
    # Short-circuit: if the PR is already merged, CI obviously passed.
    already_merged="$(gh_pr_merged_for_number "$pr_num")"
    if [[ "$already_merged" == 'true' ]]; then
      log "PR #${pr_num} already merged — CI gate passed."
      return 0
    fi

    # Gate CI on the PR check rollup (not workflow runs) to avoid false positives
    # before checks are attached to the PR head.
    status="$(ci_conclusion_for_pr "$pr_num")"
    [[ -n "$status" ]] || die "Could not determine CI status from PR #${pr_num} statusCheckRollup."

    # Format elapsed time for display.
    if (( elapsed_sec < 60 )); then
      elapsed_fmt="${elapsed_sec}s"
    else
      elapsed_fmt="$(( elapsed_sec / 60 ))m $(( elapsed_sec % 60 ))s"
    fi
    wait_suffix="[waited ${elapsed_fmt} / ${timeout_min}m, next check in ${poll_sec}s]"

    case "$status" in
      success)
        log "CI passed: pr=#${pr_num} branch='${branch}'"
        return 0
        ;;
      failure)
        dep_updater_handle_ci_failure "$pr_num" "$branch"
        ;;
      missing)
        # GitHub hasn't scheduled CI yet — this is normal right after a push.
        # Keep polling; the 20-minute timeout guards against CI never being scheduled.
        log "Still waiting for CI scheduling: pr=#${pr_num} branch='${branch}' status=${status} ${wait_suffix}"
        ;;
      *)
        # CI is running — log progress and break down per-workflow status.
        log "Still waiting for CI completion: pr=#${pr_num} branch='${branch}' status=${status} ${wait_suffix}"
        ;;
    esac

    # Periodically re-check for merge conflicts so a conflict that appears
    # after the initial push (e.g. concurrent merge to main) is caught quickly.
    cycles_since_mergeable_check=$(( cycles_since_mergeable_check + 1 ))
    if [[ -n "$pr_num" && $cycles_since_mergeable_check -ge $mergeable_check_interval ]]; then
      cycles_since_mergeable_check=0
      merge_state="$(dep_runner_gh_pr_jq "gh pr mergeable during CI wait" "$pr_num" mergeable '.mergeable' || true)"
      [[ -n "$merge_state" ]] || merge_state='UNKNOWN'
      if [[ "$merge_state" == 'CONFLICTING' ]]; then
        die "PR #${pr_num} developed merge conflicts during CI wait. Rebase the stack and re-run."
      fi
    fi

    sleep "$poll_sec"
    elapsed_sec=$(( elapsed_sec + poll_sec ))
    if (( elapsed_sec >= timeout_min * 60 )); then
      # Use a single concise timeout line that batch-all can postprocess.
      if (( elapsed_sec < 60 )); then
        elapsed_fmt="${elapsed_sec}s"
      else
        elapsed_fmt="$(( elapsed_sec / 60 ))m $(( elapsed_sec % 60 ))s"
      fi
      # Include CANCELLED check names so cancel stalls are visible (#454).
      cancelled_diag=""
      rollup_diag="$(ci_rollup_json_for_pr "$pr_num" 2>/dev/null || true)"
      latest_diag="$(ci_rollup_latest_by_name_json "${rollup_diag:-[]}")"
      latest_diag="$(ci_rollup_without_agent_product_checks "$latest_diag")"
      cancelled_diag="$(ci_rollup_cancelled_names_csv "$latest_diag" 2>/dev/null || true)"
      if [[ -n "$cancelled_diag" ]]; then
        die "WAIT_TIMEOUT ci pr=#${pr_num} branch='${branch}' waited=${elapsed_fmt} timeout=${timeout_min}m status=${status} cancelled=${cancelled_diag}"
      fi
      die "WAIT_TIMEOUT ci pr=#${pr_num} branch='${branch}' waited=${elapsed_fmt} timeout=${timeout_min}m status=${status}"
    fi
  done
}

ci_run_exists_for_head() {
  local -r branch="$1"
  local -r target_sha="$2"
  local exit_code uuid json jq_exit

  exit_code=0
  runner_exec "gh run list for ci check" -- gh run list \
    --repo "${repo_owner}/${repo_name}" --branch "$branch" --limit 30 --json name,headSha \
    || exit_code=$?
  uuid="$(runner_last_id)"
  json="$(runner_read "$uuid" stdout 2>/dev/null || true)"
  if [[ -z "$json" ]]; then
    return 1
  fi
  jq_exit=0
  tmp_json="$(mktemp)"
  printf '%s' "$json" >"$tmp_json"
  # shellcheck disable=SC2016  # jq filter uses $sha/$names variables, not shell expansion
  runner_exec "jq ci run exists" -- jq -e --arg sha "$target_sha" --arg names "$ci_workflow_names" \
    'any(.[]; .headSha == $sha and ($names == "" or (.name as $n | $names | split("\n") | index($n) != null)))' \
    "$tmp_json" >/dev/null || jq_exit=$?
  rm -f "$tmp_json"
  return "$jq_exit"
}

ci_conclusion_for_pr() {
  local -r pr_num="$1"

  ci_rollup_conclusion_for_pr_gating "$pr_num" "${repo_owner}/${repo_name}" "$ci_required_contexts"
}

wait_for_mergeable() {
  local -r pr_num="$1"
  local -r timeout_min=5
  local elapsed=0
  local state already_merged

  # Skip the conflict check if the PR is already merged (GitHub sets mergeable
  # to UNKNOWN on merged PRs, which would cause us to poll until timeout).
  already_merged="$(gh_pr_merged_for_number "$pr_num")"
  if [[ "$already_merged" == 'true' ]]; then
    log "PR #${pr_num} already merged — skipping conflict check."
    return 0
  fi

  log "Checking merge conflict status for PR #${pr_num}…"
  while true; do
    state="$(dep_runner_gh_pr_jq "gh pr mergeable check" "$pr_num" mergeable '.mergeable' || true)"
    [[ -n "$state" ]] || state='UNKNOWN'
    case "$state" in
      MERGEABLE)
        log "PR #${pr_num} is mergeable."
        return 0
        ;;
      CONFLICTING)
        cleanup_on_error "PR #${pr_num} has merge conflicts"
        die "PR #${pr_num} has merge conflicts. Rebase the stack and re-run."
        ;;
      UNKNOWN|'')
        if gh_pr_compare_ff_mergeable_for_number "$pr_num"; then
          log "PR #${pr_num}: mergeable=UNKNOWN; compare fallback (ahead, behind_by=0) — treating as mergeable."
          gh_pr_post_mergeable_compare_fallback_comment_optional "$pr_num" "$(( elapsed * 10 ))"
          return 0
        fi
        log "Still waiting for merge conflict status: pr=#${pr_num} mergeable=${state}"
        ;;
    esac
    sleep 10
    elapsed=$(( elapsed + 1 ))
    if (( elapsed * 10 >= timeout_min * 60 )); then
      if gh_pr_compare_ff_mergeable_for_number "$pr_num"; then
        log "PR #${pr_num}: mergeable UNKNOWN after ${timeout_min}m; compare fallback (ahead, behind_by=0) — treating as mergeable."
        gh_pr_post_mergeable_compare_fallback_comment_optional "$pr_num" "$(( timeout_min * 60 ))"
        return 0
      fi
      die "Timed out waiting for PR #${pr_num} mergeable state after ${timeout_min} min."
    fi
  done
}

# Quick mergeable pre-check: called right after gt submit, before initiating CI
# wait. Polls for up to 60 s. Dies immediately on CONFLICTING (no point waiting
# for CI that will never schedule). On MERGEABLE confirms early. On UNKNOWN
# after timeout, proceeds — the final wait_for_mergeable after CI will catch it.
wait_for_mergeable_quick() {
  local -r pr_num="$1"
  local -r timeout_sec=60
  local elapsed=0
  local state

  log "Checking merge conflict status (quick): pr=#${pr_num}"
  while true; do
    state="$(dep_runner_gh_pr_jq "gh pr mergeable check" "$pr_num" mergeable '.mergeable' || true)"
    [[ -n "$state" ]] || state='UNKNOWN'
    case "$state" in
      MERGEABLE)
        log "PR #${pr_num}: no merge conflicts detected."
        return 0
        ;;
      CONFLICTING)
        cleanup_on_error "PR #${pr_num} has merge conflicts"
        die "PR #${pr_num} has merge conflicts. Check that the worktree base matches origin/main and re-run."
        ;;
      UNKNOWN|'')
        log "Still waiting for merge conflict status (quick): pr=#${pr_num} mergeable=${state} waited=${elapsed}s/${timeout_sec}s"
        ;;
    esac
    sleep 5
    elapsed=$(( elapsed + 5 ))
    if (( elapsed >= timeout_sec )); then
      log "PR #${pr_num}: merge conflict status still UNKNOWN after ${timeout_sec}s — proceeding to CI wait."
      return 0
    fi
  done
}

ensure_dep_updater_label() {
  # Create the 'dep-updater' label on the repo if it doesn't already exist.
  # Idempotent: gh label create exits non-zero if the label exists; we ignore that.
  dep_runner_gh --probe "gh label" -- label create 'dep-updater' \
    --repo "${repo_owner}/${repo_name}" \
    --color '0075ca' \
    --description 'Automated dependency update via dep-updater' \
    2>/dev/null || true
}

require_resume_ci_gate() {
  local -r branches_csv="$1"
  local -r prs_csv="$2"

  [[ "$no_wait_ci" == '1' ]] && return 0
  [[ -z "$branches_csv" ]] && return 0

  local last_branch last_pr
  last_branch="$(csv_last "$branches_csv")"
  [[ -z "$last_branch" ]] && return 0

  # Resolve PR from branch directly; do not rely on parallel CSV position.
  last_pr="$(gh_pr_number_for_branch "$last_branch")"
  if [[ -z "$last_pr" && -n "$prs_csv" ]]; then
    # Backward-compat fallback for older state files.
    last_pr="$(csv_last "$prs_csv")"
  fi
  if [[ -n "$last_pr" ]] && ! is_valid_pr_number "$last_pr"; then
    last_pr=""
  fi
  [[ -z "$last_pr" ]] && return 0

  local pr_state pr_merged
  pr_state="$(gh_pr_state_for_number "$last_pr")"
  pr_merged="$(gh_pr_merged_for_number "$last_pr")"
  if [[ "$pr_merged" == 'true' || "$pr_state" == 'closed' ]]; then
    return 0
  fi

  if ! git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${last_branch}"; then
    # Branch may have been wiped by a prior cleanup interrupt. Try the remote.
    if git -C "$worktree_path" show-ref --verify --quiet "refs/remotes/origin/${last_branch}" 2>/dev/null; then
      if git -C "$worktree_path" checkout --track "origin/${last_branch}" --quiet 2>/dev/null; then
        log "Checked out '${last_branch}' from origin for resume CI gate."
      else
        log "Resume CI gate skipped: could not check out '${last_branch}' from origin."
        return 0
      fi
    else
      log "Resume CI gate skipped: branch '${last_branch}' not found locally or on origin."
      return 0
    fi
  fi

  local current_head
  current_head="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse "$last_branch" 2>/dev/null || true)"
  if [[ -z "$current_head" ]]; then
    log "Resume CI gate skipped: could not resolve head SHA for '${last_branch}'."
    return 0
  fi

  if ! ci_run_exists_for_head "$last_branch" "$current_head"; then
    log "Resuming after existing PR #${last_pr} (${last_branch}); no CI run exists for current head ${current_head:0:8}."
    log "Skipping CI wait; rebase/push this branch to trigger fresh CI, then re-run dep-updater."
    return 0
  fi

  # Check current CI conclusion before deciding what to do.
  # Use PR statusCheckRollup (ci_conclusion_for_pr), not gh run list: SKIPPED-only
  # push runs must not count as passed (issue #430 / resume path).
  local ci_status
  ci_status="$(ci_conclusion_for_pr "$last_pr")"

  case "$ci_status" in
    failure)
      # CI has already failed on the interrupted PR — close it automatically
      # and clean up so the next run starts fresh.
      cleanup
      _cleanup_trap_active=0
      dep_updater_handle_ci_failure "$last_pr" "$last_branch"
      ;;
    success)
      # CI already passed — nothing to wait for.
      log "Resuming after existing PR #${last_pr} (${last_branch}); CI already passed."
      return 0
      ;;
    *)
      # CI is still pending (or conclusion unknown).
      log "PR #${last_pr} (${last_branch}) is still waiting on CI (status: ${ci_status})."
      if is_interactive; then
        if prompt_yes_no "Wait for CI on PR #${last_pr}?" "y"; then
          log "Waiting for CI on PR #${last_pr} (${last_branch})…"
          wait_for_ci "$last_branch" "$current_head" "$last_pr"
        elif prompt_yes_no "Close PR #${last_pr} and start fresh?" "n"; then
          log "Closing PR #${last_pr}…"
          dep_runner_gh_stdout "gh pr" -- pr close "$last_pr" \
            --repo "${repo_owner}/${repo_name}" \
            --comment "Closed by dep-updater: run was interrupted while CI was pending." \
            2>/dev/null || true
          cleanup
          _cleanup_trap_active=0
          die "PR #${last_pr} has been closed. Re-run dep-updater to create a fresh update."
        else
          log "Leaving PR #${last_pr} open. Re-run dep-updater when ready to continue."
          exit 0
        fi
      else
        # Non-interactive (e.g. CI): resume waiting as before.
        log "Resuming after existing PR #${last_pr} (${last_branch}); waiting for CI before creating new PRs..."
        wait_for_ci "$last_branch" "$current_head" "$last_pr"
      fi
      ;;
  esac
}

gate_branch_head_sha() {
  local -r branch="$1"
  local -r pr_num="$2"
  local sha

  sha="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse "$branch" 2>/dev/null || true)"
  if [[ -n "$sha" ]]; then
    printf '%s' "$sha"
    return 0
  fi
  if git -C "$worktree_path" show-ref --verify --quiet "refs/remotes/origin/${branch}" 2>/dev/null; then
    sha="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse "origin/${branch}" 2>/dev/null || true)"
    if [[ -n "$sha" ]]; then
      printf '%s' "$sha"
      return 0
    fi
  fi
  if [[ -n "$pr_num" ]]; then
    sha="$(gh_pr_head_sha_for_number "$pr_num")"
    if [[ -n "$sha" ]]; then
      printf '%s' "$sha"
      return 0
    fi
  fi
  return 1
}

gate_open_pr_for_ci() {
  local branch="$1"
  local -r pr_num="$2"
  local head_sha already_merged pr_state

  if ! is_valid_pr_number "$pr_num"; then
    die "Expected a valid PR number for CI gate, got '${pr_num}'"
  fi

  already_merged="$(gh_pr_merged_for_number "$pr_num" 2>/dev/null || true)"
  if [[ "$already_merged" == 'true' ]]; then
    return 0
  fi

  pr_state="$(gh_pr_state_for_number "$pr_num")"
  if [[ "$pr_state" == 'closed' ]]; then
    return 0
  fi

  if [[ -z "$branch" ]]; then
    branch="$(gh_pr_head_ref_for_number "$pr_num")"
  fi
  [[ -n "$branch" ]] || die "Could not resolve branch for PR #${pr_num} before CI wait."

  head_sha="$(gate_branch_head_sha "$branch" "$pr_num")"
  [[ -n "$head_sha" ]] \
    || die "Could not resolve head SHA for PR #${pr_num} (branch='${branch}') before CI wait."

  log "[gate] Checking merge conflict status for PR #${pr_num} before waiting for CI…"
  wait_for_mergeable_quick "$pr_num"
  log "[gate] Waiting for CI on PR #${pr_num} (${branch})…"
  wait_for_ci "$branch" "$head_sha" "$pr_num"
  if [[ "$(gh_pr_merged_for_number "$pr_num")" != 'true' ]]; then
    log "[gate] CI passed. Final merge conflict check…"
    wait_for_mergeable "$pr_num"
    log "[gate] PR #${pr_num} is mergeable."
  fi
}

gate_pr_was_gated() {
  local -r pr_number="$1"
  local -a gated_pr_nums=("${@:2}")
  local g

  for g in "${gated_pr_nums[@]}"; do
    [[ "$g" == "$pr_number" ]] && return 0
  done
  return 1
}

# Gates on CI and mergeability for every branch that has been created so far
# in this run.  Called once after all PRs are created so that no individual
# PR is visible as "CI-passed + labelled" before the full stack is assembled.
# Security PRs gate themselves before regular PRs are stacked; this function
# handles the regular (and batch) PRs, and is a fast no-op for branches whose
# CI already passed (wait_for_ci returns success on the first poll).
gate_all_created_prs() {
  local branches_csv prs_csv branch pr_num
  local -a gate_list gated_pr_nums=()
  local tracked_csv tracked_p ungated_csv="" p

  [[ "$no_wait_ci" == '0' ]] || return 0

  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"
  if [[ -z "$branches_csv" && -z "$prs_csv" ]]; then
    return 0
  fi

  if [[ -n "$branches_csv" ]]; then
    IFS=',' read -ra gate_list <<< "$branches_csv"
    for branch in "${gate_list[@]}"; do
      [[ -z "$branch" ]] && continue
      pr_num="$(gh_pr_number_resolve_for_gate "$branch" 2>/dev/null || true)"
      if [[ -z "$pr_num" ]]; then
        die "Could not resolve open PR for branch '${branch}' before CI wait (dep-updater label may be missing)."
      fi
      if gate_pr_was_gated "$pr_num" "${gated_pr_nums[@]}"; then
        continue
      fi
      gate_open_pr_for_ci "$branch" "$pr_num"
      gated_pr_nums+=("$pr_num")
    done
  fi

  if [[ -n "$prs_csv" ]]; then
    IFS=',' read -ra gate_list <<< "$prs_csv"
    for p in "${gate_list[@]}"; do
      [[ -z "$p" ]] && continue
      if ! is_valid_pr_number "$p"; then
        continue
      fi
      if gate_pr_was_gated "$p" "${gated_pr_nums[@]}"; then
        continue
      fi
      branch="$(gh_pr_head_ref_for_number "$p")"
      gate_open_pr_for_ci "$branch" "$p"
      gated_pr_nums+=("$p")
    done
  fi

  tracked_csv="$(collect_tracked_prs_csv)"
  if [[ -z "$tracked_csv" ]]; then
    return 0
  fi

  IFS=',' read -ra gate_list <<< "$tracked_csv"
  for tracked_p in "${gate_list[@]}"; do
    [[ -z "$tracked_p" ]] && continue
    if gate_pr_was_gated "$tracked_p" "${gated_pr_nums[@]}"; then
      continue
    fi
    if [[ -z "$ungated_csv" ]]; then
      ungated_csv="#${tracked_p}"
    else
      ungated_csv="${ungated_csv}, #${tracked_p}"
    fi
  done

  if [[ -n "$ungated_csv" ]]; then
    die "CI wait was skipped for tracked PR(s): ${ungated_csv}; refusing to merge without wait_for_ci."
  fi
}

maybe_label_top_pr_for_merge() {
  local branches_csv prs_csv top_branch top_pr
  branches_csv="$(state_get "branches")"
  prs_csv="$(state_get "prs")"
  [[ -z "$branches_csv" ]] && return 0

  top_branch="$(csv_last "$branches_csv")"
  [[ -z "$top_branch" ]] && return 0

  top_pr="$(gh_pr_number_for_branch "$top_branch")"
  if [[ -z "$top_pr" && -n "$prs_csv" ]]; then
    top_pr="$(csv_last "$prs_csv")"
  fi
  if [[ -n "$top_pr" ]] && ! is_valid_pr_number "$top_pr"; then
    top_pr=""
  fi
  [[ -z "$top_pr" ]] && return 0

  local pr_state pr_merged
  pr_state="$(gh_pr_state_for_number "$top_pr")"
  pr_merged="$(gh_pr_merged_for_number "$top_pr")"
  if [[ "$pr_merged" == 'true' || "$pr_state" == 'closed' ]]; then
    return 0
  fi

  if ! git -C "$worktree_path" show-ref --verify --quiet "refs/heads/${top_branch}"; then
    log "Top stack branch '${top_branch}' not found locally; skipping merge-it prompt."
    return 0
  fi

  local top_head ci_status
  top_head="$(dep_runner_git_c_stdout "git worktree" "$worktree_path" -- rev-parse "$top_branch" 2>/dev/null || true)"
  [[ -z "$top_head" ]] && return 0

  # Use PR statusCheckRollup gating (not gh run list): SKIPPED-only push runs
  # must not look merge-ready (issue #430).
  ci_status="$(ci_conclusion_for_pr "$top_pr")"
  case "$ci_status" in
    success)
      ;;
    *)
      log "Top PR #${top_pr} (${top_branch}) is not merge-ready yet (CI status: ${ci_status})."
      return 0
      ;;
  esac

  local has_label
  has_label="$(pr_has_merge_enqueue_pending "$top_pr")"
  if [[ "$has_label" == 'true' ]]; then
    return 0
  fi
  if [[ "$has_label" == 'unknown' ]]; then
    log "Could not verify merge enqueue state on top PR #${top_pr}; skipping apply this cycle."
    return 0
  fi

  # has_label is definitively false — safe to apply.
  dep_enqueue_pr_for_merge_queue "$top_pr"
  if [[ "$_merge_it_poll_pr" == "$top_pr" && "$_merge_it_poll_had_label" == 'true' ]]; then
    log "Re-applying merge enqueue on top PR #${top_pr} (was present last poll, now absent)."
  else
    log "Enabled auto-merge on top PR #${top_pr}."
  fi
}

# ---------------------------------------------------------------------------
# PR body writer
# ---------------------------------------------------------------------------

write_pr_body() {
  local -r pkg="$1"
  local -r from_ver="$2"
  local -r to_ver="$3"
  local -r eco="$4"
  local -r files="$5"
  local -r cve_lines="${6:-}"  # optional: "pkg current fix cve1,cve2" lines for this package
  local -r body_file="$7"       # caller-provided path (use mktemp)

  # Write to a file and use --body-file to avoid heredoc escaping issues
  {
    printf '%s\n\n' '## Stack Context'
    printf "Automated dependency updates via \`dep-updater\`.\n"
    printf '%s\n\n' 'Each PR bumps exactly one dependency. Merge the full stack to update all.'
    printf '%s\n\n' '## Why?'
    if [[ -n "$cve_lines" ]]; then
      printf "\`%s\` has known CVE(s) and a newer version is available.\n\n" "$pkg"
    else
      printf "\`%s\` has a newer version available.\n\n" "$pkg"
    fi
    printf -- "- **From:** \`%s\`\n" "$from_ver"
    printf -- "- **To:** \`%s\`\n" "$to_ver"
    printf -- '- **Ecosystem:** %s\n' "$eco"
    printf -- '- **Files changed:** %s\n' "$files"
    if [[ -n "$cve_lines" ]]; then
      printf '\n## CVEs addressed\n\n'
      printf '| CVE | Fixed in |\n'
      printf '|---|---|\n'
      while IFS=' ' read -r _p _cur fix cves; do
        [[ -z "$cves" ]] && continue
        local cve
        for cve in ${cves//,/ }; do
          printf "| %s | \`%s\` |\n" "$cve" "$fix"
        done
      done <<< "$cve_lines"
    fi
  } > "$body_file"
}

# ---------------------------------------------------------------------------
# Summary table
# ---------------------------------------------------------------------------

add_summary_line() {
  # Args: ecosystem pkg from to branch pr cve_flag cve_ids
  # Store as a '|' delimited record so PACKAGE names like "(CVE)" can't break parsing.
  # NOTE: Avoid collisions with global readonly variables like $ecosystem.
  local -r summary_ecosystem="${1:-}"
  local -r summary_pkg="${2:-}"
  local -r summary_from="${3:-}"
  local -r summary_to="${4:-}"
  local -r _summary_branch="${5:-}"
  local -r summary_pr="${6:-}"
  local -r summary_cve_flag="${7:-no}"
  local -r summary_cve_ids="${8:-}"

  local entry
  entry="$(printf '%s|%s|%s|%s|%s|%s|%s\n' \
    "$summary_ecosystem" "$summary_pkg" "${summary_from:--}" "${summary_to:--}" \
    "$summary_cve_flag" "${summary_cve_ids:--}" "$summary_pr")"

  if [[ -z "$summary_lines" ]]; then
    summary_lines="$entry"
  else
    summary_lines="${summary_lines}
${entry}"
  fi
}

dep_updater_write_updates_report_json() {
  if [[ -z "${DEP_UPDATER_UPDATES_REPORT:-}" ]]; then
    return 0
  fi

  local updates_json="[]"
  local repo_name_for_report
  repo_name_for_report="$(basename "$dir")"

  while IFS='|' read -r eco pkg from to cve_flag cve_ids pr; do
    [[ -z "$pkg" ]] && continue
    # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
    updates_json="$(dep_runner_jq_with_args "dep-updater updates report row" "$updates_json" \
          --arg repo "$dir" \
          --arg repo_name "$repo_name_for_report" \
          --arg ecosystem "$eco" \
          --arg package "$pkg" \
          --arg from "${from:--}" \
          --arg to "${to:--}" \
          --arg cve "${cve_flag:-no}" \
          --arg cves "${cve_ids:--}" \
          --arg pr "${pr:-}" \
          '. + [{
            repo: $repo,
            repo_name: $repo_name,
            ecosystem: $ecosystem,
            package: $package,
            from: $from,
            to: $to,
            cve: $cve,
            cves: $cves,
            pr: $pr
          }]')"
  done <<< "$summary_lines"

  # shellcheck disable=SC2016  # jq -n emit object uses jq variables, not shell expansion
  dep_runner_jq_n "dep-updater updates report emit" \
    --arg repo "$dir" \
    --arg repo_name "$repo_name_for_report" \
    --argjson updates "$updates_json" \
    '{repo: $repo, repo_name: $repo_name, updates: $updates}' \
    >"${DEP_UPDATER_UPDATES_REPORT}" 2>/dev/null || true
}

dep_updater_batch_all_append_child_updates() {
  local -r child_updates_file="$1"
  local tmp_updates
  local merge_out

  if [[ -z "${DEP_UPDATER_UPDATES_REPORT:-}" || ! -s "$child_updates_file" ]]; then
    return 0
  fi
  if ! dep_runner_jq_file_args "dep-updater batch child updates validate" "$child_updates_file" -e '.updates | type == "array"' >/dev/null 2>&1; then
    return 0
  fi

  if [[ ! -s "${DEP_UPDATER_UPDATES_REPORT}" ]]; then
    printf '[]\n' >"${DEP_UPDATER_UPDATES_REPORT}"
  fi

  tmp_updates="$(mktemp)"
  merge_out=""
  if merge_out="$(runner_exec_stdout "dep-updater batch child updates merge" -- jq -s \
      '.[0] + (.[1].updates // [])' \
      "${DEP_UPDATER_UPDATES_REPORT}" "$child_updates_file" 2>/dev/null)"; then
    printf '%s' "$merge_out" >"$tmp_updates"
    mv "$tmp_updates" "${DEP_UPDATER_UPDATES_REPORT}"
  else
    rm -f "$tmp_updates"
  fi
}

print_stack_urls() {
  local -r prs_csv="$1"
  [[ -z "$prs_csv" ]] && return 0

  local first_pr
  first_pr="${prs_csv%%,*}"
  [[ -z "$first_pr" ]] && return 0

  log ""
  log "Stack URLs:"
  if dep_stacking_is_graphite; then
    log "  Graphite: https://app.graphite.com/github/pr/${repo_owner}/${repo_name}/${first_pr}"
  fi
  local remaining="$prs_csv"
  local pr
  while [[ -n "$remaining" ]]; do
    pr="${remaining%%,*}"
    [[ -n "$pr" ]] && log "  GitHub:   https://github.com/${repo_owner}/${repo_name}/pull/${pr}"
    if [[ "$remaining" == *,* ]]; then
      remaining="${remaining#*,}"
    else
      break
    fi
  done
}

print_summary() {
  if [[ -z "$summary_lines" ]]; then
    log ""
    log "Dependency update summary:"
    log "  No new dependency PRs were created in this run."
    return 0
  fi

  log ""
  log "Dependency update summary:"

    # summary_lines entries: ecosystem|pkg|from|to|cve_flag|cve_ids|pr
  # Put the header inside the column pipeline so all widths align.
  # Use '-' for empty from/to (batch and security-only PRs have no version range).
  {
    printf 'ECOSYSTEM|PACKAGE|FROM|TO|CVE?|CVEs|PR\n'
    while IFS='|' read -r eco pkg from to cve_flag cve_ids pr; do
      [[ -z "$pkg" ]] && continue
      printf '%s|%s|%s|%s|%s|%s|#%s\n' \
        "$eco" "$pkg" "${from:--}" "${to:--}" "${cve_flag:-no}" "${cve_ids:--}" "$pr"
    done <<< "$summary_lines"
  } | column -t -s '|' >&2
}

# ---------------------------------------------------------------------------
# Worktree cleanup helpers
# ---------------------------------------------------------------------------

cleanup_on_error() {
  local -r reason="$1"
  local leave_prs_open=0
  local preserve_worktree=0
  local saved_prs="" saved_p saved_merged saved_state comment

  log "Cleaning up after error: ${reason}"
  primary_repo_recover || true

  # Leave PRs open when the failure is merge/auto-merge config or CI-not-ready —
  # closing them drops a recoverable PR (issue #430 / tsp-maximizer#128).
  # Graphite timeout dies that say "preserving existing worktree" keep both the
  # worktree and any same-run PRs so the next attempt does not duplicate stacks.
  case "$reason" in
    *'gh merge failed'*|*'Auto merge is not allowed'*|*'enablePullRequestAutoMerge'*|\
    *'CI not ready'*|*'refusing gh merge'*|*'is not CI-green'*|WAIT_TIMEOUT*|*'WAIT_TIMEOUT '*|\
    *'preserving existing worktree'*)
      leave_prs_open=1
      ;;
  esac
  case "$reason" in
    *'preserving existing worktree'*)
      preserve_worktree=1
      ;;
  esac

  # Close any open PRs created in this session so a subsequent run starts fresh
  # (unless leave_prs_open — then comment and keep the PR for retry).
  if [[ -n "$state_file" && -f "$state_file" ]]; then
    saved_prs="$(state_get "prs" 2>/dev/null || true)"
    if [[ -n "$saved_prs" ]]; then
      log "Run created PR(s): $(csv_pretty "$saved_prs")"
      if [[ "$leave_prs_open" == '1' ]]; then
        log "Leaving PRs open for retry (merge/CI gate failure)."
      else
        log "Closing any still-open PRs created by this run."
      fi
      IFS=',' read -ra saved_prs_list <<< "$saved_prs"
      for saved_p in "${saved_prs_list[@]}"; do
        [[ -z "$saved_p" ]] && continue
        saved_merged="$(gh_pr_merged_for_number "$saved_p" 2>/dev/null || true)"
        saved_state="$(gh_pr_state_for_number "$saved_p" 2>/dev/null || true)"
        if [[ "$saved_merged" != 'true' && "$saved_state" == 'open' ]]; then
          if [[ "$leave_prs_open" == '1' ]]; then
            comment="dep-updater hit an error and left this PR open for retry: ${reason}"
            dep_runner_gh_stdout "gh pr" -- pr comment "$saved_p" \
              --repo "${repo_owner}/${repo_name}" \
              --body "$comment" 2>/dev/null || true
            log "Left PR #${saved_p} open (commented)."
          else
            comment="Closed by dep-updater after error: ${reason}. Re-run to create a fresh update."
            log "Closing PR #${saved_p} (cleanup on error — re-run to submit a fresh PR)."
            dep_runner_gh_stdout "gh pr" -- pr close "$saved_p" \
              --repo "${repo_owner}/${repo_name}" \
              --comment "$comment" 2>/dev/null || true
          fi
        fi
      done
    fi
  fi
  if [[ "$preserve_worktree" == '1' ]]; then
    log "[worktree] Preserving worktree after timeout: ${worktree_path}"
  elif [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    log "[worktree] Removing worktree: $worktree_path"
    run_command "git repo" git -C "$dir" worktree remove --force "$worktree_path" 2>/dev/null \
      || log "Note: worktree directory already removed."
    if [[ -n "$wt_base_branch" ]]; then
      log "[worktree] Deleting branch: $wt_base_branch"
      run_command "git repo" git -C "$dir" branch -D "$wt_base_branch" 2>/dev/null \
        || log "Note: wt_base_branch '${wt_base_branch}' not found; skipping deletion."
    fi
  fi
  # Preserve the state file so a subsequent run can detect open PRs via
  # require_resume_ci_gate and handle them (wait, prompt, or auto-close).
  # cleanup() (the success path) is responsible for the final deletion.
}

cleanup() {
  log "Cleaning up worktree…"
  primary_repo_recover || true
  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    log "[worktree] Removing worktree: $worktree_path"
    run_command "git repo" git -C "$dir" worktree remove --force "$worktree_path" 2>/dev/null \
      || log "Note: worktree directory already removed."
    log "[worktree] Worktree removed."
  fi
  if [[ -n "$wt_base_branch" ]]; then
    log "[worktree] Deleting branch: $wt_base_branch"
    run_command "git repo" git -C "$dir" branch -D "$wt_base_branch" 2>/dev/null \
      || log "Note: wt_base_branch '${wt_base_branch}' not found."
  fi
  rm -f "$state_file"
  log "Cleanup complete."
}

merge_pr_via_gh_single() {
  local -r pr_num="$1"
  local -r timeout_min="${merge_timeout_min}"
  local -r poll_sec=10
  local merged ci_status merge_out merge_exit elapsed elapsed_fmt
  local merge_branch merge_head

  merged="$(gh_pr_merged_for_number "$pr_num")"
  if [[ "$merged" == 'true' ]]; then
    log "PR #${pr_num} already merged."
    return 0
  fi

  ci_status="$(ci_conclusion_for_pr "$pr_num")"
  if [[ "$ci_status" != 'success' && "$no_wait_ci" == '0' ]]; then
    merge_branch="$(gh_pr_head_ref_for_number "$pr_num")"
    merge_head="$(gh_pr_head_sha_for_number "$pr_num")"
    if [[ -n "$merge_branch" && -n "$merge_head" ]]; then
      log "[merge] CI status ${ci_status} on PR #${pr_num}; waiting for CI before gh merge…"
      wait_for_ci "$merge_branch" "$merge_head" "$pr_num"
      ci_status="$(ci_conclusion_for_pr "$pr_num")"
    fi
  fi
  if [[ "$ci_status" != 'success' ]]; then
    if [[ "$ci_status" == 'pending' || "$ci_status" == 'missing' ]]; then
      die "PR #${pr_num} CI not ready (status: ${ci_status}); refusing gh merge without a successful CI wait."
    fi
    die "PR #${pr_num} is not CI-green (status: ${ci_status}); refusing gh merge."
  fi

  # Do not pass gh's delete-branch flag: gh rejects it when a merge queue is
  # required (error: cannot use -d / delete-branch when merge queue enabled).
  # Head-branch cleanup is handled by the repo delete_branch_on_merge setting /
  # cleanup workflows. Keep in sync with dep_enqueue_pr_for_merge_queue
  # (--auto --squash only). Org default is GitHub MQ (issue #466) — never
  # enqueue via leftover merge-it labels.
  log "Enabling auto-merge for PR #${pr_num} via gh (squash)…"
  merge_out=""
  merge_exit=0
  merge_out="$(dep_runner_gh_stdout "gh pr" -- pr merge "$pr_num" \
    --repo "${repo_owner}/${repo_name}" \
    --auto --squash 2>&1)" || merge_exit=$?
  if (( merge_exit != 0 )); then
    record_first_failure "gh merge failed: pr=#${pr_num}: ${merge_out}"
    die "gh merge failed: pr=#${pr_num}: ${merge_out}"
  elif [[ -n "$merge_out" ]]; then
    log "$merge_out"
  fi

  elapsed=0
  while (( elapsed < timeout_min * 60 )); do
    merged="$(gh_pr_merged_for_number "$pr_num")"
    if [[ "$merged" == 'true' ]]; then
      log "PR #${pr_num} merged."
      return 0
    fi
    sleep "$poll_sec"
    elapsed=$(( elapsed + poll_sec ))
  done

  if (( elapsed < 60 )); then
    elapsed_fmt="${elapsed}s"
  else
    elapsed_fmt="$(( elapsed / 60 ))m $(( elapsed % 60 ))s"
  fi
  wait_timeout_error "merge pr=#${pr_num} via=gh waited=${elapsed_fmt} timeout=${timeout_min}m"
  return 1
}

merge_prs_via_gh() {
  local -r prs_csv="$1"
  local p worst_rc rc

  log "Merging PRs via gh (squash): $(csv_pretty "$prs_csv")"
  worst_rc=0
  IFS=',' read -ra pr_list <<< "$prs_csv"
  for p in "${pr_list[@]}"; do
    [[ -z "$p" ]] && continue
    set +e
    merge_pr_via_gh_single "$p"
    rc=$?
    set -e
    if (( rc != 0 )) && (( worst_rc == 0 || rc > worst_rc )); then
      worst_rc=$rc
    fi
  done
  return "$worst_rc"
}

finalize_prs() {
  local -r prs_csv="$1"
  local poll_rc=0

  [[ -z "$prs_csv" ]] && return 0

  case "$merge_via" in
    gh)
      set +e
      merge_prs_via_gh "$prs_csv"
      poll_rc=$?
      set -e
      return "$poll_rc"
      ;;
    merge-queue)
      maybe_label_top_pr_for_merge
      set +e
      poll_until_merged "$prs_csv"
      poll_rc=$?
      set -e
      return "$poll_rc"
      ;;
    *)
      die "Invalid --merge-via: '${merge_via}' (expected gh or merge-queue)"
      ;;
  esac
}

poll_until_merged() {
  local -r prs_csv="$1"
  local -r timeout_min="${merge_timeout_min}"
  local -r poll_sec=30
  local elapsed=0
  local elapsed_fmt wait_suffix remaining_sec remaining_fmt

  log "Waiting for all PRs to merge (timeout: ${timeout_min} min)…"
  log "PRs: $(csv_pretty "$prs_csv")"

  _merge_it_poll_pr=""
  _merge_it_poll_had_label=""

  local all_merged p merged pending_list check_rollup failed_check failed_branch
  local branches_csv top_branch top_pr top_has_label top_ci_status wait_context
  while true; do
    # If we're waiting for merges, CI may finish after initial submission; ensure
    # the top PR is enqueued for merge as soon as it becomes merge-ready,
    # merge-ready, even if it was pending on the first check.
    maybe_label_top_pr_for_merge

    all_merged=1
    pending_list=""
    IFS=',' read -ra pr_list <<< "$prs_csv"
    for p in "${pr_list[@]}"; do
      [[ -z "$p" ]] && continue
      merged="$(gh_pr_merged_for_number "$p")"
      if [[ "$merged" != 'true' ]]; then
        all_merged=0
        pending_list="${pending_list:+${pending_list}, }#${p}"

        # Check statusCheckRollup: GitHub associates merge-queue CI runs back to
        # the original PR's head commit, so failures from the merge queue appear
        # here even though wait_for_ci only saw the initial push CI.
        check_rollup="$(dep_runner_gh_stdout "gh pr" -- pr view "$p" \
          --repo "${repo_owner}/${repo_name}" \
          --json statusCheckRollup \
          --jq '.statusCheckRollup // []' 2>/dev/null || echo '[]')"
        if ci_rollup_has_pending_or_in_progress "$(ci_rollup_normalize_json "$check_rollup")"; then
          continue
        fi
        check_rollup="$(ci_rollup_latest_by_name_json "$(ci_rollup_normalize_json "$check_rollup")")"
        failed_check="$(dep_runner_jq_with_args "merge queue failed check" "$check_rollup" -r '
              map(select(
                .conclusion == "FAILURE" or .conclusion == "ERROR" or
                .conclusion == "TIMED_OUT" or
                .conclusion == "STARTUP_FAILURE" or .conclusion == "ACTION_REQUIRED"
              )) | if length > 0 then .[0].name else "" end
            ' 2>/dev/null || true)"
        if [[ -n "$failed_check" ]]; then
          failed_branch="$(dep_runner_gh_stdout "gh pr" -- pr view "$p" \
            --repo "${repo_owner}/${repo_name}" \
            --json headRefName --jq '.headRefName // ""' 2>/dev/null || true)"
          cleanup_on_error "PR #${p}: CI check '${failed_check}' failed in the merge queue"
          dep_updater_handle_ci_failure "$p" "$failed_branch"
        fi
      fi
    done

    if [[ "$all_merged" == '1' ]]; then
      log "All PRs merged."
      return 0
    fi

    if (( elapsed >= timeout_min * 60 )); then
      # Single concise timeout line for batch-all postprocessing.
      wait_timeout_error "merge prs='${pending_list}' waited=${elapsed_fmt:-${elapsed}s} timeout=${timeout_min}m"
      return 1
    fi

    # Format elapsed and remaining for progress display.
    if (( elapsed < 60 )); then
      elapsed_fmt="${elapsed}s"
    else
      elapsed_fmt="$(( elapsed / 60 ))m $(( elapsed % 60 ))s"
    fi
    remaining_sec=$(( timeout_min * 60 - elapsed ))
    if (( remaining_sec < 60 )); then
      remaining_fmt="${remaining_sec}s"
    else
      remaining_fmt="$(( remaining_sec / 60 ))m $(( remaining_sec % 60 ))s"
    fi
    wait_suffix="[waited ${elapsed_fmt} / ${timeout_min}m, ~${remaining_fmt} remaining, next check in ${poll_sec}s]"
    wait_context=""
    branches_csv="$(state_get "branches" 2>/dev/null || true)"
    top_branch="$(csv_last "$branches_csv")"
    if [[ -n "$top_branch" ]]; then
      top_pr="$(gh_pr_number_for_branch "$top_branch" 2>/dev/null || true)"
      if [[ -n "$top_pr" ]] && is_valid_pr_number "$top_pr"; then
        top_has_label="$(pr_has_merge_enqueue_pending "$top_pr")"
        top_ci_status="unknown"
        # Match merge gating: PR statusCheckRollup, not gh run list (issue #430).
        top_ci_status="$(ci_conclusion_for_pr "$top_pr" 2>/dev/null || echo 'unknown')"
        wait_context="(top=#${top_pr} enqueue=${top_has_label} ci=${top_ci_status})"
        _merge_it_poll_pr="$top_pr"
        _merge_it_poll_had_label="$top_has_label"
      fi
    fi
    log "Still waiting for merge: ${pending_list} ${wait_context} ${wait_suffix}"

    sleep "$poll_sec"
    elapsed=$(( elapsed + poll_sec ))
  done
}

# ---------------------------------------------------------------------------
# Dry-run output helpers
# ---------------------------------------------------------------------------

# Emit a JSON report to stdout for --report-json mode.
# Args: npm_audit_lines  py_audit_lines  npm_lines  py_lines  gha_lines  rust_lines
# All args may be empty strings.
_emit_report_json() {
  local npm_audit_lines="$1"
  local py_audit_lines="$2"
  local npm_lines="$3"
  local py_lines="$4"
  local gha_lines="${5:-}"
  local rust_lines="${6:-}"

  local cves_json="[]"
  local updates_json="[]"

  # Build CVE array.
  if [[ -n "$npm_audit_lines" ]]; then
    while IFS=' ' read -r pkg current fix cve_ids; do
      [[ -z "$pkg" ]] && continue
      # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
      cves_json="$(dep_runner_jq_with_args "dep-updater report-json npm cve row" "$cves_json" \
        --arg p "$pkg" --arg c "$current" --arg f "$fix" --arg ids "$cve_ids" \
        '. + [{"ecosystem":"npm","package":$p,"current":$c,"fix":$f,"cves":$ids}]')"
    done <<< "$npm_audit_lines"
  fi
  if [[ -n "$py_audit_lines" ]]; then
    while IFS=' ' read -r pkg current fix cve_ids; do
      [[ -z "$pkg" ]] && continue
      # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
      cves_json="$(dep_runner_jq_with_args "dep-updater report-json py cve row" "$cves_json" \
        --arg e "python/${py_tool}" --arg p "$pkg" --arg c "$current" --arg f "$fix" --arg ids "$cve_ids" \
        '. + [{"ecosystem":$e,"package":$p,"current":$c,"fix":$f,"cves":$ids}]')"
    done <<< "$py_audit_lines"
  fi

  # Build updates array.
  if [[ -n "$npm_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
      updates_json="$(dep_runner_jq_with_args "dep-updater report-json npm update row" "$updates_json" \
        --arg p "$pkg" --arg o "$old_ver" --arg n "$new_ver" \
        '. + [{"ecosystem":"npm","package":$p,"from":$o,"to":$n}]')"
    done <<< "$npm_lines"
  fi
  if [[ -n "$py_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
      updates_json="$(dep_runner_jq_with_args "dep-updater report-json py update row" "$updates_json" \
        --arg e "python/${py_tool}" --arg p "$pkg" --arg o "$old_ver" --arg n "$new_ver" \
        '. + [{"ecosystem":$e,"package":$p,"from":$o,"to":$n}]')"
    done <<< "$py_lines"
  fi
  if [[ -n "$gha_lines" ]]; then
    while IFS=' ' read -r action cur_ref new_ref; do
      [[ -z "$action" ]] && continue
      # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
      updates_json="$(dep_runner_jq_with_args "dep-updater report-json gha update row" "$updates_json" \
        --arg p "$action" --arg o "$cur_ref" --arg n "$new_ref" \
        '. + [{"ecosystem":"github-actions","package":$p,"from":$o,"to":$n}]')"
    done <<< "$gha_lines"
  fi
  if [[ -n "$rust_lines" ]]; then
    while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
      [[ -z "$pkg" ]] && continue
      # shellcheck disable=SC2016  # jq row accumulator uses jq variables, not shell expansion
      updates_json="$(dep_runner_jq_with_args "dep-updater report-json rust update row" "$updates_json" \
        --arg p "$pkg" --arg o "$old_ver" --arg n "$new_ver" \
        '. + [{"ecosystem":"rust/cargo","package":$p,"from":$o,"to":$n}]')"
    done <<< "$rust_lines"
  fi

  # shellcheck disable=SC2016  # jq -n emit object uses jq variables, not shell expansion
  dep_runner_jq_n "dep-updater report-json emit" \
    --arg repo "$dir" \
    --argjson cves "$cves_json" \
    --argjson updates "$updates_json" \
    '{
      repo: $repo,
      has_updates: (($updates | length) > 0),
      has_cves: (($cves | length) > 0),
      cves: $cves,
      updates: $updates
    }'
}

# Print a columnar table of ecosystem|package|from|to rows.
# The header row is included in the column pipeline so widths align.
print_update_table() {
  local -a rows=("$@")
  if [[ ${#rows[@]} -eq 0 ]]; then
    return 0
  fi
  {
    printf 'ECOSYSTEM|PACKAGE|FROM|TO\n'
    printf '%s\n' "${rows[@]}"
  } | column -t -s '|'
}

# Print a per-PR plan entry for dry-run mode.
# Args: index scope branch commit files entries cmd
print_dry_run_pr_plan() {
  local -r idx="$1"
  local -r scope="$2"
  local -r branch="$3"
  local -r commit="$4"
  local -r files="$5"
  local -r entries="$6"
  local -r cmd="$7"
  printf '\n── PR #%s: %s\n' "$idx" "$scope"
  printf '   Branch  : %s\n' "$branch"
  printf '   Commit  : %s\n' "$commit"
  printf '   Files   : %s\n' "$files"
  printf '   Command : %s\n' "$cmd"
  if [[ -n "$entries" ]]; then
    printf '   Updates :\n'
    while IFS=' ' read -r u_pkg u_old u_new; do
      [[ -z "$u_pkg" ]] && continue
      printf '     %s  %s → %s\n' "$u_pkg" "$u_old" "$u_new"
    done <<< "$entries"
  fi
}

# ---------------------------------------------------------------------------
# Rebase helper
# ---------------------------------------------------------------------------

rebase_stack_on_main() {
  local branches_csv
  branches_csv="$(state_get "branches")"
  if [[ -z "$branches_csv" ]]; then
    log "No stack branches found; nothing to rebase."
    return 0
  fi

  run_command "git worktree" git -C "$worktree_path" fetch origin main >/dev/null 2>&1 \
    || log "Note: could not fetch latest main."

  run_in_worktree gt sync --force 2>/dev/null \
    || run_in_worktree gt restack \
    || die "Rebase failed. Resolve conflicts manually and re-run."

  dep_stack_submit_current \
    || log "Note: gt submit after restack returned non-zero (may be a no-op)."

  log "Rebase complete."
}

# ---------------------------------------------------------------------------
# Multi-repo --batch --all (one --batch run per discovered git clone)
# ---------------------------------------------------------------------------

# Log each resolved top-level scan directory (configured default, env, or --scan-root).
log_batch_all_top_level_dirs() {
  local root resolved_root
  log "[batch-all] Top-level scan directories:"
  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    resolved_root=""
    resolved_root="$(dep_updater_runner_realpath "$root" 2>/dev/null)" || {
      log "[batch-all]   (skipped — unreadable path: ${root})"
      continue
    }
    log "[batch-all]   ${resolved_root}"
  done < <(tr ':' '\n' <<<"$scan_roots_csv" | sed '/^$/d')
}

discover_batch_all_repos() {
  local root resolved_root child resolved_child repo_name slug priv_status archived_status

  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    resolved_root=""
    resolved_root="$(dep_updater_runner_realpath "$root" 2>/dev/null)" || {
      log "[batch-all] Skipping unreadable scan root: ${root}"
      continue
    }
    [[ -d "$resolved_root" ]] || continue

    while IFS= read -r child; do
      [[ -e "$child/.git" ]] || continue
      resolved_child=""
      resolved_child="$(dep_updater_runner_realpath "$child" 2>/dev/null)" || continue
      repo_name="${resolved_child##*/}"

      slug=""
      slug="$(gh_slug_from_repo_dir "$resolved_child" 2>/dev/null)" || slug=""
      if [[ -n "$slug" ]]; then
        archived_status=0
        gh_repo_is_archived "$slug" || archived_status=$?
        case "$archived_status" in
          0)
            log "[batch-all] Skipping archived repository: ${repo_name} (${slug})"
            continue
            ;;
          2)
            log "[batch-all] WARNING: could not determine archived status for ${slug}; skipping"
            continue
            ;;
        esac
      fi
      if [[ -n "$slug" ]] && [[ "$include_private" -eq 0 ]]; then
        priv_status=0
        gh_repo_is_private "$slug" || priv_status=$?
        case "$priv_status" in
          0)
            log "[batch-all] Skipping private repository: ${repo_name} (${slug})"
            continue
            ;;
          2)
            log "[batch-all] WARNING: could not determine visibility for ${slug}; skipping"
            continue
            ;;
        esac
      fi

      printf '%s\n' "$resolved_child"
    done < <(find "$resolved_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
  done < <(tr ':' '\n' <<<"$scan_roots_csv" | sed '/^$/d')
}

_batch_all_interrupted=0
_batch_all_active_child_pid=""
_batch_all_active_child_fifo=""
_batch_all_active_child_log=""

# shellcheck disable=SC2317,SC2329  # invoked via INT/TERM traps during batch --all
batch_all_cleanup_on_interrupt() {
  _batch_all_interrupted=1

  # Best-effort cleanup: kill active child and remove temp files.
  if [[ -n "${_batch_all_active_child_pid:-}" ]]; then
    kill -TERM "$_batch_all_active_child_pid" 2>/dev/null || true

    # Give the child a moment to clean up (worktrees, tempfiles, etc.) before SIGKILL.
    local tries
    tries=0
    while kill -0 "$_batch_all_active_child_pid" 2>/dev/null; do
      tries=$((tries + 1))
      [[ "$tries" -ge 5 ]] && break
      sleep 0.2
    done

    if kill -0 "$_batch_all_active_child_pid" 2>/dev/null; then
      kill -KILL "$_batch_all_active_child_pid" 2>/dev/null || true
    fi
  fi

  if [[ -n "${_batch_all_active_child_fifo:-}" ]]; then
    rm -f "$_batch_all_active_child_fifo" 2>/dev/null || true
  fi
  if [[ -n "${_batch_all_active_child_log:-}" ]]; then
    rm -f "$_batch_all_active_child_log" 2>/dev/null || true
  fi

  log "[batch-all] Interrupted."
}

# When the child JSON report is missing or generic, pull one actionable line from its log.
batch_all_scrape_actionable_from_log() {
  local -r log_file="$1"
  local line stripped

  line="$(grep -E 'ERROR: WAIT_TIMEOUT ' "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    stripped="${line#*ERROR: }"
    printf '%s' "$stripped"
    return 0
  fi

  line="$(grep -E '  - (npm|python|github-actions)\|' "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    stripped="${line##*  - }"
    printf '%s' "$stripped"
    return 0
  fi

  line="$(grep -E 'not CI-green|CI not ready|CI wait was skipped|refusing gh merge without' \
    "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    stripped="${line#*ERROR: }"
    stripped="${stripped#*  }"
    printf '%s' "$stripped"
    return 0
  fi

  line="$(grep -E 'Could not resolve open PR for branch ' \
    "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    stripped="${line#*ERROR: }"
    printf '%s' "$stripped"
    return 0
  fi

  line="$(grep -E 'ERR_PNPM_NO_MATCHING_VERSION|No matching version found for ' \
    "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    stripped="${line#*  }"
    stripped="${stripped#*  }"
    printf '%s' "$stripped"
    return 0
  fi

  line="$(grep -E '^\[FAIL\] ' "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    stripped="${line#\[FAIL\] }"
    printf '%s' "$stripped"
    return 0
  fi

  line="$(grep -E '^  --- stderr ---$' "$log_file" 2>/dev/null | tail -n 1 || true)"
  if [[ -n "$line" ]]; then
    line="$(awk '
        /^  --- stderr ---$/ { show=1; buf=""; next }
        show && /^  --- end stderr ---$/ { last=buf; show=0; next }
        show { buf = buf $0 "\n" }
        END { if (show) last=buf; printf "%s", last }
      ' "$log_file" 2>/dev/null \
      | awk '/[^[:space:]]/ { print; exit }' \
      | sed 's/^  //' || true)"
    if [[ -n "$line" ]]; then
      printf '%s' "$line"
      return 0
    fi
  fi

  return 1
}

batch_all_dispatch() {
  local dep_self repo child_exit worst_exit
  local -a child_args repos_found
  local -a failure_summaries=()
  local -a failure_details=()

  # Palette of ANSI colors cycled across repos so each project's header is visually distinct.
  # Only active when stderr is a TTY (same condition as init_prompt_style).
  local -a _repo_colors=()
  local _color_reset=""
  if [[ -t 2 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" && -n "${TERM:-}" ]]; then
    # Bold variants of: magenta, yellow, blue, green, red, cyan, white
    _repo_colors=(
      '\033[1;35m'
      '\033[1;33m'
      '\033[1;34m'
      '\033[1;32m'
      '\033[1;31m'
      '\033[1;36m'
      '\033[1;37m'
    )
    _color_reset='\033[0m'
  fi
  local _repo_color_idx=0
  _batch_all_interrupted=0
  _batch_all_active_child_pid=""
  _batch_all_active_child_fifo=""
  _batch_all_active_child_log=""
  trap batch_all_cleanup_on_interrupt INT TERM

  dep_self=""
  dep_self="$(dep_updater_runner_realpath "${BASH_SOURCE[0]}" 2>/dev/null)" \
    || die "Could not resolve dep-updater script path."

  log_batch_all_top_level_dirs

  readarray -t repos_found < <(discover_batch_all_repos | sort -u)

  if [[ ${#repos_found[@]} -eq 0 ]]; then
    log "[batch-all] No git repositories found under scan roots."
    return 0
  fi

  if [[ -n "${DEP_UPDATER_UPDATES_REPORT:-}" ]]; then
    printf '[]\n' >"${DEP_UPDATER_UPDATES_REPORT}"
  fi

  worst_exit=0

  for repo in "${repos_found[@]}"; do
    [[ -z "$repo" ]] && continue
    [[ "$_batch_all_interrupted" == '1' ]] && break

    local repo_started_ms
    local _this_color=""
    if [[ "${#_repo_colors[@]}" -gt 0 ]]; then
      _this_color="${_repo_colors[$(( _repo_color_idx % ${#_repo_colors[@]} ))]}"
      _repo_color_idx=$(( _repo_color_idx + 1 ))
    fi
    # Color just the repo-boundary header and outcome lines; child output keeps its own color.
    TIME_LOG_COLOR_START="$_this_color" TIME_LOG_COLOR_RESET="$_color_reset" \
      log "[batch-all] --- $(basename "$repo") (${repo}) ---"
    if [[ -n "${EPOCHREALTIME:-}" ]]; then
      repo_started_ms="$(( ${EPOCHREALTIME/./} / 1000 ))"
    else
      repo_started_ms="$(date +%s000)"
    fi

    child_args=()
    [[ "$dry_run" == '1' ]] && child_args+=(--dry-run)
    child_args+=(--batch)
    [[ "$quiet" == '1' ]] && child_args+=(--quiet)
    [[ "$semver_only" == '1' ]] && child_args+=(--semver-only)
    [[ "$no_wait_ci" == '1' ]] && child_args+=(--no-wait-ci)
    [[ "$no_wait_merge" == '1' ]] && child_args+=(--no-wait-merge)
    [[ "$security_only" == '1' ]] && child_args+=(--security-only)
    [[ -n "$wt_tmpdir" ]] && child_args+=(--tmpdir "$wt_tmpdir")
    child_args+=(--merge-timeout "$merge_timeout_min")
    child_args+=(--merge-via "$merge_via")
    [[ "$ecosystem" != 'auto' ]] && child_args+=(--ecosystem "$ecosystem")
    child_args+=(--dir "$repo")

    child_exit=0
    local child_log child_fifo child_pid child_report child_updates
    local root_cause child_clean report_line detail_count
    local ci_type ci_pr ci_check_name ci_check_conclusion ci_pr_url ci_check_url ci_summary
    child_log="$(mktemp)"
    child_report="$(mktemp)"
    child_updates="$(mktemp)"
    child_fifo="$(mktemp -u)"
    mkfifo "$child_fifo"
    _batch_all_active_child_log="$child_log"
    _batch_all_active_child_fifo="$child_fifo"

    # Stream ALL child output live, while also capturing it for concise failure summaries.
    # Use a fifo so we also have a child PID to kill on Ctrl-C.
    # DEP_UPDATER_RUN_REPORT: child writes structured JSON on non-zero exit for
    # batch-all to read (see dep_updater_write_batch_child_report_json).
    set +e
    DEP_UPDATER_RUN_REPORT="$child_report" \
      DEP_UPDATER_UPDATES_REPORT="$child_updates" \
      "$dep_self" "${child_args[@]}" >"$child_fifo" 2>&1 &
    child_pid=$!
    _batch_all_active_child_pid="$child_pid"

    local line
    while IFS= read -r line; do
      printf '%s\n' "$line"
      printf '%s\n' "$line" >>"$child_log"
    done <"$child_fifo"

    wait "$child_pid" || child_exit=$?
    rm -f "$child_fifo"
    _batch_all_active_child_pid=""
    _batch_all_active_child_fifo=""
    set -e

    if [[ "$_batch_all_interrupted" == '1' ]]; then
      rm -f "$child_log" "$child_report" "$child_updates"
      _batch_all_active_child_log=""
      break
    fi

    dep_updater_batch_all_append_child_updates "$child_updates"

    if [[ "$child_exit" -ne 0 ]]; then
      TIME_LOG_COLOR_START="$_this_color" TIME_LOG_COLOR_RESET="$_color_reset" \
        log "[batch-all] FAILED (${repo}) exit ${child_exit}"
      root_cause=""
      detail_count=0
      if [[ -s "$child_report" ]] \
        && dep_runner_jq_file_args "dep-updater batch-all child report validate" "$child_report" -e \
          'has("primary") and has("details") and has("exit_code")' >/dev/null 2>&1; then
        root_cause="$(dep_updater_actionable_primary_from_report "$child_report" "$child_exit")"
        while IFS= read -r report_line; do
          [[ -z "$report_line" ]] && continue
          failure_details+=("$(basename "$repo"): ${report_line}")
          detail_count=$((detail_count + 1))
        done < <(dep_runner_jq_file_args "dep-updater batch-all child report details" "$child_report" -r '.details[]? // empty' 2>/dev/null || true)
        while IFS= read -r report_line; do
          [[ -z "$report_line" ]] && continue
          failure_details+=("$(basename "$repo"): ${report_line}")
          detail_count=$((detail_count + 1))
          log "[batch-all] Command failure ($(basename "$repo")): ${report_line}"
        done < <(dep_runner_jq_file_args "dep-updater batch-all child command failures" "$child_report" -r \
          '.command_failures[]? | select(. != null)
            | if (.stderr_hint // "") != "" then "\(.label) (exit \(.exit_code)) — \(.stderr_hint)"
              else "\(.label) (exit \(.exit_code))" end' 2>/dev/null || true)
      fi
      # Keep batch-all output actionable: strip ANSI noise; use log tail only if
      # no structured report (e.g. older child or crash before write).
      child_clean="$(mktemp)"
      sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' "$child_log" >"$child_clean" 2>/dev/null || cp "$child_log" "$child_clean"

      if [[ -z "$root_cause" ]] \
        || dep_updater_primary_is_generic "$root_cause" "$child_exit"; then
        scraped=""
        scraped="$(batch_all_scrape_actionable_from_log "$child_clean" 2>/dev/null || true)"
        if [[ -n "$scraped" ]]; then
          root_cause="$scraped"
          if [[ "$detail_count" -eq 0 ]]; then
            failure_details+=("$(basename "$repo"): ${scraped}")
            detail_count=1
          fi
        fi
      fi

      if [[ -z "$root_cause" ]]; then
        root_cause="$(tail -n 1 "$child_clean" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true)"
      fi

      ci_type=""
      ci_pr=""
      ci_check_name=""
      ci_check_conclusion=""
      ci_pr_url=""
      ci_check_url=""
      if [[ -s "$child_report" ]] \
        && dep_runner_jq_file_args "dep-updater batch-all child ci failure" "$child_report" -e \
          'has("ci_failure") and .ci_failure != null' >/dev/null 2>&1; then
        ci_type="$(dep_runner_jq_file_args "dep-updater batch-all child ci type" "$child_report" \
          -r '.ci_failure | type' 2>/dev/null || true)"
        if [[ "$ci_type" == "object" ]]; then
          ci_pr="$(dep_runner_jq_file_args "dep-updater batch-all child ci pr" "$child_report" \
            -r '.ci_failure.pr // empty' 2>/dev/null || true)"
          ci_check_name="$(dep_runner_jq_file_args "dep-updater batch-all child ci check" "$child_report" \
            -r '.ci_failure.check_name // empty' 2>/dev/null || true)"
          ci_check_conclusion="$(dep_runner_jq_file_args "dep-updater batch-all child ci conclusion" "$child_report" \
            -r '.ci_failure.check_conclusion // empty' 2>/dev/null || true)"
          ci_pr_url="$(dep_runner_jq_file_args "dep-updater batch-all child ci pr url" "$child_report" \
            -r '.ci_failure.pr_url // empty' 2>/dev/null || true)"
          ci_check_url="$(dep_runner_jq_file_args "dep-updater batch-all child ci check url" "$child_report" \
            -r '.ci_failure.check_url // empty' 2>/dev/null || true)"
          if [[ -n "$ci_pr" ]]; then
            if [[ -n "$ci_check_name" ]]; then
              failure_details+=("$(basename "$repo"): CI failed on PR #${ci_pr} — ${ci_check_name} (${ci_check_conclusion})")
            else
              failure_details+=("$(basename "$repo"): CI failed on PR #${ci_pr}")
            fi
            if [[ -n "$ci_pr_url" ]]; then
              failure_details+=("$(basename "$repo"): PR: ${ci_pr_url}")
            fi
            if [[ -n "$ci_check_url" ]]; then
              failure_details+=("$(basename "$repo"): Check run: ${ci_check_url}")
            fi
            detail_count=$((detail_count + 1))
            if [[ -n "$root_cause" && "$root_cause" != *pr_url=* && -n "$ci_pr_url" ]]; then
              root_cause="${root_cause} pr_url=${ci_pr_url}"
            fi
          fi
        elif [[ "$ci_type" == "string" ]]; then
          ci_summary="$(dep_runner_jq_file_args "dep-updater batch-all child ci summary" "$child_report" \
            -r '.ci_failure // empty' 2>/dev/null || true)"
          if [[ -n "$ci_summary" && "$ci_summary" != "null" ]]; then
            failure_details+=("$(basename "$repo"): ${ci_summary}")
            detail_count=$((detail_count + 1))
          fi
        fi
      fi

      if [[ -n "$root_cause" ]]; then
        if [[ "$detail_count" -eq 0 ]]; then
          failure_details+=("$(basename "$repo"): ${root_cause}")
        fi
        log "[batch-all] Root cause: ${root_cause}"
      fi

      if [[ -n "$ci_pr" ]]; then
        if [[ -n "$ci_check_name" ]]; then
          log "[batch-all] CI failure ($(basename "$repo")): pr=#${ci_pr} ${ci_check_name} (${ci_check_conclusion})"
        else
          log "[batch-all] CI failure ($(basename "$repo")): pr=#${ci_pr} CI checks failed"
        fi
        if [[ -n "$ci_pr_url" ]]; then
          log "[batch-all] CI failure-link ($(basename "$repo")) pr: ${ci_pr_url}"
        fi
        if [[ -n "$ci_check_url" ]]; then
          log "[batch-all] CI failure-link ($(basename "$repo")) check: ${ci_check_url}"
        fi
      elif [[ -n "$ci_type" && "$ci_type" == "string" ]]; then
        ci_summary="$(dep_runner_jq_file_args "dep-updater batch-all child ci summary repeat" "$child_report" \
          -r '.ci_failure // empty' 2>/dev/null || true)"
        if [[ -n "$ci_summary" && "$ci_summary" != "null" ]]; then
          log "[batch-all] CI failure ($(basename "$repo")): ${ci_summary}"
        fi
      fi

      # If pnpm ignored builds were encountered, surface the specific skipped packages.
      if pnpm_output_has_ignored_builds "$child_clean"; then
        log "[batch-all] pnpm blocked dependency build scripts (ERR_PNPM_IGNORED_BUILDS)."
        log "[batch-all] Skipped package(s):"
        { rg -n '^.*\\[pnpm\\]   ' "$child_clean" || true; } | tail -n 20 | sed -E 's/^[0-9]+://' | sed 's/^/[batch-all]   /' >&2
        log "[batch-all] Fix: run pnpm approve-builds (or pnpm approve-builds --all) in that repo."
      fi

      rm -f "$child_clean" "$child_report"
      if [[ -n "$root_cause" ]]; then
        failure_summaries+=("$(basename "$repo"): exit ${child_exit} — ${root_cause}")
      else
        failure_summaries+=("$(basename "$repo"): exit ${child_exit}")
      fi
      if [[ "$worst_exit" -eq 0 ]] || [[ "$child_exit" -gt "$worst_exit" ]]; then
        worst_exit="$child_exit"
      fi
    else
      local repo_finished_ms repo_elapsed_s
      if [[ -n "${EPOCHREALTIME:-}" ]]; then
        repo_finished_ms="$(( ${EPOCHREALTIME/./} / 1000 ))"
      else
        repo_finished_ms="$(date +%s000)"
      fi
      repo_elapsed_s="$(( (repo_finished_ms - repo_started_ms) / 1000 ))"
      TIME_LOG_COLOR_START="$_this_color" TIME_LOG_COLOR_RESET="$_color_reset" \
        log "[batch-all] OK ($(basename "$repo")) (${repo_elapsed_s}s)"
    fi
    rm -f "$child_log" "$child_report" "$child_updates"
    _batch_all_active_child_log=""
  done

  if [[ "$_batch_all_interrupted" == '1' ]]; then
    trap - INT TERM
    return 130
  fi

  if [[ "$worst_exit" -ne 0 ]]; then
    log "[batch-all] Finished with failures (exit ${worst_exit})."
    if [[ ${#failure_summaries[@]} -gt 0 ]]; then
      log "[batch-all] Failure summary:"
      local fs
      for fs in "${failure_summaries[@]}"; do
        log "[batch-all]   ${fs}"
      done
    fi
    if [[ ${#failure_details[@]} -gt 0 ]]; then
      log "[batch-all] Failure details:"
      local fd
      for fd in "${failure_details[@]}"; do
        log "[batch-all]   ${fd}"
      done
    fi
  else
    log "[batch-all] All repos completed successfully."
  fi

  return "$worst_exit"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
  dep_updater_early_init
  dep_updater_bootstrap_path
  parse_args "$@"
  init_prompt_style

  if [[ "$batch_all" == '1' ]]; then
    check_core_prereqs
    check_gnu_sed_prereqs
    batch_all_dispatch
    exit $?
  fi

  if [[ "$report_json" == '1' ]]; then
    check_report_prereqs
    detect_ecosystem
    check_ecosystem_prereqs "$has_npm" "$py_tool" "$has_rust"
    # --report-json must be isolated from any local uncommitted state. Run the
    # scan via the dry-run worktree flow (clean tree based on origin/main / HEAD),
    # which already suppresses the human-readable plan output when report_json=1.
  fi

  if [[ "$report_json" == '0' ]]; then
    check_core_prereqs
  fi
  if [[ "$dry_run" == '0' ]]; then
    init_repo_api_context
  fi
  if [[ "$report_json" == '0' ]]; then
    detect_ecosystem
    check_ecosystem_prereqs "$has_npm" "$py_tool" "$has_rust"
    if [[ "$dry_run" == '0' ]]; then
      check_gnu_sed_prereqs
    fi
  fi
  if [[ "$dry_run" == '0' ]]; then
    check_auth_prereqs
    detect_ci_workflows
  fi

  # ── --cleanup mode ──────────────────────────────────────────────────────
  if [[ "$cleanup_mode" == '1' ]]; then
    init_state_file
    if [[ ! -f "$state_file" ]]; then
      log "No state file found at: ${state_file}"
      log "Nothing to clean up."
      exit 0
    fi
    sanitize_state_prs
    local wt
    wt="$(state_get "worktree")"
    worktree_path="$wt"
    wt_base_branch="$(state_get "wt_branch")"
    log "Running cleanup for worktree: ${worktree_path}"
    cleanup
    exit 0
  fi

  # ── --rebase mode ───────────────────────────────────────────────────────
  if [[ "$rebase_mode" == '1' ]]; then
    init_state_file
    if [[ ! -f "$state_file" ]]; then
      die "No state file found at: ${state_file}. Nothing to rebase."
    fi
    sanitize_state_prs
    local wt
    wt="$(state_get "worktree")"
    if [[ -z "$wt" || ! -d "$wt" ]]; then
      die "Worktree not found: ${wt}. Run without --rebase to create a new stack."
    fi
    worktree_path="$wt"
    readonly worktree_path
    wt_base_branch="$(state_get "wt_branch")"
    log "Rebasing stack in worktree: ${worktree_path}"
    dep_rebase_stack_on_main
    exit 0
  fi

  warn_if_dirty_workdir
  if [[ "$report_json" != '1' ]]; then
    primary_repo_warn_if_not_main
    primary_repo_preserve
  fi

# ---------------------------------------------------------------------------
# Dry-run mode: temporary worktree → scan → plan → destroy
# ---------------------------------------------------------------------------
# Helper: destroy the dry-run worktree and its tracking branch cleanly.
_dry_run_teardown() {
  local -r wt="$1"
  _cleanup_trap_active=0
  primary_repo_recover || true
  log "[worktree] Removing: $wt"
  cd - >/dev/null 2>&1 || true
  run_command "git repo" git -C "$dir" worktree remove --force "$wt" >/dev/null 2>&1 || true
  run_command "git repo" git -C "$dir" branch -D "$wt_base_branch" >/dev/null 2>&1 || true
  log "[worktree] Removed: $wt"
}

if [[ "$dry_run" == '1' ]]; then
  # Always create (and destroy) the worktree so lifecycle is exercised even
  # when no ecosystem is present — this is the main testable invariant.
  create_worktree
  dep_updater_ensure_eco_fail_file
  _cleanup_trap_active=1
  local audit_dir="$worktree_path"
  cd "$audit_dir" || die "Failed to cd to dry-run worktree: $audit_dir"

  # ── No ecosystem detected ────────────────────────────────────────────
  if [[ "$has_npm" == '0' && -z "$py_tool" && "$has_rust" == '0' && "$has_gha" == '0' ]]; then
    log "No supported ecosystem detected — nothing to update."
    if [[ "$report_json" == '1' ]]; then
      _emit_report_json "" "" "" "" "" ""
    fi
    _dry_run_teardown "$audit_dir"
    exit 0
  fi

  # ── Security audit ───────────────────────────────────────────────────
  local npm_audit_lines="" py_audit_lines=""
  if [[ "$has_npm" == '1' ]]; then
    npm_audit_lines="$(npm_audit "$(npm_project_root "$audit_dir")")"
  fi
  if [[ -n "$py_tool" ]]; then
    py_audit_lines="$(py_audit "$py_tool" "$audit_dir")"
    py_cve_fix_audit_lines="$py_audit_lines"
  fi
  npm_cve_fix_audit_lines="$npm_audit_lines"

  if [[ "$report_json" == '0' ]]; then
    if [[ -n "$npm_audit_lines" ]]; then
      printf '\n[npm] CVEs with available fixes:\n'
      {
        printf 'PACKAGE|CURRENT|FIX|CVEs\n'
        while IFS=' ' read -r cve_pkg cve_cur cve_fix cve_ids; do
          [[ -z "$cve_pkg" ]] && continue
          printf '%s|%s|%s|%s\n' "$cve_pkg" "$cve_cur" "$cve_fix" "$cve_ids"
        done <<< "$npm_audit_lines"
      } | column -t -s '|'
    fi
    if [[ -n "$py_audit_lines" ]]; then
      printf '\n[python/%s] CVEs with available fixes:\n' "$py_tool"
      {
        printf 'PACKAGE|CURRENT|FIX|CVEs\n'
        while IFS=' ' read -r cve_pkg cve_cur cve_fix cve_ids; do
          [[ -z "$cve_pkg" ]] && continue
          printf '%s|%s|%s|%s\n' "$cve_pkg" "$cve_cur" "$cve_fix" "$cve_ids"
        done <<< "$py_audit_lines"
      } | column -t -s '|'
    fi
    if [[ -z "$npm_audit_lines" && -z "$py_audit_lines" ]]; then
      log "No CVEs with direct fixes found."
    fi
  fi

  if [[ "$security_only" == '1' ]]; then
    if [[ "$report_json" == '1' ]]; then
      _emit_report_json "$npm_audit_lines" "$py_audit_lines" "" "" "" ""
    fi
    _dry_run_teardown "$audit_dir"
    exit 0
  fi

  # ── Outdated packages ────────────────────────────────────────────────
  local npm_lines="" py_lines="" rust_lines="" gha_lines=""
  if [[ "$has_npm" == '1' ]]; then
    npm_lines="$(npm_outdated "$(npm_project_root "$audit_dir")")"
  fi
  if [[ -n "$py_tool" ]]; then
    py_lines="$(py_outdated "$py_tool" "$audit_dir")"
  fi
  if [[ "$has_rust" == '1' ]]; then
    rust_lines="$(rust_outdated "$audit_dir")"
  fi
  if [[ "$has_gha" == '1' ]]; then
    gha_lines="$(gha_outdated "$audit_dir")"
  fi

  # Normalize empty/null/'{}'
  [[ "$npm_lines" == '{}' || "$npm_lines" == 'null' ]] && npm_lines=""
  [[ "$py_lines"  == '{}' || "$py_lines"  == 'null' ]] && py_lines=""

  if [[ -z "$npm_lines" && -z "$py_lines" && -z "$rust_lines" && -z "$gha_lines" ]]; then
    log "All dependencies are up to date."
    if [[ "$report_json" == '1' ]]; then
      _emit_report_json "$npm_audit_lines" "$py_audit_lines" "" "" "" ""
    fi
    _dry_run_teardown "$audit_dir"
    exit 0
  fi

  # ── Summary table + per-PR plan (human-readable; skipped in --report-json) ──
  if [[ "$report_json" == '0' ]]; then
  printf '\n'
  local -a all_rows=()
  if [[ -n "$npm_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      all_rows+=("npm|$pkg|$old_ver|$new_ver")
    done <<< "$npm_lines"
  fi
  if [[ -n "$py_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      [[ -z "$pkg" ]] && continue
      all_rows+=("python/${py_tool}|$pkg|$old_ver|$new_ver")
    done <<< "$py_lines"
  fi
  if [[ -n "$rust_lines" ]]; then
    while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
      [[ -z "$pkg" ]] && continue
      all_rows+=("rust/cargo|$pkg|$old_ver|$new_ver")
    done <<< "$rust_lines"
  fi
  if [[ -n "$gha_lines" ]]; then
    while IFS=' ' read -r action cur_ref new_ref; do
      [[ -z "$action" ]] && continue
      all_rows+=("github-actions|$action|$cur_ref|$new_ref")
    done <<< "$gha_lines"
  fi
  print_update_table "${all_rows[@]}"

  # ── Per-PR plan ───────────────────────────────────────────────────────
  printf '\n'
  if [[ "$batch" == '1' ]]; then
    printf '── Batch PR plan ──────────────────────────────────────────────\n'
    printf '   Branch  : dep-updates/batch\n'
    printf '   Commit  : chore(deps): batch dependency updates\n'
    printf '   (All updates above combined into a single PR)\n'
  else
    local pr_index=0

    if [[ -n "$npm_lines" ]]; then
      local group_keys
      group_keys="$(list_npm_group_keys "$npm_lines")"
      while IFS= read -r group_key; do
        [[ -z "$group_key" ]] && continue
        local entries
        entries="$(npm_entries_for_group "$group_key" "$npm_lines")"
        [[ -z "$entries" ]] && continue

        local safe_group scope_label commit_msg lockfile cmd_prefix
        safe_group="$(sanitize_branch_name "${group_key#@}")"
        local branch="dep-updates/npm-${safe_group}"

        local pkg_count=0 first_pkg="" first_old="" first_new=""
        while IFS=' ' read -r pkg old_ver new_ver; do
          [[ -z "$pkg" ]] && continue
          pkg_count=$(( pkg_count + 1 ))
          if [[ "$pkg_count" -eq 1 ]]; then
            first_pkg="$pkg"; first_old="$old_ver"; first_new="$new_ver"
          fi
        done <<< "$entries"

        if [[ "$pkg_count" -eq 1 ]]; then
          commit_msg="chore(deps): bump ${first_pkg} from ${first_old} to ${first_new}"
          scope_label="npm/${first_pkg}"
        else
          commit_msg="chore(deps): bump ${group_key} from ${first_old} to ${first_new}"
          scope_label="npm/${group_key} (${pkg_count} packages)"
        fi

        case "$npm_tool" in
          pnpm) lockfile="pnpm-lock.yaml" ;;
          yarn) lockfile="yarn.lock" ;;
          *)    lockfile="package-lock.json" ;;
        esac

        case "$npm_tool" in
          pnpm)
            if [[ "$semver_only" == '1' ]]; then
              cmd_prefix="pnpm (in worktree) update"
            else
              cmd_prefix="pnpm (in worktree) update --latest"
            fi
            ;;
          yarn) cmd_prefix="[yarn] --cwd <worktree> upgrade --latest" ;;
          *)
            if [[ "$semver_only" == '1' ]]; then
              cmd_prefix="[npm] update --prefix <worktree>"
            else
              cmd_prefix="[npm] install --prefix <worktree> __PKG__@latest"
            fi
            ;;
        esac

        pr_index=$(( pr_index + 1 ))
        print_dry_run_pr_plan \
          "$pr_index" \
          "$scope_label" \
          "$branch" \
          "$commit_msg" \
          "package.json + ${lockfile}" \
          "$entries" \
          "$cmd_prefix"
      done <<< "$group_keys"
    fi

    if [[ -n "$py_lines" ]]; then
      while IFS=' ' read -r pkg old_ver new_ver; do
        [[ -z "$pkg" ]] && continue
        local safe_name py_branch py_commit py_files py_cmd
        safe_name="$(sanitize_branch_name "$pkg")"
        py_branch="dep-updates/py-${safe_name}"
        py_commit="chore(deps): bump ${pkg} from ${old_ver} to ${new_ver}"
        case "$py_tool" in
          uv)     py_files="pyproject.toml + uv.lock" ;   py_cmd="[uv] --directory <worktree> add ${pkg}==${new_ver}" ;;
          poetry) py_files="pyproject.toml + poetry.lock"; py_cmd="poetry add ${pkg}@${new_ver}" ;;
          pipenv) py_files="Pipfile + Pipfile.lock" ;      py_cmd="pipenv install ${pkg}==${new_ver}" ;;
          *)      py_files="requirements.txt" ;            py_cmd="${py_tool} install ${pkg}==${new_ver}" ;;
        esac
        pr_index=$(( pr_index + 1 ))
        print_dry_run_pr_plan \
          "$pr_index" \
          "python/${py_tool}/${pkg}" \
          "$py_branch" \
          "$py_commit" \
          "$py_files" \
          "${pkg} ${old_ver} ${new_ver}" \
          "$py_cmd"
      done <<< "$py_lines"
    fi

    if [[ -n "$rust_lines" ]]; then
      while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
        [[ -z "$pkg" ]] && continue
        local safe_rust rust_branch rust_commit rust_cmd
        safe_rust="$(sanitize_branch_name "$pkg")"
        rust_branch="dep-updates/rust-${safe_rust}"
        rust_commit="chore(deps): bump ${pkg} from ${old_ver} to ${new_ver}"
        rust_cmd='cargo add'
        if [[ -n "${dep_platform:-}" && "${dep_platform}" != "-" ]]; then
          rust_cmd+=" --target $(printf '%q' "$dep_platform")"
        fi
        rust_cmd+=" $(printf '%q' "${pkg}@${new_ver}")"
        pr_index=$(( pr_index + 1 ))
        print_dry_run_pr_plan \
          "$pr_index" \
          "rust/cargo/${pkg}" \
          "$rust_branch" \
          "$rust_commit" \
          "Cargo.toml + Cargo.lock" \
          "${pkg} ${old_ver} ${new_ver}" \
          "$rust_cmd"
      done <<< "$rust_lines"
    fi

    if [[ -n "$gha_lines" ]]; then
      while IFS=' ' read -r action cur_ref new_ref; do
        [[ -z "$action" ]] && continue
        local safe_gha gha_branch gha_commit
        safe_gha="$(sanitize_branch_name "$action")"
        gha_branch="dep-updates/gha-${safe_gha}"
        gha_commit="chore(deps): bump ${action} from ${cur_ref} to ${new_ref}"
        pr_index=$(( pr_index + 1 ))
        print_dry_run_pr_plan \
          "$pr_index" \
          "github-actions/${action}" \
          "$gha_branch" \
          "$gha_commit" \
          ".github/workflows/" \
          "${action} ${cur_ref} ${new_ref}" \
          "gnu_sed_inplace -e 's|uses: ${action}@${cur_ref}|uses: ${action}@${new_ref}|g' .github/workflows/*.yml"
      done <<< "$gha_lines"
    fi
  fi
  fi  # end: report_json == 0

  if [[ "$report_json" == '1' ]]; then
    _emit_report_json "$npm_audit_lines" "$py_audit_lines" "$npm_lines" "$py_lines" "$gha_lines" "$rust_lines"
  fi

  _dry_run_teardown "$audit_dir"
  exit 0
fi

# ---------------------------------------------------------------------------
# Update mode
# ---------------------------------------------------------------------------
init_state_file
sanitize_state_prs
# Read any open-PR state from a prior interrupted run BEFORE prepare_worktree
# can overwrite the state file.  cleanup_on_error intentionally preserves the
# state file so these values survive a SIGINT.
local existing_branches existing_prs
existing_branches="$(state_get "branches")"
existing_prs="$(state_get "prs")"

prepare_worktree

dep_updater_ensure_eco_fail_file
# A fresh throwaway worktree has no recoverable stack state. Arm cleanup before
# Graphite tracking so a timeout cannot leak the worktree and poison the next run.
if [[ -z "$existing_branches" && -z "$existing_prs" ]]; then
  _cleanup_trap_active=1
fi
dep_stack_ensure_tracked

# Worktree is live — any unexpected exit from here should trigger cleanup.
_cleanup_trap_active=1

run_command "git worktree" git -C "$worktree_path" fetch origin --prune 2>/dev/null || true
log "Working in: $worktree_path"

# Scan only from a tree aligned with origin/main (never the primary clone).
sync_worktree_to_origin_main_for_scan "$existing_branches"

# Audit before outdated so CVE-marked packages bypass the minimum release age gate.
local npm_audit_lines="" py_audit_lines=""
if [[ "$has_npm" == '1' ]]; then
  log "Running npm security audit…"
  npm_audit_lines="$(npm_audit "$(npm_project_root "$worktree_path")")"
  npm_cve_fix_audit_lines="$npm_audit_lines"
  if [[ -n "$npm_audit_lines" ]]; then
    local vuln_count
    vuln_count="$(printf '%s\n' "$npm_audit_lines" | grep -c .)"
    log "Found ${vuln_count} npm package(s) with CVEs that have fixes available."
  else
    log "No npm CVEs with direct fixes found."
  fi
fi
if [[ -n "$py_tool" ]]; then
  log "Running Python security audit…"
  py_audit_lines="$(py_audit "$py_tool" "$worktree_path")"
  py_cve_fix_audit_lines="$py_audit_lines"
  if [[ -n "$py_audit_lines" ]]; then
    local py_vuln_count
    py_vuln_count="$(printf '%s\n' "$py_audit_lines" | grep -c .)"
    log "Found ${py_vuln_count} Python package(s) with CVEs that have fixes available."
  else
    log "No Python CVEs with direct fixes found."
  fi
fi

local npm_lines="" py_lines="" rust_lines="" gha_lines=""
if [[ "$has_npm" == '1' ]]; then
  npm_lines="$(npm_outdated "$(npm_project_root "$worktree_path")")"
fi
if [[ -n "$py_tool" ]]; then
  py_lines="$(py_outdated "$py_tool" "$worktree_path")"
fi
if [[ "$has_rust" == '1' ]]; then
  rust_lines="$(rust_outdated "$worktree_path")"
fi
if [[ "$has_gha" == '1' ]]; then
  gha_lines="$(gha_outdated "$worktree_path")"
fi

if [[ -z "$npm_lines" && -z "$py_lines" && -z "$rust_lines" && -z "$gha_lines" ]]; then
  log "All dependencies are up to date."
  require_resume_ci_gate "$existing_branches" "$existing_prs"
  gate_all_created_prs

  if [[ "$no_wait_merge" == '1' ]]; then
    log ""
    log "Stack submitted. To clean up after all PRs are merged, run:"
    log "  dep-updater --cleanup --dir ${dir}"
    primary_repo_recover || true
    exit 0
  fi

  local final_prs_wt
  final_prs_wt="$(collect_tracked_prs_csv)"
  if [[ -n "$final_prs_wt" ]]; then
    set +e
    finalize_prs "$final_prs_wt"
    set -e
  else
    log "No tracked PRs found; nothing to monitor."
  fi
  cleanup
  exit 0
fi

require_resume_ci_gate "$existing_branches" "$existing_prs"
ensure_dep_updater_label

# ── Security PRs go first (bottom of the stack) ───────────────────────────
# Audits already ran above (before outdated) for CVE release-age bypass.
if [[ "$has_npm" == '1' && -n "$npm_audit_lines" && "$batch" == '0' ]]; then
  npm_security_update "$npm_audit_lines"
fi
if [[ -n "$py_tool" && -n "$py_audit_lines" && "$batch" == '0' ]]; then
  py_security_update "$py_audit_lines" "$py_tool"
fi

# ── Regular updates follow (stacked on top of security PRs) ──────────────
if [[ "$batch" == '1' ]]; then
  # Batch mode: one branch + one PR for everything.
  batch_update_all "$npm_audit_lines" "$py_audit_lines" "$npm_lines" "$py_lines" "$gha_lines" "$rust_lines"
elif [[ "$security_only" == '1' ]]; then
  log "--security-only: skipping regular version bumps."
else
  if [[ -n "$npm_lines" ]]; then
    local group_keys
    group_keys="$(list_npm_group_keys "$npm_lines")"
    while IFS= read -r group_key; do
      [[ -z "$group_key" ]] && continue
      local entries
      entries="$(npm_entries_for_group "$group_key" "$npm_lines")"
      [[ -z "$entries" ]] && continue
      npm_update_group "$group_key" "$entries" "$npm_audit_lines"
    done <<< "$group_keys"
  fi

  # Process Python packages
  if [[ -n "$py_lines" ]]; then
    while IFS=' ' read -r pkg old_ver new_ver; do
      py_update_one "$pkg" "$old_ver" "$new_ver" "$py_tool" "$py_audit_lines"
    done <<< "$py_lines"
  fi

  # Process Rust / Cargo
  if [[ -n "$rust_lines" ]]; then
    while IFS=$'\t' read -r pkg old_ver new_ver dep_kind dep_package dep_platform; do
      [[ -z "$pkg" ]] && continue
      rust_update_one "$pkg" "$old_ver" "$new_ver" "$dep_kind" "$dep_package" "$dep_platform"
    done <<< "$rust_lines"
  fi

  # Process GitHub Actions
  if [[ -n "$gha_lines" ]]; then
    while IFS=' ' read -r action cur_ref new_ref; do
      [[ -z "$action" ]] && continue
      gha_update_one "$action" "$cur_ref" "$new_ref"
    done <<< "$gha_lines"
  fi
fi

print_summary
dep_updater_write_updates_report_json
if [[ -n "$pnpm_ignored_build_pkgs" ]]; then
  log ""
  log "[pnpm] Skipped package(s) due to ERR_PNPM_IGNORED_BUILDS:"
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    log "[pnpm]   ${p}"
  done <<< "$pnpm_ignored_build_pkgs"
  log "[pnpm] To resolve permanently, run: pnpm approve-builds (or pnpm approve-builds --all)"
fi
dep_updater_print_ecosystem_failure_banner
local dep_updater_final_rc=0
if dep_updater_ecosystem_failures_present; then
  dep_updater_final_rc=1
fi
local all_prs_csv
all_prs_csv="$(collect_tracked_prs_csv)"
print_stack_urls "$all_prs_csv"
gate_all_created_prs

local run_exit_rc="$dep_updater_final_rc"

if [[ "$no_wait_merge" == '1' ]]; then
  log ""
  log "Stack submitted. To clean up after all PRs are merged, run:"
  log "  $0 --cleanup --dir ${dir}"
  _cleanup_trap_active=0
  primary_repo_recover || true
  dep_updater_emit_batch_child_report "$run_exit_rc"
  exit "$run_exit_rc"
fi

if [[ -z "$all_prs_csv" ]]; then
  # Nothing was created this run — skip merge polling and go straight to cleanup.
  _cleanup_trap_active=0
  dep_updater_emit_batch_child_report "$run_exit_rc"
  cleanup
  exit "$run_exit_rc"
fi

# Wait for merge and clean up automatically
set +e
finalize_prs "$all_prs_csv"
poll_rc=$?
set -e
if (( poll_rc != 0 )); then
  run_exit_rc=1
fi
_cleanup_trap_active=0
dep_updater_emit_batch_child_report "$run_exit_rc"
cleanup
exit "$run_exit_rc"
}

main "$@"
