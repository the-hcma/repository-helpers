#!/usr/bin/env bash
# Re-enable repository-helpers user timers on the service host.
#
# Heals missing ``timers.target.wants/`` symlinks (e.g. after a mistaken
# ``systemctl disable`` on a standby NFS client, or a boot race). Safe to run
# on every user ``default.target`` start: enable --now is idempotent when the
# timers are already armed.
#
# Installed as ``ensure-user-service-timers.service`` (WantedBy=default.target).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091  # runner-bootstrap begins session for run_command
source "${script_dir}/lib/runner-bootstrap"

repo_dir="$(cd "${script_dir}/.." && pwd)"
readonly repo_dir

systemd_dir="${repo_dir}/etc/systemd"
readonly systemd_dir

if [[ ! -d "$systemd_dir" ]]; then
  echo "ensure-user-service-timers: no ${systemd_dir}; nothing to do" >&2
  exit 0
fi

enabled_any=0
timer_path=""
timer_basename=""

for timer_path in "${systemd_dir}"/*.timer; do
  [[ -f "$timer_path" ]] || continue
  timer_basename="$(basename "$timer_path")"
  echo "ensure-user-service-timers: enable --now ${timer_basename}"
  run_command "systemctl enable --now ${timer_basename}" \
    systemctl --user enable --now "$timer_basename"
  enabled_any=1
done

if [[ "$enabled_any" -eq 0 ]]; then
  echo "ensure-user-service-timers: no *.timer templates under ${systemd_dir}" >&2
fi
