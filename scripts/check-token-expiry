#!/usr/bin/env bash
# check-token-expiry — preflight a CI environment credential's expiry.
#
# Reads the expiry of the PAT backing the active GH_TOKEN and reports how long it has
# left, so an impending rotation shows up as a warning on a green run instead of as
# `Bad credentials` on an unrelated PR weeks later (repository-helpers#533).
#
# Exit 0 for a usable credential (including one inside the warning window, and an
# unmanaged OAuth secret). Exit 1 when the credential is already expired or rejected.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/token-expiry"

secret_name=""
environment_name=""
warn_days=""

usage() {
  cat <<'USAGE'
Usage: check-token-expiry --secret NAME --environment NAME [--warn-days N]

Options:
  --secret NAME        Secret name to report (e.g. DEP_UPDATER_TOKEN)
  --environment NAME   GitHub environment holding the secret
  --warn-days N        Warning window in days, positive integer (default 14)
  --help               Show this help
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --secret)
      secret_name="${2:-}"
      shift 2
      ;;
    --environment)
      environment_name="${2:-}"
      shift 2
      ;;
    --warn-days)
      warn_days="${2:-}"
      shift 2
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    *)
      printf 'check-token-expiry: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$secret_name" || -z "$environment_name" ]]; then
  printf 'check-token-expiry: --secret and --environment are required\n' >&2
  usage >&2
  exit 1
fi

# Reject a bad window here rather than let (( )) coerce it into "everything is ok".
# 0 is rejected too: it makes `days < warn_days` false for every future-dated token,
# so a secret expiring tomorrow would report OK — the silent state this preflight
# exists to prevent. "Warn only once expired" is not a mode we offer.
if [[ -n "$warn_days" && ! "$warn_days" =~ ^[1-9][0-9]*$ ]]; then
  printf 'check-token-expiry: --warn-days must be a positive integer (got %q)\n' \
    "$warn_days" >&2
  exit 1
fi

if [[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]]; then
  printf 'ERROR: TOKEN_EXPIRY_ABSENT secret=%s env=%s days=0 expires=unknown\n' \
    "$secret_name" "$environment_name"
  printf 'check-token-expiry: no GH_TOKEN in the environment; add secret %s on environment %s.\n' \
    "$secret_name" "$environment_name" >&2
  exit 1
fi

token_expiry_preflight "$secret_name" "$environment_name" ${warn_days:+"$warn_days"}
