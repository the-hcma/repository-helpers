#!/usr/bin/env bash
# scripts/on-deploy — deploy hook for setup-service (repository-helpers).
#
# Pure-bash repo: no build step. Records the deployed git SHA so setup-service
# can reload systemd units when scripts change without re-running the oneshot
# batch job immediately.
#
# Exit code contract (consumed by scripts/setup-service):
#   0  — deploy state updated; setup-service may reload/restart units.
#   1  — nothing changed; skip restart for long-running services.
#   2+ — failure; setup-service aborts.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "$script_dir/.." && pwd)"
readonly repo_dir

if [[ "${1:-}" == '-h' || "${1:-}" == '--help' ]]; then
  cat <<'EOF'
Usage:
  scripts/on-deploy
  scripts/on-deploy --help

Example deploy hook for setup-service. Records the deployed git SHA under
~/scratch/<service>/on-deploy-sha so setup-service can decide whether to
reload/restart units.

Exit codes (setup-service contract):
  0  deploy state updated; may reload/restart
  1  nothing changed; skip restart
  2+ failure; setup-service aborts
EOF
  exit 0
fi

# shellcheck disable=SC1091  # runner-bootstrap begins session for runner_exec calls
source "${script_dir}/lib/runner-bootstrap"

# on_deploy_runner_exec_stdout <label> -- <cmd> [args…]
on_deploy_runner_exec_stdout() {
  local -r label="$1"
  shift
  runner_exec_stdout "$label" "$@"
}

gh_remote="$(on_deploy_runner_exec_stdout "on-deploy git remote get-url origin" \
  -- git -C "$repo_dir" remote get-url origin | sed 's|.*github.com[:/]||;s|\.git$||')"
service_name="${gh_remote##*/}"
readonly service_name

sha_file="${HOME}/scratch/${service_name}/on-deploy-sha"
current_sha=""
current_sha="$(on_deploy_runner_exec_stdout "on-deploy git rev-parse HEAD" \
  -- git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"

if [[ -z "$current_sha" ]]; then
  echo "on-deploy: could not resolve HEAD in ${repo_dir}" >&2
  exit 2
fi

if [[ -f "$sha_file" ]]; then
  deployed_sha=""
  deployed_sha="$(tr -d '[:space:]' < "$sha_file")"
  if [[ "$deployed_sha" == "$current_sha" ]]; then
    echo "Already deployed at ${current_sha:0:7} — no change."
    exit 1
  fi
fi

mkdir -p "$(dirname "$sha_file")"
printf '%s\n' "$current_sha" > "$sha_file"
echo "Recorded deploy at ${current_sha:0:7} (${repo_dir})"
exit 0
