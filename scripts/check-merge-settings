#!/usr/bin/env bash
# check-merge-settings — Audit GitHub merge settings and Graphite merge-queue wiring.
#
# Release Please repos need squash-only merges on main (one conventional commit per PR).
# Graphite merge queue repos need enqueue labels, CI gtmq skips, merged-pr-closer, and
# (when present) protect-main bypass for the Graphite App.
#
# Usage:
#   scripts/check-merge-settings
#   scripts/check-merge-settings --repo OWNER/NAME
#   scripts/check-merge-settings --apply
set -euo pipefail

readonly DEFAULT_ORG='the-hcma'
readonly GRAPHITE_APP_ACTOR_ID=158384
readonly THIS_REPO_NAME='repository-helpers'

org="$DEFAULT_ORG"
apply=0
declare -a repo_slugs=()

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/check-merge-settings [--org ORG] [--repo OWNER/NAME ...]
  scripts/check-merge-settings --apply [--org ORG] [--repo ...]

Without --repo, discovers org repositories that have release-please.yml or a merge-it
label, then audits each.

Release Please (when .github/workflows/release-please.yml exists):
  - squash-only repo settings; squash_merge_commit_message=BLANK
  - protect-main ruleset (if present): allowed_merge_methods is squash only

Graphite merge queue (when merge-it label is present):
  - enqueue label merge-it; merge-mq as well when that label exists on the repo
  - .github/workflows/merged-pr-closer.yml references graphite-app / merge queue
  - .github/workflows/ci.yml skips gtmq_merge_* branches (strict repos)
  - dependabot.yml implies dependabot-auto-merge.yml with merge-it (strict repos)
  - protect-main bypass for Graphite App actor_id 158384 (when ruleset exists)

--apply patches release-please repo settings and protect-main squash methods.
Graphite merge strategy (squash) in Graphite settings cannot be verified via gh.

Requires: gh (authenticated), jq.
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log_ok() {
  printf 'OK: %s\n' "$*" >&2
}

log_warn() {
  printf 'WARN: %s\n' "$*" >&2
}

log_fail() {
  printf 'FAIL: %s\n' "$*" >&2
}

require_tools() {
  command -v gh >/dev/null 2>&1 || die "'gh' not found (https://cli.github.com)"
  command -v jq >/dev/null 2>&1 || die "'jq' not found"
  gh auth status >/dev/null 2>&1 || die "'gh' is not authenticated (run: gh auth login)"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --org)
        [[ $# -ge 2 ]] || die "--org requires a value"
        org="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || die "--repo requires OWNER/NAME"
        repo_slugs+=("$2")
        shift 2
        ;;
      --apply)
        apply=1
        shift
        ;;
      *)
        die "Unknown argument: $1 (see --help)"
        ;;
    esac
  done

  if [[ "${#repo_slugs[@]}" -eq 0 ]]; then
    local slug
    while IFS= read -r slug; do
      [[ -n "$slug" ]] || continue
      repo_slugs+=("$slug")
    done < <(discover_org_audit_repos "$org")
    if [[ "${#repo_slugs[@]}" -eq 0 ]]; then
      die "No auditable repositories under ${org} (need merge-it label or release-please.yml)"
    fi
  fi
}

repo_short_name() {
  printf '%s' "${1#*/}"
}

is_strict_graphite_repo() {
  [[ "$(repo_short_name "$1")" != "$THIS_REPO_NAME" ]]
}

repo_has_merge_it_label() {
  local slug="$1"
  local labels_json
  labels_json="$(fetch_repo_labels_json "$slug")"
  jq -e 'index("merge-it") != null' >/dev/null <<<"$labels_json"
}

repo_should_audit() {
  local slug="$1"
  if repo_has_release_please "$slug"; then
    return 0
  fi
  if repo_has_merge_it_label "$slug"; then
    return 0
  fi
  return 1
}

discover_org_audit_repos() {
  local owner="$1"
  local slug
  while IFS= read -r slug; do
    [[ -n "$slug" ]] || continue
    if repo_should_audit "${owner}/${slug}"; then
      printf '%s\n' "${owner}/${slug}"
    fi
  done < <(gh api "orgs/${owner}/repos" --paginate --jq '.[].name')
}

repo_has_release_please() {
  local slug="$1"
  gh api "repos/${slug}/contents/.github/workflows/release-please.yml" >/dev/null 2>&1
}

gh_path_exists() {
  local slug="$1"
  local path="$2"
  gh api "repos/${slug}/contents/${path}" >/dev/null 2>&1
}

fetch_github_text_file() {
  local slug="$1"
  local path="$2"
  local response encoded
  response="$(gh api "repos/${slug}/contents/${path}" 2>/dev/null || true)"
  if [[ -z "$response" ]]; then
    return 1
  fi
  encoded="$(jq -r '.content // empty' <<<"$response")"
  if [[ -z "$encoded" || "$encoded" == 'null' ]]; then
    return 1
  fi
  printf '%s' "$encoded" | base64 -d 2>/dev/null || return 1
}

fetch_repo_settings() {
  local slug="$1"
  gh api "repos/${slug}" \
    --jq '{
      allow_merge_commit,
      allow_rebase_merge,
      allow_squash_merge,
      squash_merge_commit_message,
      squash_merge_commit_title
    }'
}

fetch_protect_main_ruleset() {
  local slug="$1"
  local owner name ruleset_id
  owner="${slug%%/*}"
  name="${slug#*/}"
  ruleset_id="$(gh api "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id' 2>/dev/null | head -n1 || true)"
  if [[ -z "$ruleset_id" ]]; then
    return 1
  fi
  gh api "repos/${owner}/${name}/rulesets/${ruleset_id}"
}

fetch_protect_main_merge_methods() {
  local ruleset_json="$1"
  jq '[.rules[] | select(.type == "pull_request") | .parameters.allowed_merge_methods // []] | add // []' \
    <<<"$ruleset_json"
}

fetch_repo_labels_json() {
  local slug="$1"
  gh api "repos/${slug}/labels" --jq '[.[].name]'
}

expected_enqueue_labels() {
  local labels_json="$1"
  printf '%s\n' 'merge-it'
  if jq -e 'index("merge-mq") != null' >/dev/null <<<"$labels_json"; then
    printf '%s\n' 'merge-mq'
  fi
}

validate_repo_settings_json() {
  local slug="$1"
  local settings_json="$2"
  local fail=0
  local v

  v="$(jq -r '.allow_merge_commit' <<<"$settings_json")"
  if [[ "$v" != 'false' ]]; then
    log_fail "${slug}: allow_merge_commit must be false (got ${v})"
    fail=1
  fi

  v="$(jq -r '.allow_rebase_merge' <<<"$settings_json")"
  if [[ "$v" != 'false' ]]; then
    log_fail "${slug}: allow_rebase_merge must be false (got ${v})"
    fail=1
  fi

  v="$(jq -r '.allow_squash_merge' <<<"$settings_json")"
  if [[ "$v" != 'true' ]]; then
    log_fail "${slug}: allow_squash_merge must be true (got ${v})"
    fail=1
  fi

  v="$(jq -r '.squash_merge_commit_message' <<<"$settings_json")"
  if [[ "$v" != 'BLANK' ]]; then
    log_fail "${slug}: squash_merge_commit_message must be BLANK (got ${v})"
    fail=1
  fi

  v="$(jq -r '.squash_merge_commit_title' <<<"$settings_json")"
  if [[ "$v" != 'PR_TITLE' ]]; then
    log_fail "${slug}: squash_merge_commit_title must be PR_TITLE (got ${v})"
    fail=1
  fi

  return "$fail"
}

validate_ruleset_methods_json() {
  local slug="$1"
  local methods_json="$2"
  local count methods_line

  count="$(jq 'length' <<<"$methods_json")"
  if [[ "$count" -eq 0 ]]; then
    log_warn "${slug}: no protect-main ruleset (repo settings only; consider adding squash-only ruleset)"
    return 0
  fi

  methods_line="$(jq -r 'join(", ")' <<<"$methods_json")"
  if [[ "$count" -eq 1 ]] && jq -e '.[0] == "squash"' >/dev/null <<<"$methods_json"; then
    return 0
  fi

  log_fail "${slug}: protect-main allowed_merge_methods must be [squash] (got: ${methods_line})"
  return 1
}

validate_graphite_bypass_json() {
  local slug="$1"
  local ruleset_json="$2"

  if [[ -z "$ruleset_json" ]]; then
    if is_strict_graphite_repo "$slug"; then
      log_warn "${slug}: no protect-main ruleset (Graphite MQ needs bypass for graphite-app on protect-main)"
    fi
    return 0
  fi

  if jq -e --argjson id "$GRAPHITE_APP_ACTOR_ID" '
    .bypass_actors // []
    | any(
        .actor_id == $id
        and .actor_type == "Integration"
        and (.bypass_mode == "always" or .bypass_mode == "pull_request")
      )
  ' >/dev/null <<<"$ruleset_json"; then
    return 0
  fi

  log_fail "${slug}: protect-main must bypass Graphite App (Integration actor_id ${GRAPHITE_APP_ACTOR_ID})"
  return 1
}

validate_graphite_enqueue_labels() {
  local slug="$1"
  local labels_json="$2"
  local label fail=0

  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    if jq -e --arg name "$label" 'index($name) != null' >/dev/null <<<"$labels_json"; then
      continue
    fi
    log_fail "${slug}: missing Graphite enqueue label '${label}' (create in GitHub; wire in Graphite MQ settings)"
    fail=1
  done < <(expected_enqueue_labels "$labels_json")

  return "$fail"
}

validate_graphite_workflows() {
  local slug="$1"
  local strict="$2"
  local fail=0
  local ci_text closer_text dependabot_auto_text

  if ! gh_path_exists "$slug" '.github/workflows/merged-pr-closer.yml'; then
    if [[ "$strict" == '1' ]]; then
      log_fail "${slug}: missing .github/workflows/merged-pr-closer.yml"
      fail=1
    else
      log_warn "${slug}: missing merged-pr-closer.yml (optional for ${THIS_REPO_NAME})"
    fi
  else
    closer_text="$(fetch_github_text_file "$slug" '.github/workflows/merged-pr-closer.yml' || true)"
    if [[ -z "$closer_text" ]] \
      || ! grep -qF 'graphite-app' <<<"$closer_text" \
      || ! grep -qF 'Graphite merge queue' <<<"$closer_text"; then
      log_fail "${slug}: merged-pr-closer.yml must detect graphite-app Graphite merge queue comments"
      fail=1
    fi
  fi

  if gh_path_exists "$slug" '.github/workflows/ci.yml'; then
    ci_text="$(fetch_github_text_file "$slug" '.github/workflows/ci.yml' || true)"
    if [[ -z "$ci_text" ]] || ! grep -qF 'gtmq_merge_' <<<"$ci_text"; then
      if [[ "$strict" == '1' ]]; then
        log_fail "${slug}: ci.yml must skip gtmq_merge_* merge-queue staging branches"
        fail=1
      else
        log_warn "${slug}: ci.yml does not skip gtmq_merge_* (recommended when using Graphite MQ)"
      fi
    fi
  elif [[ "$strict" == '1' ]]; then
    log_fail "${slug}: missing .github/workflows/ci.yml"
    fail=1
  fi

  if gh_path_exists "$slug" '.github/dependabot.yml'; then
    if ! gh_path_exists "$slug" '.github/workflows/dependabot-auto-merge.yml'; then
      if [[ "$strict" == '1' ]]; then
        log_fail "${slug}: dependabot.yml present but dependabot-auto-merge.yml is missing"
        fail=1
      fi
    else
      dependabot_auto_text="$(fetch_github_text_file "$slug" '.github/workflows/dependabot-auto-merge.yml' || true)"
      if [[ -z "$dependabot_auto_text" ]] || ! grep -qF 'merge-it' <<<"$dependabot_auto_text"; then
        log_fail "${slug}: dependabot-auto-merge.yml must add merge-it label"
        fail=1
      fi
    fi
  fi

  return "$fail"
}

apply_repo_settings() {
  local slug="$1"
  log_warn "${slug}: applying squash-only repository settings"
  gh api -X PATCH "repos/${slug}" \
    -f allow_merge_commit=false \
    -f allow_rebase_merge=false \
    -f allow_squash_merge=true \
    -f squash_merge_commit_message=BLANK \
    -f squash_merge_commit_title=PR_TITLE >/dev/null
}

apply_protect_main_squash_methods() {
  local slug="$1"
  local owner name ruleset_id payload
  owner="${slug%%/*}"
  name="${slug#*/}"
  ruleset_id="$(gh api "repos/${owner}/${name}/rulesets" \
    --jq '.[] | select(.name == "protect-main") | .id' 2>/dev/null | head -n1 || true)"
  if [[ -z "$ruleset_id" ]]; then
    log_warn "${slug}: no protect-main ruleset to patch (skipped)"
    return 0
  fi

  payload="$(gh api "repos/${owner}/${name}/rulesets/${ruleset_id}")"
  payload="$(jq '
    .rules |= map(
      if .type == "pull_request" then
        .parameters.allowed_merge_methods = ["squash"]
      else .
      end
    )
    | {
        name,
        target,
        enforcement,
        conditions,
        bypass_actors,
        rules
      }
  ' <<<"$payload")"

  log_warn "${slug}: patching protect-main ruleset ${ruleset_id} (squash-only)"
  gh api -X PUT "repos/${owner}/${name}/rulesets/${ruleset_id}" --input - <<<"$payload" >/dev/null
}

check_release_please() {
  local slug="$1"
  local repo_fail=0
  local settings_json ruleset_json methods_json

  if ! repo_has_release_please "$slug"; then
    return 0
  fi

  settings_json="$(fetch_repo_settings "$slug")"
  ruleset_json="$(fetch_protect_main_ruleset "$slug" 2>/dev/null || true)"
  if [[ -n "$ruleset_json" ]]; then
    methods_json="$(fetch_protect_main_merge_methods "$ruleset_json")"
  else
    methods_json='[]'
  fi

  if [[ "$apply" -eq 1 ]]; then
    if ! validate_repo_settings_json "$slug" "$settings_json"; then
      apply_repo_settings "$slug"
      settings_json="$(fetch_repo_settings "$slug")"
    fi
    if ! validate_ruleset_methods_json "$slug" "$methods_json"; then
      apply_protect_main_squash_methods "$slug"
      ruleset_json="$(fetch_protect_main_ruleset "$slug" 2>/dev/null || true)"
      if [[ -n "$ruleset_json" ]]; then
        methods_json="$(fetch_protect_main_merge_methods "$ruleset_json")"
      fi
    fi
  fi

  if ! validate_repo_settings_json "$slug" "$settings_json"; then
    repo_fail=1
  fi
  if ! validate_ruleset_methods_json "$slug" "$methods_json"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    log_ok "${slug}: release-please merge settings"
  else
    log_fail "${slug}: release-please settings (fix with --apply; see AGENTS.md merge-settings section)"
  fi

  return "$repo_fail"
}

check_graphite_merge_queue() {
  local slug="$1"
  local repo_fail=0
  local strict=0
  local labels_json ruleset_json

  if ! repo_has_merge_it_label "$slug"; then
    return 0
  fi

  if is_strict_graphite_repo "$slug"; then
    strict=1
  fi

  labels_json="$(fetch_repo_labels_json "$slug")"
  ruleset_json="$(fetch_protect_main_ruleset "$slug" 2>/dev/null || true)"

  if ! validate_graphite_enqueue_labels "$slug" "$labels_json"; then
    repo_fail=1
  fi
  if ! validate_graphite_bypass_json "$slug" "$ruleset_json"; then
    repo_fail=1
  fi
  if ! validate_graphite_workflows "$slug" "$strict"; then
    repo_fail=1
  fi

  if [[ "$repo_fail" -eq 0 ]]; then
    log_ok "${slug}: Graphite merge queue GitHub wiring"
    printf '     Confirm MQ is enabled with squash strategy in Graphite settings for %s.\n' \
      "$(repo_short_name "$slug")" >&2
  else
    log_fail "${slug}: Graphite merge queue setup (see AGENTS.md and GRAPHITE.md in this repo)"
  fi

  return "$repo_fail"
}

check_one_repo() {
  local slug="$1"
  local total_fail=0

  if ! check_release_please "$slug"; then
    total_fail=$(( total_fail + 1 ))
  fi
  if ! check_graphite_merge_queue "$slug"; then
    total_fail=$(( total_fail + 1 ))
  fi

  return "$total_fail"
}

main() {
  local slug
  local total_fail=0

  parse_args "$@"
  require_tools

  for slug in "${repo_slugs[@]}"; do
    if [[ "$slug" != */* ]]; then
      die "Invalid --repo (expected OWNER/NAME): ${slug}"
    fi
    if ! check_one_repo "$slug"; then
      total_fail=$(( total_fail + 1 ))
    fi
  done

  if [[ "$total_fail" -gt 0 ]]; then
    die "${total_fail} repository/repositories failed merge-settings check"
  fi

  log_ok "all ${#repo_slugs[@]} repository/repositories passed"
}

main "$@"
