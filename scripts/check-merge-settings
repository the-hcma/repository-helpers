#!/usr/bin/env bash
# check-merge-settings — Audit Release Please merge settings and Graphite MQ wiring.
#
# Thin wrapper around github-repo-lint (merge + Graphite sections only).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/runner-bootstrap"
# shellcheck disable=SC1091
source "${script_dir}/lib/repo-practices"

rp_main 'check-merge-settings' --merge-only "$@"
