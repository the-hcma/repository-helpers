#!/usr/bin/env bash
# Remove matured pkg@version entries from pnpm-release-age-grandfather.tsv and sync
# pnpm-workspace.yaml minimumReleaseAgeExclude (age-out grandfathered dependencies).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/pnpm-release-age
source "${script_dir}/lib/pnpm-release-age"

usage() {
  cat <<'EOF'
Usage: scripts/prune-pnpm-release-age-grandfather [OPTIONS] [repo_root]

Drops grandfather entries whose registry publish time is at least minimumReleaseAge
old, then updates pnpm-workspace.yaml excludes to match the remaining list.

Options:
  --dry-run            Print removals without writing files
  --expand-wildcard    Replace wildcard grandfather with tracked lockfile entries
  --refresh-epochs     Re-fetch missing publish epochs from the registry
  --minutes <n>        Override minutes from the grandfather file header
  -h, --help           Show this help
EOF
}

dry_run=0
expand_wildcard=0
refresh_epochs=0
minutes_override=""
repo_root="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --expand-wildcard)
      expand_wildcard=1
      shift
      ;;
    --refresh-epochs)
      refresh_epochs=1
      shift
      ;;
    --minutes)
      minutes_override="${2:?--minutes requires a value}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      repo_root="$1"
      shift
      break
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  repo_root="$1"
fi

repo_root="$(cd "$repo_root" && pwd)"
lockfile="${repo_root}/pnpm-lock.yaml"
tsv="$(pnpm_release_age_grandfather_path "$repo_root")"
workspace="${repo_root}/pnpm-workspace.yaml"

if [[ ! -f "$lockfile" ]]; then
  printf 'ERROR: no pnpm-lock.yaml under %s\n' "$repo_root" >&2
  exit 1
fi

if [[ ! -f "$tsv" ]]; then
  printf 'ERROR: missing %s — run scripts/grandfather-pnpm-release-age first\n' "$tsv" >&2
  exit 1
fi

IFS=$'\t' read -r header_minutes header_mode < <(pnpm_release_age_read_grandfather_header "$tsv")

minutes="$header_minutes"
if [[ -n "$minutes_override" ]]; then
  minutes="$minutes_override"
fi

if [[ "$header_mode" == 'wildcard' && "$expand_wildcard" == '0' ]]; then
  printf 'Grandfather is still wildcard ("*").\n'
  printf 'Run with --expand-wildcard to build tracked excludes from the lockfile,\n'
  printf 'then re-run prune to age out matured entries.\n'
  exit 0
fi

kept_lines=()
kept_specs=()
removed=0
refreshed=0
spec=""
epoch=""
pkg=""
version=""
new_epoch=""
source_lines=()

if [[ "$expand_wildcard" == '1' ]]; then
  header_mode="tracked"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    source_lines+=("$line")
  done < <(pnpm_release_age_build_tracked_entries_from_lockfile "$lockfile")
  printf 'Expanded wildcard to %s tracked entries.\n' "${#source_lines[@]}"
else
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    source_lines+=("$line")
  done < <(pnpm_release_age_read_grandfather_entries "$tsv")
fi

for line in "${source_lines[@]}"; do
  spec="${line%%$'\t'*}"
  epoch="${line#*$'\t'}"
  if [[ "$epoch" == "$line" ]]; then
    epoch=""
  fi

  if [[ "$refresh_epochs" == '1' || -z "$epoch" ]]; then
    if IFS=$'\t' read -r pkg version < <(pnpm_release_age_spec_split "$spec"); then
      new_epoch="$(pnpm_release_age_registry_epoch "$pkg" "$version" 2>/dev/null || true)"
      if [[ -n "$new_epoch" ]]; then
        epoch="$new_epoch"
        refreshed=$(( refreshed + 1 ))
      fi
    fi
  fi

  if pnpm_release_age_entry_is_aged_out "$epoch" "$minutes"; then
    removed=$(( removed + 1 ))
    if [[ "$dry_run" == '1' ]]; then
      printf 'would remove (aged): %s\n' "$spec"
    fi
    continue
  fi

  kept_lines+=("${spec}${epoch:+$'\t'${epoch}}")
  kept_specs+=("$spec")
  if [[ "$dry_run" == '1' ]]; then
    printf 'would keep: %s\n' "$spec"
  fi
done

if [[ "$dry_run" == '1' ]]; then
  printf 'Dry-run: would remove %s, keep %s (refreshed %s epochs).\n' \
    "$removed" "${#kept_specs[@]}" "$refreshed"
  exit 0
fi

pnpm_release_age_write_grandfather_file "$tsv" "$minutes" "$header_mode" "${kept_lines[@]}"
pnpm_release_age_sync_workspace "$repo_root" "$minutes" "$header_mode" "${kept_specs[@]}"

printf 'Pruned %s aged entries; %s remain in %s.\n' \
  "$removed" "${#kept_specs[@]}" "$tsv"
if [[ ${#kept_specs[@]} -eq 0 && "$header_mode" == 'tracked' ]]; then
  printf 'All excludes aged out — pnpm-workspace.yaml has no minimumReleaseAgeExclude block.\n'
  printf 'Verify CI with: pnpm install --frozen-lockfile\n'
fi
