#!/usr/bin/env bash
# repo-big-brother-enforcer - deprecated wrapper for github-repo-lint --enforcer.
#
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

printf 'WARN: scripts/repo-big-brother-enforcer is renamed to scripts/github-repo-lint --enforcer\n' >&2
exec "${script_dir}/github-repo-lint" --enforcer "$@"
