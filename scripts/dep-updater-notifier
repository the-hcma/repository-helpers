#!/usr/bin/env bash
# dep-updater-notifier — check configured repos for outdated/CVE deps and email a summary.
#
# Designed to be run from cron. Sends a single email listing every repo that
# has pending updates, what's outdated, and whether any entries are CVE-related.
# Uses dep-updater --report-json --quiet for clean, structured output.
#
# Usage:
#   dep-updater-notifier [-p|--print]    # write email to stdout instead of sending
#   dep-updater-notifier [-v|--verbose]  # show timestamped progress on stderr
#
# Flags can be combined: dep-updater-notifier -p -v
#
# By default all stderr output is suppressed (safe for cron).
# Cron example (daily at 07:00):
#   0 7 * * * /path/to/dep-updater-notifier
set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# Cron runs with a minimal PATH. Ensure common install locations are included so
# dep-updater's prerequisite checks behave the same as an interactive shell.
PATH="${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

readonly dep_updater="${script_dir}/dep-updater"

readonly default_repo_root="${HOME}/work/ai"

readonly email_to="hcma@hcma.info"
readonly email_from="dep-updater-notifier-no-reply@hcma.info"
readonly email_reply_to="dep-updater-notifier-no-reply@hcma.info"
readonly email_subject_prefix="[dep-updater-notifier]"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

warn() {
  [[ "$verbose" == '1' ]] || return 0
  printf 'ERROR: %s\n' "$*" >&2
}

log() {
  [[ "$verbose" == '1' ]] || return 0
  local ts ts_base tz epoch_real frac_us ms date_zone

  ts_base="$(date '+%Y-%m-%d %H:%M:%S')"
  tz="$(date '+%z')"

  ms="000"
  epoch_real="${EPOCHREALTIME:-}"
  if [[ -n "$epoch_real" ]]; then
    frac_us="${epoch_real#*.}"
    ms="${frac_us:0:3}"
  fi

  # Warn when a POSIX TZ string (e.g. EST5EDT) is treated as UTC by `date`.
  # This happens with some `date` implementations (e.g. uutils coreutils).
  date_zone="$(date '+%z %Z' 2>/dev/null || echo '')"
  if [[ "$date_zone" == '+0000 UTC' && -n "${TZ:-}" && "${TZ:-}" != 'UTC' && "${TZ:-}" != 'Etc/UTC' ]]; then
    if [[ "${TZ:-}" =~ ^[A-Za-z]{3,}[0-9]+[A-Za-z]{3,}$ ]]; then
      warn "TZ='${TZ}' looks like an outdated POSIX timezone string, and your 'date' is treating it as UTC."
      warn "Falling back to UTC timestamps. Fix: set TZ to an IANA zone (e.g. America/New_York)."
    fi
  fi

  ts="${ts_base}.${ms} ${tz}"
  printf '%s %s\n' "$ts" "$*" >&2
}

append_report() {
  local -r line="$1"
  report_lines+=("$line")
}

cleanup_files=()
cleanup_tmpfiles() {
  [[ ${#cleanup_files[@]} -gt 0 ]] || return 0
  rm -f "${cleanup_files[@]}" 2>/dev/null || true
}
trap cleanup_tmpfiles EXIT INT TERM

discover_repos() {
  local -r roots_csv="${DEP_UPDATER_NOTIFIER_ROOTS:-$default_repo_root}"
  local -r repos_csv="${DEP_UPDATER_NOTIFIER_REPOS:-}"
  local root
  local child

  if [[ -n "$repos_csv" ]]; then
    tr ':' '\n' <<<"$repos_csv" | sed '/^$/d'
    return 0
  fi

  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    if [[ ! -d "$root" ]]; then
      continue
    fi
    for child in "$root"/*; do
      [[ -d "$child" ]] || continue
      [[ -e "$child/.git" ]] || continue
      printf '%s\n' "$child"
    done
  done < <(tr ':' '\n' <<<"$roots_csv" | sed '/^$/d')
}

check_notifier_prereqs() {
  local missing=0
  if ! command -v jq >/dev/null 2>&1; then
    missing=$(( missing + 1 ))
    warn "Missing required tool in PATH: jq"
    append_report "=== notifier prerequisites ==="
    append_report "Missing required tool in PATH: jq"
    append_report ""
  fi
  if (( print_only == 0 )); then
    if ! command -v sendmail >/dev/null 2>&1; then
      missing=$(( missing + 1 ))
      warn "Missing required tool in PATH: sendmail (MTA)"
      append_report "=== notifier prerequisites ==="
      append_report "Missing required tool in PATH: sendmail (MTA)"
      append_report ""
    fi
  fi

  if (( missing > 0 )); then
    found_failure=1
  fi
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

print_only=0
verbose=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--print)   print_only=1 ;;
    -v|--verbose) verbose=1 ;;
    -h|--help)
      sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) die "Unknown option: '$1'. Valid options: -p/--print, -v/--verbose, -h/--help" ;;
  esac
  shift
done

[[ -x "$dep_updater" ]] || die "dep-updater not found or not executable: ${dep_updater}"

scan_host="$(hostname -s 2>/dev/null || echo 'unknown')"
report_lines=()
notice_lines=()
update_repos_paths=()
found_any=0
found_cve=0
found_failure=0

check_notifier_prereqs

repos=()
while IFS= read -r repo; do
  repos+=("$repo")
done < <(discover_repos | sort -u)

if (( ${#repos[@]} == 0 )); then
  found_failure=1
  warn "No git repos discovered (set DEP_UPDATER_NOTIFIER_ROOTS/DEP_UPDATER_NOTIFIER_REPOS)."
  append_report "=== notifier ==="
  append_report "No git repos discovered."
  append_report "Set DEP_UPDATER_NOTIFIER_ROOTS (colon-separated) and/or DEP_UPDATER_NOTIFIER_REPOS."
  append_report ""
fi

for repo in "${repos[@]}"; do
  repo_name="$(basename "$repo")"

  if [[ ! -d "$repo" ]]; then
    log "Skipping ${repo_name}: directory not found."
    append_report "=== ${repo_name} === (directory not found: ${repo})"
    append_report ""
    continue
  fi

  log "Checking ${repo_name}…"
  log "  cmd: ${dep_updater} --report-json --dir ${repo}"

  exit_code=0
  dep_out_file="$(mktemp)"
  dep_err_file="$(mktemp)"
  cleanup_files+=("$dep_out_file" "$dep_err_file")
  "$dep_updater" --report-json --dir "$repo" >"$dep_out_file" 2>"$dep_err_file" || exit_code=$?

  if [[ "$verbose" == '1' ]]; then
    log "  json:"
    (jq . <"$dep_out_file" 2>/dev/null || tail -n 80 "$dep_out_file") | sed 's/^/  /' >&2
  fi

  json_ok=0
  if jq -e . <"$dep_out_file" >/dev/null 2>&1; then
    json_ok=1
  fi

  if (( exit_code != 0 )) || (( json_ok == 0 )); then
    fail_reason="exit code ${exit_code}"
    if (( exit_code == 0 )) && (( json_ok == 0 )); then
      fail_reason="invalid JSON on stdout (exit code 0)"
    fi

    log "${repo_name}: scan failed (${fail_reason})."
    found_failure=1
    warn "${repo_name}: scan failed (${fail_reason})."
    append_report "=== ${repo_name} === (scan failed, ${fail_reason})"
    append_report "Hint: dep-updater --report-json must emit valid JSON on stdout."
    append_report ""
    append_report "stderr (last 80 lines):"
    append_report "$(tail -n 80 "$dep_err_file" 2>/dev/null || true)"
    if (( json_ok == 0 )); then
      append_report ""
      append_report "stdout (last 80 lines):"
      append_report "$(tail -n 80 "$dep_out_file" 2>/dev/null || true)"
    fi
    append_report ""
    continue
  fi

  has_updates="$(jq -r '.has_updates' <"$dep_out_file" 2>/dev/null || echo "")"
  has_cves="$(jq -r '.has_cves' <"$dep_out_file" 2>/dev/null || echo "")"

  if [[ "$has_updates" != 'true' && "$has_cves" != 'true' ]]; then
    log "${repo_name}: up to date."
    continue
  fi

  found_any=1
  update_repos_paths+=("$repo")
  [[ "$has_cves" == 'true' ]] && found_cve=1

  cve_flag=""
  [[ "$has_cves" == 'true' ]] && cve_flag=" [CVE]"

  report_lines+=("=== ${repo_name}${cve_flag} ===")
  report_lines+=("")

  if [[ "$has_cves" == 'true' ]]; then
    report_lines+=("Security vulnerabilities with available fixes:")
    report_lines+=("  $(printf '%-24s  %-10s  %-10s  %s' 'PACKAGE' 'CURRENT' 'FIX' 'CVEs')")
    while IFS= read -r row; do
      pkg="$(printf '%s' "$row" | jq -r '.package')"
      current="$(printf '%s' "$row" | jq -r '.current')"
      fix="$(printf '%s' "$row" | jq -r '.fix')"
      cves="$(printf '%s' "$row" | jq -r '.cves')"
      report_lines+=("  $(printf '%-24s  %-10s  %-10s  %s' "$pkg" "$current" "$fix" "$cves")")
    done < <(jq -c '.cves[]' <"$dep_out_file")
    report_lines+=("")
  fi

  if [[ "$has_updates" == 'true' ]]; then
    report_lines+=("Outdated packages:")
    ecosystems=()
    packages=()
    froms=()
    tos=()
    eco_w=8
    pkg_w=7
    from_w=4
    to_w=2

    local_notice="${repo_name}${cve_flag}:"
    local_count=0
    local_pairs=""
    while IFS= read -r row; do
      ecosystem="$(printf '%s' "$row" | jq -r '.ecosystem')"
      pkg="$(printf '%s' "$row" | jq -r '.package')"
      from="$(printf '%s' "$row" | jq -r '.from')"
      to="$(printf '%s' "$row" | jq -r '.to')"

      ecosystems+=("$ecosystem")
      packages+=("$pkg")
      froms+=("$from")
      tos+=("$to")

      local_count=$(( local_count + 1 ))
      if (( local_count <= 3 )); then
        local_pairs="${local_pairs:+${local_pairs}, }${pkg} ${from}→${to}"
      fi
    done < <(jq -c '.updates[]' <"$dep_out_file")

    # Compute widths (cap PACKAGE to avoid huge lines in mail clients).
    for i in "${!ecosystems[@]}"; do
      if ((${#ecosystems[$i]} > eco_w)); then eco_w=${#ecosystems[$i]}; fi
      if ((${#packages[$i]} > pkg_w)); then pkg_w=${#packages[$i]}; fi
      if ((${#froms[$i]} > from_w)); then from_w=${#froms[$i]}; fi
      if ((${#tos[$i]} > to_w)); then to_w=${#tos[$i]}; fi
    done
    (( eco_w < 10 )) && eco_w=10
    (( from_w < 4 )) && from_w=4
    (( to_w < 2 )) && to_w=2
    if (( pkg_w > 40 )); then
      pkg_w=40
    fi

    report_lines+=("  $(printf "%-${eco_w}s  %-${pkg_w}s  %-${from_w}s  %s" 'ECOSYSTEM' 'PACKAGE' 'FROM' 'TO')")
    for i in "${!ecosystems[@]}"; do
      pkg_disp="${packages[$i]}"
      if ((${#pkg_disp} > pkg_w)); then
        pkg_disp="${pkg_disp:0:$(( pkg_w - 1 ))}…"
      fi
      report_lines+=("  $(printf "%-${eco_w}s  %-${pkg_w}s  %-${from_w}s  %s" \
        "${ecosystems[$i]}" "$pkg_disp" "${froms[$i]}" "${tos[$i]}")")
    done

    if (( local_count > 3 )); then
      local_pairs="${local_pairs} (+$(( local_count - 3 )) more)"
    fi
    notice_lines+=("${local_notice} ${local_pairs}")
    report_lines+=("")
  fi
done

if (( found_any == 0 && found_failure == 0 )); then
  # Cron-silent: no output when nothing to do.
  exit 0
fi

for notice_line in "${notice_lines[@]}"; do
  [[ "$verbose" == '1' ]] || continue
  printf '%s\n' "$notice_line" >&2
done

# ---------------------------------------------------------------------------
# Build email
# ---------------------------------------------------------------------------

subject_tag=""
(( found_cve == 1 )) && subject_tag=" ⚠ CVE fixes available"
if (( found_any == 1 )); then
  readonly subject="${email_subject_prefix} dependency updates needed${subject_tag}"
else
  readonly subject="${email_subject_prefix} notifier failed (no results)"
fi

body_lines=()
body_lines+=("Dependency updates are available for one or more of your repos.")
body_lines+=("Run dep-updater in the relevant directory to create PRs automatically.")
body_lines+=("")
  body_lines+=("Scanned:  $(date '+%Y-%m-%d %H:%M %z %Z')")
body_lines+=("Host:     ${scan_host}  (user: $(id -un 2>/dev/null || echo '?'))")
body_lines+=("Script:   ${BASH_SOURCE[0]}")
body_lines+=("dep-updater: ${dep_updater}")
body_lines+=("")
body_lines+=("────────────────────────────────────────────────────────────────")
body_lines+=("")
for line in "${report_lines[@]}"; do
  body_lines+=("$line")
done
body_lines+=("────────────────────────────────────────────────────────────────")
body_lines+=("To update:")
for upd_repo in "${update_repos_paths[@]}"; do
  upd_name="$(basename "$upd_repo")"
  body_lines+=("  ${upd_name}:  cd ${upd_repo} && ${dep_updater} [--batch] [--security-only]")
done

body="$(printf '%s\n' "${body_lines[@]}")"

if (( print_only == 1 )); then
  printf 'To: %s\n' "$email_to"
  printf 'From: %s\n' "$email_from"
  printf 'Reply-To: %s\n' "$email_reply_to"
  printf 'Subject: %s\n\n' "$subject"
  printf '%s\n' "$body"
  if (( found_failure == 1 )); then
    exit 1
  fi
  exit 0
fi

# Build a MIME multipart/alternative email so the HTML part can use a
# monospace <pre> block, preserving column alignment in the report table.
# Plain-text is kept as the first (fallback) part for clients that prefer it.
boundary="dep-updater-$(date +%s%N | md5sum | head -c16)"
html_body="$(printf '%s' "$body" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"

{
  printf 'To: %s\n' "$email_to"
  printf 'From: %s\n' "$email_from"
  printf 'Reply-To: %s\n' "$email_reply_to"
  printf 'Subject: %s\n' "$subject"
  printf 'MIME-Version: 1.0\n'
  printf 'Content-Type: multipart/alternative; boundary="%s"\n' "$boundary"
  printf '\n'
  printf -- '--%s\n' "$boundary"
  printf 'Content-Type: text/plain; charset="utf-8"\n'
  printf 'Content-Transfer-Encoding: 8bit\n'
  printf '\n'
  printf '%s\n' "$body"
  printf '\n'
  printf -- '--%s\n' "$boundary"
  printf 'Content-Type: text/html; charset="utf-8"\n'
  printf 'Content-Transfer-Encoding: 8bit\n'
  printf '\n'
  printf '<!DOCTYPE html><html><body>\n'
  printf '<pre style="font-family:monospace,monospace;font-size:13px;line-height:1.4">\n'
  printf '%s\n' "$html_body"
  printf '</pre>\n'
  printf '</body></html>\n'
  printf '\n'
  printf -- '--%s--\n' "$boundary"
} | sendmail -t -oi -f "$email_from" \
  || die "sendmail failed — is a mail transfer agent configured?"

if (( found_failure == 1 )); then
  printf 'ERROR: dep-updater-notifier failed (see email for details)\n' >&2
  exit 1
fi
