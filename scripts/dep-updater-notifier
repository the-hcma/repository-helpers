#!/usr/bin/env bash
# dep-updater-notifier — check configured repos for outdated/CVE deps and email a summary.
#
# Designed to be run from cron. Sends a single email listing every repo that
# has pending updates, what's outdated, and whether any entries are CVE-related.
# Uses dep-updater --report-json --quiet for clean, structured output.
#
# Mail addresses come from ~/.config/dep-updater.env (same file as
# dep-updater-batch-run): DEP_UPDATER_REPORT_TO / DEP_UPDATER_REPORT_FROM.
#
# Usage:
#   dep-updater-notifier [-p|--print]    # write email to stdout instead of sending
#   dep-updater-notifier [-v|--verbose]  # show timestamped progress on stderr
#
# Flags can be combined: dep-updater-notifier -p -v
#
# By default all stderr output is suppressed (safe for cron).
# Cron example (daily at 07:00):
#   0 7 * * * /path/to/dep-updater-notifier
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# shellcheck disable=SC1091
source "${script_dir}/lib/tooling-path"
tooling_path_bootstrap_cron_minimal

readonly dep_updater="${script_dir}/dep-updater"

# shellcheck disable=SC1091  # shared helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/time-log"

# shellcheck disable=SC1091  # shared helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/sendmail"

# shellcheck disable=SC1091  # shared helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/email-multipart"

readonly default_repo_root="${HOME}/work/ai"

env_file="${DEP_UPDATER_ENV_FILE:-${HOME}/.config/dep-updater.env}"
readonly env_file
email_to=""
email_from=""
email_reply_to=""
email_from_default="dep-updater-notifier-no-reply@example.com"
readonly email_from_default
readonly email_subject_prefix="[dep-updater-notifier]"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

warn() {
  [[ "$verbose" == '1' ]] || return 0
  printf 'WARNING: %s\n' "$*" >&2
}

# dun_load_env_file
# Sources ~/.config/dep-updater.env (override with DEP_UPDATER_ENV_FILE).
# Required outside test mode; test mode may skip when the file is absent or
# DEP_UPDATER_NOTIFIER_SKIP_ENV_FILE=1.
dun_load_env_file() {
  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' \
    && "${DEP_UPDATER_NOTIFIER_SKIP_ENV_FILE:-0}" == '1' ]]; then
    return 0
  fi
  if [[ "${REPO_HELPERS_TEST_MODE:-0}" == '1' && ! -f "$env_file" ]]; then
    return 0
  fi
  if [[ ! -f "$env_file" ]]; then
    die "Missing required env file: ${env_file} (copy etc/dep-updater.env.example and set DEP_UPDATER_REPORT_TO)."
  fi
  if [[ ! -r "$env_file" ]]; then
    die "Env file is not readable: ${env_file}"
  fi
  set -a
  # shellcheck source=/dev/null
  source "$env_file"
  set +a
}

# dun_apply_config_defaults
# Fills report addresses after dep-updater.env is loaded.
dun_apply_config_defaults() {
  if [[ -z "${DEP_UPDATER_REPORT_TO:-}" ]]; then
    DEP_UPDATER_REPORT_TO="johndoe@example.com"
  fi
  if [[ -z "${DEP_UPDATER_REPORT_FROM:-}" ]]; then
    DEP_UPDATER_REPORT_FROM="$email_from_default"
  fi
  if [[ -z "${DEP_UPDATER_REPORT_REPLY_TO:-}" ]]; then
    DEP_UPDATER_REPORT_REPLY_TO="${DEP_UPDATER_REPORT_FROM}"
  fi
  email_to="${DEP_UPDATER_REPORT_TO}"
  email_from="${DEP_UPDATER_REPORT_FROM}"
  email_reply_to="${DEP_UPDATER_REPORT_REPLY_TO}"
}

append_report() {
  local -r line="$1"
  report_lines+=("$line")
}

cleanup_files=()
cleanup_tmpfiles() {
  [[ ${#cleanup_files[@]} -gt 0 ]] || return 0
  rm -f "${cleanup_files[@]}" 2>/dev/null || true
}
trap cleanup_tmpfiles EXIT INT TERM

# shellcheck disable=SC1091  # shared helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/runner-bootstrap"

# shellcheck disable=SC1091  # shared helper sourced at runtime; CI shellcheck doesn't use -x
source "${script_dir}/lib/github-repo-slug"

# dun_runner_print_stream <text>
# Re-emit jq stream stdout after $(…) capture inside the helper. Command
# substitution strips trailing newlines; without restoring one, `while read`
# drops a sole/last row. Only for process-substitution streams — scalar
# captures (hostname, counts, MIME boundary) must use printf '%s' so outer
# $(…) / string embeds are not polluted if a caller forgets to strip.
dun_runner_print_stream() {
  local -r out="$1"

  printf '%s' "$out"
  if [[ -n "$out" ]]; then
    printf '\n'
  fi
}

# dun_runner_jq_file <label> <file> [jq-args…]
# Scalar / validation jq (counts, flags, pretty). Does not restore newlines.
dun_runner_jq_file() {
  local -r label="$1"
  local -r file="$2"
  shift 2
  local exit_code
  local out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- jq "$@" "$file")" || exit_code=$?
  printf '%s' "$out"
  return "$exit_code"
}

# dun_runner_jq_stream <label> <file> [jq-args…]
# NDJSON / row streams for `while read` (e.g. .updates[], .cves[]).
dun_runner_jq_stream() {
  local -r label="$1"
  local -r file="$2"
  shift 2
  local exit_code
  local out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- jq "$@" "$file")" || exit_code=$?
  dun_runner_print_stream "$out"
  return "$exit_code"
}

# dun_runner_jq_r <label> <json> <jq --raw-output filter>
dun_runner_jq_r() {
  local -r label="$1"
  local -r json="$2"
  local -r filter="$3"
  local exit_code
  local out

  exit_code=0
  # shellcheck disable=SC2016  # jq filter passed as bash -c positional arg
  out="$(runner_exec_stdout "$label" -- bash -c 'printf "%s" "$2" | jq --raw-output "$1"' bash "$filter" "$json")" \
    || exit_code=$?
  printf '%s' "$out"
  return "$exit_code"
}

# dun_runner_exec_stdout <label> -- <cmd…>
dun_runner_exec_stdout() {
  local -r label="$1"
  shift
  [[ "${1:-}" == '--' ]] || return 2
  shift
  local exit_code out

  exit_code=0
  out="$(runner_exec_stdout "$label" -- "$@")" || exit_code=$?
  printf '%s' "$out"
  return "$exit_code"
}

# dun_actionable_fail_reason_from_stderr <stderr_text> <exit_code>
# Prefer dep-updater ERROR lines or nested runner stderr hints over generic exit codes.
dun_actionable_fail_reason_from_stderr() {
  local -r stderr_text="$1"
  local -r exit_code="$2"
  local line label in_stderr block_line trimmed

  if [[ -z "$stderr_text" ]]; then
    printf 'exit code %s' "$exit_code"
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == ERROR:\ * ]]; then
      printf '%s' "${line#ERROR: }"
      return 0
    fi
  done <<<"$stderr_text"

  label=""
  in_stderr=0
  block_line=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == \[FAIL\]\ * ]]; then
      label="${line#\[FAIL\] }"
      continue
    fi
    if [[ "$line" == '  --- stderr ---' ]]; then
      in_stderr=1
      block_line=""
      continue
    fi
    if (( in_stderr )) && [[ "$line" == '  --- end stderr ---' ]]; then
      if [[ -n "$block_line" ]]; then
        if [[ -n "$label" ]]; then
          printf '%s: %s' "$label" "$block_line"
        else
          printf '%s' "$block_line"
        fi
        return 0
      fi
      in_stderr=0
      continue
    fi
    if (( in_stderr )); then
      trimmed="${line#"${line%%[![:space:]]*}"}"
      if [[ -z "$block_line" && -n "$trimmed" ]]; then
        block_line="$trimmed"
      fi
    fi
  done <<<"$stderr_text"

  printf 'exit code %s' "$exit_code"
}

# dun_scan_cmd_display <repo_dir>
dun_scan_cmd_display() {
  local -r repo="$1"
  printf '%s --report-json --dir %s' "$dep_updater" "$repo"
}

# dun_runner_last_failure_cmdline
# Quoted cmdline from the most recent failed run_command in this session.
dun_runner_last_failure_cmdline() {
  local uuid
  uuid="$(runner_session_failed_ids | tail -n 1)"
  [[ -n "$uuid" ]] || return 0
  runner_read "$uuid" cmdline 2>/dev/null || true
}

# dun_record_failure <summary> [command]
dun_record_failure() {
  local -r summary="$1"
  local -r cmd="${2:-}"

  found_failure=1
  failure_summary_lines+=("$summary")
  failure_cmd_lines+=("$cmd")
}

# dun_append_failure_report <repo_name> <fail_reason> <command>
dun_append_failure_report() {
  local -r repo_name="$1"
  local -r fail_reason="$2"
  local -r cmd="$3"

  append_report "=== ${repo_name} === (scan failed: ${fail_reason})"
  if [[ -n "$cmd" ]]; then
    append_report "command: ${cmd}"
  fi
}

discover_repos() {
  local -r roots_csv="${DEP_UPDATER_NOTIFIER_ROOTS:-$default_repo_root}"
  local -r repos_csv="${DEP_UPDATER_NOTIFIER_REPOS:-}"
  local root
  local child

  if [[ -n "$repos_csv" ]]; then
    tr ':' '\n' <<<"$repos_csv" | sed '/^$/d'
    return 0
  fi

  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    if [[ ! -d "$root" ]]; then
      continue
    fi
    for child in "$root"/*; do
      [[ -d "$child" ]] || continue
      [[ -e "$child/.git" ]] || continue
      printf '%s\n' "$child"
    done
  done < <(tr ':' '\n' <<<"$roots_csv" | sed '/^$/d')
}

# dun_skip_archived_repo <repo_dir>
# Exit 0 when the clone should be skipped (archived, or archived status unknown).
# Exit 1 when the clone should be scanned (not archived, or no resolvable slug).
dun_skip_archived_repo() {
  local -r repo="$1"
  local slug
  local archived_status

  slug=""
  slug="$(gh_slug_from_repo_dir "$repo" 2>/dev/null || true)"
  if [[ -z "$slug" ]]; then
    return 1
  fi

  archived_status=0
  gh_repo_is_archived "$slug" || archived_status=$?
  case "$archived_status" in
    0)
      return 0
      ;;
    2)
      warn "Could not determine archived status for ${slug}; skipping."
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

check_notifier_prereqs() {
  local missing=0
  local -r prereq_cmd='dep-updater-notifier prerequisite check'
  if ! command -v jq >/dev/null 2>&1; then
    missing=$(( missing + 1 ))
    warn "Missing required tool in PATH: jq"
    append_report "=== notifier prerequisites ==="
    append_report "Missing required tool in PATH: jq"
    append_report "command: ${prereq_cmd}"
    append_report ""
    dun_record_failure 'missing required tool in PATH: jq' "$prereq_cmd"
  fi
  if (( print_only == 0 )); then
    if [[ "${REPO_HELPERS_TEST_MODE:-0}" != '1' ]] \
      && ! command -v sendmail >/dev/null 2>&1; then
      missing=$(( missing + 1 ))
      warn "Missing required tool in PATH: sendmail (MTA)"
      append_report "=== notifier prerequisites ==="
      append_report "Missing required tool in PATH: sendmail (MTA)"
      append_report "command: ${prereq_cmd}"
      append_report ""
      dun_record_failure 'missing required tool in PATH: sendmail (MTA)' "$prereq_cmd"
    fi
  fi
}

dun_emit_failure_stderr() {
  local i line cmd

  if (( found_failure == 0 )); then
    return 0
  fi

  if (( ${#failure_summary_lines[@]} == 0 )); then
    printf 'ERROR: dep-updater-notifier failed (see email for repo details)\n' >&2
    return 0
  fi

  if (( ${#failure_summary_lines[@]} == 1 )); then
    printf 'ERROR: dep-updater-notifier failed: %s\n' "${failure_summary_lines[0]}" >&2
    cmd="${failure_cmd_lines[0]:-}"
    if [[ -n "$cmd" ]]; then
      printf '  command: %s\n' "$cmd" >&2
    fi
    return 0
  fi

  printf 'ERROR: dep-updater-notifier failed (%d issue(s)):\n' \
    "${#failure_summary_lines[@]}" >&2
  for i in "${!failure_summary_lines[@]}"; do
    printf '  - %s\n' "${failure_summary_lines[$i]}" >&2
    cmd="${failure_cmd_lines[$i]:-}"
    if [[ -n "$cmd" ]]; then
      printf '    command: %s\n' "$cmd" >&2
    fi
  done
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

print_only=0
verbose=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--print)   print_only=1 ;;
    -v|--verbose) verbose=1 ;;
    -h|--help)
      sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) die "Unknown option: '$1'. Valid options: -p/--print, -v/--verbose, -h/--help" ;;
  esac
  shift
done

[[ -x "$dep_updater" ]] || die "dep-updater not found or not executable: ${dep_updater}"

dun_load_env_file
dun_apply_config_defaults

export TIME_LOG_ENABLED="$verbose"
export TIME_LOG_WARN_TZ="$verbose"
export TIME_LOG_WARN_PREFIX="WARNING:"

scan_host="$(dun_runner_exec_stdout "dep-updater-notifier hostname" -- hostname --short 2>/dev/null || echo 'unknown')"
report_lines=()
notice_lines=()
update_repos_paths=()
failure_summary_lines=()
failure_cmd_lines=()
found_any=0
found_cve=0
found_failure=0

check_notifier_prereqs

repos=()
_repo_discover_file="$(mktemp)"
discover_repos >"$_repo_discover_file"
mapfile -t repos < <(dun_runner_exec_stdout "dep-updater-notifier sort repos" -- sort --unique "$_repo_discover_file")
rm -f "$_repo_discover_file"

if (( ${#repos[@]} == 0 )); then
  discover_cmd="discover_repos (roots: ${DEP_UPDATER_NOTIFIER_ROOTS:-$default_repo_root})"
  dun_record_failure \
    'no git repos discovered (set DEP_UPDATER_NOTIFIER_ROOTS/DEP_UPDATER_NOTIFIER_REPOS)' \
    "$discover_cmd"
  warn "No git repos discovered (set DEP_UPDATER_NOTIFIER_ROOTS/DEP_UPDATER_NOTIFIER_REPOS)."
  append_report "=== notifier ==="
  append_report "No git repos discovered."
  append_report "Set DEP_UPDATER_NOTIFIER_ROOTS (colon-separated) and/or DEP_UPDATER_NOTIFIER_REPOS."
  append_report "command: ${discover_cmd}"
  append_report ""
fi

if (( ${#repos[@]} > 0 )); then
for repo in "${repos[@]}"; do
  repo_name="$(basename "$repo")"

  if [[ ! -d "$repo" ]]; then
    log "Skipping ${repo_name}: directory not found."
    append_report "=== ${repo_name} === (directory not found: ${repo})"
    append_report ""
    continue
  fi

  if dun_skip_archived_repo "$repo"; then
    log "Skipping ${repo_name}: archived GitHub repository."
    continue
  fi

  log "Checking ${repo_name}…"
  log "  cmd: ${dep_updater} --report-json --dir ${repo}"

  dep_out_file="$(mktemp)"
  cleanup_files+=("$dep_out_file")

  exit_code=0
  set +e
  run_command "dep-updater: ${repo_name}" "$dep_updater" --report-json --dir "$repo" \
    >"$dep_out_file" || exit_code=$?
  set -e

  dep_err_text=""
  dep_scan_cmd=""
  if [[ "$exit_code" -ne 0 ]]; then
    dep_err_text="$(runner_last_failure_capture_stderr 200 2>/dev/null || true)"
    dep_scan_cmd="$(dun_runner_last_failure_cmdline)"
  fi
  if [[ -z "$dep_scan_cmd" ]]; then
    dep_scan_cmd="$(dun_scan_cmd_display "$repo")"
  fi

  if [[ "$verbose" == '1' ]]; then
    pretty_json=""
    log "  json:"
    if pretty_json="$(dun_runner_jq_file "dep-updater-notifier json pretty" "$dep_out_file" . 2>/dev/null)"; then
      printf '%s\n' "$pretty_json" | sed 's/^/  /' >&2
    else
      dun_runner_exec_stdout "dep-updater-notifier tail invalid json" -- tail --lines=80 "$dep_out_file" \
        | sed 's/^/  /' >&2
    fi
  fi

  json_ok=0
  if dun_runner_jq_file "dep-updater-notifier json validate" "$dep_out_file" --exit-status . >/dev/null 2>&1; then
    json_ok=1
  fi

  if (( exit_code != 0 )) || (( json_ok == 0 )); then
    if (( exit_code == 0 )) && (( json_ok == 0 )); then
      fail_reason="invalid JSON on stdout (exit code 0)"
    else
      fail_reason="$(dun_actionable_fail_reason_from_stderr "$dep_err_text" "$exit_code")"
    fi

    log "${repo_name}: scan failed (${fail_reason})."
    dun_record_failure "${repo_name}: ${fail_reason}" "$dep_scan_cmd"
    dun_append_failure_report "$repo_name" "$fail_reason" "$dep_scan_cmd"
    if [[ -n "$dep_err_text" ]]; then
      append_report "dep-updater stderr:"
      while IFS= read -r eline || [[ -n "$eline" ]]; do
        append_report "  ${eline}"
      done <<<"$dep_err_text"
    else
      append_report "(no stderr from dep-updater)"
    fi
    if (( exit_code == 0 )) && (( json_ok == 0 )); then
      append_report "dep-updater stdout (first 800 bytes, invalid JSON):"
      ohead=""
      ohead="$(dun_runner_exec_stdout "dep-updater-notifier head invalid json" -- head --bytes=800 "$dep_out_file" 2>/dev/null || true)"
      while IFS= read -r oline || [[ -n "$oline" ]]; do
        append_report "  ${oline}"
      done <<<"$ohead"
    fi
    append_report ""
    continue
  fi

  update_count="$(dun_runner_jq_file "dep-updater-notifier updates count" "$dep_out_file" --raw-output '.updates|length' \
    2>/dev/null || echo "0")"
  cve_count="$(dun_runner_jq_file "dep-updater-notifier cves count" "$dep_out_file" --raw-output '.cves|length' \
    2>/dev/null || echo "0")"

  # Prefer concrete array lengths over has_* flags so empty tables are never mailed.
  if [[ ! "$update_count" =~ ^[0-9]+$ ]]; then
    update_count=0
  fi
  if [[ ! "$cve_count" =~ ^[0-9]+$ ]]; then
    cve_count=0
  fi
  if (( update_count == 0 && cve_count == 0 )); then
    log "${repo_name}: up to date."
    continue
  fi
  if (( update_count > 0 )); then
    has_updates='true'
  else
    has_updates='false'
  fi
  if (( cve_count > 0 )); then
    has_cves='true'
  else
    has_cves='false'
  fi

  found_any=1
  update_repos_paths+=("$repo")
  [[ "$has_cves" == 'true' ]] && found_cve=1

  cve_flag=""
  [[ "$has_cves" == 'true' ]] && cve_flag=" [CVE]"

  report_lines+=("=== ${repo_name}${cve_flag} ===")
  report_lines+=("")

  if [[ "$has_cves" == 'true' ]]; then
    report_lines+=("Security vulnerabilities with available fixes:")
    report_lines+=("  $(printf '%-24s  %-10s  %-10s  %s' 'PACKAGE' 'CURRENT' 'FIX' 'CVEs')")
    while IFS= read -r row || [[ -n "$row" ]]; do
      [[ -n "$row" ]] || continue
      pkg="$(dun_runner_jq_r "dep-updater-notifier cve package" "$row" '.package')"
      current="$(dun_runner_jq_r "dep-updater-notifier cve current" "$row" '.current')"
      fix="$(dun_runner_jq_r "dep-updater-notifier cve fix" "$row" '.fix')"
      cves="$(dun_runner_jq_r "dep-updater-notifier cve ids" "$row" '.cves')"
      report_lines+=("  $(printf '%-24s  %-10s  %-10s  %s' "$pkg" "$current" "$fix" "$cves")")
    done < <(dun_runner_jq_stream "dep-updater-notifier cves stream" "$dep_out_file" --compact-output '.cves[]')
    report_lines+=("")
  fi

  if [[ "$has_updates" == 'true' ]]; then
    report_lines+=("Outdated packages:")
    ecosystems=()
    packages=()
    froms=()
    tos=()
    eco_w=8
    pkg_w=7
    from_w=4
    to_w=2

    local_notice="${repo_name}${cve_flag}:"
    local_count=0
    local_pairs=""
    while IFS= read -r row || [[ -n "$row" ]]; do
      [[ -n "$row" ]] || continue
      ecosystem="$(dun_runner_jq_r "dep-updater-notifier update ecosystem" "$row" '.ecosystem')"
      pkg="$(dun_runner_jq_r "dep-updater-notifier update package" "$row" '.package')"
      from="$(dun_runner_jq_r "dep-updater-notifier update from" "$row" '.from')"
      to="$(dun_runner_jq_r "dep-updater-notifier update to" "$row" '.to')"

      ecosystems+=("$ecosystem")
      packages+=("$pkg")
      froms+=("$from")
      tos+=("$to")

      local_count=$(( local_count + 1 ))
      if (( local_count <= 3 )); then
        local_pairs="${local_pairs:+${local_pairs}, }${pkg} ${from}→${to}"
      fi
    done < <(dun_runner_jq_stream "dep-updater-notifier updates stream" "$dep_out_file" --compact-output '.updates[]')

    # Compute widths (cap PACKAGE to avoid huge lines in mail clients).
    for i in "${!ecosystems[@]}"; do
      if ((${#ecosystems[$i]} > eco_w)); then eco_w=${#ecosystems[$i]}; fi
      if ((${#packages[$i]} > pkg_w)); then pkg_w=${#packages[$i]}; fi
      if ((${#froms[$i]} > from_w)); then from_w=${#froms[$i]}; fi
      if ((${#tos[$i]} > to_w)); then to_w=${#tos[$i]}; fi
    done
    (( eco_w < 10 )) && eco_w=10
    (( from_w < 4 )) && from_w=4
    (( to_w < 2 )) && to_w=2
    if (( pkg_w > 40 )); then
      pkg_w=40
    fi

    report_lines+=("  $(printf "%-${eco_w}s  %-${pkg_w}s  %-${from_w}s  %s" 'ECOSYSTEM' 'PACKAGE' 'FROM' 'TO')")
    for i in "${!ecosystems[@]}"; do
      pkg_disp="${packages[$i]}"
      if ((${#pkg_disp} > pkg_w)); then
        pkg_disp="${pkg_disp:0:$(( pkg_w - 1 ))}…"
      fi
      report_lines+=("  $(printf "%-${eco_w}s  %-${pkg_w}s  %-${from_w}s  %s" \
        "${ecosystems[$i]}" "$pkg_disp" "${froms[$i]}" "${tos[$i]}")")
    done

    if (( local_count > 3 )); then
      local_pairs="${local_pairs} (+$(( local_count - 3 )) more)"
    fi
    notice_lines+=("${local_notice} ${local_pairs}")
    report_lines+=("")
  fi
done
fi

if (( found_any == 0 && found_failure == 0 )); then
  # Cron-silent: no output when nothing to do.
  exit 0
fi

if (( ${#notice_lines[@]} > 0 )); then
  for notice_line in "${notice_lines[@]}"; do
    [[ "$verbose" == '1' ]] || continue
    printf '%s\n' "$notice_line" >&2
  done
fi

# ---------------------------------------------------------------------------
# Build email
# ---------------------------------------------------------------------------

subject_tag=""
(( found_cve == 1 )) && subject_tag=" ⚠ CVE fixes available"
if (( found_any == 1 )); then
  readonly subject="${email_subject_prefix} dependency updates needed${subject_tag}"
else
  readonly subject="${email_subject_prefix} notifier failed (no results)"
fi

body_lines=()
if (( found_any == 1 )); then
  body_lines+=("Dependency updates are available for one or more of your repos.")
  body_lines+=("Run dep-updater in the relevant directory to create PRs automatically.")
else
  body_lines+=("One or more repository scans failed or produced nothing to report.")
  body_lines+=("See each repo section below for dep-updater stderr; cron PATH is often smaller than a login shell (install tools under ~/.local/bin or widen PATH).")
fi
body_lines+=("")
body_lines+=("Scanned:  $(dun_runner_exec_stdout "dep-updater-notifier scan timestamp" -- date '+%Y-%m-%d %H:%M %z %Z')")
body_lines+=("Host:     ${scan_host}  (user: $(dun_runner_exec_stdout "dep-updater-notifier user id" -- id --user --name 2>/dev/null || echo '?'))")
body_lines+=("Script:   ${BASH_SOURCE[0]}")
body_lines+=("dep-updater: ${dep_updater}")
body_lines+=("")
body_lines+=("────────────────────────────────────────────────────────────────")
body_lines+=("")
for line in "${report_lines[@]}"; do
  body_lines+=("$line")
done
body_lines+=("────────────────────────────────────────────────────────────────")
body_lines+=("To update:")
if (( ${#update_repos_paths[@]} > 0 )); then
  for upd_repo in "${update_repos_paths[@]}"; do
    upd_name="$(basename "$upd_repo")"
    body_lines+=("  ${upd_name}:  cd ${upd_repo} && ${dep_updater} [--batch] [--security-only]")
  done
fi

body="$(printf '%s\n' "${body_lines[@]}")"

if (( print_only == 1 )); then
  printf 'To: %s\n' "$email_to"
  printf 'From: %s\n' "$email_from"
  printf 'Reply-To: %s\n' "$email_reply_to"
  printf 'Subject: %s\n\n' "$subject"
  printf '%s\n' "$body"
  if (( found_failure == 1 )); then
    dun_emit_failure_stderr
    exit 1
  fi
  exit 0
fi

# Shared multipart writer pipes body into sed (do not wrap sed in runner_exec
# with a here-string: the runner backgrounds the child with empty stdin, so
# HTML clients get a blank message while plain-text still has the report).
repo_helpers_email_write_multipart \
  "$email_to" "$email_from" "$email_reply_to" "$subject" "$body" \
  'dep-updater' \
  | repo_helpers_sendmail "$email_from" \
  || die "sendmail failed — is a mail transfer agent configured?"

if (( found_failure == 1 )); then
  dun_emit_failure_stderr
  exit 1
fi
