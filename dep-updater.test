#!/usr/bin/env bash
# Basic smoke tests for dep-updater dry-run mode.
#
# These tests run the script with --dry-run against this repository (which has
# no npm or Python ecosystem) and verify:
#   1. The script exits 0.
#   2. A worktree is created  (log line "[worktree] Creating worktree at:").
#   3. The worktree is removed (log line "[worktree] Removed:").
#   4. The output indicates that no dependencies need updating.
#
# Both non-batch and --batch modes are exercised to confirm the code paths
# do not diverge on these invariants.
#
# Prerequisites (must be on PATH): git, gt, gh, jq, rg
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

script="${script_dir}/dep-updater"
readonly script

pass=0
fail=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

assert_exit_0() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -eq 0 ]]; then
    printf '[PASS] %s: exits 0\n' "$label"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: expected exit 0, got %d\n' "$label" "$exit_code"
    printf '       output:\n%s\n' "$output"
    fail=$(( fail + 1 ))
  fi
}

assert_contains() {
  local -r label="$1"
  local -r output="$2"
  local -r needle="$3"
  if printf '%s' "$output" | grep -qF "$needle"; then
    printf '[PASS] %s: output contains "%s"\n' "$label" "$needle"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: output does NOT contain "%s"\n' "$label" "$needle"
    printf '       output:\n%s\n' "$output"
    fail=$(( fail + 1 ))
  fi
}

# ---------------------------------------------------------------------------
# Run one dry-run invocation and capture output + exit code.
# ---------------------------------------------------------------------------

run_dry_run() {
  local -r label="$1"
  local -r extra_flags="${2:-}"
  local output exit_code
  local tmpfile
  tmpfile="$(mktemp)"
  set +e
  # shellcheck disable=SC2086  # word-split intentional for extra_flags
  "$script" --dry-run --dir "$script_dir" $extra_flags >"$tmpfile" 2>&1
  exit_code=$?
  set -e
  output="$(cat "$tmpfile")"
  rm -f "$tmpfile"

  assert_exit_0   "$label" "$output" "$exit_code"
  # Worktree lifecycle — the core invariant: created and destroyed on every dry-run
  assert_contains "$label" "$output" "[worktree] Creating worktree at:"
  assert_contains "$label" "$output" "[worktree] Ready:"
  assert_contains "$label" "$output" "[worktree] Removed:"
  # Worktree must be under TMPDIR / /tmp, never next to the source repo
  assert_contains "$label" "$output" "[worktree] Creating worktree at: ${TMPDIR:-/tmp}/"
  # No ecosystem → no change
  assert_contains "$label" "$output" "No supported ecosystem detected"
}

# ---------------------------------------------------------------------------
# Test: non-batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== non-batch dry-run ===\n'
run_dry_run "non-batch" ""

# ---------------------------------------------------------------------------
# Test: batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== batch dry-run ===\n'
run_dry_run "batch" "--batch"

# ---------------------------------------------------------------------------
# Static: no 'local -r' inside loop bodies
#
# In bash, 'local' is function-scoped. Declaring 'local -r foo=x' inside a
# loop that runs more than once will fail on the second iteration with:
#   "local: foo: readonly variable"
# Neither 'bash -n' nor shellcheck catches this — it only manifests at runtime.
# ---------------------------------------------------------------------------

printf '\n=== static: local -r in loops ===\n'
local_r_in_loops="$(awk '
  /^[[:space:]]*(while|for|until)[[:space:]]/ { depth++ }
  /^[[:space:]]*done\b/ { if (depth > 0) depth-- }
  /^}/ { depth=0 }
  /[[:space:]]local[[:space:]]+-[a-zA-Z]*r/ && depth > 0 { print NR": "$0 }
' "$script")"
if [[ -n "$local_r_in_loops" ]]; then
  printf '[FAIL] local-r-in-loops: local -r inside a loop body crashes on 2nd iteration:\n%s\n' \
    "$local_r_in_loops"
  fail=$(( fail + 1 ))
else
  printf '[PASS] local-r-in-loops: no local -r declarations inside loops\n'
  pass=$(( pass + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: pinned-package detection is present
# ---------------------------------------------------------------------------

printf '\n=== static: pinned package detection ===\n'

# py_is_pinned() must be defined
if grep -q '^py_is_pinned()' "$script"; then
  printf '[PASS] py_is_pinned: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_is_pinned: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must pass --arg semver_only to jq (semver-only uses .wanted)
if grep -q '\-\-arg semver_only' "$script"; then
  printf '[PASS] npm_outdated: passes semver_only to jq filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: --arg semver_only missing from jq call\n'
  fail=$(( fail + 1 ))
fi

# npm_outdated must pass --argjson specs to jq (exact-pin detection)
if grep -q '\-\-argjson specs' "$script"; then
  printf '[PASS] npm_outdated: passes package.json specs to jq filter\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm_outdated: --argjson specs missing from jq call\n'
  fail=$(( fail + 1 ))
fi

# package.json update patches must use jq capture() to preserve range prefix
capture_count="$(grep -c 'capture("^(?P<prefix>' "$script" || true)"
if (( capture_count >= 2 )); then
  printf '[PASS] npm update patches: both use capture() to preserve range prefix\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] npm update patches: expected >=2 capture() calls for range prefix, found %d\n' \
    "$capture_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: constraint-dependencies isolation
# ---------------------------------------------------------------------------

printf '\n=== static: constraint-dependencies isolation ===\n'

# py_outdated ge-floor extraction must use awk section tracking, not rg -o, so
# constraint-dependencies entries (which rg -o cannot filter from context) are excluded.
if grep -q 'in_direct = 1' "$script"; then
  printf '[PASS] py_outdated: uses awk section tracking to skip constraint-dependencies\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: awk section tracking (in_direct) not found; constraint-dependencies may leak\n'
  fail=$(( fail + 1 ))
fi

# The output loop in py_outdated must validate PEP 508 package names to drop
# any mangled strings (e.g. "constraint-dependencies=[...") that slip through.
if grep -A3 'while IFS=.*read.*pkg cur new' "$script" \
    | grep -q 'A-Za-z0-9.*A-Za-z0-9\._-'; then
  printf '[PASS] py_outdated: output loop validates PEP 508 package names\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: PEP 508 name validation missing from output loop\n'
  fail=$(( fail + 1 ))
fi

# py_outdated must probe resolvability with 'uv pip install --dry-run' so that
# packages blocked by transitive constraints (e.g. amqtt pinning click<8.2) are
# filtered from the report before being shown as available updates.
if grep -q 'uv pip install --dry-run' "$script"; then
  printf '[PASS] py_outdated: probes resolvability with uv pip install --dry-run\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: uv pip install --dry-run probe missing\n'
  fail=$(( fail + 1 ))
fi

# The probe must pass all installed packages as pinned requirements (not just
# --constraint), so that the resolver sees transitive Requires-Dist from other
# packages and fails when they conflict with the candidate upgrade.
if grep -q -- '-r /dev/stdin' "$script"; then
  printf '[PASS] py_outdated: probe uses -r /dev/stdin (requirements, not constraints)\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: probe must use -r /dev/stdin to catch Requires-Dist conflicts\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Behavioural: uv transitive-constraint probe
# ---------------------------------------------------------------------------

printf '\n=== behavioural: uv transitive-constraint probe ===\n'

# The probe pipes all installed packages (with pkg replaced by new_ver) as
# requirements to 'uv pip install --dry-run'.  Test the jq pipeline directly:
# given a synthetic installed_json, it must emit pkg==new_ver for the target
# package and name==current_ver for all others, with editable installs excluded.
if ! command -v jq >/dev/null 2>&1; then
  printf '[SKIP] jq not on PATH — skipping probe jq-pipeline test\n'
else
  synthetic_json='[
    {"name":"click","version":"8.1.8"},
    {"name":"typer","version":"0.15.4"},
    {"name":"my-pkg","version":"0.1.0","editable_project_location":"/src/my-pkg"}
  ]'
  probe_output="$(printf '%s' "$synthetic_json" \
    | jq -r --arg p "click" --arg v "8.3.2" \
        '.[] | select(has("editable_project_location") | not)
             | if (.name | ascii_downcase) == ($p | ascii_downcase)
               then "\(.name)==" + $v
               else "\(.name)==\(.version)"
               end')"
  expected="$(printf 'click==8.3.2\ntyper==0.15.4')"
  if [[ "$probe_output" == "$expected" ]]; then
    printf '[PASS] probe jq pipeline: target replaced, others pinned, editable excluded\n'
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] probe jq pipeline: unexpected output\n'
    printf '       expected: %s\n' "$expected"
    printf '       got:      %s\n' "$probe_output"
    fail=$(( fail + 1 ))
  fi
fi

# Live probe: run the real uv dry-run against the my-tracks venv if present.
# This validates the full pipeline catches a transitive constraint violation
# (amqtt→typer==0.15.4→click<8.2 blocks click 8.3.2).
my_tracks_dir="${HOME}/work/ai/my-tracks"
if ! command -v uv >/dev/null 2>&1; then
  printf '[SKIP] uv not on PATH — skipping live probe test\n'
elif [[ ! -d "${my_tracks_dir}/.venv" ]]; then
  printf '[SKIP] my-tracks venv not found — skipping live probe test\n'
else
  if ! cd "$my_tracks_dir"; then
    live_installed_json=""
  else
    live_installed_json="$(uv pip list --format=json 2>/dev/null || true)"
  fi
  if [[ -z "$live_installed_json" ]]; then
    printf '[SKIP] uv pip list failed in my-tracks — skipping live probe test\n'
  else
    # click==8.3.2 must be blocked (typer==0.15.4 requires click<8.2)
    live_blocked=0
    if printf '%s' "$live_installed_json" \
        | jq -r --arg p "click" --arg v "8.3.2" \
            '.[] | select(has("editable_project_location") | not)
                 | if (.name | ascii_downcase) == ($p | ascii_downcase)
                   then "\(.name)==" + $v
                   else "\(.name)==\(.version)"
                   end' \
        | (cd "$my_tracks_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
      live_blocked=1  # exit 0 = probe thinks it's fine — wrong
    fi
    if [[ "$live_blocked" -eq 0 ]]; then
      printf '[PASS] live probe: click==8.3.2 blocked by my-tracks transitive constraints\n'
      pass=$(( pass + 1 ))
    else
      printf '[FAIL] live probe: click==8.3.2 was NOT blocked — transitive constraint not detected\n'
      fail=$(( fail + 1 ))
    fi

    # An unblocked upgrade (shellcheck-py) must pass through the probe.
    live_sc_ver="$(printf '%s' "$live_installed_json" \
      | jq -r '.[] | select(.name == "shellcheck-py") | .version' 2>/dev/null || true)"
    if [[ -n "$live_sc_ver" ]]; then
      live_sc_ok=0
      if printf '%s' "$live_installed_json" \
          | jq -r --arg p "shellcheck-py" --arg v "0.11.0.1" \
              '.[] | select(has("editable_project_location") | not)
                   | if (.name | ascii_downcase) == ($p | ascii_downcase)
                     then "\(.name)==" + $v
                     else "\(.name)==\(.version)"
                     end' \
          | (cd "$my_tracks_dir" && uv pip install --dry-run -r /dev/stdin >/dev/null 2>&1); then
        live_sc_ok=1
      fi
      if [[ "$live_sc_ok" -eq 1 ]]; then
        printf '[PASS] live probe: shellcheck-py==0.11.0.1 allowed in my-tracks\n'
        pass=$(( pass + 1 ))
      else
        printf '[FAIL] live probe: shellcheck-py==0.11.0.1 was incorrectly rejected\n'
        fail=$(( fail + 1 ))
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Static: >= floor revert on failure
# ---------------------------------------------------------------------------

printf '\n=== static: >= floor revert on failure ===\n'

# py_update_one must revert pyproject.toml when uv lock fails after a sed patch
# so the file is not left dirty and does not corrupt subsequent update attempts.
revert_count=0
revert_count="$(grep -c 'checkout -- pyproject.toml' "$script" 2>/dev/null || true)"
if (( revert_count >= 2 )); then
  printf '[PASS] pyproject.toml revert: present in both py_update_one and batch_update_all\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] pyproject.toml revert: expected >=2 occurrences, found %d\n' "$revert_count"
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Static: uv >= constraint floor detection
# ---------------------------------------------------------------------------

printf '\n=== static: uv >= floor detection ===\n'

# py_constraint_op() must be defined — used to preserve >= vs == when updating
if grep -q '^py_constraint_op()' "$script"; then
  printf '[PASS] py_constraint_op: function is defined\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_constraint_op: function is missing from script\n'
  fail=$(( fail + 1 ))
fi

# py_outdated must contain the stale-floor detection variable ge_floor
if grep -q 'ge_floor' "$script"; then
  printf '[PASS] py_outdated: contains ge_floor stale-floor detection\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_outdated: ge_floor stale-floor detection missing\n'
  fail=$(( fail + 1 ))
fi

# py_update_one must call py_constraint_op to preserve the original operator
if grep -q 'py_constraint_op' "$script"; then
  printf '[PASS] py_update_one: calls py_constraint_op to detect >= vs ==\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] py_update_one: py_constraint_op call missing\n'
  fail=$(( fail + 1 ))
fi

# batch_update_all must use staged pyproject.toml diff to determine actual changes
# (not py_lines_arg directly) so transitive-only packages are excluded from the PR body
if grep -q 'diff --cached -- pyproject.toml' "$script"; then
  printf '[PASS] batch_update_all: uses staged diff to build actual Python update list\n'
  pass=$(( pass + 1 ))
else
  printf '[FAIL] batch_update_all: staged diff for actual_py_lines not found\n'
  fail=$(( fail + 1 ))
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
