#!/usr/bin/env bash
# Basic smoke tests for dep-updater dry-run mode.
#
# These tests run the script with --dry-run against this repository (which has
# no npm or Python ecosystem) and verify:
#   1. The script exits 0.
#   2. A worktree is created  (log line "[worktree] Creating worktree at:").
#   3. The worktree is removed (log line "[worktree] Removed:").
#   4. The output indicates that no dependencies need updating.
#
# Both non-batch and --batch modes are exercised to confirm the code paths
# do not diverge on these invariants.
#
# Prerequisites (must be on PATH): git, gt, gh, jq, rg
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

script="${script_dir}/dep-updater"
readonly script

pass=0
fail=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

assert_exit_0() {
  local -r label="$1"
  local -r output="$2"
  local -r exit_code="$3"
  if [[ "$exit_code" -eq 0 ]]; then
    printf '[PASS] %s: exits 0\n' "$label"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: expected exit 0, got %d\n' "$label" "$exit_code"
    printf '       output:\n%s\n' "$output"
    fail=$(( fail + 1 ))
  fi
}

assert_contains() {
  local -r label="$1"
  local -r output="$2"
  local -r needle="$3"
  if printf '%s' "$output" | grep -qF "$needle"; then
    printf '[PASS] %s: output contains "%s"\n' "$label" "$needle"
    pass=$(( pass + 1 ))
  else
    printf '[FAIL] %s: output does NOT contain "%s"\n' "$label" "$needle"
    printf '       output:\n%s\n' "$output"
    fail=$(( fail + 1 ))
  fi
}

# ---------------------------------------------------------------------------
# Run one dry-run invocation and capture output + exit code.
# ---------------------------------------------------------------------------

run_dry_run() {
  local -r label="$1"
  local -r extra_flags="${2:-}"
  local output exit_code
  local tmpfile
  tmpfile="$(mktemp)"
  set +e
  # shellcheck disable=SC2086  # word-split intentional for extra_flags
  "$script" --dry-run --dir "$script_dir" $extra_flags >"$tmpfile" 2>&1
  exit_code=$?
  set -e
  output="$(cat "$tmpfile")"
  rm -f "$tmpfile"

  assert_exit_0   "$label" "$output" "$exit_code"
  # Worktree lifecycle — the core invariant: created and destroyed on every dry-run
  assert_contains "$label" "$output" "[worktree] Creating worktree at:"
  assert_contains "$label" "$output" "[worktree] Ready:"
  assert_contains "$label" "$output" "[worktree] Removed:"
  # No ecosystem → no change
  assert_contains "$label" "$output" "No supported ecosystem detected"
}

# ---------------------------------------------------------------------------
# Test: non-batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== non-batch dry-run ===\n'
run_dry_run "non-batch" ""

# ---------------------------------------------------------------------------
# Test: batch dry-run
# ---------------------------------------------------------------------------

printf '\n=== batch dry-run ===\n'
run_dry_run "batch" "--batch"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n--- results: %d passed, %d failed ---\n' "$pass" "$fail"
if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
