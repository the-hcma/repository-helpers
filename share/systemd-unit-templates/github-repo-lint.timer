# Daily timer for GitHub Repo Lint (enforcer).
#
# Template: repository-helpers/share/systemd-unit-templates/github-repo-lint.timer
# scripts/setup-github-repo-lint enables this with systemctl --user enable --now
# on the ConditionHost machine. Requires user lingering there.

[Unit]
Description=GitHub Repo Lint (enforcer) - daily schedule

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
Unit=github-repo-lint.service

[Install]
WantedBy=timers.target
